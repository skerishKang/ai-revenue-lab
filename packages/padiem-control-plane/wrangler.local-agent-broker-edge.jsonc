{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "padiem-local-agent-broker-edge",
  "main": "local_agent_broker_edge_worker.py",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "LOCAL_AGENT_BROKER_SERVICE",
      "service": "padiem-local-agent-broker-state"
    }
  ],
  "observability": {
    "enabled": true
  }
}
