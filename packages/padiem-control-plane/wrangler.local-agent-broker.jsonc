{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "padiem-local-agent-broker-state",
  "main": "local_agent_broker_worker.py",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "LOCAL_AGENT_BROKER_STATE",
        "class_name": "LocalAgentBrokerDurableObject"
      }
    ]
  },
  "exports": {
    "LocalAgentBrokerDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
