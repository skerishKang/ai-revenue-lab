# COM2 Chat cron env — NAMES ONLY. Copy values from the host env file, never commit them.
# The unit reads these from ENV_FILE (the profile's existing .env), not from this file.

# The reviewed CPython host entry (#6356). Must stay 1; PADIEM_LOCAL_DEV must stay unset.
PADIEM_CHAT_CPYTHON_HOST=1
# Same gate the Cloudflare scheduled handler reads. With this off the tick is a no-op.
PADIEM_CHAT_AUTOMATION_SCHEDULER_ENABLED=true
# Profile data root: /mnt/d/padiem/chat-staging (staging) or /mnt/d/padiem/chat-com2 (production).
PADIEM_CHAT_LOCAL_DATA_DIR=
PADIEM_CHAT_PUBLIC_BASE_URL=
# At least 32 characters. Value lives in the host env file only.
PADIEM_CHAT_SESSION_SECRET=
# Staging 8830, production 8797. Loopback http only.
PC_QUEUE_ORIGIN=
# Needed by app.local_cron before the tick can report anything past NOT_CONFIGURED.
PADIEM_CHAT_LOCAL_IDENTITY_RPC_ORIGIN=
PADIEM_CHAT_LOCAL_IDENTITY_RPC_SECRET=
