[Unit]
Description=PADIEM COM2 Chat scheduled lane timer (staging)
Requires=padiem-chat-cron-staging.service

[Timer]
# Rendered from CRON_SCHEDULE at install time. Production must equal the deployed
# Cloudflare cron trigger; nothing in the repository declares that value.
OnCalendar=*-*-* *:00/15:00
AccuracySec=30s
RandomizedDelaySec=0
# A missed tick is not replayed: a catch-up burst after downtime would look like
# a double tick next to the Cloudflare lane.
Persistent=false
Unit=padiem-chat-cron-staging.service

[Install]
WantedBy=timers.target
