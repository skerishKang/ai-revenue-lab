[Unit]
Description=PADIEM COM2 Chat scheduled lane (production) — one automation tick
Documentation=file:C:/Users/limone/AppData/Local/Temp/tmpx23580xa/app/README-cron.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/d/padiem/chat-com2
ConditionPathIsMountPoint=/mnt/d
ConditionPathExists=/opt/padiem/chat-com2/.env
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=padiem-chat
Group=padiem-chat
WorkingDirectory=C:/Users/limone/AppData/Local/Temp/tmpx23580xa/app
EnvironmentFile=/opt/padiem/chat-com2/.env
Environment=CRON_PROFILE=production
Environment=CRON_EXPECTED_DATA_ROOT=/mnt/d/padiem/chat-com2
Environment=CRON_EXPECTED_QUEUE_ORIGIN=http://127.0.0.1:8797
Environment=CRON_LOCK_FILE=/run/padiem-chat-cron/production.lock
RuntimeDirectory=padiem-chat-cron
RuntimeDirectoryMode=0750
ExecCondition=C:/Users/limone/AppData/Local/Temp/tmpx23580xa/app/venv/bin/python C:/Users/limone/AppData/Local/Temp/tmpx23580xa/app/check_config_cron.py
ExecStart=C:/Users/limone/AppData/Local/Temp/tmpx23580xa/app/run-cron.sh
TimeoutStartSec=600
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/d/padiem/chat-com2 /run/padiem-chat-cron
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
