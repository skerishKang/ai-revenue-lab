# Copy to /opt/padiem/connector-watch/.env (mode 0600) and fill the notifier names
# the Chat worker already uses. With none of them set the watch still prints its
# verdict to the journal and never claims to have told anyone.
CONNECTOR_WATCH_EXECUTOR_UNIT=padiem-oracle-mesh-executor.service
CONNECTOR_WATCH_JOURNAL_MINUTES=90
CONNECTOR_WATCH_CHAT_HEALTH_URL=https://chat.padiem.net/health
B66_ALERT_TELEGRAM_BOT_TOKEN=
B66_ALERT_TELEGRAM_CHAT_ID=
B66_ALERT_DISCORD_WEBHOOK_URL=
# After the cutover: read the queue on this host with the read-only secret.
# PC_QUEUE_BACKEND=com2
# CONNECTOR_WATCH_QUEUE_ORIGIN=http://127.0.0.1:8797
# CONNECTOR_WATCH_READ_SECRET=
# CONNECTOR_WATCH_DEVICE_IDS=
