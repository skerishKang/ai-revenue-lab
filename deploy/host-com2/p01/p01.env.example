# P01 Engine on COM2 — NAMES ONLY. Copy to /opt/padiem/p01/env/p01.env (0600)
# and fill values on the host. No value is committed, and the service never
# prints one.
#
# This file is read by the unit through EnvironmentFile. The bind is also fixed
# in the unit and re-checked by check_config.py: loopback 8811, nothing else.

# --- bind (must stay exactly these values) ----------------------------------
P01_HOST=127.0.0.1
P01_PORT=8811

# --- Engine caller identity --------------------------------------------------
# Every non-health route requires it. The Chat host sends the same pair through
# PADIEM_CHAT_LOCAL_P01_CALLER_ID / PADIEM_CHAT_LOCAL_P01_ENGINE_CREDENTIAL.
# Secret: 32–512 bytes, supplied on the host only.
PADIEM_ENGINE_CALLER_ID=
PADIEM_ENGINE_CALLER_SECRET=

# --- Engine caller allow-list ------------------------------------------------
# Apps the Engine accepts calls for. The Chat host (padiem-chat), the BookAI
# reader app (b61) and the Chat host's connector lanes all relay through it.
# Leaving an app out makes every call for it fail with a 403 app-authorization
# error until the host file is corrected by hand. Known past incidents:
# b61 (BookAI AI calls) and the Google connector lanes below.
#   b54-padiem-claw           Chat connector tool lane (Gmail READ)
#   b54-padiem-claw-drive     Chat connector tool lane (Drive READ)
#   b54-padiem-claw-calendar  Calendar READ activation, grant state, tool lane
# The hosts send exactly these app ids (apps/padiem-chat/app/local_p01_engine.py,
# apps/korean-ai-code-agent/src/kagent/p01_adapter.py). Keep the value identical
# to the live /opt/padiem/p01/env/p01.env.
PADIEM_ENGINE_ALLOWED_APPS=padiem-chat,b61,b54-padiem-claw,b54-padiem-claw-drive,b54-padiem-claw-calendar

# --- existing Control Plane HTTPS RPC authorities ----------------------------
# Bare HTTPS Worker origins; secrets match each Worker's existing ingress
# secret. Reuse authorized values on COM2; never generate or print them here.
PADIEM_ENGINE_LOCAL_IDENTITY_ORIGIN=
PADIEM_ENGINE_LOCAL_IDENTITY_SECRET=
PADIEM_ENGINE_LOCAL_ADMISSION_ORIGIN=
PADIEM_ENGINE_LOCAL_ADMISSION_SECRET=

# --- Google OAuth state authority (Calendar READ activation, #7229) ----------
# Bare HTTPS origin of the Google OAuth state Worker and the secret that Worker
# verifies (its PADIEM_GOOGLE_STATE_RPC_INGRESS_SECRET). Chat's host already
# holds the same pair as PADIEM_CHAT_LOCAL_GOOGLE_OAUTH_ORIGIN/_SECRET; reuse
# that authorized value here, never generate or print one. Both empty keeps the
# binding absent and the Calendar lane's reviewed 503 unchanged. The state
# Worker must also allow the reviewed select_calendar_binding method on its
# HTTPS ingress; see docs/operations/COM2_P01_CONTROL_PLANE_BINDINGS_20261109.md.
PADIEM_ENGINE_LOCAL_GOOGLE_OAUTH_ORIGIN=
PADIEM_ENGINE_LOCAL_GOOGLE_OAUTH_SECRET=

# --- Chat service binding (host stand-in for PADIEM_CHAT_SERVICE) ------------
# Loopback Chat origin. The host publishes it under the binding name the
# unchanged Engine code reads.
PADIEM_ENGINE_LOCAL_CHAT_ORIGIN=

# COM2 edge material for that binding: Chat's ingress middleware refuses every
# call that does not carry x-padiem-edge-* headers signed with this secret, so
# the binding publishes only when this file exists and is private. Point at
# THIS service's own 0600 copy of the same secret value the Chat host uses
# (never group/world readable — the binding refuses such a file). Missing or
# unusable material disables the desktop lane loudly at startup
# (p01_local_chat_edge_unconfigured); it never blocks the rest of the Engine.
PADIEM_COM2_EDGE_SECRET_FILE=

# --- Engine ↔ Chat computer-use secret ---------------------------------------
# Same value in the Chat env and here, 32+ characters. Absent or shorter keeps
# startup working and the Claw desktop / PC-query tools off.
CLAW_ENGINE_DESKTOP_SECRET=

# --- observability -----------------------------------------------------------
PADIEM_ENGINE_AUTHORITY_DIAGNOSTIC_TOKEN=

# Chat-side variable (do NOT put it here; it belongs to the Chat host's own env,
# which deploy/host-com2/chat owns and this package does not edit):
#   PADIEM_CHAT_LOCAL_P01_ENGINE_ORIGIN=http://127.0.0.1:8811
