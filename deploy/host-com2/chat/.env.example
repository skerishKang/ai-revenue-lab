# COM2 Chat parallel host — copy to /opt/padiem/chat-com2/.env (0600) and fill.
# This file carries NAMES only. Never commit values, never print them.
# host opt-in: https public origin required, PADIEM_LOCAL_DEV must stay unset
PADIEM_CHAT_CPYTHON_HOST=1
PADIEM_CHAT_PUBLIC_BASE_URL=https://chat-com2.padiem.net
PADIEM_CHAT_AUTH_MODE=
PADIEM_CHAT_COOKIE_SECURE=true
PADIEM_CHAT_SESSION_SECRET=
PADIEM_CHAT_GOOGLE_CLIENT_ID=
PADIEM_CHAT_GOOGLE_CLIENT_SECRET=
PADIEM_CHAT_RUNTIME_MODE=mock
PADIEM_CHAT_LIVE_ENABLED=false
PADIEM_CHAT_WEB_PROVIDER=off
PADIEM_CHAT_TIMEOUT_SECONDS=600
PADIEM_CHAT_COMPLETED_TIMEOUT_SECONDS=600
PADIEM_CHAT_LOCAL_DATA_DIR=/mnt/d/padiem/chat-com2
# stage-3 window: create this file to refuse writes while reads continue
PADIEM_CHAT_MAINTENANCE_SENTINEL=/mnt/d/padiem/chat-com2/MAINTENANCE
# B14 over HTTPS (fill together with the Owner-approved endpoint)
B14_UPSTREAM_MODE=
B14_UPSTREAM_URL=
PADIEM_B14_SERVICE_PROOF_SECRET=
TINYFISH_API_KEY=
PADIEM_CHAT_DAUM_REST_API_KEY=
# HTTPS stand-ins for the Worker Service bindings (fill as pairs, or leave empty)
PADIEM_CHAT_LOCAL_IDENTITY_RPC_ORIGIN=
PADIEM_CHAT_LOCAL_IDENTITY_RPC_SECRET=
PADIEM_CHAT_LOCAL_B66_PDF_ORIGIN=
PADIEM_CHAT_LOCAL_B66_PDF_SECRET=

# Optional positive byte limit for saved PC command output; blank = no product cap.
# PC file reads retain their separate 20 MB limit.
PADIEM_CHAT_PC_COMMAND_OUTPUT_MAX_BYTES=
