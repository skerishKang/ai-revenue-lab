# COM2 Chat staging — copy to /opt/padiem/chat-staging/.env (0600) and fill.
# This file carries NAMES only. Never commit values, never print them.
# host opt-in: https public origin required, PADIEM_LOCAL_DEV must stay unset
PADIEM_CHAT_CPYTHON_HOST=1
PADIEM_CHAT_PUBLIC_BASE_URL=https://chat-com2-staging.padiem.net
PADIEM_CHAT_AUTH_MODE=
PADIEM_CHAT_COOKIE_SECURE=true
PADIEM_CHAT_SESSION_SECRET=
PADIEM_CHAT_GOOGLE_CLIENT_ID=
PADIEM_CHAT_GOOGLE_CLIENT_SECRET=
PADIEM_CHAT_RUNTIME_MODE=mock
PADIEM_CHAT_LIVE_ENABLED=false
PADIEM_CHAT_WEB_PROVIDER=off
PADIEM_CHAT_TIMEOUT_SECONDS=600
PADIEM_CHAT_COMPLETED_TIMEOUT_SECONDS=600
PADIEM_CHAT_LOCAL_DATA_DIR=/mnt/d/padiem/chat-staging
# stage-3 window: create this file to refuse writes while reads continue
PADIEM_CHAT_MAINTENANCE_SENTINEL=/mnt/d/padiem/chat-staging/MAINTENANCE
# staging queue (8830). The service secret is read from the file; never inline it.
PC_QUEUE_BACKEND=com2
PC_QUEUE_ORIGIN=http://127.0.0.1:8830
PADIEM_CHAT_QUEUE_ALLOW_LOOPBACK_HTTP=1
PC_QUEUE_SERVICE_SECRET_FILE=/opt/padiem/mesh-queue-staging/service-secret.txt
# shared login: staging profile uses b62-staging and the configured public origin.
# CPython route mounting and native signing/verification are separate work.
# Never point these at production values.
PADIEM_CHAT_SHARED_LOGIN_ENABLED=true
PADIEM_CHAT_SHARED_AUTH_CLIENT_ID=b62-staging
PADIEM_CHAT_SHARED_AUTH_CLIENT_KID=
PADIEM_CHAT_SHARED_AUTH_CLIENT_PRIVATE_JWK_FILE=
PADIEM_CHAT_SHARED_AUTH_COMPARE_STATE_KEY_FILE=
# B14 over HTTPS (fill together with the Owner-approved endpoint)
B14_UPSTREAM_MODE=
B14_UPSTREAM_URL=
PADIEM_B14_SERVICE_PROOF_SECRET=
TINYFISH_API_KEY=
PADIEM_CHAT_DAUM_REST_API_KEY=
# HTTPS stand-ins for the Worker Service bindings (fill as pairs, or leave empty)
PADIEM_CHAT_LOCAL_IDENTITY_RPC_ORIGIN=
PADIEM_CHAT_LOCAL_IDENTITY_RPC_SECRET=
PADIEM_CHAT_LOCAL_B66_PDF_ORIGIN=
PADIEM_CHAT_LOCAL_B66_PDF_SECRET=
