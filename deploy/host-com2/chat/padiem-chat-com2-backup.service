[Unit]
Description=PADIEM COM2 Chat daily SQLite snapshot
RequiresMountsFor=/mnt/d/padiem/chat-com2

[Service]
Type=oneshot
User=padiem-chat
Environment=PADIEM_CHAT_LOCAL_DATA_DIR=/mnt/d/padiem/chat-com2
EnvironmentFile=/opt/padiem/chat-com2/.env
ExecStart=/opt/padiem/chat-com2/venv/bin/python /opt/padiem/chat-com2/backup.py --db ${PADIEM_CHAT_LOCAL_DATA_DIR}/chat.sqlite3 --dest ${PADIEM_CHAT_LOCAL_DATA_DIR}/backups --keep 7
