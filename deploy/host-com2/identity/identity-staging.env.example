# Paths only. Point to an explicitly prepared staging identity database.
COM2_IDENTITY_AUTHORITY_FACTORY=authority_factory:create_authority
COM2_IDENTITY_DB_PATH=/mnt/d/padiem/identity-staging/identity.sqlite3
COM2_IDENTITY_LOOKUP_KEY_FILE=/opt/padiem/identity-staging/secrets/lookup_key
COM2_IDENTITY_TICKET_KEY_FILE=/opt/padiem/identity-staging/secrets/ticket_key
COM2_IDENTITY_RPC_SECRET_FILE=/opt/padiem/identity-staging/secrets/rpc_ingress_secret
CONTROL_PLANE_CONNECTOR_ENROLLMENT_RPC_ENABLED=false
CONTROL_PLANE_CONNECTOR_ENROLLMENT_SCOPE_APPROVED=false
CONTROL_PLANE_CONNECTOR_ENROLLMENT_SCHEMA_INSTALLED=false
PYTHONPATH=/opt/padiem/identity-staging/host:/opt/padiem/identity-staging/src:/opt/padiem/identity-staging/broker
