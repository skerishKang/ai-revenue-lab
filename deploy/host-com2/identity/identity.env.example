# COM2 loopback relay only. Upstream must be a separately authorized private
# HTTPS ingress to the canonical Cloudflare DO, using its existing proof key.
# No upstream address, key value, or local identity database is supplied here.
COM2_IDENTITY_AUTHORITY_FACTORY=com2_identity_do_proxy:create_authority
COM2_IDENTITY_UPSTREAM_ORIGIN=
COM2_IDENTITY_UPSTREAM_SECRET_FILE=
COM2_IDENTITY_RPC_SECRET_FILE=
PYTHONPATH=/opt/padiem/identity/host:/opt/padiem/identity/src:/opt/padiem/identity/broker
