# /etc/padiem/offsite-backup.env (0600, root) — paths and names only.
# The encryption key and the R2 token live in 0600 files; values never go here.
COM2_OFFSITE_KEY_FILE=/etc/padiem/offsite-backup.key
COM2_OFFSITE_KEY_ID=com2-2026-11
OFFSITE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OFFSITE_R2_BUCKET=
OFFSITE_R2_TOKEN_ID_FILE=/etc/padiem/r2-offsite-token-id
OFFSITE_R2_TOKEN_SECRET_FILE=/etc/padiem/r2-offsite-token-secret
OFFSITE_STATE_DIR=/var/lib/padiem-offsite-backup
OFFSITE_QUEUE_BACKUP_DIR=/opt/padiem/backups/mesh-queue
OFFSITE_CHAT_BACKUP_DIR=/mnt/d/padiem/chat-com2/backups
OFFSITE_BROKER_BACKUP_DIR=/mnt/d/padiem/broker/backups
# The D1 pair the 04:20 Windows task PADIEM-COM2-D1-R2-Sync publishes. This tool only
# ever reads it; the systemd unit lists the parent path in ReadOnlyPaths.
OFFSITE_D1_GENERATIONS_DIR=/mnt/d/PADIEM-Servers/infrastructure/storage-migration/snapshots/generations
# Evidence this host is expected to hold that pair: the Windows drive is attached.
# No mount = NOT_INSTALLED (reported), mounted but no generation = FAIL.
OFFSITE_D1_MOUNT_ROOT=/mnt/d
# Optional cross-check of the COM2 B62 runtime pointer. Empty means the published
# generation pointer alone decides, which is what the daily sync writes.
OFFSITE_D1_RUNTIME_POINTER=
# Location of com2_backup_schedule.py (the generation authority). Empty means the
# path install.sh links next to offsite.py.
OFFSITE_GENERATION_OPS_PATH=
OFFSITE_RETENTION_DAILY=7
OFFSITE_RETENTION_WEEKLY=4
