# /etc/padiem/offsite-backup.env (0600, root) — paths and names only.
# The encryption key and the R2 token live in 0600 files; values never go here.
COM2_OFFSITE_KEY_FILE=/etc/padiem/offsite-backup.key
COM2_OFFSITE_KEY_ID=com2-2026-11
OFFSITE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OFFSITE_R2_BUCKET=
OFFSITE_R2_TOKEN_ID_FILE=/etc/padiem/r2-offsite-token-id
OFFSITE_R2_TOKEN_SECRET_FILE=/etc/padiem/r2-offsite-token-secret
OFFSITE_STATE_DIR=/var/lib/padiem-offsite-backup
OFFSITE_QUEUE_BACKUP_DIR=/opt/padiem/backups/mesh-queue
OFFSITE_CHAT_BACKUP_DIR=/mnt/d/padiem/chat-com2/backups
OFFSITE_BROKER_BACKUP_DIR=/mnt/d/padiem/broker/backups
OFFSITE_RETENTION_DAILY=7
OFFSITE_RETENTION_WEEKLY=4
