<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="PadiemPcConnect.app"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8.1, 10 and 11. Declaring them is what lets the program read the
           real operating system version instead of the 6.2 it would be told
           otherwise, and the TLS 1.3 decision is made from that build. -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da7d}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{4a2f28e3-53b5-44c2-b83e-dfd3f4f4a04f}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker, not requireAdministrator: the double clicked window must open
           and answer at once, and the one step that needs elevation asks for it in
           its own words, so the check and dry run modes stay runnable by an ordinary
           sign in. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
