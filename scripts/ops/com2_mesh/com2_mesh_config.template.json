{
  "com2_host": "COM2_HOST_OR_ADDRESS",
  "com2_ssh_port": 22,
  "com2_ssh_user": "SSH_USER",
  "com2_ssh_key": "C:\path\to\private_key",
  "com2_probe_script": "C:\path\to\padiem-mesh-probe.cmd",
  "com2_mesh_port": 4443,
  "health_log": "C:\path\to\com2-mesh-health.log",
  "recovery_log": "C:\path\to\com2-mesh-recovery.jsonl",
  "lock_file": "C:\path\to\com2-mesh-recovery.lock",
  "state_file": "C:\path\to\com2-mesh-recovery-state.json",
  "status_file": "C:\path\to\com2-mesh-status.json",
  "recovery_lock_seconds": 600,
  "recovery_max_attempts": 3,
  "recovery_backoff_schedule_seconds": [300, 900, 1800],
  "recovery_cooldown_seconds": 300,
  "recovery_retry_window_seconds": 3600,
  "max_pending_seconds": 900,
  "ssh_timeout_seconds": 15,
  "verify_timeout_seconds": 30,
  "tcp_timeout_ms": 3000,
  "mesh_agent_service": "Mesh Agent",
  "autostart_boot_tolerance_seconds": 120,
  "autostart_http_timeout_seconds": 8,
  "com2_wsl_distro": "Ubuntu",
  "com2_mesh_unit": "padiem-meshcentral.service",
  "com2_keeper_pattern": "[p]adiem-wsl-keepalive",
  "com2_keeper_process_name": "padiem-wsl-keepalive"
}
