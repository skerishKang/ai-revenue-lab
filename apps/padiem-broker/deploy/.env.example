# COM2 padiem-broker — copy to /opt/padiem/broker/.env (0600) and fill paths.
# Values live in 0600 files; this file carries paths and names only.
PADIEM_BROKER_RPC_INGRESS_SECRET_FILE=/opt/padiem/broker/secrets/rpc_ingress_secret
LOCAL_AGENT_BROKER_PEPPER_FILE=/opt/padiem/broker/secrets/pepper
PADIEM_BROKER_DB_PATH=/mnt/d/padiem/broker/broker.sqlite3
# Must match the Cloudflare broker authority_ref for snapshot compatibility.
LOCAL_AGENT_BROKER_AUTHORITY_REF=
# Same default-off feature gates the Worker uses.
LOCAL_AGENT_BROKER_PAIRING_RPC_ENABLED=false
LOCAL_AGENT_BROKER_PAIRING_SCHEMA_INSTALLED=false
LOCAL_AGENT_BROKER_PAIRING_SCHEMA_INSTALL_ENABLED=false
LOCAL_AGENT_BROKER_PAIRING_ISSUANCE_RATE_LIMIT=0
LOCAL_AGENT_OFFICE_CHUNK_TRANSFER_ENABLED=false
