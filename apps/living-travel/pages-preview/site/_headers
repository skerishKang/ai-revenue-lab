/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; script-src 'none'; connect-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'self'

# Connected staging surface only. The global /* CSP (script-src 'none';
# connect-src 'none') is detached here so the staging pages can load the pinned
# Firebase modular SDK from gstatic and call the isolated Modal staging API.
# The synthetic preview CSP above is unchanged and still applies to every
# non-staging path. No wildcard origins, no 'unsafe-inline', no 'unsafe-eval'.
# connect-src lists only the exact Firebase auth origins and the exact Modal
# staging API origin (must match API_BASE in staging/assets/config.js).
/staging/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self'; img-src 'self'; connect-src https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://ai-revenue-lab-identity.firebaseapp.com https://padiemipu--ai-revenue-living-travel-staging-web.modal.run; frame-src https://ai-revenue-lab-identity.firebaseapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
