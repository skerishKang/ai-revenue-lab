{
  "name": "@padiem/connector",
  "version": "0.1.0",
  "description": "PADIEM Connector — Windows PC connection interface for PADIEM Agent.",
  "type": "module",
  "bin": {
    "padiem-connector": "bin/padiem-connector.mjs",
    "claw-connect": "bin/claw-connect.mjs"
  },
  "files": [
    "bin/",
    "padiem_connector/",
    "claw_connect/",
    "install.ps1",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/padiem-connector.mjs start",
    "status": "node bin/padiem-connector.mjs status",
    "autostart:on": "node bin/padiem-connector.mjs autostart on",
    "autostart:off": "node bin/padiem-connector.mjs autostart off",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "license": "SEE LICENSE IN README.md",
  "private": true
}
