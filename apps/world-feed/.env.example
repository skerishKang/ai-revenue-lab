# World Feed — environment overrides (copy to .env as needed)
# All variables use the WORLD_FEED_ prefix.

WORLD_FEED_APP_ENV=development
WORLD_FEED_DATABASE_PATH=var/world-feed.db
WORLD_FEED_AI_PROVIDER=mock
WORLD_FEED_AI_MODEL=mock-world-feed-v1
WORLD_FEED_AI_MAX_RETRIES=3
WORLD_FEED_PROMPT_VERSION=world-feed-v1
WORLD_FEED_DEFAULT_BRIEF_SIZE=5
