{
  "name": "b64-ai-reward-router",
  "main": "dist/src/worker.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": true,
  // Issue #6077: B64's design tokens name Pretendard, but the Worker shipped no
  // @font-face, so the typeface only appeared on machines that already had it
  // installed. These are the same official SIL OFL 1.1 assets the reviewed
  // councillor prototype already carries — the dynamic-subset slices mean a
  // Korean page downloads only the ranges it needs instead of the 3.1 MB set.
  // No `binding` is declared: nothing in the Worker reads the files, so this
  // adds no new live binding for the deploy gate's parity readback to track.
  "assets": {
    "directory": "./public"
  },
  // Issue #987: the mutation-origin binding for cookie-authenticated account
  // and pipeline POSTs (#3476 policy). It MUST be the real serving host — an
  // unconfigured or wrong value denies cookie-carrying POSTs (fail closed) and
  // never bypasses the guard.
  //
  // B64 is an independent business (owner decision 2026-10-27), so this names
  // B64's own host rather than assuming another product's origin, and it no
  // longer carries that product's name in the binding key. The value below is
  // the host measured live today; when B64's own registered domain is confirmed
  // by a read-only Cloudflare inventory, changing this one line and redeploying
  // is the whole migration for this setting.
  "vars": {
    "B64_PUBLIC_BASE_URL": "https://b64-ai-reward-router.charliekant.workers.dev"
  },
  // No `services` block: B64 authenticates its own members against its own D1
  // and holds its own session key. It binds no other product's Worker, so it
  // cannot be reached through, or blocked by, another product's routes.
  // Issue #987: durable storage for the income pipeline and B64 accounts.
  // The database and migrations/d1/*.sql are created and applied ONLY by the
  // dispatch-only B64 D1 provision gate
  // (.github/workflows/b64-d1-provision-gate.yml); application code never
  // provisions schema. `database_id` is the id that gate provisioned and
  // printed (#5840); the all-zero value that used to sit here was a
  // placeholder and is not acceptable at deploy time — the deploy gate refuses
  // it. Renaming the database itself is a production mutation and is not part
  // of this file's history.
  "d1_databases": [
    {
      "binding": "B64_INCOME_DB",
      "database_name": "padiem-b64",
      "database_id": "b7f7bbd7-442c-4bc6-bc0d-b1026b0d459a",
      "migrations_dir": "migrations/d1"
    }
  ]
}
