# B64 AI Reward Router
# Provider accounts are optional for pre-activation development.
# Keep every provider DISABLED until the owner has completed the corresponding
# account approval / authority step. Never commit real secret values.
NODE_ENV=development

# ayeT — owner action #1116
B64_AYET_MODE=DISABLED
B64_AYET_OWNER_AUTHORIZED=false
B64_AYET_PUBLISHER_ID=
B64_AYET_PLACEMENT_ID=
B64_AYET_REWARDED_ADSLOT_ID=
B64_AYET_PUBLISHER_API_KEY=

# Adscend Media — owner action #1117
B64_ADSCEND_MODE=DISABLED
B64_ADSCEND_OWNER_AUTHORIZED=false
B64_ADSCEND_PUBLISHER_ID=
B64_ADSCEND_OFFERWALL_PROFILE_ID=
B64_ADSCEND_API_KEY=

# Tremendous — owner action #1118
B64_TREMENDOUS_MODE=DISABLED
B64_TREMENDOUS_OWNER_AUTHORIZED=false
B64_TREMENDOUS_CAMPAIGN_ID=
B64_TREMENDOUS_ACCESS_TOKEN=
