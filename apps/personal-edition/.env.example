APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=var/personal-edition.db

# Database backend selection (default: sqlite)
#   sqlite     — use DATABASE_PATH (default, local/test)
#   postgresql — use PE_DATABASE_URL (explicit selection required)
#
# In production, DB_BACKEND must be explicitly set.  SQLite is NOT a
# fallback for production; if DB_BACKEND=postgresql, PE_DATABASE_URL
# must be provided.
DB_BACKEND=sqlite
PE_DATABASE_URL=
AI_PROVIDER=mock
AI_MODEL=mock-personal-edition-v1
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
PROMPT_VERSION=personal-edition-v1

# Session and authentication (required in production)
SECRET_KEY=dev-secret-key-change-in-production
ADMIN_SECRET=dev-admin-secret-change-in-production
SESSION_MAX_AGE_SECONDS=28800

# Cookie security (must be true in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
