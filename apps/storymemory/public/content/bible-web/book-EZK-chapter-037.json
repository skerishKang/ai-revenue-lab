    {
      "canonical_locator": "bible:web:EZK:37:10",
      "sequence": 21408,
      "chapter_label": "EZK 37",
      "verse_label": "10",
      "locator": {
        "book": "EZK",
        "chapter": 37,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 37,
          "verse": 10
        }
      ],
      "en": "So I prophesied as he commanded me, and the breath came into them, and they lived, and stood up on their feet, an exceedingly great army.",
      "ko": "이에 내가 그 명대로 대언하였더니 생기가 그들에게 들어가매 그들이 곧 살아 일어나서 서는데 극히 큰 군대더라",
      "source_text_hash": "6610cab09c7b28869bb2bf445ccbfc66eace079db5a576d271fd3cc8bc9e96a4",
      "translation_text_hash": "4313ed8d66675cd41337b08384b48b7fb3a8ee2667cfa8e60f0816752b30ae01",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이에 내가 그 명대로 대언하였더니 생기가 그들에게 들어가매 그들이 곧 살아 일어나서 서는데 극히 큰 군대더라"
      ],
      "raw_text_hashes": [
        "4313ed8d66675cd41337b08384b48b7fb3a8ee2667cfa8e60f0816752b30ae01"
      ]
