        "verse": 4
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 37,
          "verse": 4
        }
      ],
      "en": "Again he said to me, “Prophesy over these bones, and tell them, ‘You dry bones, hear the LORD’s word.",
      "ko": "또 내게 이르시되 너는 이 모든 뼈에게 대언하여 이르기를 너희 마른 뼈들아 여호와의 말씀을 들을찌어다",
      "source_text_hash": "eff30eed6399b155f41362143cb7f41a946778700ddc33f4dd8128065c03c40f",
      "translation_text_hash": "02fc80e631987da9811e47b5057354936a15b7d374d040ab0bdd43df08c88898",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 내게 이르시되 너는 이 모든 뼈에게 대언하여 이르기를 너희 마른 뼈들아 여호와의 말씀을 들을찌어다"
      ],
      "raw_text_hashes": [
        "02fc80e631987da9811e47b5057354936a15b7d374d040ab0bdd43df08c88898"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:37:5",
      "sequence": 21403,
      "chapter_label": "EZK 37",
      "verse_label": "5",
      "locator": {
        "book": "EZK",
        "chapter": 37,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 37,
          "verse": 5
        }
      ],
      "en": "The Lord GOD says to these bones: “Behold, I will cause breath to enter into you, and you will live.",
      "ko": "주 여호와께서 이 뼈들에게 말씀하시기를 내가 생기로 너희에게 들어가게 하리니 너희가 살리라",
      "source_text_hash": "0f726db94adc99f632bbdca1d107c0dad784555cbf97820ff828603ee96775e5",
      "translation_text_hash": "fa6553851045216b2803714055e1b097ee76e4eae99168084df596304db88aaa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주 여호와께서 이 뼈들에게 말씀하시기를 내가 생기로 너희에게 들어가게 하리니 너희가 살리라"
      ],
      "raw_text_hashes": [
        "fa6553851045216b2803714055e1b097ee76e4eae99168084df596304db88aaa"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:37:6",
      "sequence": 21404,
      "chapter_label": "EZK 37",
      "verse_label": "6",
      "locator": {
