        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 57,
          "verse": 12
        }
      ],
      "en": "I will declare your righteousness; and as for your works, they will not benefit you.",
      "ko": "너의 의를 내가 보이리라 너의 소위가 네게 무익하니라",
      "source_text_hash": "72b037852ca92bee553ea565695c3045ddd068a79669fc5e88f11a62ec383843",
      "translation_text_hash": "1fd986ab4be7944b8ad307272d48b17b7567d2cba3b46e15afcb0af684e618bf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너의 의를 내가 보이리라 너의 소위가 네게 무익하니라"
      ],
      "raw_text_hashes": [
        "1fd986ab4be7944b8ad307272d48b17b7567d2cba3b46e15afcb0af684e618bf"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:57:13",
      "sequence": 18779,
      "chapter_label": "ISA 57",
      "verse_label": "13",
      "locator": {
