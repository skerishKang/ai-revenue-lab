      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 상수리나무 사이, 모든 푸른 나무 아래서 음욕을 피우며 골짜기 가운데 바위 틈에서 자녀를 죽이는도다"
      ],
      "raw_text_hashes": [
