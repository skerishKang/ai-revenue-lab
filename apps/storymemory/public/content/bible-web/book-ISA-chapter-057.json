      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 길이 멀어서 피곤할찌라도 헛되다 아니함은 네 힘이 소성되었으므로 쇠약하여 가지 아니함이니라"
      ],
      "raw_text_hashes": [
        "dd1d9c00c961034a6c2e5b3c54ab742ee22773860a2c0478bd1a8eece9100bf6"
