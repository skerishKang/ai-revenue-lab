      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 9,
          "verse": 16
        }
      ],
      "en": "For where a last will and testament is, there must of necessity be the death of him who made it.",
      "ko": "유언은 유언한 자가 죽어야 되나니",
      "source_text_hash": "3734364179b297fcfaae677ad53aa4699ee2cbdd9347983b5bc138e698443fe2",
      "translation_text_hash": "a8a474e0646098eeaf1a0d03d4fd6b506a09c7ba3c894edac82849c38c6255e1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "유언은 유언한 자가 죽어야 되나니"
      ],
      "raw_text_hashes": [
        "a8a474e0646098eeaf1a0d03d4fd6b506a09c7ba3c894edac82849c38c6255e1"
      ]
    },
    {
      "canonical_locator": "bible:web:HEB:9:17",
      "sequence": 30119,
      "chapter_label": "HEB 9",
      "verse_label": "17",
      "locator": {
        "book": "HEB",
