        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 9,
          "verse": 6
        }
      ],
      "en": "Now these things having been thus prepared, the priests go in continually into the first tabernacle, accomplishing the services,",
      "ko": "이 모든 것을 이같이 예비하였으니 제사장들이 항상 첫장막에 들어가 섬기는 예를 행하고",
      "source_text_hash": "a5bb8058c2c17886f1eed20212cd7cd7878fc9db3b5e2ad56d0264c2c9493865",
      "translation_text_hash": "7d663b92bee1a7d3ffb2e87cc4c50a63025c438d08c9afacdd36ed064dcd4e7f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 모든 것을 이같이 예비하였으니 제사장들이 항상 첫장막에 들어가 섬기는 예를 행하고"
      ],
      "raw_text_hashes": [
        "7d663b92bee1a7d3ffb2e87cc4c50a63025c438d08c9afacdd36ed064dcd4e7f"
      ]
    },
    {
      "canonical_locator": "bible:web:HEB:9:7",
      "sequence": 30109,
      "chapter_label": "HEB 9",
      "verse_label": "7",
      "locator": {
