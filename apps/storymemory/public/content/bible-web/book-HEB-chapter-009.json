      "chapter_label": "HEB 9",
      "verse_label": "27",
      "locator": {
        "book": "HEB",
        "chapter": 9,
        "verse": 27
      },
      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 9,
          "verse": 27
        }
      ],
      "en": "Inasmuch as it is appointed for men to die once, and after this, judgment,",
      "ko": "한번 죽는 것은 사람에게 정하신 것이요 그 후에는 심판이 있으리니",
      "source_text_hash": "fab0012814db595afe706fa2b686282c87a21fa92559aeb14e8648bd08ccca7f",
      "translation_text_hash": "628c4f5265cd18543ecebfaa3b51babe2cf05fba3c969a358c29ba2a948a9209",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한번 죽는 것은 사람에게 정하신 것이요 그 후에는 심판이 있으리니"
      ],
      "raw_text_hashes": [
        "628c4f5265cd18543ecebfaa3b51babe2cf05fba3c969a358c29ba2a948a9209"
      ]
    },
    {
      "canonical_locator": "bible:web:HEB:9:28",
      "sequence": 30130,
      "chapter_label": "HEB 9",
      "verse_label": "28",
      "locator": {
        "book": "HEB",
        "chapter": 9,
        "verse": 28
      },
      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 9,
          "verse": 28
        }
