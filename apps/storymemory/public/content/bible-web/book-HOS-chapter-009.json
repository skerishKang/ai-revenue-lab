  "passages": [
    {
      "canonical_locator": "bible:web:HOS:9:1",
      "sequence": 22210,
      "chapter_label": "HOS 9",
      "verse_label": "1",
      "locator": {
        "book": "HOS",
        "chapter": 9,
        "verse": 1
