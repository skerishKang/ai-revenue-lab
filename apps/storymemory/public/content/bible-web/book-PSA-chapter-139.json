      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 139,
          "verse": 9
        }
      ],
      "en": "If I take the wings of the dawn, and settle in the uttermost parts of the sea,",
      "ko": "내가 새벽 날개를 치며 바다 끝에 가서 거할찌라도",
      "source_text_hash": "4eb227ff565cf03cb368faaa0cfb368689f41b51aad12dcdaa7daee4b5139638",
      "translation_text_hash": "16306ddc53b4783adf6620457c676f788f94a1a44b8213fd80477123b1836ac5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 새벽 날개를 치며 바다 끝에 가서 거할찌라도"
      ],
      "raw_text_hashes": [
        "16306ddc53b4783adf6620457c676f788f94a1a44b8213fd80477123b1836ac5"
      ]
    },
