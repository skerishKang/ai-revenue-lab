      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 139,
          "verse": 6
        }
      ],
      "en": "This knowledge is beyond me. It’s lofty. I can’t attain it.",
      "ko": "이 지식이 내게 너무 기이하니 높아서 내가 능히 미치지 못하나이다",
      "source_text_hash": "b2f4f30efb476eb5ea5d0a0384ee9e836c7743c075bfa68add9fa18640663b97",
      "translation_text_hash": "78dbd127eb6d2b8168e8828930fa9854ea4b0658f885587140479f715fee64dd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
