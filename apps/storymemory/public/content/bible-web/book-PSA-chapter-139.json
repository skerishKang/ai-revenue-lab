      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 139,
          "verse": 8
        }
      ],
      "en": "If I ascend up into heaven, you are there. If I make my bed in Sheol, behold, you are there!",
      "ko": "내가 하늘에 올라갈찌라도 거기 계시며 음부에 내 자리를 펼찌라도 거기 계시니이다",
      "source_text_hash": "396f8870704e739dde6704a3b39c6a219f2c0760383b211ebdfa8647953ed444",
      "translation_text_hash": "a449e015d9f81f17288c16210b47f2dea0466e87fee7ef92cb110cb6f021884d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 하늘에 올라갈찌라도 거기 계시며 음부에 내 자리를 펼찌라도 거기 계시니이다"
      ],
      "raw_text_hashes": [
        "a449e015d9f81f17288c16210b47f2dea0466e87fee7ef92cb110cb6f021884d"
      ]
