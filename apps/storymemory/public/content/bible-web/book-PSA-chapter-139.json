      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 나의 앉고 일어섬을 아시며 멀리서도 나의 생각을 통촉하시오며"
      ],
      "raw_text_hashes": [
        "c86e56183ee6d8a989663ea31a5383ba2a2fcd1dcf8b350e89aa90de21c1e393"
      ]
    },
