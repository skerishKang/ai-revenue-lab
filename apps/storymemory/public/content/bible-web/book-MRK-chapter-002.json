      "source_text_hash": "48c717dd9d5c91ab2792e19a3201748fc5bf8d2e719bf9c4cc03fab7b1255d49",
      "translation_text_hash": "09f86cd61ba9b03d4098193fb04a3d1b97356a8d60d7cb5f024bcdb48472f104",
