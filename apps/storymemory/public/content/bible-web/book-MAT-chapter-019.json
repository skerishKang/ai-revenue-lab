      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "예수께서 가라사대 모세가 너희 마음의 완악함을 인하여 아내 내어버림을 허락하였거니와 본래는 그렇지 아니하니라"
      ],
