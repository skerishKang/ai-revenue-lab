      "translation_text_hash": "90e91636e273fe1430ca30a4d56d3f6809587f1e544008bca65a07f788cf3dba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하늘은 기뻐하고 땅은 즐거워하며 바다와 거기 충만한 것은 외치며"
      ],
      "raw_text_hashes": [
