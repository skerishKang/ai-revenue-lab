      ],
      "en": "For the LORD is great, and greatly to be praised! He is to be feared above all gods.",
      "ko": "여호와는 광대하시니 극진히 찬양할 것이요 모든 신보다 경외할 것임이여",
      "source_text_hash": "9cc91d710144e07d5909e7c683472c59d0edacf031adfc07bab8c63b2e4eca54",
      "translation_text_hash": "ef673b17dfff573118574568ece4acbddbc839a7bf7880ca7ff241c054f6671f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와는 광대하시니 극진히 찬양할 것이요 모든 신보다 경외할 것임이여"
      ],
      "raw_text_hashes": [
        "ef673b17dfff573118574568ece4acbddbc839a7bf7880ca7ff241c054f6671f"
      ]
    },
