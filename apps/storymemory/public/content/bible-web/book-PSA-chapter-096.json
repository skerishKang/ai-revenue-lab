      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만방의 모든 신은 헛 것이요 여호와께서는 하늘을 지으셨음이로다"
      ],
      "raw_text_hashes": [
        "e3ded49728fbecdcf53a22504a0ec33836379b216d6a9b04318dfe5d84b3784d"
