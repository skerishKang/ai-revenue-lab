      "source_text_hash": "83f882ab3a67ee7b8a2abc6ac0d0ed3506b90824edbb8d9fcb7e6ddd15783818",
      "translation_text_hash": "db5e0bd7a352419b5d2d8f65b13e0f164c47c820c4a930c6bdc4765952830508",
      "translation_policy": "krv-1961-source-mapped",
