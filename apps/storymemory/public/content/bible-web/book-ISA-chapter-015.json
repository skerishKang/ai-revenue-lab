      "locator": {
        "book": "ISA",
        "chapter": 15,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 15,
          "verse": 6
        }
      ],
      "en": "For the waters of Nimrim will be desolate; for the grass has withered away, the tender grass fails, there is no green thing.",
      "ko": "니므림 물이 마르고 풀이 시들었으며 연한 풀이 말라 청청한 것이 없음이로다",
      "source_text_hash": "3962497e5e3e7a368dd2543c2dfd712c30c57e879c5deebd4a630c8bca5a628a",
      "translation_text_hash": "4edc7986a4ec725c993251d6dae355f7fb23684cc14beb9527d71808bd3486e6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "니므림 물이 마르고 풀이 시들었으며 연한 풀이 말라 청청한 것이 없음이로다"
      ],
      "raw_text_hashes": [
        "4edc7986a4ec725c993251d6dae355f7fb23684cc14beb9527d71808bd3486e6"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:15:7",
      "sequence": 17968,
      "chapter_label": "ISA 15",
      "verse_label": "7",
      "locator": {
