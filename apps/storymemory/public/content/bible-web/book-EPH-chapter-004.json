      "source_text_hash": "928f3cd283ec4c5698e1a052259b4b4532c41e65537b8f3a5fdb6791cee42f86",
      "translation_text_hash": "8478775dce497077e37b945771e95e4eee582c3502c293c924d423eca85e53e6",
