        {
          "book": "2CH",
          "chapter": 14,
          "verse": 3
        }
      ],
      "en": "for he took away the foreign altars and the high places, broke down the pillars, cut down the Asherah poles,",
      "ko": "이방 제단과 산당을 없이하고 주상을 훼파하며 아세라 상을 찍고",
      "source_text_hash": "1dc013c9d77f19c361ea58707a048e70b001f293101bf8266f69221451e29767",
      "translation_text_hash": "afe95dd3ba44851f8ad308de8a49759b05fafac7063c73a017351245c5a7a53e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이방 제단과 산당을 없이하고 주상을 훼파하며 아세라 상을 찍고"
      ],
      "raw_text_hashes": [
        "afe95dd3ba44851f8ad308de8a49759b05fafac7063c73a017351245c5a7a53e"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:14:4",
      "sequence": 11480,
