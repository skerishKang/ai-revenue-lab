        "verse": 9
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 14,
          "verse": 9
        }
      ],
      "en": "Zerah the Ethiopian came out against them with an army of a million troops and three hundred chariots, and he came to Mareshah.",
      "ko": "구스 사람 세라가 저희를 치려하여 군사 백만과 병거 삼백승을 거느리고 마레사에 이르매",
      "source_text_hash": "0e2fe92da04338b5e1405ce472b4d0a7759c16f6b79176289f8ede9c72a0f31a",
      "translation_text_hash": "fe012f47de4a4a80264cb633624ed9f354a2e5b0c35fb3dd9e2abbbc72a644ec",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "구스 사람 세라가 저희를 치려하여 군사 백만과 병거 삼백승을 거느리고 마레사에 이르매"
      ],
      "raw_text_hashes": [
        "fe012f47de4a4a80264cb633624ed9f354a2e5b0c35fb3dd9e2abbbc72a644ec"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:14:10",
      "sequence": 11486,
      "chapter_label": "2CH 14",
      "verse_label": "10",
      "locator": {
        "book": "2CH",
