      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "But we know that the law is good if a person uses it lawfully,",
      "ko": "그러나 사람이 율법을 법 있게 쓰면 율법은 선한 것인줄 우리는 아노라",
      "source_text_hash": "f4d6f9199ae43761fea1985b80827010fd54042bd1f940e4c02df4686527cf6a",
      "translation_text_hash": "92aefd2cb713bc022b69d5c1445f692c86a6f5ecdbeba2ccdf8192b5a5ed06cd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
