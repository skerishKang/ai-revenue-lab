        "verse": 9
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 3,
          "verse": 9
        }
      ],
      "en": "(The Sidonians call Hermon Sirion, and the Amorites call it Senir.)",
      "ko": "(헤르몬산을 시돈 사람은 시룐이라 칭하고 아모리 족속은 스닐이라 칭하였느니라)",
      "source_text_hash": "cf5240d1b58a9fb0e641463819e3843fee1ca9362d3d9d06c69ed23e75a31a99",
      "translation_text_hash": "de487b77e61611d1981b0ac177ff4818e97f732c4e8182e5e8cd3eb2437109dd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "(헤르몬산을 시돈 사람은 시룐이라 칭하고 아모리 족속은 스닐이라 칭하였느니라)"
      ],
      "raw_text_hashes": [
