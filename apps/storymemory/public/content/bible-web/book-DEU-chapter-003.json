      "sequence": 4994,
      "chapter_label": "DEU 3",
      "verse_label": "18",
      "locator": {
        "book": "DEU",
        "chapter": 3,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 3,
          "verse": 18
        }
      ],
      "en": "I commanded you at that time, saying, “The LORD your God has given you this land to possess it. All of you men of valor shall pass over armed before your brothers, the children of Israel.",
      "ko": "그 때에 내가 이 땅을 받은 너희에게 명하여 이르기를 너희의 하나님 여호와께서 이 땅을 너희에게 주어 기업이 되게 하셨은즉 너희 군인들은 무장하고 너희의 형제 이스라엘 자손의 선봉이 되어 건너가되",
      "source_text_hash": "d5629e77bee2da88743155c2bef59f34d826850af8f4383d33a89b3a0d28282d",
      "translation_text_hash": "27e27b288eec96b70b44dba1231d88d8803ba7d383b8c89dd3d15e70091a778c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 때에 내가 이 땅을 받은 너희에게 명하여 이르기를 너희의 하나님 여호와께서 이 땅을 너희에게 주어 기업이 되게 하셨은즉 너희 군인들은 무장하고 너희의 형제 이스라엘 자손의 선봉이 되어 건너가되"
      ],
      "raw_text_hashes": [
        "27e27b288eec96b70b44dba1231d88d8803ba7d383b8c89dd3d15e70091a778c"
      ]
