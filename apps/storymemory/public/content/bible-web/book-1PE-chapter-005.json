    {
      "canonical_locator": "bible:web:1PE:5:8",
      "sequence": 30470,
      "chapter_label": "1PE 5",
      "verse_label": "8",
      "locator": {
        "book": "1PE",
        "chapter": 5,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1PE",
          "chapter": 5,
          "verse": 8
        }
      ],
      "en": "Be sober and self-controlled. Be watchful. Your adversary, the devil, walks around like a roaring lion, seeking whom he may devour.",
      "ko": "근신하라 깨어라 너희 대적 마귀가 우는 사자 같이 두루 다니며 삼킬 자를 찾나니",
      "source_text_hash": "538bdf4e55eadc3c88ea38adc3636661cc49a3053f63d850dfb94f8d7bed615c",
      "translation_text_hash": "88e6ee900080658e30e82c2989424f7649f0886731c8ae6b2777d7c64ec9112a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "근신하라 깨어라 너희 대적 마귀가 우는 사자 같이 두루 다니며 삼킬 자를 찾나니"
      ],
      "raw_text_hashes": [
        "88e6ee900080658e30e82c2989424f7649f0886731c8ae6b2777d7c64ec9112a"
      ]
    },
    {
      "canonical_locator": "bible:web:1PE:5:9",
      "sequence": 30471,
      "chapter_label": "1PE 5",
      "verse_label": "9",
      "locator": {
        "book": "1PE",
