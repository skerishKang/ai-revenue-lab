      ],
      "raw_text_hashes": [
        "0cdf38c8a5ab227428d3581e9bb87fcb0751c01b9ef72e9820aeda4cbc792ef8"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:1:9",
      "sequence": 1542,
      "chapter_label": "EXO 1",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
