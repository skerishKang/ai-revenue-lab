      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님께서 허락하시면 우리가 이것을 하리라"
      ],
      "raw_text_hashes": [
        "538ef4c8a3eb93a5f5edf576a35b261176a30c76698fe9a7548689b5aec65a76"
      ]
