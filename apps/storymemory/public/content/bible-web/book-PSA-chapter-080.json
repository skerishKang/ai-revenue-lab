      "translation_text_hash": "f3079876d44eca52b463eb0ae58e146befd051f86e76910d5e139aa3078a49e5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
