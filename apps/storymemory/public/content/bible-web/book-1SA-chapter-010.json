        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 10,
          "verse": 9
        }
      ],
      "en": "It was so, that when he had turned his back to go from Samuel, God gave him another heart; and all those signs happened that day.",
      "ko": "그가 사무엘에게서 떠나려고 몸을 돌이킬 때에 하나님이 새 마음을 주셨고 그 날 그 징조도 다 응하니라",
      "source_text_hash": "88082290ab54273d2d7c947b0e86cb0c5f63131aac5bd249ede5fd030f35ca88",
      "translation_text_hash": "18fbfffcdd8b92ce51962ada76c02061efe31cd833f886aff1082c6cc033f86e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 사무엘에게서 떠나려고 몸을 돌이킬 때에 하나님이 새 마음을 주셨고 그 날 그 징조도 다 응하니라"
      ],
      "raw_text_hashes": [
        "18fbfffcdd8b92ce51962ada76c02061efe31cd833f886aff1082c6cc033f86e"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:10:10",
      "sequence": 7429,
      "chapter_label": "1SA 10",
      "verse_label": "10",
      "locator": {
        "book": "1SA",
