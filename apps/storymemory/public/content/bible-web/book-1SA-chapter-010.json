        "verse": 4
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 10,
          "verse": 4
        }
      ],
      "en": "They will greet you and give you two loaves of bread, which you shall receive from their hand.",
      "ko": "그들이 네게 문안하고 떡 두덩이를 주겠고 너는 그 손에서 받으리라",
      "source_text_hash": "493dca762bea6f45fe225a01a8304194726a8e3345a016160123645914cd74a2",
      "translation_text_hash": "849a3da5fd9a0ac7081cc5aa7a4e5cf9f7a1d956bc02360de7084458882c08b8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들이 네게 문안하고 떡 두덩이를 주겠고 너는 그 손에서 받으리라"
      ],
      "raw_text_hashes": [
        "849a3da5fd9a0ac7081cc5aa7a4e5cf9f7a1d956bc02360de7084458882c08b8"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:10:5",
      "sequence": 7424,
      "chapter_label": "1SA 10",
      "verse_label": "5",
      "locator": {
        "book": "1SA",
        "chapter": 10,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 10,
          "verse": 5
        }
      ],
      "en": "“After that you will come to the hill of God, where the garrison of the Philistines is; and it will happen, when you have come there to the city, that you will meet a band of prophets coming down from the high place with a lute, a tambourine, a pipe, and a harp before them; and they will be prophesying.",
      "ko": "그 후에 네가 하나님의 산에 이르리니 그곳에는 블레셋 사람의 영문이 있느니라 네가 그리로 가서 그 성읍으로 들어갈 때에 선지자의 무리가 산당에서부터 비파와 소고와 저와 수금을 앞세우고 예언하며 내려오는 것을 만날 것이요",
      "source_text_hash": "6b93bcf689b7c9892c334b8a8c0e5bd4e9c59e508c4283c33bc4b35092334a96",
      "translation_text_hash": "28d18ef48f734cf59fdf9caf9a07292f69ec885f6944a3301b39ec9fb2e6f613",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 후에 네가 하나님의 산에 이르리니 그곳에는 블레셋 사람의 영문이 있느니라 네가 그리로 가서 그 성읍으로 들어갈 때에 선지자의 무리가 산당에서부터 비파와 소고와 저와 수금을 앞세우고 예언하며 내려오는 것을 만날 것이요"
      ],
      "raw_text_hashes": [
        "28d18ef48f734cf59fdf9caf9a07292f69ec885f6944a3301b39ec9fb2e6f613"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:10:6",
      "sequence": 7425,
      "chapter_label": "1SA 10",
      "verse_label": "6",
      "locator": {
        "book": "1SA",
        "chapter": 10,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 10,
          "verse": 6
        }
      ],
      "en": "Then the LORD’s Spirit will come mightily on you, then you will prophesy with them and will be turned into another man.",
      "ko": "네게는 여호와의 신이 크게 임하리니 너도 그들과 함께 예언을 하고 변하여 새 사람이 되리라",
      "source_text_hash": "532eeeb6f7a6e77d5af5e4b4a23b4b56526f14c47fb7200f0288082e95c73e3e",
      "translation_text_hash": "dd1c6e7b2c7ec23b2bfb993cf44b1a3dad828db641e26683713a9972b6e04786",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네게는 여호와의 신이 크게 임하리니 너도 그들과 함께 예언을 하고 변하여 새 사람이 되리라"
      ],
      "raw_text_hashes": [
        "dd1c6e7b2c7ec23b2bfb993cf44b1a3dad828db641e26683713a9972b6e04786"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:10:7",
      "sequence": 7426,
      "chapter_label": "1SA 10",
      "verse_label": "7",
      "locator": {
        "book": "1SA",
        "chapter": 10,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 10,
          "verse": 7
        }
      ],
      "en": "Let it be, when these signs have come to you, that you do what is appropriate for the occasion; for God is with you.",
      "ko": "이 징조가 네게 임하거든 너는 기회를 따라 행하라 하나님이 너와 함께 하시느니라",
      "source_text_hash": "0076c016728d20ba4d6da9f051a851166965bdcb1c983eddcb36adf8e05c708f",
      "translation_text_hash": "7a349d81569ad357d9f5062c081a226ec69499911d047b950ba1a335366c7506",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 징조가 네게 임하거든 너는 기회를 따라 행하라 하나님이 너와 함께 하시느니라"
      ],
      "raw_text_hashes": [
        "7a349d81569ad357d9f5062c081a226ec69499911d047b950ba1a335366c7506"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:10:8",
      "sequence": 7427,
      "chapter_label": "1SA 10",
      "verse_label": "8",
      "locator": {
