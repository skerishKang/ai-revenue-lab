        "verse": 12
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 49,
          "verse": 12
        }
      ],
      "en": "His eyes will be red with wine, his teeth white with milk.",
      "ko": "그 눈은 포도주로 인하여 붉겠고 그 이는 우유로 인하여 희리로다",
      "source_text_hash": "fa636f936007eb465fe9560a0911e0188a59f77918466278adadd88b22c41fc0",
      "translation_text_hash": "0a51d479f00c484e2943c895267371fa2aff9412f48a91c36cd52985d87b828d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 눈은 포도주로 인하여 붉겠고 그 이는 우유로 인하여 희리로다"
      ],
      "raw_text_hashes": [
        "0a51d479f00c484e2943c895267371fa2aff9412f48a91c36cd52985d87b828d"
      ]
    },
    {
