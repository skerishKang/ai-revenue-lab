      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 49,
          "verse": 14
        }
      ],
      "en": "“Issachar is a strong donkey, lying down between the saddlebags.",
      "ko": "잇사갈은 양의 우리 사이에 꿇어 앉은 건장한 나귀로다",
      "source_text_hash": "2d94f28967e4828e6fd89252f84409564086a85d346e92e1338391b208a1697c",
      "translation_text_hash": "602c29bee0678e25d56c8e2fbb0e5fb91a2b0d00d4af3a72ad3be9b4acc796cf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
