    {
      "canonical_locator": "bible:web:JOS:5:6",
      "sequence": 5941,
      "chapter_label": "JOS 5",
      "verse_label": "6",
      "locator": {
        "book": "JOS",
        "chapter": 5,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 5,
          "verse": 6
        }
      ],
      "en": "For the children of Israel walked forty years in the wilderness until all the nation, even the men of war who came out of Egypt, were consumed, because they didn’t listen to the LORD’s voice. The LORD swore to them that he wouldn’t let them see the land which the LORD swore to their fathers that he would give us, a land flowing with milk and honey.",
      "ko": "이스라엘 자손들이 여호와의 말씀을 청종치 아니하므로 여호와께서 그들에게 대하여 맹세하사 그들의 열조에게 맹세하여 우리에게 주마 하신 땅 곧 젖과 꿀이 흐르는 땅을 그들로 보지 못하게 하리라 하시매 애굽에서 나온 족속 곧 군사들이 다 멸절하기까지 사십년 동안을 광야에 행하였더니",
      "source_text_hash": "b6d7879e936467937bbc87e8c17c086b28cd2852bf22542f737e680aa89729a1",
      "translation_text_hash": "85a1a0b4daee7018527ec4eda0c1d5e3dbe0b3e0af199d8cab80b09384a177a0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손들이 여호와의 말씀을 청종치 아니하므로 여호와께서 그들에게 대하여 맹세하사 그들의 열조에게 맹세하여 우리에게 주마 하신 땅 곧 젖과 꿀이 흐르는 땅을 그들로 보지 못하게 하리라 하시매 애굽에서 나온 족속 곧 군사들이 다 멸절하기까지 사십년 동안을 광야에 행하였더니"
      ],
      "raw_text_hashes": [
        "85a1a0b4daee7018527ec4eda0c1d5e3dbe0b3e0af199d8cab80b09384a177a0"
      ]
    },
    {
      "canonical_locator": "bible:web:JOS:5:7",
      "sequence": 5942,
      "chapter_label": "JOS 5",
      "verse_label": "7",
      "locator": {
        "book": "JOS",
