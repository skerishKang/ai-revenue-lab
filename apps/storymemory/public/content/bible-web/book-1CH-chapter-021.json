      "locator": {
        "book": "1CH",
        "chapter": 21,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 21,
          "verse": 25
        }
      ],
      "en": "So David gave to Ornan six hundred shekels of gold by weight for the place.",
      "ko": "그 기지 값으로 금 육백 세겔을 달아 오르난에게 주고",
      "source_text_hash": "07f05ad31e67ffc7e0a80958d2f8864fc5600b84cf036f390fab42a43ed74332",
      "translation_text_hash": "9d35cd19e9ddff0993b6e28e12d09bab781ac3e2a50660f30f650be15a07cfd7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
