      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아나니아라 하는 사람이 그 아내 삽비라로 더불어 소유를 팔아"
      ],
      "raw_text_hashes": [
        "71a50a974ee15f0821862a3d0bbe3bda2924852d7f80c4e2bb264a81c3f60223"
      ]
    },
    {
