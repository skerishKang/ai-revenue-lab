      "translation_text_hash": "246e69f17a9bc064463c03e81d3171d25ed4cba1a2bdd81daf088fe841f9f3cc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 무덤에 내려가는 자와 함께 인정되고 힘이 없는 사람과 같으며"
      ],
      "raw_text_hashes": [
        "246e69f17a9bc064463c03e81d3171d25ed4cba1a2bdd81daf088fe841f9f3cc"
      ]
    },
    {
