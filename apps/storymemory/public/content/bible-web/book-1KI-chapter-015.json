      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 15,
          "verse": 6
        }
      ],
      "en": "Now there was war between Rehoboam and Jeroboam all the days of his life.",
      "ko": "르호보암과 여로보암 사이에 사는 날 동안 전쟁이 있었더니",
      "source_text_hash": "803d93697230011b93cf6527fb98bda395ecd4475869c7fae7808bd25b5b70e8",
      "translation_text_hash": "da28b08eb996449e2b8c1ccc6dc1bdf314f7d6783c896f8a43f80f1d0f6c5f49",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "르호보암과 여로보암 사이에 사는 날 동안 전쟁이 있었더니"
      ],
      "raw_text_hashes": [
        "da28b08eb996449e2b8c1ccc6dc1bdf314f7d6783c896f8a43f80f1d0f6c5f49"
      ]
    },
    {
      "canonical_locator": "bible:web:1KI:15:7",
      "sequence": 9257,
      "chapter_label": "1KI 15",
