      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 15,
          "verse": 11
        }
      ],
      "en": "Asa did that which was right in the LORD’s eyes, as David his father did.",
      "ko": "아사가 그 조상 다윗 같이 여호와 보시기에 정직하게 행하여",
      "source_text_hash": "74fff18c080c11aa5e285f228cf6ce80a1c19b1a4362c9a372e8fc36ba7a7f4b",
      "translation_text_hash": "3f7f2387d0ce65c1c736fbc688897ac13414ce48df24245cea163789b6d46760",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아사가 그 조상 다윗 같이 여호와 보시기에 정직하게 행하여"
      ],
      "raw_text_hashes": [
        "3f7f2387d0ce65c1c736fbc688897ac13414ce48df24245cea163789b6d46760"
      ]
    },
    {
      "canonical_locator": "bible:web:1KI:15:12",
      "sequence": 9262,
      "chapter_label": "1KI 15",
      "verse_label": "12",
      "locator": {
        "book": "1KI",
