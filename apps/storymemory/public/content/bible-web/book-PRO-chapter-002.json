      "translation_text_hash": "04eca56d2ce04412e35a073013209ec142adc41bddc5506ecbab49ebb541aa2c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
