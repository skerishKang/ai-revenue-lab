      "source_text_hash": "e67719523b3b8845a3595dcbabc2ceeb5fa303ba51cf1d03c2c07dcadd9b071b",
      "translation_text_hash": "104938bf401e7aaf3f52eeaf4b77ae52da21643e18d18001da65e4a4ada432fe",
