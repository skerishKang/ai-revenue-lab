    {
      "canonical_locator": "bible:web:NEH:4:16",
      "sequence": 12376,
      "chapter_label": "NEH 4",
      "verse_label": "16",
      "locator": {
        "book": "NEH",
        "chapter": 4,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "NEH",
          "chapter": 4,
          "verse": 16
        }
      ],
      "en": "From that time forth, half of my servants did the work, and half of them held the spears, the shields, the bows, and the coats of mail; and the rulers were behind all the house of Judah.",
      "ko": "그 때로부터 내 종자의 절반은 역사하고 절반은 갑옷을 입고 창과 방패와 활을 가졌고 민장은 유다 온 족속의 뒤에 있었으며",
      "source_text_hash": "19f4e833e095f3e4332eb89c30c7d9f11817b3519ed40be0d52ba68f6e09a60f",
      "translation_text_hash": "cd6aca7ea19fc9afdf5f82e69330a003f1d7b0498ecc7b82516d60950d879b2b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 때로부터 내 종자의 절반은 역사하고 절반은 갑옷을 입고 창과 방패와 활을 가졌고 민장은 유다 온 족속의 뒤에 있었으며"
      ],
      "raw_text_hashes": [
        "cd6aca7ea19fc9afdf5f82e69330a003f1d7b0498ecc7b82516d60950d879b2b"
      ]
