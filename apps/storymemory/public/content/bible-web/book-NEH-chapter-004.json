    {
      "canonical_locator": "bible:web:NEH:4:17",
      "sequence": 12377,
      "chapter_label": "NEH 4",
      "verse_label": "17",
      "locator": {
        "book": "NEH",
        "chapter": 4,
        "verse": 17
      },
      "raw_locator": [
        {
          "book": "NEH",
          "chapter": 4,
          "verse": 17
        }
      ],
      "en": "Those who built the wall, and those who bore burdens loaded themselves; everyone with one of his hands did the work, and with the other held his weapon.",
      "ko": "성을 건축하는 자와 담부하는 자는 다 각각 한 손으로 일을 하며 한 손에는 병기를 잡았는데",
      "source_text_hash": "aa4d8d989fafd6bbcb383b6521cadd6ec4e787aa03cd224541f68123744fe083",
      "translation_text_hash": "54011fc734694ffdbbe952b7982752a5fde9e4e8525347badf65298149493513",
