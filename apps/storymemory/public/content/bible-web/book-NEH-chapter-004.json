    {
      "canonical_locator": "bible:web:NEH:4:13",
      "sequence": 12373,
      "chapter_label": "NEH 4",
      "verse_label": "13",
      "locator": {
        "book": "NEH",
        "chapter": 4,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "NEH",
          "chapter": 4,
          "verse": 13
        }
      ],
      "en": "Therefore I set guards in the lowest parts of the space behind the wall, in the open places. I set the people by family groups with their swords, their spears, and their bows.",
      "ko": "내가 성 뒤 낮고 넓은 곳에 백성으로 그 종족을 따라 칼과 창과 활을 가지고 서게 하고",
      "source_text_hash": "fc350f6f6148150b54e1adf314d36daad1041dfed4b7e629f9c068618eeaa687",
      "translation_text_hash": "7bc30a20ef442d154fed3516a133e207195825e31c48bb3d3d5360979ad937ad",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 성 뒤 낮고 넓은 곳에 백성으로 그 종족을 따라 칼과 창과 활을 가지고 서게 하고"
      ],
      "raw_text_hashes": [
