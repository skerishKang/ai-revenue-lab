      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브람이 또 가로되 주께서 내게 씨를 아니주셨으니 내 집에서 길리운 자가 나의 후사가 될것이니이다"
      ],
      "raw_text_hashes": [
        "8484392f979c627df54e332dd096adcccb7b9b7cc47ba88b9dff776714f439b0"
