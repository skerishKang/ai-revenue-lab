      ]
    },
    {
      "canonical_locator": "bible:web:2KI:19:22",
      "sequence": 10084,
      "chapter_label": "2KI 19",
      "verse_label": "22",
      "locator": {
        "book": "2KI",
        "chapter": 19,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 19,
          "verse": 22
        }
      ],
      "en": "Whom have you defied and blasphemed? Against whom have you exalted your voice and lifted up your eyes on high? Against the Holy One of Israel!",
      "ko": "네가 누구를 꾸짖었으며 훼방하였느냐 누구를 향하여 소리를 높였으며 눈을 높이 떴느냐 이스라엘의 거룩한 자에게 그리하였도다",
      "source_text_hash": "6d0d3baed9376d27bbfe992b7923e386ade5c459460b65c98d1786f6950c60a8",
      "translation_text_hash": "1ee8472dbc6533b3ec5fa8c8874a984326fb72245e7421804b723ba2d1a8f473",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 누구를 꾸짖었으며 훼방하였느냐 누구를 향하여 소리를 높였으며 눈을 높이 떴느냐 이스라엘의 거룩한 자에게 그리하였도다"
      ],
      "raw_text_hashes": [
        "1ee8472dbc6533b3ec5fa8c8874a984326fb72245e7421804b723ba2d1a8f473"
