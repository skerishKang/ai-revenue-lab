      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 19,
          "verse": 27
        }
      ],
      "en": "But I know your sitting down, your going out, your coming in, and your raging against me.",
      "ko": "네 거처와 네 출입과 네가 내게 향한 분노를 내가 다 아노니",
      "source_text_hash": "9e2858945d4f20faa9b7c622e86adc9bfc0d58507531a57c7bc5025a47b42f44",
      "translation_text_hash": "8a33cfcc80a088e525b6dc0a26d4b2a4d1d18e87dfa860719cf865fefa75a22b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 거처와 네 출입과 네가 내게 향한 분노를 내가 다 아노니"
      ],
      "raw_text_hashes": [
        "8a33cfcc80a088e525b6dc0a26d4b2a4d1d18e87dfa860719cf865fefa75a22b"
      ]
