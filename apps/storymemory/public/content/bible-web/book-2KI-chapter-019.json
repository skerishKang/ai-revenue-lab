    {
      "canonical_locator": "bible:web:2KI:19:23",
      "sequence": 10085,
      "chapter_label": "2KI 19",
      "verse_label": "23",
      "locator": {
        "book": "2KI",
        "chapter": 19,
        "verse": 23
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 19,
          "verse": 23
        }
      ],
      "en": "By your messengers, you have defied the Lord, and have said, “With the multitude of my chariots, I have come up to the height of the mountains, to the innermost parts of Lebanon, and I will cut down its tall cedars and its choice cypress trees; and I will enter into his farthest lodging place, the forest of his fruitful field.",
      "ko": "네가 사자로 주를 훼방하여 이르기를 내가 많은 병거를 거느리고 여러 산꼭대기에 올라가며 레바논 깊은 곳에 이르러 높은 백향목과 아름다운 잣나무를 베고 내가 그 지경 끝에 들어가며 그 동산의 무성한 수풀에 이르리라",
      "source_text_hash": "dc0b685b4bee30b95d54edb8d4fd1312114319daf44b539f6f4602d27df9e66b",
      "translation_text_hash": "289fa1287de0e38ed28bd3f1f9b66563b10888601545f805e5552e63d1ad63c7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 사자로 주를 훼방하여 이르기를 내가 많은 병거를 거느리고 여러 산꼭대기에 올라가며 레바논 깊은 곳에 이르러 높은 백향목과 아름다운 잣나무를 베고 내가 그 지경 끝에 들어가며 그 동산의 무성한 수풀에 이르리라"
      ],
      "raw_text_hashes": [
        "289fa1287de0e38ed28bd3f1f9b66563b10888601545f805e5552e63d1ad63c7"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:19:24",
      "sequence": 10086,
      "chapter_label": "2KI 19",
      "verse_label": "24",
      "locator": {
        "book": "2KI",
        "chapter": 19,
        "verse": 24
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 19,
          "verse": 24
        }
      ],
      "en": "I have dug and drunk strange waters, and I will dry up all the rivers of Egypt with the sole of my feet.”",
      "ko": "내가 땅을 파서 이방의 물을 마셨고 나의 발바닥으로 애굽의 모든 하수를 말렸노라 하였도다",
      "source_text_hash": "a2e20a83c77901cae4643843953112ecb628d2c65253814531805deec6ffe3fb",
      "translation_text_hash": "757c4e51eb525c8d7a35387d9488c4e7ae5e391c79099dcffcc6219f5ee05bba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 땅을 파서 이방의 물을 마셨고 나의 발바닥으로 애굽의 모든 하수를 말렸노라 하였도다"
      ],
      "raw_text_hashes": [
