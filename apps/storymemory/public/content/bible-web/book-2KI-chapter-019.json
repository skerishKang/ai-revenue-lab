        }
      ],
      "en": "So the servants of King Hezekiah came to Isaiah.",
      "ko": "이와 같이 히스기야왕의 신복이 이사야에게 나아가니",
      "source_text_hash": "63894251e995a2c776deef4f963468016b924b3ecc1dea5ddfb76e202fb9d864",
      "translation_text_hash": "3bbecf623fc21e11aa63996506dc0fef0a9c46e9de09e410f5a60e4177da03de",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이와 같이 히스기야왕의 신복이 이사야에게 나아가니"
      ],
      "raw_text_hashes": [
        "3bbecf623fc21e11aa63996506dc0fef0a9c46e9de09e410f5a60e4177da03de"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:19:6",
      "sequence": 10068,
      "chapter_label": "2KI 19",
