        "verse": 9
      },
      "raw_locator": [
        {
          "book": "ECC",
          "chapter": 7,
          "verse": 9
        }
      ],
      "en": "Don’t be hasty in your spirit to be angry, for anger rests in the bosom of fools.",
      "ko": "급한 마음으로 노를 발하지 말라 노는 우매자의 품에 머무름이니라",
      "source_text_hash": "f4ff667ca5849d041bac1f4e557125ea5c29d134aab4f39aa8a72c4e9e9c7784",
      "translation_text_hash": "e20e2688557a4fd5c0062952afc58650bbbdfa08039b1496c7ab968f28d79f84",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "급한 마음으로 노를 발하지 말라 노는 우매자의 품에 머무름이니라"
      ],
      "raw_text_hashes": [
        "e20e2688557a4fd5c0062952afc58650bbbdfa08039b1496c7ab968f28d79f84"
      ]
    },
    {
      "canonical_locator": "bible:web:ECC:7:10",
      "sequence": 17440,
      "chapter_label": "ECC 7",
      "verse_label": "10",
      "locator": {
