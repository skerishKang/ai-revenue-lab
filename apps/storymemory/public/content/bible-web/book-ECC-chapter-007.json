        "chapter": 7,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "ECC",
          "chapter": 7,
          "verse": 3
        }
      ],
      "en": "Sorrow is better than laughter; for by the sadness of the face the heart is made good.",
      "ko": "슬픔이 웃음보다 나음은 얼굴에 근심함으로 마음이 좋게 됨이니라",
      "source_text_hash": "0ff929849d0a6a8980e31efa46000b61fcb98a26ae65280978eb71d4bd817401",
      "translation_text_hash": "532db69f705f53f25dc59f47e823b85fc406b61b433ca8c9a99713c168dbb3dc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "슬픔이 웃음보다 나음은 얼굴에 근심함으로 마음이 좋게 됨이니라"
      ],
      "raw_text_hashes": [
        "532db69f705f53f25dc59f47e823b85fc406b61b433ca8c9a99713c168dbb3dc"
      ]
    },
    {
      "canonical_locator": "bible:web:ECC:7:4",
      "sequence": 17434,
      "chapter_label": "ECC 7",
