      "raw_locator": [
        {
          "book": "ECC",
          "chapter": 7,
          "verse": 8
        }
      ],
      "en": "Better is the end of a thing than its beginning. The patient in spirit is better than the proud in spirit.",
      "ko": "일의 끝이 시작보다 낫고 참는 마음이 교만한 마음보다 나으니",
      "source_text_hash": "1a7585f962f70a73f30b5711fb5f8239688a7d521b4ec4d807875dc9f17560da",
      "translation_text_hash": "e62e7141c8762c1d98e1debc65bcc3953018eb4df68a36ccf023c986ef63d155",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "일의 끝이 시작보다 낫고 참는 마음이 교만한 마음보다 나으니"
      ],
      "raw_text_hashes": [
        "e62e7141c8762c1d98e1debc65bcc3953018eb4df68a36ccf023c986ef63d155"
      ]
    },
    {
      "canonical_locator": "bible:web:ECC:7:9",
      "sequence": 17439,
      "chapter_label": "ECC 7",
      "verse_label": "9",
      "locator": {
        "book": "ECC",
