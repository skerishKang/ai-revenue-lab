        "verse": 13
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 4,
          "verse": 13
        }
      ],
      "en": "It is because of the sins of her prophets and the iniquities of her priests, that have shed the blood of the just in the middle of her.",
      "ko": "그 선지자들의 죄와 제사장들의 죄악을 인함이니 저희가 성읍 중에서 의인의 피를 흘렸도다",
      "source_text_hash": "58ed34a1f3f5b5ec5a60fd1b1cb21669825de3f782068caa7cc70647c04f0b51",
      "translation_text_hash": "d89784cb97fc4cfc4ed78d1bd8fcfe678239efb1dddec97b23a85e66be5c1f68",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 선지자들의 죄와 제사장들의 죄악을 인함이니 저희가 성읍 중에서 의인의 피를 흘렸도다"
      ],
      "raw_text_hashes": [
        "d89784cb97fc4cfc4ed78d1bd8fcfe678239efb1dddec97b23a85e66be5c1f68"
