        "verse": 4
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 4,
          "verse": 4
        }
      ],
      "en": "The tongue of the nursing child clings to the roof of his mouth for thirst. The young children ask for bread, and no one breaks it for them.",
      "ko": "젖먹이가 목말라서 혀가 입천장에 붙음이여 어린 아이가 떡을 구하나 떼어 줄 사람이 없도다",
      "source_text_hash": "c7a4e7495bd9096ac30a10a4900c45ac264db2be551e23015e5b530d0fd5ac53",
      "translation_text_hash": "23c3d78808d33629886b9648743d27f21ec6b1a02a4e2751a8bbff8695a65ea3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "젖먹이가 목말라서 혀가 입천장에 붙음이여 어린 아이가 떡을 구하나 떼어 줄 사람이 없도다"
      ],
      "raw_text_hashes": [
        "23c3d78808d33629886b9648743d27f21ec6b1a02a4e2751a8bbff8695a65ea3"
      ]
    },
    {
      "canonical_locator": "bible:web:LAM:4:5",
      "sequence": 20426,
      "chapter_label": "LAM 4",
