        "verse": 10
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 4,
          "verse": 10
        }
      ],
      "en": "The hands of the pitiful women have boiled their own children. They were their food in the destruction of the daughter of my people.",
      "ko": "처녀 내 백성의 멸망할 때에 자비한 부녀가 손으로 자기 자녀를 삶아 식물을 삼았도다",
      "source_text_hash": "1751ef03fba2370b403fb0eb30c0d6aa586259a5e71246e4570b7a9d850c0e6d",
      "translation_text_hash": "aced918fbf6db6bbe5de18b597bcba4fc178f201af3fc699a2d03f210d8d5641",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "처녀 내 백성의 멸망할 때에 자비한 부녀가 손으로 자기 자녀를 삶아 식물을 삼았도다"
      ],
      "raw_text_hashes": [
        "aced918fbf6db6bbe5de18b597bcba4fc178f201af3fc699a2d03f210d8d5641"
      ]
    },
    {
      "canonical_locator": "bible:web:LAM:4:11",
      "sequence": 20432,
      "chapter_label": "LAM 4",
      "verse_label": "11",
      "locator": {
