      "sequence": 20443,
      "chapter_label": "LAM 4",
      "verse_label": "22",
      "locator": {
        "book": "LAM",
        "chapter": 4,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 4,
          "verse": 22
        }
      ],
      "en": "The punishment of your iniquity is accomplished, daughter of Zion. He will no more carry you away into captivity. He will visit your iniquity, daughter of Edom. He will uncover your sins.",
      "ko": "처녀 시온아 네 죄악의 형벌이 다하였으니 주께서 다시는 너로 사로잡혀 가지 않게 하시리로다 처녀 에돔아 주께서 네 죄악을 벌하시며 네 허물을 드러내시리로다",
      "source_text_hash": "c3d01859a04b9ea9b3007e1decfdbf8bfa7d8b3438845eb4bf247bc4e1dbe6bf",
      "translation_text_hash": "747bbef9707f50bc3f68a3b9c0dafbae50b15a6df9dc48bb30d9d3f4ab595373",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "처녀 시온아 네 죄악의 형벌이 다하였으니 주께서 다시는 너로 사로잡혀 가지 않게 하시리로다 처녀 에돔아 주께서 네 죄악을 벌하시며 네 허물을 드러내시리로다"
