      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무론 무슨 일에든지 시기와 판단이 있으므로 사람에게 임하는 화가 심함이니라"
      ],
      "raw_text_hashes": [
        "1b31a07c45de0b16021c42933cefadd627d0496317964dc5eae3195dcf869227"
      ]
    },
    {
      "canonical_locator": "bible:web:ECC:8:7",
      "sequence": 17466,
      "chapter_label": "ECC 8",
      "verse_label": "7",
      "locator": {
        "book": "ECC",
