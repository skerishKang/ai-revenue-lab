      "raw_texts": [
        "왕의 말은 권능이 있나니 누가 이르기를 왕께서 무엇을 하시나이까 할 수 있으랴"
      ],
      "raw_text_hashes": [
        "6c956617ac03d6dcc91565a5aad066da51f87074464dd6eddbf85710a8491c68"
      ]
    },
    {
      "canonical_locator": "bible:web:ECC:8:5",
      "sequence": 17464,
      "chapter_label": "ECC 8",
