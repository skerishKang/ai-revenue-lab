      "source_text_hash": "ae9c03cac59f3f301215b8fd4ac8c990b75edf1b50af1c34648e7135de403be7",
      "translation_text_hash": "bd574fe0b585835a6c29cf87fa34674e2f60ecc4c681551f753607b1a3d3135e",
      "translation_policy": "krv-1961-source-mapped",
