      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 37,
          "verse": 5
        }
      ],
      "en": "Commit your way to the LORD. Trust also in him, and he will do this:",
      "ko": "너의 길을 여호와께 맡기라 저를 의지하면 저가 이루시고",
      "source_text_hash": "fc2be29e46b15fd0960ddee5c825f00038af463c304abd0716b8d802174bb7d8",
      "translation_text_hash": "822a7fe2c7fe20f1d0d8b18351dfdc988d67594c3d2dd5d104f71f62b7c23a69",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너의 길을 여호와께 맡기라 저를 의지하면 저가 이루시고"
      ],
      "raw_text_hashes": [
        "822a7fe2c7fe20f1d0d8b18351dfdc988d67594c3d2dd5d104f71f62b7c23a69"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:37:6",
      "sequence": 14457,
      "chapter_label": "PSA 37",
      "verse_label": "6",
      "locator": {
