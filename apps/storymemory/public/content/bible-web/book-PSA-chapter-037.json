        "verse": 4
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 37,
          "verse": 4
        }
      ],
      "en": "Also delight yourself in the LORD, and he will give you the desires of your heart.",
      "ko": "또 여호와를 기뻐하라 저가 네 마음의 소원을 이루어 주시리로다",
      "source_text_hash": "d5427bd824ef9df00b88a4fb9d8009093f8994d8a71c5cf4f2b4afb7ecfed52b",
      "translation_text_hash": "cfebe61d357db1077ec49c5cd53d395e72ec5d210171353de130db652b101a47",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 여호와를 기뻐하라 저가 네 마음의 소원을 이루어 주시리로다"
      ],
      "raw_text_hashes": [
        "cfebe61d357db1077ec49c5cd53d395e72ec5d210171353de130db652b101a47"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:37:5",
      "sequence": 14456,
      "chapter_label": "PSA 37",
      "verse_label": "5",
      "locator": {
