        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 37,
          "verse": 6
        }
      ],
      "en": "he will make your righteousness shine out like light, and your justice as the noon day sun.",
      "ko": "네 의를 빛같이 나타내시며 네 공의를 정오의 빛같이 하시리로다",
      "source_text_hash": "59930a92d100b3e4e3d11e57f0ea3fe33d81d73efd58e596e006f6a2b317abd4",
      "translation_text_hash": "1060b75262fb5ea4b6a5cf08d16280b234ada38d2ff1bef1bdf1eaea8022adcb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 의를 빛같이 나타내시며 네 공의를 정오의 빛같이 하시리로다"
      ],
      "raw_text_hashes": [
        "1060b75262fb5ea4b6a5cf08d16280b234ada38d2ff1bef1bdf1eaea8022adcb"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:37:7",
      "sequence": 14458,
      "chapter_label": "PSA 37",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 37,
        "verse": 7
