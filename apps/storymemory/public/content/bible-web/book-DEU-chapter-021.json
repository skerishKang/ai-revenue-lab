        "verse": 22
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 21,
          "verse": 22
        }
      ],
      "en": "If a man has committed a sin worthy of death, and he is put to death, and you hang him on a tree,",
      "ko": "사람이 만일 죽을 죄를 범하므로 네가 그를 죽여 나무 위에 달거든",
      "source_text_hash": "e6910458afa0b2f62150c100f16bf8b91198ef976a17b90c23c0b69bdc58985b",
      "translation_text_hash": "4b753c8485dcbcd0f9ab5448861dac39e8e19f28d0aa452778ddb75ea00f107c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 만일 죽을 죄를 범하므로 네가 그를 죽여 나무 위에 달거든"
      ],
      "raw_text_hashes": [
        "4b753c8485dcbcd0f9ab5448861dac39e8e19f28d0aa452778ddb75ea00f107c"
      ]
    },
