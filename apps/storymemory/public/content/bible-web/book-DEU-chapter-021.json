      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 21,
          "verse": 15
        }
      ],
      "en": "If a man has two wives, the one beloved and the other hated, and they have borne him children, both the beloved and the hated, and if the firstborn son is hers who was hated,",
      "ko": "어떤 사람이 두 아내를 두었는데 하나는 사랑을 받고 하나는 미움을 받다가 그 사랑을 받는 자와 미움을 받는 자가 둘 다 아들을 낳았다 하자 그 미움을 받는 자의 소생이 장자여든",
      "source_text_hash": "e4d51c358357159df338d860e6bc86389c7123d4cf4df033f867a2d7547cbd24",
      "translation_text_hash": "eb5c6c257a403483499629e9052c3815cc5ed3379112300fb4091a47b61582ac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어떤 사람이 두 아내를 두었는데 하나는 사랑을 받고 하나는 미움을 받다가 그 사랑을 받는 자와 미움을 받는 자가 둘 다 아들을 낳았다 하자 그 미움을 받는 자의 소생이 장자여든"
      ],
      "raw_text_hashes": [
