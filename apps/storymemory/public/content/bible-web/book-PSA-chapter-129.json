        {
          "book": "PSA",
          "chapter": 129,
          "verse": 3
        }
      ],
      "en": "The plowers plowed on my back. They made their furrows long.",
      "ko": "밭 가는 자가 내 등에 갈아 그 고랑을 길게 지었도다",
      "source_text_hash": "9a968b9463dd77c56406273791a1a516e383f3c77115624065b6305c3fbede8c",
      "translation_text_hash": "9299fa0d26240f7cb868462d52daa81035ceb21db7defea39feab6c98902f33a",
      "translation_policy": "krv-1961-source-mapped",
