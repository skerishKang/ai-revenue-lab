    {
      "canonical_locator": "bible:web:MAL:3:11",
      "sequence": 23132,
      "chapter_label": "MAL 3",
      "verse_label": "11",
      "locator": {
        "book": "MAL",
        "chapter": 3,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "MAL",
          "chapter": 3,
          "verse": 11
        }
      ],
      "en": "I will rebuke the devourer for your sakes, and he shall not destroy the fruits of your ground; neither shall your vine cast its fruit before its time in the field,” says the LORD of Armies.",
      "ko": "만군의 여호와가 이르노라 내가 너희를 위하여 황충을 금하여 너희 토지 소산을 멸하지 않게 하며 너희 밭에 포도나무의 과실로 기한 전에 떨어지지 않게 하리니",
      "source_text_hash": "534bf239c06437425f0312e73bcfd448b224163419d77e52fd231c33c69301cc",
      "translation_text_hash": "a9dd8e87dc65463c38425d01ff287a778fd25721dc3f5c79ab3c31bf84313ab1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만군의 여호와가 이르노라 내가 너희를 위하여 황충을 금하여 너희 토지 소산을 멸하지 않게 하며 너희 밭에 포도나무의 과실로 기한 전에 떨어지지 않게 하리니"
      ],
      "raw_text_hashes": [
