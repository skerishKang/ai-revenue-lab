    {
      "canonical_locator": "bible:web:MAL:3:9",
      "sequence": 23130,
      "chapter_label": "MAL 3",
      "verse_label": "9",
      "locator": {
        "book": "MAL",
        "chapter": 3,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "MAL",
          "chapter": 3,
          "verse": 9
        }
      ],
      "en": "You are cursed with the curse; for you rob me, even this whole nation.",
      "ko": "너희 곧 온 나라가 나의 것을 도적질하였으므로 너희가 저주를 받았느니라",
      "source_text_hash": "b662584c4d92d1807121559447e02fcc09b79afc745e88d9131dea9d5eb006f3",
      "translation_text_hash": "fdee9ff756814889d67f89901dabce4ef8346903206e7475024212974adc9711",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 곧 온 나라가 나의 것을 도적질하였으므로 너희가 저주를 받았느니라"
      ],
      "raw_text_hashes": [
        "fdee9ff756814889d67f89901dabce4ef8346903206e7475024212974adc9711"
      ]
