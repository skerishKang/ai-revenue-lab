      ]
    },
    {
      "canonical_locator": "bible:web:MAL:3:12",
      "sequence": 23133,
      "chapter_label": "MAL 3",
      "verse_label": "12",
      "locator": {
        "book": "MAL",
        "chapter": 3,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "MAL",
          "chapter": 3,
          "verse": 12
        }
      ],
      "en": "“All nations shall call you blessed, for you will be a delightful land,” says the LORD of Armies.",
      "ko": "너희 땅이 아름다와지므로 열방이 너희를 복되다 하리라 만군의 여호와의 말이니라",
      "source_text_hash": "9db4297a49ae19f902c01c363ab9948f9274f20cec9c4dd570add9a2ab87b041",
      "translation_text_hash": "abd572c7d1696cd72cfb8657083d51781a8a1b00d4f736a02ad51c6a4f47599d",
