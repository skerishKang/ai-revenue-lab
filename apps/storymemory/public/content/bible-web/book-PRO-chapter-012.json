      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어진 여인은 그 지아비의 면류관이나 욕을 끼치는 여인은 그 지아비로 뼈가 썩음 같게 하느니라"
      ],
      "raw_text_hashes": [
        "a0c13b01322afaee67b17331360d905d1fc19a4ac5fdeb51e9059070228bbcf6"
