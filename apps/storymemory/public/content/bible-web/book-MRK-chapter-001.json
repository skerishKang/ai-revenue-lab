      ],
      "en": "Immediately the Spirit drove him out into the wilderness.",
      "ko": "성령이 곧 예수를 광야로 몰아내신지라",
      "source_text_hash": "25d28fba787ecd5b0437314e2c4918f0fca838ee95f672a7c316883fe98564d6",
      "translation_text_hash": "d17992d5b31c00481d0644ca2629af459ffc97855183670e233c6ca2225751dd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "성령이 곧 예수를 광야로 몰아내신지라"
      ],
      "raw_text_hashes": [
        "d17992d5b31c00481d0644ca2629af459ffc97855183670e233c6ca2225751dd"
      ]
    },
    {
