        {
          "book": "MRK",
          "chapter": 1,
          "verse": 14
        }
      ],
      "en": "Now after John was taken into custody, Jesus came into Galilee, preaching the Good News of God’s Kingdom,",
      "ko": "요한이 잡힌 후 예수께서 갈릴리에 오셔서 하나님의 복음을 전파하여",
      "source_text_hash": "9b771d8925e98aed74f7d3349d02958c70e295144e37da7615cdc864f81030f2",
      "translation_text_hash": "6c8c1225cbf53e6b737f8b1687002eabe26b8b39ae7d04add178f45163d98dcd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요한이 잡힌 후 예수께서 갈릴리에 오셔서 하나님의 복음을 전파하여"
      ],
      "raw_text_hashes": [
        "6c8c1225cbf53e6b737f8b1687002eabe26b8b39ae7d04add178f45163d98dcd"
      ]
    },
    {
      "canonical_locator": "bible:web:MRK:1:15",
      "sequence": 24231,
      "chapter_label": "MRK 1",
      "verse_label": "15",
      "locator": {
        "book": "MRK",
        "chapter": 1,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "MRK",
          "chapter": 1,
          "verse": 15
        }
      ],
      "en": "and saying, “The time is fulfilled, and God’s Kingdom is at hand! Repent, and believe in the Good News.”",
      "ko": "가라사대 때가 찼고 하나님 나라가 가까왔으니 회개하고 복음을 믿으라 하시더라",
