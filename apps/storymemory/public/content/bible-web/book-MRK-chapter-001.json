      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "광야에서 사십 일을 계셔서 사단에게 시험을 받으시며 들짐승과 함께 계시니 천사들이 수종들더라"
      ],
      "raw_text_hashes": [
        "67469ca7682dea206378e94e11a547bef062cbb3ea839f600f20bc2e08d9db64"
