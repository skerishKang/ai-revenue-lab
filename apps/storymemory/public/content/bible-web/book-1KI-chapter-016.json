        "verse": 32
      },
      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 16,
          "verse": 32
        }
      ],
      "en": "He raised up an altar for Baal in the house of Baal, which he had built in Samaria.",
      "ko": "사마리아에 건축한 바알의 사당 속에 바알을 위하여 단을 쌓으며",
      "source_text_hash": "2ee82c8e2f0cd8aec2db1910c002fc7f724c49aabe45332e3bf334858caf360e",
      "translation_text_hash": "962c5b35d20fecf35de885aef1a0536e416deed5fffc588db42824c0021cb690",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사마리아에 건축한 바알의 사당 속에 바알을 위하여 단을 쌓으며"
      ],
      "raw_text_hashes": [
        "962c5b35d20fecf35de885aef1a0536e416deed5fffc588db42824c0021cb690"
      ]
    },
