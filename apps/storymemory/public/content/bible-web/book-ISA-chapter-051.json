      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 51,
          "verse": 15
        }
      ],
      "en": "For I am the LORD your God, who stirs up the sea so that its waves roar. the LORD of Armies is his name.",
      "ko": "나는 네 하나님 여호와라 바다를 저어서 그 물결로 흉용케 하는 자니 내 이름은 만군의 여호와니라",
      "source_text_hash": "87d1b1f5c06df449de344be72a9daf54125d44cb2ccfd765fd55955428d62c44",
      "translation_text_hash": "e0f7a0ce5f3bfa6d9fb76b4130b3f067734e88c394217a3113dba74fa42b867d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 네 하나님 여호와라 바다를 저어서 그 물결로 흉용케 하는 자니 내 이름은 만군의 여호와니라"
      ],
      "raw_text_hashes": [
