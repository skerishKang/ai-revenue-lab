      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 51,
          "verse": 17
        }
      ],
      "en": "Awake, awake! Stand up, Jerusalem, you who have drunk from the LORD’s hand the cup of his wrath. You have drunken the bowl of the cup of staggering, and drained it.",
      "ko": "여호와의 손에서 그 분노의 잔을 마신 예루살렘이여 깰찌어다 깰찌어다 일어설찌어다 네가 이미 비틀걸음 치게 하는 큰 잔을 마셔 다하였도다",
      "source_text_hash": "b85e835c5f72359481f5b52af84516db5c654aef55014b57e8a245a4d1f31b84",
      "translation_text_hash": "5b1b003d73d5ffded32208195e475bf41895723d730179b09d411d23c0b1343e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 손에서 그 분노의 잔을 마신 예루살렘이여 깰찌어다 깰찌어다 일어설찌어다 네가 이미 비틀걸음 치게 하는 큰 잔을 마셔 다하였도다"
      ],
      "raw_text_hashes": [
