        {
          "book": "JOL",
          "chapter": 2,
          "verse": 4
        }
      ],
      "en": "Their appearance is as the appearance of horses, and they run as horsemen.",
      "ko": "그 모양은 말 같고 그 달리는 것은 기병 같으며",
      "source_text_hash": "a2bc8d5d4ed9b347e9a7ef36f5e2608d5df2e9626870b86874191ed5548f3b5c",
      "translation_text_hash": "6d695c36d77248376e0029b050a4a113208932ab14f638956c17f041356496e4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 모양은 말 같고 그 달리는 것은 기병 같으며"
      ],
      "raw_text_hashes": [
        "6d695c36d77248376e0029b050a4a113208932ab14f638956c17f041356496e4"
      ]
    },
    {
      "canonical_locator": "bible:web:JOL:2:5",
      "sequence": 22317,
      "chapter_label": "JOL 2",
      "verse_label": "5",
      "locator": {
        "book": "JOL",
