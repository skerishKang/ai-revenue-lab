      "raw_locator": [
        {
          "book": "JOL",
          "chapter": 2,
          "verse": 3
        }
      ],
      "en": "A fire devours before them, and behind them, a flame burns. The land is as the garden of Eden before them, and behind them, a desolate wilderness. Yes, and no one has escaped them.",
      "ko": "불이 그들의 앞을 사르며 불꽃이 그들의 뒤를 태우니 그 전의 땅은 에덴 동산 같았으나 그 후의 땅은 황무한 들 같으니 그 들을 피한 자가 없도다",
      "source_text_hash": "d5ee2d5b51661ac2f11691ffb93ab20f58d84188590edf66954757c16c9371d4",
      "translation_text_hash": "f7c05e1c6ff1a4750e62806126b0dc14e011d7ab960ceddbee378fb8d644361d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "불이 그들의 앞을 사르며 불꽃이 그들의 뒤를 태우니 그 전의 땅은 에덴 동산 같았으나 그 후의 땅은 황무한 들 같으니 그 들을 피한 자가 없도다"
      ],
      "raw_text_hashes": [
        "f7c05e1c6ff1a4750e62806126b0dc14e011d7ab960ceddbee378fb8d644361d"
      ]
    },
    {
