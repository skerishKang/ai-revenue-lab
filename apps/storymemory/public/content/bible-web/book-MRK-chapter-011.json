      "raw_locator": [
        {
          "book": "MRK",
          "chapter": 11,
          "verse": 8
        }
      ],
      "en": "Many spread their garments on the way, and others were cutting down branches from the trees and spreading them on the road.",
      "ko": "많은 사람은 자기 겉옷과 다른이들은 밭에서 벤 나무가지를 길에 펴며",
      "source_text_hash": "e37005ff3eee311db3d4f49d6e910f8fd75b1bc1dd24584d8c78ac08807ae3df",
      "translation_text_hash": "9e656f47df998dc78c760f6d07b141018083c8a50f5c12e58de79be143d6a2f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "많은 사람은 자기 겉옷과 다른이들은 밭에서 벤 나무가지를 길에 펴며"
      ],
      "raw_text_hashes": [
        "9e656f47df998dc78c760f6d07b141018083c8a50f5c12e58de79be143d6a2f5"
      ]
    },
    {
      "canonical_locator": "bible:web:MRK:11:9",
      "sequence": 24650,
      "chapter_label": "MRK 11",
