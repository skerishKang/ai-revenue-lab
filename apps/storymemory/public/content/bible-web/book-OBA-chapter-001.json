      "raw_locator": [
        {
          "book": "OBA",
          "chapter": 1,
          "verse": 6
        }
      ],
      "en": "How Esau will be ransacked! How his hidden treasures are sought out!",
      "ko": "에서가 어찌 그리 수탐되었으며 그 감춘 보물이 어찌 그리 수탐되었는고",
      "source_text_hash": "1a2b300ea9b05526b0c677b779f46fc9a9acb7675aaed57016bf93609fa64dff",
      "translation_text_hash": "3b931e07f0bb8637ac7f0fd24956ff7ea6414559a0024d619d81446a4e5d9656",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에서가 어찌 그리 수탐되었으며 그 감춘 보물이 어찌 그리 수탐되었는고"
      ],
      "raw_text_hashes": [
        "3b931e07f0bb8637ac7f0fd24956ff7ea6414559a0024d619d81446a4e5d9656"
      ]
