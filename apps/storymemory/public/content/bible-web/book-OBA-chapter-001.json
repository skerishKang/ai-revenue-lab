      "sequence": 22530,
      "chapter_label": "OBA 1",
      "verse_label": "19",
      "locator": {
        "book": "OBA",
        "chapter": 1,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "OBA",
          "chapter": 1,
          "verse": 19
        }
      ],
      "en": "Those of the South will possess the mountain of Esau, and those of the lowland, the Philistines. They will possess the field of Ephraim, and the field of Samaria. Benjamin will possess Gilead.",
      "ko": "남방 사람은 에서의 산을 얻을 것이며 평지 사람은 블레셋을 얻을 것이요 또 그들이 에브라임의 들과 사마리아의 들을 얻을 것이며 베냐민은 길르앗을 얻을 것이며",
      "source_text_hash": "6f6456c7f521d55ad434500e63e422ce9fef0ebd1926a5812d4a779c731f4118",
      "translation_text_hash": "06fcc286472647dcef689796281cfe702f848d5abaf21998690192c4f73b7ee8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "남방 사람은 에서의 산을 얻을 것이며 평지 사람은 블레셋을 얻을 것이요 또 그들이 에브라임의 들과 사마리아의 들을 얻을 것이며 베냐민은 길르앗을 얻을 것이며"
      ],
      "raw_text_hashes": [
