      "source_text_hash": "4776122c753da1e490f3dca3b0ca51793690c8240ae935d032e48d1f1871b042",
      "translation_text_hash": "4e09b67a4bca352ad649b7498183c04bd5fd50ae0ebfb512ba691cc25559a546",
