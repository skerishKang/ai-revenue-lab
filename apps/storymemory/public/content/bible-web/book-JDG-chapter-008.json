      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 8,
          "verse": 3
        }
      ],
      "en": "God has delivered into your hand the princes of Midian, Oreb and Zeeb! What was I able to do in comparison with you?” Then their anger was abated toward him when he had said that.",
      "ko": "하나님이 미디안 방백 오렙과 스엡을 너희 손에 붙이셨으니 나의 한 일이 어찌 능히 너희의 한 것에 비교되겠느냐 기드온이 이 말을 하매 그들의 노가 풀리니라",
      "source_text_hash": "f5b60fd7ac875a59160253bfb24324cffd872f8c2a731b36ef67b3a6ff9f831d",
      "translation_text_hash": "c8e09c7caa4c69027505bb8570b9735b8b91694938aeb4490d7b7c4dc6807076",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이 미디안 방백 오렙과 스엡을 너희 손에 붙이셨으니 나의 한 일이 어찌 능히 너희의 한 것에 비교되겠느냐 기드온이 이 말을 하매 그들의 노가 풀리니라"
      ],
      "raw_text_hashes": [
