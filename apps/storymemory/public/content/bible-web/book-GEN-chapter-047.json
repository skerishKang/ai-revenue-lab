      "ko": "기근이 더욱 심하여 사방에 식물이 없고 애굽 땅과 가나안 땅이 기근으로 쇠약하니",
      "source_text_hash": "e8c076947c0ba6ebff27828e5b64c83bf4cb32bf23fc42846a7f874407637830",
      "translation_text_hash": "8d8a55ac239cdc42e3567d2d94207b6b368a747ad72d92811b45dc01b5e9f980",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "기근이 더욱 심하여 사방에 식물이 없고 애굽 땅과 가나안 땅이 기근으로 쇠약하니"
      ],
      "raw_text_hashes": [
        "8d8a55ac239cdc42e3567d2d94207b6b368a747ad72d92811b45dc01b5e9f980"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:47:14",
      "sequence": 1435,
      "chapter_label": "GEN 47",
