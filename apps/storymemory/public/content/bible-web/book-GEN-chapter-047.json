      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 47,
          "verse": 2
        }
      ],
      "en": "From among his brothers he took five men, and presented them to Pharaoh.",
      "ko": "형들중 오인을 택하여 바로에게 보이니",
      "source_text_hash": "61286c8133a67d6276b2cb7312c935c5f390ec0c345adf8a618e9bce43735f12",
      "translation_text_hash": "2149adec8cc983ec3096edaf214c516387452a55dd895aabb668894141307f2e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "형들중 오인을 택하여 바로에게 보이니"
      ],
      "raw_text_hashes": [
        "2149adec8cc983ec3096edaf214c516387452a55dd895aabb668894141307f2e"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:47:3",
      "sequence": 1424,
      "chapter_label": "GEN 47",
      "verse_label": "3",
      "locator": {
