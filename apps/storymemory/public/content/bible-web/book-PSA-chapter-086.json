      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주는 선하사 사유하기를 즐기시며 주께 부르짖는 자에게 인자함이 후하심이니이다"
      ],
      "raw_text_hashes": [
        "0c886936335ca5952a0c7e95cc53ea9d8d71920830df8bc2316e92fc7d6a3b94"
