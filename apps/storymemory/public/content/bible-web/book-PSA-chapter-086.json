      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 내게 향하신 주의 인자가 크사 내 영혼을 깊은 음부에서 건지셨음이니이다"
      ],
      "raw_text_hashes": [
        "efbd6b9cd088f5d201aea8621ae889ed0e03c4c67e415d40dca622506c11d3e7"
      ]
    },
