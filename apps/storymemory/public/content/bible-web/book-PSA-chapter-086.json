      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대저 주는 광대하사 기사를 행하시오니 주만 하나님이시니이다"
      ],
      "raw_text_hashes": [
        "72ec6945d869055af95e8c380cae084707b4ae5857adda120b41b25f98aae5df"
      ]
