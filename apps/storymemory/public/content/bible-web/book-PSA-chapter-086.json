      "translation_text_hash": "8156efed5f1a53e289e3dd1652fdfa6bdf5dd663ed5871bff33f1755003023bb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나의 기도에 귀를 기울이시고 나의 간구하는 소리를 들으소서"
      ],
      "raw_text_hashes": [
        "8156efed5f1a53e289e3dd1652fdfa6bdf5dd663ed5871bff33f1755003023bb"
      ]
