      "translation_text_hash": "8bfedf9451b27a8d957a99eae54d043e36a1fda4fb79e01cfed10c4740cc6d5d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나는 곤고하고 궁핍하오니 귀를 기울여 내게 응답하소서"
      ],
      "raw_text_hashes": [
