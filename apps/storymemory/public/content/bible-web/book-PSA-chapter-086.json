      "translation_text_hash": "ef190af635407f035f28a16235d504a45b11cdde78330e78629cd33c916e6752",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주여 나를 긍휼히 여기소서 내가 종일 주께 부르짖나이다"
      ],
      "raw_text_hashes": [
        "ef190af635407f035f28a16235d504a45b11cdde78330e78629cd33c916e6752"
      ]
