      "source_text_hash": "2381973d7322576ed5808e2ebbc54a39a5ae50aefc7f09566748f1d3102710a3",
      "translation_text_hash": "344e2f8c58d55339d031c1afb6bcdb9dcd13a5fe1936186ec35bc2a57cc7532c",
      "translation_policy": "krv-1961-source-mapped",
