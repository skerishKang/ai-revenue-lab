      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 8,
          "verse": 7
        }
      ],
      "en": "He brought me to the door of the court; and when I looked, behold, a hole in the wall.",
      "ko": "그가 나를 이끌고 뜰 문에 이르시기로 내가 본즉 담에 구멍이 있더라",
      "source_text_hash": "755be0c25e477fe6e47a5a62deb7b55c52474194d4c822fee467e0cc18eca70a",
      "translation_text_hash": "520ef3bf1e6799f3d6c7c465472e1f79fa3e36a9e9c6e17a2ea259ee9d78b065",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 나를 이끌고 뜰 문에 이르시기로 내가 본즉 담에 구멍이 있더라"
      ],
      "raw_text_hashes": [
        "520ef3bf1e6799f3d6c7c465472e1f79fa3e36a9e9c6e17a2ea259ee9d78b065"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:8:8",
      "sequence": 20613,
      "chapter_label": "EZK 8",
