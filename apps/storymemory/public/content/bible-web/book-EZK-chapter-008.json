      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 8,
          "verse": 4
        }
      ],
      "en": "Behold, the glory of the God of Israel was there, according to the appearance that I saw in the plain.",
      "ko": "이스라엘 하나님의 영광이 거기 있는데 내가 들에서 보던 이상과 같더라",
      "source_text_hash": "985217074b80854a05833dc2f83592fd2ab70905a980379b39b1e2ed3ff56244",
      "translation_text_hash": "e1249455f018e412a5e57cafc6c9a4a68001c65c0f3e38391671cd1dbe41ecf0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 하나님의 영광이 거기 있는데 내가 들에서 보던 이상과 같더라"
      ],
      "raw_text_hashes": [
        "e1249455f018e412a5e57cafc6c9a4a68001c65c0f3e38391671cd1dbe41ecf0"
      ]
