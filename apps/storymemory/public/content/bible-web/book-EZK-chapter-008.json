    {
      "canonical_locator": "bible:web:EZK:8:13",
      "sequence": 20618,
      "chapter_label": "EZK 8",
      "verse_label": "13",
      "locator": {
        "book": "EZK",
        "chapter": 8,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 8,
          "verse": 13
        }
      ],
      "en": "He said also to me, “You will again see more of the great abominations which they do.”",
