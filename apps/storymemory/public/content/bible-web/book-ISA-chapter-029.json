    {
      "canonical_locator": "bible:web:ISA:29:11",
      "sequence": 18205,
      "chapter_label": "ISA 29",
      "verse_label": "11",
      "locator": {
        "book": "ISA",
        "chapter": 29,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 29,
          "verse": 11
        }
      ],
      "en": "All vision has become to you like the words of a book that is sealed, which men deliver to one who is educated, saying, “Read this, please;” and he says, “I can’t, for it is sealed;”",
      "ko": "그러므로 모든 묵시가 너희에게는 마치 봉한 책의 말이라 그것을 유식한 자에게 주며 이르기를 그대에게 청하노니 이를 읽으라 하면 대답하기를 봉하였으니 못하겠노라 할 것이요",
      "source_text_hash": "d0fa24ac9b72a077e66511c5c06b9ac84815a224bcbb175c5e62f0466a976820",
      "translation_text_hash": "7999b2bbca96c4ccf3481561dfd890a78337b05488ad9aefcc7f3d66240e220a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 모든 묵시가 너희에게는 마치 봉한 책의 말이라 그것을 유식한 자에게 주며 이르기를 그대에게 청하노니 이를 읽으라 하면 대답하기를 봉하였으니 못하겠노라 할 것이요"
      ],
      "raw_text_hashes": [
        "7999b2bbca96c4ccf3481561dfd890a78337b05488ad9aefcc7f3d66240e220a"
      ]
    },
