    {
      "canonical_locator": "bible:web:ISA:29:10",
      "sequence": 18204,
      "chapter_label": "ISA 29",
      "verse_label": "10",
      "locator": {
        "book": "ISA",
        "chapter": 29,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 29,
          "verse": 10
        }
      ],
      "en": "For the LORD has poured out on you a spirit of deep sleep, and has closed your eyes, the prophets; and he has covered your heads, the seers.",
      "ko": "대저 여호와께서 깊이 잠들게 하는 신을 너희에게 부어주사 너희의 눈을 감기셨음이니 눈은 선지자요 너희 머리를 덮으셨음이니 머리는 선견자라",
      "source_text_hash": "5b4106471ee8e0f522c6f73b2f364f462adf38a38b0c4f19d25b5df9bd845af9",
      "translation_text_hash": "38254c101ac0003b14c4d169fa2f15b9d57676df655b293a38f09df0e43df570",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대저 여호와께서 깊이 잠들게 하는 신을 너희에게 부어주사 너희의 눈을 감기셨음이니 눈은 선지자요 너희 머리를 덮으셨음이니 머리는 선견자라"
      ],
      "raw_text_hashes": [
        "38254c101ac0003b14c4d169fa2f15b9d57676df655b293a38f09df0e43df570"
