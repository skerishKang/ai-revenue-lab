        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 62,
          "verse": 10
        }
      ],
      "en": "Go through, go through the gates! Prepare the way of the people! Build up, build up the highway! Gather out the stones! Lift up a banner for the peoples.",
      "ko": "성문으로 나아가라 나아가라 백성의 길을 예비하라 대로를 수축하고 수축하라 돌을 제하라 만민을 위하여 기를 들라",
      "source_text_hash": "7162e92bbec2dd47f0ac40b89d5035b7df03576d65e1040e4448cd25cde7e8a9",
      "translation_text_hash": "b465cee39308c02112e67f28b4a53131d06f3e39bcef73f72a0c23dd03cf5ade",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "성문으로 나아가라 나아가라 백성의 길을 예비하라 대로를 수축하고 수축하라 돌을 제하라 만민을 위하여 기를 들라"
      ],
      "raw_text_hashes": [
        "b465cee39308c02112e67f28b4a53131d06f3e39bcef73f72a0c23dd03cf5ade"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:62:11",
      "sequence": 18866,
      "chapter_label": "ISA 62",
      "verse_label": "11",
      "locator": {
