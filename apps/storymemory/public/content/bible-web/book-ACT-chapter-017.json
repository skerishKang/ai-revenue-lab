        "verse": 16
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 17,
          "verse": 16
        }
      ],
      "en": "Now while Paul waited for them at Athens, his spirit was provoked within him as he saw the city full of idols.",
      "ko": "바울이 아덴에서 저희를 기다리다가 온 성에 우상이 가득한 것을 보고 마음에 분하여",
      "source_text_hash": "ff9184c3dc8add865524850b42ba6d5305271196974f67bf4e9ef0be9571cd4e",
      "translation_text_hash": "abd62bcae775b3ca55d2c038e868a5a4d6d185b7d074592c3b77ecabe57710de",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바울이 아덴에서 저희를 기다리다가 온 성에 우상이 가득한 것을 보고 마음에 분하여"
      ],
      "raw_text_hashes": [
        "abd62bcae775b3ca55d2c038e868a5a4d6d185b7d074592c3b77ecabe57710de"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:17:17",
      "sequence": 27538,
      "chapter_label": "ACT 17",
