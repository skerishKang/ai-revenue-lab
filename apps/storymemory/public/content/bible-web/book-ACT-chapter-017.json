      "source_text_hash": "fb4b6ee284cedae1895c3f4208628634a4a6e44e80436c29c4c5f087d490f4d4",
      "translation_text_hash": "975df9c6c948da5fd43b09f4b003eab5640d02b45a3d2d5cde03cd1cdcbf94f2",
      "translation_policy": "krv-1961-source-mapped",
