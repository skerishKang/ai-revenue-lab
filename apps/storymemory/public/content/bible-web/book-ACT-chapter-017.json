        "verse": 24
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 17,
          "verse": 24
        }
      ],
      "en": "The God who made the world and all things in it, he, being Lord of heaven and earth, doesn’t dwell in temples made with hands.",
      "ko": "우주와 그 가운데 있는 만유를 지으신 신께서는 천지의 주재시니 손으로 지은 전에 계시지 아니하시고",
      "source_text_hash": "10eb7b58a0e3ee4f88bf782f391efcedd75d19ed465e1a7b164e4e47677d02e4",
      "translation_text_hash": "99d2e190daf32c8c3ad9b564bb1c7fa2ba324364466b3973e49d7d79393c912d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우주와 그 가운데 있는 만유를 지으신 신께서는 천지의 주재시니 손으로 지은 전에 계시지 아니하시고"
      ],
      "raw_text_hashes": [
        "99d2e190daf32c8c3ad9b564bb1c7fa2ba324364466b3973e49d7d79393c912d"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:17:25",
      "sequence": 27546,
      "chapter_label": "ACT 17",
