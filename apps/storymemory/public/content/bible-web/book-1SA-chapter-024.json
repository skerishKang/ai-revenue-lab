        "verse": 2
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 2
        }
      ],
      "en": "Then Saul took three thousand chosen men out of all Israel, and went to seek David and his men on the rocks of the wild goats.",
      "ko": "사울이 온 이스라엘에서 택한 사람 삼천을 거느리고 다윗과 그의 사람들을 찾으러 들염소 바위로 갈쌔",
      "source_text_hash": "5a0777d5aeea91b35ad554c705c5fe21d1e089066682c8448ce7a8b3aece2f27",
      "translation_text_hash": "83dab175c580f4cdf1be562559d1beef8ce207f6228246098fb4607eb03fca49",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울이 온 이스라엘에서 택한 사람 삼천을 거느리고 다윗과 그의 사람들을 찾으러 들염소 바위로 갈쌔"
      ],
      "raw_text_hashes": [
        "83dab175c580f4cdf1be562559d1beef8ce207f6228246098fb4607eb03fca49"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:3",
      "sequence": 7843,
      "chapter_label": "1SA 24",
      "verse_label": "3",
      "locator": {
