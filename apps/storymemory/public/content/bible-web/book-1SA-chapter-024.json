        "verse": 5
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 5
        }
      ],
      "en": "Afterward, David’s heart struck him because he had cut off Saul’s skirt.",
      "ko": "그리한 후에 사울의 옷자락 벰을 인하여 다윗의 마음이 찔려",
      "source_text_hash": "6ee747ccd695c146ba4fd2e704069edb3be8b27433e2e89b97536d654fd5b43d",
      "translation_text_hash": "e4ea5dc5cbe70f3e1db0098db7152d79760968bb2bedb0ae47d906692ab0d634",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그리한 후에 사울의 옷자락 벰을 인하여 다윗의 마음이 찔려"
      ],
      "raw_text_hashes": [
        "e4ea5dc5cbe70f3e1db0098db7152d79760968bb2bedb0ae47d906692ab0d634"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:6",
      "sequence": 7846,
      "chapter_label": "1SA 24",
      "verse_label": "6",
      "locator": {
        "book": "1SA",
        "chapter": 24,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 6
        }
      ],
      "en": "He said to his men, “The LORD forbid that I should do this thing to my lord, the LORD’s anointed, to stretch out my hand against him, since he is the LORD’s anointed.”",
      "ko": "자기 사람들에게 이르되 내가 손을 들어 여호와의 기름 부음을 받은 내 주를 치는 것은 여호와의 금하시는 것이니 그는 여호와의 기름 부음을 받은 자가 됨이니라 하고",
      "source_text_hash": "7f5700c9420c00f16b986592663ede188aecbcfc67fdad05fb7c78730f949516",
      "translation_text_hash": "ee8fd71e8e229baf48e4b05e3394ca4d0fe94555cd1d5f7095e2ce234765fca2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "자기 사람들에게 이르되 내가 손을 들어 여호와의 기름 부음을 받은 내 주를 치는 것은 여호와의 금하시는 것이니 그는 여호와의 기름 부음을 받은 자가 됨이니라 하고"
      ],
      "raw_text_hashes": [
        "ee8fd71e8e229baf48e4b05e3394ca4d0fe94555cd1d5f7095e2ce234765fca2"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:7",
      "sequence": 7847,
      "chapter_label": "1SA 24",
      "verse_label": "7",
      "locator": {
        "book": "1SA",
        "chapter": 24,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 7
        }
      ],
      "en": "So David checked his men with these words, and didn’t allow them to rise against Saul. Saul rose up out of the cave, and went on his way.",
      "ko": "다윗이 이 말로 자기 사람들을 금하여 사울을 해하지 못하게 하니라 사울이 일어나 굴에서 나가 자기 길을 가니라",
      "source_text_hash": "b75a0db9274b52cadbac49b8368b99e0910a050d044b71ce8955c49d4e2a0052",
      "translation_text_hash": "9e24d2572c8cf03ac76c67874cd8252c11bc3fcf5e7b9c4f7bf7a49295a8af3c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 이 말로 자기 사람들을 금하여 사울을 해하지 못하게 하니라 사울이 일어나 굴에서 나가 자기 길을 가니라"
      ],
      "raw_text_hashes": [
        "9e24d2572c8cf03ac76c67874cd8252c11bc3fcf5e7b9c4f7bf7a49295a8af3c"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:8",
      "sequence": 7848,
      "chapter_label": "1SA 24",
      "verse_label": "8",
      "locator": {
        "book": "1SA",
        "chapter": 24,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 8
        }
      ],
      "en": "David also arose afterward, and went out of the cave and cried after Saul, saying, “My lord the king!” When Saul looked behind him, David bowed with his face to the earth, and showed respect.",
      "ko": "그 후에 다윗도 일어나 굴에서 나가 사울의 뒤에서 외쳐 가로되 내 주 왕이여 하매 사울이 돌아보는지라 다윗이 땅에 엎드려 절하고",
      "source_text_hash": "9287210d18285ae4f7f5a4a351c973b6ececa35002e28a2a347c811756fe4e95",
      "translation_text_hash": "19d57f67c2c7c72b1173107049263604eae460f2372e4df57c4c681d48b36876",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 후에 다윗도 일어나 굴에서 나가 사울의 뒤에서 외쳐 가로되 내 주 왕이여 하매 사울이 돌아보는지라 다윗이 땅에 엎드려 절하고"
      ],
      "raw_text_hashes": [
        "19d57f67c2c7c72b1173107049263604eae460f2372e4df57c4c681d48b36876"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:9",
      "sequence": 7849,
      "chapter_label": "1SA 24",
      "verse_label": "9",
      "locator": {
        "book": "1SA",
        "chapter": 24,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 9
        }
      ],
      "en": "David said to Saul, “Why do you listen to men’s words, saying, ‘Behold, David seeks to harm you’?",
      "ko": "사울에게 이르되 다윗이 왕을 해하려 한다고 하는 사람들의 말을 왕은 어찌하여 들으시나이까",
      "source_text_hash": "b620cc53870a160e33e1c7f5303ab2b41554328714ed7379e7619b3754c7e8f7",
      "translation_text_hash": "ed979bc202d588c8f9a4d29d200dc0b2241e857a3f4cb406dd205d862aad55df",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울에게 이르되 다윗이 왕을 해하려 한다고 하는 사람들의 말을 왕은 어찌하여 들으시나이까"
      ],
      "raw_text_hashes": [
        "ed979bc202d588c8f9a4d29d200dc0b2241e857a3f4cb406dd205d862aad55df"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:10",
      "sequence": 7850,
      "chapter_label": "1SA 24",
      "verse_label": "10",
      "locator": {
        "book": "1SA",
        "chapter": 24,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 10
        }
      ],
      "en": "Behold, today your eyes have seen how the LORD had delivered you today into my hand in the cave. Some urged me to kill you, but I spared you. I said, ‘I will not stretch out my hand against my lord, for he is the LORD’s anointed.’",
      "ko": "오늘 여호와께서 굴에서 왕을 내 손에 붙이신 것을 왕이 아셨을 것이니이다 혹이 나를 권하여 왕을 죽이라 하였으나 내가 왕을 아껴 말하기를 나는 내 손을 들어 내 주를 해치 아니하리니 그는 여호와의 기름 부음을 받은 자가 됨이니라 하였나이다",
      "source_text_hash": "ea6aa1bf0707ceb65a305deaf51598df8df3f462961a49e6f1f43e1e3c77ce7e",
      "translation_text_hash": "f021cf48a2d547adc632476cfeef6b4fb15a6d671ce3a8dc53118b7b6f93ff07",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오늘 여호와께서 굴에서 왕을 내 손에 붙이신 것을 왕이 아셨을 것이니이다 혹이 나를 권하여 왕을 죽이라 하였으나 내가 왕을 아껴 말하기를 나는 내 손을 들어 내 주를 해치 아니하리니 그는 여호와의 기름 부음을 받은 자가 됨이니라 하였나이다"
      ],
      "raw_text_hashes": [
        "f021cf48a2d547adc632476cfeef6b4fb15a6d671ce3a8dc53118b7b6f93ff07"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:11",
      "sequence": 7851,
      "chapter_label": "1SA 24",
      "verse_label": "11",
      "locator": {
        "book": "1SA",
        "chapter": 24,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 11
        }
      ],
      "en": "Moreover, my father, behold, yes, see the skirt of your robe in my hand; for in that I cut off the skirt of your robe and didn’t kill you, know and see that there is neither evil nor disobedience in my hand. I have not sinned against you, though you hunt for my life to take it.",
      "ko": "나의 아버지여 보소서 내 손에 있는 왕의 옷자락을 보소서 내가 왕을 죽이지 아니하고 겉옷자락만 베었은즉 나의 손에 악이나 죄과가 없는 줄을 아실찌니이다 왕은 내 생명을 찾아 해하려 하시나 나는 왕에게 범죄한 일이 없나이다",
      "source_text_hash": "7bc297859355c29ce2349bfb2245cada0c4d4fdf2902daadb9414d77ef95efeb",
      "translation_text_hash": "335e25335e59ec8bde850c5b67b72144839f344551aed74420131d4b9d7f63ce",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 아버지여 보소서 내 손에 있는 왕의 옷자락을 보소서 내가 왕을 죽이지 아니하고 겉옷자락만 베었은즉 나의 손에 악이나 죄과가 없는 줄을 아실찌니이다 왕은 내 생명을 찾아 해하려 하시나 나는 왕에게 범죄한 일이 없나이다"
      ],
      "raw_text_hashes": [
        "335e25335e59ec8bde850c5b67b72144839f344551aed74420131d4b9d7f63ce"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:24:12",
      "sequence": 7852,
      "chapter_label": "1SA 24",
      "verse_label": "12",
      "locator": {
        "book": "1SA",
        "chapter": 24,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 24,
          "verse": 12
        }
      ],
      "en": "May the LORD judge between me and you, and may the LORD avenge me of you; but my hand will not be on you.",
      "ko": "여호와께서는 나와 왕 사이를 판단하사 나를 위하여 왕에게 보복하시려니와 내 손으로는 왕을 해하지 않겠나이다",
      "source_text_hash": "d90d562d425414c590fda1d5b48fbb4a9fbd8d3a635967c02d2e7f9dfe42e689",
      "translation_text_hash": "d7814ddf59555b5c7a5c6de19b80d1f500e1d66942683d661eb1737fdc3bad82",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서는 나와 왕 사이를 판단하사 나를 위하여 왕에게 보복하시려니와 내 손으로는 왕을 해하지 않겠나이다"
      ],
      "raw_text_hashes": [
        "d7814ddf59555b5c7a5c6de19b80d1f500e1d66942683d661eb1737fdc3bad82"
      ]
