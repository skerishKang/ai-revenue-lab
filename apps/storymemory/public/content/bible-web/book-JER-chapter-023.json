      "raw_locator": [
        {
          "book": "JER",
          "chapter": 23,
          "verse": 6
        }
      ],
      "en": "In his days Judah will be saved, and Israel will dwell safely. This is his name by which he will be called: The LORD our righteousness.",
      "ko": "그의 날에 유다는 구원을 얻겠고 이스라엘은 평안히 거할 것이며 그 이름은 여호와 우리의 의라 일컬음을 받으리라",
      "source_text_hash": "818f5880090dd440f1ed4f34d715f2beb715fd623c3cf87b1bf79e25ba2b1786",
      "translation_text_hash": "0051f3a059c7100273f5f2a7ab0b6f64ff193a3c257634bd7f798df595a9239a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그의 날에 유다는 구원을 얻겠고 이스라엘은 평안히 거할 것이며 그 이름은 여호와 우리의 의라 일컬음을 받으리라"
      ],
      "raw_text_hashes": [
        "0051f3a059c7100273f5f2a7ab0b6f64ff193a3c257634bd7f798df595a9239a"
