    {
      "canonical_locator": "bible:web:1CO:7:35",
      "sequence": 28519,
      "chapter_label": "1CO 7",
      "verse_label": "35",
      "locator": {
        "book": "1CO",
        "chapter": 7,
        "verse": 35
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 7,
          "verse": 35
        }
      ],
      "en": "This I say for your own benefit, not that I may ensnare you, but for that which is appropriate, and that you may attend to the Lord without distraction.",
      "ko": "내가 이것을 말함은 너희의 유익을 위함이요 너희에게 올무를 놓으려 함이 아니니 오직 너희로 하여금 이치에 합하게 하여 분요함이 없이 주를 섬기게 하려 함이라",
      "source_text_hash": "9d4ebe5f719df1e74ff9a513cc7f898fb221855ace21d10c23db2d48abb702fb",
      "translation_text_hash": "feab6a3f933d59abc7bab45091da9c77ec55913d5c3f546be8a7ad7844c0fb50",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 이것을 말함은 너희의 유익을 위함이요 너희에게 올무를 놓으려 함이 아니니 오직 너희로 하여금 이치에 합하게 하여 분요함이 없이 주를 섬기게 하려 함이라"
      ],
      "raw_text_hashes": [
