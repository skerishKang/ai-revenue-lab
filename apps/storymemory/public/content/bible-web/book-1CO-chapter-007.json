      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "혹 믿지 아니하는 자가 갈리거든 갈리게 하라 형제나 자매나 이런 일에 구속 받을 것이 없느니라 그러나 하나님은 화평 중에서 너희를 부르셨느니라"
      ],
      "raw_text_hashes": [
        "1a123cb485e6b42936aaa7d21277506b531249a895ea5988585558ce6f548499"
