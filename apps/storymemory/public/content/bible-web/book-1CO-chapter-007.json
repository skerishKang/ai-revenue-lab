    {
      "canonical_locator": "bible:web:1CO:7:34",
      "sequence": 28518,
      "chapter_label": "1CO 7",
      "verse_label": "34",
      "locator": {
        "book": "1CO",
        "chapter": 7,
        "verse": 34
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 7,
          "verse": 34
        }
      ],
      "en": "There is also a difference between a wife and a virgin. The unmarried woman cares about the things of the Lord, that she may be holy both in body and in spirit. But she who is married cares about the things of the world—how she may please her husband.",
      "ko": "시집 가지 않은 자와 처녀는 주의 일을 염려하여 몸과 영을 다 거룩하게 하려 하되 시집 간 자는 세상 일을 염려하여 어찌하여야 남편을 기쁘게 할꼬 하느니라",
      "source_text_hash": "fcabc1a602244604fed1918f3387b7ad12160826b1b59e61a71d54bc26dd01ab",
      "translation_text_hash": "00075a4a9411a4ae3e85a26101399c244fa3423f41959039537d819254c7007a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시집 가지 않은 자와 처녀는 주의 일을 염려하여 몸과 영을 다 거룩하게 하려 하되 시집 간 자는 세상 일을 염려하여 어찌하여야 남편을 기쁘게 할꼬 하느니라"
      ],
      "raw_text_hashes": [
        "00075a4a9411a4ae3e85a26101399c244fa3423f41959039537d819254c7007a"
