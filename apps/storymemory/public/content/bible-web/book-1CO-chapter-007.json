        "verse": 27
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 7,
          "verse": 27
        }
      ],
      "en": "Are you bound to a wife? Don’t seek to be freed. Are you free from a wife? Don’t seek a wife.",
      "ko": "네가 아내에게 매였느냐 놓이기를 구하지 말며 아내에게서 놓였느냐 아내를 구하지 말라",
      "source_text_hash": "2b3bc9fe76ad6d29da4cb7222d44a0e52e43f8e6dd211cc864e93c2767d05e88",
      "translation_text_hash": "9869864b1ebb2a12329f7911121e8c5a8813cb8577a05739ed1c669ffdb8b3e3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 아내에게 매였느냐 놓이기를 구하지 말며 아내에게서 놓였느냐 아내를 구하지 말라"
      ],
      "raw_text_hashes": [
        "9869864b1ebb2a12329f7911121e8c5a8813cb8577a05739ed1c669ffdb8b3e3"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:7:28",
      "sequence": 28512,
      "chapter_label": "1CO 7",
      "verse_label": "28",
      "locator": {
