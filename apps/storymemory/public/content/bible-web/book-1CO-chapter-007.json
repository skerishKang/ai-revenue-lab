        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 7,
          "verse": 11
        }
      ],
      "en": "(but if she departs, let her remain unmarried, or else be reconciled to her husband), and that the husband not leave his wife.",
      "ko": "(만일 갈릴찌라도 그냥 지내든지 다시 그 남편과 화합하든지 하라) 남편도 아내를 버리지 말라",
      "source_text_hash": "2b9a597f4cb74b97d281958f39e0628e46d3198635c04a66a07497db8f339a9b",
      "translation_text_hash": "64e057088130733026b54ee4fed917c129b7f54113b2ed67a56edcb8ff7e7215",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "(만일 갈릴찌라도 그냥 지내든지 다시 그 남편과 화합하든지 하라) 남편도 아내를 버리지 말라"
      ],
      "raw_text_hashes": [
        "64e057088130733026b54ee4fed917c129b7f54113b2ed67a56edcb8ff7e7215"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:7:12",
      "sequence": 28496,
      "chapter_label": "1CO 7",
      "verse_label": "12",
      "locator": {
        "book": "1CO",
