      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아내된 자여 네가 남편을 구원할는지 어찌 알 수 있으며 남편된 자여 네가 네 아내를 구원할는지 어찌 알 수 있으리요"
      ],
      "raw_text_hashes": [
