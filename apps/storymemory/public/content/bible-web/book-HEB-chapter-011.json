    {
      "canonical_locator": "bible:web:HEB:11:6",
      "sequence": 30175,
      "chapter_label": "HEB 11",
      "verse_label": "6",
      "locator": {
        "book": "HEB",
        "chapter": 11,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 11,
          "verse": 6
        }
      ],
      "en": "Without faith it is impossible to be well pleasing to him, for he who comes to God must believe that he exists, and that he is a rewarder of those who seek him.",
      "ko": "믿음이 없이는 기쁘시게 못하나니 하나님께 나아가는 자는 반드시 그가 계신 것과 또한 그가 자기를 찾는 자들에게 상 주시는 이심을 믿어야 할찌니라",
      "source_text_hash": "4a4da27e983a9aa92ef6c0080f06a409b4d88ee35ea40287f5e84cd1113e435b",
      "translation_text_hash": "d1023ab5598f90e2cc0ec57ab870f5eea5c85d5c9316f0464cb3d923c68135d7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "믿음이 없이는 기쁘시게 못하나니 하나님께 나아가는 자는 반드시 그가 계신 것과 또한 그가 자기를 찾는 자들에게 상 주시는 이심을 믿어야 할찌니라"
      ],
      "raw_text_hashes": [
