      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "믿음으로 모든 세계가 하나님의 말씀으로 지어진 줄을 우리가 아나니 보이는 것은 나타난 것으로 말미암아 된것이 아니니라"
      ],
      "raw_text_hashes": [
        "014d03c11e4913c385495a4f5e1c702d529b74b40309ffcdaeaeb67653406c4d"
