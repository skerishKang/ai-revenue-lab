      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "믿음으로 아브라함은 부르심을 받았을 때에 순종하여 장래 기업으로 받을 땅에 나갈쌔 갈 바를 알지 못하고 나갔으며"
      ],
      "raw_text_hashes": [
        "5c2f95fb4b2953bffdd07700f58404fbe69718edd618838364f755f833212ef3"
