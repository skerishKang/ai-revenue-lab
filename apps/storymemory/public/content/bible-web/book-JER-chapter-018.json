      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "레바논의 눈이 어찌 들의 반석을 떠나겠으며 원방에서 흘러내리는 찬물이 어찌 마르겠느냐"
      ],
      "raw_text_hashes": [
        "93c7bbe64b30902b91d49137eafc8d26c4a1d2a9087e3640343dfeb3d18ef950"
