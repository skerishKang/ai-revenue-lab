      "translation_text_hash": "68898f513b07c5eef187372ea8e0b38a147c5d0628614172799255eea53a73ad",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께로부터 예레미야에게 임한 말씀에 가라사대"
      ],
      "raw_text_hashes": [
        "68898f513b07c5eef187372ea8e0b38a147c5d0628614172799255eea53a73ad"
      ]
    },
