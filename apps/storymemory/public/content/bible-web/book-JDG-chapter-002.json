      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 2,
          "verse": 11
        }
      ],
      "en": "The children of Israel did that which was evil in the LORD’s sight, and served the Baals.",
      "ko": "이스라엘 자손이 여호와의 목전에 악을 행하여 바알들을 섬기며",
      "source_text_hash": "e60f845b03b1b7c2d2b379f2bc95ab443116526b2c4be3051174c325af64eaac",
      "translation_text_hash": "3c8bce8fea1bbd17673a15b082afcdcecd48aacc845f386f9a02132f12d7a1a4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손이 여호와의 목전에 악을 행하여 바알들을 섬기며"
      ],
      "raw_text_hashes": [
        "3c8bce8fea1bbd17673a15b082afcdcecd48aacc845f386f9a02132f12d7a1a4"
      ]
    },
    {
