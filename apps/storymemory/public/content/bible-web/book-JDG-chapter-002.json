      ],
      "en": "The LORD raised up judges, who saved them out of the hand of those who plundered them.",
      "ko": "여호와께서 사사를 세우사 노략하는 자의 손에서 그들을 건져내게 하셨으나",
      "source_text_hash": "ea0b93ca77dbb0f0b072535a78253490429dca111692d3892b3ad13d84eefeba",
      "translation_text_hash": "0aefee490929defe956fe551033c2b542450a85cc2eb0efa9697733f2fbde169",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 사사를 세우사 노략하는 자의 손에서 그들을 건져내게 하셨으나"
      ],
      "raw_text_hashes": [
