      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 2,
          "verse": 13
        }
      ],
      "en": "They abandoned the LORD, and served Baal and the Ashtaroth.",
      "ko": "곧 그들이 여호와를 버리고 바알과 아스다롯을 섬겼으므로",
      "source_text_hash": "74250ab878f04ed9c40cb0d59403e3dfdc94c85b6f83b90a34c49947ad6725e2",
      "translation_text_hash": "82f3692e3cfbb7718e39cec4718ad180fb58d21cbd393b14628f75a730e14949",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "곧 그들이 여호와를 버리고 바알과 아스다롯을 섬겼으므로"
      ],
      "raw_text_hashes": [
        "82f3692e3cfbb7718e39cec4718ad180fb58d21cbd393b14628f75a730e14949"
