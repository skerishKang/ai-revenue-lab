      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한 계집은 말하되 내 주여 나와 이 계집이 한 집에서 사는데 내가 저와 함께 집에 있으며 아이를 낳았더니"
      ],
      "raw_text_hashes": [
        "ccc89c1190ba369b57b223f9677d19e679ecf0ccb8608252d6024c0e728a3c8c"
