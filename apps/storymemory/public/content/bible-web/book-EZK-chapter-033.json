    {
      "canonical_locator": "bible:web:EZK:33:8",
      "sequence": 21289,
      "chapter_label": "EZK 33",
      "verse_label": "8",
      "locator": {
        "book": "EZK",
        "chapter": 33,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 33,
          "verse": 8
        }
      ],
      "en": "When I tell the wicked, ‘O wicked man, you will surely die,’ and you don’t speak to warn the wicked from his way, that wicked man will die in his iniquity, but I will require his blood at your hand.",
      "ko": "가령 내가 악인에게 이르기를 악인아 너는 정녕 죽으리라 하였다 하자 네가 그 악인에게 말로 경고하여 그 길에서 떠나게 아니하면 그 악인은 자기 죄악 중에서 죽으려니와 내가 그 피를 네 손에서 찾으리라",
      "source_text_hash": "2c9e48e756639c20662f1b3e6424ef458fac3cf5fd517aace4cc3c768751e8f4",
      "translation_text_hash": "d94ae2c299468a2cc0fc9bce2e17fa4dd5166852b4875af404073e3ffe57cad0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가령 내가 악인에게 이르기를 악인아 너는 정녕 죽으리라 하였다 하자 네가 그 악인에게 말로 경고하여 그 길에서 떠나게 아니하면 그 악인은 자기 죄악 중에서 죽으려니와 내가 그 피를 네 손에서 찾으리라"
      ],
      "raw_text_hashes": [
        "d94ae2c299468a2cc0fc9bce2e17fa4dd5166852b4875af404073e3ffe57cad0"
