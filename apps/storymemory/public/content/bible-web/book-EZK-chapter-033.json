        {
          "book": "EZK",
          "chapter": 33,
          "verse": 3
        }
      ],
      "en": "if, when he sees the sword come on the land, he blows the trumpet and warns the people,",
      "ko": "그 사람이 칼이 그 땅에 임함을 보고 나팔을 불어 백성에게 경고하되",
      "source_text_hash": "746bb0e0eaaf5ff44fdc269716c589215c4edae2fd62cb3b6763f6197776e44d",
      "translation_text_hash": "5fb0078454d8da0b206ed2acbf029161016cc3701dcef40b630e842548128b22",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사람이 칼이 그 땅에 임함을 보고 나팔을 불어 백성에게 경고하되"
      ],
      "raw_text_hashes": [
        "5fb0078454d8da0b206ed2acbf029161016cc3701dcef40b630e842548128b22"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:33:4",
      "sequence": 21285,
      "chapter_label": "EZK 33",
      "verse_label": "4",
      "locator": {
