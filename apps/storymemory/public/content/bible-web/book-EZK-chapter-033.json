    {
      "canonical_locator": "bible:web:EZK:33:21",
      "sequence": 21302,
      "chapter_label": "EZK 33",
      "verse_label": "21",
      "locator": {
        "book": "EZK",
        "chapter": 33,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 33,
          "verse": 21
        }
      ],
      "en": "In the twelfth year of our captivity, in the tenth month, in the fifth day of the month, one who had escaped out of Jerusalem came to me, saying, “The city has been defeated!”",
      "ko": "우리가 사로잡힌지 십 이년 시월 오일에 예루살렘에서부터 도망하여 온 자가 내게 나아와 말하기를 그 성이 함락되었다 하였는데",
      "source_text_hash": "980bb2e7577d4c3eb4acf49a2c31f00622faf6caea98e0a1b0588ecf6d4a1927",
      "translation_text_hash": "6a0240f46597b1fe2390256837f8f71a9a1250eb26f4844430707b369cd0962a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 사로잡힌지 십 이년 시월 오일에 예루살렘에서부터 도망하여 온 자가 내게 나아와 말하기를 그 성이 함락되었다 하였는데"
      ],
      "raw_text_hashes": [
