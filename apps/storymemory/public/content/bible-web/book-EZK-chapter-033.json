    {
      "canonical_locator": "bible:web:EZK:33:9",
      "sequence": 21290,
      "chapter_label": "EZK 33",
      "verse_label": "9",
      "locator": {
        "book": "EZK",
        "chapter": 33,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 33,
          "verse": 9
        }
      ],
      "en": "Nevertheless, if you warn the wicked of his way to turn from it, and he doesn’t turn from his way; he will die in his iniquity, but you have delivered your soul.",
      "ko": "그러나 너는 악인에게 경고하여 돌이켜 그 길에서 떠나라고 하되 그가 돌이켜 그 길에서 떠나지 아니하면 그는 자기 죄악 중에서 죽으려니와 너는 네 생명을 보전하리라",
      "source_text_hash": "b54ded933a7af3d9734b12381e5a184e9484efe68f513ec177859f11e017e8fe",
      "translation_text_hash": "102096fd7b98d354c2421cbf77061461006bea398b707db76ed462c96ddae3e1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 너는 악인에게 경고하여 돌이켜 그 길에서 떠나라고 하되 그가 돌이켜 그 길에서 떠나지 아니하면 그는 자기 죄악 중에서 죽으려니와 너는 네 생명을 보전하리라"
      ],
      "raw_text_hashes": [
