    {
      "canonical_locator": "bible:web:EZK:33:28",
      "sequence": 21309,
      "chapter_label": "EZK 33",
      "verse_label": "28",
      "locator": {
        "book": "EZK",
        "chapter": 33,
        "verse": 28
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 33,
          "verse": 28
        }
      ],
      "en": "I will make the land a desolation and an astonishment. The pride of her power will cease. The mountains of Israel will be desolate, so that no one will pass through.",
      "ko": "내가 그 땅으로 황무지와 놀라움이 되게 하고 그 권능의 교만을 그치게 하리니 이스라엘의 산들이 황무하여 지나갈 사람이 없으리라",
      "source_text_hash": "bce46ea3e87614e0cb79fa01e3c46b68fd9229b63c279e04b060dae61b04323e",
      "translation_text_hash": "f7dfa2f17e20a93e858bd1c06d664c566e589b0ccc6c26332fd3b7c8972b3c60",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 그 땅으로 황무지와 놀라움이 되게 하고 그 권능의 교만을 그치게 하리니 이스라엘의 산들이 황무하여 지나갈 사람이 없으리라"
      ],
      "raw_text_hashes": [
