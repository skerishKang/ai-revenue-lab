      ],
      "en": "When Samuel was old, he made his sons judges over Israel.",
      "ko": "사무엘이 늙으매 그 아들들로 이스라엘 사사를 삼으니",
      "source_text_hash": "55d804f802f1b3ea210a09cf79c8bb72e708f91be2950cd869c44a897fef3577",
      "translation_text_hash": "6af6a62d3dfdf1142988d3896bb61cb316f982f327810283c8b7970521bb0471",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사무엘이 늙으매 그 아들들로 이스라엘 사사를 삼으니"
      ],
      "raw_text_hashes": [
        "6af6a62d3dfdf1142988d3896bb61cb316f982f327810283c8b7970521bb0471"
      ]
    },
    {
