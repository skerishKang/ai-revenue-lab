      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 8,
          "verse": 10
        }
      ],
      "en": "Samuel told all the LORD’s words to the people who asked him for a king.",
      "ko": "사무엘이 왕을 구하는 백성에게 여호와의 모든 말씀을 일러",
      "source_text_hash": "c8da5adfc5951c8bfdea024cb0d927ea780abbf095caabfdbb772ea9bbbf3aae",
      "translation_text_hash": "5612f30102987dd6bff7a6a95fd27f548ae8e5ae6e421fddbe7dc8a1a83a2038",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사무엘이 왕을 구하는 백성에게 여호와의 모든 말씀을 일러"
      ],
      "raw_text_hashes": [
        "5612f30102987dd6bff7a6a95fd27f548ae8e5ae6e421fddbe7dc8a1a83a2038"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:8:11",
      "sequence": 7381,
      "chapter_label": "1SA 8",
      "verse_label": "11",
      "locator": {
