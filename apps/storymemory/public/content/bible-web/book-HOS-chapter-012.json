        {
          "book": "HOS",
          "chapter": 12,
          "verse": 7
        }
      ],
      "en": "A merchant has dishonest scales in his hand. He loves to defraud.",
      "ko": "저는 상고여늘 손에 거짓 저울을 가지고 사취하기를 좋아하는도다",
      "source_text_hash": "30b37c67369eec9f2894fe38456115dc42ba6b6dd71b0a190b32031ec2a49e67",
      "translation_text_hash": "a8d25d88c46101a0cf7165707a5159e674c68362bf90bdab245fbf6927f83bbd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저는 상고여늘 손에 거짓 저울을 가지고 사취하기를 좋아하는도다"
      ],
      "raw_text_hashes": [
        "a8d25d88c46101a0cf7165707a5159e674c68362bf90bdab245fbf6927f83bbd"
      ]
