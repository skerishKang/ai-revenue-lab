      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 12,
          "verse": 6
        }
      ],
      "en": "Therefore turn to your God. Keep kindness and justice, and wait continually for your God.",
      "ko": "그런즉 너의 하나님께로 돌아와서 인애와 공의를 지키며 항상 너의 하나님을 바라볼찌니라",
      "source_text_hash": "0afe105c9202d8cea014b947dd8b71efb3121509315ebed4ed3ad65dd97cf710",
      "translation_text_hash": "80ebe6e2aff888f381f2d6cbadc11c6b79948f16fa15113b54e853102cac22be",
      "translation_policy": "krv-1961-source-mapped",
