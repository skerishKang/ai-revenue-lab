      "raw_texts": [
        "만일 총명이 있거든 이것을 들으며 내 말소리에 귀를 기울이라"
      ],
      "raw_text_hashes": [
        "ad5ecdadba950013559049a9b9702af9caed119996623649f43cd725f474b505"
      ]
