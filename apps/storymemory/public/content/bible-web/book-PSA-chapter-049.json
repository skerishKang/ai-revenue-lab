      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 49,
          "verse": 2
        }
      ],
      "en": "both low and high, rich and poor together.",
      "ko": "귀천 빈부를 물론하고 다 들을찌어다",
      "source_text_hash": "dae2030b323213712ee55e442ad8356c8b29ef52d922aceda5fd6a7d58307b7f",
      "translation_text_hash": "b970169bc1dcc98df4b4796daaadface40667a6efb8c29c292ff41c76f62eb61",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "귀천 빈부를 물론하고 다 들을찌어다"
      ],
      "raw_text_hashes": [
        "b970169bc1dcc98df4b4796daaadface40667a6efb8c29c292ff41c76f62eb61"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:49:3",
      "sequence": 14652,
      "chapter_label": "PSA 49",
      "verse_label": "3",
      "locator": {
        "book": "PSA",
