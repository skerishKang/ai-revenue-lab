        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 49,
          "verse": 5
        }
      ],
      "en": "Why should I fear in the days of evil, when iniquity at my heels surrounds me?",
      "ko": "죄악이 나를 따라 에우는 환난의 날에 내가 어찌 두려워하랴",
      "source_text_hash": "d92b97d536e95eb3021a564e0d0675c2ddd646c01228388f96b3caa3900f0f6d",
      "translation_text_hash": "90a282a08a02dc2d559c123b597d6b25370ad76c113dd3e8c7dffbce75bec472",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "죄악이 나를 따라 에우는 환난의 날에 내가 어찌 두려워하랴"
      ],
      "raw_text_hashes": [
        "90a282a08a02dc2d559c123b597d6b25370ad76c113dd3e8c7dffbce75bec472"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:49:6",
      "sequence": 14655,
      "chapter_label": "PSA 49",
      "verse_label": "6",
      "locator": {
        "book": "PSA",
        "chapter": 49,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 49,
          "verse": 6
        }
      ],
      "en": "Those who trust in their wealth, and boast in the multitude of their riches—",
      "ko": "자기의 재물을 의지하고 풍부함으로 자긍하는 자는",
      "source_text_hash": "ab8054e3131f8a6c052ec064d052c3343a5a74d6f8e95fb1640ccf9221e92142",
      "translation_text_hash": "2894867c468af11e6dfca67df3d5d1db6fe5a563e58a79a4b424982d10219225",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "자기의 재물을 의지하고 풍부함으로 자긍하는 자는"
      ],
      "raw_text_hashes": [
        "2894867c468af11e6dfca67df3d5d1db6fe5a563e58a79a4b424982d10219225"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:49:7",
      "sequence": 14656,
      "chapter_label": "PSA 49",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 49,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 49,
          "verse": 7
        }
      ],
      "en": "none of them can by any means redeem his brother, nor give God a ransom for him.",
      "ko": "아무도 결코 그 형제를 구속하지 못하며 저를 위하여 하나님께 속전을 바치지도 못할 것은",
      "source_text_hash": "db682a07b2b3988bdc5208943f323e5c5f3f6b9b84cf9c70f03e0c2486e17d39",
      "translation_text_hash": "95629ccbbe1f71b628440a138bb394ae446ab589eeca75590764d1b8509002a1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아무도 결코 그 형제를 구속하지 못하며 저를 위하여 하나님께 속전을 바치지도 못할 것은"
      ],
      "raw_text_hashes": [
        "95629ccbbe1f71b628440a138bb394ae446ab589eeca75590764d1b8509002a1"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:49:8",
      "sequence": 14657,
      "chapter_label": "PSA 49",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
