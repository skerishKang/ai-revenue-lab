        "verse": 3
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 49,
          "verse": 3
        }
      ],
      "en": "My mouth will speak words of wisdom. My heart will utter understanding.",
      "ko": "내 입은 지혜를 말하겠고 내 마음은 명철을 묵상하리로다",
      "source_text_hash": "2ecb7fba6d192cdf881d579ab9b8b42fc886a64122f2c060604e84251d55c137",
      "translation_text_hash": "da46411273646cfd2ab96ea6b95c94ce7d4b2975107ad87d28cd72c1770b3a8c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 입은 지혜를 말하겠고 내 마음은 명철을 묵상하리로다"
      ],
      "raw_text_hashes": [
        "da46411273646cfd2ab96ea6b95c94ce7d4b2975107ad87d28cd72c1770b3a8c"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:49:4",
      "sequence": 14653,
      "chapter_label": "PSA 49",
      "verse_label": "4",
      "locator": {
        "book": "PSA",
        "chapter": 49,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 49,
          "verse": 4
        }
      ],
      "en": "I will incline my ear to a proverb. I will solve my riddle on the harp.",
      "ko": "내가 비유에 내 귀를 기울이고 수금으로 나의 오묘한 말을 풀리로다",
      "source_text_hash": "ecd41260bb09071f63bb9f7e7273ed139735c31abc221606899a5e8f9cf7b9af",
      "translation_text_hash": "e23c7559d1c260280a8464710097c58000285494e17758ec06c2d0dcf5074be4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 비유에 내 귀를 기울이고 수금으로 나의 오묘한 말을 풀리로다"
      ],
      "raw_text_hashes": [
        "e23c7559d1c260280a8464710097c58000285494e17758ec06c2d0dcf5074be4"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:49:5",
      "sequence": 14654,
      "chapter_label": "PSA 49",
      "verse_label": "5",
      "locator": {
        "book": "PSA",
