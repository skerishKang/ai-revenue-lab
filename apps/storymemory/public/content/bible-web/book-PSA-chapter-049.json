        {
          "book": "PSA",
          "chapter": 49,
          "verse": 1
        }
      ],
      "en": "Hear this, all you peoples. Listen, all you inhabitants of the world,",
      "ko": "만민들아 이를 들으라 세상의 거민들아 귀를 기울이라",
      "source_text_hash": "3900ad39d84114f937b38605afd28026e4899da177fd2d43b021506e60f8fc8c",
      "translation_text_hash": "e7d4e1d4e66d1a9ed6a41e9a66a44ee96c158c631ee7c408f3222bbfa086067f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만민들아 이를 들으라 세상의 거민들아 귀를 기울이라"
      ],
      "raw_text_hashes": [
        "e7d4e1d4e66d1a9ed6a41e9a66a44ee96c158c631ee7c408f3222bbfa086067f"
      ]
