      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 43,
          "verse": 13
        }
      ],
      "en": "Take your brother also, get up, and return to the man.",
      "ko": "네 아우도 데리고 떠나 다시 그 사람에게로 가라",
      "source_text_hash": "73f0e858e42cb6df410aece1a2ea9147142156dd2526bb629b7ad64f671e5f26",
