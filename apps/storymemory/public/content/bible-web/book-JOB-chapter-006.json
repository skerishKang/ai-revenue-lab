      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "피곤한 자 곧 전능자, 경외하는 일을 폐한 자를 그 벗이 불쌍히 여길 것이어늘"
      ],
      "raw_text_hashes": [
