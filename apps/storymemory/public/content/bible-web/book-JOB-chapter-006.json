      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 분한을 달아 보며 나의 모든 재앙을 저울에 둘 수 있으면"
      ],
      "raw_text_hashes": [
        "eb0d999e55dcd547c72cfc56ab34aeec18350a127686da5942b2feec4a681f61"
      ]
    },
