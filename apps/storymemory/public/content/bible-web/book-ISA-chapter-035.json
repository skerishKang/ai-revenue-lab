        "verse": 5
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 35,
          "verse": 5
        }
      ],
      "en": "Then the eyes of the blind will be opened, and the ears of the deaf will be unstopped.",
      "ko": "그 때에 소경의 눈이 밝을 것이며 귀머거리의 귀가 열릴 것이며",
      "source_text_hash": "2fb18d52a16aea27789fe9cfd7e54156929049e0d36b4f3942a54054401da896",
      "translation_text_hash": "933000b011590f96f5e486a960a460aaa5389f57bab0ce941853afc7496b3f21",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 때에 소경의 눈이 밝을 것이며 귀머거리의 귀가 열릴 것이며"
      ],
      "raw_text_hashes": [
        "933000b011590f96f5e486a960a460aaa5389f57bab0ce941853afc7496b3f21"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:35:6",
      "sequence": 18327,
      "chapter_label": "ISA 35",
      "verse_label": "6",
      "locator": {
