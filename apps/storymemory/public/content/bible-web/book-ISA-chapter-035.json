      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 35,
          "verse": 3
        }
      ],
      "en": "Strengthen the weak hands, and make the feeble knees firm.",
      "ko": "너희는 약한 손을 강하게 하여주며 떨리는 무릎을 굳게 하여주며",
      "source_text_hash": "d6da0aad3d41dad0aab6de9726bb27f0f9cbc175af418a16b4a12e388160f2c8",
      "translation_text_hash": "8af56770d8ded62fdbd3d8ada3a41969bb9560591ef64af415bc1e1816aa4673",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 약한 손을 강하게 하여주며 떨리는 무릎을 굳게 하여주며"
      ],
      "raw_text_hashes": [
        "8af56770d8ded62fdbd3d8ada3a41969bb9560591ef64af415bc1e1816aa4673"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:35:4",
      "sequence": 18325,
      "chapter_label": "ISA 35",
      "verse_label": "4",
      "locator": {
