    {
      "canonical_locator": "bible:web:ISA:44:25",
      "sequence": 18559,
      "chapter_label": "ISA 44",
      "verse_label": "25",
      "locator": {
        "book": "ISA",
        "chapter": 44,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 44,
          "verse": 25
        }
