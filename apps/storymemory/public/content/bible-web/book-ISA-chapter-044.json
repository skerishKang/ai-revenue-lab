      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들이 풀 가운데서 솟아나기를 시냇가의 버들 같이 할 것이라"
      ],
      "raw_text_hashes": [
        "ce4db7010083ef8d39c8edd9ca21fa33a6e446a7c1ea397b73878d71a43f4817"
