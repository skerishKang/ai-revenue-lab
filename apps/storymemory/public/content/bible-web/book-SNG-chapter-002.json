      "translation_text_hash": "dca59a541266e477159e5598a1befedcd6ed5eba55a5904843748d99df3ea536",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여자들 중에 내 사랑은 가시나무 가운데 백합화 같구나"
      ],
      "raw_text_hashes": [
        "dca59a541266e477159e5598a1befedcd6ed5eba55a5904843748d99df3ea536"
      ]
