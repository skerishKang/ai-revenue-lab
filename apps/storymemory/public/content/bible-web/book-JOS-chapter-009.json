      ]
    },
    {
      "canonical_locator": "bible:web:JOS:9:21",
      "sequence": 6059,
      "chapter_label": "JOS 9",
      "verse_label": "21",
      "locator": {
        "book": "JOS",
        "chapter": 9,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 9,
          "verse": 21
        }
      ],
      "en": "The princes said to them, “Let them live.” So they became wood cutters and drawers of water for all the congregation, as the princes had spoken to them.",
      "ko": "무리에게 이르되 그들을 살리라 하니 족장들이 그들에게 이른대로 그들이 온 회중을 위하여 나무 패며 물 긷는 자가 되었더라",
      "source_text_hash": "24dba4c88d07d252f5d3ad14359e7d75801a557ce97dd574146c7266dbe9661a",
      "translation_text_hash": "e1a41ee740ec588c91149faca01e0e34cdac7c9f47bf9610c681380591467122",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무리에게 이르되 그들을 살리라 하니 족장들이 그들에게 이른대로 그들이 온 회중을 위하여 나무 패며 물 긷는 자가 되었더라"
      ],
      "raw_text_hashes": [
        "e1a41ee740ec588c91149faca01e0e34cdac7c9f47bf9610c681380591467122"
