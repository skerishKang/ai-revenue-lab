        "verse": 20
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 9,
          "verse": 20
        }
      ],
      "en": "We will do this to them, and let them live; lest wrath be on us, because of the oath which we swore to them.”",
      "ko": "우리가 그들에게 맹세한 맹약을 인하여 진노가 우리에게 임할까 하노니 이렇게 행하여 그들을 살리리라 하고",
      "source_text_hash": "6db280d8bf0b24c0bd49e7a97631c7938428c38604e0b6bac08a17cbf3638c98",
      "translation_text_hash": "f73166e710a6b1762e4cee4035737e7cb24ef8f6b2cf4aae49b64dd4a56854a6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 그들에게 맹세한 맹약을 인하여 진노가 우리에게 임할까 하노니 이렇게 행하여 그들을 살리리라 하고"
      ],
      "raw_text_hashes": [
