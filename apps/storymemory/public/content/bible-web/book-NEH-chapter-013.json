        "verse": 8
      },
      "raw_locator": [
        {
          "book": "NEH",
          "chapter": 13,
          "verse": 8
        }
      ],
      "en": "It grieved me severely. Therefore I threw all Tobiah’s household stuff out of the room.",
      "ko": "내가 심히 근심하여 도비야의 세간을 그 방 밖으로 다 내어 던지고",
      "source_text_hash": "91874a4c65534db14282c3163aebfd5251d903ccdc9ab1711567bccc91720e60",
      "translation_text_hash": "5a56108952d30f058581ebcfd755ca6193ca6497c55dd6d586eb4cb489a75258",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 심히 근심하여 도비야의 세간을 그 방 밖으로 다 내어 던지고"
      ],
      "raw_text_hashes": [
        "5a56108952d30f058581ebcfd755ca6193ca6497c55dd6d586eb4cb489a75258"
      ]
    },
    {
      "canonical_locator": "bible:web:NEH:13:9",
      "sequence": 12681,
      "chapter_label": "NEH 13",
      "verse_label": "9",
      "locator": {
