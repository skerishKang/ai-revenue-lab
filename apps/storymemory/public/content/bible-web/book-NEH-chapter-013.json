    {
      "canonical_locator": "bible:web:NEH:13:22",
      "sequence": 12694,
      "chapter_label": "NEH 13",
      "verse_label": "22",
      "locator": {
        "book": "NEH",
        "chapter": 13,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "NEH",
          "chapter": 13,
          "verse": 22
        }
      ],
      "en": "I commanded the Levites that they should purify themselves, and that they should come and keep the gates, to sanctify the Sabbath day. Remember me for this also, my God, and spare me according to the greatness of your loving kindness.",
      "ko": "내가 또 레위 사람들을 명하여 몸을 정결케 하고 와서 성문을 지켜서 안식일로 거룩하게 하라 하였느니라 나의 하나님이여 나를 위하여 이 일도 기억하옵시고 주의 큰 은혜대로 나를 아끼시옵소서",
      "source_text_hash": "03076be6a215f54ded439b50a3e9cfdc56ec96e37ca1068ca8a4b853f39ef600",
      "translation_text_hash": "6bc90e16289e6a706d3c70ccd56e25d0af99c041a1f38361a3697bd8e8711a95",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 또 레위 사람들을 명하여 몸을 정결케 하고 와서 성문을 지켜서 안식일로 거룩하게 하라 하였느니라 나의 하나님이여 나를 위하여 이 일도 기억하옵시고 주의 큰 은혜대로 나를 아끼시옵소서"
      ],
      "raw_text_hashes": [
