      "source_text_hash": "3f1b2d4ab3a9435562419561571d7774ef3781ced9a75a8775750c1ccd5911dc",
      "translation_text_hash": "f2f61ee417493501d72087c2e41e98aa229fc4f0c9cc498e7d1fd84da9ac616a",
      "translation_policy": "krv-1961-source-mapped",
