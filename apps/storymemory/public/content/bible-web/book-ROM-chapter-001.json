      "raw_texts": [
        "복음에는 하나님의 의가 나타나서 믿음으로 믿음에 이르게 하나니 기록된바 오직 의인은 믿음으로 말미암아 살리라 함과 같으니라"
      ],
      "raw_text_hashes": [
