        "verse": 11
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 6,
          "verse": 11
        }
      ],
      "en": "He shall take off his garments, and put on other garments, and carry the ashes outside the camp to a clean place.",
      "ko": "그 옷을 벗고 다른 옷을 입고 그 재를 진 바깥 정결한 곳으로 가져 갈 것이요",
      "source_text_hash": "444ca893083b3e4de761d85bc45420ad6c42b1084369dc48182c496729b0cf25",
      "translation_text_hash": "053b346c35265c73ccbe0b61770befb6082e31532cf4a99d31c07dc8799d38ea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 옷을 벗고 다른 옷을 입고 그 재를 진 바깥 정결한 곳으로 가져 갈 것이요"
      ],
      "raw_text_hashes": [
        "053b346c35265c73ccbe0b61770befb6082e31532cf4a99d31c07dc8799d38ea"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:6:12",
      "sequence": 2862,
      "chapter_label": "LEV 6",
      "verse_label": "12",
      "locator": {
