      ],
      "raw_text_hashes": [
        "f1bd9ed27fa5e9fca4c5f49167160a4974d2d83934c7f489a8dc3d8331abd91a"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:6:14",
      "sequence": 2864,
