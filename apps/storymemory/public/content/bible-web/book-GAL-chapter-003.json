        "verse": 6
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 6
        }
      ],
      "en": "Even so, Abraham “believed God, and it was counted to him for righteousness.”",
      "ko": "아브라함이 하나님을 믿으매 이것을 그에게 의로 정하셨다 함과 같으니라",
      "source_text_hash": "427824e18cf29b478c5729e2dae28e08fe2e1ce87dbcff45e04f9e2d5bc776f3",
      "translation_text_hash": "1caf7e774491469e3d1205119257146c6e9f7457b20520eed06f336094317bf9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브라함이 하나님을 믿으매 이것을 그에게 의로 정하셨다 함과 같으니라"
      ],
      "raw_text_hashes": [
        "1caf7e774491469e3d1205119257146c6e9f7457b20520eed06f336094317bf9"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:7",
      "sequence": 29106,
      "chapter_label": "GAL 3",
      "verse_label": "7",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 7
        }
      ],
      "en": "Know therefore that those who are of faith are children of Abraham.",
      "ko": "그런즉 믿음으로 말미암은 자들은 아브라함의 아들인줄 알찌어다",
      "source_text_hash": "68cb4693ac8aab1bb8d74566b8b5d40888d9882bfd0f227e31e5be89a4985aae",
      "translation_text_hash": "699ded582d2df92fcbcd20b511f52ef65b615ece91d3e98d0b42e56a9938163c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그런즉 믿음으로 말미암은 자들은 아브라함의 아들인줄 알찌어다"
      ],
      "raw_text_hashes": [
        "699ded582d2df92fcbcd20b511f52ef65b615ece91d3e98d0b42e56a9938163c"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:8",
      "sequence": 29107,
      "chapter_label": "GAL 3",
      "verse_label": "8",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 8
        }
      ],
      "en": "The Scripture, foreseeing that God would justify the Gentiles by faith, preached the Good News beforehand to Abraham, saying, “In you all the nations will be blessed.”",
      "ko": "또 하나님이 이방을 믿음으로 말미암아 의로 정하실 것을 성경이 미리 알고 먼저 아브라함에게 복음을 전하되 모든 이방이 너를 인하여 복을 받으리라 하였으니",
      "source_text_hash": "f9e9ec09e9a1b8027ad2f952cc33d9a8d63eb02532e1001120c5331f6a937793",
      "translation_text_hash": "b5cead6a9cf78dcc3533123e77ec3b465a5e9d3caa5a5b374944243cb4889e0d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 하나님이 이방을 믿음으로 말미암아 의로 정하실 것을 성경이 미리 알고 먼저 아브라함에게 복음을 전하되 모든 이방이 너를 인하여 복을 받으리라 하였으니"
      ],
      "raw_text_hashes": [
        "b5cead6a9cf78dcc3533123e77ec3b465a5e9d3caa5a5b374944243cb4889e0d"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:9",
      "sequence": 29108,
      "chapter_label": "GAL 3",
      "verse_label": "9",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 9
        }
      ],
      "en": "So then, those who are of faith are blessed with the faithful Abraham.",
      "ko": "그러므로 믿음으로 말미암은 자는 믿음이 있는 아브라함과 함께 복을 받느니라",
      "source_text_hash": "d9badb93cc3a9ff4f5ff772c386fadeb1a686ea7f48f823f8292e2ea5f2c2d9e",
      "translation_text_hash": "3d5b29a7be1b9c70b63b1523add128b66fc1feb6b1644120bb944cedac149848",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 믿음으로 말미암은 자는 믿음이 있는 아브라함과 함께 복을 받느니라"
      ],
      "raw_text_hashes": [
        "3d5b29a7be1b9c70b63b1523add128b66fc1feb6b1644120bb944cedac149848"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:10",
      "sequence": 29109,
      "chapter_label": "GAL 3",
      "verse_label": "10",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 10
        }
      ],
      "en": "For as many as are of the works of the law are under a curse. For it is written, “Cursed is everyone who doesn’t continue in all things that are written in the book of the law, to do them.”",
      "ko": "무릇 율법 행위에 속한 자들은 저주 아래 있나니 기록된바 누구든지 율법 책에 기록된대로 온갖 일을 항상 행하지 아니하는 자는 저주 아래 있는 자라 하였음이라",
      "source_text_hash": "7326aeaf55e8789a9dd0e08f3cf7ec49c190808a17c55885a0f21f03cadd02fc",
      "translation_text_hash": "43ed5fc861f2bcf2a0207a3cb031914e107e7526ec16c0eaf5a7963c0a83749f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 율법 행위에 속한 자들은 저주 아래 있나니 기록된바 누구든지 율법 책에 기록된대로 온갖 일을 항상 행하지 아니하는 자는 저주 아래 있는 자라 하였음이라"
      ],
      "raw_text_hashes": [
        "43ed5fc861f2bcf2a0207a3cb031914e107e7526ec16c0eaf5a7963c0a83749f"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:11",
      "sequence": 29110,
      "chapter_label": "GAL 3",
      "verse_label": "11",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 11
        }
      ],
      "en": "Now that no man is justified by the law before God is evident, for, “The righteous will live by faith.”",
      "ko": "또 하나님 앞에서 아무나 율법으로 말미암아 의롭게 되지 못할 것이 분명하니 이는 의인이 믿음으로 살리라 하였음이니라",
      "source_text_hash": "507587462d9e631731b4527b23ba4288dd07d00ae0014532830f00b037d2ff09",
      "translation_text_hash": "d441e30e5aa4f5c761551b6bb0215ea1674dcdac637049f3e6402758e5ceeab3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 하나님 앞에서 아무나 율법으로 말미암아 의롭게 되지 못할 것이 분명하니 이는 의인이 믿음으로 살리라 하였음이니라"
      ],
      "raw_text_hashes": [
        "d441e30e5aa4f5c761551b6bb0215ea1674dcdac637049f3e6402758e5ceeab3"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:12",
      "sequence": 29111,
      "chapter_label": "GAL 3",
      "verse_label": "12",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 12
        }
      ],
      "en": "The law is not of faith, but, “The man who does them will live by them.”",
      "ko": "율법은 믿음에서 난것이 아니라 이를 행하는 자는 그 가운데서 살리라 하였느니라",
      "source_text_hash": "6ef8c327b648a603937e85622aade4907dbba88072869b24f04d639092663f1d",
      "translation_text_hash": "afd9e5e8ff0ad2d1df3638f53be6b12b711d20a2c243904f7890d7dbf9d2e986",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "율법은 믿음에서 난것이 아니라 이를 행하는 자는 그 가운데서 살리라 하였느니라"
      ],
      "raw_text_hashes": [
        "afd9e5e8ff0ad2d1df3638f53be6b12b711d20a2c243904f7890d7dbf9d2e986"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:13",
      "sequence": 29112,
      "chapter_label": "GAL 3",
      "verse_label": "13",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 13
        }
      ],
      "en": "Christ redeemed us from the curse of the law, having become a curse for us. For it is written, “Cursed is everyone who hangs on a tree,”",
      "ko": "그리스도께서 우리를 위하여 저주를 받은바 되사 율법의 저주에서 우리를 속량하셨으니 기록된바 나무에 달린 자마다 저주 아래 있는 자라 하였음이라",
      "source_text_hash": "55ab41cf529c62f3f9eb13f4014de144ba20ee896cac13ced92f2134198893fc",
      "translation_text_hash": "2c1cafd33123dba8c8551f91b4c758a5e10886f9ce19bcb5fc7e267733637d6a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그리스도께서 우리를 위하여 저주를 받은바 되사 율법의 저주에서 우리를 속량하셨으니 기록된바 나무에 달린 자마다 저주 아래 있는 자라 하였음이라"
      ],
      "raw_text_hashes": [
        "2c1cafd33123dba8c8551f91b4c758a5e10886f9ce19bcb5fc7e267733637d6a"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:14",
      "sequence": 29113,
      "chapter_label": "GAL 3",
      "verse_label": "14",
      "locator": {
        "book": "GAL",
        "chapter": 3,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 14
        }
      ],
      "en": "that the blessing of Abraham might come on the Gentiles through Christ Jesus, that we might receive the promise of the Spirit through faith.",
      "ko": "이는 그리스도 예수 안에서 아브라함의 복이 이방인에게 미치게 하고 또 우리로 하여금 믿음으로 말미암아 성령의 약속을 받게 하려 함이니라",
      "source_text_hash": "163d904e8517b222ab21c456a76b8b0c537aab49efd4114bc28c6d0fde1b6d5a",
      "translation_text_hash": "07244a1ffaa7673b0e6f3cb48adf0af44af5d1702708e850d8820eb53a8e8788",
      "translation_policy": "krv-1961-source-mapped",
