      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 4
        }
      ],
      "en": "Did you suffer so many things in vain, if it is indeed in vain?",
      "ko": "너희가 이같이 많은 괴로움을 헛되이 받았느냐 과연 헛되냐",
      "source_text_hash": "7d68332a54e2ff8709e3d809849d7b0f5f968eb2182133d9240644e8ace3e591",
      "translation_text_hash": "92b64410e788d96d365e180e7f2298b160bc17138868bcf1f8c06e21a52176ae",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 이같이 많은 괴로움을 헛되이 받았느냐 과연 헛되냐"
      ],
      "raw_text_hashes": [
        "92b64410e788d96d365e180e7f2298b160bc17138868bcf1f8c06e21a52176ae"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:5",
      "sequence": 29104,
      "chapter_label": "GAL 3",
      "verse_label": "5",
      "locator": {
