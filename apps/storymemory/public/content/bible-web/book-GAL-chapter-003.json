        "verse": 3
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 3,
          "verse": 3
        }
      ],
      "en": "Are you so foolish? Having begun in the Spirit, are you now completed in the flesh?",
      "ko": "너희가 이같이 어리석으냐 성령으로 시작하였다가 이제는 육체로 마치겠느냐",
      "source_text_hash": "3bdce003bb493ca712d8d811a15080aa960fa85fa056eb55b68c6f73adaf7b10",
      "translation_text_hash": "59e66b24894362309d180f173fd9f8b712edca28dcc9c65066a6636441145f8a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 이같이 어리석으냐 성령으로 시작하였다가 이제는 육체로 마치겠느냐"
      ],
      "raw_text_hashes": [
        "59e66b24894362309d180f173fd9f8b712edca28dcc9c65066a6636441145f8a"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:3:4",
      "sequence": 29103,
      "chapter_label": "GAL 3",
      "verse_label": "4",
      "locator": {
