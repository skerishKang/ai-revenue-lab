      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 10,
          "verse": 2
        }
      ],
      "en": "But one who enters in by the door is the shepherd of the sheep.",
      "ko": "문으로 들어가는 이가 양의 목자라",
      "source_text_hash": "129285a481cec55d2768e4df2d748321d788099b9935eb59a9c94c02faeccb5e",
      "translation_text_hash": "40a0f84c625dc9fa96c604b8ffbe2b40846984f425e618b42c86a60802188df8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "문으로 들어가는 이가 양의 목자라"
      ],
      "raw_text_hashes": [
        "40a0f84c625dc9fa96c604b8ffbe2b40846984f425e618b42c86a60802188df8"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:10:3",
      "sequence": 26484,
