      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 10,
          "verse": 13
        }
      ],
      "en": "The hired hand flees because he is a hired hand and doesn’t care for the sheep.",
      "ko": "달아나는 것은 저가 삯군인 까닭에 양을 돌아보지 아니함이나",
      "source_text_hash": "63e851c653288c7a897081ad67256edc75527e5299e6d7c26357ae432714a084",
      "translation_text_hash": "00a1e2ea66873c6a6c1426f62deed0f3fea53b90c176c515486ba25172256a6e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "달아나는 것은 저가 삯군인 까닭에 양을 돌아보지 아니함이나"
      ],
      "raw_text_hashes": [
        "00a1e2ea66873c6a6c1426f62deed0f3fea53b90c176c515486ba25172256a6e"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:10:14",
      "sequence": 26495,
      "chapter_label": "JHN 10",
      "verse_label": "14",
      "locator": {
