        "verse": 9
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 10,
          "verse": 9
        }
      ],
      "en": "I am the door. If anyone enters in by me, he will be saved, and will go in and go out and will find pasture.",
      "ko": "내가 문이니 누구든지 나로 말미암아 들어가면 구원을 얻고 또는 들어가며 나오며 꼴을 얻으리라",
      "source_text_hash": "f206b86be002474d28b56323240541565e9290d730f3971782c644697511f909",
      "translation_text_hash": "559e0703b601c9b253ec7975c0639305d4f9be5cd5de9573892b13b81aab4a73",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 문이니 누구든지 나로 말미암아 들어가면 구원을 얻고 또는 들어가며 나오며 꼴을 얻으리라"
      ],
      "raw_text_hashes": [
        "559e0703b601c9b253ec7975c0639305d4f9be5cd5de9573892b13b81aab4a73"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:10:10",
      "sequence": 26491,
      "chapter_label": "JHN 10",
      "verse_label": "10",
      "locator": {
        "book": "JHN",
