        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 10,
          "verse": 10
        }
      ],
      "en": "The thief only comes to steal, kill, and destroy. I came that they may have life, and may have it abundantly.",
      "ko": "도적이 오는 것은 도적질하고 죽이고 멸망시키려는 것뿐이요 내가 온 것은 양으로 생명을 얻게 하고 더 풍성히 얻게 하려는 것이라",
      "source_text_hash": "d65e64a30cdb3d5eb4d55e7d4e829f0a36cf1bf014c6bff3f2d6d721d790b95e",
      "translation_text_hash": "be3644a6a164602e203a28d8a7c592ce6870f881ab4b5bafff782f441630dc3e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "도적이 오는 것은 도적질하고 죽이고 멸망시키려는 것뿐이요 내가 온 것은 양으로 생명을 얻게 하고 더 풍성히 얻게 하려는 것이라"
      ],
      "raw_text_hashes": [
        "be3644a6a164602e203a28d8a7c592ce6870f881ab4b5bafff782f441630dc3e"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:10:11",
      "sequence": 26492,
      "chapter_label": "JHN 10",
      "verse_label": "11",
      "locator": {
        "book": "JHN",
