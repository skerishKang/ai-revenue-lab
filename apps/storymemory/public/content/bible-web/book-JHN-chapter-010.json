      "translation_text_hash": "986e0a16d08b8267e6ee45867bc69f65ae18f16bbf26601ebbf1ea7b2eb35f75",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 중에 많은 사람이 말하되 저가 귀신 들려 미쳤거늘 어찌하여 그 말을 듣느냐 하며"
      ],
      "raw_text_hashes": [
