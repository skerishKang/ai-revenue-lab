      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 10,
          "verse": 8
        }
      ],
      "en": "All who came before me are thieves and robbers, but the sheep didn’t listen to them.",
      "ko": "나보다 먼저 온 자는 다 절도요 강도니 양들이 듣지 아니하였느니라",
      "source_text_hash": "048aa578e0c45e475836415d8ec0fba210f0db612f9127dda531db67a3bd348b",
      "translation_text_hash": "c5b838f7c8f70ca612944d55c7b254339fb5c7758dfe492b35272f8b5c9c1dfe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나보다 먼저 온 자는 다 절도요 강도니 양들이 듣지 아니하였느니라"
      ],
      "raw_text_hashes": [
        "c5b838f7c8f70ca612944d55c7b254339fb5c7758dfe492b35272f8b5c9c1dfe"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:10:9",
      "sequence": 26490,
      "chapter_label": "JHN 10",
      "verse_label": "9",
      "locator": {
        "book": "JHN",
