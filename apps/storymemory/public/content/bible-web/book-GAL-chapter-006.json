      ],
      "raw_text_hashes": [
        "b985df5eb9f718ad420442b4f69301c09ebeee0bb97b64cdafd1271928b53727"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:3",
      "sequence": 29188,
      "chapter_label": "GAL 6",
      "verse_label": "3",
      "locator": {
