        "verse": 11
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 11
        }
      ],
      "en": "See with what large letters I write to you with my own hand.",
      "ko": "내 손으로 너희에게 이렇게 큰 글자로 쓴 것을 보라",
      "source_text_hash": "44b55adef46fe556111b69ee6e2b582309499f866da2ac752429fa13c0fae22e",
      "translation_text_hash": "085411ea6e5f768d44f165bfe5b51a981d3a59c5b172c97f8fc453936918c611",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 손으로 너희에게 이렇게 큰 글자로 쓴 것을 보라"
      ],
      "raw_text_hashes": [
        "085411ea6e5f768d44f165bfe5b51a981d3a59c5b172c97f8fc453936918c611"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:12",
      "sequence": 29197,
      "chapter_label": "GAL 6",
      "verse_label": "12",
      "locator": {
        "book": "GAL",
        "chapter": 6,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 12
        }
      ],
      "en": "As many as desire to make a good impression in the flesh compel you to be circumcised, just so they may not be persecuted for the cross of Christ.",
      "ko": "무릇 육체의 모양을 내려 하는 자들이 억지로 너희로 할례 받게 함은 저희가 그리스도의 십자가를 인하여 핍박을 면하려 함 뿐이라",
      "source_text_hash": "5db707f7cf2e3423ac4c6b122a97ebe97cfcfa90b19478ae5565564b055c4630",
      "translation_text_hash": "254823d450d7fd6a3fd2c73ba4c2de1a89e7a575c263667e3ca23eb833e864eb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 육체의 모양을 내려 하는 자들이 억지로 너희로 할례 받게 함은 저희가 그리스도의 십자가를 인하여 핍박을 면하려 함 뿐이라"
      ],
      "raw_text_hashes": [
        "254823d450d7fd6a3fd2c73ba4c2de1a89e7a575c263667e3ca23eb833e864eb"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:13",
      "sequence": 29198,
      "chapter_label": "GAL 6",
      "verse_label": "13",
      "locator": {
        "book": "GAL",
        "chapter": 6,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 13
        }
      ],
      "en": "For even they who receive circumcision don’t keep the law themselves, but they desire to have you circumcised, so that they may boast in your flesh.",
      "ko": "할례 받은 저희라도 스스로 율법은 지키지 아니하고 너희로 할례 받게 하려 하는 것은 너희의 육체로 자랑하려 함이니라",
      "source_text_hash": "15183c461f32fb14c7b92a7d6d01c6f7b8ae5597c87f2ea28307f40208a393a7",
      "translation_text_hash": "8c5eaeec871399c0ea7ada6d1f50785ab15d8129eb099a316444722c6044fe01",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "할례 받은 저희라도 스스로 율법은 지키지 아니하고 너희로 할례 받게 하려 하는 것은 너희의 육체로 자랑하려 함이니라"
      ],
      "raw_text_hashes": [
        "8c5eaeec871399c0ea7ada6d1f50785ab15d8129eb099a316444722c6044fe01"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:14",
      "sequence": 29199,
      "chapter_label": "GAL 6",
      "verse_label": "14",
      "locator": {
        "book": "GAL",
        "chapter": 6,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 14
        }
      ],
      "en": "But far be it from me to boast except in the cross of our Lord Jesus Christ, through which the world has been crucified to me, and I to the world.",
      "ko": "그러나 내게는 우리 주 예수 그리스도의 십자가 외에 결코 자랑할 것이 없으니 그리스도로 말미암아 세상이 나를 대하여 십자가에 못 박히고 내가 또한 세상을 대하여 그러하니라",
      "source_text_hash": "22db6213a27a1b6583d399847afcf3195ec1b2887ffb30a77a9aa4a9c95b0391",
      "translation_text_hash": "4cc3008a7604462db15ecb4dbd89fda86ba85219d5fbaa000221bdcfe004f318",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 내게는 우리 주 예수 그리스도의 십자가 외에 결코 자랑할 것이 없으니 그리스도로 말미암아 세상이 나를 대하여 십자가에 못 박히고 내가 또한 세상을 대하여 그러하니라"
      ],
      "raw_text_hashes": [
