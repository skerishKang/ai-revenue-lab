        "verse": 6
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 6
        }
      ],
      "en": "But let him who is taught in the word share all good things with him who teaches.",
      "ko": "가르침을 받는 자는 말씀을 가르치는 자와 모든 좋은 것을 함께 하라",
      "source_text_hash": "3bc57a23e2778a1dcecac7b1cc5236192ff35f82056db0522bd851d7fefcd384",
      "translation_text_hash": "ca346197750deb9425809f49b26bbbdd699659ed99cd4d925e98e26a4e8c6ac8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가르침을 받는 자는 말씀을 가르치는 자와 모든 좋은 것을 함께 하라"
      ],
      "raw_text_hashes": [
        "ca346197750deb9425809f49b26bbbdd699659ed99cd4d925e98e26a4e8c6ac8"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:7",
      "sequence": 29192,
      "chapter_label": "GAL 6",
      "verse_label": "7",
      "locator": {
        "book": "GAL",
        "chapter": 6,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 7
        }
      ],
      "en": "Don’t be deceived. God is not mocked, for whatever a man sows, that he will also reap.",
      "ko": "스스로 속이지 말라 하나님은 만홀히 여김을 받지 아니하시나니 사람이 무엇으로 심든지 그대로 거두리라",
      "source_text_hash": "98ecccae9e85014ce939ffc2f198504045c9e09f6b869d1f9d77a65482216cae",
      "translation_text_hash": "0b93c73ba9852a13620647151f05c2341d7da4aa2a6a29d67955735ae3745ed6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "스스로 속이지 말라 하나님은 만홀히 여김을 받지 아니하시나니 사람이 무엇으로 심든지 그대로 거두리라"
      ],
      "raw_text_hashes": [
        "0b93c73ba9852a13620647151f05c2341d7da4aa2a6a29d67955735ae3745ed6"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:8",
      "sequence": 29193,
      "chapter_label": "GAL 6",
      "verse_label": "8",
      "locator": {
        "book": "GAL",
        "chapter": 6,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 8
        }
      ],
      "en": "For he who sows to his own flesh will from the flesh reap corruption. But he who sows to the Spirit will from the Spirit reap eternal life.",
      "ko": "자기의 육체를 위하여 심는 자는 육체로부터 썩어진 것을 거두고 성령을 위하여 심는 자는 성령으로부터 영생을 거두리라",
      "source_text_hash": "b8ec6759cc609dd9faa245eb71effc587cd98199fba03100141075b1cf3877d2",
      "translation_text_hash": "268223b12ff62cf9f9ec1ba327ff86b5e8a1de2e07a772c145eb60ebfa033bad",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "자기의 육체를 위하여 심는 자는 육체로부터 썩어진 것을 거두고 성령을 위하여 심는 자는 성령으로부터 영생을 거두리라"
      ],
      "raw_text_hashes": [
        "268223b12ff62cf9f9ec1ba327ff86b5e8a1de2e07a772c145eb60ebfa033bad"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:9",
      "sequence": 29194,
      "chapter_label": "GAL 6",
      "verse_label": "9",
      "locator": {
        "book": "GAL",
        "chapter": 6,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 9
        }
      ],
      "en": "Let’s not be weary in doing good, for we will reap in due season if we don’t give up.",
      "ko": "우리가 선을 행하되 낙심하지 말찌니 피곤하지 아니하면 때가 이르매 거두리라",
      "source_text_hash": "1f6aad7ebb2b9408485c27ecb3b11ab83adf0dc37dba169cea3fe6abfacf9fec",
      "translation_text_hash": "332f0eb9d4703db5106405009958e9fff9a16b5dffebf9c5e2cef06dcecf5c71",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 선을 행하되 낙심하지 말찌니 피곤하지 아니하면 때가 이르매 거두리라"
      ],
      "raw_text_hashes": [
        "332f0eb9d4703db5106405009958e9fff9a16b5dffebf9c5e2cef06dcecf5c71"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:10",
      "sequence": 29195,
      "chapter_label": "GAL 6",
      "verse_label": "10",
      "locator": {
        "book": "GAL",
        "chapter": 6,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 10
        }
      ],
      "en": "So then, as we have opportunity, let’s do what is good toward all men, and especially toward those who are of the household of the faith.",
      "ko": "그러므로 우리는 기회 있는대로 모든 이에게 착한 일을 하되 더욱 믿음의 가정들에게 할찌니라",
      "source_text_hash": "023359336db8b5c63aaed6be756c8a1bf17600fe8fb5d1bb6256b4f0176e3e4d",
      "translation_text_hash": "678809aface7d1e8c5c22bbe1659c0070e162c1b0a4464331b7e6f78ea74f19b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 우리는 기회 있는대로 모든 이에게 착한 일을 하되 더욱 믿음의 가정들에게 할찌니라"
      ],
      "raw_text_hashes": [
        "678809aface7d1e8c5c22bbe1659c0070e162c1b0a4464331b7e6f78ea74f19b"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:6:11",
      "sequence": 29196,
      "chapter_label": "GAL 6",
      "verse_label": "11",
      "locator": {
