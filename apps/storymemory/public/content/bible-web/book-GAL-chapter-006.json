        "verse": 2
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 6,
          "verse": 2
        }
      ],
      "en": "Bear one another’s burdens, and so fulfill the law of Christ.",
      "ko": "너희가 짐을 서로 지라 그리하여 그리스도의 법을 성취하라",
      "source_text_hash": "26108db7bd8ddd9b052f294ee604e3641284dec57bd6c1eb695687e416e7d42d",
      "translation_text_hash": "b985df5eb9f718ad420442b4f69301c09ebeee0bb97b64cdafd1271928b53727",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
