        {
          "book": "GAL",
          "chapter": 6,
          "verse": 5
        }
      ],
      "en": "For each man will bear his own burden.",
      "ko": "각각 자기의 짐을 질 것임이니라",
      "source_text_hash": "4ec9087bef899c92cb0766704a9c13586fa155cae695dabae4f0b33dce6e5675",
      "translation_text_hash": "0cd0d51ab2ed0a4ebe5647113db1aeb89c12b4a150300ffba5b043e86f8d00da",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
