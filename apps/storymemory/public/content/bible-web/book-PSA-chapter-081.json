      "raw_texts": [
        "이르시되 내가 그 어깨에서 짐을 벗기고 그 손에서 광주리를 놓게 하였도다"
      ],
      "raw_text_hashes": [
        "8fc9ac650280f63b9d97a9ec7606ce40613da4694bf8a41ba62a20985550e21a"
      ]
    },
