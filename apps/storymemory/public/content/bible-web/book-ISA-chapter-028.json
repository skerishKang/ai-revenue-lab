      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 28,
          "verse": 3
        }
      ],
      "en": "The crown of pride of the drunkards of Ephraim will be trodden under foot.",
      "ko": "에브라임의 취한 자의 교만한 면류관이 발에 밟힐 것이라",
      "source_text_hash": "88fc47075923aacfb3b04e344ec78a442f76caa9ed8212d53b2c0f16f8f08795",
      "translation_text_hash": "71826dc5ccebebedbd67f5bc473336c4ac4115bf50c11bbc2368fccaf32654c6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에브라임의 취한 자의 교만한 면류관이 발에 밟힐 것이라"
      ],
      "raw_text_hashes": [
        "71826dc5ccebebedbd67f5bc473336c4ac4115bf50c11bbc2368fccaf32654c6"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:28:4",
      "sequence": 18169,
      "chapter_label": "ISA 28",
      "verse_label": "4",
      "locator": {
        "book": "ISA",
        "chapter": 28,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 28,
          "verse": 4
        }
      ],
      "en": "The fading flower of his glorious beauty, which is on the head of the fertile valley, shall be like the first-ripe fig before the summer, which someone picks and eats as soon as he sees it.",
      "ko": "그 기름진 골짜기 꼭대기에 있는 그 영화의 쇠잔해 가는 꽃이 여름 전에 처음 익은 무화과와 같으리니 보는 자가 그것을 보고 얼른 따서 먹으리로다",
      "source_text_hash": "0d983e16b17cb2961e6d00ab5aef4ada7ca87d89c67fe5c03faa928faf8fdefe",
      "translation_text_hash": "07ebc5dce9f49a7b0cc6e2505bc0fc8b98120e447f3e1d77dfc646ce181aab4b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 기름진 골짜기 꼭대기에 있는 그 영화의 쇠잔해 가는 꽃이 여름 전에 처음 익은 무화과와 같으리니 보는 자가 그것을 보고 얼른 따서 먹으리로다"
      ],
      "raw_text_hashes": [
        "07ebc5dce9f49a7b0cc6e2505bc0fc8b98120e447f3e1d77dfc646ce181aab4b"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:28:5",
