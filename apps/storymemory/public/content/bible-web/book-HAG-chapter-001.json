        {
          "book": "HAG",
          "chapter": 1,
          "verse": 4
        }
      ],
      "en": "“Is it a time for you yourselves to dwell in your paneled houses, while this house lies waste?",
      "ko": "이 전이 황무하였거늘 너희가 이 때에 판벽한 집에 거하는 것이 가하냐",
      "source_text_hash": "394a34692df04247f29b2d755eea040adf2dffb02da47217bad5e54fc3c448bd",
      "translation_text_hash": "48375cb924f4c4d8fd8b2722482522c5497d688850d2f84386d099d8eecbb59e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 전이 황무하였거늘 너희가 이 때에 판벽한 집에 거하는 것이 가하냐"
      ],
      "raw_text_hashes": [
        "48375cb924f4c4d8fd8b2722482522c5497d688850d2f84386d099d8eecbb59e"
      ]
    },
    {
      "canonical_locator": "bible:web:HAG:1:5",
      "sequence": 22846,
