      "en": "Then the LORD’s word came by Haggai the prophet, saying,",
      "ko": "여호와의 말씀이 선지자 학개에게 임하여 가라사대",
      "source_text_hash": "5a05efd85e1735f4bd5a4e93dac73b29d0228c6f504591e52eb1830e67991295",
      "translation_text_hash": "6862690bdcd916e59da8f06567cb0bcfd4fc043266b1dfa86b92e96d3d013a2f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 선지자 학개에게 임하여 가라사대"
      ],
      "raw_text_hashes": [
        "6862690bdcd916e59da8f06567cb0bcfd4fc043266b1dfa86b92e96d3d013a2f"
      ]
    },
    {
