        "verse": 10
      },
      "raw_locator": [
        {
          "book": "HAG",
          "chapter": 1,
          "verse": 10
        }
      ],
      "en": "Therefore for your sake the heavens withhold the dew, and the earth withholds its fruit.",
      "ko": "그러므로 너희로 인하여 하늘은 이슬을 그쳤고 땅은 산물을 그쳤으며",
      "source_text_hash": "02a48e4b25f64d297045b8fc75ca3ab1f3296f2dbb4a282bc99ddea45ae38f88",
      "translation_text_hash": "aa39fcef4d71a7aee9e47c054ca195fb16479defc5a5d915027ca901578d6ce3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 너희로 인하여 하늘은 이슬을 그쳤고 땅은 산물을 그쳤으며"
      ],
      "raw_text_hashes": [
        "aa39fcef4d71a7aee9e47c054ca195fb16479defc5a5d915027ca901578d6ce3"
      ]
    },
