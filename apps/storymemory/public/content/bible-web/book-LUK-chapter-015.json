      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그리고 살진 송아지를 끌어다가 잡으라 우리가 먹고 즐기자"
      ],
      "raw_text_hashes": [
        "c330bd467f193dcd53f375c14571585e79de93659463880f5445d186e9f478db"
      ]
