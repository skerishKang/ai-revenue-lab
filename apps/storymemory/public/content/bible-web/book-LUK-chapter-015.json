      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 노하여 들어가기를 즐겨 아니하거늘 아버지가 나와서 권한대"
      ],
      "raw_text_hashes": [
        "f61b9eca10ad384f5df5c21608e4582a076973772bd0b646bc40416814e5c22c"
      ]
    },
    {
      "canonical_locator": "bible:web:LUK:15:29",
      "sequence": 25618,
      "chapter_label": "LUK 15",
      "verse_label": "29",
      "locator": {
        "book": "LUK",
        "chapter": 15,
        "verse": 29
      },
      "raw_locator": [
        {
          "book": "LUK",
          "chapter": 15,
          "verse": 29
        }
      ],
      "en": "But he answered his father, ‘Behold, these many years I have served you, and I never disobeyed a commandment of yours, but you never gave me a goat, that I might celebrate with my friends.",
