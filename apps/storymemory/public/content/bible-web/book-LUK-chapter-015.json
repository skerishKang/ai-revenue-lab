      "raw_texts": [
        "한 종을 불러 이 무슨 일인가 물은대"
      ],
      "raw_text_hashes": [
        "ba1db2e76e05bcdcee96d739b8820ca6e621d15360daed56da30d4a174d9e246"
      ]
