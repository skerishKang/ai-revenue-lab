      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가로되 친구여 어찌하여 예복을 입지 않고 여기 들어왔느냐 하니 저가 유구무언이어늘"
      ],
      "raw_text_hashes": [
        "7ed310c810789931e75d65a7c911538e988bed16b125b6a10cc33f2d762c31ce"
      ]
    },
