      ],
      "en": "Go therefore to the intersections of the highways, and as many as you may find, invite to the wedding feast.’",
      "ko": "사거리 길에 가서 사람을 만나는대로 혼인 잔치에 청하여 오너라 한대",
      "source_text_hash": "7ab1563ad3829936ee4eb789ec9fbd05156826bf624501b8342dbeed432b6c79",
      "translation_text_hash": "11e62c26c904e1ec3ee33323813971370a3e09b7379018c92c8f793c40cdfbf1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사거리 길에 가서 사람을 만나는대로 혼인 잔치에 청하여 오너라 한대"
      ],
      "raw_text_hashes": [
        "11e62c26c904e1ec3ee33323813971370a3e09b7379018c92c8f793c40cdfbf1"
      ]
    },
