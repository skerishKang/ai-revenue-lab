      "raw_locator": [
        {
          "book": "JER",
          "chapter": 33,
          "verse": 19
        }
      ],
      "en": "The LORD’s word came to Jeremiah, saying,",
      "ko": "여호와의 말씀이 예레미야에게 임하니라 가라사대",
      "source_text_hash": "731fe23da327d64a2b966e34555fac18be5a09d52d2e03dad7ddf55769a4c879",
      "translation_text_hash": "38b966489c2387c272222c79e74379d841da48b637820b97fb43ca4afc7454f7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 예레미야에게 임하니라 가라사대"
      ],
      "raw_text_hashes": [
        "38b966489c2387c272222c79e74379d841da48b637820b97fb43ca4afc7454f7"
      ]
    },
