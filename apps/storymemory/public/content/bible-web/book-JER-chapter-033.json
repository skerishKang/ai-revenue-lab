        "verse": 14
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 33,
          "verse": 14
        }
      ],
      "en": "“Behold, the days come,” says the LORD, “that I will perform that good word which I have spoken concerning the house of Israel and concerning the house of Judah.",
      "ko": "나 여호와가 말하노라 보라 내가 이스라엘 집과 유다 집에 대하여 이른 선한 말을 성취할 날이 이르리라",
      "source_text_hash": "4d931e3145ead42dfd279012e6706619fc2291db975aa69a39e530bb299efbcf",
      "translation_text_hash": "70e7ef39418f5dd2a719ef23dc48720ce0a411d5b1eee2b9e4d599e05318e8a5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나 여호와가 말하노라 보라 내가 이스라엘 집과 유다 집에 대하여 이른 선한 말을 성취할 날이 이르리라"
      ],
      "raw_text_hashes": [
        "70e7ef39418f5dd2a719ef23dc48720ce0a411d5b1eee2b9e4d599e05318e8a5"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:33:15",
      "sequence": 19791,
      "chapter_label": "JER 33",
      "verse_label": "15",
      "locator": {
        "book": "JER",
