    {
      "canonical_locator": "bible:web:JER:14:20",
      "sequence": 19314,
      "chapter_label": "JER 14",
      "verse_label": "20",
      "locator": {
        "book": "JER",
        "chapter": 14,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 14,
          "verse": 20
        }
      ],
      "en": "We acknowledge, LORD, our wickedness, and the iniquity of our fathers; for we have sinned against you.",
      "ko": "여호와여 우리가 우리의 악과 우리 조상의 죄악을 인정하나이다 우리가 주께 범죄하였나이다",
      "source_text_hash": "fe1ae49dc80b61e8bc2ccc1d1f9faedff67bb1abb9539ebc51d0e8738c9c3f9b",
      "translation_text_hash": "2b2ace966ea1e67f47bc16f37645b3e5357ca0c4068d7f2e4962b3b58ada2dcd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 우리가 우리의 악과 우리 조상의 죄악을 인정하나이다 우리가 주께 범죄하였나이다"
      ],
      "raw_text_hashes": [
        "2b2ace966ea1e67f47bc16f37645b3e5357ca0c4068d7f2e4962b3b58ada2dcd"
