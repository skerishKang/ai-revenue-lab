    {
      "canonical_locator": "bible:web:JER:14:16",
      "sequence": 19310,
      "chapter_label": "JER 14",
      "verse_label": "16",
      "locator": {
        "book": "JER",
        "chapter": 14,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 14,
          "verse": 16
        }
      ],
      "en": "The people to whom they prophesy will be cast out in the streets of Jerusalem because of the famine and the sword. They will have no one to bury them—them, their wives, their sons, or their daughters, for I will pour their wickedness on them.",
      "ko": "그들의 예언을 받은 백성은 기근과 칼로 인하여 예루살렘 거리에 던짐을 입을 것인즉 그들을 장사할 자가 없을 것이요 그 아내와 그 아들과 그 딸도 그렇게 되리니 이는 내가 그들의 악을 그 위에 부음이니라",
      "source_text_hash": "a5ae022e90fc19061a57157b4deac0b32ac31c563f9422edcc9bfefeb9f58048",
      "translation_text_hash": "ef2223800dbbda45b90f29e96e0fb5d5d2010fcf2709f62c04660bbf7e064a5e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들의 예언을 받은 백성은 기근과 칼로 인하여 예루살렘 거리에 던짐을 입을 것인즉 그들을 장사할 자가 없을 것이요 그 아내와 그 아들과 그 딸도 그렇게 되리니 이는 내가 그들의 악을 그 위에 부음이니라"
      ],
      "raw_text_hashes": [
