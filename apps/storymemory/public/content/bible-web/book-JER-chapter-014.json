        }
      ],
      "en": "Yes, the doe in the field also calves and forsakes her young, because there is no grass.",
      "ko": "들의 암사슴은 새끼를 낳아도 풀이 없으므로 내어버리며",
      "source_text_hash": "d1d4d67b2e5cfe7aae21b62de009e61e43de44d11c0c2b2f6572dd08793bd1eb",
      "translation_text_hash": "98831a0153b844eeb4847956a25f06376a2a35b80fb54006476e92de76a0326c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "들의 암사슴은 새끼를 낳아도 풀이 없으므로 내어버리며"
      ],
      "raw_text_hashes": [
        "98831a0153b844eeb4847956a25f06376a2a35b80fb54006476e92de76a0326c"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:14:6",
      "sequence": 19300,
      "chapter_label": "JER 14",
      "verse_label": "6",
      "locator": {
