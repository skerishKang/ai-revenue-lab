        "verse": 11
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 14,
          "verse": 11
        }
      ],
      "en": "The LORD said to me, “Don’t pray for this people for their good.",
      "ko": "여호와께서 또 내게 이르시되 너는 이 백성을 위하여 복을 구하지 말라",
      "source_text_hash": "a30b5403e395da817ef562625b3a5768eba09fbdf7a72adcecafa721dde2d336",
      "translation_text_hash": "c7a60c457796dc2696e03ec538e5b24f07f9fc507c90021f4abc7081e36076ec",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 또 내게 이르시되 너는 이 백성을 위하여 복을 구하지 말라"
      ],
      "raw_text_hashes": [
        "c7a60c457796dc2696e03ec538e5b24f07f9fc507c90021f4abc7081e36076ec"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:14:12",
      "sequence": 19306,
      "chapter_label": "JER 14",
      "verse_label": "12",
      "locator": {
