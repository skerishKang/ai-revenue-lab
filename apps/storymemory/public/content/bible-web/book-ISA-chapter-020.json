      ],
      "en": "In the year that Tartan came to Ashdod, when Sargon the king of Assyria sent him, and he fought against Ashdod and took it;",
      "ko": "앗수르 왕 사르곤이 군대장관을 아스돗으로 보내매 그가 와서 아스돗을 쳐서 취하던 해",
      "source_text_hash": "fb0315000ca6d9eefb40123dc751fa401da85b8eb377a609ba3bc1ac65f39000",
      "translation_text_hash": "578178714acfb5007234c4a93ea0864aeba8b0122159c326f8aec7b55118703e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "앗수르 왕 사르곤이 군대장관을 아스돗으로 보내매 그가 와서 아스돗을 쳐서 취하던 해"
      ],
      "raw_text_hashes": [
        "578178714acfb5007234c4a93ea0864aeba8b0122159c326f8aec7b55118703e"
      ]
    },
