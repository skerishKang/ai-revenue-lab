        "verse": 2
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 23,
          "verse": 2
        }
      ],
      "en": "“The LORD’s Spirit spoke by me. His word was on my tongue.",
      "ko": "여호와의 신이 나를 빙자하여 말씀하심이여 그 말씀이 내 혀에 있도다",
      "source_text_hash": "f81bd5f688d5c1b43ca4964b76be8c0027121b9258537f3747e6327629dbf262",
      "translation_text_hash": "ec6fef325d5f89893bd733dfef01d1ffbc39f157324d622fd417dcd9e91b89ba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 신이 나를 빙자하여 말씀하심이여 그 말씀이 내 혀에 있도다"
      ],
      "raw_text_hashes": [
        "ec6fef325d5f89893bd733dfef01d1ffbc39f157324d622fd417dcd9e91b89ba"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:23:3",
      "sequence": 8657,
      "chapter_label": "2SA 23",
      "verse_label": "3",
      "locator": {
        "book": "2SA",
        "chapter": 23,
        "verse": 3
