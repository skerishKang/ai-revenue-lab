      "locator": {
        "book": "2SA",
        "chapter": 23,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 23,
          "verse": 9
        }
      ],
      "en": "After him was Eleazar the son of Dodai the son of an Ahohite, one of the three mighty men with David when they defied the Philistines who were there gathered together to battle, and the men of Israel had gone away.",
      "ko": "그 다음은 아호아 사람 도대의 아들 엘르아살이니 다윗과 함께한 세 용사 중에 하나이라 블레셋 사람이 싸우려고 모이매 이스라엘 사람들이 물러간지라 세 용사가 싸움을 돋우고",
      "source_text_hash": "8288c9a8d1bd4e4fe32dda420d88fe3bd91fc1e959252fe222d1702f883993da",
      "translation_text_hash": "fed3542e12be1dc8168b34364fe265fa32e75ac55b389cec19aab196182bdef9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 다음은 아호아 사람 도대의 아들 엘르아살이니 다윗과 함께한 세 용사 중에 하나이라 블레셋 사람이 싸우려고 모이매 이스라엘 사람들이 물러간지라 세 용사가 싸움을 돋우고"
      ],
      "raw_text_hashes": [
