      "en": "for they have devoured Jacob, and destroyed his homeland.",
      "ko": "저희가 야곱을 삼키고 그 거처를 황폐케 함이니이다",
      "source_text_hash": "85c290cfd3241b5b98f6e468a3f69958a01a6062419706b4e3d22bd6a6011ca2",
      "translation_text_hash": "03e19175c60709157e3575681233657b2b4232c0cbaa61be025774cfd0a35bfe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 야곱을 삼키고 그 거처를 황폐케 함이니이다"
      ],
      "raw_text_hashes": [
        "03e19175c60709157e3575681233657b2b4232c0cbaa61be025774cfd0a35bfe"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:79:8",
      "sequence": 15194,
      "chapter_label": "PSA 79",
      "verse_label": "8",
      "locator": {
