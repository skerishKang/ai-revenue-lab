      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바나바는 쓰스라 하고 바울은 그 중에 말하는 자이므로 허메라 하더라"
      ],
      "raw_text_hashes": [
        "90274db0e8eb56ce5ecb41817a8c3a4dca7d6fd58ecd11ed429b4b133cb49c6f"
      ]
