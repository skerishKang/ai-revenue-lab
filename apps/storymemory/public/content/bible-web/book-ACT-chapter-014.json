      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 순종치 아니하는 유대인들이 이방인들의 마음을 선동하여 형제들에게 악감을 품게 하거늘"
      ],
      "raw_text_hashes": [
