    {
      "canonical_locator": "bible:web:DEU:26:17",
      "sequence": 5584,
      "chapter_label": "DEU 26",
      "verse_label": "17",
      "locator": {
        "book": "DEU",
        "chapter": 26,
        "verse": 17
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 26,
          "verse": 17
        }
      ],
      "en": "You have declared today that the LORD is your God, and that you would walk in his ways, keep his statutes, his commandments, and his ordinances, and listen to his voice.",
      "ko": "네가 오늘날 여호와를 네 하나님으로 인정하고 또 그 도를 행하고 그 규례와 명령과 법도를 지키며 그 소리를 들으리라 확언하였고",
      "source_text_hash": "f6d1e254ae1bece5d0adbacc487259fb143748c668f7aa8d820ae77d6b0ff8c8",
      "translation_text_hash": "d77f43b8d4da0404c8eb1de3be3504c8428bef05be756aab29b08650601c337d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 오늘날 여호와를 네 하나님으로 인정하고 또 그 도를 행하고 그 규례와 명령과 법도를 지키며 그 소리를 들으리라 확언하였고"
      ],
      "raw_text_hashes": [
        "d77f43b8d4da0404c8eb1de3be3504c8428bef05be756aab29b08650601c337d"
      ]
