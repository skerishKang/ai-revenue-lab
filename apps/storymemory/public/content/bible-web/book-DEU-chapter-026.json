      "sequence": 5583,
      "chapter_label": "DEU 26",
      "verse_label": "16",
      "locator": {
        "book": "DEU",
        "chapter": 26,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 26,
          "verse": 16
        }
      ],
      "en": "Today the LORD your God commands you to do these statutes and ordinances. You shall therefore keep and do them with all your heart and with all your soul.",
      "ko": "오늘날 네 하나님 여호와께서 이 규례와 법도를 행하라고 네게 명하시나니 그런즉 너는 마음을 다하고 성품을 다하여 지켜 행하라",
      "source_text_hash": "1e066f5b1a47a39fb233bf693234de7a98f7a7d13c409cf76f4681f0b38f7c6d",
      "translation_text_hash": "5dd1f9bb0d0ee8337adf038e6f7891a67eeb3674ab1ae9f9df8330b7a16b6fbd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오늘날 네 하나님 여호와께서 이 규례와 법도를 행하라고 네게 명하시나니 그런즉 너는 마음을 다하고 성품을 다하여 지켜 행하라"
      ],
      "raw_text_hashes": [
