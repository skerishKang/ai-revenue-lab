        "verse": 6
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 32,
          "verse": 6
        }
      ],
      "en": "The messengers returned to Jacob, saying, “We came to your brother Esau. He is coming to meet you, and four hundred men are with him.”",
      "ko": "사자들이 야곱에게 돌아와 가로되 우리가 주인의 형 에서에게 이른즉 그가 사백인을 거느리고 주인을 만나려고 오더이다",
      "source_text_hash": "6e5ce3da7037d4629dd721c7830101f94c38bc623ef8894757eb6c7df790f3e0",
      "translation_text_hash": "2b18db3aea9eaacfd740d112515405821be593eed5ed73a3c48b60519f7ce1ab",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사자들이 야곱에게 돌아와 가로되 우리가 주인의 형 에서에게 이른즉 그가 사백인을 거느리고 주인을 만나려고 오더이다"
      ],
      "raw_text_hashes": [
        "2b18db3aea9eaacfd740d112515405821be593eed5ed73a3c48b60519f7ce1ab"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:32:7",
      "sequence": 936,
