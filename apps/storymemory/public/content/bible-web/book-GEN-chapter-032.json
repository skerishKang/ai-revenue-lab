      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 32,
          "verse": 5
        }
      ],
      "en": "I have cattle, donkeys, flocks, male servants, and female servants. I have sent to tell my lord, that I may find favor in your sight.’”",
      "ko": "내게 소와 나귀와 양떼와 노비가 있사오므로 사람을 보내어 내 주께 고하고 내 주께 은혜 받기를 원하나이다 하더라 하라 하였더니",
      "source_text_hash": "302d4655f692d3bd3fca0a8d6c581cfbabd79a38ea6ba876c8fbf9615b196f66",
      "translation_text_hash": "ae6656f37a4e987da7734608a27e398874348755b88834e9c9181437fc03d7b0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게 소와 나귀와 양떼와 노비가 있사오므로 사람을 보내어 내 주께 고하고 내 주께 은혜 받기를 원하나이다 하더라 하라 하였더니"
      ],
      "raw_text_hashes": [
        "ae6656f37a4e987da7734608a27e398874348755b88834e9c9181437fc03d7b0"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:32:6",
      "sequence": 935,
