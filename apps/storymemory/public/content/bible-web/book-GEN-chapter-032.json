        "verse": 8
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 32,
          "verse": 8
        }
      ],
      "en": "He said, “If Esau comes to the one company, and strikes it, then the company which is left will escape.”",
      "ko": "가로되 에서가 와서 한 떼를 치면 남은 한 떼는 피하리라 하고",
      "source_text_hash": "c7d0d5d31e3c83230c6c691e45a154222dcb2310c2cc692d6591d266a23daf48",
      "translation_text_hash": "aa3f110dd49a874070906b79cb654aa5d0dd3dcbe9eae3f44d0e13252b085c2f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가로되 에서가 와서 한 떼를 치면 남은 한 떼는 피하리라 하고"
      ],
      "raw_text_hashes": [
        "aa3f110dd49a874070906b79cb654aa5d0dd3dcbe9eae3f44d0e13252b085c2f"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:32:9",
      "sequence": 938,
