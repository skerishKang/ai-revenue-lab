      ],
      "en": "The elder to Gaius the beloved, whom I love in truth.",
      "ko": "장로는 사랑하는 가이오 곧 나의 참으로 사랑하는 자에게 편지하노라",
      "source_text_hash": "fb3d371885228ac45396ed68e67306e0ee833db1be04d78fde3ab845685f41af",
      "translation_text_hash": "5ceb2dec131a51971af7ec02aef9248133171f3f5b55c500640bbd7b24d0e252",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "장로는 사랑하는 가이오 곧 나의 참으로 사랑하는 자에게 편지하노라"
      ],
      "raw_text_hashes": [
        "5ceb2dec131a51971af7ec02aef9248133171f3f5b55c500640bbd7b24d0e252"
      ]
    },
    {
      "canonical_locator": "bible:web:3JN:1:2",
      "sequence": 30657,
      "chapter_label": "3JN 1",
      "verse_label": "2",
