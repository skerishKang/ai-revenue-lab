      "raw_locator": [
        {
          "book": "3JN",
          "chapter": 1,
          "verse": 4
        }
      ],
      "en": "I have no greater joy than this: to hear about my children walking in truth.",
      "ko": "내가 내 자녀들이 진리 안에서 행한다 함을 듣는 것보다 더 즐거움이 없도다",
      "source_text_hash": "782909bf615b69030484f402beebaa180de544e1d07e9620a11db9f492796551",
      "translation_text_hash": "f2b10bbe0816c3b765883bb7854f63963f29c62877a6138751e12a1a2d69fcba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 내 자녀들이 진리 안에서 행한다 함을 듣는 것보다 더 즐거움이 없도다"
      ],
      "raw_text_hashes": [
        "f2b10bbe0816c3b765883bb7854f63963f29c62877a6138751e12a1a2d69fcba"
      ]
    },
    {
      "canonical_locator": "bible:web:3JN:1:5",
      "sequence": 30660,
      "chapter_label": "3JN 1",
      "verse_label": "5",
