        "verse": 7
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 10,
          "verse": 7
        }
      ],
      "en": "But when the assembly is to be gathered together, you shall blow, but you shall not sound an alarm.",
      "ko": "또 회중을 모을 때에도 나팔을 불 것이나 소리를 울려 불지 말 것이며",
      "source_text_hash": "07e4034e5110a2f56cf94585658838d7e9dbd183ccaf8ea652b9408e6dc9551a",
      "translation_text_hash": "d1f6eb5b1ca02ab1f2d0ccdeb2f19f15c780b03f672f62143852b265a7f92ad1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 회중을 모을 때에도 나팔을 불 것이나 소리를 울려 불지 말 것이며"
      ],
      "raw_text_hashes": [
        "d1f6eb5b1ca02ab1f2d0ccdeb2f19f15c780b03f672f62143852b265a7f92ad1"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:10:8",
      "sequence": 3997,
      "chapter_label": "NUM 10",
