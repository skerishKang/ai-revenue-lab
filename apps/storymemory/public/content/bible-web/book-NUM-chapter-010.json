        "verse": 5
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 10,
          "verse": 5
        }
      ],
      "en": "When you blow an alarm, the camps that lie on the east side shall go forward.",
      "ko": "너희가 그것을 울려 불 때에는 동편 진들이 진행할 것이고",
      "source_text_hash": "e6d37e4b568933b04591ff3de02923070eae4d2adfc44ecbe4c98a8166c429ec",
      "translation_text_hash": "2cf27419e5d033528db2a779f5000f49c7e9cb9a8d77761584957e336548470a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 그것을 울려 불 때에는 동편 진들이 진행할 것이고"
      ],
      "raw_text_hashes": [
        "2cf27419e5d033528db2a779f5000f49c7e9cb9a8d77761584957e336548470a"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:10:6",
      "sequence": 3995,
      "chapter_label": "NUM 10",
      "verse_label": "6",
      "locator": {
        "book": "NUM",
        "chapter": 10,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 10,
          "verse": 6
        }
      ],
      "en": "When you blow an alarm the second time, the camps that lie on the south side shall go forward. They shall blow an alarm for their journeys.",
      "ko": "제 이차로 울려 불 때에는 남편 진들이 진행할 것이라 무릇 진행하려 할 때에는 나팔소리를 울려 불 것이며",
      "source_text_hash": "b57a51a88e00b99137cf46b4aa41f16cc4fb814ed33713c67fc42dac692bba7d",
      "translation_text_hash": "75c255f805b5b131ce8da1d22fa2918b737ed56da5e75658a6daa104791739f8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제 이차로 울려 불 때에는 남편 진들이 진행할 것이라 무릇 진행하려 할 때에는 나팔소리를 울려 불 것이며"
      ],
      "raw_text_hashes": [
        "75c255f805b5b131ce8da1d22fa2918b737ed56da5e75658a6daa104791739f8"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:10:7",
      "sequence": 3996,
      "chapter_label": "NUM 10",
      "verse_label": "7",
      "locator": {
