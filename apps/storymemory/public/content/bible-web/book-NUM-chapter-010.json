        {
          "book": "NUM",
          "chapter": 10,
          "verse": 11
        }
      ],
      "en": "In the second year, in the second month, on the twentieth day of the month, the cloud was taken up from over the tabernacle of the covenant.",
      "ko": "제 이년 이월 이십일에 구름이 증거막에서 떠오르매",
      "source_text_hash": "9d3bcfd9899b2845ac0bc41fa229b8ade88752a61eb1305b7e814ee1ba3095bb",
      "translation_text_hash": "26ff92c510add7b3b85642bd679624dc69cde44d35202e22195f9d30b3761ffc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제 이년 이월 이십일에 구름이 증거막에서 떠오르매"
      ],
      "raw_text_hashes": [
        "26ff92c510add7b3b85642bd679624dc69cde44d35202e22195f9d30b3761ffc"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:10:12",
      "sequence": 4001,
      "chapter_label": "NUM 10",
      "verse_label": "12",
      "locator": {
        "book": "NUM",
