      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 친구를 위하여 자기 목숨을 버리면 이에서 더 큰 사랑이 없나니"
      ],
      "raw_text_hashes": [
        "45537c94c919a795a42f96180379b252efac32e2427d39357fc673b1e739e65f"
      ]
