        "verse": 17
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 15,
          "verse": 17
        }
      ],
      "en": "“I command these things to you, that you may love one another.",
      "ko": "내가 이것을 너희에게 명함은 너희로 서로 사랑하게 하려함이로라",
      "source_text_hash": "06990ed41a6b4a67914cae70fb1c9c8fbf64a1ad95211456fd55bf2331d3df87",
      "translation_text_hash": "1e514ebfa58a265b51db06560923dc9d0485649610e547d218703807dc404272",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 이것을 너희에게 명함은 너희로 서로 사랑하게 하려함이로라"
      ],
      "raw_text_hashes": [
        "1e514ebfa58a265b51db06560923dc9d0485649610e547d218703807dc404272"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:15:18",
      "sequence": 26717,
      "chapter_label": "JHN 15",
      "verse_label": "18",
      "locator": {
        "book": "JHN",
        "chapter": 15,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 15,
          "verse": 18
        }
      ],
      "en": "If the world hates you, you know that it has hated me before it hated you.",
      "ko": "세상이 너희를 미워하면 너희보다 먼저 나를 미워한 줄을 알라",
      "source_text_hash": "cc34fad909c8fbeee1458588c049556b0c9951ad6469c96f76d2651f2aa0ec4e",
      "translation_text_hash": "d2cd3297d3cba126e73d9b9b714af3c059c588bf71fb1d24d81aec4c26d6c797",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "세상이 너희를 미워하면 너희보다 먼저 나를 미워한 줄을 알라"
      ],
      "raw_text_hashes": [
        "d2cd3297d3cba126e73d9b9b714af3c059c588bf71fb1d24d81aec4c26d6c797"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:15:19",
      "sequence": 26718,
      "chapter_label": "JHN 15",
      "verse_label": "19",
      "locator": {
        "book": "JHN",
        "chapter": 15,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 15,
          "verse": 19
        }
      ],
      "en": "If you were of the world, the world would love its own. But because you are not of the world, since I chose you out of the world, therefore the world hates you.",
      "ko": "너희가 세상에 속하였으면 세상이 자기의 것을 사랑할 터이나 너희는 세상에 속한 자가 아니요 도리어 세상에서 나의 택함을 입은 자인고로 세상이 너희를 미워하느니라",
      "source_text_hash": "66d1fe8f89009c5b69c2211eedf7a4590f92808cf16a4aa502c1e02f96d5ad4b",
      "translation_text_hash": "cdf58613ac74d8c3f9ccce467d0c26969e6673d9f28ebd5a643e32c36ce25842",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 세상에 속하였으면 세상이 자기의 것을 사랑할 터이나 너희는 세상에 속한 자가 아니요 도리어 세상에서 나의 택함을 입은 자인고로 세상이 너희를 미워하느니라"
      ],
      "raw_text_hashes": [
        "cdf58613ac74d8c3f9ccce467d0c26969e6673d9f28ebd5a643e32c36ce25842"
