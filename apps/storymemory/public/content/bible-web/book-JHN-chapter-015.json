        "verse": 27
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 15,
          "verse": 27
        }
      ],
      "en": "You will also testify, because you have been with me from the beginning.",
      "ko": "너희도 처음부터 나와 함께 있었으므로 증거하느니라",
      "source_text_hash": "37cc4207b043dfa07fe330683f34538fae138947165d44beb2c3cc805170050f",
      "translation_text_hash": "3c80f0282084e31969e8751930ed7db3b2307ff4e9ff1ec6851e83fbba541bc7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희도 처음부터 나와 함께 있었으므로 증거하느니라"
      ],
      "raw_text_hashes": [
        "3c80f0282084e31969e8751930ed7db3b2307ff4e9ff1ec6851e83fbba541bc7"
