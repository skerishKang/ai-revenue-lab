        "verse": 26
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 15,
          "verse": 26
        }
      ],
      "en": "“When the Counselorhas come, whom I will send to you from the Father, the Spirit of truth, who proceeds from the Father, he will testify about me.",
      "ko": "내가 아버지께로서 너희에게 보낼 보혜사 곧 아버지께로서 나오시는 진리의 성령이 오실 때에 그가 나를 증거하실 것이요",
      "source_text_hash": "40566713ba01b80551c30a136abdf304c2620cc80f6e9e9233ccee07ef46fdf1",
      "translation_text_hash": "824055b5090d08e9949e38887e058f0988a82e546ce7e1ff490c2974ac50062a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 아버지께로서 너희에게 보낼 보혜사 곧 아버지께로서 나오시는 진리의 성령이 오실 때에 그가 나를 증거하실 것이요"
      ],
      "raw_text_hashes": [
        "824055b5090d08e9949e38887e058f0988a82e546ce7e1ff490c2974ac50062a"
      ]
    },
