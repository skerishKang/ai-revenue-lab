      ],
      "en": "“I am the true vine, and my Father is the farmer.",
      "ko": "내가 참 포도나무요 내 아버지는 그 농부라",
      "source_text_hash": "955babd1cec84e6b4ca6fd565759843ed72e4cfd1c01eb3e000bbc05f48c4d4f",
      "translation_text_hash": "991fcbec1f9f2fd8596117b20c6d3df3f06456de02871fbfc01cc0fad84262fa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 참 포도나무요 내 아버지는 그 농부라"
      ],
      "raw_text_hashes": [
        "991fcbec1f9f2fd8596117b20c6d3df3f06456de02871fbfc01cc0fad84262fa"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:15:2",
      "sequence": 26701,
      "chapter_label": "JHN 15",
