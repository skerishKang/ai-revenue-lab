      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 5,
          "verse": 4
        }
      ],
      "en": "All the elders of Israel came. The Levites took up the ark.",
      "ko": "이스라엘 장로들이 다 이르매 레위 사람이 궤를 메니라",
      "source_text_hash": "7beac72a97ddc98172e16fef8fa8e28e6295ba39499c84fb3f547074136946a5",
      "translation_text_hash": "86a6bd2216bdd1c3525a989d6ecf7e2770044374f9ee7e5fc808783e70e9b133",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 장로들이 다 이르매 레위 사람이 궤를 메니라"
      ],
      "raw_text_hashes": [
        "86a6bd2216bdd1c3525a989d6ecf7e2770044374f9ee7e5fc808783e70e9b133"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:5:5",
      "sequence": 11274,
      "chapter_label": "2CH 5",
