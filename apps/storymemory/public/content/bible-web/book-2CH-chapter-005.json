      ],
      "en": "So all the men of Israel assembled themselves to the king at the feast, which was in the seventh month.",
      "ko": "칠월 절기에 이스라엘 모든 사람이 다 왕에게로 모이고",
      "source_text_hash": "452dec1784095cae535bc96b4e6f266f19dd99e42b8fb0d3e16f2b4d5b45ee7d",
      "translation_text_hash": "97c42806da436c58bd148aa144b9704b2de2e88ac54f847e64e663ee2bb12061",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "칠월 절기에 이스라엘 모든 사람이 다 왕에게로 모이고"
      ],
      "raw_text_hashes": [
        "97c42806da436c58bd148aa144b9704b2de2e88ac54f847e64e663ee2bb12061"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:5:4",
      "sequence": 11273,
      "chapter_label": "2CH 5",
