      "translation_text_hash": "df623134b4b9fff237f54bfadbbf45dc6c43d109304889f7446639f0db008f0f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
