        "verse": 7
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 7
        }
      ],
      "en": "“You shall make curtains of goats’ hair for a covering over the tabernacle. You shall make eleven curtains.",
      "ko": "그 성막을 덮는 막 곧 앙장을 염소털로 만들되 열 한폭을 만들찌며",
      "source_text_hash": "c7cb6894e34bdb0a98af14d0940a59ad4052d3d784b077f5480545377412cbbe",
      "translation_text_hash": "684587865106153304119f4e4ba78d8f17b5440afa8ed710c04115754e2b8a9f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 성막을 덮는 막 곧 앙장을 염소털로 만들되 열 한폭을 만들찌며"
      ],
      "raw_text_hashes": [
        "684587865106153304119f4e4ba78d8f17b5440afa8ed710c04115754e2b8a9f"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:8",
      "sequence": 2244,
      "chapter_label": "EXO 26",
      "verse_label": "8",
