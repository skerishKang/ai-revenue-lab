      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 11
        }
      ],
      "en": "You shall make fifty clasps of bronze, and put the clasps into the loops, and couple the tent together, that it may be one.",
      "ko": "놋 갈고리 오십을 만들고 그 갈고리로 그 고를 꿰어 연합하여 한 막이 되게 하고",
      "source_text_hash": "cb7aed0cfe4699e914fb834fcdd2a824de7ecc89d151266c46f67b6832445537",
      "translation_text_hash": "646f341478c3e8fbd96ad8ee2b9ccea0a10f617bd015048dd46dd34980501f49",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "놋 갈고리 오십을 만들고 그 갈고리로 그 고를 꿰어 연합하여 한 막이 되게 하고"
      ],
      "raw_text_hashes": [
        "646f341478c3e8fbd96ad8ee2b9ccea0a10f617bd015048dd46dd34980501f49"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:12",
      "sequence": 2248,
      "chapter_label": "EXO 26",
      "verse_label": "12",
      "locator": {
