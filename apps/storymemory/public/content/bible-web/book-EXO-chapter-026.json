        "verse": 3
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 3
        }
      ],
      "en": "Five curtains shall be coupled together to one another, and the other five curtains shall be coupled to one another.",
      "ko": "그 앙장 다섯 폭을 서로 연하며 다른 다섯 폭도 서로 연하고",
      "source_text_hash": "dbe1542a6adf02b7ddbf8f8a1cec8f17fe30b067cf592b39db6609c37a4d6887",
      "translation_text_hash": "73dbb3449dc67dd1f31631fa4f2ed030272f58edb6745cdf7f382d75cbc3121a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 앙장 다섯 폭을 서로 연하며 다른 다섯 폭도 서로 연하고"
      ],
      "raw_text_hashes": [
        "73dbb3449dc67dd1f31631fa4f2ed030272f58edb6745cdf7f382d75cbc3121a"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:4",
      "sequence": 2240,
      "chapter_label": "EXO 26",
      "verse_label": "4",
      "locator": {
        "book": "EXO",
        "chapter": 26,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 4
        }
      ],
      "en": "You shall make loops of blue on the edge of the one curtain from the edge in the coupling, and you shall do likewise on the edge of the curtain that is outermost in the second coupling.",
      "ko": "그 앙장의 연락할 말폭 가에 청색 고를 만들며 다른 연락할 말폭 가에도 그와 같이 하고",
      "source_text_hash": "6414b607b6f168f9d3f7459ecd2939b78cbb41e616d96e9d375cf56ec2f92a21",
      "translation_text_hash": "71bec8795ca2f2a34c59d379af76bcda0e8014d617e9a2f4abff7f8214754052",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 앙장의 연락할 말폭 가에 청색 고를 만들며 다른 연락할 말폭 가에도 그와 같이 하고"
      ],
      "raw_text_hashes": [
        "71bec8795ca2f2a34c59d379af76bcda0e8014d617e9a2f4abff7f8214754052"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:5",
      "sequence": 2241,
      "chapter_label": "EXO 26",
      "verse_label": "5",
      "locator": {
        "book": "EXO",
        "chapter": 26,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 5
        }
      ],
      "en": "You shall make fifty loops in the one curtain, and you shall make fifty loops in the edge of the curtain that is in the second coupling. The loops shall be opposite one another.",
      "ko": "앙장 말폭 가에 고 오십을 달며 다른 앙장 말폭 가에도 고 오십을 달고 그 고들을 서로 대하게 하고",
      "source_text_hash": "371267c6e6a25e0cd6c65e0466d038d2374148a9ddc8da8150227cae6964bc5a",
      "translation_text_hash": "e0179659a13878b03f6a1a16949bfb375ac37c7c9ccdb2ea3e63f95e8be50a90",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "앙장 말폭 가에 고 오십을 달며 다른 앙장 말폭 가에도 고 오십을 달고 그 고들을 서로 대하게 하고"
      ],
      "raw_text_hashes": [
        "e0179659a13878b03f6a1a16949bfb375ac37c7c9ccdb2ea3e63f95e8be50a90"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:6",
      "sequence": 2242,
      "chapter_label": "EXO 26",
      "verse_label": "6",
      "locator": {
        "book": "EXO",
        "chapter": 26,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 6
        }
      ],
      "en": "You shall make fifty clasps of gold, and couple the curtains to one another with the clasps. The tabernacle shall be a unit.",
      "ko": "금 갈고리 오십을 만들고 그 갈고리로 앙장을 연합하여 한 성막을 이룰찌며",
      "source_text_hash": "665ecb064e3f325b05b61cb21f74841c45de62200fa141fd3fa576092e6aa487",
      "translation_text_hash": "cd670bd748757258945379ed470911eb4e22e81b19c64255edbbca5337d77fed",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "금 갈고리 오십을 만들고 그 갈고리로 앙장을 연합하여 한 성막을 이룰찌며"
      ],
      "raw_text_hashes": [
        "cd670bd748757258945379ed470911eb4e22e81b19c64255edbbca5337d77fed"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:7",
      "sequence": 2243,
      "chapter_label": "EXO 26",
      "verse_label": "7",
      "locator": {
