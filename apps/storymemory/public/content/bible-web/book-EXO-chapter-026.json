      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 8
        }
      ],
      "en": "The length of each curtain shall be thirty cubits, and the width of each curtain four cubits: the eleven curtains shall have one measure.",
      "ko": "각 폭의 장은 삼십 규빗, 광은 사 규빗으로 열 한폭의 장단을 같게 하고",
      "source_text_hash": "c31448b131c740e3599e0e25095d94980a8a9ae9de1eee8f151f2f97f136dc45",
      "translation_text_hash": "9ea26bdd81bc11e55f05294047df13406166dba7e5b502ffde629cacb8b1b3c6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "각 폭의 장은 삼십 규빗, 광은 사 규빗으로 열 한폭의 장단을 같게 하고"
      ],
      "raw_text_hashes": [
        "9ea26bdd81bc11e55f05294047df13406166dba7e5b502ffde629cacb8b1b3c6"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:9",
      "sequence": 2245,
      "chapter_label": "EXO 26",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
        "chapter": 26,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 9
        }
      ],
      "en": "You shall couple five curtains by themselves, and six curtains by themselves, and shall double over the sixth curtain in the forefront of the tent.",
      "ko": "그 앙장 다섯 폭을 서로 연하며 또 여섯 폭을 서로 연하고 그 여섯째 폭 절반은 성막 전면에 접어 드리우고",
      "source_text_hash": "ac7d4a39d89d05955bd74db98d2729d3447427cbfa6c0b983df0c23ce86ae1bc",
      "translation_text_hash": "772f60daf47251ffd246e72c2cf579a6f8852c5ba305b5ef948eb8cf92555488",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 앙장 다섯 폭을 서로 연하며 또 여섯 폭을 서로 연하고 그 여섯째 폭 절반은 성막 전면에 접어 드리우고"
      ],
      "raw_text_hashes": [
        "772f60daf47251ffd246e72c2cf579a6f8852c5ba305b5ef948eb8cf92555488"
      ]
    },
    {
