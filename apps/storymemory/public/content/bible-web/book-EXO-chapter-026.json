        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 26,
          "verse": 12
        }
      ],
      "en": "The overhanging part that remains of the curtains of the tent—the half curtain that remains—shall hang over the back of the tabernacle.",
      "ko": "그 막 곧 앙장의 나머지 그 반 폭은 성막 뒤에 드리우고",
      "source_text_hash": "8f765326f0a4f4cf7db4c20874080612f8263d8df3a9937ca64707c9d69d327b",
      "translation_text_hash": "9a6fa753f49f767b1fa74606f1cd538be98682c454822ee0e972ab254786a43e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 막 곧 앙장의 나머지 그 반 폭은 성막 뒤에 드리우고"
      ],
      "raw_text_hashes": [
        "9a6fa753f49f767b1fa74606f1cd538be98682c454822ee0e972ab254786a43e"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:26:13",
      "sequence": 2249,
      "chapter_label": "EXO 26",
      "verse_label": "13",
      "locator": {
        "book": "EXO",
