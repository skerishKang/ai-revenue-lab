      "chapter_label": "PSA 22",
      "verse_label": "30",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 30
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 30
        }
      ],
