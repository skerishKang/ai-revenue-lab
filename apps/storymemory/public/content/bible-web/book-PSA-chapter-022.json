      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 19
        }
      ],
      "en": "But don’t be far off, LORD. You are my help. Hurry to help me!",
      "ko": "여호와여 멀리하지 마옵소서 나의 힘이시여 속히 나를 도우소서",
      "source_text_hash": "724615856bbbc78d33698a8f064efbffffc3e52c1a16f00f9ddd91d70686502a",
      "translation_text_hash": "c15f230a461a83b873232dfe674fccb1c71f0d0cb7fb8ba0568cb7b8864cbf8c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 멀리하지 마옵소서 나의 힘이시여 속히 나를 도우소서"
      ],
      "raw_text_hashes": [
        "c15f230a461a83b873232dfe674fccb1c71f0d0cb7fb8ba0568cb7b8864cbf8c"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:20",
      "sequence": 14225,
      "chapter_label": "PSA 22",
      "verse_label": "20",
