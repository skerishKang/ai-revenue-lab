      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 20
        }
      ],
      "en": "Deliver my soul from the sword, my precious life from the power of the dog.",
      "ko": "내 영혼을 칼에서 건지시며 내 유일한 것을 개의 세력에서 구하소서",
      "source_text_hash": "1e70e6c09edeaef8a00b932b4e0c5e3a77e3af08e2aa47b7a1e77986b16a26de",
      "translation_text_hash": "6908188888ba63b8d18908811dca6ddd4fef11f6c3c22d1b61683aeb71aa0cdb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 영혼을 칼에서 건지시며 내 유일한 것을 개의 세력에서 구하소서"
      ],
      "raw_text_hashes": [
        "6908188888ba63b8d18908811dca6ddd4fef11f6c3c22d1b61683aeb71aa0cdb"
      ]
