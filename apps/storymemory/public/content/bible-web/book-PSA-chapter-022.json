        "verse": 25
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 25
        }
      ],
      "en": "My praise of you comes in the great assembly. I will pay my vows before those who fear him.",
      "ko": "대회 중에 나의 찬송은 주께로서 온 것이니 주를 경외하는 자 앞에서 나의 서원을 갚으리이다",
      "source_text_hash": "b2ade39f71bfcc8977f0f967113094746bc5c6fcc296144bd04ef9f85e12c91a",
      "translation_text_hash": "b6a5df8d23b32142b07e566aaabe9b135787b03e3dff908ebc402d7c89749633",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대회 중에 나의 찬송은 주께로서 온 것이니 주를 경외하는 자 앞에서 나의 서원을 갚으리이다"
      ],
      "raw_text_hashes": [
        "b6a5df8d23b32142b07e566aaabe9b135787b03e3dff908ebc402d7c89749633"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:26",
      "sequence": 14231,
      "chapter_label": "PSA 22",
      "verse_label": "26",
      "locator": {
        "book": "PSA",
