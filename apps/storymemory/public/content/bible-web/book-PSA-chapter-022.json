        "verse": 3
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 3
        }
      ],
      "en": "But you are holy, you who inhabit the praises of Israel.",
      "ko": "이스라엘의 찬송 중에 거하시는 주여 주는 거룩하시니이다",
      "source_text_hash": "f2f832061dbe2aa174bf47a4f3313e935e1d2f08b7f60c550bc84e1657f87e91",
      "translation_text_hash": "ac576315f27760e48eb0dc5fa89cce6ddfdeaa6cb01316e666c1db861eefa390",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘의 찬송 중에 거하시는 주여 주는 거룩하시니이다"
      ],
      "raw_text_hashes": [
        "ac576315f27760e48eb0dc5fa89cce6ddfdeaa6cb01316e666c1db861eefa390"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:4",
      "sequence": 14209,
      "chapter_label": "PSA 22",
      "verse_label": "4",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 4
        }
      ],
      "en": "Our fathers trusted in you. They trusted, and you delivered them.",
      "ko": "우리 열조가 주께 의뢰하였고 의뢰하였으므로 저희를 건지셨나이다",
      "source_text_hash": "ff7279f2dab09ffed3eac4b959530ecfaa2bc835396140ddee9fd1e3b3b045e3",
      "translation_text_hash": "97882a28722c3027fc43909e0db4133f57394788ab7517577f1cc2270b151a3e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 열조가 주께 의뢰하였고 의뢰하였으므로 저희를 건지셨나이다"
      ],
      "raw_text_hashes": [
        "97882a28722c3027fc43909e0db4133f57394788ab7517577f1cc2270b151a3e"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:5",
      "sequence": 14210,
      "chapter_label": "PSA 22",
      "verse_label": "5",
      "locator": {
