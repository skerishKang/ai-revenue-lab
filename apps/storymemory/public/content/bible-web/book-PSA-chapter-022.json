        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 5
        }
      ],
      "en": "They cried to you, and were delivered. They trusted in you, and were not disappointed.",
      "ko": "저희가 주께 부르짖어 구원을 얻고 주께 의뢰하여 수치를 당치 아니하였나이다",
      "source_text_hash": "4674039a0e5d08eb9909cf3d3c6809404053ffe6513ef61fa98d5bc826a88973",
      "translation_text_hash": "007dd4a088491f9d13f95c6b38516dcbadc838a0810dbda7a776d263535afec7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 주께 부르짖어 구원을 얻고 주께 의뢰하여 수치를 당치 아니하였나이다"
      ],
      "raw_text_hashes": [
        "007dd4a088491f9d13f95c6b38516dcbadc838a0810dbda7a776d263535afec7"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:6",
      "sequence": 14211,
      "chapter_label": "PSA 22",
      "verse_label": "6",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 6
        }
      ],
      "en": "But I am a worm, and no man; a reproach of men, and despised by the people.",
      "ko": "나는 벌레요 사람이 아니라 사람의 훼방거리요 백성의 조롱거리니이다",
      "source_text_hash": "743ec85c0e9303ddf26dd4978dbcb84fb69f7926b4aea0b048d5ceb4a7ccd5ed",
      "translation_text_hash": "efcf66dba7cbb6837d1c1974ace7b6a62d9da573e4872df81adf3954e360de6a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 벌레요 사람이 아니라 사람의 훼방거리요 백성의 조롱거리니이다"
      ],
      "raw_text_hashes": [
        "efcf66dba7cbb6837d1c1974ace7b6a62d9da573e4872df81adf3954e360de6a"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:7",
      "sequence": 14212,
      "chapter_label": "PSA 22",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 7
        }
      ],
      "en": "All those who see me mock me. They insult me with their lips. They shake their heads, saying,",
      "ko": "나를 보는 자는 다 비웃으며 입술을 비쭉이고 머리를 흔들며 말하되",
      "source_text_hash": "3c329aec16ab35b0cb222bea440755bc994c4dd99f18b1eb42060338493dd179",
      "translation_text_hash": "fc5934126469c12ce5e8c0f66f89aa25008413f808131be8961958c6b0503dd9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 보는 자는 다 비웃으며 입술을 비쭉이고 머리를 흔들며 말하되"
      ],
      "raw_text_hashes": [
        "fc5934126469c12ce5e8c0f66f89aa25008413f808131be8961958c6b0503dd9"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:8",
      "sequence": 14213,
      "chapter_label": "PSA 22",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 8
        }
      ],
      "en": "“He trusts in the LORD. Let him deliver him. Let him rescue him, since he delights in him.”",
      "ko": "저가 여호와께 의탁하니 구원하실걸, 저를 기뻐하시니 건지실걸 하나이다",
      "source_text_hash": "58cd72e127430ea5ebf8127d36931a9c63326701e57dca37c83ce2253491dce2",
      "translation_text_hash": "8af29c00e86c17492c8a4a5161a4b364ccb3c4c7aee511b30beeb6afda5e8ba3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 여호와께 의탁하니 구원하실걸, 저를 기뻐하시니 건지실걸 하나이다"
      ],
      "raw_text_hashes": [
        "8af29c00e86c17492c8a4a5161a4b364ccb3c4c7aee511b30beeb6afda5e8ba3"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:9",
      "sequence": 14214,
      "chapter_label": "PSA 22",
      "verse_label": "9",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 9
        }
      ],
      "en": "But you brought me out of the womb. You made me trust while at my mother’s breasts.",
      "ko": "오직 주께서 나를 모태에서 나오게 하시고 내 모친의 젖을 먹을 때에 의지하게 하셨나이다",
      "source_text_hash": "51aff6e19925172a4034db8324b31bd86d05257b960168c61dc8a11f244b928d",
      "translation_text_hash": "50f7e13f2b5b479b9edb5463300428d0d23894aef39ed050ffbc0886977f1291",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 주께서 나를 모태에서 나오게 하시고 내 모친의 젖을 먹을 때에 의지하게 하셨나이다"
      ],
      "raw_text_hashes": [
        "50f7e13f2b5b479b9edb5463300428d0d23894aef39ed050ffbc0886977f1291"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:10",
      "sequence": 14215,
      "chapter_label": "PSA 22",
      "verse_label": "10",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 10
        }
      ],
      "en": "I was thrown on you from my mother’s womb. You are my God since my mother bore me.",
      "ko": "내가 날 때부터 주께 맡긴바 되었고 모태에서 나올 때부터 주는 내 하나님이 되셨사오니",
      "source_text_hash": "77f13e8a72b33897ec00e86b8ecb8522190517d816095b93cc8ef6f06f3d5a02",
      "translation_text_hash": "7e42ad462c38d7e620723912518ab7d0f072740d2c858874fede91fbc24be8a7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 날 때부터 주께 맡긴바 되었고 모태에서 나올 때부터 주는 내 하나님이 되셨사오니"
      ],
      "raw_text_hashes": [
        "7e42ad462c38d7e620723912518ab7d0f072740d2c858874fede91fbc24be8a7"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:11",
      "sequence": 14216,
      "chapter_label": "PSA 22",
      "verse_label": "11",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 11
        }
      ],
      "en": "Don’t be far from me, for trouble is near. For there is no one to help.",
      "ko": "나를 멀리하지 마옵소서 환난이 가깝고 도울 자 없나이다",
      "source_text_hash": "d6735f904df14125e2730f844cec9e70ddbb56227bf2ed35e3c65750d9ec4356",
      "translation_text_hash": "fd84e33edd70ffd26bd9d5f7494ffebcb57720074958abcdb1167e1d192cebd5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 멀리하지 마옵소서 환난이 가깝고 도울 자 없나이다"
      ],
      "raw_text_hashes": [
        "fd84e33edd70ffd26bd9d5f7494ffebcb57720074958abcdb1167e1d192cebd5"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:12",
      "sequence": 14217,
      "chapter_label": "PSA 22",
      "verse_label": "12",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 12
        }
      ],
      "en": "Many bulls have surrounded me. Strong bulls of Bashan have encircled me.",
      "ko": "많은 황소가 나를 에워싸며 바산의 힘센 소들이 나를 둘렀으며",
      "source_text_hash": "c9027e33e1030f116b18d321711c2ea8efb4f5092a0426ebf34e155f22251758",
      "translation_text_hash": "a5e717663a59718202516d21972145db63552e616f4cb37501b4e4599e3867cf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "많은 황소가 나를 에워싸며 바산의 힘센 소들이 나를 둘렀으며"
      ],
      "raw_text_hashes": [
        "a5e717663a59718202516d21972145db63552e616f4cb37501b4e4599e3867cf"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:13",
      "sequence": 14218,
      "chapter_label": "PSA 22",
      "verse_label": "13",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 13
        }
      ],
      "en": "They open their mouths wide against me, lions tearing prey and roaring.",
      "ko": "내게 그 입을 벌림이 찢고 부르짖는 사자 같으니이다",
      "source_text_hash": "d2fabdda5c28b8ef4ffb89ee05aa34f55aa6842747181ea28401dd5080c6ecd4",
      "translation_text_hash": "23bf5486d15f4f6c77eba1bd8a15d9598cc235216c724aaf343c8ef973e1c801",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게 그 입을 벌림이 찢고 부르짖는 사자 같으니이다"
      ],
      "raw_text_hashes": [
        "23bf5486d15f4f6c77eba1bd8a15d9598cc235216c724aaf343c8ef973e1c801"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:14",
      "sequence": 14219,
      "chapter_label": "PSA 22",
      "verse_label": "14",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 14
        }
      ],
      "en": "I am poured out like water. All my bones are out of joint. My heart is like wax. It is melted within me.",
      "ko": "나는 물같이 쏟아졌으며 내 모든 뼈는 어그러졌으며 내 마음은 촛밀 같아서 내 속에서 녹았으며",
      "source_text_hash": "95d91ee65793665e89b43dea6a01fd632d9527ff6bc7d62572ad6bc8115886c4",
      "translation_text_hash": "658616a6cf9c5ab4d1acdc8b06963d84d38767f9c19321e0bac7a8ed8588f9dd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 물같이 쏟아졌으며 내 모든 뼈는 어그러졌으며 내 마음은 촛밀 같아서 내 속에서 녹았으며"
      ],
      "raw_text_hashes": [
        "658616a6cf9c5ab4d1acdc8b06963d84d38767f9c19321e0bac7a8ed8588f9dd"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:22:15",
      "sequence": 14220,
      "chapter_label": "PSA 22",
      "verse_label": "15",
      "locator": {
        "book": "PSA",
        "chapter": 22,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 15
        }
      ],
      "en": "My strength is dried up like a potsherd. My tongue sticks to the roof of my mouth. You have brought me into the dust of death.",
      "ko": "내 힘이 말라 질그릇 조각 같고 내 혀가 잇틀에 붙었나이다 주께서 또 나를 사망의 진토에 두셨나이다",
      "source_text_hash": "1839e656d8ea534d79a6ac9d34fb5651835afe478f43afe156e1663e930c1990",
      "translation_text_hash": "0d649f5fa655a12bce71a361a8719d9c77b1106cc9b362f96ee4b5200f68117e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 힘이 말라 질그릇 조각 같고 내 혀가 잇틀에 붙었나이다 주께서 또 나를 사망의 진토에 두셨나이다"
      ],
      "raw_text_hashes": [
        "0d649f5fa655a12bce71a361a8719d9c77b1106cc9b362f96ee4b5200f68117e"
      ]
    },
