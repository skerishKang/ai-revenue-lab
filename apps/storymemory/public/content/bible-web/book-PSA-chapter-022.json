      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 22,
          "verse": 16
        }
      ],
      "en": "For dogs have surrounded me. A company of evildoers have enclosed me. They have pierced my hands and feet.",
      "ko": "개들이 나를 에워쌌으며 악한 무리가 나를 둘러 내 수족을 찔렀나이다",
      "source_text_hash": "09fb0a6263555f84daea71dbcc8fbba724ac421a730432168b79ffda201c10a0",
      "translation_text_hash": "847908c622ec81b8e4da6ae55532f71a2b84639502b191d7f6c8f91a3e4ddb5d",
      "translation_policy": "krv-1961-source-mapped",
