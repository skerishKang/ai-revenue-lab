      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 22,
          "verse": 12
        }
      ],
      "en": "“One Ananias, a devout man according to the law, well reported of by all the Jews who lived in Damascus,",
      "ko": "율법에 의하면 경건한 사람으로 거기 사는 모든 유대인들에게 칭찬을 듣는 아나니아라 하는 이가",
      "source_text_hash": "143a98f54982460a31b7b2a0d93ab3504de49cf21d78cb8ba5bc7c8fec8705d8",
      "translation_text_hash": "7a32e9ab2a4e095740dfb3715a8513abafc9d2694adaa1eeef44b39498f96b3d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "율법에 의하면 경건한 사람으로 거기 사는 모든 유대인들에게 칭찬을 듣는 아나니아라 하는 이가"
      ],
      "raw_text_hashes": [
        "7a32e9ab2a4e095740dfb3715a8513abafc9d2694adaa1eeef44b39498f96b3d"
      ]
