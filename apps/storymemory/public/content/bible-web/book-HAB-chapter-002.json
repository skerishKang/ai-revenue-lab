      },
      "raw_locator": [
        {
          "book": "HAB",
          "chapter": 2,
          "verse": 12
        }
      ],
      "en": "Woe to him who builds a town with blood, and establishes a city by iniquity!",
      "ko": "피로 읍을 건설하며 불의로 성을 건축하는 자에게 화 있을찐저",
      "source_text_hash": "80d1c25f4af83884790235d96fd4941f6ad6795aac6ed42f232194401791e163",
      "translation_text_hash": "b9ea2a4aee5e96d44a968c744f3464ea110904b1040d3f5ccfdfac6eee82c0f9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
