      "translation_text_hash": "13912bf641b38291d22f22d119e487b6ebadb0588f01a8c7995bf70da73d965d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
