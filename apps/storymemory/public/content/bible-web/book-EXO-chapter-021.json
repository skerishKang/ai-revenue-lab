      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 21,
          "verse": 9
        }
      ],
      "en": "If he marries her to his son, he shall deal with her as a daughter.",
      "ko": "만일 그를 자기 아들에게 주기로 하였으면 그를 딸 같이 대접할 것이요",
      "source_text_hash": "4e176a59cb08ba3b4e692bcd20d5fc9d11145701f78f6104e810909801001960",
      "translation_text_hash": "b79087f3a60f7470d71abd4c7e297c2bf5c6cb6d1d3a669dbedf4b5f51123580",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 그를 자기 아들에게 주기로 하였으면 그를 딸 같이 대접할 것이요"
      ],
      "raw_text_hashes": [
        "b79087f3a60f7470d71abd4c7e297c2bf5c6cb6d1d3a669dbedf4b5f51123580"
      ]
