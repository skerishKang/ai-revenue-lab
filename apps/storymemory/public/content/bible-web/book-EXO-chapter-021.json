      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 21,
          "verse": 7
        }
      ],
      "en": "“If a man sells his daughter to be a female servant, she shall not go out as the male servants do.",
      "ko": "사람이 그 딸을 여종으로 팔았으면 그는 남종 같이 나오지 못할찌며",
      "source_text_hash": "4be6919bad5e8ac683885dba6182841cbc2d362a9b8b8ae62712b5050c6ab184",
      "translation_text_hash": "a832c78fe0a317562b291e7e9e668247ed8c9e6b46fc1c17f7764fe31ec9f39d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 그 딸을 여종으로 팔았으면 그는 남종 같이 나오지 못할찌며"
      ],
      "raw_text_hashes": [
        "a832c78fe0a317562b291e7e9e668247ed8c9e6b46fc1c17f7764fe31ec9f39d"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:21:8",
      "sequence": 2086,
      "chapter_label": "EXO 21",
      "verse_label": "8",
