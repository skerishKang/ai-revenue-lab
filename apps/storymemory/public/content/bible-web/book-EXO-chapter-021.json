        "verse": 3
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 21,
          "verse": 3
        }
      ],
      "en": "If he comes in by himself, he shall go out by himself. If he is married, then his wife shall go out with him.",
      "ko": "그가 단신으로 왔으면 단신으로 나갈 것이요 장가 들었으면 그 아내도 그와 함께 나가려니와",
      "source_text_hash": "43c802f930f58bd2657c1e57d2731a0ad7c5bf29deebaae66bb6cdb46bb6853c",
      "translation_text_hash": "90a8ec8341352b1cd1f6f3271bd53052aca75d271babfc0753398ea9200ca722",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 단신으로 왔으면 단신으로 나갈 것이요 장가 들었으면 그 아내도 그와 함께 나가려니와"
      ],
      "raw_text_hashes": [
        "90a8ec8341352b1cd1f6f3271bd53052aca75d271babfc0753398ea9200ca722"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:21:4",
      "sequence": 2082,
      "chapter_label": "EXO 21",
      "verse_label": "4",
      "locator": {
