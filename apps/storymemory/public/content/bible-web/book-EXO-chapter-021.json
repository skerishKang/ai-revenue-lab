      "source_text_hash": "53e2d67a852255de426708e2413494c9cf2dc77e34cae2e305a807739ac2ff02",
      "translation_text_hash": "6b6c679e0673fe9403dc2dbc0d55143ae24c78ee7b6023f23ed6b5566b983b8a",
      "translation_policy": "krv-1961-source-mapped",
