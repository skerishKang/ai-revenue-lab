      "raw_texts": [
        "유다 자손이 예루살렘을 쳐서 취하여 칼날로 치고 성을 불살랐으며"
      ],
      "raw_text_hashes": [
        "8f072d8394e696b6548ea1c4dbd78e6320f1ff5aa040d1d3c155dea75b020ce6"
