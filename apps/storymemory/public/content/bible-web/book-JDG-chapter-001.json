      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "갈렙이 말하기를 기럇 세벨을 쳐서 그것을 취하는 자에게는 내 딸 악사를 아내로 주리라 하였더니"
      ],
      "raw_text_hashes": [
        "b3a7265a48247498ea01bbf64d8c92e4fca41a64f5429db93e80e935e9013de9"
