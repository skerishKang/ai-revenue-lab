      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 가라사대 유다가 올라갈찌니라 보라 내가 이 땅을 그 손에 붙였노라 하시니라"
      ],
      "raw_text_hashes": [
