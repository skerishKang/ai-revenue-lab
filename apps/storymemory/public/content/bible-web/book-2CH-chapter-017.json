        "verse": 4
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 17,
          "verse": 4
        }
      ],
      "en": "but sought the God of his father, and walked in his commandments, and not in the ways of Israel.",
      "ko": "오직 그 부친의 하나님께 구하며 그 계명을 행하고 이스라엘의 행위를 좇지 아니하였음이라",
      "source_text_hash": "1c2c6a00cbe9e017cf68d4c8cbbe3368a3db8578883876a58e7be794b6f4a720",
      "translation_text_hash": "e9ac68315a983d6aa9b04419fa19707ede20d533b5c750bb92fa92dfd449c42f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 그 부친의 하나님께 구하며 그 계명을 행하고 이스라엘의 행위를 좇지 아니하였음이라"
      ],
      "raw_text_hashes": [
        "e9ac68315a983d6aa9b04419fa19707ede20d533b5c750bb92fa92dfd449c42f"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:17:5",
      "sequence": 11529,
      "chapter_label": "2CH 17",
      "verse_label": "5",
      "locator": {
        "book": "2CH",
