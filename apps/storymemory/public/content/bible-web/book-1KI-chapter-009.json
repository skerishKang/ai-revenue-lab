      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 9,
          "verse": 8
        }
      ],
      "en": "Though this house is so high, yet everyone who passes by it will be astonished and hiss; and they will say, ‘Why has the LORD done this to this land and to this house?’",
      "ko": "이 전이 높을찌라도 무릇 그리로 지나가는 자가 놀라며 비웃어 가로되 여호와께서 무슨 까닭으로 이 땅과 이 전에 이 같이 행하셨는고 하면",
      "source_text_hash": "b21383a28c31a518280c803b823bb1d2623a17478707c7910d4cc6f1d80dd041",
      "translation_text_hash": "9959cc0da75be6e6dcfdbdf51a744581f40701da61dfe2e7fc198196a830cecd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 전이 높을찌라도 무릇 그리로 지나가는 자가 놀라며 비웃어 가로되 여호와께서 무슨 까닭으로 이 땅과 이 전에 이 같이 행하셨는고 하면"
      ],
      "raw_text_hashes": [
