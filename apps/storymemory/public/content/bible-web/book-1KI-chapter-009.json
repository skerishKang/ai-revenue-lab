      "source_text_hash": "04eb1f574ceccded3e83278dc7a92d0addc49a6a236b1d0916a6d866055dff4b",
      "translation_text_hash": "5b7ab259d4937f8bbffd46603a7b54a6a3e864dda26b9a67f0c124e16d1f9376",
      "translation_policy": "krv-1961-source-mapped",
