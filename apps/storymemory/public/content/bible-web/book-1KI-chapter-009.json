      "source_text_hash": "acafd9bc897def0ae19170a554bfd13d0c4f116941791b68befc6c68c7bdeeb8",
      "translation_text_hash": "5117cf651e793fe99c083ecbbab3dcf3783b9b1423352449d4122b0c4ecf3829",
