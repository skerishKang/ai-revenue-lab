        }
      ],
      "en": "Moses laid up the rods before the LORD in the Tent of the Testimony.",
      "ko": "모세가 그 지팡이들을 증거의 장막 안 여호와 앞에 두었더라",
      "source_text_hash": "1bebbdc3f7010911fe4401884ca7c91b57065f3819a7b07e2733bedd82a63373",
      "translation_text_hash": "f9322ba190934dd51cef8c2e412c72fb3278af82380714ce91c566478e1bd3dc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세가 그 지팡이들을 증거의 장막 안 여호와 앞에 두었더라"
      ],
      "raw_text_hashes": [
        "f9322ba190934dd51cef8c2e412c72fb3278af82380714ce91c566478e1bd3dc"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:17:8",
      "sequence": 4253,
