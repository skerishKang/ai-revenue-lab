      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 14,
          "verse": 5
        }
      ],
      "en": "As soon as the kingdom was established in his hand, he killed his servants who had slain the king his father,",
      "ko": "나라가 그 손에 굳게 서매 그 부왕을 죽인 신복들을 죽였으나",
      "source_text_hash": "911ece156646ea9ad1ec9aa8d3bdaf5246a5ac3bafe0c456476bc9b715cffd77",
      "translation_text_hash": "905ede5705ab6356cd332ebc42f901f7b90c6b3f2b94beaf03d41118dc811ea0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나라가 그 손에 굳게 서매 그 부왕을 죽인 신복들을 죽였으나"
      ],
      "raw_text_hashes": [
        "905ede5705ab6356cd332ebc42f901f7b90c6b3f2b94beaf03d41118dc811ea0"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:14:6",
      "sequence": 9903,
      "chapter_label": "2KI 14",
      "verse_label": "6",
      "locator": {
