      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 14,
          "verse": 12
        }
      ],
      "en": "Judah was defeated by Israel; and each man fled to his tent.",
      "ko": "유다가 이스라엘 앞에서 패하여 각기 장막으로 도망한지라",
      "source_text_hash": "88121838e22e826975e8687c224c21b5002c9bdad65f9f3218b6d6498b57e9b9",
      "translation_text_hash": "5f1b510a64b5106f4fcf7d0443096c20c4b1bb99e1614dfc4800e639de22f09f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "유다가 이스라엘 앞에서 패하여 각기 장막으로 도망한지라"
      ],
      "raw_text_hashes": [
        "5f1b510a64b5106f4fcf7d0443096c20c4b1bb99e1614dfc4800e639de22f09f"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:14:13",
      "sequence": 9910,
      "chapter_label": "2KI 14",
