        {
          "book": "AMO",
          "chapter": 8,
          "verse": 4
        }
      ],
      "en": "Hear this, you who desire to swallow up the needy, and cause the poor of the land to fail,",
      "ko": "궁핍한 자를 삼키며 땅의 가난한 자를 망케 하려는 자들아 이 말을 들으라",
      "source_text_hash": "b8e3901c1f4bd6c16cd22118c231873a0b05ff86d096d7b6a05fa61b048f6281",
      "translation_text_hash": "5a338cf570e2464dbd9b8212e2ac2feaae607aab4c268d6fb8e49879dde84140",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "궁핍한 자를 삼키며 땅의 가난한 자를 망케 하려는 자들아 이 말을 들으라"
      ],
      "raw_text_hashes": [
        "5a338cf570e2464dbd9b8212e2ac2feaae607aab4c268d6fb8e49879dde84140"
      ]
    },
    {
      "canonical_locator": "bible:web:AMO:8:5",
      "sequence": 22487,
