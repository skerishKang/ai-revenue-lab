      ],
      "en": "For if you thoroughly amend your ways and your doings, if you thoroughly execute justice between a man and his neighbor;",
      "ko": "너희가 만일 길과 행위를 참으로 바르게 하여 이웃들 사이에 공의를 행하며",
      "source_text_hash": "8f761dc672019cbbb4838c0643af88fcec3c627a9af99b79b60031c6cac7659c",
      "translation_text_hash": "11345767217d381c85210e905af32b38554057008a4ce872368d657d54b194e6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 만일 길과 행위를 참으로 바르게 하여 이웃들 사이에 공의를 행하며"
      ],
      "raw_text_hashes": [
        "11345767217d381c85210e905af32b38554057008a4ce872368d657d54b194e6"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:7:6",
      "sequence": 19126,
