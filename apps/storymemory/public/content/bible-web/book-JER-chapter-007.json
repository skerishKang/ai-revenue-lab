      "ko": "너희가 무익한 거짓말을 의뢰하는도다",
      "source_text_hash": "68f5fe61f6bc9488d2e43f53d60957d80bde3cd1731dba05739941b68c7292e7",
      "translation_text_hash": "a340af72ccce105d118f9651748996b813359ce40ba032792377a04fd5fd327e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
