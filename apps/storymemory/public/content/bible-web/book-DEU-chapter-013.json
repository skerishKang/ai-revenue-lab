      "locator": {
        "book": "DEU",
        "chapter": 13,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 13,
          "verse": 7
        }
      ],
      "en": "of the gods of the peoples who are around you, near to you, or far off from you, from the one end of the earth even to the other end of the earth—",
      "ko": "곧 네 사방에 둘러 있는 민족 혹 네게서 가깝든지 네게서 멀든지 땅 이 끝에서 저 끝까지 있는 민족의 신들을 우리가 가서 섬기자 할찌라도",
      "source_text_hash": "3339741642649d0edf722121b60f6d1739bbe4baa96d59c008481a58778aeee1",
      "translation_text_hash": "c40b052330b1c49e0c22339fd13af8098fc33e1f48dd403f8f50c82153149454",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "곧 네 사방에 둘러 있는 민족 혹 네게서 가깝든지 네게서 멀든지 땅 이 끝에서 저 끝까지 있는 민족의 신들을 우리가 가서 섬기자 할찌라도"
      ],
      "raw_text_hashes": [
        "c40b052330b1c49e0c22339fd13af8098fc33e1f48dd403f8f50c82153149454"
      ]
