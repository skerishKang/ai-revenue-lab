      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 1,
          "verse": 10
        }
      ],
      "en": "She was in bitterness of soul, and prayed to the LORD, weeping bitterly.",
      "ko": "한나가 마음이 괴로와서 여호와께 기도하고 통곡하며",
      "source_text_hash": "6a8630779b8457367e6a563b1cfbf90c73d33a16bd65ba6bf018510b9f7304b2",
      "translation_text_hash": "f399973c575fc6f8cd0ff026b8ac5fc84b74fe600dd3a082253a85eccfc9c949",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한나가 마음이 괴로와서 여호와께 기도하고 통곡하며"
      ],
      "raw_text_hashes": [
        "f399973c575fc6f8cd0ff026b8ac5fc84b74fe600dd3a082253a85eccfc9c949"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:1:11",
      "sequence": 7224,
      "chapter_label": "1SA 1",
      "verse_label": "11",
      "locator": {
        "book": "1SA",
        "chapter": 1,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 1,
          "verse": 11
        }
      ],
      "en": "She vowed a vow, and said, “LORD of Armies, if you will indeed look at the affliction of your servant and remember me, and not forget your servant, but will give to your servant a boy, then I will give him to the LORD all the days of his life, and no razor shall come on his head.”",
      "ko": "서원하여 가로되 만군의 여호와여 만일 주의 여종의 고통을 돌아보시고 나를 생각하시고 주의 여종을 잊지 아니하사 아들을 주시면 내가 그의 평생에 그를 여호와께 드리고 삭도를 그 머리에 대지 아니하겠나이다",
      "source_text_hash": "0e70202eed4f028d84279f587704be2f8d5b0cabda02108d86d783b80fa7d7a0",
      "translation_text_hash": "cc1f401a314e8e64666faa28b05bb48cc0236c301b30b8e13241f2f5a6a7b4f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "서원하여 가로되 만군의 여호와여 만일 주의 여종의 고통을 돌아보시고 나를 생각하시고 주의 여종을 잊지 아니하사 아들을 주시면 내가 그의 평생에 그를 여호와께 드리고 삭도를 그 머리에 대지 아니하겠나이다"
      ],
      "raw_text_hashes": [
