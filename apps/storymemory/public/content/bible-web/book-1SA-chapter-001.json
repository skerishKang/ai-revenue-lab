        "verse": 5
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 1,
          "verse": 5
        }
      ],
      "en": "but he gave a double portion to Hannah, for he loved Hannah, but the LORD had shut up her womb.",
      "ko": "한나에게는 갑절을 주니 이는 그를 사랑함이라 그러나 여호와께서 그로 성태치 못하게 하시니",
      "source_text_hash": "a9011dd2f4254cbb921f137e23d792f06eb9ff6d3bcbf53919d5ad3d43ed2b96",
      "translation_text_hash": "e2fd43b0a38eade3a0deaf5e1e6c5bb3a6f2659ccb66ecaff93fd22713fc1615",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한나에게는 갑절을 주니 이는 그를 사랑함이라 그러나 여호와께서 그로 성태치 못하게 하시니"
      ],
      "raw_text_hashes": [
        "e2fd43b0a38eade3a0deaf5e1e6c5bb3a6f2659ccb66ecaff93fd22713fc1615"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:1:6",
      "sequence": 7219,
      "chapter_label": "1SA 1",
      "verse_label": "6",
      "locator": {
        "book": "1SA",
        "chapter": 1,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 1,
          "verse": 6
        }
      ],
      "en": "Her rival provoked her severely, to irritate her, because the LORD had shut up her womb.",
      "ko": "여호와께서 그로 성태치 못하게 하시므로 그 대적 브닌나가 그를 심히 격동하여 번민케 하더라",
      "source_text_hash": "ba1b8f8c42c66f160a01d45bc37ff85b84d04b3700d6d626f8dd972f501d6d37",
      "translation_text_hash": "2e764bbd84f77003cf1a6778af80ef736e9e7ea65421458cf9a131b1fb0f4575",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 그로 성태치 못하게 하시므로 그 대적 브닌나가 그를 심히 격동하여 번민케 하더라"
      ],
      "raw_text_hashes": [
        "2e764bbd84f77003cf1a6778af80ef736e9e7ea65421458cf9a131b1fb0f4575"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:1:7",
      "sequence": 7220,
      "chapter_label": "1SA 1",
      "verse_label": "7",
      "locator": {
        "book": "1SA",
        "chapter": 1,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 1,
          "verse": 7
        }
      ],
      "en": "So year by year, when she went up to the LORD’s house, her rival provoked her. Therefore she wept, and didn’t eat.",
      "ko": "매년에 한나가 여호와의 집에 올라갈 때마다 남편이 그같이 하매 브닌나가 그를 격동시키므로 그가 울고 먹지 아니하니",
      "source_text_hash": "b780c695584548a68a8119e7d7e781a5f657076d3dcc89e7bebe225d9d1852a4",
      "translation_text_hash": "11aee65e5e6d1a1dfe3a10bfaaf8f1b54125ebb203b6f38e24a262ca3f50458a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "매년에 한나가 여호와의 집에 올라갈 때마다 남편이 그같이 하매 브닌나가 그를 격동시키므로 그가 울고 먹지 아니하니"
      ],
      "raw_text_hashes": [
        "11aee65e5e6d1a1dfe3a10bfaaf8f1b54125ebb203b6f38e24a262ca3f50458a"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:1:8",
      "sequence": 7221,
      "chapter_label": "1SA 1",
      "verse_label": "8",
      "locator": {
        "book": "1SA",
        "chapter": 1,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "Elkanah her husband said to her, “Hannah, why do you weep? Why don’t you eat? Why is your heart grieved? Am I not better to you than ten sons?”",
      "ko": "그 남편 엘가나가 그에게 이르되 한나여 어찌하여 울며 어찌하여 먹지 아니하며 어찌하여 그대의 마음이 슬프뇨 내가 그대에게 열 아들보다 낫지 아니하뇨",
      "source_text_hash": "5109237664a677cf9b58861157b181da2a58dbc8dee7811950822bb808dbaa0d",
      "translation_text_hash": "b4dd9350a50fac0be611eeb502e10b55bf6ae580f554c859e954ec759b654d86",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 남편 엘가나가 그에게 이르되 한나여 어찌하여 울며 어찌하여 먹지 아니하며 어찌하여 그대의 마음이 슬프뇨 내가 그대에게 열 아들보다 낫지 아니하뇨"
      ],
      "raw_text_hashes": [
