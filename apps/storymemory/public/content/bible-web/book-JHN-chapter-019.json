      "source_text_hash": "51ac442b30a1860aae75c2d184ef8cfacf8ab084a5d8ebdcd0cfa68832c66219",
      "translation_text_hash": "493ced0ade874d4779b8b00ccdf09533c76b9ecd560e5fcc4f2d1fae23fff14c",
      "translation_policy": "krv-1961-source-mapped",
