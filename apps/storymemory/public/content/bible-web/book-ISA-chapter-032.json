      "chapter_label": "ISA 32",
      "verse_label": "7",
      "locator": {
        "book": "ISA",
        "chapter": 32,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 32,
          "verse": 7
        }
      ],
      "en": "The ways of the scoundrel are evil. He devises wicked plans to destroy the humble with lying words, even when the needy speaks right.",
      "ko": "궤휼한 자는 그 그릇이 악하여 악한 계획을 베풀어 거짓말로 가련한 자를 멸하며 빈핍한 자가 말을 바르게 할찌라도 그리함이어니와",
      "source_text_hash": "89050b79f6ec2ffbf9d8a387bdf95cc7e00de9cbb27c9f73f8e9fb28f6c197ca",
      "translation_text_hash": "0fc76fa5de8c0b1841d5ab4bae478ad193e079ec42ea9872dc748209fc6300f9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "궤휼한 자는 그 그릇이 악하여 악한 계획을 베풀어 거짓말로 가련한 자를 멸하며 빈핍한 자가 말을 바르게 할찌라도 그리함이어니와"
      ],
      "raw_text_hashes": [
        "0fc76fa5de8c0b1841d5ab4bae478ad193e079ec42ea9872dc748209fc6300f9"
