      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 11,
          "verse": 5
        }
      ],
      "en": "The righteousness of the blameless will direct his way, but the wicked shall fall by his own wickedness.",
      "ko": "완전한 자는 그 의로 인하여 그 길이 곧게 되려니와 악한 자는 그 악을 인하여 넘어지리라",
      "source_text_hash": "765edd2b617c8416aea2a7c10d8ed607df05ed57d945c020adee8ec7d286fe0a",
      "translation_text_hash": "35decf62bba7e7c35491f970870fae185f0b2db92aeecf631524d3af5e9a0dfd",
      "translation_policy": "krv-1961-source-mapped",
