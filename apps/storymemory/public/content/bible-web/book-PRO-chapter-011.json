      "translation_text_hash": "81979370b060f540fb0c39e162a887088ec95ab4615ccdd15278befa70650c66",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
