      "translation_text_hash": "5158268d57e1ae2399ac4d07783bdb3085998c0cc1b11d214a2c2ca0f99b1607",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
