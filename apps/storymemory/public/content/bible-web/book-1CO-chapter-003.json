      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 누구든지 그 위에 세운 공력이 그대로 있으면 상을 받고"
      ],
      "raw_text_hashes": [
        "88b5fbece25de2c00428b6cc051d9e959051cb14414454d57ec1c95afcfb0242"
