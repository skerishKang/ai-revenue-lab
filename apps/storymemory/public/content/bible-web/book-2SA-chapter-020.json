      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 20,
          "verse": 5
        }
      ],
      "en": "So Amasa went to call the men of Judah together, but he stayed longer than the set time which had been appointed to him.",
      "ko": "아마사가 유다 사람을 소집하러 가더니 왕의 정한 기한에 지체된지라",
      "source_text_hash": "08d119e323dd9b87eb1364afc4ebcab74923b3db940cc11accb2aeff86829f0d",
      "translation_text_hash": "06e5f6db9345c5f16c58ee566292c711e271579446088ebf256e24c9d1128d30",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아마사가 유다 사람을 소집하러 가더니 왕의 정한 기한에 지체된지라"
      ],
      "raw_text_hashes": [
        "06e5f6db9345c5f16c58ee566292c711e271579446088ebf256e24c9d1128d30"
      ]
    },
    {
