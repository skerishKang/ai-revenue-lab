        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 7,
          "verse": 13
        }
      ],
      "en": "Pharaoh’s heart was hardened, and he didn’t listen to them, as the LORD had spoken.",
      "ko": "그러나 바로의 마음이 강퍅하여 그들을 듣지 아니하니 여호와의 말씀과 같더라",
      "source_text_hash": "75d8f4e7e78cc70fcdb30cafa7d51559bc7ad35ca34444239f17a9a2d0ed0e1e",
      "translation_text_hash": "35cc2d530ab578d0aec6dc0681f6b2bf55046879da478030967c62bcc7bddb5b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 바로의 마음이 강퍅하여 그들을 듣지 아니하니 여호와의 말씀과 같더라"
      ],
      "raw_text_hashes": [
        "35cc2d530ab578d0aec6dc0681f6b2bf55046879da478030967c62bcc7bddb5b"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:7:14",
      "sequence": 1700,
      "chapter_label": "EXO 7",
