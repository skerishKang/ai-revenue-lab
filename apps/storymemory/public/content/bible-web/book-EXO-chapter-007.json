        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 7,
          "verse": 6
        }
      ],
      "en": "Moses and Aaron did so. As the LORD commanded them, so they did.",
      "ko": "모세와 아론이 여호와께서 자기들에게 명하신대로 곧 그대로 행하였더라",
      "source_text_hash": "6f7374957e08df25ed5a86b2860055be6a2690d05ea5befb611badd2df91c8b7",
      "translation_text_hash": "b6c136346ebaf0d1a8afd5d53e3af9a9372257dcc55e20b557148ef6e1cf59e6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세와 아론이 여호와께서 자기들에게 명하신대로 곧 그대로 행하였더라"
      ],
      "raw_text_hashes": [
        "b6c136346ebaf0d1a8afd5d53e3af9a9372257dcc55e20b557148ef6e1cf59e6"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:7:7",
      "sequence": 1693,
      "chapter_label": "EXO 7",
      "verse_label": "7",
      "locator": {
