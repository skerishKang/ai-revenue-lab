      ],
      "en": "In the thickness of the wall of the court toward the east, before the separate place, and before the building, there were rooms.",
      "ko": "남편 골방 뜰 맞은편과 남편 건물 맞은편에도 방 둘이 있는데",
      "source_text_hash": "0872c20b21b368a486973487e5a90cbe3ea5444d5588a3a1288ebb33faa435a5",
      "translation_text_hash": "0d4d9663e28ea7e67e552d4b36367f9bfc84c329b2d0e81007a3ef517e1ee785",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "남편 골방 뜰 맞은편과 남편 건물 맞은편에도 방 둘이 있는데"
      ],
      "raw_text_hashes": [
        "0d4d9663e28ea7e67e552d4b36367f9bfc84c329b2d0e81007a3ef517e1ee785"
      ]
