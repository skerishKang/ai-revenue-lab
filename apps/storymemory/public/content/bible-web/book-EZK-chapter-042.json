      "raw_texts": [
        "그 방들의 자리의 장이 일백척이요 광이 오십척이며 그 문은 북을 향하였고"
      ],
      "raw_text_hashes": [
        "10964421f9c741d87928d6a4469ce4b29c1f9afd0a74ad292cc98f4d1b5cda95"
