      "en": "The wall that was outside by the side of the rooms, toward the outer court before the rooms, was fifty cubits long.",
      "ko": "그 한 방의 바깥 담 곧 뜰의 담과 마주 대한 담의 장이 오십척이니",
      "source_text_hash": "856317bde4758d02cacf3da64b62f256764301a7b25739a8956806b8b016e908",
      "translation_text_hash": "3ba6f4998e18b9fc8245d9043977a8b06fba9da1a2ba30198bdb95175a95cefe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 한 방의 바깥 담 곧 뜰의 담과 마주 대한 담의 장이 오십척이니"
      ],
      "raw_text_hashes": [
        "3ba6f4998e18b9fc8245d9043977a8b06fba9da1a2ba30198bdb95175a95cefe"
      ]
