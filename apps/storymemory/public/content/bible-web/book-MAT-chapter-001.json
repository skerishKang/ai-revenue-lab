      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "람은 아미나답을 낳고 아미나답은 나손을 낳고 나손은 살몬을 낳고"
      ],
      "raw_text_hashes": [
        "1f44f69bdcd514eac4e0d5196869c0ba290803a5b9fd75d60f9fec2c0ad69274"
      ]
