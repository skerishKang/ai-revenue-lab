      "raw_locator": [
        {
          "book": "REV",
          "chapter": 18,
          "verse": 5
        }
      ],
      "en": "for her sins have reached to the sky, and God has remembered her iniquities.",
      "ko": "그 죄는 하늘에 사무쳤으며 하나님은 그의 불의한 일을 기억하신지라",
      "source_text_hash": "b9fb111db0e70ab6a205180e76de6a423afbc5184b6ead70ee3ba9d6795974f6",
      "translation_text_hash": "a624999a6aeb6a4834e4cd504dd7a1fa758c4f5f418201d38fe0020893b3877e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 죄는 하늘에 사무쳤으며 하나님은 그의 불의한 일을 기억하신지라"
      ],
      "raw_text_hashes": [
        "a624999a6aeb6a4834e4cd504dd7a1fa758c4f5f418201d38fe0020893b3877e"
      ]
