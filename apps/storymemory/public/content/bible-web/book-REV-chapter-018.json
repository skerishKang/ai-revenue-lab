    {
      "canonical_locator": "bible:web:REV:18:20",
      "sequence": 31010,
      "chapter_label": "REV 18",
      "verse_label": "20",
      "locator": {
        "book": "REV",
        "chapter": 18,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 18,
          "verse": 20
        }
      ],
      "en": "“Rejoice over her, O heaven, you saints, apostles, and prophets, for God has judged your judgment on her.”",
      "ko": "하늘과 성도들과 사도들과 선지자들아 그를 인하여 즐거워하라 하나님이 너희를 신원하시는 심판을 그에게 하셨음이라 하더라",
      "source_text_hash": "189719c5b6852909e112ca54e3c46cbf3244caac3a4e8a08c62c3a40e48f0db3",
      "translation_text_hash": "c0369d657bd18d694b4b93ddc2066324d56d55efb6646c141dfd57f4bc262195",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하늘과 성도들과 사도들과 선지자들아 그를 인하여 즐거워하라 하나님이 너희를 신원하시는 심판을 그에게 하셨음이라 하더라"
      ],
      "raw_text_hashes": [
