        "verse": 9
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 18,
          "verse": 9
        }
      ],
      "en": "The kings of the earth who committed sexual immorality and lived wantonly with her will weep and wail over her, when they look at the smoke of her burning,",
      "ko": "그와 함께 음행하고 사치하던 땅의 왕들이 그 불붙는 연기를 보고 위하여 울고 가슴을 치며",
      "source_text_hash": "b730ef26023a010e4b53633eda87aa0d3cf3131d50e4932c89d66e98bd162603",
      "translation_text_hash": "152621860682e20af00fd8a114801cda735e793e021c6fc5c68e4fdf40e16395",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
