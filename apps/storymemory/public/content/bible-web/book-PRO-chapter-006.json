      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 입의 말로 네가 얽혔으며 네 입의 말로 인하여 잡히게 되었느니라"
      ],
      "raw_text_hashes": [
        "da5fc3329009f02052ebf1eb938a92be6f7d0ccd942fef34e162e8933862bb22"
      ]
