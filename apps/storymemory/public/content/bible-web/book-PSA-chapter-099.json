      ],
      "en": "The LORD is great in Zion. He is high above all the peoples.",
      "ko": "여호와께서 시온에서 광대하시고 모든 민족 위에 높으시도다",
      "source_text_hash": "a7c60ad6d8de067a4679403609b48a4cf67a0aa21e65acee85fd09285bed10e8",
      "translation_text_hash": "c2435f88b6bc4ae89d3061814811eb16c7a98c7a126a8d3dd7e84eff370c36ed",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
