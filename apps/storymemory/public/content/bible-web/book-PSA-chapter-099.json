      "translation_text_hash": "cc81f913fd7bfb90b27f943afd5a35d9b4b034433990cb882294b279c1449f34",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 크고 두려운 이름을 찬송할찌어다 그는 거룩하시도다"
      ],
      "raw_text_hashes": [
        "cc81f913fd7bfb90b27f943afd5a35d9b4b034433990cb882294b279c1449f34"
      ]
