        "verse": 7
      },
      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 1,
          "verse": 7
        }
      ],
      "en": "The LORD is good, a stronghold in the day of trouble; and he knows those who take refuge in him.",
      "ko": "여호와는 선하시며 환난 날에 산성이시라 그는 자기에게 의뢰하는 자들을 아시느니라",
      "source_text_hash": "188d1192120a896e87d304a7184a5748ebfae950128e55149e0a2d5815511049",
      "translation_text_hash": "3c3bd1a040b9126abac30deddb84eb99aa57ee7c468d23aacd3ddc8b4a8c9cf0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와는 선하시며 환난 날에 산성이시라 그는 자기에게 의뢰하는 자들을 아시느니라"
      ],
      "raw_text_hashes": [
        "3c3bd1a040b9126abac30deddb84eb99aa57ee7c468d23aacd3ddc8b4a8c9cf0"
      ]
    },
    {
      "canonical_locator": "bible:web:NAM:1:8",
      "sequence": 22693,
      "chapter_label": "NAM 1",
      "verse_label": "8",
      "locator": {
        "book": "NAM",
