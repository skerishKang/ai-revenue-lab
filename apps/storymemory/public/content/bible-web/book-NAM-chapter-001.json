      ],
      "en": "A revelation about Nineveh. The book of the vision of Nahum the Elkoshite.",
      "ko": "니느웨에 대한 중한 경고 곧 엘고스 사람 나훔의 묵시의 글이라",
      "source_text_hash": "0492481ac9db866c578eb1445256014b14be506ad2809ac9c5c18c217f1bd965",
      "translation_text_hash": "e33ea2446690fcd7f01898db221c7407520099f0e2874785ebcbe108a5eb76f9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "니느웨에 대한 중한 경고 곧 엘고스 사람 나훔의 묵시의 글이라"
      ],
      "raw_text_hashes": [
        "e33ea2446690fcd7f01898db221c7407520099f0e2874785ebcbe108a5eb76f9"
      ]
    },
    {
      "canonical_locator": "bible:web:NAM:1:2",
      "sequence": 22687,
      "chapter_label": "NAM 1",
      "verse_label": "2",
      "locator": {
