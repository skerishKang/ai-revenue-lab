        "verse": 8
      },
      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "But with an overflowing flood, he will make a full end of her place, and will pursue his enemies into darkness.",
      "ko": "그가 범람한 물로 그곳을 진멸하시고 자기 대적들을 흑암으로 쫓아내시리라",
      "source_text_hash": "beefd458b48e2f049f34b02b21fa48a5038e18f94b915973a57bd4966833813d",
      "translation_text_hash": "07aa1a3f0798437920de3e0bdb0340ab395bf44ed0bf858f584960f6f2dcad96",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 범람한 물로 그곳을 진멸하시고 자기 대적들을 흑암으로 쫓아내시리라"
      ],
      "raw_text_hashes": [
        "07aa1a3f0798437920de3e0bdb0340ab395bf44ed0bf858f584960f6f2dcad96"
      ]
    },
    {
      "canonical_locator": "bible:web:NAM:1:9",
      "sequence": 22694,
      "chapter_label": "NAM 1",
      "verse_label": "9",
      "locator": {
        "book": "NAM",
