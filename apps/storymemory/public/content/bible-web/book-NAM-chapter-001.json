        "verse": 4
      },
      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 1,
          "verse": 4
        }
      ],
      "en": "He rebukes the sea and makes it dry, and dries up all the rivers. Bashan and Carmel languish. The flower of Lebanon languishes.",
      "ko": "그는 바다를 꾸짖어 그것을 말리우시며 모든 강을 말리우시나니 바산과 갈멜이 쇠하며 레바논의 꽃이 이우는도다",
      "source_text_hash": "eba1daf247a30f99bf1e71dd96cb98e33a2fac12280080ff3e73326ad1b96f96",
      "translation_text_hash": "c71ef37e65ae0fc879dcbb76f03923147b339a828c6ff157d0b5fd7a6a588191",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그는 바다를 꾸짖어 그것을 말리우시며 모든 강을 말리우시나니 바산과 갈멜이 쇠하며 레바논의 꽃이 이우는도다"
      ],
      "raw_text_hashes": [
        "c71ef37e65ae0fc879dcbb76f03923147b339a828c6ff157d0b5fd7a6a588191"
      ]
    },
    {
      "canonical_locator": "bible:web:NAM:1:5",
      "sequence": 22690,
      "chapter_label": "NAM 1",
      "verse_label": "5",
      "locator": {
        "book": "NAM",
        "chapter": 1,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 1,
          "verse": 5
        }
      ],
      "en": "The mountains quake before him, and the hills melt away. The earth trembles at his presence, yes, the world, and all who dwell in it.",
      "ko": "그로 인하여 산들이 진동하며 작은 산들이 녹고 그의 앞에서는 땅 곧 세계와 그 가운데 거하는 자들이 솟아 오르는도다",
      "source_text_hash": "853416d797ca6077c40ee44ea51874473abe25144fb54120b85182b0d01e285d",
      "translation_text_hash": "8de4aabb9815ec4b12457b5308d2062ebd5345fd684ce4ca4cf4e657a21026ca",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그로 인하여 산들이 진동하며 작은 산들이 녹고 그의 앞에서는 땅 곧 세계와 그 가운데 거하는 자들이 솟아 오르는도다"
      ],
      "raw_text_hashes": [
        "8de4aabb9815ec4b12457b5308d2062ebd5345fd684ce4ca4cf4e657a21026ca"
      ]
    },
    {
      "canonical_locator": "bible:web:NAM:1:6",
      "sequence": 22691,
      "chapter_label": "NAM 1",
      "verse_label": "6",
      "locator": {
        "book": "NAM",
        "chapter": 1,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 1,
          "verse": 6
        }
      ],
      "en": "Who can stand before his indignation? Who can endure the fierceness of his anger? His wrath is poured out like fire, and the rocks are broken apart by him.",
      "ko": "누가 능히 그 분노하신 앞에 서며 누가 능히 그 진노를 감당하랴 그 진노를 불처럼 쏟으시니 그를 인하여 바위들이 깨어지는도다",
      "source_text_hash": "cc0a6939c62582540d8ba1296352965f92a6f820dcc0fc306a9e802c060e378b",
      "translation_text_hash": "79f8afcc84a7f6feadf764662796ed0e6d32d5dab86482004a62b45f4b658129",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "누가 능히 그 분노하신 앞에 서며 누가 능히 그 진노를 감당하랴 그 진노를 불처럼 쏟으시니 그를 인하여 바위들이 깨어지는도다"
      ],
      "raw_text_hashes": [
        "79f8afcc84a7f6feadf764662796ed0e6d32d5dab86482004a62b45f4b658129"
      ]
    },
    {
      "canonical_locator": "bible:web:NAM:1:7",
      "sequence": 22692,
      "chapter_label": "NAM 1",
