    {
      "canonical_locator": "bible:web:DEU:9:9",
      "sequence": 5167,
      "chapter_label": "DEU 9",
      "verse_label": "9",
      "locator": {
        "book": "DEU",
        "chapter": 9,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 9,
          "verse": 9
        }
      ],
      "en": "When I had gone up onto the mountain to receive the stone tablets, even the tablets of the covenant which the LORD made with you, then I stayed on the mountain forty days and forty nights. I neither ate bread nor drank water.",
      "ko": "그 때에 내가 돌판들 곧 여호와께서 너희와 세우신 언약의 돌판들을 받으려고 산에 올라가서 사십 주야를 산에 거하며 떡도 먹지 아니하고 물도 마시지 아니하였더니",
      "source_text_hash": "2a0ed61aa470679c32b39ea03105541006748061ca67c1fa0cf749c788874211",
      "translation_text_hash": "e04866eb714cbe0e8305308c1608b90f4817e1c9146b8042014bc037d298b3fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 때에 내가 돌판들 곧 여호와께서 너희와 세우신 언약의 돌판들을 받으려고 산에 올라가서 사십 주야를 산에 거하며 떡도 먹지 아니하고 물도 마시지 아니하였더니"
      ],
      "raw_text_hashes": [
        "e04866eb714cbe0e8305308c1608b90f4817e1c9146b8042014bc037d298b3fe"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:9:10",
      "sequence": 5168,
      "chapter_label": "DEU 9",
      "verse_label": "10",
      "locator": {
        "book": "DEU",
        "chapter": 9,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 9,
          "verse": 10
        }
      ],
      "en": "The LORD delivered to me the two stone tablets written with God’s finger. On them were all the words which the LORD spoke with you on the mountain out of the middle of the fire in the day of the assembly.",
      "ko": "여호와께서 두 돌판을 내게 주셨나니 그 판의 글은 하나님이 친수로 기록하신 것이요 너희 총회 날에 여호와께서 산상 불 가운데서 너희에게 이르신 모든 말씀이니라",
      "source_text_hash": "f7f65e03494462db3d97a980c8b57ab276dd737b977d2216189ceb2e7461a340",
      "translation_text_hash": "0f95a264940d6c5086180b52c6f5980654eb3bf2d999c176e55417573b1cf2f6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 두 돌판을 내게 주셨나니 그 판의 글은 하나님이 친수로 기록하신 것이요 너희 총회 날에 여호와께서 산상 불 가운데서 너희에게 이르신 모든 말씀이니라"
      ],
