      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 돌이켜 산에서 내려오는데 산에는 불이 붙었고 언약의 두 돌판은 내 손에 있었느니라"
      ],
      "raw_text_hashes": [
