    {
      "canonical_locator": "bible:web:1CH:25:5",
      "sequence": 11052,
      "chapter_label": "1CH 25",
      "verse_label": "5",
      "locator": {
        "book": "1CH",
        "chapter": 25,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 25,
          "verse": 5
        }
      ],
      "en": "All these were the sons of Heman the king’s seer in the words of God, to lift up the horn. God gave to Heman fourteen sons and three daughters.",
      "ko": "이는 다 헤만의 아들들이니 나팔을 부는 자며 헤만은 하나님의 말씀을 받드는 왕의 선견자라 하나님이 헤만에게 열 네 아들과 세 딸을 주셨더라",
      "source_text_hash": "237e70b1e5c9b514a70c833e09cc374d3d26286b76e572ce2f097d3f2f0b9e63",
      "translation_text_hash": "a3a67ed73bb5be349ae4d6a1d13297c822470f6b9c29418a6e84cc67d143bd18",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 다 헤만의 아들들이니 나팔을 부는 자며 헤만은 하나님의 말씀을 받드는 왕의 선견자라 하나님이 헤만에게 열 네 아들과 세 딸을 주셨더라"
      ],
      "raw_text_hashes": [
