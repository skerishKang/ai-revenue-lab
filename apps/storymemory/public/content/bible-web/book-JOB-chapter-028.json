      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 28,
          "verse": 11
        }
      ],
      "en": "He binds the streams that they don’t trickle. The thing that is hidden he brings out to light.",
      "ko": "시냇물을 막아 스미지 않게 하고 감취었던 것을 밝은데로 내느니라",
      "source_text_hash": "488eb50192e548e6263e3b5060b99e29ca58a43294ed7ec8d7922185450019da",
      "translation_text_hash": "23fa291ca4a23ecbe5f39624411c211f5cc480a4de9ba3d02444048995362ecd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시냇물을 막아 스미지 않게 하고 감취었던 것을 밝은데로 내느니라"
      ],
      "raw_text_hashes": [
        "23fa291ca4a23ecbe5f39624411c211f5cc480a4de9ba3d02444048995362ecd"
      ]
