        "verse": 15
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 28,
          "verse": 15
        }
      ],
      "en": "It can’t be gotten for gold, neither will silver be weighed for its price.",
      "ko": "정금으로도 바꿀 수 없고 은을 달아도 그 값을 당치 못하리니",
      "source_text_hash": "bb1420a89369225c7527fe743949e79edd0c33315aa383b44e819a0aac5b1253",
      "translation_text_hash": "a6218b1568f327ef2dff44275ddf777e014a1a08c5821182656033398247b60a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "정금으로도 바꿀 수 없고 은을 달아도 그 값을 당치 못하리니"
      ],
      "raw_text_hashes": [
        "a6218b1568f327ef2dff44275ddf777e014a1a08c5821182656033398247b60a"
      ]
    },
    {
