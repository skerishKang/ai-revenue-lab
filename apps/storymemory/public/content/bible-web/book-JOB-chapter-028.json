      "raw_texts": [
        "그 값을 사람이 알지 못하나니 사람 사는 땅에서 찾을 수 없구나"
      ],
      "raw_text_hashes": [
        "d1fbec2811796016fd13ab702a6b3e9358344dc41a363868affc6975f22abaef"
      ]
