        "verse": 13
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 28,
          "verse": 13
        }
      ],
      "en": "Man doesn’t know its price, and it isn’t found in the land of the living.",
      "ko": "그 값을 사람이 알지 못하나니 사람 사는 땅에서 찾을 수 없구나",
      "source_text_hash": "5c2d64708d991950275197fbb8b1767ffdba9e54423a0918e6329b7fd73f20f9",
      "translation_text_hash": "d1fbec2811796016fd13ab702a6b3e9358344dc41a363868affc6975f22abaef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
