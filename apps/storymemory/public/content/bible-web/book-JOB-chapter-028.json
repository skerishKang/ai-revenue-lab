        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 28,
          "verse": 10
        }
      ],
      "en": "He cuts out channels among the rocks. His eye sees every precious thing.",
      "ko": "돌 가운데로 도랑을 파서 각종 보물을 눈으로 발견하고",
      "source_text_hash": "610eff87318a809d0ce5e4ede75e6836c73698472ccd03a84389f698ed47bcf4",
      "translation_text_hash": "8c41625a6c9e8eaee3f2469ef14c169cf5e24d69d9538475157c6ef5e720aea1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "돌 가운데로 도랑을 파서 각종 보물을 눈으로 발견하고"
      ],
      "raw_text_hashes": [
        "8c41625a6c9e8eaee3f2469ef14c169cf5e24d69d9538475157c6ef5e720aea1"
      ]
