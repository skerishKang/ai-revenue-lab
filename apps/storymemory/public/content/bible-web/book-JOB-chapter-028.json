      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 28,
          "verse": 7
        }
      ],
      "en": "That path no bird of prey knows, neither has the falcon’s eye seen it.",
      "ko": "그 길은 솔개도 알지 못하고 매의 눈도 보지 못하며",
      "source_text_hash": "503aadac03158827d468a2b2d1adba7c15a72279d000d1ddbcde1fc0df5b1b86",
      "translation_text_hash": "f89668967f2c1750c6907d990cadf700f0f7df6cd911ac49758f49583d407683",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
