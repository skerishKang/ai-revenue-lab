      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "자기 몸을 구별하여 여호와께 드리는 모든 날 동안은 시체를 가까이 하지 말 것이요"
      ],
      "raw_text_hashes": [
