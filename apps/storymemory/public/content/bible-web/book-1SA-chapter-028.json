      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울이 여호와로 그에게 맹세하여 가로되 여호와께서 사시거니와 네가 이 일로는 벌을 당치 아니하리라"
      ],
      "raw_text_hashes": [
