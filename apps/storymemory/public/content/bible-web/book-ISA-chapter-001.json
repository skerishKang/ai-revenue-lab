      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 마음이 너희의 월삭과 정한 절기를 싫어하나니 그것이 내게 무거운 짐이라 내가 지기에 곤비하였느니라"
      ],
      "raw_text_hashes": [
        "c7b221c725d28dd3e123b6408facfa176e0e65711f861ead6cfc9287aaa6e8d1"
