      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 3
        }
      ],
      "en": "Glory in his holy name. Let the heart of those who seek the LORD rejoice.",
      "ko": "그 성호를 자랑하라 무릇 여호와를 구하는 자는 마음이 즐거울찌로다",
      "source_text_hash": "f13aad97a69a487a2beaaafe14588a4b332c40faf3d142911d2e604c143476cf",
      "translation_text_hash": "5dfc11044d1a422a95e0f07f129867da9686d37884dbea884d54bf627ecfac8b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 성호를 자랑하라 무릇 여호와를 구하는 자는 마음이 즐거울찌로다"
      ],
      "raw_text_hashes": [
        "5dfc11044d1a422a95e0f07f129867da9686d37884dbea884d54bf627ecfac8b"
      ]
    },
    {
