      ],
      "raw_text_hashes": [
        "16308cc9314cf96d57cf8df2170ca6c5acf272458ab80ef95c54091ab8f230af"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:105:7",
      "sequence": 15614,
      "chapter_label": "PSA 105",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 105,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 7
        }
      ],
      "en": "He is the LORD, our God. His judgments are in all the earth.",
      "ko": "그는 여호와 우리 하나님이시라 그의 판단이 온 땅에 있도다",
      "source_text_hash": "bade5cdd3adeabe1161e52dc9fb37e4b6a96d4335124598345a6593cd4147a2f",
      "translation_text_hash": "fa96f4a3aeff3cf0b2863d8a897fbed48aed885bf3df51aeeac3e45268c5b1b1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그는 여호와 우리 하나님이시라 그의 판단이 온 땅에 있도다"
      ],
      "raw_text_hashes": [
        "fa96f4a3aeff3cf0b2863d8a897fbed48aed885bf3df51aeeac3e45268c5b1b1"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:105:8",
      "sequence": 15615,
      "chapter_label": "PSA 105",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
        "chapter": 105,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 8
        }
      ],
      "en": "He has remembered his covenant forever, the word which he commanded to a thousand generations,",
      "ko": "그는 그 언약 곧 천대에 명하신 말씀을 영원히 기억하셨으니",
      "source_text_hash": "4b1c5f2c93f4ea5765622903ff23ef65450e5adeed3ea6160ec96a249e3c3401",
      "translation_text_hash": "304d4594cf580aa52fd8220a7dfd811923f45b1f123b2145bb0926b6bebf811d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그는 그 언약 곧 천대에 명하신 말씀을 영원히 기억하셨으니"
      ],
      "raw_text_hashes": [
        "304d4594cf580aa52fd8220a7dfd811923f45b1f123b2145bb0926b6bebf811d"
      ]
    },
    {
