      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 9
        }
      ],
      "en": "the covenant which he made with Abraham, his oath to Isaac,",
      "ko": "이것은 아브라함에게 하신 언약이며 이삭에게 하신 맹세며",
      "source_text_hash": "cf7f62237414ccdf9878dd27d20d5d20ada60fa70078a39565a1992fd3ca95a8",
      "translation_text_hash": "52a533c2fc72e452ae692603655d44e6685018a3e35c71b0382d7fbc5ddc1717",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이것은 아브라함에게 하신 언약이며 이삭에게 하신 맹세며"
      ],
      "raw_text_hashes": [
        "52a533c2fc72e452ae692603655d44e6685018a3e35c71b0382d7fbc5ddc1717"
      ]
    },
