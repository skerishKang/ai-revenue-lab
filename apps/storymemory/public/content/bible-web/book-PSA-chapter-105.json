      "sequence": 15622,
      "chapter_label": "PSA 105",
      "verse_label": "15",
      "locator": {
        "book": "PSA",
        "chapter": 105,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 15
        }
      ],
      "en": "“Don’t touch my anointed ones! Do my prophets no harm!”",
      "ko": "이르시기를 나의 기름 부은 자를 만지지 말며 나의 선지자를 상하지 말라 하셨도다",
      "source_text_hash": "a282da254103b2c3d1657ed3da69b48535bc230c41c675d2efa300034f26727a",
      "translation_text_hash": "79a847ffb257b8afdd60a49f0591e4fcdced6d92e98d44096f78b89d971deba3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이르시기를 나의 기름 부은 자를 만지지 말며 나의 선지자를 상하지 말라 하셨도다"
      ],
      "raw_text_hashes": [
        "79a847ffb257b8afdd60a49f0591e4fcdced6d92e98d44096f78b89d971deba3"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:105:16",
      "sequence": 15623,
      "chapter_label": "PSA 105",
      "verse_label": "16",
      "locator": {
        "book": "PSA",
        "chapter": 105,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 16
        }
      ],
