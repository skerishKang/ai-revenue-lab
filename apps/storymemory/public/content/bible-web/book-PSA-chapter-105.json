      "ko": "그에게 노래하며 그를 찬양하며 그의 모든 기사를 말할찌어다",
      "source_text_hash": "24cc92d604d8eb989c3bfc89f9ee5882e75a10b2c3f67b0b944393ef5c0add79",
      "translation_text_hash": "83f228f92123752d4d2b394c9aabbd87c0190207dffc7a13bdb1e3a1a6ae0a04",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그에게 노래하며 그를 찬양하며 그의 모든 기사를 말할찌어다"
      ],
      "raw_text_hashes": [
        "83f228f92123752d4d2b394c9aabbd87c0190207dffc7a13bdb1e3a1a6ae0a04"
      ]
    },
    {
