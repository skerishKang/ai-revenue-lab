      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 4
        }
      ],
      "en": "Seek the LORD and his strength. Seek his face forever more.",
      "ko": "여호와와 그 능력을 구할찌어다 그 얼굴을 항상 구할찌어다",
      "source_text_hash": "648f1f1dbadf9e70b614cccf87eae20e78e7c1add43520d3ac6047a874557447",
      "translation_text_hash": "33d73d2326598592903e80e49f8d66483fbc79466fe08d8756b9bc15dbcbfc51",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와와 그 능력을 구할찌어다 그 얼굴을 항상 구할찌어다"
      ],
      "raw_text_hashes": [
        "33d73d2326598592903e80e49f8d66483fbc79466fe08d8756b9bc15dbcbfc51"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:105:5",
      "sequence": 15612,
      "chapter_label": "PSA 105",
      "verse_label": "5",
      "locator": {
