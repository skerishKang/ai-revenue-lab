        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 105,
          "verse": 11
        }
      ],
      "en": "saying, “To you I will give the land of Canaan, the lot of your inheritance,”",
      "ko": "이르시기를 내가 가나안 땅을 네게 주어 너희 기업의 지경이 되게 하리라 하셨도다",
      "source_text_hash": "52930328a9ae765d95dd0fcfef44a889375d257f21836f67d9e78a180d348cd2",
      "translation_text_hash": "cee24af55bf0228598bd1f82d7cf6326845d4d618bb636ec274768afa9b86d82",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이르시기를 내가 가나안 땅을 네게 주어 너희 기업의 지경이 되게 하리라 하셨도다"
      ],
      "raw_text_hashes": [
        "cee24af55bf0228598bd1f82d7cf6326845d4d618bb636ec274768afa9b86d82"
      ]
    },
