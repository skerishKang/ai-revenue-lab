      "translation_text_hash": "16308cc9314cf96d57cf8df2170ca6c5acf272458ab80ef95c54091ab8f230af",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
