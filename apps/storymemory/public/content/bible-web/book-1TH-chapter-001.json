        "verse": 7
      },
      "raw_locator": [
        {
          "book": "1TH",
          "chapter": 1,
          "verse": 7
        }
      ],
      "en": "so that you became an example to all who believe in Macedonia and in Achaia.",
      "ko": "그러므로 너희가 마게도냐와 아가야 모든 믿는 자의 본이 되었는지라",
      "source_text_hash": "2687d288aad5abfa781ec1f5732e5f5bd39447054ec7cff3ad9ff3ca09c7a235",
      "translation_text_hash": "7e3ecb81f613312ae16df3c5ce9fe02d40be3044b144de5cdc38852daa7b8211",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 너희가 마게도냐와 아가야 모든 믿는 자의 본이 되었는지라"
      ],
      "raw_text_hashes": [
        "7e3ecb81f613312ae16df3c5ce9fe02d40be3044b144de5cdc38852daa7b8211"
      ]
    },
    {
      "canonical_locator": "bible:web:1TH:1:8",
      "sequence": 29565,
      "chapter_label": "1TH 1",
      "verse_label": "8",
      "locator": {
        "book": "1TH",
        "chapter": 1,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1TH",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "For from you the word of the Lord has been declared, not only in Macedonia and Achaia, but also in every place your faith toward God has gone out, so that we need not say anything.",
      "ko": "주의 말씀이 너희에게로부터 마게도냐와 아가야에만 들릴 뿐아니라 하나님을 향하는 너희 믿음의 소문이 각처에 퍼진고로 우리는 아무 말도 할것이 없노라",
      "source_text_hash": "0f5b0513b0fc842375b137e7fc72f60f22ca1ea20955e621fc7f1223976acc01",
      "translation_text_hash": "2b53ef58d0086ff30db7c037c15ac734575424ed48db59c5f21ec472a8f2a5d7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 말씀이 너희에게로부터 마게도냐와 아가야에만 들릴 뿐아니라 하나님을 향하는 너희 믿음의 소문이 각처에 퍼진고로 우리는 아무 말도 할것이 없노라"
      ],
      "raw_text_hashes": [
