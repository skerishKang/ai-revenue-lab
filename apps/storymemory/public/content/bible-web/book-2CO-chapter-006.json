      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "영광과 욕됨으로 말미암으며 악한 이름과 아름다운 이름으로 말미암으며 속이는 자 같으나 참되고"
      ],
      "raw_text_hashes": [
        "bc7c61def5c52abe8dc1d9e8ec506997fa12ef2a31254f44caa335a9e9b6592f"
      ]
    },
