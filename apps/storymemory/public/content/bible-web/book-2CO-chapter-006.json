      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 하나님과 함께 일하는 자로서 너희를 권하노니 하나님의 은혜를 헛되이 받지 말라"
      ],
      "raw_text_hashes": [
