      "en": "even as the testimony of Christ was confirmed in you—",
      "ko": "그리스도의 증거가 너희 중에 견고케 되어",
      "source_text_hash": "0bca7302cb724d0ccc5736849ec9d6326fee8d6407c835b07468663a793da385",
      "translation_text_hash": "8dbfa83d062e56d22b45a0754a80b62b4a774c7d5c1e7e7c2f2c79958c814965",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
