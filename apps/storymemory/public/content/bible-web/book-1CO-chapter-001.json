      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님의 뜻을 따라 그리스도 예수의 사도로 부르심을 입은 바울과 및 형제 소스데네는"
      ],
      "raw_text_hashes": [
        "5a476573e3a811af11dfff44ced7ef9a52ef8af291b3b5d74c7a5ed4f0517037"
      ]
