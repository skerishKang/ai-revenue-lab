      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "발람이 아침에 일어나서 자기 나귀에 안장을 지우고 모압 귀족들과 함께 행하니"
      ],
      "raw_text_hashes": [
