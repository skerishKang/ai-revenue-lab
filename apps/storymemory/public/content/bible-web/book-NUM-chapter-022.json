      "translation_text_hash": "df146eb0c59a7bac2b648c6a27eb74ede00b490a2045269e3733dd5f630ec1ec",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "발락이 다시 그들보다 더 높은 귀족들을 더 많이 보내매"
