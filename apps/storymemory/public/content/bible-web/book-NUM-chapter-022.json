        "verse": 12
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 22,
          "verse": 12
        }
      ],
      "en": "God said to Balaam, “You shall not go with them. You shall not curse the people, for they are blessed.”",
      "ko": "하나님이 발람에게 이르시되 너는 그들과 함께 가지도 말고 그 백성을 저주하지도 말라 그들은 복을 받은 자니라",
      "source_text_hash": "3423ce543807b6c4efcfe24f7a31e979ba76659ef71fd217635a898e382a16b6",
      "translation_text_hash": "a06380598e443fc6a88c37ac248ffbd7f1f64b529fbbc838f03e74684dc54783",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이 발람에게 이르시되 너는 그들과 함께 가지도 말고 그 백성을 저주하지도 말라 그들은 복을 받은 자니라"
      ],
      "raw_text_hashes": [
        "a06380598e443fc6a88c37ac248ffbd7f1f64b529fbbc838f03e74684dc54783"
