      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 11,
          "verse": 19
        }
      ],
      "en": "There was not a city that made peace with the children of Israel, except the Hivites, the inhabitants of Gibeon. They took all in battle.",
      "ko": "기브온 거민 히위 사람 외에는 이스라엘 자손과 화친한 성읍이 하나도 없고 다 이스라엘 자손에게 쳐서 취한바 되었으니",
      "source_text_hash": "48b87ede24f866f35a119d6de09426f33d328f84722ecc3164dd6349f5f50e86",
      "translation_text_hash": "b08e63790c02e2b51db85d25e885fd2557400e61b94b6d6bad9c26417f8fe09e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "기브온 거민 히위 사람 외에는 이스라엘 자손과 화친한 성읍이 하나도 없고 다 이스라엘 자손에게 쳐서 취한바 되었으니"
      ],
      "raw_text_hashes": [
