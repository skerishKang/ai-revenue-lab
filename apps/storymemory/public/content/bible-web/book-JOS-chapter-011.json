    {
      "canonical_locator": "bible:web:JOS:11:7",
      "sequence": 6115,
      "chapter_label": "JOS 11",
      "verse_label": "7",
      "locator": {
        "book": "JOS",
        "chapter": 11,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 11,
          "verse": 7
        }
      ],
      "en": "So Joshua came suddenly, with all the warriors, against them by the waters of Merom, and attacked them.",
      "ko": "이에 여호수아가 모든 군사와 함께 메롬 물가로 가서 졸지에 습격할 때에",
      "source_text_hash": "068fc218f8931a94fe7e6f56d83ae95f1987f8a5253411843c8676b5a89931b1",
      "translation_text_hash": "bfe35a0f4074053779a6ea40eadc672269a744d16ec13309edc89fde52509fa9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이에 여호수아가 모든 군사와 함께 메롬 물가로 가서 졸지에 습격할 때에"
      ],
      "raw_text_hashes": [
        "bfe35a0f4074053779a6ea40eadc672269a744d16ec13309edc89fde52509fa9"
      ]
    },
    {
      "canonical_locator": "bible:web:JOS:11:8",
      "sequence": 6116,
      "chapter_label": "JOS 11",
      "verse_label": "8",
      "locator": {
        "book": "JOS",
