      ]
    },
    {
      "canonical_locator": "bible:web:JOS:11:22",
      "sequence": 6130,
      "chapter_label": "JOS 11",
      "verse_label": "22",
      "locator": {
        "book": "JOS",
        "chapter": 11,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 11,
          "verse": 22
        }
      ],
      "en": "There were none of the Anakim left in the land of the children of Israel. Only in Gaza, in Gath, and in Ashdod, did some remain.",
      "ko": "이스라엘 자손의 땅 안에는 아낙 사람이 하나도 남음이 없고 가사와 가드와 아스돗에만 약간 남았었더라",
      "source_text_hash": "874518879c22588d7e5fcb05d0758161af3971886e75849af4f40ef1de60ff2b",
      "translation_text_hash": "5124d345aece057b3e2192020db4c33789f3c1095dd70017de7950ad25e66249",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손의 땅 안에는 아낙 사람이 하나도 남음이 없고 가사와 가드와 아스돗에만 약간 남았었더라"
      ],
      "raw_text_hashes": [
        "5124d345aece057b3e2192020db4c33789f3c1095dd70017de7950ad25e66249"
