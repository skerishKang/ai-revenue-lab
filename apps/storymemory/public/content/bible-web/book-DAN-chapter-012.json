      "raw_locator": [
        {
          "book": "DAN",
          "chapter": 12,
          "verse": 12
        }
      ],
      "en": "Blessed is he who waits, and comes to the one thousand three hundred thirty-five days.",
      "ko": "기다려서 일천 삼백 삼십 오일까지 이르는 그 사람은 복이 있으리라",
      "source_text_hash": "2b66676a720122bf4642d7cf3bfacd2d0849e93829ba1504d96f1ba2afe4e33f",
      "translation_text_hash": "66dc3e1cfd5d6a0ed48babebd96db24985422b645a997c6652f23ca0ed107881",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "기다려서 일천 삼백 삼십 오일까지 이르는 그 사람은 복이 있으리라"
      ],
      "raw_text_hashes": [
        "66dc3e1cfd5d6a0ed48babebd96db24985422b645a997c6652f23ca0ed107881"
      ]
    },
    {
      "canonical_locator": "bible:web:DAN:12:13",
