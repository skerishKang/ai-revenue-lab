        "verse": 11
      },
      "raw_locator": [
        {
          "book": "DAN",
          "chapter": 12,
          "verse": 11
        }
      ],
      "en": "“From the time that the continual burnt offering is taken away and the abomination that makes desolate set up, there will be one thousand two hundred ninety days.",
      "ko": "매일 드리는 제사를 폐하며 멸망케 할 미운 물건을 세울 때부터 일천 이백 구십일을 지낼 것이요",
      "source_text_hash": "6391f1b53cb50f90c185e4f00d152532fcd4e9f474d41696153253b50c61d19d",
      "translation_text_hash": "02e33d5c4c3ada18af090784ee751df2f8473aae3cfd8f2e2dce5cabbdf32f35",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "매일 드리는 제사를 폐하며 멸망케 할 미운 물건을 세울 때부터 일천 이백 구십일을 지낼 것이요"
      ],
      "raw_text_hashes": [
        "02e33d5c4c3ada18af090784ee751df2f8473aae3cfd8f2e2dce5cabbdf32f35"
      ]
