      "raw_locator": [
        {
          "book": "DAN",
          "chapter": 12,
          "verse": 13
        }
      ],
      "en": "“But go your way until the end; for you will rest, and will stand in your inheritance at the end of the days.”",
      "ko": "너는 가서 마지막을 기다리라 이는 네가 평안히 쉬다가 끝날에는 네 업을 누릴 것임이니라",
      "source_text_hash": "2d1bb8b3dada8c7966ec36d170ca3fa30b0809ba8801cb635495dd54961e2d07",
      "translation_text_hash": "5906a9c6b6f2df4b79e2b9e20c312327c904e7eefaf0d193df33ad47eef857f4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
