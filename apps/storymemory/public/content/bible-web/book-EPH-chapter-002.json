      "source_text_hash": "60ce8c4724e04ada81a70afb31704671a138ad05df6ebbfbae470c5610d8b943",
      "translation_text_hash": "2e5b1d6712c00ab66fca61d28f68eacaa1bf320fb4a1bfbe6c1325cc02176699",
      "translation_policy": "krv-1961-source-mapped",
