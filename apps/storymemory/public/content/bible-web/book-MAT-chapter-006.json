      "raw_locator": [
        {
          "book": "MAT",
          "chapter": 6,
          "verse": 6
        }
      ],
      "en": "But you, when you pray, enter into your inner room, and having shut your door, pray to your Father who is in secret; and your Father who sees in secret will reward you openly.",
      "ko": "너는 기도할 때에 네 골방에 들어가 문을 닫고 은밀한 중에 계신 네 아버지께 기도하라 은밀한 중에 보시는 네 아버지께서 갚으시리라",
      "source_text_hash": "e4a1870a6802ee5f48471366352e8da291bd931be43eb64550eb20e2e9fc0b56",
      "translation_text_hash": "cc0c433e3d13f7dbc09547284145ccd8f9ac9abb61552a178189f4b32d5e3168",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 기도할 때에 네 골방에 들어가 문을 닫고 은밀한 중에 계신 네 아버지께 기도하라 은밀한 중에 보시는 네 아버지께서 갚으시리라"
      ],
      "raw_text_hashes": [
        "cc0c433e3d13f7dbc09547284145ccd8f9ac9abb61552a178189f4b32d5e3168"
      ]
