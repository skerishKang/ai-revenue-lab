        "verse": 3
      },
      "raw_locator": [
        {
          "book": "MAT",
          "chapter": 6,
          "verse": 3
        }
      ],
      "en": "But when you do merciful deeds, don’t let your left hand know what your right hand does,",
      "ko": "너는 구제할 때에 오른손의 하는 것을 왼손이 모르게 하여",
      "source_text_hash": "fa87c17a1c1aaef22eb426eeaa53ccc603c2f64de521110842047d716eba7276",
      "translation_text_hash": "b6de3de779c75461d864271db3fcd56beb86e32cb93319bfaf107fb62464b4aa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 구제할 때에 오른손의 하는 것을 왼손이 모르게 하여"
      ],
      "raw_text_hashes": [
        "b6de3de779c75461d864271db3fcd56beb86e32cb93319bfaf107fb62464b4aa"
      ]
    },
    {
      "canonical_locator": "bible:web:MAT:6:4",
