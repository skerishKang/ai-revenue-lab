      "source_text_hash": "41b83f5ceab2797726c7a84c59ce87116f0b89c1a6d18cf8927408c70bf1bf99",
      "translation_text_hash": "c2c954f8e266c60a52d5b4b926f396d578c984bfc964ee3714aa5449a424714b",
      "translation_policy": "krv-1961-source-mapped",
