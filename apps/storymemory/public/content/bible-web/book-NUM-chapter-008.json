      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손 중에서 레위인을 취하여 정결케 하라"
      ],
      "raw_text_hashes": [
        "b53ad2cd4c9f0c61df8c004bd4f3b9809610eef978fc42c77384f52a3e0c0f2e"
