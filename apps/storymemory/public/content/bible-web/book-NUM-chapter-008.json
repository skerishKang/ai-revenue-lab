    {
      "canonical_locator": "bible:web:NUM:8:16",
      "sequence": 3956,
      "chapter_label": "NUM 8",
      "verse_label": "16",
      "locator": {
        "book": "NUM",
        "chapter": 8,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 8,
          "verse": 16
        }
      ],
      "en": "For they are wholly given to me from among the children of Israel; instead of all who open the womb, even the firstborn of all the children of Israel, I have taken them to me.",
      "ko": "그들은 이스라엘 자손 중에서 내게 온전히 드린바 된 자라 이스라엘 자손 중 일절 초태생 곧 모든 처음 난 자의 대신으로 내가 그들을 취하였나니",
      "source_text_hash": "7fe75c797193ddfe9ad0610517f1809c33515250e7e99f398bbd3aa47c296d2f",
      "translation_text_hash": "22eebb6c9865bd23cd1af08988201148f3d0677638d70b24189c8e77cfe5b0c3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들은 이스라엘 자손 중에서 내게 온전히 드린바 된 자라 이스라엘 자손 중 일절 초태생 곧 모든 처음 난 자의 대신으로 내가 그들을 취하였나니"
