      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "백성들아 시시로 저를 의지하고 그 앞에 마음을 토하라 하나님은 우리의 피난처시로다(셀라)"
      ],
      "raw_text_hashes": [
