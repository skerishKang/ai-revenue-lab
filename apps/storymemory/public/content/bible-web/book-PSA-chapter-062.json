      "translation_text_hash": "71a1a5ef56b268dab05f7605b04f957536569188d52f29a8cbc3d2b7bded4687",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 영혼이 잠잠히 하나님만 바람이여 나의 구원이 그에게서 나는도다"
      ],
      "raw_text_hashes": [
        "71a1a5ef56b268dab05f7605b04f957536569188d52f29a8cbc3d2b7bded4687"
      ]
