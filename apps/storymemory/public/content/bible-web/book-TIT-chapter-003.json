      "raw_locator": [
        {
          "book": "TIT",
          "chapter": 3,
          "verse": 10
        }
      ],
      "en": "Avoid a factious man after a first and second warning,",
      "ko": "이단에 속한 사람을 한두번 훈계한 후에 멀리 하라",
      "source_text_hash": "43b1706020dc72be97e8d5fa8b0e7b9a333ccf669ae56f46d59a79a0bdc77aa7",
      "translation_text_hash": "af1e417ce0fe765e095b6aa0ca8e899afe3024a5cd309138659bd7f0d21220df",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
