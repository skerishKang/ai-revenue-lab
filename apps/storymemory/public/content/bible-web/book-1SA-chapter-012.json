      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 12,
          "verse": 14
        }
      ],
      "en": "If you will fear the LORD, and serve him, and listen to his voice, and not rebel against the commandment of the LORD, then both you and also the king who reigns over you are followers of the LORD your God.",
      "ko": "너희가 만일 여호와를 경외하여 그를 섬기며 그 목소리를 듣고 여호와의 명령을 거역하지 아니하며 또 너희와 너희를 다스리는 왕이 너희 하나님 여호와를 좇으면 좋으니라마는",
      "source_text_hash": "28b40c7b25ec7d3ff2ed49c02e67e70e7431c97f66baa8587dfaab90c92fb5ac",
      "translation_text_hash": "6b51a0cacdf696a2031970deaca501d8a48fbe1b01c308800c1ef04b8ce0cd2d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
