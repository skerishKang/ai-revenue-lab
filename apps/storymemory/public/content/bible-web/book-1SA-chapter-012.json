        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 12,
          "verse": 8
        }
      ],
      "en": "“When Jacob had come into Egypt, and your fathers cried to the LORD, then the LORD sent Moses and Aaron, who brought your fathers out of Egypt, and made them to dwell in this place.",
      "ko": "야곱이 애굽에 들어간 후 너희 열조가 여호와께 부르짖으매 여호와께서 모세와 아론을 보내사 그 두 사람으로 너희 열조를 애굽에서 인도하여 내어 이곳에 거하게 하셨으나",
      "source_text_hash": "056bf816ee8a66eac458f98d712a95589cc9eedb2eb1adb4fd62ae773fc8f9e7",
      "translation_text_hash": "c1eec4263bfc8bcc26d50e76b6ec5d04a4045ad61db6a37231bb6a63766823ee",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "야곱이 애굽에 들어간 후 너희 열조가 여호와께 부르짖으매 여호와께서 모세와 아론을 보내사 그 두 사람으로 너희 열조를 애굽에서 인도하여 내어 이곳에 거하게 하셨으나"
      ],
      "raw_text_hashes": [
        "c1eec4263bfc8bcc26d50e76b6ec5d04a4045ad61db6a37231bb6a63766823ee"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:12:9",
      "sequence": 7470,
      "chapter_label": "1SA 12",
      "verse_label": "9",
      "locator": {
        "book": "1SA",
        "chapter": 12,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 12,
          "verse": 9
        }
      ],
      "en": "But they forgot the LORD their God; and he sold them into the hand of Sisera, captain of the army of Hazor, and into the hand of the Philistines, and into the hand of the king of Moab; and they fought against them.",
      "ko": "그들이 그 하나님 여호와를 잊은지라 여호와께서 그들을 하솔 군장 시스라의 손과 블레셋 사람의 손과 모압 왕의 손에 붙이셨더니 그들이 치매",
      "source_text_hash": "c59a4f8d8105f913e2a3c41a562bc0c45f974c3dc9e7d6c1b2ed3b3bf8d85600",
      "translation_text_hash": "b73dba506cf79da832e9e78836100770283114e4bfd7445d669e51b247eddf10",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들이 그 하나님 여호와를 잊은지라 여호와께서 그들을 하솔 군장 시스라의 손과 블레셋 사람의 손과 모압 왕의 손에 붙이셨더니 그들이 치매"
      ],
      "raw_text_hashes": [
        "b73dba506cf79da832e9e78836100770283114e4bfd7445d669e51b247eddf10"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:12:10",
      "sequence": 7471,
      "chapter_label": "1SA 12",
      "verse_label": "10",
      "locator": {
        "book": "1SA",
        "chapter": 12,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 12,
          "verse": 10
        }
      ],
      "en": "They cried to the LORD, and said, ‘We have sinned, because we have forsaken the LORD and have served the Baals and the Ashtaroth; but now deliver us out of the hand of our enemies, and we will serve you.’",
      "ko": "백성이 여호와께 부르짖어 가로되 우리가 여호와를 버리고 바알들과 아스다롯을 섬기므로 범죄하였나이다 그러하오나 이제 우리를 원수들의 손에서 건져내소서 그리하시면 우리가 주를 섬기겠나이다 하매",
      "source_text_hash": "1ea27215cb8091f35cce619f62c5ed24b9eda645eaf1e91b0d1446f3fe6aa9f0",
      "translation_text_hash": "7bf4b946b8cf1899dae59533b5ef37c92514d40c31e8fd94ec0ac60be6ce20ee",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "백성이 여호와께 부르짖어 가로되 우리가 여호와를 버리고 바알들과 아스다롯을 섬기므로 범죄하였나이다 그러하오나 이제 우리를 원수들의 손에서 건져내소서 그리하시면 우리가 주를 섬기겠나이다 하매"
      ],
      "raw_text_hashes": [
        "7bf4b946b8cf1899dae59533b5ef37c92514d40c31e8fd94ec0ac60be6ce20ee"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:12:11",
      "sequence": 7472,
      "chapter_label": "1SA 12",
      "verse_label": "11",
      "locator": {
        "book": "1SA",
        "chapter": 12,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 12,
          "verse": 11
        }
      ],
      "en": "The LORD sent Jerubbaal, Bedan, Jephthah, and Samuel, and delivered you out of the hand of your enemies on every side; and you lived in safety.",
      "ko": "여호와께서 여룹바알과 베단과 입다와 나 사무엘을 보내사 너희를 너희 사방 원수의 손에서 건져내사 너희로 안전히 거하게 하셨거늘",
      "source_text_hash": "11371b0731438301107f56ed584ecaeaa56a200e2263b5bef0ffbb0d6275ef51",
      "translation_text_hash": "a7a529d459e2e7357d67eb42659846d3f6f7b3e57b9a78cf1d0368baebd89fa9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 여룹바알과 베단과 입다와 나 사무엘을 보내사 너희를 너희 사방 원수의 손에서 건져내사 너희로 안전히 거하게 하셨거늘"
      ],
      "raw_text_hashes": [
