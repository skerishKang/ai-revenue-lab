      ]
    },
    {
      "canonical_locator": "bible:web:1SA:12:12",
      "sequence": 7473,
      "chapter_label": "1SA 12",
      "verse_label": "12",
      "locator": {
        "book": "1SA",
        "chapter": 12,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 12,
          "verse": 12
        }
      ],
      "en": "“When you saw that Nahash the king of the children of Ammon came against you, you said to me, ‘No, but a king shall reign over us,’ when the LORD your God was your king.",
      "ko": "너희가 암몬 자손의 왕 나하스의 너희를 치러 옴을 보고 너희 하나님 여호와께서는 너희의 왕이 되실찌라도 너희가 내게 이르기를 아니라 우리를 다스릴 왕이 있어야 하겠다 하였도다",
      "source_text_hash": "d26d05fe40e2bd683fadfa60c179ee87f333610db977f356afc3d95300eb297e",
      "translation_text_hash": "b6efee7929a5d16538fb590815f3e5181a8054552a46470e1549d8dafe2f4323",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
