      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 이름에 합당한 영광을 돌리며 거룩한 옷을 입고 여호와께 경배할찌어다"
      ],
      "raw_text_hashes": [
