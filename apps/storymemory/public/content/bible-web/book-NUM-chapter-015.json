      "raw_texts": [
        "이스라엘 자손에게 명하여 그들의 대대로 그 옷단 귀에 술을 만들고 청색 끈을 그 귀의 술에 더하라"
      ],
      "raw_text_hashes": [
        "2425455f3bfe79240eb3dc384d51df5d41f3820aeaa9ba61b3954452a54ff8c5"
      ]
    },
