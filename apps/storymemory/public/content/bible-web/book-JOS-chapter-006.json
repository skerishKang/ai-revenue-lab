      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 6,
          "verse": 3
        }
      ],
      "en": "All of your men of war shall march around the city, going around the city once. You shall do this six days.",
      "ko": "너희 모든 군사는 성을 둘러 성 주위를 매일 한번씩 돌되 엿새 동안을 그리하라",
      "source_text_hash": "ebac76be354cd604039e38c732253aa473c699a2e0961fd01aba84acb64dcdc5",
      "translation_text_hash": "2e1df0d7d059a3ea00b370c99b07fe716050e0e89aaf5e90946b80f49bfa9513",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 모든 군사는 성을 둘러 성 주위를 매일 한번씩 돌되 엿새 동안을 그리하라"
      ],
      "raw_text_hashes": [
        "2e1df0d7d059a3ea00b370c99b07fe716050e0e89aaf5e90946b80f49bfa9513"
      ]
