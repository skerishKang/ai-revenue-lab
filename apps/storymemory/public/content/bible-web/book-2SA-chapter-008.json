        "verse": 7
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 8,
          "verse": 7
        }
      ],
      "en": "David took the shields of gold that were on the servants of Hadadezer, and brought them to Jerusalem.",
      "ko": "다윗이 하닷에셀의 신복들의 가진 금방패를 빼앗아 예루살렘으로 가져오고",
      "source_text_hash": "36e0323def8533d8b633c5c82c27ea1dc68efe6d801babc12e58d707f05e845d",
      "translation_text_hash": "d860a568dc9881ef2b7afe685465da1063498bfad050f7bf63414acd65a8559c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 하닷에셀의 신복들의 가진 금방패를 빼앗아 예루살렘으로 가져오고"
      ],
      "raw_text_hashes": [
        "d860a568dc9881ef2b7afe685465da1063498bfad050f7bf63414acd65a8559c"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:8:8",
      "sequence": 8218,
      "chapter_label": "2SA 8",
      "verse_label": "8",
      "locator": {
