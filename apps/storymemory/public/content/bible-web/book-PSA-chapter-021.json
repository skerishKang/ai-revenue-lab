      "translation_text_hash": "0906c3f2be2691c5d80e380604a6fece56305097a157c7eb8042f6c5acaa714b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 생명을 구하매 주께서 주셨으니 곧 영영한 장수로소이다"
      ],
      "raw_text_hashes": [
        "0906c3f2be2691c5d80e380604a6fece56305097a157c7eb8042f6c5acaa714b"
      ]
    },
