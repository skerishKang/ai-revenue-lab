      ],
      "en": "Give ear to my words, LORD. Consider my meditation.",
      "ko": "여호와여 나의 말에 귀를 기울이사 나의 심사를 통촉하소서",
      "source_text_hash": "b01217c9a74e2789a5512f0ca5b59058883e13f18967b919ad3c12b932d0e7c1",
      "translation_text_hash": "2caac12886f869d8bac53e4bb8184752d5c0c815896e7101251928fcd8cb57ae",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나의 말에 귀를 기울이사 나의 심사를 통촉하소서"
      ],
      "raw_text_hashes": [
        "2caac12886f869d8bac53e4bb8184752d5c0c815896e7101251928fcd8cb57ae"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:2",
      "sequence": 13976,
      "chapter_label": "PSA 5",
