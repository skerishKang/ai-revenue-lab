        "chapter": 5,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 4
        }
      ],
      "en": "For you are not a God who has pleasure in wickedness. Evil can’t live with you.",
      "ko": "주는 죄악을 기뻐하는 신이 아니시니 악이 주와 함께 유하지 못하며",
      "source_text_hash": "de3c017efbff4739eae2b13272afb608e6c6a26436ef575b815bca726290c454",
      "translation_text_hash": "111d33a34b9cae89be7fb3a53c7a1d36c267d919b50fc1e7e4ad0cc73c1c4059",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주는 죄악을 기뻐하는 신이 아니시니 악이 주와 함께 유하지 못하며"
      ],
      "raw_text_hashes": [
        "111d33a34b9cae89be7fb3a53c7a1d36c267d919b50fc1e7e4ad0cc73c1c4059"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:5",
      "sequence": 13979,
      "chapter_label": "PSA 5",
      "verse_label": "5",
      "locator": {
        "book": "PSA",
