        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 5
        }
      ],
      "en": "The arrogant will not stand in your sight. You hate all workers of iniquity.",
      "ko": "오만한 자가 주의 목전에 서지 못하리이다 주는 모든 행악자를 미워하시며",
      "source_text_hash": "5f7c2ed95ff850b20633ce985c4de6568fd3e059845afd888446bf79d05c1d57",
      "translation_text_hash": "130ac52e59159ac5ce40e8769dc13c48f92c8fe2e5dc584385bb678c91127756",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오만한 자가 주의 목전에 서지 못하리이다 주는 모든 행악자를 미워하시며"
      ],
      "raw_text_hashes": [
        "130ac52e59159ac5ce40e8769dc13c48f92c8fe2e5dc584385bb678c91127756"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:6",
      "sequence": 13980,
      "chapter_label": "PSA 5",
      "verse_label": "6",
      "locator": {
        "book": "PSA",
        "chapter": 5,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 6
        }
      ],
      "en": "You will destroy those who speak lies. The LORD abhors the bloodthirsty and deceitful man.",
      "ko": "거짓말하는 자를 멸하시리이다 여호와께서는 피 흘리기를 즐기고 속이는 자를 싫어하시나이다",
      "source_text_hash": "932bd7cbc6be3c7bdb873d696f8493a2625022252fcda9b34c00a4f1a8c2e866",
      "translation_text_hash": "2ef3c255b0eb3a1b4e6b0627a477ae17704c336bb541d9e1d12b624ddd095cd6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "거짓말하는 자를 멸하시리이다 여호와께서는 피 흘리기를 즐기고 속이는 자를 싫어하시나이다"
      ],
      "raw_text_hashes": [
        "2ef3c255b0eb3a1b4e6b0627a477ae17704c336bb541d9e1d12b624ddd095cd6"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:7",
      "sequence": 13981,
      "chapter_label": "PSA 5",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 5,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 7
        }
      ],
      "en": "But as for me, in the abundance of your loving kindness I will come into your house. I will bow toward your holy temple in reverence of you.",
      "ko": "오직 나는 주의 풍성한 인자를 힘입어 주의 집에 들어가 주를 경외함으로 성전을 향하여 경배하리이다",
      "source_text_hash": "997b7257c2f250a010899cd05c1393aa6034615b776f245f7f513ad0357b756e",
      "translation_text_hash": "1ea0b1c5e6efe337106fb19e2771d9b44032d7f0ec9831854df6f77c2a58a94c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 나는 주의 풍성한 인자를 힘입어 주의 집에 들어가 주를 경외함으로 성전을 향하여 경배하리이다"
      ],
      "raw_text_hashes": [
        "1ea0b1c5e6efe337106fb19e2771d9b44032d7f0ec9831854df6f77c2a58a94c"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:8",
      "sequence": 13982,
      "chapter_label": "PSA 5",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
        "chapter": 5,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 8
        }
      ],
      "en": "Lead me, LORD, in your righteousness because of my enemies. Make your way straight before my face.",
      "ko": "여호와여 나의 원수들을 인하여 주의 의로 나를 인도하시고 주의 길을 내 목전에 곧게 하소서",
      "source_text_hash": "5e085bbecdac9ae0b90a411cc8a8ac0173cf45e11465a1aa23dd00890b9cfff7",
      "translation_text_hash": "b60d6887d3809e01f2e21035d1c7abbe3f1866c6b9fd2a779081d7c626eea9c9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나의 원수들을 인하여 주의 의로 나를 인도하시고 주의 길을 내 목전에 곧게 하소서"
      ],
      "raw_text_hashes": [
        "b60d6887d3809e01f2e21035d1c7abbe3f1866c6b9fd2a779081d7c626eea9c9"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:9",
      "sequence": 13983,
      "chapter_label": "PSA 5",
      "verse_label": "9",
      "locator": {
        "book": "PSA",
        "chapter": 5,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 9
        }
      ],
      "en": "For there is no faithfulness in their mouth. Their heart is destruction. Their throat is an open tomb. They flatter with their tongue.",
      "ko": "저희 입에 신실함이 없고 저희 심중이 심히 악하며 저희 목구멍은 열린 무덤 같고 저희 혀로는 아첨하나이다",
      "source_text_hash": "1fac94c2add07ac9796e400875f0fddc025524bc58914bd98d16f6778c78d016",
      "translation_text_hash": "19148e56228248e468b62498423688290cf104ef5b39140cfe81cdd09725e885",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희 입에 신실함이 없고 저희 심중이 심히 악하며 저희 목구멍은 열린 무덤 같고 저희 혀로는 아첨하나이다"
      ],
      "raw_text_hashes": [
        "19148e56228248e468b62498423688290cf104ef5b39140cfe81cdd09725e885"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:10",
      "sequence": 13984,
      "chapter_label": "PSA 5",
      "verse_label": "10",
      "locator": {
        "book": "PSA",
        "chapter": 5,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 10
        }
      ],
      "en": "Hold them guilty, God. Let them fall by their own counsels. Thrust them out in the multitude of their transgressions, for they have rebelled against you.",
      "ko": "하나님이여 저희를 정죄하사 자기 꾀에 빠지게 하시고 그 많은 허물로 인하여 저희를 쫓아내소서 저희가 주를 배역함이니이다",
      "source_text_hash": "af93080995c4076f98bf6144036166d9eee469ad4f228710cb6b9a1dc760889b",
      "translation_text_hash": "7213e005b1f447d98339aedc815ee1f98dda487de7da882f48ebf944c1b84eea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 저희를 정죄하사 자기 꾀에 빠지게 하시고 그 많은 허물로 인하여 저희를 쫓아내소서 저희가 주를 배역함이니이다"
      ],
      "raw_text_hashes": [
        "7213e005b1f447d98339aedc815ee1f98dda487de7da882f48ebf944c1b84eea"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:11",
      "sequence": 13985,
      "chapter_label": "PSA 5",
      "verse_label": "11",
      "locator": {
        "book": "PSA",
        "chapter": 5,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 11
        }
      ],
      "en": "But let all those who take refuge in you rejoice. Let them always shout for joy, because you defend them. Let them also who love your name be joyful in you.",
      "ko": "오직 주에게 피하는 자는 다 기뻐하며 주의 보호로 인하여 영영히 기뻐 외치며 주의 이름을 사랑하는 자들은 주를 즐거워하리이다",
      "source_text_hash": "a1a0b729a53fe5c402adf900dd52792df659a1f06b8c8545cc2c565f40f46626",
      "translation_text_hash": "8b875fadfdd35b4a094bae6886c733a419c037847ab3e4464e84939ca6fce14b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 주에게 피하는 자는 다 기뻐하며 주의 보호로 인하여 영영히 기뻐 외치며 주의 이름을 사랑하는 자들은 주를 즐거워하리이다"
      ],
      "raw_text_hashes": [
        "8b875fadfdd35b4a094bae6886c733a419c037847ab3e4464e84939ca6fce14b"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:5:12",
      "sequence": 13986,
      "chapter_label": "PSA 5",
      "verse_label": "12",
      "locator": {
        "book": "PSA",
        "chapter": 5,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 5,
          "verse": 12
        }
      ],
      "en": "For you will bless the righteous. LORD, you will surround him with favor as with a shield.",
      "ko": "여호와여 주는 의인에게 복을 주시고 방패로 함 같이 은혜로 저를 호위하시리이다",
      "source_text_hash": "0f729a084b97d30bb044c21fe238d76b2f8b83f519177c4551ceef62f6accbcb",
      "translation_text_hash": "1d3339164009c8de6b290317f0898cfbee9f591b53f1bd3179f03c59cb8224f7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주는 의인에게 복을 주시고 방패로 함 같이 은혜로 저를 호위하시리이다"
      ],
      "raw_text_hashes": [
        "1d3339164009c8de6b290317f0898cfbee9f591b53f1bd3179f03c59cb8224f7"
      ]
    }
  ]
