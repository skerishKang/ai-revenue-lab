      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "많은 사람에게 붙었던 더러운 귀신들이 크게 소리를 지르며 나가고 또 많은 중풍병자와 앉은뱅이가 나으니"
      ],
      "raw_text_hashes": [
        "cb66e61181c79710f6ccc7739386dd022b9f9222c3790cd650e4f3c62d08b41e"
      ]
