        "verse": 11
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 2,
          "verse": 11
        }
      ],
      "en": "Has a nation changed its gods, which really are no gods? But my people have changed their glory for that which doesn’t profit.",
      "ko": "어느 나라가 그 신을 신 아닌 것과 바꾼 일이 있느냐 그러나 나의 백성은 그 영광을 무익한 것과 바꾸었도다",
      "source_text_hash": "b01e6aae2e6e56a2c1ecba6fd931e0efa9826e5458a92b839de7c4364f83f3d8",
      "translation_text_hash": "88ab1066e2d4a94bb83564201aa4aa767a315955edcba0908a85524c5848e971",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어느 나라가 그 신을 신 아닌 것과 바꾼 일이 있느냐 그러나 나의 백성은 그 영광을 무익한 것과 바꾸었도다"
      ],
      "raw_text_hashes": [
        "88ab1066e2d4a94bb83564201aa4aa767a315955edcba0908a85524c5848e971"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:2:12",
      "sequence": 18978,
