      "translation_text_hash": "92400c00a8a840356fc38ae6f3c16fdc4a42bb200aeadb8204e7b38724c2e695",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
