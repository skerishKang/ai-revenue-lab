      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희는 굽어 엎드러지고 우리는 일어나 바로 서도다"
      ],
      "raw_text_hashes": [
        "52cfdb7fde2c95c1373be44ef610c142dfa7ded4a3c8e45e82d5dd2052dacc87"
      ]
    },
