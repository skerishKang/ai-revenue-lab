        "verse": 2
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 20,
          "verse": 2
        }
      ],
      "en": "send you help from the sanctuary, grant you support from Zion,",
      "ko": "성소에서 너를 도와주시고 시온에서 너를 붙드시며",
      "source_text_hash": "331b6a4e23a2c32f66b1410e6c3a7dbee9de79cc9c612747ccef8a9b86e7db23",
      "translation_text_hash": "cba9b5edc1eefcd52dfb4f8b0e69090443b41a2148fc786aaa2c1a6fb2559db5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "성소에서 너를 도와주시고 시온에서 너를 붙드시며"
      ],
      "raw_text_hashes": [
        "cba9b5edc1eefcd52dfb4f8b0e69090443b41a2148fc786aaa2c1a6fb2559db5"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:20:3",
      "sequence": 14186,
