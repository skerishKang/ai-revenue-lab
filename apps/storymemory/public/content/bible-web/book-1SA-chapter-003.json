          "chapter": 3,
          "verse": 12
        }
      ],
      "en": "In that day I will perform against Eli all that I have spoken concerning his house, from the beginning even to the end.",
      "ko": "내가 엘리의 집에 대하여 말한 것을 처음부터 끝까지 그 날에 그에게 다 이루리라",
      "source_text_hash": "a4fd34a6084ef71b11223dd09d2f62bae41ba5d15863764395dab55e683459ca",
      "translation_text_hash": "de9a765ace9d054310a3f796fc6d7ad2b49136b4980ce10bc75bac7fd560adf0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 엘리의 집에 대하여 말한 것을 처음부터 끝까지 그 날에 그에게 다 이루리라"
      ],
      "raw_text_hashes": [
        "de9a765ace9d054310a3f796fc6d7ad2b49136b4980ce10bc75bac7fd560adf0"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:3:13",
      "sequence": 7290,
      "chapter_label": "1SA 3",
      "verse_label": "13",
      "locator": {
        "book": "1SA",
