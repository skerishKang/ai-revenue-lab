    {
      "canonical_locator": "bible:web:MIC:1:8",
      "sequence": 22588,
      "chapter_label": "MIC 1",
      "verse_label": "8",
      "locator": {
        "book": "MIC",
        "chapter": 1,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "MIC",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "For this I will lament and wail. I will go stripped and naked. I will howl like the jackals and mourn like the ostriches.",
      "ko": "이러므로 내가 애통하며 애곡하고 벌거벗은 몸으로 행하며 들개 같이 애곡하고 타조 같이 애통하리니",
      "source_text_hash": "e3829576e308953c9eefff143cf66f2ab53eec0783ba282e9b5fbdec315a0e98",
      "translation_text_hash": "56e9505ea8a8084797d3601b3997e94ebc8b8917f730cf92ad5eb48985b18179",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이러므로 내가 애통하며 애곡하고 벌거벗은 몸으로 행하며 들개 같이 애곡하고 타조 같이 애통하리니"
      ],
      "raw_text_hashes": [
        "56e9505ea8a8084797d3601b3997e94ebc8b8917f730cf92ad5eb48985b18179"
      ]
    },
    {
      "canonical_locator": "bible:web:MIC:1:9",
      "sequence": 22589,
      "chapter_label": "MIC 1",
      "verse_label": "9",
      "locator": {
        "book": "MIC",
        "chapter": 1,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "MIC",
          "chapter": 1,
          "verse": 9
        }
      ],
      "en": "For her wounds are incurable; for it has come even to Judah. It reaches to the gate of my people, even to Jerusalem.",
      "ko": "이는 그 상처는 고칠 수 없고 그것이 유다까지도 이르고 내 백성의 성문 곧 예루살렘에도 미쳤음이니라",
      "source_text_hash": "5e6e5ab329cc6cf4d0c74bb641a46e917cd33ad6b39d083fb4154713c3eba5bf",
      "translation_text_hash": "51b5f43c31bc2a9beae301d0fbfd2ecb8dbb32c5d5c0a59c944a63a6fd20193d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 그 상처는 고칠 수 없고 그것이 유다까지도 이르고 내 백성의 성문 곧 예루살렘에도 미쳤음이니라"
      ],
      "raw_text_hashes": [
        "51b5f43c31bc2a9beae301d0fbfd2ecb8dbb32c5d5c0a59c944a63a6fd20193d"
      ]
    },
    {
      "canonical_locator": "bible:web:MIC:1:10",
      "sequence": 22590,
      "chapter_label": "MIC 1",
      "verse_label": "10",
      "locator": {
