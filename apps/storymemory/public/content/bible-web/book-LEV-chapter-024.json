      "mapping_note": null,
      "raw_texts": [
        "그들이 그를 가두고 여호와의 명령을 기다리더니"
      ],
      "raw_text_hashes": [
        "a3324471903027a8ab3f0693eafa09833c18d2b5a19e61e00e736112c8105226"
