      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 모세에게 일러 가라사대"
      ],
      "raw_text_hashes": [
        "1213bc72e4be9e9f17f4b9129e3f0d4cbde2d4cf24000ea629c6671d78ca8075"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:24:2",
      "sequence": 3449,
      "chapter_label": "LEV 24",
      "verse_label": "2",
      "locator": {
        "book": "LEV",
