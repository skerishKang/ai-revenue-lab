      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "위임식은 칠일 동안 행하나니 위임식이 마치는 날까지 칠일 동안은 회막문에 나가지 말라"
      ],
      "raw_text_hashes": [
