      ],
      "raw_text_hashes": [
        "61deec6e52d3e4ebb5f33c68a9ec9e8d37b91b18043a52a62ca25eb4ac1b7486"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:8:7",
