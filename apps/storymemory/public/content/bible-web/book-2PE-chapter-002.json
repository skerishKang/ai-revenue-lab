      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "더 큰 힘과 능력을 가진 천사들이라도 주 앞에서 저희를 거스려 훼방하는 송사를 하지 아니하느니라"
      ],
      "raw_text_hashes": [
        "5426c6cc062bfab64143953aeb8ab1ae0bb9a4f89140defe7646442114b81c74"
