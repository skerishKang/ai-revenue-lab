      "raw_text_hashes": [
        "fc2f8ba5c997395838d96be6fe6a4e5d95c7eae61543e1faed944498cc97f543"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:34:7",
      "sequence": 988,
      "chapter_label": "GEN 34",
