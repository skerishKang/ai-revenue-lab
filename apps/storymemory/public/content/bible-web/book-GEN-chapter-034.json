      "raw_texts": [
        "그 아비 하몰에게 청하여 가로되 이 소녀를 내 아내로 얻게 하여 주소서 하였더라"
      ],
      "raw_text_hashes": [
        "38935bdab91d75725e64e951cd45efb01d705b9233bbe39e4e1217eebc8d3204"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:34:5",
      "sequence": 986,
      "chapter_label": "GEN 34",
