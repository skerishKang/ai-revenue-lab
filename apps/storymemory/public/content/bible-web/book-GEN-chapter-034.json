      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "레아가 야곱에게 낳은 딸 디나가 그 땅 여자를 보러 나갔더니"
      ],
      "raw_text_hashes": [
        "9f8733c0dd58cdfbdb46ecd25ad547400659961166b06b1e4d75298ecd7e867f"
      ]
    },
    {
