      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 34,
          "verse": 6
        }
      ],
      "en": "Hamor the father of Shechem went out to Jacob to talk with him.",
      "ko": "세겜의 아비 하몰은 야곱에게 말하러 왔으며",
      "source_text_hash": "ba6f19d8bd89c522f6c044e19c342a51da996b09ab74b6f4a242aeed346d8a47",
      "translation_text_hash": "fc2f8ba5c997395838d96be6fe6a4e5d95c7eae61543e1faed944498cc97f543",
      "translation_policy": "krv-1961-source-mapped",
