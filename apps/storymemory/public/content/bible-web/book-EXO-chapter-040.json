        "verse": 2
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 2
        }
      ],
      "en": "“On the first day of the first month you shall raise up the tabernacle of the Tent of Meeting.",
      "ko": "너는 정월 초일일에 성막 곧 회막을 세우고",
      "source_text_hash": "8d1015c215dad0c4dc61b91bf9eaa893401cb0015cab2bc12515b0e3b43f2d80",
      "translation_text_hash": "3b7a02cbdd90e47cb27811df02f32c7cca09b668488c8994b0825c52ed78791f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 정월 초일일에 성막 곧 회막을 세우고"
      ],
      "raw_text_hashes": [
        "3b7a02cbdd90e47cb27811df02f32c7cca09b668488c8994b0825c52ed78791f"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:3",
      "sequence": 2711,
      "chapter_label": "EXO 40",
      "verse_label": "3",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 3
        }
      ],
      "en": "You shall put the ark of the covenant in it, and you shall screen the ark with the veil.",
      "ko": "또 증거궤를 들여 놓고 또 장으로 그 궤를 가리우고",
      "source_text_hash": "6f249f50ca2bd4f516334bf2d327da33f146593679774344fc91dd24b13a76c6",
      "translation_text_hash": "9debbab38163e7a81af2586b60a851c67bca7518df6be03bd31092bc990588fc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 증거궤를 들여 놓고 또 장으로 그 궤를 가리우고"
      ],
      "raw_text_hashes": [
        "9debbab38163e7a81af2586b60a851c67bca7518df6be03bd31092bc990588fc"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:4",
      "sequence": 2712,
      "chapter_label": "EXO 40",
      "verse_label": "4",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 4
        }
      ],
      "en": "You shall bring in the table, and set in order the things that are on it. You shall bring in the lamp stand, and light its lamps.",
      "ko": "또 상을 들여 놓고 그 위에 물품을 진설하고 등대를 들여 놓고 불을 켜고",
      "source_text_hash": "e9d0fd64696d92b16d1f750ffecd1a57140e1a2a67ca386d9541e8d254565ce4",
      "translation_text_hash": "27d5a6a5edb176a262ebd7bec98ed66e9b72db583b5fa10e158d4e44aae45e5b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 상을 들여 놓고 그 위에 물품을 진설하고 등대를 들여 놓고 불을 켜고"
      ],
      "raw_text_hashes": [
        "27d5a6a5edb176a262ebd7bec98ed66e9b72db583b5fa10e158d4e44aae45e5b"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:5",
      "sequence": 2713,
      "chapter_label": "EXO 40",
      "verse_label": "5",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 5
        }
      ],
      "en": "You shall set the golden altar for incense before the ark of the covenant, and put the screen of the door to the tabernacle.",
      "ko": "또 금 향단을 증거궤 앞에 두고 성막 문에 장을 달고",
      "source_text_hash": "202da8868ad411c45d735eae580d19d5afcf77b8dadd920f2a5675d2a2d6579d",
      "translation_text_hash": "f644b1489339f1174a20a080f7c20f26bc69df5becd84c5eaebf2ae8ff4e5a82",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 금 향단을 증거궤 앞에 두고 성막 문에 장을 달고"
      ],
      "raw_text_hashes": [
        "f644b1489339f1174a20a080f7c20f26bc69df5becd84c5eaebf2ae8ff4e5a82"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:6",
      "sequence": 2714,
      "chapter_label": "EXO 40",
      "verse_label": "6",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 6
        }
      ],
      "en": "“You shall set the altar of burnt offering before the door of the tabernacle of the Tent of Meeting.",
      "ko": "또 번제단을 회막의 성막 문 앞에 놓고",
      "source_text_hash": "f55f7c80d6f4aefbcd1840d0433247a6c8a9aaa9052ff4a56644357a4dc94e83",
      "translation_text_hash": "ad96ed005c253959db50336c03efeaa33a0470babf24b123b57854fed5529d5c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 번제단을 회막의 성막 문 앞에 놓고"
      ],
      "raw_text_hashes": [
        "ad96ed005c253959db50336c03efeaa33a0470babf24b123b57854fed5529d5c"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:7",
      "sequence": 2715,
      "chapter_label": "EXO 40",
      "verse_label": "7",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 7
        }
      ],
      "en": "You shall set the basin between the Tent of Meeting and the altar, and shall put water therein.",
      "ko": "또 물두멍을 회막과 단 사이에 놓고 그 속에 물을 담고",
      "source_text_hash": "6e2b5a8057cd71f20b42afd53ee87183d47f817e8669a70e0946caa3297e56e9",
      "translation_text_hash": "cee40c323a292beb8c30491cdfcbbcdbc8412e0e9a35eda7cc35499c3fe9b801",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 물두멍을 회막과 단 사이에 놓고 그 속에 물을 담고"
      ],
      "raw_text_hashes": [
        "cee40c323a292beb8c30491cdfcbbcdbc8412e0e9a35eda7cc35499c3fe9b801"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:8",
      "sequence": 2716,
      "chapter_label": "EXO 40",
      "verse_label": "8",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 8
        }
      ],
      "en": "You shall set up the court around it, and hang up the screen of the gate of the court.",
      "ko": "또 뜰 주위에 포장을 치고 뜰 문에 장을 달고",
      "source_text_hash": "7ed4ef9ef6fccef5f3f4f22e62cd1f574ffe8bb88750f3ed34b798993668bf53",
      "translation_text_hash": "beb6ab6ea3936f19c3c305d2264ad449863c2f140cd347b8628570bf2da570c9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 뜰 주위에 포장을 치고 뜰 문에 장을 달고"
      ],
      "raw_text_hashes": [
        "beb6ab6ea3936f19c3c305d2264ad449863c2f140cd347b8628570bf2da570c9"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:9",
      "sequence": 2717,
      "chapter_label": "EXO 40",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 9
        }
      ],
      "en": "“You shall take the anointing oil, and anoint the tabernacle and all that is in it, and shall make it holy, and all its furniture, and it will be holy.",
      "ko": "또 관유를 취하여 성막과 그 안에 있는 모든 것에 발라 그것과 그 모든 기구를 거룩하게 하라 그것이 거룩하리라",
      "source_text_hash": "c57851d79a4777f9b3627bd3df111d703bf75669a54a528daa49f10803a34175",
      "translation_text_hash": "49978ee52f5165a79273ee69990565fad48299043fc9ac678935bc183c84f4bd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 관유를 취하여 성막과 그 안에 있는 모든 것에 발라 그것과 그 모든 기구를 거룩하게 하라 그것이 거룩하리라"
      ],
      "raw_text_hashes": [
        "49978ee52f5165a79273ee69990565fad48299043fc9ac678935bc183c84f4bd"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:10",
      "sequence": 2718,
      "chapter_label": "EXO 40",
      "verse_label": "10",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 10
        }
      ],
      "en": "You shall anoint the altar of burnt offering, with all its vessels, and sanctify the altar, and the altar will be most holy.",
      "ko": "너는 또 번제단과 그 모든 기구에 발라 그 안을 거룩하게 하라 그 단이 지극히 거룩하리라",
      "source_text_hash": "8b292fd6de222dab5d311443cab38c84d8952440889bb1e6ce5a3f87c92aa257",
      "translation_text_hash": "ba8feb7643a1be224a6f1943ce5eb3235ca43d6cb5a5e3d3f32e9a98da7f3be1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 또 번제단과 그 모든 기구에 발라 그 안을 거룩하게 하라 그 단이 지극히 거룩하리라"
      ],
      "raw_text_hashes": [
        "ba8feb7643a1be224a6f1943ce5eb3235ca43d6cb5a5e3d3f32e9a98da7f3be1"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:11",
      "sequence": 2719,
      "chapter_label": "EXO 40",
      "verse_label": "11",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 11
        }
      ],
      "en": "You shall anoint the basin and its base, and sanctify it.",
      "ko": "너는 또 물두멍과 그 받침에 발라 거룩하게 하고",
      "source_text_hash": "5eba318f8ca03981c08f70e2a547e6ababacdfb4bf858fd504aa1b3b00138a93",
      "translation_text_hash": "d13cc4eb24ddb05d9bb1257df72560cd36cb88db855dbb35aa51b90685c202e1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 또 물두멍과 그 받침에 발라 거룩하게 하고"
      ],
      "raw_text_hashes": [
        "d13cc4eb24ddb05d9bb1257df72560cd36cb88db855dbb35aa51b90685c202e1"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:12",
      "sequence": 2720,
      "chapter_label": "EXO 40",
      "verse_label": "12",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 12
        }
      ],
      "en": "“You shall bring Aaron and his sons to the door of the Tent of Meeting, and shall wash them with water.",
      "ko": "너는 또 아론과 그 아들들을 회막문으로 데려다가 물로 씻기고",
      "source_text_hash": "61089671d3b60f6ef65dd6f4a5fe44359848d88e82d2f87992c8d3cf4cde430c",
      "translation_text_hash": "93320f4a0f844951014665b1821a87c486c56791a17766316a365a08b5196aff",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 또 아론과 그 아들들을 회막문으로 데려다가 물로 씻기고"
      ],
      "raw_text_hashes": [
        "93320f4a0f844951014665b1821a87c486c56791a17766316a365a08b5196aff"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:13",
      "sequence": 2721,
      "chapter_label": "EXO 40",
      "verse_label": "13",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 13
        }
      ],
      "en": "You shall put on Aaron the holy garments; and you shall anoint him, and sanctify him, that he may minister to me in the priest’s office.",
      "ko": "아론에게 거룩한 옷을 입히고 그에게 기름을 부어 거룩하게 하여 그로 내게 제사장의 직분을 행하게 하라",
      "source_text_hash": "69ab3d1c998988ff0476597638410f39b110bf50176eefe74e5fa8d9bf93c476",
      "translation_text_hash": "dde2f10a5986b533310c7079c1d987b86db246ec8662c32a05c953f8dddb47e5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아론에게 거룩한 옷을 입히고 그에게 기름을 부어 거룩하게 하여 그로 내게 제사장의 직분을 행하게 하라"
      ],
      "raw_text_hashes": [
        "dde2f10a5986b533310c7079c1d987b86db246ec8662c32a05c953f8dddb47e5"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:14",
      "sequence": 2722,
      "chapter_label": "EXO 40",
      "verse_label": "14",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 14
        }
      ],
      "en": "You shall bring his sons, and put tunics on them.",
      "ko": "너는 또 그 아들들을 데려다가 그들에게 겉옷을 입히고",
      "source_text_hash": "374c2ac038d91b066a999cdc18f14aa366efbea7a7cd4995355938ee7e1353b7",
      "translation_text_hash": "fdaba6e7c5a6b6512c74da9b75c12b2dcdcf2e78769eaa45c5cb790f3f1371ac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 또 그 아들들을 데려다가 그들에게 겉옷을 입히고"
      ],
      "raw_text_hashes": [
        "fdaba6e7c5a6b6512c74da9b75c12b2dcdcf2e78769eaa45c5cb790f3f1371ac"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:40:15",
      "sequence": 2723,
      "chapter_label": "EXO 40",
      "verse_label": "15",
      "locator": {
        "book": "EXO",
        "chapter": 40,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 40,
          "verse": 15
        }
      ],
      "en": "You shall anoint them, as you anointed their father, that they may minister to me in the priest’s office. Their anointing shall be to them for an everlasting priesthood throughout their generations.”",
      "ko": "그 아비에게 기름을 부음 같이 그들에게도 부어서 그들로 내게 제사장 직분을 행하게 하라 그들이 기름 부음을 받았은즉 대대로 영영히 제사장이 되리라 하시매",
      "source_text_hash": "406caf5b963cc2dca29f560c00e72c6740d68fa457dd67d8808828b840ad8357",
      "translation_text_hash": "15423bf5fa112464f76bf1cf85a1f21f4c264966eb12cdf13311267ae76bd2ab",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 아비에게 기름을 부음 같이 그들에게도 부어서 그들로 내게 제사장 직분을 행하게 하라 그들이 기름 부음을 받았은즉 대대로 영영히 제사장이 되리라 하시매"
      ],
      "raw_text_hashes": [
