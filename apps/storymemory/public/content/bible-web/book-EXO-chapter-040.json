      "source_text_hash": "67dc4f30b904eff8592f5d7d1dbf246527618842af38a344a32e39579debaa52",
      "translation_text_hash": "756de97c39c3ab3fa3368fb7f5ec38ff58aa36be34180a36dc432c86aca29339",
