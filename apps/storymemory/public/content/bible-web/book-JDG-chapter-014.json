          "book": "JDG",
          "chapter": 14,
          "verse": 1
        }
      ],
      "en": "Samson went down to Timnah, and saw a woman in Timnah of the daughters of the Philistines.",
      "ko": "삼손이 딤나에 내려가서 거기서 블레셋 딸 중 한 여자를 보고",
      "source_text_hash": "bfe3941f936fa22600ba74c56c063844bf0d7e54fb7fd0e1c30bf64b7fc1ac65",
      "translation_text_hash": "9a0dc99d54a13aec109a57b9f7ca1318a241f006ae9196c40917dedc70e85ad3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "삼손이 딤나에 내려가서 거기서 블레셋 딸 중 한 여자를 보고"
      ],
      "raw_text_hashes": [
        "9a0dc99d54a13aec109a57b9f7ca1318a241f006ae9196c40917dedc70e85ad3"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:14:2",
      "sequence": 6912,
      "chapter_label": "JDG 14",
      "verse_label": "2",
      "locator": {
