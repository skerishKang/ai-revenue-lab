    },
    {
      "canonical_locator": "bible:web:JDG:14:13",
      "sequence": 6923,
      "chapter_label": "JDG 14",
      "verse_label": "13",
      "locator": {
        "book": "JDG",
        "chapter": 14,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 14,
          "verse": 13
        }
      ],
      "en": "but if you can’t tell me the answer, then you shall give me thirty linen garments and thirty changes of clothing.” They said to him, “Tell us your riddle, that we may hear it.”",
      "ko": "그러나 그것을 능히 내게 고하지 못하면 너희가 내게 베옷 삼십 벌과 겉옷 삼십 벌을 줄찌니라 그들이 이르되 너는 수수께끼를 하여 우리로 듣게 하라",
      "source_text_hash": "139f9b9b02d20c0cf8b52f0cba989df9e894d7714e278a22d6ecf0c4f1ce8b44",
      "translation_text_hash": "74ab35977e031871535bdac0bbec27a114bb8fc33e3f0d397e2ff967213e161e",
      "translation_policy": "krv-1961-source-mapped",
