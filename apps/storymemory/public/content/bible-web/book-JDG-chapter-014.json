        "verse": 7
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 14,
          "verse": 7
        }
      ],
      "en": "He went down and talked with the woman, and she pleased Samson well.",
      "ko": "그가 내려가서 그 여자와 말하며 그를 기뻐하였더라",
      "source_text_hash": "2dde0e516bc99f296d8c5822c6a214cc2f84f8fd5582e408d1d2614153cd7552",
      "translation_text_hash": "0fc41fa3e6aa7e03302ad7559a2d6a00b516dbcf4e1ffccc1a30488f846be03e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 내려가서 그 여자와 말하며 그를 기뻐하였더라"
      ],
      "raw_text_hashes": [
        "0fc41fa3e6aa7e03302ad7559a2d6a00b516dbcf4e1ffccc1a30488f846be03e"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:14:8",
      "sequence": 6918,
      "chapter_label": "JDG 14",
      "verse_label": "8",
      "locator": {
        "book": "JDG",
