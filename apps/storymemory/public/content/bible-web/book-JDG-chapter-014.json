    {
      "canonical_locator": "bible:web:JDG:14:10",
      "sequence": 6920,
      "chapter_label": "JDG 14",
      "verse_label": "10",
      "locator": {
        "book": "JDG",
        "chapter": 14,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 14,
          "verse": 10
        }
      ],
      "en": "His father went down to the woman; and Samson made a feast there, for the young men used to do so.",
      "ko": "삼손의 아비가 여자에게로 내려가매 삼손이 거기서 잔치를 배설하였으니 소년은 이렇게 행하는 풍속이 있음이더라",
      "source_text_hash": "b5c8065bcceb3a25be26c027a7c7bc02720bd796c57e057c63448eb1b7fbdf75",
      "translation_text_hash": "be73ac28e856ab09600f40313cadfaa47d046b22a493fad752064c2d8e61237a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "삼손의 아비가 여자에게로 내려가매 삼손이 거기서 잔치를 배설하였으니 소년은 이렇게 행하는 풍속이 있음이더라"
      ],
      "raw_text_hashes": [
        "be73ac28e856ab09600f40313cadfaa47d046b22a493fad752064c2d8e61237a"
      ]
