      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게 말하던 천사가 다시 와서 나를 깨우니 마치 자는 사람이 깨우임 같더라"
      ],
      "raw_text_hashes": [
