        {
          "book": "ISA",
          "chapter": 11,
          "verse": 1
        }
      ],
      "en": "A shoot will come out of the stock of Jesse, and a branch out of his roots will bear fruit.",
      "ko": "이새의 줄기에서 한 싹이 나며 그 뿌리에서 한 가지가 나서 결실할 것이요",
      "source_text_hash": "21fba0efc74fc33d65faf83e48dde0054c0ebbc6d752f6a4ae9478711e868003",
      "translation_text_hash": "019914d5048ffa20995c5b9b3150790a7f231cf45d528f5807cb9a8b073fcc12",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이새의 줄기에서 한 싹이 나며 그 뿌리에서 한 가지가 나서 결실할 것이요"
      ],
      "raw_text_hashes": [
        "019914d5048ffa20995c5b9b3150790a7f231cf45d528f5807cb9a8b073fcc12"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:11:2",
      "sequence": 17887,
      "chapter_label": "ISA 11",
      "verse_label": "2",
      "locator": {
