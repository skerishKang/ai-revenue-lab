        "verse": 5
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 11,
          "verse": 5
        }
      ],
      "en": "Righteousness will be the belt around his waist, and faithfulness the belt around his waist.",
      "ko": "공의로 그 허리띠를 삼으며 성실로 몸의 띠를 삼으리라",
      "source_text_hash": "d5d0b03d0c268bfec4bc97de51e238f73ebf4b0bd05ac82c1b1902938630f481",
      "translation_text_hash": "3fcc3f5e09dc648cb728998d6a91ed677f87ee1441b8d237e9b18a5bee325ff8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "공의로 그 허리띠를 삼으며 성실로 몸의 띠를 삼으리라"
      ],
      "raw_text_hashes": [
        "3fcc3f5e09dc648cb728998d6a91ed677f87ee1441b8d237e9b18a5bee325ff8"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:11:6",
      "sequence": 17891,
      "chapter_label": "ISA 11",
      "verse_label": "6",
      "locator": {
        "book": "ISA",
