      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 주께서 우리를 우리 대적에게서 구원하시고 우리를 미워하는 자로 수치를 당케 하셨나이다"
      ],
      "raw_text_hashes": [
        "b6bd30f49a0b68766098e6d593318efc3507df08bef266c9aef96ac77ff54a20"
