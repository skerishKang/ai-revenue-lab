      "source_text_hash": "c87ee9b6d8cc1ecd4dcc9e8e4bd161d21d6a1372cdf3b42067e7e674a6550876",
      "translation_text_hash": "57fa4fffeeeafbea22c4f1dcc8225498e65df0730b39c5623f46629742eea3e7",
