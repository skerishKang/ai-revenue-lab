      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 16,
          "verse": 3
        }
      ],
      "en": "Commit your deeds to the LORD, and your plans shall succeed.",
      "ko": "너의 행사를 여호와께 맡기라 그리하면 너의 경영하는 것이 이루리라",
      "source_text_hash": "a0611de8f3bf2c9a48cf70a9217700546f24fa6b8e89fa8d661986c5f68f6ec2",
      "translation_text_hash": "add5790b3d9b2f6c1cf9d691409760e117192b83434dfe5835340fd9961e2b6a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너의 행사를 여호와께 맡기라 그리하면 너의 경영하는 것이 이루리라"
      ],
      "raw_text_hashes": [
        "add5790b3d9b2f6c1cf9d691409760e117192b83434dfe5835340fd9961e2b6a"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:16:4",
      "sequence": 16845,
      "chapter_label": "PRO 16",
      "verse_label": "4",
      "locator": {
        "book": "PRO",
