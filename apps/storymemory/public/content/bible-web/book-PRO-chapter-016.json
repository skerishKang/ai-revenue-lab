        {
          "book": "PRO",
          "chapter": 16,
          "verse": 1
        }
      ],
      "en": "The plans of the heart belong to man, but the answer of the tongue is from the LORD.",
      "ko": "마음의 경영은 사람에게 있어도 말의 응답은 여호와께로서 나느니라",
      "source_text_hash": "b5aa89c9ffd6f0e2152eb4b1f37a01a29b2ddb0118b8213eecee546d652ff2a1",
      "translation_text_hash": "16f302c5c70eefd897d68e5a430289001a5a36214431c6b5713ec7678f5fae71",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "마음의 경영은 사람에게 있어도 말의 응답은 여호와께로서 나느니라"
      ],
      "raw_text_hashes": [
        "16f302c5c70eefd897d68e5a430289001a5a36214431c6b5713ec7678f5fae71"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:16:2",
