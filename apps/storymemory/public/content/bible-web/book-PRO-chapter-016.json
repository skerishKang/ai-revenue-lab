      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "의로운 입술은 왕들의 기뻐하는 것이요 정직히 말하는 자는 그들의 사랑을 입느니라"
      ],
      "raw_text_hashes": [
        "e01605d1342e864846e9c1e23ae251bc43bc98d37fd769b40bbc903fc7cf358a"
      ]
    },
    {
