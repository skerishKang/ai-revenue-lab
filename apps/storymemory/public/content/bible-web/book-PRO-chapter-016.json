      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "겸손한 자와 함께하여 마음을 낮추는 것이 교만한 자와 함께하여 탈취물을 나누는 것보다 나으니라"
      ],
      "raw_text_hashes": [
        "730ff9306421578d61b2ad1f5941225b0ba710006f75fb198b3fc67d1979163e"
