      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 16,
          "verse": 13
        }
      ],
      "en": "Righteous lips are the delight of kings. They value one who speaks the truth.",
      "ko": "의로운 입술은 왕들의 기뻐하는 것이요 정직히 말하는 자는 그들의 사랑을 입느니라",
      "source_text_hash": "65fb3ec8de55ec332158c80c17166a466670796535a3b077d2adf6e32df889cb",
      "translation_text_hash": "e01605d1342e864846e9c1e23ae251bc43bc98d37fd769b40bbc903fc7cf358a",
      "translation_policy": "krv-1961-source-mapped",
