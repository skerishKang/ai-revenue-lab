      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요셉이 그들에게 이르되 두려워 마소서 내가 하나님을 대신하리이까"
      ],
      "raw_text_hashes": [
        "6df583b67fc02810b0907f6a8a817bdc668e8ea265afceeee114a6a787b442b7"
