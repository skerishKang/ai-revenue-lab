      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들은 또 머리털을 밀지도 말며 머리털을 길게 자라게도 말고 그 머리털을 깎기만 할 것이며"
      ],
      "raw_text_hashes": [
