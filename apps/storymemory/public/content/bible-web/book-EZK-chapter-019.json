      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 이스라엘 방백들을 위하여 애가를 지어"
      ],
      "raw_text_hashes": [
        "97b13bf40eac5989823f77e868335bd7d8481c92e4626c18e62ab4b735cf4a87"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:19:2",
      "sequence": 20884,
