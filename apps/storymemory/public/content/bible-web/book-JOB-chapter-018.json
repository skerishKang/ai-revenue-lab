      "translation_text_hash": "0609647b510dedfa9258c3d1c14420ae3470e8586defe608616333c678c28c35",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
