        {
          "book": "SNG",
          "chapter": 7,
          "verse": 4
        }
      ],
      "en": "Your neck is like an ivory tower. Your eyes are like the pools in Heshbon by the gate of Bathrabbim. Your nose is like the tower of Lebanon which looks toward Damascus.",
      "ko": "목은 상아 망대 같구나 눈은 헤스본 바드랍빔 문 곁의 못 같고 코는 다메섹을 향한 레바논 망대 같구나",
      "source_text_hash": "46f9f23de8c07eb5069c11b1f4482c7306bd3ed9266a62140b2fb1cc6618eda8",
      "translation_text_hash": "c330cd5e03b9df0e40304754028f815596a43f1a7f20dbdd91f45dcc4f77c410",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "목은 상아 망대 같구나 눈은 헤스본 바드랍빔 문 곁의 못 같고 코는 다메섹을 향한 레바논 망대 같구나"
      ],
      "raw_text_hashes": [
        "c330cd5e03b9df0e40304754028f815596a43f1a7f20dbdd91f45dcc4f77c410"
      ]
