      "raw_locator": [
        {
          "book": "SNG",
          "chapter": 7,
          "verse": 11
        }
      ],
      "en": "Come, my beloved! Let’s go out into the field. Let’s lodge in the villages.",
      "ko": "나의 사랑하는 자야 우리가 함께 들로 가서 동네에서 유숙하자",
      "source_text_hash": "217768a2421c4da9f608a469248e4d10e2a28665f5903b7c63286fa2499ea91d",
      "translation_text_hash": "839e1816f1de155e29043bf0b7b441655dc9129808cd39536c8977d9d3a6d845",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 사랑하는 자야 우리가 함께 들로 가서 동네에서 유숙하자"
      ],
      "raw_text_hashes": [
        "839e1816f1de155e29043bf0b7b441655dc9129808cd39536c8977d9d3a6d845"
      ]
    },
    {
      "canonical_locator": "bible:web:SNG:7:12",
      "sequence": 17640,
      "chapter_label": "SNG 7",
      "verse_label": "12",
      "locator": {
        "book": "SNG",
