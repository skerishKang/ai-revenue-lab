      ],
      "en": "Your two breasts are like two fawns, that are twins of a roe.",
      "ko": "두 유방은 암사슴의 쌍태 새끼 같고",
      "source_text_hash": "6d3652def3d2db903e6a980d871c9a5d398302c21bfbde7fe2ce8915780cf4b5",
      "translation_text_hash": "48a75fe30d615c592851805caa867e0608ea780b0677f6379af5069c4ca3cdf6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "두 유방은 암사슴의 쌍태 새끼 같고"
      ],
      "raw_text_hashes": [
        "48a75fe30d615c592851805caa867e0608ea780b0677f6379af5069c4ca3cdf6"
      ]
    },
    {
