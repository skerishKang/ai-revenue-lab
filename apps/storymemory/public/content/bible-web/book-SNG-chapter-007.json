        {
          "book": "SNG",
          "chapter": 7,
          "verse": 7
        }
      ],
      "en": "This, your stature, is like a palm tree, your breasts like its fruit.",
      "ko": "네 키는 종려나무 같고 네 유방은 그 열매 송이 같구나",
      "source_text_hash": "0a36b5da82e0dc07b0201866946030cc42706319832e8cbabc8a18c6194c23d7",
      "translation_text_hash": "7483e1d77a4275b4f33641fcada2a2eed24404ec320e813902d4e52396d1499f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 키는 종려나무 같고 네 유방은 그 열매 송이 같구나"
      ],
      "raw_text_hashes": [
        "7483e1d77a4275b4f33641fcada2a2eed24404ec320e813902d4e52396d1499f"
      ]
    },
    {
      "canonical_locator": "bible:web:SNG:7:8",
      "sequence": 17636,
      "chapter_label": "SNG 7",
      "verse_label": "8",
      "locator": {
