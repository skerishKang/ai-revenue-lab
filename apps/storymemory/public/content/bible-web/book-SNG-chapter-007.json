      },
      "raw_locator": [
        {
          "book": "SNG",
          "chapter": 7,
          "verse": 10
        }
      ],
      "en": "I am my beloved’s. His desire is toward me.",
      "ko": "나는 나의 사랑하는 자에게 속하였구나 그가 나를 사모하는구나",
      "source_text_hash": "d25043972e2d33f51030ac3abaa634c9be551f1047b4902d0c9a408e8fe7e573",
      "translation_text_hash": "7a21adebd7b255488b43f28362ef6f0cebdf95bdabee7f7acb7fd4cbd1b0077e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 나의 사랑하는 자에게 속하였구나 그가 나를 사모하는구나"
      ],
      "raw_text_hashes": [
        "7a21adebd7b255488b43f28362ef6f0cebdf95bdabee7f7acb7fd4cbd1b0077e"
      ]
    },
    {
      "canonical_locator": "bible:web:SNG:7:11",
      "sequence": 17639,
      "chapter_label": "SNG 7",
