      "raw_locator": [
        {
          "book": "SNG",
          "chapter": 7,
          "verse": 6
        }
      ],
      "en": "How beautiful and how pleasant you are, love, for delights!",
      "ko": "사랑아 네가 어찌 그리 아름다운지, 어찌 그리 화창한지 쾌락하게 하는구나",
      "source_text_hash": "aef5dd54d5700bf63f33c00b000b05f22f2a14349ef83008de0060c02b774d0f",
      "translation_text_hash": "eab6d965ebede7c94123ca326ad77a81fe352d44019d3fe35987970c93377f39",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사랑아 네가 어찌 그리 아름다운지, 어찌 그리 화창한지 쾌락하게 하는구나"
      ],
      "raw_text_hashes": [
        "eab6d965ebede7c94123ca326ad77a81fe352d44019d3fe35987970c93377f39"
      ]
    },
    {
