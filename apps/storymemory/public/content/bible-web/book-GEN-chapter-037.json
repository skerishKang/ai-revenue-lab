      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 37,
          "verse": 9
        }
      ],
      "en": "He dreamed yet another dream, and told it to his brothers, and said, “Behold, I have dreamed yet another dream: and behold, the sun and the moon and eleven stars bowed down to me.”",
      "ko": "요셉이 다시 꿈을 꾸고 그 형들에게 고하여 가로되 내가 또 꿈을 꾼즉 해와 달과 열 한 별이 내게 절하더이다 하니라",
      "source_text_hash": "1ddf33e2547103254071a00a8b7d4e4f07266a7d47c1108aefd21701046300b6",
      "translation_text_hash": "1a265829257bce769e64b9a1c1a42a78ed119d5339c8db79dd4565ffefb7f001",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요셉이 다시 꿈을 꾸고 그 형들에게 고하여 가로되 내가 또 꿈을 꾼즉 해와 달과 열 한 별이 내게 절하더이다 하니라"
      ],
      "raw_text_hashes": [
