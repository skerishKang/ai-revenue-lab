      "translation_text_hash": "9caba9d2311436558eed3890b6558f2ceb36dccfa6d2a6693719d3c1d3432290",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕후가 육십이요 비빈이 팔십이요 시녀가 무수하되"
      ],
      "raw_text_hashes": [
        "9caba9d2311436558eed3890b6558f2ceb36dccfa6d2a6693719d3c1d3432290"
      ]
    },
    {
