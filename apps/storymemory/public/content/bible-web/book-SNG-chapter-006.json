      "raw_locator": [
        {
          "book": "SNG",
          "chapter": 6,
          "verse": 7
        }
      ],
      "en": "Your temples are like a piece of a pomegranate behind your veil.",
      "ko": "너울 속의 너의 뺨은 석류 한쪽 같구나",
      "source_text_hash": "9d8fb2da25a0bfcdfb622ad4d188161b5b65ca3fea90ed10a90876f681b69880",
