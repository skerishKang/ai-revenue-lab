      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너울 속의 너의 뺨은 석류 한쪽 같구나"
      ],
      "raw_text_hashes": [
        "fc56b440351248e27de76ea651f52c792fe7a1b194e40401b8bbd4ff238fa085"
      ]
    },
    {
