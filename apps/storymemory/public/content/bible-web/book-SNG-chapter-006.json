      "raw_locator": [
        {
          "book": "SNG",
          "chapter": 6,
          "verse": 5
        }
      ],
      "en": "Turn away your eyes from me, for they have overcome me. Your hair is like a flock of goats, that lie along the side of Gilead.",
      "ko": "네 눈이 나를 놀래니 돌이켜 나를 보지 말라 네 머리털은 길르앗산 기슭에 누운 염소떼 같고",
      "source_text_hash": "74a03b29c954c99d5367b8dd268d977f5c371b9bcf6d16d8caddf6da6947b2b8",
      "translation_text_hash": "c22a2335eee9cafadc7d572af52e5d4f35bb450663a811c39a53bd1deddf12da",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 눈이 나를 놀래니 돌이켜 나를 보지 말라 네 머리털은 길르앗산 기슭에 누운 염소떼 같고"
      ],
      "raw_text_hashes": [
