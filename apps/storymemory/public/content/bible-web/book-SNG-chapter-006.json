        {
          "book": "SNG",
          "chapter": 6,
          "verse": 4
        }
      ],
      "en": "You are beautiful, my love, as Tirzah, lovely as Jerusalem, awesome as an army with banners.",
      "ko": "내 사랑아 너의 어여쁨이 디르사 같고 너의 고움이 예루살렘 같고 엄위함이 기치를 벌인 군대 같구나",
      "source_text_hash": "138db81855b4dafb408f91e112641977afdbd958f48b3b127b87aa287054c5b7",
      "translation_text_hash": "df5033a430c60ab77c3fb768eb3206a3fb93b6710856b800b83b56dde6064875",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 사랑아 너의 어여쁨이 디르사 같고 너의 고움이 예루살렘 같고 엄위함이 기치를 벌인 군대 같구나"
      ],
      "raw_text_hashes": [
        "df5033a430c60ab77c3fb768eb3206a3fb93b6710856b800b83b56dde6064875"
      ]
