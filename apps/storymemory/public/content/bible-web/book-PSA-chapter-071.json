      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 71,
          "verse": 8
        }
      ],
      "en": "My mouth shall be filled with your praise, with your honor all day long.",
      "ko": "주를 찬송함과 주를 존숭함이 종일토록 내 입에 가득하리이다",
      "source_text_hash": "132f1b25d24b2ae4e37ca96688b980142fdc3fa7f9ac6aaf5f9fef3276ec255d",
      "translation_text_hash": "89dc42d88a561a9a50b3e641b1733901357a2d01ccc5306f4de50bb6484e8632",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주를 찬송함과 주를 존숭함이 종일토록 내 입에 가득하리이다"
      ],
      "raw_text_hashes": [
        "89dc42d88a561a9a50b3e641b1733901357a2d01ccc5306f4de50bb6484e8632"
      ]
    },
