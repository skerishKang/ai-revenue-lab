        {
          "book": "PSA",
          "chapter": 71,
          "verse": 5
        }
      ],
      "en": "For you are my hope, Lord GOD, my confidence from my youth.",
      "ko": "주 여호와여 주는 나의 소망이시요 나의 어릴 때부터 의지시라",
      "source_text_hash": "335e6af7c9942faffb2b483dd13ad5052be8d8dd745786984c25cbb22d6025c9",
      "translation_text_hash": "33ed979a422a299f37189cd1c4565ae5e6fcbc4987f99cbbf88315f731fe41bd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주 여호와여 주는 나의 소망이시요 나의 어릴 때부터 의지시라"
      ],
      "raw_text_hashes": [
        "33ed979a422a299f37189cd1c4565ae5e6fcbc4987f99cbbf88315f731fe41bd"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:71:6",
      "sequence": 14983,
      "chapter_label": "PSA 71",
      "verse_label": "6",
