      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 71,
          "verse": 7
        }
      ],
      "en": "I am a marvel to many, but you are my strong refuge.",
      "ko": "나는 무리에게 이상함이 되었사오나 주는 나의 견고한 피난처시오니",
      "source_text_hash": "35e7cc099a13e58072e370ce6fb40da8d0e485f4a78cf165c14581ca8db41cd5",
      "translation_text_hash": "9a5df6293c56633137141f34e33d88a726d8d425efa77672dd1b0aff456f602a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 무리에게 이상함이 되었사오나 주는 나의 견고한 피난처시오니"
      ],
      "raw_text_hashes": [
        "9a5df6293c56633137141f34e33d88a726d8d425efa77672dd1b0aff456f602a"
      ]
    },
