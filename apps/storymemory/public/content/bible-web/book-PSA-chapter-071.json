      "source_text_hash": "1b235e970eb3ca0aefd410f916cce207da5296631aaa964458af52af3601dbe1",
      "translation_text_hash": "a1a01e95ee4da43c14fd975b31399372d2dec360c6424af518d502fef8800a36",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 더욱 창대하게 하시고 돌이키사 나를 위로하소서"
      ],
      "raw_text_hashes": [
        "a1a01e95ee4da43c14fd975b31399372d2dec360c6424af518d502fef8800a36"
      ]
    },
