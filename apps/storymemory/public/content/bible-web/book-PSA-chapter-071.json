      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 내가 주께 피하오니 나로 영영히 수치를 당케 마소서"
      ],
      "raw_text_hashes": [
        "77a8c24d563946719070c86abbcd9db8e8e3d1f565b6f9a0836939b5acf66d7b"
      ]
