      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 71,
          "verse": 6
        }
      ],
      "en": "I have relied on you from the womb. You are he who took me out of my mother’s womb. I will always praise you.",
      "ko": "내가 모태에서부터 주의 붙드신바 되었으며 내 어미 배에서 주의 취하여 내신바 되었사오니 나는 항상 주를 찬송하리이다",
      "source_text_hash": "fdd28900c8e781c99061c24b0b449476c483973f74ad1fe3ddf00d1d2ba6c019",
      "translation_text_hash": "3ac6d8e45c9ca0ba43b50d874dec72b7e70a7906185b84d478ec61041f23f5a2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 모태에서부터 주의 붙드신바 되었으며 내 어미 배에서 주의 취하여 내신바 되었사오니 나는 항상 주를 찬송하리이다"
      ],
      "raw_text_hashes": [
        "3ac6d8e45c9ca0ba43b50d874dec72b7e70a7906185b84d478ec61041f23f5a2"
