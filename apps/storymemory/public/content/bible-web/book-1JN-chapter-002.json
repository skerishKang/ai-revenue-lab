      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "거짓말 하는 자가 누구뇨 예수께서 그리스도이심을 부인하는 자가 아니뇨 아버지와 아들을 부인하는 그가 적그리스도니"
      ],
      "raw_text_hashes": [
