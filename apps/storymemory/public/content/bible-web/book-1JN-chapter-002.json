      "raw_locator": [
        {
          "book": "1JN",
          "chapter": 2,
          "verse": 13
        }
      ],
      "en": "I write to you, fathers, because you know him who is from the beginning. I write to you, young men, because you have overcome the evil one. I write to you, little children, because you know the Father.",
      "ko": "아비들아 내가 너희에게 쓰는 것은 너희가 태초부터 계신 이를 앎이요 청년들아 내가 너희에게 쓰는 것은 너희가 악한 자를 이기었음이니라",
      "source_text_hash": "7809103efc35a9f574fc7af27eba288f440b5eb332e9d4f27aa3b26eb664e579",
      "translation_text_hash": "4a8cd1d43314edec7faaf7d25b1aa09498b8ddde870d4ed3ba12005ffe43326e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아비들아 내가 너희에게 쓰는 것은 너희가 태초부터 계신 이를 앎이요 청년들아 내가 너희에게 쓰는 것은 너희가 악한 자를 이기었음이니라"
      ],
      "raw_text_hashes": [
