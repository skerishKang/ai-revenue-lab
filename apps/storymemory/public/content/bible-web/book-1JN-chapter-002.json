    {
      "canonical_locator": "bible:web:1JN:2:8",
      "sequence": 30555,
      "chapter_label": "1JN 2",
      "verse_label": "8",
      "locator": {
        "book": "1JN",
        "chapter": 2,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1JN",
          "chapter": 2,
          "verse": 8
        }
      ],
      "en": "Again, I write a new commandment to you, which is true in him and in you, because the darkness is passing away and the true light already shines.",
      "ko": "다시 내가 너희에게 새 계명을 쓰노니 저에게와 너희에게도 참된 것이라 이는 어두움이 지나가고 참빛이 벌써 비췸이니라",
      "source_text_hash": "f05c16d74aada13da8cd7367101a88634386ec9d5e65b990ecad269b94056bc2",
      "translation_text_hash": "ca17d178193b6f3bcf1af43acbe2735ea3d09d3fe28553a62d225c14a8f04f12",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다시 내가 너희에게 새 계명을 쓰노니 저에게와 너희에게도 참된 것이라 이는 어두움이 지나가고 참빛이 벌써 비췸이니라"
      ],
      "raw_text_hashes": [
        "ca17d178193b6f3bcf1af43acbe2735ea3d09d3fe28553a62d225c14a8f04f12"
