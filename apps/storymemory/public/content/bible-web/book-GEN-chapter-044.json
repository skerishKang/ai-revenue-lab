      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요셉이 그 청지기에게 명하여 가로되 양식을 각인의 자루에 실을 수 있을만큼 채우고 각인의 돈을 그 자루에 넣고"
      ],
      "raw_text_hashes": [
        "be2a6084ca912358cae130728a76eb564ace97b180a0d2eda345ce67d96df153"
      ]
