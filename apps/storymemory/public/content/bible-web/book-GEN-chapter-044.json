      "en": "He overtook them, and he spoke these words to them.",
      "ko": "청지기가 그들에게 따라 미쳐 그대로 말하니",
      "source_text_hash": "0e45f8305d8ec1a1afd8cb071caa0fd2e0d222b947d5f10ba4196b44cd8d953d",
      "translation_text_hash": "8d70bf052d521cf315072f8bf4be636b5c31ae73482393880a37f2452909eaca",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "청지기가 그들에게 따라 미쳐 그대로 말하니"
      ],
      "raw_text_hashes": [
        "8d70bf052d521cf315072f8bf4be636b5c31ae73482393880a37f2452909eaca"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:44:7",
      "sequence": 1332,
      "chapter_label": "GEN 44",
