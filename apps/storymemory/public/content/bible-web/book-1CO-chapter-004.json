    {
      "canonical_locator": "bible:web:1CO:4:8",
      "sequence": 28438,
      "chapter_label": "1CO 4",
      "verse_label": "8",
      "locator": {
        "book": "1CO",
        "chapter": 4,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 4,
          "verse": 8
        }
      ],
      "en": "You are already filled. You have already become rich. You have come to reign without us. Yes, and I wish that you did reign, that we also might reign with you!",
      "ko": "너희가 이미 배부르며 이미 부요하며 우리 없이 왕노릇 하였도다 우리가 너희와 함께 왕노릇 하기 위하여 참으로 너희의 왕노릇 하기를 원하노라",
      "source_text_hash": "8c0eed568398084ec156fa54965d63f0a6a2cad38c78a448bba49e2e783d6290",
      "translation_text_hash": "68a0862ecc82c5715aab80d23c77f322f5e646f3fefc177ba922ba9aeeae9d6a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 이미 배부르며 이미 부요하며 우리 없이 왕노릇 하였도다 우리가 너희와 함께 왕노릇 하기 위하여 참으로 너희의 왕노릇 하기를 원하노라"
      ],
      "raw_text_hashes": [
