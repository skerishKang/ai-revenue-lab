    {
      "canonical_locator": "bible:web:1CO:4:9",
      "sequence": 28439,
      "chapter_label": "1CO 4",
      "verse_label": "9",
      "locator": {
        "book": "1CO",
        "chapter": 4,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 4,
          "verse": 9
        }
      ],
      "en": "For I think that God has displayed us, the apostles, last of all, like men sentenced to death. For we are made a spectacle to the world, both to angels and men.",
      "ko": "내가 생각건대 하나님이 사도인 우리를 죽이기로 작정한 자 같이 미말에 두셨으매 우리는 세계 곧 천사와 사람에게 구경거리가 되었노라",
      "source_text_hash": "3cb273e0657557ec773cefe11ae8e83b349511aacf114f4899d1b861dc6b2150",
      "translation_text_hash": "5f6fd830e2e9c5ab783df59216217c900bb7624555746c698f27eeaff5e4d0ad",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 생각건대 하나님이 사도인 우리를 죽이기로 작정한 자 같이 미말에 두셨으매 우리는 세계 곧 천사와 사람에게 구경거리가 되었노라"
      ],
      "raw_text_hashes": [
        "5f6fd830e2e9c5ab783df59216217c900bb7624555746c698f27eeaff5e4d0ad"
      ]
