        {
          "book": "JER",
          "chapter": 17,
          "verse": 12
        }
      ],
      "en": "A glorious throne, set on high from the beginning, is the place of our sanctuary.",
      "ko": "영화로우신 보좌여 원시부터 높이 계시며 우리의 성소이시며",
      "source_text_hash": "5ad9264338778686cba9f59c6cb10b4f372f33489e6cd8e5a83c54d06f00c47e",
      "translation_text_hash": "3899ff97b224f0bdfeeb1325aa9ce2b06429b0c08743b48ba5b45b833dda85bf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "영화로우신 보좌여 원시부터 높이 계시며 우리의 성소이시며"
      ],
      "raw_text_hashes": [
        "3899ff97b224f0bdfeeb1325aa9ce2b06429b0c08743b48ba5b45b833dda85bf"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:17:13",
      "sequence": 19371,
      "chapter_label": "JER 17",
      "verse_label": "13",
