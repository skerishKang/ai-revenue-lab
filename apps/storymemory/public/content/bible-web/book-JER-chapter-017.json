        "verse": 7
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 17,
          "verse": 7
        }
      ],
      "en": "“Blessed is the man who trusts in the LORD, and whose confidence is in the LORD.",
      "ko": "그러나 무릇 여호와를 의지하며 여호와를 의뢰하는 그 사람은 복을 받을 것이라",
      "source_text_hash": "e74c43789536befcfafffc488ff1b17d36ab999bcf365e7f2b5c0b5eeba6c12b",
      "translation_text_hash": "b1d5f18f0292dc8191ef792d09251aa6839cf7474eff893b8273dbae60fdb126",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 무릇 여호와를 의지하며 여호와를 의뢰하는 그 사람은 복을 받을 것이라"
      ],
      "raw_text_hashes": [
        "b1d5f18f0292dc8191ef792d09251aa6839cf7474eff893b8273dbae60fdb126"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:17:8",
      "sequence": 19366,
      "chapter_label": "JER 17",
      "verse_label": "8",
      "locator": {
