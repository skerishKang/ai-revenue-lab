      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들은 청종치 아니하며 귀를 기울이지 아니하며 그 목을 곧게 하여 듣지 아니하며 교훈을 받지 아니하였느니라"
      ],
      "raw_text_hashes": [
