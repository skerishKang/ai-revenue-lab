      "mapping_note": null,
      "raw_texts": [
        "잡혀간 곳에서 죽으리니 이 땅을 다시 보지 못하리라"
      ],
      "raw_text_hashes": [
        "feaaf6784468a9bad8feba77dbe578ba02635aa6b47ce41d3a40ee36faca6005"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:22:13",
      "sequence": 19468,
      "chapter_label": "JER 22",
