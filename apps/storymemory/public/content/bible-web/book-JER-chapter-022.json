        "verse": 13
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 22,
          "verse": 13
        }
      ],
      "en": "“Woe to him who builds his house by unrighteousness, and his rooms by injustice; who uses his neighbor’s service without wages, and doesn’t give him his hire;",
      "ko": "불의로 그 집을 세우며 불공평으로 그 다락방을 지으며 그 이웃을 고용하고 그 고가를 주지 아니하는 자에게 화 있을찐저",
      "source_text_hash": "6ca7ddfd859dcf6726aac4ccb6038ed8b3248ddd2917b338aeca275d45e8dd27",
      "translation_text_hash": "8e621e12f850ece2704b62d40ed2d334cf92b36b0b13da271528f8b588594868",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
