        {
          "book": "1CO",
          "chapter": 2,
          "verse": 3
        }
      ],
      "en": "I was with you in weakness, in fear, and in much trembling.",
      "ko": "내가 너희 가운데 거할 때에 약하며 두려워하며 심히 떨었노라",
      "source_text_hash": "46390762c68e2d6def1cc7a7f87068a4c85ec6e56639f858349fccf291131200",
      "translation_text_hash": "46bef3d8229affb0cdd2e166d9c36bd6b65d8381a8b5823680f0a0ac10026308",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너희 가운데 거할 때에 약하며 두려워하며 심히 떨었노라"
      ],
      "raw_text_hashes": [
        "46bef3d8229affb0cdd2e166d9c36bd6b65d8381a8b5823680f0a0ac10026308"
      ]
    },
    {
