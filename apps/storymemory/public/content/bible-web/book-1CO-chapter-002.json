      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너희 중에서 예수 그리스도와 그의 십자가에 못 박히신 것 외에는 아무 것도 알지 아니하기로 작정하였음이라"
      ],
      "raw_text_hashes": [
        "41153010519166f409a53feeec55ef45f9f791a4288d1eece2d1cf57cb6eb741"
