      "translation_text_hash": "2ae5b7287eff580bc019562a0fcc82f22714688d72ecf4a855ec444da621154a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대저 주의 원수가 훤화하며 주를 한하는 자가 머리를 들었나이다"
      ],
      "raw_text_hashes": [
        "2ae5b7287eff580bc019562a0fcc82f22714688d72ecf4a855ec444da621154a"
      ]
    },
