      "source_text_hash": "ed5111b0904ad7cc0355586e02cd29034ab6b78c9c95074a6a26289c8a67611f",
      "translation_text_hash": "702ddb1a71d36824ad025a01d3108cf7ddcae70c156405f8f88ea38acba25dac",
      "translation_policy": "krv-1961-source-mapped",
