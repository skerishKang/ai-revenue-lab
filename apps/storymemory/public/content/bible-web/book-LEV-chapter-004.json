      "ko": "그 수송아지의 가죽과 그 모든 고기와 그 머리와 다리와 내장과",
      "source_text_hash": "d1147b22efa5394a72c27ab769032146d5ed9efbb4074dbce78296a5bb7f536b",
      "translation_text_hash": "970824977d0d5368134a7ea7eb9256efefe151897dbf87649aeded698b26e69a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 수송아지의 가죽과 그 모든 고기와 그 머리와 다리와 내장과"
      ],
      "raw_text_hashes": [
        "970824977d0d5368134a7ea7eb9256efefe151897dbf87649aeded698b26e69a"
      ]
    },
