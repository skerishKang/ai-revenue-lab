    {
      "canonical_locator": "bible:web:2SA:12:9",
      "sequence": 8296,
      "chapter_label": "2SA 12",
      "verse_label": "9",
      "locator": {
        "book": "2SA",
        "chapter": 12,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 12,
          "verse": 9
        }
      ],
      "en": "Why have you despised the LORD’s word, to do that which is evil in his sight? You have struck Uriah the Hittite with the sword, have taken his wife to be your wife, and have slain him with the sword of the children of Ammon.",
      "ko": "그러한데 어찌하여 네가 여호와의 말씀을 업신여기고 나 보기에 악을 행하였느뇨 네가 칼로 헷 사람 우리아를 죽이되 암몬 자손의 칼로 죽이고 그 처를 빼앗아 네 처를 삼았도다",
      "source_text_hash": "62b6c7d868fa47b49ae7c462c543738632fdbe8b09156e0c4c6815a30ac2edfa",
      "translation_text_hash": "d180faa92247db4dbcab0bdfef1aa77611cef04a56c89406d5c79dffca21184e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러한데 어찌하여 네가 여호와의 말씀을 업신여기고 나 보기에 악을 행하였느뇨 네가 칼로 헷 사람 우리아를 죽이되 암몬 자손의 칼로 죽이고 그 처를 빼앗아 네 처를 삼았도다"
      ],
      "raw_text_hashes": [
        "d180faa92247db4dbcab0bdfef1aa77611cef04a56c89406d5c79dffca21184e"
      ]
    },
    {
