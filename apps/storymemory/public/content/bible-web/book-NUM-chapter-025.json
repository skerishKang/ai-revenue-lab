      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 25,
          "verse": 9
        }
      ],
      "en": "Those who died by the plague were twenty-four thousand.",
      "ko": "그 염병으로 죽은 자가 이만 사천명이었더라",
      "source_text_hash": "b735bf727c5786c55af956ece5c498d60bce1130417391fff4eb6327a2fd5488",
      "translation_text_hash": "403aa87079154e4406619c9b5424d723db3f2c40884ff236859e33fd5441236b",
      "translation_policy": "krv-1961-source-mapped",
