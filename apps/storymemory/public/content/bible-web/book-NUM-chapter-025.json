        "verse": 7
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 25,
          "verse": 7
        }
      ],
      "en": "When Phinehas, the son of Eleazar, the son of Aaron the priest, saw it, he rose up from the middle of the congregation, and took a spear in his hand.",
      "ko": "제사장 아론의 손자 엘르아살의 아들 비느하스가 보고 회중의 가운데서 일어나 손에 창을 들고",
      "source_text_hash": "8ff0523552388ad1ebd248ec76be953f55f0c1dc8e410d7fee9ea5c0d7aa3cb3",
      "translation_text_hash": "85b4fd3d66eb3f0c534568b457d96f9c5fd8ff40150f020f382e9c740a66d8d7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제사장 아론의 손자 엘르아살의 아들 비느하스가 보고 회중의 가운데서 일어나 손에 창을 들고"
      ],
      "raw_text_hashes": [
        "85b4fd3d66eb3f0c534568b457d96f9c5fd8ff40150f020f382e9c740a66d8d7"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:25:8",
      "sequence": 4480,
