      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 25,
          "verse": 13
        }
      ],
      "en": "It shall be to him, and to his offspring after him, the covenant of an everlasting priesthood, because he was jealous for his God, and made atonement for the children of Israel.’”",
      "ko": "그와 그 후손에게 영원한 제사장 직분의 언약이라 그가 그 하나님을 위하여 질투하여 이스라엘 자손을 속죄하였음이니라",
      "source_text_hash": "43257cbcfd38c7de9836772d24960bdc0723d2c986e92263b5a33940475368b5",
      "translation_text_hash": "8de5c8dea5c0c4417bf28e2c4e2dfd04ee68c5d85f93118424b0b543b7cee88e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그와 그 후손에게 영원한 제사장 직분의 언약이라 그가 그 하나님을 위하여 질투하여 이스라엘 자손을 속죄하였음이니라"
      ],
      "raw_text_hashes": [
