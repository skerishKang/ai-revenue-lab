      "translation_text_hash": "22c53a128ab4247bd8361712ce6f3b53db9e48a9caad024e0609a0434b56ac90",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
