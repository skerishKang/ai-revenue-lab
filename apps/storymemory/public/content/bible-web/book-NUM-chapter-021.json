        "verse": 6
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 21,
          "verse": 6
        }
      ],
      "en": "The LORD sent venomous snakes among the people, and they bit the people. Many people of Israel died.",
      "ko": "여호와께서 불뱀들을 백성 중에 보내어 백성을 물게 하시므로 이스라엘 백성 중에 죽은 자가 많은지라",
      "source_text_hash": "ec727319d97a5f82575d411781c21efa41e2e9e4c7a24582d8310b6f24b40116",
      "translation_text_hash": "313e48def45fb0c2fc05c6aa76a9aad3af68d32bc5730e5497125c36a024c731",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 불뱀들을 백성 중에 보내어 백성을 물게 하시므로 이스라엘 백성 중에 죽은 자가 많은지라"
      ],
      "raw_text_hashes": [
        "313e48def45fb0c2fc05c6aa76a9aad3af68d32bc5730e5497125c36a024c731"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:21:7",
      "sequence": 4348,
      "chapter_label": "NUM 21",
      "verse_label": "7",
      "locator": {
        "book": "NUM",
