      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 21,
          "verse": 11
        }
      ],
      "en": "They traveled from Oboth, and encamped at Iyeabarim, in the wilderness which is before Moab, toward the sunrise.",
      "ko": "오봇에서 진행하여 모압 앞 해 돋는 편 광야 이예아바림에 진 쳤고",
      "source_text_hash": "08bd7c7733b75619f89e331386dc644f2010c6c640dad2dd49dd8fb67362d072",
      "translation_text_hash": "2ca7f0f8a02697f9e9aee964a9f2cf93404c10a591f46fe8be0b5fb1d4e744cb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오봇에서 진행하여 모압 앞 해 돋는 편 광야 이예아바림에 진 쳤고"
      ],
      "raw_text_hashes": [
        "2ca7f0f8a02697f9e9aee964a9f2cf93404c10a591f46fe8be0b5fb1d4e744cb"
      ]
    },
