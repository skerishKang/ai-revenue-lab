      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 45,
          "verse": 6
        }
      ],
      "en": "Your throne, God, is forever and ever. A scepter of equity is the scepter of your kingdom.",
      "ko": "하나님이여 주의 보좌가 영영하며 주의 나라의 홀은 공평한 홀이니이다",
      "source_text_hash": "9aca7134d86508c053dd277361b179ca1c09e9b79f390a80cccb5f8eddf12927",
      "translation_text_hash": "20e34dc9d9605cb86946f025d8030db89c485e86254df7806cd814a6cd07aadf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 주의 보좌가 영영하며 주의 나라의 홀은 공평한 홀이니이다"
      ],
      "raw_text_hashes": [
        "20e34dc9d9605cb86946f025d8030db89c485e86254df7806cd814a6cd07aadf"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:45:7",
      "sequence": 14605,
      "chapter_label": "PSA 45",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
