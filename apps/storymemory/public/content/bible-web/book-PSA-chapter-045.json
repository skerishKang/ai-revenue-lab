      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕은 인생보다 아름다워 은혜를 입술에 머금으니 그러므로 하나님이 왕에게 영영히 복을 주시도다"
      ],
      "raw_text_hashes": [
