      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "수 놓은 옷을 입은 저가 왕께로 인도함을 받으며 시종하는 동무 처녀들도 왕께로 이끌려 갈 것이라"
      ],
      "raw_text_hashes": [
        "1174e3b3b7752fa5aebe27cb98b850bff37ed2484647d8fcd957fc23118cdb7d"
