        {
          "book": "PSA",
          "chapter": 45,
          "verse": 3
        }
      ],
      "en": "Strap your sword on your thigh, O mighty one, in your splendor and your majesty.",
      "ko": "능한 자여 칼을 허리에 차고 왕의 영화와 위엄을 입으소서",
      "source_text_hash": "d14e169f81ee7746354926294903b8a9fcb1ec17ae9fcc782544cb8c10380988",
      "translation_text_hash": "ac337595e28e5e324a0de97c4990053bd87a4a03ad044052a7e7430093579447",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "능한 자여 칼을 허리에 차고 왕의 영화와 위엄을 입으소서"
      ],
      "raw_text_hashes": [
        "ac337595e28e5e324a0de97c4990053bd87a4a03ad044052a7e7430093579447"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:45:4",
      "sequence": 14602,
