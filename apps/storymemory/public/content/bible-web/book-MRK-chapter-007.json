      "translation_text_hash": "698c31c15ae1de97dbb4d7b771c021fe1d49f14e0fe158f5ab5338ad96142a74",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
