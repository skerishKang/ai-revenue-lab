        {
          "book": "MRK",
          "chapter": 7,
          "verse": 8
        }
      ],
      "en": "“For you set aside the commandment of God, and hold tightly to the tradition of men—the washing of pitchers and cups, and you do many other such things.”",
      "ko": "너희가 하나님의 계명은 버리고 사람의 유전을 지키느니라",
      "source_text_hash": "548fd16262ebd26fc77d1ccf1b8d4327b348d701c45b63eac0467d0b695b7b76",
      "translation_text_hash": "d83546d65cde8147991797854b5906415aaf51ccdb38aea39379b8abfacaf346",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 하나님의 계명은 버리고 사람의 유전을 지키느니라"
      ],
      "raw_text_hashes": [
        "d83546d65cde8147991797854b5906415aaf51ccdb38aea39379b8abfacaf346"
      ]
    },
