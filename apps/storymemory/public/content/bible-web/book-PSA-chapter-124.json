      "translation_text_hash": "d49f206f31461b554af6ba2eb85a1b9007cbb13a8b79e145f86f8d1dc8f3e8de",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
