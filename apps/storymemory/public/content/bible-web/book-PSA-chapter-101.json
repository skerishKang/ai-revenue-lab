      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사특한 마음이 내게서 떠날 것이니 악한 일을 내가 알지 아니하리로다"
      ],
      "raw_text_hashes": [
        "fae778cf99409baae6b5ca0feb8ffc80b693f33e54b5d95db37f80908a5f708f"
      ]
