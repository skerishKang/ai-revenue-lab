      "en": "the great trials which your eyes saw, the signs, and those great wonders.",
      "ko": "곧 그 큰 시험과 이적과 큰 기사를 네가 목도하였느니라",
      "source_text_hash": "3d21da259fed95736c46e0d55d9fd0ed434c99265b03b91d6fbaa1acae7dea48",
      "translation_text_hash": "3b1c053d66b0d43fd8d8db569501d34ac1955b34310f1a3bb08607f10c1a995c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "곧 그 큰 시험과 이적과 큰 기사를 네가 목도하였느니라"
      ],
      "raw_text_hashes": [
        "3b1c053d66b0d43fd8d8db569501d34ac1955b34310f1a3bb08607f10c1a995c"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:29:4",
      "sequence": 5684,
      "chapter_label": "DEU 29",
      "verse_label": "4",
      "locator": {
