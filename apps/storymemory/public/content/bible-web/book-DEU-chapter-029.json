        "verse": 4
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 29,
          "verse": 4
        }
      ],
      "en": "But the LORD has not given you a heart to know, eyes to see, and ears to hear, to this day.",
      "ko": "그러나 깨닫는 마음과 보는 눈과 듣는 귀는 오늘날까지 여호와께서 너희에게 주지 아니하셨느니라",
      "source_text_hash": "a9fd0188a5b7b0ac215e04170cf0aa9c03a6b27d8033e5eb78ef8222c948d555",
      "translation_text_hash": "b5172510fd7a2b0a8931296b72d84460ab9fcdf50496c837acc944ba0ef2ceba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 깨닫는 마음과 보는 눈과 듣는 귀는 오늘날까지 여호와께서 너희에게 주지 아니하셨느니라"
      ],
      "raw_text_hashes": [
        "b5172510fd7a2b0a8931296b72d84460ab9fcdf50496c837acc944ba0ef2ceba"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:29:5",
      "sequence": 5685,
      "chapter_label": "DEU 29",
      "verse_label": "5",
      "locator": {
        "book": "DEU",
