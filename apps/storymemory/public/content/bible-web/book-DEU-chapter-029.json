    {
      "canonical_locator": "bible:web:DEU:29:6",
      "sequence": 5686,
      "chapter_label": "DEU 29",
      "verse_label": "6",
      "locator": {
        "book": "DEU",
        "chapter": 29,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 29,
          "verse": 6
        }
      ],
      "en": "You have not eaten bread, neither have you drunk wine or strong drink, that you may know that I am the LORD your God.",
      "ko": "너희로 떡도 먹지 못하며 포도주나 독주를 마시지 못하게 하셨음은 주는 너희 하나님 여호와이신 줄을 알게 하려 하심이니라",
      "source_text_hash": "8e0383f005d515dcf87c630c4ea9f45f133e05aecaa8ea1947a51cec421b98c8",
      "translation_text_hash": "ae1f5ee7260dc21439cade6769241f5bf55705a1dc8bdac27794b801fa7d0286",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희로 떡도 먹지 못하며 포도주나 독주를 마시지 못하게 하셨음은 주는 너희 하나님 여호와이신 줄을 알게 하려 하심이니라"
      ],
      "raw_text_hashes": [
        "ae1f5ee7260dc21439cade6769241f5bf55705a1dc8bdac27794b801fa7d0286"
