        {
          "book": "ISA",
          "chapter": 38,
          "verse": 7
        }
      ],
      "en": "This shall be the sign to you from the LORD, that the LORD will do this thing that he has spoken.",
      "ko": "나 여호와가 말한 것을 네게 이룰 증거로 이 징조를 네게 주리라",
      "source_text_hash": "8d72401a4f4cb102e9cc761144d11c71cb34438794578a738ab5f29939c5019a",
      "translation_text_hash": "a4511008e4f62607ac383b7551b96a7175d851913869230f1843f437e462fb2f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나 여호와가 말한 것을 네게 이룰 증거로 이 징조를 네게 주리라"
      ],
      "raw_text_hashes": [
        "a4511008e4f62607ac383b7551b96a7175d851913869230f1843f437e462fb2f"
      ]
    },
