        }
      ],
      "en": "Now when she had weaned Lo-Ruhamah, she conceived, and bore a son.",
      "ko": "고멜이 로루하마를 젖뗀 후에 또 잉태하여 아들을 낳으매",
      "source_text_hash": "62b82e50db812c89ca382c9dbc09c6f232800e29e57316960f98930dea5ff80b",
      "translation_text_hash": "5106709521f6481e46f6c0dd5745ae61c66a620f81ba6400b1ed46e407076afd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "고멜이 로루하마를 젖뗀 후에 또 잉태하여 아들을 낳으매"
      ],
      "raw_text_hashes": [
        "5106709521f6481e46f6c0dd5745ae61c66a620f81ba6400b1ed46e407076afd"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:1:9",
      "sequence": 22104,
      "chapter_label": "HOS 1",
      "verse_label": "9",
      "locator": {
