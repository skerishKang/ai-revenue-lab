      "en": "Now the LORD’s word came to me, saying,",
      "ko": "여호와의 말씀이 내게 임하니라 이르시되",
      "source_text_hash": "1427a59272b4e738cdc60fd8a3687faf45caa2c766d2d9ab7317a06e9b6dc364",
      "translation_text_hash": "c10961067badc4e6053f89b63d34f264023d34a1f79f584a4129d4c822688852",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 내게 임하니라 이르시되"
      ],
      "raw_text_hashes": [
        "c10961067badc4e6053f89b63d34f264023d34a1f79f584a4129d4c822688852"
      ]
