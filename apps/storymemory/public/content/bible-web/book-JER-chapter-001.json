      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 가로되 슬프도소이다 주 여호와여 보소서 나는 아이라 말할 줄을 알지 못하나이다"
      ],
      "raw_text_hashes": [
