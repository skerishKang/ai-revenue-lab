      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "혹시 여호와께서 나의 원통함을 감찰하시리니 오늘날 그 저주 까닭에 선으로 내게 갚아주시리라 하고"
      ],
      "raw_text_hashes": [
