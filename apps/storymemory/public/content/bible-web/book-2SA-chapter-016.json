        "verse": 7
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 16,
          "verse": 7
        }
      ],
      "en": "Shimei said when he cursed, “Be gone, be gone, you man of blood, and wicked fellow!",
      "ko": "시므이가 저주하는 가운데 이와 같이 말하니라 피를 흘린 자여 비루한 자여 가거라 가거라",
      "source_text_hash": "87c0f6fc45963d3d30b7ce7dfa5c7134b488b987d5946a47286486861a4b4a28",
      "translation_text_hash": "f78d34504016a5860e0454b2ca3b3abd287feed27edce14fffa63506c549b67c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시므이가 저주하는 가운데 이와 같이 말하니라 피를 흘린 자여 비루한 자여 가거라 가거라"
      ],
      "raw_text_hashes": [
        "f78d34504016a5860e0454b2ca3b3abd287feed27edce14fffa63506c549b67c"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:16:8",
      "sequence": 8435,
      "chapter_label": "2SA 16",
      "verse_label": "8",
      "locator": {
        "book": "2SA",
