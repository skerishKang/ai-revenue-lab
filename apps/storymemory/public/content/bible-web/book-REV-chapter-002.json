      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다만 너희에게 있는 것을 내가 올 때까지 굳게 잡으라"
      ],
      "raw_text_hashes": [
        "bbb3b62967f3326ec85de76d1974b5119f1b395967c4f2db0a286bc2fd259466"
      ]
