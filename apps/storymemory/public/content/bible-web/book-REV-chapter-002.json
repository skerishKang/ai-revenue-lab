    {
      "canonical_locator": "bible:web:REV:2:21",
      "sequence": 30735,
      "chapter_label": "REV 2",
      "verse_label": "21",
      "locator": {
        "book": "REV",
        "chapter": 2,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 2,
          "verse": 21
        }
      ],
      "en": "I gave her time to repent, but she refuses to repent of her sexual immorality.",
      "ko": "또 내가 그에게 회개할 기회를 주었으되 그 음행을 회개하고자 아니하는도다",
      "source_text_hash": "4f05895142a879fc98bea3d0a77b09998a7d8ff62dd10cd80942701b4175c5cb",
      "translation_text_hash": "ba7aa504176cc246dc3af1749465035d730714013428c0dd63f9cd957172b07e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 내가 그에게 회개할 기회를 주었으되 그 음행을 회개하고자 아니하는도다"
      ],
      "raw_text_hashes": [
        "ba7aa504176cc246dc3af1749465035d730714013428c0dd63f9cd957172b07e"
      ]
    },
    {
      "canonical_locator": "bible:web:REV:2:22",
      "sequence": 30736,
      "chapter_label": "REV 2",
      "verse_label": "22",
      "locator": {
        "book": "REV",
