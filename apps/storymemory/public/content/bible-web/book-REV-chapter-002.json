        "verse": 19
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 2,
          "verse": 19
        }
      ],
      "en": "“I know your works, your love, faith, service, patient endurance, and that your last works are more than the first.",
      "ko": "내가 네 사업과 사랑과 믿음과 섬김과 인내를 아노니 네 나중 행위가 처음것보다 많도다",
      "source_text_hash": "c32a38e3208e1adb7126bbac21b9391ec0e153352f41723c2b5a7656bf9e95de",
      "translation_text_hash": "7deda893763be1921625b51f00a3be5e05968303d52ca1d3c781280fccc69d07",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 네 사업과 사랑과 믿음과 섬김과 인내를 아노니 네 나중 행위가 처음것보다 많도다"
      ],
      "raw_text_hashes": [
        "7deda893763be1921625b51f00a3be5e05968303d52ca1d3c781280fccc69d07"
      ]
