        {
          "book": "REV",
          "chapter": 2,
          "verse": 4
        }
      ],
      "en": "But I have this against you, that you left your first love.",
      "ko": "그러나 너를 책망할 것이 있나니 너의 처음 사랑을 버렸느니라",
      "source_text_hash": "903379c269da209b0fee446a894842b8ccf3770e711513078d12689833f2e23d",
      "translation_text_hash": "0f9f299bee61ed87e0dae7d78b43b41de332a555183564290a6241ef392c5f39",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 너를 책망할 것이 있나니 너의 처음 사랑을 버렸느니라"
      ],
      "raw_text_hashes": [
        "0f9f299bee61ed87e0dae7d78b43b41de332a555183564290a6241ef392c5f39"
      ]
    },
    {
      "canonical_locator": "bible:web:REV:2:5",
      "sequence": 30719,
      "chapter_label": "REV 2",
      "verse_label": "5",
      "locator": {
