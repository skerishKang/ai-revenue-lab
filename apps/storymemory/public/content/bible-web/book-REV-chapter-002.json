    {
      "canonical_locator": "bible:web:REV:2:10",
      "sequence": 30724,
      "chapter_label": "REV 2",
      "verse_label": "10",
      "locator": {
        "book": "REV",
        "chapter": 2,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 2,
          "verse": 10
        }
      ],
      "en": "Don’t be afraid of the things which you are about to suffer. Behold, the devil is about to throw some of you into prison, that you may be tested; and you will have oppression for ten days. Be faithful to death, and I will give you the crown of life.",
      "ko": "네가 장차 받을 고난을 두려워 말라 볼찌어다 마귀가 장차 너희 가운데서 몇 사람을 옥에 던져 시험을 받게 하리니 너희가 십일 동안 환난을 받으리라 네가 죽도록 충성하라 그리하면 내가 생명의 면류관을 네게 주리라",
      "source_text_hash": "63f8aaa7a1b20596f802879c3408502057f92ef75d26d96eac76e2334e47b08d",
      "translation_text_hash": "41edf0a4cc1ba90bca95a08c832be403d70d08630a3cb883b48eb784063cfa00",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 장차 받을 고난을 두려워 말라 볼찌어다 마귀가 장차 너희 가운데서 몇 사람을 옥에 던져 시험을 받게 하리니 너희가 십일 동안 환난을 받으리라 네가 죽도록 충성하라 그리하면 내가 생명의 면류관을 네게 주리라"
      ],
      "raw_text_hashes": [
        "41edf0a4cc1ba90bca95a08c832be403d70d08630a3cb883b48eb784063cfa00"
      ]
    },
