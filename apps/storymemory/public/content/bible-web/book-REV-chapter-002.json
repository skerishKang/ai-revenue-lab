      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에베소 교회의 사자에게 편지하기를 오른손에 일곱 별을 붙잡고 일곱 금 촛대 사이에 다니시는 이가 가라사대"
      ],
      "raw_text_hashes": [
        "3ea2b38041c9763725d5c6d2730317bb29b4e8d1e8f46147649d18a9c6c97b3f"
