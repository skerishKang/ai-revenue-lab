      "raw_locator": [
        {
          "book": "REV",
          "chapter": 2,
          "verse": 3
        }
      ],
      "en": "You have perseverance and have endured for my name’s sake, and have not grown weary.",
      "ko": "또 네가 참고 내 이름을 위하여 견디고 게으르지 아니한 것을 아노라",
      "source_text_hash": "3aefdf012849bb0dd944ad81844eed6acece60cb8b7946fe0754b5654d9d58ce",
      "translation_text_hash": "59cd15dff420825c4a56c2a897ca21703b514f5ee105536443c94e6d61d776b4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 네가 참고 내 이름을 위하여 견디고 게으르지 아니한 것을 아노라"
      ],
      "raw_text_hashes": [
        "59cd15dff420825c4a56c2a897ca21703b514f5ee105536443c94e6d61d776b4"
      ]
    },
    {
      "canonical_locator": "bible:web:REV:2:4",
      "sequence": 30718,
