      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 31,
          "verse": 6
        }
      ],
      "en": "Give strong drink to him who is ready to perish, and wine to the bitter in soul.",
      "ko": "독주는 죽게된 자에게, 포도주는 마음에 근심하는 자에게 줄찌어다",
      "source_text_hash": "c71a2251d4bc75982507c9e1d62577d24cf29c63ef11ab38fbe649db2675abce",
      "translation_text_hash": "6c0e4ea7f4420ff701311079cb11f60f8c8901c3ae41603d0fe07763870a9ce5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "독주는 죽게된 자에게, 포도주는 마음에 근심하는 자에게 줄찌어다"
      ],
      "raw_text_hashes": [
        "6c0e4ea7f4420ff701311079cb11f60f8c8901c3ae41603d0fe07763870a9ce5"
      ]
    },
