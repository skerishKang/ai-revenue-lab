      "translation_text_hash": "f34f27ca530c1d665b4d270fbc63e100bf09636abd2c9f09c976ec7055577999",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "르무엘왕의 말씀한바 곧 그 어머니가 그를 훈계한 잠언이라"
      ],
      "raw_text_hashes": [
        "f34f27ca530c1d665b4d270fbc63e100bf09636abd2c9f09c976ec7055577999"
      ]
    },
    {
