      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 급히 군사들과 백부장들을 거느리고 달려 내려가니 저희가 천부장과 군사들을 보고 바울 치기를 그치는지라"
      ],
      "raw_text_hashes": [
