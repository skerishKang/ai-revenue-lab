      "translation_text_hash": "9c9a3e3ec573c04d1e04658d25c4face5987644378cdbd2d5922c852cefea745",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
