      "raw_locator": [
        {
          "book": "ZEC",
          "chapter": 2,
          "verse": 11
        }
      ],
      "en": "Many nations shall join themselves to the LORD in that day, and shall be my people; and I will dwell among you, and you shall know that the LORD of Armies has sent me to you.",
      "ko": "그 날에 많은 나라가 여호와께 속하여 내 백성이 될 것이요 나는 네 가운데 거하리라 네가 만군의 여호와께서 나를 네게 보내신줄 알리라",
      "source_text_hash": "5cc523f3f78bab923d854a52decd7ee23844dd949e0cea55fa5258845ee17b71",
      "translation_text_hash": "541e4b54e0d91cca027bec67e6eca84685623b363ca79542a8d99cefd09f4a78",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 날에 많은 나라가 여호와께 속하여 내 백성이 될 것이요 나는 네 가운데 거하리라 네가 만군의 여호와께서 나를 네게 보내신줄 알리라"
      ],
      "raw_text_hashes": [
        "541e4b54e0d91cca027bec67e6eca84685623b363ca79542a8d99cefd09f4a78"
