        }
      ],
      "en": "‘Come, Zion! Escape, you who dwell with the daughter of Babylon.’",
      "ko": "바벨론 성에 거하는 시온아 이제 너는 피할찌니라",
      "source_text_hash": "84ebaa415181d112f078136c7667b291e1f1456c4bfab1017728c838afd96636",
      "translation_text_hash": "2829db85adcf86886ac25036d29b3e5920f730b64e480224050f9ab20933d908",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바벨론 성에 거하는 시온아 이제 너는 피할찌니라"
      ],
      "raw_text_hashes": [
        "2829db85adcf86886ac25036d29b3e5920f730b64e480224050f9ab20933d908"
      ]
    },
    {
      "canonical_locator": "bible:web:ZEC:2:8",
      "sequence": 22908,
      "chapter_label": "ZEC 2",
      "verse_label": "8",
