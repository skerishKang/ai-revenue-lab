        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 11
        }
      ],
      "en": "Why do you draw back your hand, even your right hand? Take it from your chest and consume them!",
      "ko": "주께서 어찌하여 주의 손 곧 오른손을 거두시나이까 주의 품에서 빼사 저희를 멸하소서",
      "source_text_hash": "54936c3535283f6c731bc2f88c8c971262ee78382f1c3edec3c3651829f2d83a",
      "translation_text_hash": "a3509e7c8ab9f4e085ed56defe08408e1f3c0accb50ee3fee1d5b59c6b0594f6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 어찌하여 주의 손 곧 오른손을 거두시나이까 주의 품에서 빼사 저희를 멸하소서"
      ],
      "raw_text_hashes": [
        "a3509e7c8ab9f4e085ed56defe08408e1f3c0accb50ee3fee1d5b59c6b0594f6"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:12",
      "sequence": 15061,
      "chapter_label": "PSA 74",
      "verse_label": "12",
      "locator": {
