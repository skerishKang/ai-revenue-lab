        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 12
        }
      ],
      "en": "Yet God is my King of old, working salvation throughout the earth.",
      "ko": "하나님은 예로부터 나의 왕이시라 인간에 구원을 베푸셨나이다",
      "source_text_hash": "434c3b1ef2aa750ea56035789cfe41ecb6a65cba21eb593ed1d90c4ae79d1789",
      "translation_text_hash": "195aaac69c32235ccb5a052e676bd814bb13dfb65eb217d8fc4ef2836d875b99",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님은 예로부터 나의 왕이시라 인간에 구원을 베푸셨나이다"
      ],
      "raw_text_hashes": [
        "195aaac69c32235ccb5a052e676bd814bb13dfb65eb217d8fc4ef2836d875b99"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:13",
      "sequence": 15062,
      "chapter_label": "PSA 74",
      "verse_label": "13",
      "locator": {
        "book": "PSA",
        "chapter": 74,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 13
        }
      ],
      "en": "You divided the sea by your strength. You broke the heads of the sea monsters in the waters.",
      "ko": "주께서 주의 능력으로 바다를 나누시고 물 가운데 용들의 머리를 깨뜨리셨으며",
      "source_text_hash": "df9d001c9ec7c533ce12c3df55bde269b08932f8c4f26c29ca56512e35ce4bbb",
      "translation_text_hash": "130e2e6114d762095c29b478c03f8dbc5dcc78cbaaa2dbccbb402b0d77b862dc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 주의 능력으로 바다를 나누시고 물 가운데 용들의 머리를 깨뜨리셨으며"
      ],
      "raw_text_hashes": [
        "130e2e6114d762095c29b478c03f8dbc5dcc78cbaaa2dbccbb402b0d77b862dc"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:14",
      "sequence": 15063,
      "chapter_label": "PSA 74",
      "verse_label": "14",
      "locator": {
        "book": "PSA",
        "chapter": 74,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 14
        }
      ],
      "en": "You broke the heads of Leviathan in pieces. You gave him as food to people and desert creatures.",
      "ko": "악어의 머리를 파쇄하시고 그것을 사막에 거하는 자에게 식물로 주셨으며",
      "source_text_hash": "4c9fc0a175fbd356ebe2f41ecbb6886107f400dde03043a7ab16e7bfa18997f5",
      "translation_text_hash": "dbff908a3e9fd5923c81cb82b0abc5a1d0f690f682dfad4c99417f3ca79ae1d2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악어의 머리를 파쇄하시고 그것을 사막에 거하는 자에게 식물로 주셨으며"
      ],
      "raw_text_hashes": [
        "dbff908a3e9fd5923c81cb82b0abc5a1d0f690f682dfad4c99417f3ca79ae1d2"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:15",
      "sequence": 15064,
      "chapter_label": "PSA 74",
      "verse_label": "15",
      "locator": {
        "book": "PSA",
        "chapter": 74,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 15
        }
      ],
      "en": "You opened up spring and stream. You dried up mighty rivers.",
      "ko": "바위를 쪼개사 큰 물을 내시며 길이 흐르는 강들을 말리우셨나이다",
      "source_text_hash": "108b9c230cabf21ec850961b87bfe0ba6b98973a54b2c4c3bfe909616662ec3a",
