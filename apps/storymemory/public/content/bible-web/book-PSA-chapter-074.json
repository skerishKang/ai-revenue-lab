        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 6
        }
      ],
      "en": "Now they break all its carved work down with hatchet and hammers.",
      "ko": "이제 저희가 도끼와 철퇴로 성소의 모든 조각품을 쳐서 부수고",
      "source_text_hash": "c1c29ad43de28b3f9ec072865e6e66b2265e5d6933e04c3d98de58e31e986ecc",
      "translation_text_hash": "325bf4a642767c4ec6d66d99a288639617cfe6c8fd58c0185a3ad6a3b7a987f8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이제 저희가 도끼와 철퇴로 성소의 모든 조각품을 쳐서 부수고"
      ],
      "raw_text_hashes": [
        "325bf4a642767c4ec6d66d99a288639617cfe6c8fd58c0185a3ad6a3b7a987f8"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:7",
      "sequence": 15056,
      "chapter_label": "PSA 74",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 74,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 7
        }
      ],
      "en": "They have burned your sanctuary to the ground. They have profaned the dwelling place of your Name.",
      "ko": "주의 성소를 불사르며 주의 이름이 계신 곳을 더럽혀 땅에 엎었나이다",
      "source_text_hash": "3235052924aa983985ccb9fb73e96320c4efbc1372d0a2aa0fcb59f2ef252f29",
      "translation_text_hash": "96ed24168b50b3355a24a4fbbc1be46a304d2d1e5ca4241dff014000fb71b056",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 성소를 불사르며 주의 이름이 계신 곳을 더럽혀 땅에 엎었나이다"
      ],
      "raw_text_hashes": [
        "96ed24168b50b3355a24a4fbbc1be46a304d2d1e5ca4241dff014000fb71b056"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:8",
      "sequence": 15057,
      "chapter_label": "PSA 74",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
        "chapter": 74,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 8
        }
      ],
      "en": "They said in their heart, “We will crush them completely.” They have burned up all the places in the land where God was worshiped.",
      "ko": "저희의 마음에 이르기를 우리가 그것을 진멸하자 하고 이 땅에 있는 하나님의 모든 회당을 불살랐나이다",
      "source_text_hash": "cb32d2c2dcfa9c14cc3e1d4fa39d48e81c2b4bfed03ee927d6689e6dbb4467bf",
      "translation_text_hash": "67251d0fbc8264967ec666d897f959854ebc1221453d21dc35584dd7cb6ebbf0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희의 마음에 이르기를 우리가 그것을 진멸하자 하고 이 땅에 있는 하나님의 모든 회당을 불살랐나이다"
      ],
      "raw_text_hashes": [
        "67251d0fbc8264967ec666d897f959854ebc1221453d21dc35584dd7cb6ebbf0"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:9",
      "sequence": 15058,
      "chapter_label": "PSA 74",
      "verse_label": "9",
      "locator": {
        "book": "PSA",
        "chapter": 74,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 74,
          "verse": 9
        }
      ],
      "en": "We see no miraculous signs. There is no longer any prophet, neither is there among us anyone who knows how long.",
      "ko": "우리의 표적이 보이지 아니하며 선지자도 다시 없으며 이런 일이 얼마나 오랠는지 우리 중에 아는 자도 없나이다",
      "source_text_hash": "1e4fd9d1141138696ceef498eecfab5b2dc89fd3b26d55b73302cd0bf02cf2fc",
      "translation_text_hash": "8d036f572cb663d3e890f9222bc60ce5c287aaab43572d05106c4ee55529652b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리의 표적이 보이지 아니하며 선지자도 다시 없으며 이런 일이 얼마나 오랠는지 우리 중에 아는 자도 없나이다"
      ],
      "raw_text_hashes": [
        "8d036f572cb663d3e890f9222bc60ce5c287aaab43572d05106c4ee55529652b"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:74:10",
      "sequence": 15059,
      "chapter_label": "PSA 74",
      "verse_label": "10",
      "locator": {
        "book": "PSA",
