        "chapter": 1,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HAB",
          "chapter": 1,
          "verse": 6
        }
      ],
      "en": "For, behold, I am raising up the Chaldeans, that bitter and hasty nation who march through the width of the earth, to possess dwelling places that are not theirs.",
      "ko": "보라 내가 사납고 성급한 백성 곧 땅의 넓은 곳으로 다니며 자기의 소유 아닌 거할 곳들을 점령하는 갈대아 사람을 일으켰나니",
      "source_text_hash": "32daa11c58fd150da7c21d7f18c19255ac8f3db7e25a9a40179f7265ef992b01",
      "translation_text_hash": "ef46037edba07829f29f3bb18f878290b36cfcfac0114b9f25a0d830ab5317ca",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 내가 사납고 성급한 백성 곧 땅의 넓은 곳으로 다니며 자기의 소유 아닌 거할 곳들을 점령하는 갈대아 사람을 일으켰나니"
      ],
      "raw_text_hashes": [
        "ef46037edba07829f29f3bb18f878290b36cfcfac0114b9f25a0d830ab5317ca"
      ]
    },
    {
      "canonical_locator": "bible:web:HAB:1:7",
      "sequence": 22739,
      "chapter_label": "HAB 1",
      "verse_label": "7",
      "locator": {
