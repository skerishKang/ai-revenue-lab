        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 5
        }
      ],
      "en": "By awesome deeds of righteousness, you answer us, God of our salvation. You who are the hope of all the ends of the earth, of those who are far away on the sea.",
      "ko": "우리 구원의 하나님이시여 땅의 모든 끝과 먼 바다에 있는 자의 의지할 주께서 의를 좇아 엄위하신 일로 우리에게 응답하시리이다",
      "source_text_hash": "4dd7f4476b01f78e73633ee77fdb343c3e49344c334b1f57c986020668d10ab3",
      "translation_text_hash": "cfc03cbf23ab13792194a0472aaceb7507dbc856bebc032468bde2b8e60d69da",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 구원의 하나님이시여 땅의 모든 끝과 먼 바다에 있는 자의 의지할 주께서 의를 좇아 엄위하신 일로 우리에게 응답하시리이다"
      ],
      "raw_text_hashes": [
        "cfc03cbf23ab13792194a0472aaceb7507dbc856bebc032468bde2b8e60d69da"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:6",
      "sequence": 14867,
      "chapter_label": "PSA 65",
      "verse_label": "6",
      "locator": {
