        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 6
        }
      ],
      "en": "By your power, you form the mountains, having armed yourself with strength.",
      "ko": "주는 주의 힘으로 산을 세우시며 권능으로 띠를 띠시며",
      "source_text_hash": "6388c851d86dfe3d0f89213816e1c1389022948dc62ebb243cd461e9409d64c8",
      "translation_text_hash": "aee73dad4cf661be4a9e8501c6b227e4acd866eadaa377f21f765516fac8ac2d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주는 주의 힘으로 산을 세우시며 권능으로 띠를 띠시며"
      ],
      "raw_text_hashes": [
        "aee73dad4cf661be4a9e8501c6b227e4acd866eadaa377f21f765516fac8ac2d"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:7",
      "sequence": 14868,
      "chapter_label": "PSA 65",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 65,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 7
        }
      ],
      "en": "You still the roaring of the seas, the roaring of their waves, and the turmoil of the nations.",
      "ko": "바다의 흉용과 물결의 요동과 만민의 훤화까지 진정하시나이다",
      "source_text_hash": "d4ff3fc2519e661080ad689b6d31f065f4a9a5365e8f3660ce86657b33e2118c",
      "translation_text_hash": "71153b7ce6adb58999bab34bfce7a40fe1fb2862fbf9a24a2c6b68918d381fbf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바다의 흉용과 물결의 요동과 만민의 훤화까지 진정하시나이다"
      ],
      "raw_text_hashes": [
        "71153b7ce6adb58999bab34bfce7a40fe1fb2862fbf9a24a2c6b68918d381fbf"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:8",
      "sequence": 14869,
      "chapter_label": "PSA 65",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
        "chapter": 65,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 8
        }
      ],
      "en": "They also who dwell in faraway places are afraid at your wonders. You call the morning’s dawn and the evening with songs of joy.",
      "ko": "땅 끝에 거하는 자가 주의 징조를 두려워하나이다 주께서 아침 되는 것과 저녁 되는 것을 즐거워하게 하시며",
      "source_text_hash": "7e786850bfee6b0e74065133d08a7d500dc154bd05f4091d6b999188aaf30d0d",
      "translation_text_hash": "9b5b50bd3c6bed962fb28dcb5e13819da5c9b5176d82c4788b8dc392beef2503",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "땅 끝에 거하는 자가 주의 징조를 두려워하나이다 주께서 아침 되는 것과 저녁 되는 것을 즐거워하게 하시며"
      ],
      "raw_text_hashes": [
        "9b5b50bd3c6bed962fb28dcb5e13819da5c9b5176d82c4788b8dc392beef2503"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:9",
      "sequence": 14870,
      "chapter_label": "PSA 65",
      "verse_label": "9",
      "locator": {
        "book": "PSA",
        "chapter": 65,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 9
        }
      ],
      "en": "You visit the earth, and water it. You greatly enrich it. The river of God is full of water. You provide them grain, for so you have ordained it.",
      "ko": "땅을 권고하사 물을 대어 심히 윤택케 하시며 하나님의 강에 물이 가득하게 하시고 이 같이 땅을 예비하신 후에 저희에게 곡식을 주시나이다",
      "source_text_hash": "cc1acc090786817a7e74ab2a047619cdb89ede863558146debfbe5c399330c28",
      "translation_text_hash": "593f242e96a071ab3ff01fb4124d19c0638a3a76ea060c659af0974573707706",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "땅을 권고하사 물을 대어 심히 윤택케 하시며 하나님의 강에 물이 가득하게 하시고 이 같이 땅을 예비하신 후에 저희에게 곡식을 주시나이다"
      ],
      "raw_text_hashes": [
        "593f242e96a071ab3ff01fb4124d19c0638a3a76ea060c659af0974573707706"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:10",
      "sequence": 14871,
      "chapter_label": "PSA 65",
      "verse_label": "10",
      "locator": {
        "book": "PSA",
        "chapter": 65,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 10
        }
      ],
      "en": "You drench its furrows. You level its ridges. You soften it with showers. You bless it with a crop.",
      "ko": "주께서 밭고랑에 물을 넉넉히 대사 그 이랑을 평평하게 하시며 또 단 비로 부드럽게 하시고 그 싹에 복 주시나이다",
      "source_text_hash": "2b699d32214eb859d074e0da14e22748848ce1b9f1164c5bd95b4bada2a197f6",
      "translation_text_hash": "3ec6d38c617df871cdede05cb8a9fa946d5de4e2b58a1285f1dfe48c79cd50b9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 밭고랑에 물을 넉넉히 대사 그 이랑을 평평하게 하시며 또 단 비로 부드럽게 하시고 그 싹에 복 주시나이다"
      ],
      "raw_text_hashes": [
        "3ec6d38c617df871cdede05cb8a9fa946d5de4e2b58a1285f1dfe48c79cd50b9"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:11",
      "sequence": 14872,
      "chapter_label": "PSA 65",
      "verse_label": "11",
      "locator": {
        "book": "PSA",
        "chapter": 65,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 11
        }
      ],
      "en": "You crown the year with your bounty. Your carts overflow with abundance.",
      "ko": "주의 은택으로 년사에 관 씌우시니 주의 길에는 기름이 떨어지며",
      "source_text_hash": "203c5ea7ac6a39ded18bae2dfcd6cdb0eb7d12d88934d3bb2d8d122f5d316dcf",
      "translation_text_hash": "dda63d6471be8e59e2b25c6381414e25d08c80e2a0fc4b7c47e154c71406003b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 은택으로 년사에 관 씌우시니 주의 길에는 기름이 떨어지며"
      ],
      "raw_text_hashes": [
        "dda63d6471be8e59e2b25c6381414e25d08c80e2a0fc4b7c47e154c71406003b"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:12",
      "sequence": 14873,
      "chapter_label": "PSA 65",
      "verse_label": "12",
      "locator": {
        "book": "PSA",
        "chapter": 65,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 12
        }
      ],
      "en": "The wilderness grasslands overflow. The hills are clothed with gladness.",
      "ko": "들의 초장에도 떨어지니 작은 산들이 기쁨으로 띠를 띠었나이다",
      "source_text_hash": "22328f1b887265ab0027d66f150beacb6bf2433881ac0ea45b524e2f878dc548",
      "translation_text_hash": "4153e60af6adb80d72f7eea473e5cd279e8881acc91f939f7612b499d4c8458c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "들의 초장에도 떨어지니 작은 산들이 기쁨으로 띠를 띠었나이다"
      ],
      "raw_text_hashes": [
        "4153e60af6adb80d72f7eea473e5cd279e8881acc91f939f7612b499d4c8458c"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:13",
      "sequence": 14874,
      "chapter_label": "PSA 65",
      "verse_label": "13",
      "locator": {
        "book": "PSA",
        "chapter": 65,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 13
        }
      ],
      "en": "The pastures are covered with flocks. The valleys also are clothed with grain. They shout for joy! They also sing.",
      "ko": "초장에는 양떼가 입혔고 골짜기에는 곡식이 덮였으매 저희가 다 즐거이 외치고 또 노래하나이다",
      "source_text_hash": "95ca490dc42e9f1213d40de06c47890797b9973bbe81cac87dd093eed9c0175f",
      "translation_text_hash": "d319ad7951b4ba9c01ac484bd86b0b32368c35344fe5449df971fcb25f8678e3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "초장에는 양떼가 입혔고 골짜기에는 곡식이 덮였으매 저희가 다 즐거이 외치고 또 노래하나이다"
      ],
      "raw_text_hashes": [
        "d319ad7951b4ba9c01ac484bd86b0b32368c35344fe5449df971fcb25f8678e3"
      ]
    }
  ]
