      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 65,
          "verse": 2
        }
      ],
      "en": "You who hear prayer, all men will come to you.",
      "ko": "기도를 들으시는 주여 모든 육체가 주께 나아오리이다",
      "source_text_hash": "e5e9293c13e69e47eae22439617372ac5926ccd24767e8a85e9b9d0c75e5f32e",
      "translation_text_hash": "1cffa5750e4b7c1fbbc1fefb6bc26a9279347ca8fe5d879fa3cb668b2388bf9b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "기도를 들으시는 주여 모든 육체가 주께 나아오리이다"
      ],
      "raw_text_hashes": [
        "1cffa5750e4b7c1fbbc1fefb6bc26a9279347ca8fe5d879fa3cb668b2388bf9b"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:65:3",
      "sequence": 14864,
