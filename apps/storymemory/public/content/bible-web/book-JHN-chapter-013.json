      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "마귀가 벌써 시몬의 아들 가룟 유다의 마음에 예수를 팔려는 생각을 넣었더니"
      ],
      "raw_text_hashes": [
        "63d0fbee3025bebc83fd9e55995e72dd2b3af1583ccd7dc3720d209467bd7a3d"
      ]
    },
