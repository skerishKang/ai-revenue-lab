        "verse": 37
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 13,
          "verse": 37
        }
      ],
      "en": "Peter said to him, “Lord, why can’t I follow you now? I will lay down my life for you.”",
      "ko": "베드로가 가로되 주여 내가 지금은 어찌하여 따를 수 없나이까 주를 위하여 내 목숨을 버리겠나이다",
      "source_text_hash": "4305a109f3560fa83ad1a002cd4ec44a114386f3759394228238faab0b09b312",
      "translation_text_hash": "828b0cf1c48fa82e5b62b0a956dfd329163584d8d2b43e1efe85c0d4feffecbe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "베드로가 가로되 주여 내가 지금은 어찌하여 따를 수 없나이까 주를 위하여 내 목숨을 버리겠나이다"
      ],
      "raw_text_hashes": [
        "828b0cf1c48fa82e5b62b0a956dfd329163584d8d2b43e1efe85c0d4feffecbe"
      ]
