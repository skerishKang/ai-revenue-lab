    {
      "canonical_locator": "bible:web:JHN:13:34",
      "sequence": 26664,
      "chapter_label": "JHN 13",
      "verse_label": "34",
      "locator": {
        "book": "JHN",
        "chapter": 13,
        "verse": 34
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 13,
          "verse": 34
        }
      ],
      "en": "A new commandment I give to you, that you love one another. Just as I have loved you, you also love one another.",
      "ko": "새 계명을 너희에게 주노니 서로 사랑하라 내가 너희를 사랑한것 같이 너희도 서로 사랑하라",
      "source_text_hash": "ecb8c757586e5dafb721997839ab08e930f2b816e749147723eed2fbd012137c",
      "translation_text_hash": "da5620c2043b0cced35764a4d32abdb6599f1b78bc8ce22246864589efb90417",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "새 계명을 너희에게 주노니 서로 사랑하라 내가 너희를 사랑한것 같이 너희도 서로 사랑하라"
      ],
      "raw_text_hashes": [
        "da5620c2043b0cced35764a4d32abdb6599f1b78bc8ce22246864589efb90417"
      ]
