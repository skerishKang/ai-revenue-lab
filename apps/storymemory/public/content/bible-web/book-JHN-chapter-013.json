      "raw_texts": [
        "너희가 나를 선생이라 또는 주라 하니 너희 말이 옳도다 내가 그러하다"
      ],
      "raw_text_hashes": [
        "eefbc786457f4c189dba456c2a839ff7ea2f994f8c50a719409d25f74255557f"
      ]
