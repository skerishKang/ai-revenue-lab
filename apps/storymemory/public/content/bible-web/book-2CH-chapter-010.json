        "verse": 7
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 10,
          "verse": 7
        }
      ],
      "en": "They spoke to him, saying, “If you are kind to these people, please them, and speak good words to them, then they will be your servants forever.”",
      "ko": "대답하여 가로되 왕이 만일 이 백성을 후대하여 기쁘게하고 선한 말을 하시면 저희가 영영히 왕의 종이 되리이다 하나",
      "source_text_hash": "dc880fd35b42ac84d40b9b604b9d5206b747866beff1357bf6d24968182589d7",
      "translation_text_hash": "30f16858a49b7c09f98fda9ab25b5bfc127f3673333dd3fa38d12bac1c774b40",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대답하여 가로되 왕이 만일 이 백성을 후대하여 기쁘게하고 선한 말을 하시면 저희가 영영히 왕의 종이 되리이다 하나"
      ],
      "raw_text_hashes": [
        "30f16858a49b7c09f98fda9ab25b5bfc127f3673333dd3fa38d12bac1c774b40"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:10:8",
      "sequence": 11404,
      "chapter_label": "2CH 10",
      "verse_label": "8",
