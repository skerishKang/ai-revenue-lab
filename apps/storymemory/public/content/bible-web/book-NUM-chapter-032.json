      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 32,
          "verse": 29
        }
      ],
      "en": "Moses said to them, “If the children of Gad and the children of Reuben will pass with you over the Jordan, every man who is armed to battle before the LORD, and the land is subdued before you, then you shall give them the land of Gilead for a possession;",
      "ko": "모세가 그들에게 이르되 갓 자손과 르우벤 자손이 만일 각기 무장하고 너희와 함께 요단을 건너가서 여호와 앞에서 싸워서 그 땅이 너희 앞에 항복하기에 이르거든 길르앗 땅을 그들에게 산업으로 줄 것이니라",
      "source_text_hash": "9e42e37b5a2a5e5d867e5c2bbabb6cad6b82d7de96fc55e087c9a253e0baf424",
      "translation_text_hash": "1cb40e3dceee3d51917c96bf012f8723f83a55af68bea57fe94adfcd7ba7abe9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세가 그들에게 이르되 갓 자손과 르우벤 자손이 만일 각기 무장하고 너희와 함께 요단을 건너가서 여호와 앞에서 싸워서 그 땅이 너희 앞에 항복하기에 이르거든 길르앗 땅을 그들에게 산업으로 줄 것이니라"
      ],
      "raw_text_hashes": [
        "1cb40e3dceee3d51917c96bf012f8723f83a55af68bea57fe94adfcd7ba7abe9"
      ]
    },
