      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 32,
          "verse": 3
        }
      ],
      "en": "“Ataroth, Dibon, Jazer, Nimrah, Heshbon, Elealeh, Sebam, Nebo, and Beon,",
      "ko": "아다롯과 디본과 야셀과 니므라와 헤스본과 엘르알레와 스밤과 느보와 브온",
      "source_text_hash": "d274cb90d03bd6186bc5d6415e62d35a22d7e61362f8d883e12c9c5bc3534e48",
      "translation_text_hash": "4604f8acab13b14fc68ebbbe2b197d2cb402a90bb6c0bdd97c804710559e73f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아다롯과 디본과 야셀과 니므라와 헤스본과 엘르알레와 스밤과 느보와 브온"
      ],
      "raw_text_hashes": [
        "4604f8acab13b14fc68ebbbe2b197d2cb402a90bb6c0bdd97c804710559e73f5"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:32:4",
      "sequence": 4723,
