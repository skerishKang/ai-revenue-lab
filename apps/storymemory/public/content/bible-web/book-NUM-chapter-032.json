      "source_text_hash": "24e4bd18eb1f4777b398fe73215969238a11540b418c745ee47513ff29751810",
      "translation_text_hash": "9f033d4a7ebda9abf6bd9f2c2edaa9cc594f375b1800e962abb9faad741c2112",
