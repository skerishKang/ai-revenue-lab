        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 140,
          "verse": 9
        }
      ],
      "en": "As for the head of those who surround me, let the mischief of their own lips cover them.",
      "ko": "나를 에우는 자가 그 머리를 들 때에 저희 입술의 해가 저희를 덮게 하소서",
      "source_text_hash": "a6c0b54cd55ec8ae756be2919705a610969ec53568a80bc8284f17230f3b334e",
      "translation_text_hash": "11fece80f653b36fec5634828e79e88f3b048bfddab837c3df305694dcd0c15e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 에우는 자가 그 머리를 들 때에 저희 입술의 해가 저희를 덮게 하소서"
      ],
      "raw_text_hashes": [
        "11fece80f653b36fec5634828e79e88f3b048bfddab837c3df305694dcd0c15e"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:140:10",
      "sequence": 16274,
      "chapter_label": "PSA 140",
      "verse_label": "10",
      "locator": {
