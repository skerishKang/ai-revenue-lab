        {
          "book": "PSA",
          "chapter": 140,
          "verse": 2
        }
      ],
      "en": "those who devise mischief in their hearts. They continually gather themselves together for war.",
      "ko": "저희가 중심에 해하기를 꾀하고 싸우기 위하여 매일 모이오며",
      "source_text_hash": "25e9fc9f8fc057bf97bdab4493df031b144a661c9f02ad39dae162afc369ed6e",
      "translation_text_hash": "48ee771500ab5a8a7012e5340fc88f85e9e32c7a29c9d3d614385681912d4314",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 중심에 해하기를 꾀하고 싸우기 위하여 매일 모이오며"
      ],
      "raw_text_hashes": [
        "48ee771500ab5a8a7012e5340fc88f85e9e32c7a29c9d3d614385681912d4314"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:140:3",
      "sequence": 16267,
      "chapter_label": "PSA 140",
      "verse_label": "3",
      "locator": {
        "book": "PSA",
