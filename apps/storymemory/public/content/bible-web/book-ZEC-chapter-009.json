        "verse": 5
      },
      "raw_locator": [
        {
          "book": "ZEC",
          "chapter": 9,
          "verse": 5
        }
      ],
      "en": "Ashkelon will see it, and fear; Gaza also, and will writhe in agony; as will Ekron, for her expectation will be disappointed; and the king will perish from Gaza, and Ashkelon will not be inhabited.",
      "ko": "아스글론이 보고 무서워하며 가사도 심히 아파할 것이며 에그론은 그 소망이 수치가 되므로 역시 그러하리라 가사에는 임금이 끊칠 것이며 아스글론에는 거민이 없을 것이며",
      "source_text_hash": "93cf6d8fc4a7f4a1a59141168c9eb340575ac1650bace307c8eaaf9f36d700d0",
      "translation_text_hash": "abb9ad9b697b161e8acf816b371c6147d7015c747949da8106f391e3bd665e54",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아스글론이 보고 무서워하며 가사도 심히 아파할 것이며 에그론은 그 소망이 수치가 되므로 역시 그러하리라 가사에는 임금이 끊칠 것이며 아스글론에는 거민이 없을 것이며"
      ],
      "raw_text_hashes": [
        "abb9ad9b697b161e8acf816b371c6147d7015c747949da8106f391e3bd665e54"
      ]
    },
    {
      "canonical_locator": "bible:web:ZEC:9:6",
      "sequence": 23006,
      "chapter_label": "ZEC 9",
      "verse_label": "6",
      "locator": {
        "book": "ZEC",
        "chapter": 9,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "ZEC",
          "chapter": 9,
          "verse": 6
        }
      ],
      "en": "Foreigners will dwell in Ashdod, and I will cut off the pride of the Philistines.",
      "ko": "아스돗에는 잡족이 거하리라 내가 블레셋 사람의 교만을 끊고",
      "source_text_hash": "b7f816c660b9ce34d6f527bf739f4e8abad121155568ac3e2d40ae61e89dc128",
      "translation_text_hash": "d044c38196f57ac26d140f6daa1b072076158ff7fea02e203711dc56fd909f05",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아스돗에는 잡족이 거하리라 내가 블레셋 사람의 교만을 끊고"
      ],
      "raw_text_hashes": [
        "d044c38196f57ac26d140f6daa1b072076158ff7fea02e203711dc56fd909f05"
      ]
    },
    {
      "canonical_locator": "bible:web:ZEC:9:7",
      "sequence": 23007,
      "chapter_label": "ZEC 9",
      "verse_label": "7",
      "locator": {
        "book": "ZEC",
        "chapter": 9,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "ZEC",
          "chapter": 9,
          "verse": 7
        }
      ],
      "en": "I will take away his blood out of his mouth, and his abominations from between his teeth; and he also will be a remnant for our God; and he will be as a chieftain in Judah, and Ekron as a Jebusite.",
      "ko": "그 입에서 그 피를, 그 잇사이에서 그 가증한 것을 제하리니 그도 남아서 우리 하나님께로 돌아와서 유다의 한 두목 같이 되겠고 에그론은 여부스 사람 같이 되리라",
      "source_text_hash": "42cc808435674a7f03aa6f060ed562fbedcae4c9ab23172788bfcbec01e52e54",
      "translation_text_hash": "3824a0d7661d86d94030ef40866ef1cfd698b7efb224b6dbecb006228afc3da6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 입에서 그 피를, 그 잇사이에서 그 가증한 것을 제하리니 그도 남아서 우리 하나님께로 돌아와서 유다의 한 두목 같이 되겠고 에그론은 여부스 사람 같이 되리라"
      ],
      "raw_text_hashes": [
        "3824a0d7661d86d94030ef40866ef1cfd698b7efb224b6dbecb006228afc3da6"
      ]
    },
    {
      "canonical_locator": "bible:web:ZEC:9:8",
      "sequence": 23008,
      "chapter_label": "ZEC 9",
      "verse_label": "8",
      "locator": {
