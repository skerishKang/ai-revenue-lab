      "raw_texts": [
        "네가 만일 환난날에 낙담하면 네 힘의 미약함을 보임이니라"
      ],
      "raw_text_hashes": [
        "b052c506f50d8c4dc0abcc95878471b3dd439d643826b0304249a965373ec3cd"
      ]
