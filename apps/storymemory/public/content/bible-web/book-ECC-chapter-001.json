      "source_text_hash": "5be611f4c61111c9dcfab0c7412103765367e811eb79ab7b25175c0570f2af1e",
      "translation_text_hash": "8e55cd788d34364d75a56de4576225b54b3b69d2471900f059e47d9c905a7c43",
