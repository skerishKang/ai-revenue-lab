      "source_text_hash": "4e47c9721f615a388598cabc8d5711bf6a559c74a16d4866b6c4708822a3f213",
      "translation_text_hash": "2fbe1c04f5dcbc89a3108dba8623bb25a0b17b0df5fc9320b1b3faed911fbc2d",
      "translation_policy": "krv-1961-source-mapped",
