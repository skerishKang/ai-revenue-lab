      "source_text_hash": "ddb6372a9a9ef646197895d30f1683397e4a09848ccaa99e9407f971bda1d8ea",
      "translation_text_hash": "070159f060add6c8d9045a94417ee2f7f0b3edce8f200ebbb1efb2041fc22954",
