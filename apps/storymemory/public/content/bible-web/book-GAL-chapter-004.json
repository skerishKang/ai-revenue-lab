      "en": "You observe days, months, seasons, and years.",
      "ko": "너희가 날과 달과 절기와 해를 삼가 지키니",
      "source_text_hash": "50fb2ba457e0db11a9c5704c0e5d38c0c9b9370c3784f493ab0c6e227964c8a1",
      "translation_text_hash": "4a44db953f591031013b16b66f06c63f292243d45217a8be74c4089b26d1a781",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
