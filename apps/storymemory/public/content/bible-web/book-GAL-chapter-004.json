      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너희를 위하여 수고한 것이 헛될까 두려워 하노라"
      ],
      "raw_text_hashes": [
        "b254957cb188127e9fda357d0640dfc7da25f95a9d383304e3cbd4d955f799fb"
      ]
