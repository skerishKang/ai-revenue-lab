      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 또 말하노니 유업을 이을 자가 모든 것의 주인이나 어렸을 동안에는 종과 다름이 없어서"
      ],
      "raw_text_hashes": [
        "4a30a8b2c76d6468391d1702f9f58811e72b101769284dadd665ff3bc0f29b2c"
      ]
