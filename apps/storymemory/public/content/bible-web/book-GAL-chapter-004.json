      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 하가는 아라비아에 있는 시내산으로 지금 있는 예루살렘과 같은 데니 저가 그 자녀들로 더불어 종노릇하고"
      ],
      "raw_text_hashes": [
        "f4855702386266b91cc2b1636f6be6cb7bb804a7808fd2cd3a1b590db6cbb3db"
      ]
