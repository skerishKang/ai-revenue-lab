    {
      "canonical_locator": "bible:web:NUM:35:6",
      "sequence": 4852,
      "chapter_label": "NUM 35",
      "verse_label": "6",
      "locator": {
        "book": "NUM",
        "chapter": 35,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 35,
          "verse": 6
        }
      ],
      "en": "“The cities which you shall give to the Levites, they shall be the six cities of refuge, which you shall give for the man slayer to flee to. Besides them you shall give forty-two cities.",
      "ko": "너희가 레위인에게 줄 성읍은 살인자로 피케 할 도피성으로 여섯 성읍이요 그 외에 사십 이 성읍이라",
      "source_text_hash": "890528c22c8c8b0ed12e9574a17230dd76a8b24d812ae2005e065fa5b305c414",
      "translation_text_hash": "8825e22f4fbbd98a8f12557fee5b79a9e289daa458fb2ba5e7d1618f4f881bbd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 레위인에게 줄 성읍은 살인자로 피케 할 도피성으로 여섯 성읍이요 그 외에 사십 이 성읍이라"
      ],
      "raw_text_hashes": [
        "8825e22f4fbbd98a8f12557fee5b79a9e289daa458fb2ba5e7d1618f4f881bbd"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:35:7",
      "sequence": 4853,
