        "verse": 11
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 35,
          "verse": 11
        }
      ],
      "en": "then you shall appoint for yourselves cities to be cities of refuge for you, that the man slayer who kills any person unwittingly may flee there.",
      "ko": "너희를 위하여 성읍을 도피성으로 정하여 그릇 살인한 자로 그리로 피하게 하라",
      "source_text_hash": "70c6e5f7e3714de0f3c89c3677d5ca471cf44b2bd200aea37aaaabd78a2838b6",
      "translation_text_hash": "fc3433de32d5b2b7d41bcd6b0f27b9b77b3cbfaef8deea83b8389c17c6f4426a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희를 위하여 성읍을 도피성으로 정하여 그릇 살인한 자로 그리로 피하게 하라"
      ],
      "raw_text_hashes": [
        "fc3433de32d5b2b7d41bcd6b0f27b9b77b3cbfaef8deea83b8389c17c6f4426a"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:35:12",
      "sequence": 4858,
      "chapter_label": "NUM 35",
      "verse_label": "12",
      "locator": {
        "book": "NUM",
