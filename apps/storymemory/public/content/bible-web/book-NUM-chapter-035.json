      "ko": "너희가 줄 성읍 중에 여섯으로 도피성이 되게 하되",
      "source_text_hash": "b581f1199a8bfea8b3a7551ce7539a14b85e9043bd0c6d197e7beb40332b0adc",
      "translation_text_hash": "50ed9676847cbfa2bbe6ba94341ddcbdd0ee337e7fe031630a7b0673d47044fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 줄 성읍 중에 여섯으로 도피성이 되게 하되"
      ],
      "raw_text_hashes": [
        "50ed9676847cbfa2bbe6ba94341ddcbdd0ee337e7fe031630a7b0673d47044fe"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:35:14",
      "sequence": 4860,
      "chapter_label": "NUM 35",
      "verse_label": "14",
      "locator": {
        "book": "NUM",
