# Living Fiction environment configuration.
# Copy to .env for local development. Never commit a real .env, and never
# paste real secrets into this example file.
#
# Every secret below must be a genuinely random value; there are no
# source-code fallbacks. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production
LF_ENV=development

# Database backend: sqlite (local default) | postgres (production only).
# The backend is chosen EXPLICITLY here; it is never inferred from a URL.
# production + sqlite fails closed at startup.
LF_DATABASE_BACKEND=sqlite

# SQLite backend only.
LF_DATABASE_PATH=var/living-fiction.db

# PostgreSQL backend only (both treated as secrets — never logged).
# Runtime pooled connection, application role without migration rights:
LF_DATABASE_URL=
# Owner/migration-role direct connection, used ONLY by
# `python -m app.ops.bootstrap` commands:
LF_MIGRATION_DATABASE_URL=
# Optional bounded pool cap (default 5; kept small so an idle deployment
# can scale to zero).
#LF_DATABASE_POOL_MAX_SIZE=5

# Web secrets — required (non-empty) in every environment. Production
# additionally enforces >= 32 characters, mutually distinct values that are
# not obvious placeholders.
LF_ADMIN_SECRET=
LF_CREDENTIAL_HMAC_KEY=
LF_SESSION_HMAC_KEY=

# Comma-separated allowed request origins (scheme://host[:port], no path).
# Required and non-empty in production; set it to the app's own Modal HTTPS
# origin (e.g. https://ai-revenue-living-fiction--<team>.modal.run). No edge
# proxy is required. When empty outside production the allowed origin is
# derived from the request Host.
LF_ALLOWED_ORIGINS=

# AI provider: mock (Phase 1, deterministic) | opencode_go (Phase 3A)
# | openai_compat (generic OpenAI-compatible endpoint).
# The model name is set via LF_AI_MODEL; the default is mock.
#
# OpenCode Go (recommended for DeepSeek V4):
#   LF_AI_PROVIDER=opencode_go
#   LF_AI_MODEL=deepseek-v4-flash   (or deepseek-v4-pro)
#   LF_AI_API_KEY=<your OpenCode Go API key>
#
# Generic OpenAI-compatible endpoint:
#   LF_AI_PROVIDER=openai_compat
#   LF_AI_BASE_URL=https://public-compatible-provider.example/v1
#   LF_AI_MODEL=<provider model id>
#   LF_AI_API_KEY=<your API key>
#LF_AI_PROVIDER=mock

# AI model name (for opencode_go / openai_compat provider).
# Required when LF_AI_PROVIDER is not "mock".
# OpenCode Go model IDs: deepseek-v4-flash, deepseek-v4-pro
#LF_AI_MODEL=deepseek-v4-flash

# API key for the AI provider (opencode_go / openai_compat).
# Required when LF_AI_PROVIDER is not "mock". Operator sets this via
# environment variable — never hardcode the value in any file.
#LF_AI_API_KEY=

# Base URL for a generic OpenAI-compatible API endpoint.
# Required only for openai_compat. Not used by opencode_go.
# Must use HTTPS. Embedded credentials are rejected.
# Loopback, private, and link-local addresses are rejected.
#LF_AI_BASE_URL=https://public-compatible-provider.example/v1
