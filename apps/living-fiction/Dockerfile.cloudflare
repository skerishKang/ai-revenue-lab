# Living Fiction Cloudflare Container image.
# Build context must be apps/living-fiction/ so the canonical app package,
# migrations, and templates are copied without a parallel product tree.

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/living-fiction

COPY . .

RUN python -m pip install --upgrade pip \
    && python -m pip install ".[postgres]"

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers"]
