# Long-lived reading content.
/content/bible-web/search-index/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/content/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Static shell assets always revalidate (ETag); deploy cadence beats day-long caches.
/styles/*
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/*.mjs
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

# Entry points and API answers always revalidate.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/api/*
  Cache-Control: no-cache
