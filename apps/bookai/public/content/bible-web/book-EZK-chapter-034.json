    {
      "canonical_locator": "bible:web:EZK:34:23",
      "sequence": 21337,
      "chapter_label": "EZK 34",
      "verse_label": "23",
      "locator": {
        "book": "EZK",
        "chapter": 34,
        "verse": 23
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 34,
          "verse": 23
        }
      ],
      "en": "I will set up one shepherd over them, and he will feed them, even my servant David. He will feed them, and he will be their shepherd.",
      "ko": "내가 한 목자를 그들의 위에 세워 먹이게 하리니 그는 내 종 다윗이라 그가 그들을 먹이고 그들의 목자가 될찌라",
      "source_text_hash": "93967ed2d177e73d9e5a8618118da52141028d7f57e10f9ae0d837d575845553",
      "translation_text_hash": "178f879882d6906c1646dbdcecce7aa048dd4dd75cd047fa94af11c46affeef6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 한 목자를 그들의 위에 세워 먹이게 하리니 그는 내 종 다윗이라 그가 그들을 먹이고 그들의 목자가 될찌라"
      ],
      "raw_text_hashes": [
