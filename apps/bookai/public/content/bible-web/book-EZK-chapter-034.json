        {
          "book": "EZK",
          "chapter": 34,
          "verse": 7
        }
      ],
      "en": "“‘Therefore, you shepherds, hear the LORD’s word:",
      "ko": "그러므로 목자들아 여호와의 말씀을 들을찌어다",
      "source_text_hash": "9a33fdd1cfe42b3f2acbcc428776f866b29fd897a84538233d2ceee93b4e073b",
      "translation_text_hash": "4a1ab5b124564af3f1066a800fb0cfea821ffe1d43199c4292939c6d73ea8253",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 목자들아 여호와의 말씀을 들을찌어다"
      ],
      "raw_text_hashes": [
        "4a1ab5b124564af3f1066a800fb0cfea821ffe1d43199c4292939c6d73ea8253"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:34:8",
      "sequence": 21322,
      "chapter_label": "EZK 34",
      "verse_label": "8",
      "locator": {
        "book": "EZK",
