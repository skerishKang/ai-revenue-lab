        "verse": 6
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 6
        }
      ],
      "en": "knowing this, that our old man was crucified with him, that the body of sin might be done away with, so that we would no longer be in bondage to sin.",
      "ko": "우리가 알거니와 우리 옛 사람이 예수와 함께 십자가에 못 박힌 것은 죄의 몸이 멸하여 다시는 우리가 죄에게 종노릇 하지 아니하려 함이니",
      "source_text_hash": "9551c67a7680b94ad7f4dca08f7319d3dc1217821f5e0157d502af9999c64a38",
      "translation_text_hash": "7a6fbbc56ed99d5ee56aa185b1779973e011e52c8de11112789401d204cc2f03",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 알거니와 우리 옛 사람이 예수와 함께 십자가에 못 박힌 것은 죄의 몸이 멸하여 다시는 우리가 죄에게 종노릇 하지 아니하려 함이니"
      ],
      "raw_text_hashes": [
        "7a6fbbc56ed99d5ee56aa185b1779973e011e52c8de11112789401d204cc2f03"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:7",
      "sequence": 28072,
      "chapter_label": "ROM 6",
      "verse_label": "7",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 7
        }
      ],
      "en": "For he who has died has been freed from sin.",
      "ko": "이는 죽은 자가 죄에서 벗어나 의롭다 하심을 얻었음이니라",
      "source_text_hash": "d9f5ca13c8c41e81756f16d92ed1d32bd8469a191b4acba07890a5c1dcc5da4e",
      "translation_text_hash": "5fc386320925e5feb26313055b83b2147883d6f980f05dbd43154f2ba8033bd1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 죽은 자가 죄에서 벗어나 의롭다 하심을 얻었음이니라"
      ],
      "raw_text_hashes": [
        "5fc386320925e5feb26313055b83b2147883d6f980f05dbd43154f2ba8033bd1"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:8",
      "sequence": 28073,
      "chapter_label": "ROM 6",
      "verse_label": "8",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 8
        }
      ],
      "en": "But if we died with Christ, we believe that we will also live with him,",
      "ko": "만일 우리가 그리스도와 함께 죽었으면 또한 그와 함께 살 줄을 믿노니",
      "source_text_hash": "2cdeec6b6e79285e7ccfbd19fc442867519c02436b391a7e92b34df02020d0f3",
      "translation_text_hash": "277ab75b5538f281ed7549fadb42f76e67d0838017aa45efd31947d324ca2580",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 우리가 그리스도와 함께 죽었으면 또한 그와 함께 살 줄을 믿노니"
      ],
      "raw_text_hashes": [
        "277ab75b5538f281ed7549fadb42f76e67d0838017aa45efd31947d324ca2580"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:9",
      "sequence": 28074,
      "chapter_label": "ROM 6",
      "verse_label": "9",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 9
        }
      ],
      "en": "knowing that Christ, being raised from the dead, dies no more. Death no longer has dominion over him!",
      "ko": "이는 그리스도께서 죽은 자 가운데서 사셨으매 다시 죽지 아니하시고 사망이 다시 그를 주장하지 못할 줄을 앎이로라",
      "source_text_hash": "aebf5b301dd463a2b25a61f36dfd79bca762a9d9f9a8a6e5490fd5eeeea1989c",
      "translation_text_hash": "e6af6fa7d6fe9f8fc16dac8de94e5e4a2b185301d0a0de9231e971dd54415c2b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 그리스도께서 죽은 자 가운데서 사셨으매 다시 죽지 아니하시고 사망이 다시 그를 주장하지 못할 줄을 앎이로라"
      ],
      "raw_text_hashes": [
        "e6af6fa7d6fe9f8fc16dac8de94e5e4a2b185301d0a0de9231e971dd54415c2b"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:10",
      "sequence": 28075,
      "chapter_label": "ROM 6",
      "verse_label": "10",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 10
        }
      ],
      "en": "For the death that he died, he died to sin one time; but the life that he lives, he lives to God.",
      "ko": "그의 죽으심은 죄에 대하여 단번에 죽으심이요 그의 살으심은 하나님께 대하여 살으심이니",
      "source_text_hash": "1d15fbce55334b116d94ce4ab72807fc1656893acf285596367cc789cbab44fc",
      "translation_text_hash": "462e35d52cdd3e28c0771d3eb0814e770aadc9625315daa81a6325519767b3b6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그의 죽으심은 죄에 대하여 단번에 죽으심이요 그의 살으심은 하나님께 대하여 살으심이니"
      ],
      "raw_text_hashes": [
        "462e35d52cdd3e28c0771d3eb0814e770aadc9625315daa81a6325519767b3b6"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:11",
      "sequence": 28076,
      "chapter_label": "ROM 6",
      "verse_label": "11",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 11
        }
      ],
      "en": "Thus consider yourselves also to be dead to sin, but alive to God in Christ Jesus our Lord.",
      "ko": "이와 같이 너희도 너희 자신을 죄에 대하여는 죽은 자요 그리스도 예수 안에서 하나님을 대하여는 산 자로 여길찌어다",
      "source_text_hash": "e6f6cb5bc5369b8fbb951b6238a753d39770465372cee40deaf8cea649ec7a86",
      "translation_text_hash": "83611c87c1c8391ee421e7d0671c275d9ed2adf65aca08bc6023a876f96582e2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이와 같이 너희도 너희 자신을 죄에 대하여는 죽은 자요 그리스도 예수 안에서 하나님을 대하여는 산 자로 여길찌어다"
      ],
      "raw_text_hashes": [
        "83611c87c1c8391ee421e7d0671c275d9ed2adf65aca08bc6023a876f96582e2"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:12",
      "sequence": 28077,
      "chapter_label": "ROM 6",
      "verse_label": "12",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 12
        }
      ],
      "en": "Therefore don’t let sin reign in your mortal body, that you should obey it in its lusts.",
      "ko": "그러므로 너희는 죄로 너희 죽을 몸에 왕노릇하지 못하게 하여 몸의 사욕을 순종치 말고",
      "source_text_hash": "91dbf1db91ce6945dd26cdcc09b67b4a656e0e406a1fe0e595ed495769c0e516",
      "translation_text_hash": "3bd99251a968fdcda65cdd0912bdab4ff8f466a61f82538cc87ef919ddd40959",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 너희는 죄로 너희 죽을 몸에 왕노릇하지 못하게 하여 몸의 사욕을 순종치 말고"
      ],
      "raw_text_hashes": [
        "3bd99251a968fdcda65cdd0912bdab4ff8f466a61f82538cc87ef919ddd40959"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:13",
      "sequence": 28078,
      "chapter_label": "ROM 6",
      "verse_label": "13",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 13
        }
      ],
      "en": "Also, do not present your members to sin as instruments of unrighteousness, but present yourselves to God as alive from the dead, and your members as instruments of righteousness to God.",
      "ko": "또한 너희 지체를 불의의 병기로 죄에게 드리지 말고 오직 너희 자신을 죽은 자 가운데서 다시 산 자 같이 하나님께 드리며 너희 지체를 의의 병기로 하나님께 드리라",
      "source_text_hash": "ce31781f038a4a621847fbb1da6c8c34ec3246a749a529708560296f4e17ba53",
      "translation_text_hash": "93e41f2b340f9f45b47fbed9c77772b0e772d5b3d6f04ed4196da11001d038c7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또한 너희 지체를 불의의 병기로 죄에게 드리지 말고 오직 너희 자신을 죽은 자 가운데서 다시 산 자 같이 하나님께 드리며 너희 지체를 의의 병기로 하나님께 드리라"
      ],
      "raw_text_hashes": [
        "93e41f2b340f9f45b47fbed9c77772b0e772d5b3d6f04ed4196da11001d038c7"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:6:14",
      "sequence": 28079,
      "chapter_label": "ROM 6",
      "verse_label": "14",
      "locator": {
        "book": "ROM",
        "chapter": 6,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 6,
          "verse": 14
        }
      ],
      "en": "For sin will not have dominion over you, for you are not under law, but under grace.",
      "ko": "죄가 너희를 주관치 못하리니 이는 너희가 법 아래 있지 아니하고 은혜 아래 있음이니라",
      "source_text_hash": "de627cdd98c2697c8d03e7759181d89ccb8d95afb044bfc6b478aa1d7a8827eb",
      "translation_text_hash": "115bd2630bc38c0c1e759432e37696c850d7bf35a6166727f507e11b0144308f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
