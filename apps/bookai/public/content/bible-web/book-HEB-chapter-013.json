      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 13,
          "verse": 3
        }
      ],
      "en": "Remember those who are in bonds, as bound with them, and those who are ill-treated, since you are also in the body.",
      "ko": "자기도 함께 갇힌것 같이 갇힌 자를 생각하고 자기도 몸을 가졌은즉 학대 받는 자를 생각하라",
      "source_text_hash": "3b1a3c1828cf2d31d6644a4b889967d4c4e2481676ee0e1a47c6d2a8c68528ef",
      "translation_text_hash": "88230248572f90bc34ca2291ca35ca4610f6f2ee15f2ad2bb06b3b45ea7cec21",
      "translation_policy": "krv-1961-source-mapped",
