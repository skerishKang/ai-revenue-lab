      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 내 말을 자세히 들으라 이것이 너희의 위로가 될 것이니라"
      ],
      "raw_text_hashes": [
        "41de6ac22a53532e0309eeaab1663ce984c673df1017a43e615382ad01e59167"
      ]
    },
