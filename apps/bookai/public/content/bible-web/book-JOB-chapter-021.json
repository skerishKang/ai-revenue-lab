      "translation_text_hash": "fea6fccf227116e27ce97ebb5bc9d3449b5b47ea7add7bbe304a7429c0515be7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
