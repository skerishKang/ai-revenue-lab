      },
      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 2,
          "verse": 9
        }
      ],
      "en": "Take the plunder of silver. Take the plunder of gold, for there is no end of treasure, an abundance of every precious thing.",
      "ko": "은을 노략하라 금을 늑탈하라 그 저축한 것이 무한하고 아름다운 기구가 풍부함이니라",
      "source_text_hash": "679bcafa81545cb0ce2b429be8e7e66db71fed3f885247fd6cabaa5142d90e13",
      "translation_text_hash": "8cd222f1c7f0dfd3a3a48e6cea3dae492f8d0cb9f809ef0cb31c134aaaab5b58",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
