      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "니느웨는 예로부터 물이 모인 못 같더니 이제 모두 도망하니 서라 서라 하나 돌아보는 자가 없도다"
      ],
      "raw_text_hashes": [
        "5ab758a5f8c168880766bba35f8d300aa107d8d2c243a9ce932e776a7127efab"
