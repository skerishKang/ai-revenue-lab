        "verse": 13
      },
      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 2,
          "verse": 13
        }
      ],
      "en": "“Behold, I am against you,” says the LORD of Armies, “and I will burn her chariots in the smoke, and the sword will devour your young lions; and I will cut off your prey from the earth, and the voice of your messengers will no longer be heard.”",
      "ko": "만군의 여호와의 말씀에 내가 네 대적이 되어 너의 병거들을 살라 연기가 되게 하고 너의 젊은 사자들을 칼로 멸할 것이며 내가 또 너의 노략한 것을 땅에서 끊으리니 너의 파견자의 목소리가 다시는 들리지 아니하리라 하셨느니라",
      "source_text_hash": "a691cdbd379ebc27b800f3022e069a8c10f71c9d24ec6be848bcad7bfc75aa4d",
      "translation_text_hash": "d2b743b0d4ae869566db4c75fd7c411f416795b28b4cea5fc5f81efe850e566d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
