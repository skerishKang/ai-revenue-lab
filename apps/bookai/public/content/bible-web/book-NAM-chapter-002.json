      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 2,
          "verse": 6
        }
      ],
      "en": "The gates of the rivers are opened, and the palace is dissolved.",
      "ko": "강들의 수문이 열리고 왕궁이 소멸되며",
      "source_text_hash": "9b40016f716de7e3e24152c8e133891695830ed3cd49312eb9c4fe431fdbd9f3",
      "translation_text_hash": "55d680aa7c3da9760d4b4d645c9f4528cab07bcaed522492350dd962bccbc066",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "강들의 수문이 열리고 왕궁이 소멸되며"
      ],
      "raw_text_hashes": [
        "55d680aa7c3da9760d4b4d645c9f4528cab07bcaed522492350dd962bccbc066"
      ]
    },
    {
      "canonical_locator": "bible:web:NAM:2:7",
      "sequence": 22707,
      "chapter_label": "NAM 2",
