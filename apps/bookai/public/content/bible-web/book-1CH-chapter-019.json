    {
      "canonical_locator": "bible:web:1CH:19:6",
      "sequence": 10914,
      "chapter_label": "1CH 19",
      "verse_label": "6",
      "locator": {
        "book": "1CH",
        "chapter": 19,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 19,
          "verse": 6
        }
      ],
      "en": "When the children of Ammon saw that they had made themselves odious to David, Hanun and the children of Ammon sent one thousand talents of silver to hire chariots and horsemen out of Mesopotamia, out of Aram-maacah, and out of Zobah.",
      "ko": "암몬 자손이 자기가 다윗에게 밉게 한줄 안지라 하눈이 암몬 자손으로 더불어 은 일천 달란트를 아람 나하라임과 아람마아가와 소바에 보내어 병거와 마병을 삯 내되",
      "source_text_hash": "3498f8d90369c006fb977387bda23788103ca81802a63b5b58c54d8386396efa",
      "translation_text_hash": "3abc1ba744f79f1d768e41705ee9e57edf009f5b4f7821d58538316399b82230",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "암몬 자손이 자기가 다윗에게 밉게 한줄 안지라 하눈이 암몬 자손으로 더불어 은 일천 달란트를 아람 나하라임과 아람마아가와 소바에 보내어 병거와 마병을 삯 내되"
      ],
      "raw_text_hashes": [
