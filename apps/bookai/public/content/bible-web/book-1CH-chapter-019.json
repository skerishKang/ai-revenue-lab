        "verse": 4
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 19,
          "verse": 4
        }
      ],
      "en": "So Hanun took David’s servants, shaved them, and cut off their garments in the middle at their buttocks, and sent them away.",
      "ko": "하눈이 이에 다윗의 신복들을 잡아 그 수염을 깎고 그 의복의 중동 볼기까지 자르고 돌려 보내매",
      "source_text_hash": "494ff1e3e4f223f23b88de595c1e2dd8600f1590ddf247253c5e95b446f3f3b0",
      "translation_text_hash": "2e9c33e4ef91de2d84a8737eba67e1629b1712edaf259bc8dfabb823560f2c88",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하눈이 이에 다윗의 신복들을 잡아 그 수염을 깎고 그 의복의 중동 볼기까지 자르고 돌려 보내매"
      ],
      "raw_text_hashes": [
        "2e9c33e4ef91de2d84a8737eba67e1629b1712edaf259bc8dfabb823560f2c88"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:19:5",
      "sequence": 10913,
      "chapter_label": "1CH 19",
      "verse_label": "5",
      "locator": {
