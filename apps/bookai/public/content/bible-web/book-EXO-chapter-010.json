      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세가 가로되 우리가 여호와 앞에 절기를 지킬것인즉 우리가 남녀 노소와 우양을 데리고 가겠나이다"
      ],
      "raw_text_hashes": [
