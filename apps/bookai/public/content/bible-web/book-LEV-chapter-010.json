      ],
      "en": "Then the LORD said to Aaron,",
      "ko": "여호와께서 아론에게 일러 가라사대",
      "source_text_hash": "908e66d67320bea762b1abd5dacab00c1db3cfe354c4345183423b3355b867ec",
      "translation_text_hash": "dcf6e46eccb120e3d0c0484c6e3431428a445874e9584be9e62d438456640fc7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
