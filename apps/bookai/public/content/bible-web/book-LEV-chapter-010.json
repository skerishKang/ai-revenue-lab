      "raw_texts": [
        "또 여호와가 모세로 명한 모든 규례를 이스라엘 자손에게 가르치리라"
      ],
      "raw_text_hashes": [
        "714c9c1c2e2b73b298fdec2e52d79a58cd4855638719dab42b0d46f9154fb7c0"
      ]
