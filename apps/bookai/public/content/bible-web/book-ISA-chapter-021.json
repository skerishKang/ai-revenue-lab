        "verse": 5
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 21,
          "verse": 5
        }
      ],
      "en": "They prepare the table. They set the watch. They eat. They drink. Rise up, you princes, oil the shield!",
      "ko": "그들이 식탁을 베풀고 파숫군을 세우고 먹고 마시도다 너희 방백들아 일어나 방패에 기름을 바를찌어다",
      "source_text_hash": "c789dcc9d72cb287bb4a84c814169131238b804e79a6c948053a4a5db3054aa1",
      "translation_text_hash": "56b558d774cb6950ae346acab3014a5a2d8e95ecdffc6f071b24b0e6e4516517",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들이 식탁을 베풀고 파숫군을 세우고 먹고 마시도다 너희 방백들아 일어나 방패에 기름을 바를찌어다"
      ],
      "raw_text_hashes": [
        "56b558d774cb6950ae346acab3014a5a2d8e95ecdffc6f071b24b0e6e4516517"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:21:6",
