        "verse": 6
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 21,
          "verse": 6
        }
      ],
      "en": "For the Lord said to me, “Go, set a watchman. Let him declare what he sees.",
      "ko": "주께서 내게 이르시되 가서 파숫군을 세우고 그 보는 것을 고하게 하되",
      "source_text_hash": "186b5f6d82ca92405c34e28a02b191c295ce152f395be46ee40ec5b3a95bc8e0",
      "translation_text_hash": "8e2f0d26bfea61af57f0d8483fd550eff7d4c7dab23afafaf117f71958085ed5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 내게 이르시되 가서 파숫군을 세우고 그 보는 것을 고하게 하되"
      ],
      "raw_text_hashes": [
        "8e2f0d26bfea61af57f0d8483fd550eff7d4c7dab23afafaf117f71958085ed5"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:21:7",
