    {
      "canonical_locator": "bible:web:1KI:5:10",
      "sequence": 8889,
      "chapter_label": "1KI 5",
      "verse_label": "10",
      "locator": {
        "book": "1KI",
        "chapter": 5,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 5,
          "verse": 10
        }
      ],
      "en": "So Hiram gave Solomon cedar timber and cypress timber according to all his desire.",
      "ko": "솔로몬의 모든 원대로 백향목 재목과 잣나무 재목을 주매",
      "source_text_hash": "15c28eb86a5f1a208da1d8d43f17db7fea94e31e79911a99dcd343227f3934d1",
      "translation_text_hash": "d155b4746efe16bd332848e6e3b0e5e5f34f6ebcc37d2cfea780451d9eb6c669",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "솔로몬의 모든 원대로 백향목 재목과 잣나무 재목을 주매"
      ],
      "raw_text_hashes": [
        "d155b4746efe16bd332848e6e3b0e5e5f34f6ebcc37d2cfea780451d9eb6c669"
      ]
    },
    {
      "canonical_locator": "bible:web:1KI:5:11",
      "sequence": 8890,
      "chapter_label": "1KI 5",
      "verse_label": "11",
      "locator": {
        "book": "1KI",
        "chapter": 5,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 5,
          "verse": 11
        }
      ],
      "en": "Solomon gave Hiram twenty thousand cors of wheat for food to his household, and twenty cors of pure oil. Solomon gave this to Hiram year by year.",
      "ko": "솔로몬이 히람에게 그 궁정의 식물로 밀 이만석과 맑은 기름 이십석을 주고 해마다 그와 같이 주었더라",
      "source_text_hash": "2733b79ec35eeeda02f275f2b7dd6f43f1237835a971b455406f487ae420c8da",
      "translation_text_hash": "fc88cf895810e0baf0bafb11cac21c3ec6e988d9b1309ad3c30a12e8fcf74f9c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "솔로몬이 히람에게 그 궁정의 식물로 밀 이만석과 맑은 기름 이십석을 주고 해마다 그와 같이 주었더라"
      ],
      "raw_text_hashes": [
        "fc88cf895810e0baf0bafb11cac21c3ec6e988d9b1309ad3c30a12e8fcf74f9c"
      ]
    },
    {
      "canonical_locator": "bible:web:1KI:5:12",
