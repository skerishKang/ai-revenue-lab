      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 147,
          "verse": 4
        }
      ],
      "en": "He counts the number of the stars. He calls them all by their names.",
      "ko": "저가 별의 수효를 계수하시고 저희를 다 이름대로 부르시는도다",
      "source_text_hash": "2bcf83634a77873292481aa1e5f66a3d9ea97d78fd12802e84506098d0006139",
      "translation_text_hash": "86021e22803a41aab480a79281ec4321f192e93fbc129df35271ff5deb2166ea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
