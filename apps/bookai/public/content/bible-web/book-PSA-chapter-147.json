      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 147,
          "verse": 5
        }
      ],
      "en": "Great is our Lord, and mighty in power. His understanding is infinite.",
      "ko": "우리 주는 광대하시며 능력이 많으시며 그 지혜가 무궁하시도다",
      "source_text_hash": "04f22e9167479e05fd89f3b3e564fcf4dea2e89b7feb34f430779ad38c154c54",
      "translation_text_hash": "28902a4312adb08056a8d6cb9756154aaafb18c9cc1eb82d1df02aebfec00e99",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 주는 광대하시며 능력이 많으시며 그 지혜가 무궁하시도다"
      ],
      "raw_text_hashes": [
        "28902a4312adb08056a8d6cb9756154aaafb18c9cc1eb82d1df02aebfec00e99"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:147:6",
      "sequence": 16358,
      "chapter_label": "PSA 147",
      "verse_label": "6",
      "locator": {
        "book": "PSA",
