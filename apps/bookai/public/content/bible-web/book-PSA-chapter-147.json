        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 147,
          "verse": 9
        }
      ],
      "en": "He provides food for the livestock, and for the young ravens when they call.",
      "ko": "들짐승과 우는 까마귀 새끼에게 먹을 것을 주시는도다",
      "source_text_hash": "e45ec7335efbb881a482152c8ded288153390f92cbd464e8b1656fee638e9009",
      "translation_text_hash": "304a944924b65e396f2dcf97302b9affbba2c842d3958927c0353b3fb98e92a3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "들짐승과 우는 까마귀 새끼에게 먹을 것을 주시는도다"
      ],
      "raw_text_hashes": [
        "304a944924b65e396f2dcf97302b9affbba2c842d3958927c0353b3fb98e92a3"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:147:10",
      "sequence": 16362,
      "chapter_label": "PSA 147",
      "verse_label": "10",
      "locator": {
        "book": "PSA",
        "chapter": 147,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 147,
          "verse": 10
        }
      ],
      "en": "He doesn’t delight in the strength of the horse. He takes no pleasure in the legs of a man.",
      "ko": "여호와는 말의 힘을 즐거워 아니하시며 사람의 다리도 기뻐 아니하시고",
      "source_text_hash": "009fbb2f453f1209fe1697d9c7bd002bfe62f3b263814ec92fd5f381ca0423e7",
      "translation_text_hash": "ec8482b589d45e276bb21ba50c09c22627e35183d39550f6961486497eda5bf5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와는 말의 힘을 즐거워 아니하시며 사람의 다리도 기뻐 아니하시고"
      ],
      "raw_text_hashes": [
        "ec8482b589d45e276bb21ba50c09c22627e35183d39550f6961486497eda5bf5"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:147:11",
      "sequence": 16363,
      "chapter_label": "PSA 147",
      "verse_label": "11",
      "locator": {
        "book": "PSA",
        "chapter": 147,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 147,
          "verse": 11
        }
      ],
      "en": "The LORD takes pleasure in those who fear him, in those who hope in his loving kindness.",
      "ko": "자기를 경외하는 자와 그 인자하심을 바라는 자들을 기뻐하시는도다",
      "source_text_hash": "9b43892ab4372af32dcffd6e4caf23ad78e1189181bd4a7609b0a3622f253cf9",
      "translation_text_hash": "90f797e458140603e6d797ff132d91df805e9625404b170988236610e07d34b9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "자기를 경외하는 자와 그 인자하심을 바라는 자들을 기뻐하시는도다"
      ],
      "raw_text_hashes": [
        "90f797e458140603e6d797ff132d91df805e9625404b170988236610e07d34b9"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:147:12",
      "sequence": 16364,
      "chapter_label": "PSA 147",
      "verse_label": "12",
      "locator": {
