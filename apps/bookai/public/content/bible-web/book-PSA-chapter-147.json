        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 147,
          "verse": 6
        }
      ],
      "en": "The LORD upholds the humble. He brings the wicked down to the ground.",
      "ko": "여호와께서 겸손한 자는 붙드시고 악인은 땅에 엎드러뜨리시는도다",
      "source_text_hash": "a06d580e2a9aea934222e24a074d694ef7becbbc4a44c5f9158d1d649160a70f",
      "translation_text_hash": "86d1b06a4b38e7b5c9d68e30114287cd980c483cb372240edfc785829bdffd9e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 겸손한 자는 붙드시고 악인은 땅에 엎드러뜨리시는도다"
      ],
      "raw_text_hashes": [
        "86d1b06a4b38e7b5c9d68e30114287cd980c483cb372240edfc785829bdffd9e"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:147:7",
      "sequence": 16359,
      "chapter_label": "PSA 147",
      "verse_label": "7",
      "locator": {
