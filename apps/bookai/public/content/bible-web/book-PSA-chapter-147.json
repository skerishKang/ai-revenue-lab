        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 147,
          "verse": 7
        }
      ],
      "en": "Sing to the LORD with thanksgiving. Sing praises on the harp to our God,",
      "ko": "감사함으로 여호와께 노래하며 수금으로 하나님께 찬양할찌어다",
      "source_text_hash": "2d0ce4ad5d82ff0b1ef90c0ef93845ef027eb9c133aaccd82a59c6ef3b7d9801",
      "translation_text_hash": "932d9ded47399fc00e37b42de4cff4bc0c9acf96bfd2fc6b8430997005587083",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "감사함으로 여호와께 노래하며 수금으로 하나님께 찬양할찌어다"
      ],
      "raw_text_hashes": [
        "932d9ded47399fc00e37b42de4cff4bc0c9acf96bfd2fc6b8430997005587083"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:147:8",
      "sequence": 16360,
      "chapter_label": "PSA 147",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
