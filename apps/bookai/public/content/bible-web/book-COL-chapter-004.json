      "translation_text_hash": "1cd7b6cd3088ddb70728d8c11b6d8c7e5cfeac7b03ec5c9abb2dd7fe7548a69a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
