      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 17,
          "verse": 12
        }
      ],
      "en": "He is like a lion that is greedy of his prey, as it were a young lion lurking in secret places.",
      "ko": "저는 그 움킨 것을 찢으려 하는 사자 같으며 은밀한 곳에 엎드린 젊은 사자 같으니이다",
      "source_text_hash": "2c57bf9ed32e761d6cfd65d8e206cd565f42c4a3589ee887ffeec8fd563abd85",
      "translation_text_hash": "73e8cf6025dc011f043e9db40c58e16bfb51747c1b2590391a68daa8db760602",
      "translation_policy": "krv-1961-source-mapped",
