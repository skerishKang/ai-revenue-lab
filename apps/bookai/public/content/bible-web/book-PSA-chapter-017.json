      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 17,
          "verse": 2
        }
      ],
      "en": "Let my sentence come out of your presence. Let your eyes look on equity.",
      "ko": "나의 판단을 주 앞에서 내시며 주의 눈은 공평함을 살피소서",
      "source_text_hash": "6b7bbc56b598ac20a79c4b89a5eeb2fd6cff7b87e34fdfff4502cca03bd4bb34",
      "translation_text_hash": "5ed2c3baec2814b6b3410765b60e08d81317d03e43e8a476d28ad968f6afd1ea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 판단을 주 앞에서 내시며 주의 눈은 공평함을 살피소서"
      ],
      "raw_text_hashes": [
        "5ed2c3baec2814b6b3410765b60e08d81317d03e43e8a476d28ad968f6afd1ea"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:17:3",
      "sequence": 14107,
      "chapter_label": "PSA 17",
