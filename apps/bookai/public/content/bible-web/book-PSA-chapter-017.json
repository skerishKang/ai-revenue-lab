      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 17,
          "verse": 9
        }
      ],
      "en": "from the wicked who oppress me, my deadly enemies, who surround me.",
      "ko": "나를 압제하는 악인과 나를 에워싼 극한 원수에게서 벗어나게 하소서",
      "source_text_hash": "dc364cce65fdd5d774a3c3d9594b972a71aff100b9aecc546561d280cf006f46",
      "translation_text_hash": "b0b2f4589fc251ea3e47394cfb82b9443dac57d3a67b39a8035cc1c187b590c0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 압제하는 악인과 나를 에워싼 극한 원수에게서 벗어나게 하소서"
      ],
      "raw_text_hashes": [
        "b0b2f4589fc251ea3e47394cfb82b9443dac57d3a67b39a8035cc1c187b590c0"
      ]
