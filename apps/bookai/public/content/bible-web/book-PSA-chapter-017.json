      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 17,
          "verse": 5
        }
      ],
      "en": "My steps have held fast to your paths. My feet have not slipped.",
      "ko": "나의 걸음이 주의 길을 굳게 지키고 실족지 아니하였나이다",
      "source_text_hash": "e93cf756802311c17eab269e35cd81892c27a8e48dfceb5a085c267fd603a0de",
      "translation_text_hash": "1ea3d12bfd153e527234df2e5bae571909676da56ae71046c14a2662cbbc17a1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 걸음이 주의 길을 굳게 지키고 실족지 아니하였나이다"
      ],
      "raw_text_hashes": [
        "1ea3d12bfd153e527234df2e5bae571909676da56ae71046c14a2662cbbc17a1"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:17:6",
      "sequence": 14110,
