      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 17,
          "verse": 10
        }
      ],
      "en": "They close up their callous hearts. With their mouth they speak proudly.",
      "ko": "저희가 자기 기름에 잠겼으며 그 입으로 교만히 말하나이다",
      "source_text_hash": "49814be02595f70d87ad4c286d241140b916d85de5db09be78938ddea725cb91",
      "translation_text_hash": "a6a6a7b3a9a89ecca7fa8d881643a852d01fb940b27095152d5b92bced706242",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 자기 기름에 잠겼으며 그 입으로 교만히 말하나이다"
      ],
      "raw_text_hashes": [
        "a6a6a7b3a9a89ecca7fa8d881643a852d01fb940b27095152d5b92bced706242"
      ]
    },
