      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 17,
          "verse": 8
        }
      ],
      "en": "Keep me as the apple of your eye. Hide me under the shadow of your wings,",
      "ko": "나를 눈동자 같이 지키시고 주의 날개 그늘 아래 감추사",
      "source_text_hash": "7d7337d66fb6aea8256e5171d00b8c3c4fed83ce3ee2a37312debc4f9cb12311",
      "translation_text_hash": "c341c348757e95d95b072c030d18d1d55188eaf9231f0328de0ede7f2069cb14",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 눈동자 같이 지키시고 주의 날개 그늘 아래 감추사"
      ],
      "raw_text_hashes": [
        "c341c348757e95d95b072c030d18d1d55188eaf9231f0328de0ede7f2069cb14"
      ]
    },
    {
