      "raw_locator": [
        {
          "book": "JER",
          "chapter": 52,
          "verse": 5
        }
      ],
      "en": "So the city was besieged to the eleventh year of King Zedekiah.",
      "ko": "성이 시드기야왕 십 일년까지 에워싸였더니",
      "source_text_hash": "96c5df4b76f1952bf0a94692400242f256cdca92dc44dd185203fb5e7bb4dd99",
      "translation_text_hash": "b1c3f7175f416fc47ddd215027dcec7f3f8225b19188044df8280cfcde19e652",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "성이 시드기야왕 십 일년까지 에워싸였더니"
      ],
      "raw_text_hashes": [
        "b1c3f7175f416fc47ddd215027dcec7f3f8225b19188044df8280cfcde19e652"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:52:6",
      "sequence": 20283,
      "chapter_label": "JER 52",
      "verse_label": "6",
      "locator": {
        "book": "JER",
        "chapter": 52,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 52,
          "verse": 6
        }
      ],
      "en": "In the fourth month, in the ninth day of the month, the famine was severe in the city, so that there was no bread for the people of the land.",
      "ko": "그 사월 구일에 성중에 기근이 심하여 그 땅 백성의 식물이 진하였더라",
      "source_text_hash": "4323e52a2f97141968f4d030786d0e5b584a1c4d7667f1cce56bd2d07f2f1ad1",
      "translation_text_hash": "806074cec786084a40c20cc67cc740bf29be9c7d009b3a6f74151a1b4953393f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사월 구일에 성중에 기근이 심하여 그 땅 백성의 식물이 진하였더라"
      ],
      "raw_text_hashes": [
        "806074cec786084a40c20cc67cc740bf29be9c7d009b3a6f74151a1b4953393f"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:52:7",
      "sequence": 20284,
      "chapter_label": "JER 52",
