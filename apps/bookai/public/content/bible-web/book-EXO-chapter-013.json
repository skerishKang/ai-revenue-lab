        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 13,
          "verse": 6
        }
      ],
      "en": "Seven days you shall eat unleavened bread, and in the seventh day shall be a feast to the LORD.",
      "ko": "칠일 동안 무교병을 먹고 제 칠일에는 여호와께 절기를 지키라",
      "source_text_hash": "5f7edc35e9a52b208765987b27416285f75b2a4d1c7dfc9b0bfd857a03412f24",
      "translation_text_hash": "99c4122bb6159e43fe5181d771977108e1a267b8a61f30b7b5d9375ed998c259",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "칠일 동안 무교병을 먹고 제 칠일에는 여호와께 절기를 지키라"
      ],
      "raw_text_hashes": [
        "99c4122bb6159e43fe5181d771977108e1a267b8a61f30b7b5d9375ed998c259"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:13:7",
      "sequence": 1875,
      "chapter_label": "EXO 13",
      "verse_label": "7",
      "locator": {
        "book": "EXO",
        "chapter": 13,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 13,
          "verse": 7
        }
      ],
      "en": "Unleavened bread shall be eaten throughout the seven days; and no leavened bread shall be seen with you. No yeast shall be seen with you, within all your borders.",
      "ko": "칠일 동안에는 무교병을 먹고 유교병을 너희 곳에 있게 하지 말며 네 지경 안에서 누룩을 네게 보이지도 말게 하며",
      "source_text_hash": "100a810a8035a74d70f4ae134dd0f3b076604d93c8e50b47dcf5972f3bc61c42",
      "translation_text_hash": "9ceea21ed117bfb6a9084b757860284601824d17bcb8faa8f507af47046c1c19",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "칠일 동안에는 무교병을 먹고 유교병을 너희 곳에 있게 하지 말며 네 지경 안에서 누룩을 네게 보이지도 말게 하며"
      ],
      "raw_text_hashes": [
        "9ceea21ed117bfb6a9084b757860284601824d17bcb8faa8f507af47046c1c19"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:13:8",
      "sequence": 1876,
      "chapter_label": "EXO 13",
      "verse_label": "8",
      "locator": {
        "book": "EXO",
        "chapter": 13,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 13,
          "verse": 8
        }
      ],
      "en": "You shall tell your son in that day, saying, ‘It is because of that which the LORD did for me when I came out of Egypt.’",
      "ko": "너는 그 날에 네 아들에게 뵈어 이르기를 이 예식은 내가 애굽에서 나올 때에 여호와께서 나를 위하여 행하신 일을 인함이라 하고",
      "source_text_hash": "00f7718ef8a95cd853458630fed1a1c4de38221d68360329943098540c04cd11",
      "translation_text_hash": "f472c7e89b3dd54b35456dfde580541faa160aa63153f38da3de367725da2b05",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 그 날에 네 아들에게 뵈어 이르기를 이 예식은 내가 애굽에서 나올 때에 여호와께서 나를 위하여 행하신 일을 인함이라 하고"
      ],
      "raw_text_hashes": [
        "f472c7e89b3dd54b35456dfde580541faa160aa63153f38da3de367725da2b05"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:13:9",
      "sequence": 1877,
      "chapter_label": "EXO 13",
