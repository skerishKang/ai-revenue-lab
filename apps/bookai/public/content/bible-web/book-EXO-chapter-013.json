        "verse": 10
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 13,
          "verse": 10
        }
      ],
      "en": "You shall therefore keep this ordinance in its season from year to year.",
      "ko": "연년이 기한에 이르러 이 규례를 지킬찌니라",
      "source_text_hash": "6d5d69cb41c6fde61b91cd6b3658c96a8576054f3956a53ef67e4f7511a36dcb",
      "translation_text_hash": "da7fb9f7b4b3a7f66a92181f024fd86fa8f9042c0dce9d4063a797699485a302",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "연년이 기한에 이르러 이 규례를 지킬찌니라"
      ],
      "raw_text_hashes": [
        "da7fb9f7b4b3a7f66a92181f024fd86fa8f9042c0dce9d4063a797699485a302"
      ]
    },
    {
