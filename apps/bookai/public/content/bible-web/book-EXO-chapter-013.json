      "source_text_hash": "4d36aa3ec9eead10ad17e095e48367f92a54c53cdaaccc3b3db49e0dd28579c3",
      "translation_text_hash": "4492117490f077649a026775c7710d68d84515091dab878723d8f6a9df066280",
