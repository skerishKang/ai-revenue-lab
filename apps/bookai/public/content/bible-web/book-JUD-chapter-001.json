        "verse": 2
      },
      "raw_locator": [
        {
          "book": "JUD",
          "chapter": 1,
          "verse": 2
        }
      ],
      "en": "May mercy, peace, and love be multiplied to you.",
      "ko": "긍휼과 평강과 사랑이 너희에게 더욱 많을찌어다",
      "source_text_hash": "eda0025737ba3e004dccdd11fb5a03e0b4db81f992faf0559cc8ca573922bd5d",
      "translation_text_hash": "566932ad01a82fe7e226fc3f1ebf56dcef6fa00485c61513e61f960a1d2fbbe7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "긍휼과 평강과 사랑이 너희에게 더욱 많을찌어다"
      ],
      "raw_text_hashes": [
        "566932ad01a82fe7e226fc3f1ebf56dcef6fa00485c61513e61f960a1d2fbbe7"
      ]
    },
    {
      "canonical_locator": "bible:web:JUD:1:3",
      "sequence": 30672,
      "chapter_label": "JUD 1",
      "verse_label": "3",
      "locator": {
