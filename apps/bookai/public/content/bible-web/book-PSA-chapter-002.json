      "translation_text_hash": "af282c3b3cda8454b0d23df0be814041d101420808d21cff275589df7a13197c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
