      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 2,
          "verse": 8
        }
      ],
      "en": "Ask of me, and I will give the nations for your inheritance, the uttermost parts of the earth for your possession.",
      "ko": "내게 구하라 내가 열방을 유업으로 주리니 네 소유가 땅 끝까지 이르리로다",
      "source_text_hash": "b074164ddecfc7010d18e86232121a89d934c33e7e92a74eb8648d38669228bd",
      "translation_text_hash": "a4677e9ac625ea3490310f9593d98573fa8c336d53995dc3161fa3c3c51b1392",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게 구하라 내가 열방을 유업으로 주리니 네 소유가 땅 끝까지 이르리로다"
      ],
      "raw_text_hashes": [
        "a4677e9ac625ea3490310f9593d98573fa8c336d53995dc3161fa3c3c51b1392"
      ]
    },
