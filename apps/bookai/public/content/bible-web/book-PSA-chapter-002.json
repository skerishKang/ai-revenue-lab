      "raw_texts": [
        "네가 철장으로 저희를 깨뜨림이여 질그릇 같이 부수리라 하시도다"
      ],
      "raw_text_hashes": [
        "c201d9f3df462987631eaeee5bb12378358191164f2d9ff9662c737716694eb2"
      ]
    },
