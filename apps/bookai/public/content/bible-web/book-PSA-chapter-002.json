      "ko": "여호와를 경외함으로 섬기고 떨며 즐거워할지어다",
      "source_text_hash": "cd1732858cf3130bee2b2ee5544a83c1a8430aacf9dc2999b2c95da48ddf45e0",
      "translation_text_hash": "7af15decb9f88e9a28f4d28666cd05e2ffdb8d96bb65f7fbc2a9f2edd897541e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
