        {
          "book": "SNG",
          "chapter": 3,
          "verse": 7
        }
      ],
      "en": "Behold, it is Solomon’s carriage! Sixty mighty men are around it, of the mighty men of Israel.",
      "ko": "이는 솔로몬의 연이라 이스라엘 용사 중 육십인이 옹위하였는데",
      "source_text_hash": "193512d93c791a539579fa3852a66171372ea9bbe29622908c83460058a629d9",
      "translation_text_hash": "940394eaacea9ea41901c5889b40a9d16c697e5cd7f18044df8598cef21de995",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 솔로몬의 연이라 이스라엘 용사 중 육십인이 옹위하였는데"
      ],
      "raw_text_hashes": [
        "940394eaacea9ea41901c5889b40a9d16c697e5cd7f18044df8598cef21de995"
      ]
    },
