      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 밤에 침상에서 마음에 사랑하는 자를 찾았구나 찾아도 발견치 못하였구나"
      ],
      "raw_text_hashes": [
