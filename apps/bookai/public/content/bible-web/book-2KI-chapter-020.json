        {
          "book": "2KI",
          "chapter": 20,
          "verse": 2
        }
      ],
      "en": "Then he turned his face to the wall, and prayed to the LORD, saying,",
      "ko": "히스기야가 낯을 벽으로 향하고 여호와께 기도하여 가로되",
      "source_text_hash": "aae4e1ad57f3399bbf456297c5a136e3f57130424de270008f0202d7f5a316ad",
      "translation_text_hash": "8a80a5da5b2fc549ec74a377cb34e2b832b5c4640ca1daccdbb2bd5f691a3d75",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "히스기야가 낯을 벽으로 향하고 여호와께 기도하여 가로되"
      ],
      "raw_text_hashes": [
        "8a80a5da5b2fc549ec74a377cb34e2b832b5c4640ca1daccdbb2bd5f691a3d75"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:20:3",
      "sequence": 10102,
      "chapter_label": "2KI 20",
      "verse_label": "3",
      "locator": {
