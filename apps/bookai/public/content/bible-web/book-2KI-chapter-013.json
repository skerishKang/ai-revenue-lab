      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 13,
          "verse": 4
        }
      ],
      "en": "Jehoahaz begged the LORD, and the LORD listened to him; for he saw the oppression of Israel, how the king of Syria oppressed them.",
      "ko": "아람 왕이 이스라엘을 학대하므로 여호아하스가 여호와께 간구하매 여호와께서 들으셨으니 이는 저희의 학대 받음을 보셨음이라",
      "source_text_hash": "396aa74b536d538e16509ecdde022a18614f6f0499b5df0b5c19a4893199a77c",
      "translation_text_hash": "398afaac415cfece4a4297af4423fbed7da1406cb02f264c202288b849b8f88e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아람 왕이 이스라엘을 학대하므로 여호아하스가 여호와께 간구하매 여호와께서 들으셨으니 이는 저희의 학대 받음을 보셨음이라"
      ],
      "raw_text_hashes": [
