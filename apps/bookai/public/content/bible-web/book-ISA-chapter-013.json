      "source_text_hash": "2d1b2dd3c096162f64d5b36a7c7b668f07c0bdd4458792be44025ddb4a8f39fc",
      "translation_text_hash": "79e929e5fe6e8ead3e8bd6d8fcd67f2ebce17a897c4168811b37a8e64439ec34",
      "translation_policy": "krv-1961-source-mapped",
