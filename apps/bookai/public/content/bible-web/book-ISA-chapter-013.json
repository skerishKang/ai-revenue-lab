      "source_text_hash": "c27c86ef43e2508f85ef990be9440a5db3fdfdb470da687b4457aba8365d0e7b",
      "translation_text_hash": "34e2486b71cadc1f37b48ccbaf72cbb23c15e02056705b2b9d28c97f1261f088",
