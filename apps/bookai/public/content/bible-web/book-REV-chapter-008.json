      "translation_text_hash": "3eaf796c0c5bf2f206b8d8f43aeb3398ff809556166c093cf3cf23191518015e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
