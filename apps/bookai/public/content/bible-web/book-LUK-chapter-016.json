      "raw_texts": [
        "한 부자가 있어 자색 옷과 고운 베옷을 입고 날마다 호화로이 연락하는데"
      ],
      "raw_text_hashes": [
        "efe9211aaaf9d23769689c22048d93714c5f693c8eba9b6df9e34dbddc7c0205"
