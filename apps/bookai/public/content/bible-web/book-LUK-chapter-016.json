      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "율법과 선지자는 요한의 때까지요 그 후부터는 하나님 나라의 복음이 전파되어 사람마다 그리로 침입하느니라"
      ],
      "raw_text_hashes": [
