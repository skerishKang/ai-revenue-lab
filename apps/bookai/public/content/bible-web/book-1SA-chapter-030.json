      "raw_texts": [
        "이에 다윗과 그와 함께한 육백명이 가서 브솔 시내에 이르러는 뒤떨어진 자를 거기 머물렀으되"
      ],
      "raw_text_hashes": [
        "fe88f27e2604dcee8feb93f08340a62d125032482c7d7b8d7c09c9b50e9e64ae"
