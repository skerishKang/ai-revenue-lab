        "verse": 2
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 21,
          "verse": 2
        }
      ],
      "en": "“Please inquire of the LORD for us; for Nebuchadnezzar king of Babylon makes war against us. Perhaps the LORD will deal with us according to all his wondrous works, that he may withdraw from us.”",
      "ko": "(1절에 포함되어 있음)",
      "source_text_hash": "a343930552f9f74afd7e67bab0728b1c2685779e2a9dd6b857b6dad8be718d3f",
      "translation_text_hash": "253b718e6a12d2bbd3630b6fd63da0bb9fdae2f1058f047b1053efe936f06e24",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "(1절에 포함되어 있음)"
      ],
      "raw_text_hashes": [
        "253b718e6a12d2bbd3630b6fd63da0bb9fdae2f1058f047b1053efe936f06e24"
      ]
    },
    {
