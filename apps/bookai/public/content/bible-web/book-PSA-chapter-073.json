      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 73,
          "verse": 7
        }
      ],
      "en": "Their eyes bulge with fat. Their minds pass the limits of conceit.",
      "ko": "살찜으로 저희 눈이 솟아나며 저희 소득은 마음의 소원보다 지나며",
      "source_text_hash": "8c55609920612050435bb52978f69b0d4af2a2adb5725fae7d9d02d7385c2cc1",
      "translation_text_hash": "4829b0dbc8c3aa1c620bc01e071bb625460141c2befed3bc6ce4f8d2e6671fd7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "살찜으로 저희 눈이 솟아나며 저희 소득은 마음의 소원보다 지나며"
      ],
      "raw_text_hashes": [
        "4829b0dbc8c3aa1c620bc01e071bb625460141c2befed3bc6ce4f8d2e6671fd7"
      ]
