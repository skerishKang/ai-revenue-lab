      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 73,
          "verse": 5
        }
      ],
      "en": "They are free from burdens of men, neither are they plagued like other men.",
      "ko": "타인과 같은 고난이 없고 타인과 같은 재앙도 없나니",
      "source_text_hash": "e2786b9f8aeb7c8ab9f87e8b074cf11b4c870a71c15175b7ed98201b916b34ea",
      "translation_text_hash": "f9134b85873223cf20ce57445d6d337f074da291f611b300ef68536450ffd9ad",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
