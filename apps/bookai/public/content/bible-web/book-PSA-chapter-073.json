      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 73,
          "verse": 13
        }
      ],
      "en": "Surely I have cleansed my heart in vain, and washed my hands in innocence,",
      "ko": "내가 내 마음을 정히 하며 내 손을 씻어 무죄하다 한 것이 실로 헛되도다",
      "source_text_hash": "24f8c748cef4429ef15b35c0561d32a4e787b2a41c006d5d209150a533829a99",
      "translation_text_hash": "4c3d2e69c989a2eb8273841ef9a44047c6b6f97996f63c85ec73eed6b39286c8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 내 마음을 정히 하며 내 손을 씻어 무죄하다 한 것이 실로 헛되도다"
      ],
      "raw_text_hashes": [
        "4c3d2e69c989a2eb8273841ef9a44047c6b6f97996f63c85ec73eed6b39286c8"
      ]
    },
