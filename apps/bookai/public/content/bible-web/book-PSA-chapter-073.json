      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 73,
          "verse": 9
        }
      ],
      "en": "They have set their mouth in the heavens. Their tongue walks through the earth.",
      "ko": "저희 입은 하늘에 두고 저희 혀는 땅에 두루 다니도다",
      "source_text_hash": "785d516303f53519d8003986ee97d49e2e04df30754decadebd2d29a7bea86b7",
      "translation_text_hash": "79d0420b9a08a31004ccb7a7f1667971a02cd410c9ea4f8d24d5b4ca1e2ab4bc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희 입은 하늘에 두고 저희 혀는 땅에 두루 다니도다"
