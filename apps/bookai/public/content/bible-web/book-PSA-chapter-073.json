      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 73,
          "verse": 6
        }
      ],
      "en": "Therefore pride is like a chain around their neck. Violence covers them like a garment.",
      "ko": "그러므로 교만이 저희 목걸이요 강포가 저희의 입는 옷이며",
      "source_text_hash": "259df15711f6e5632a542f54974f652ceaee77221e752165c05a78ee89205705",
      "translation_text_hash": "fc2e9426a740f5c2c08f594cb876e1af61711c051b9e8de8857fb8d47c8b482e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
