      "translation_text_hash": "c7303a9b64d169adb388cdba0decb6370d994cd5e9ea23fd66a79c04cfcb60dc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "거기 있는 병자들을 고치고 또 말하기를 하나님의 나라가 너희에게 가까이 왔다 하라"
      ],
      "raw_text_hashes": [
        "c7303a9b64d169adb388cdba0decb6370d994cd5e9ea23fd66a79c04cfcb60dc"
      ]
