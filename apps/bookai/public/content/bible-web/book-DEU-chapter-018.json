      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 18,
          "verse": 15
        }
      ],
      "en": "The LORD your God will raise up to you a prophet from among you, of your brothers, like me. You shall listen to him.",
      "ko": "네 하나님 여호와께서 너의 중 네 형제 중에서 나와 같은 선지자 하나를 너를 위하여 일으키시리니 너희는 그를 들을찌니라",
      "source_text_hash": "45d8b94c42327ff57be47fa57ee58bd6e0831ab5240c7bd35a88d8a397b9e118",
      "translation_text_hash": "4f1704f3498f3813ca8cab11dce38e4b8204ae9f6e6720a87e21fdc213003bed",
      "translation_policy": "krv-1961-source-mapped",
