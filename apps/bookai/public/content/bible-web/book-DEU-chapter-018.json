      ],
      "en": "It shall happen, that whoever will not listen to my words which he shall speak in my name, I will require it of him.",
      "ko": "무릇 그가 내 이름으로 고하는 내 말을 듣지 아니하는 자는 내게 벌을 받을 것이요",
      "source_text_hash": "b91fe65986b55fe2be7c7dbf968d2c4dda4a44b8ad15e9c8be1b2acdfc61c03c",
      "translation_text_hash": "2e7efcef923f3970858661ce0f760dd880595c58c65affa4ec886e79d484baf3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 그가 내 이름으로 고하는 내 말을 듣지 아니하는 자는 내게 벌을 받을 것이요"
      ],
      "raw_text_hashes": [
        "2e7efcef923f3970858661ce0f760dd880595c58c65affa4ec886e79d484baf3"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:18:20",
      "sequence": 5405,
      "chapter_label": "DEU 18",
