      "source_text_hash": "5458e3ce844870dd97d9b8b254c2d5297d1f697cee4ead466d3daba32cd928a0",
      "translation_text_hash": "e539a91326ee6e1f6a8e414b1c3c3bdec28a8d80d5d70f561f5ceb0149b33271",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 네 이웃을 압제하지 말며 늑탈하지 말며 품군의 삯을 아침까지 밤새도록 네게 두지 말며"
      ],
