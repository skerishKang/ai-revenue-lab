      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 19,
          "verse": 20
        }
      ],
      "en": "“‘If a man lies carnally with a woman who is a slave girl, pledged to be married to another man, and not ransomed or given her freedom; they shall be punished. They shall not be put to death, because she was not free.",
      "ko": "무릇 아직 속량도 되지 못하고 해방도 되지 못하고 정혼한 씨종과 사람이 행음하면 두 사람이 형벌은 받으려니와 그들이 죽임을 당치 아니할 것은 그 여인은 아직 해방되지 못하였음이라",
      "source_text_hash": "b1f1b185eeff27c5e8cddfbfaef9f2aaab302398ae5bafbad0262a7fa6f278f2",
      "translation_text_hash": "610489c0bdf9d389309b86b618fcb0b594863bdcb4d3a41bc201c9a87e99d9dc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 아직 속량도 되지 못하고 해방도 되지 못하고 정혼한 씨종과 사람이 행음하면 두 사람이 형벌은 받으려니와 그들이 죽임을 당치 아니할 것은 그 여인은 아직 해방되지 못하였음이라"
      ],
      "raw_text_hashes": [
