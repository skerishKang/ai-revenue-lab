      "source_text_hash": "9b2c49db2d75813414b33f4e7bdddbe8e404b48f688a7166ca73f6d7de4826db",
      "translation_text_hash": "3a62e5e9bebc1ea9d63947bff058674e4c1f61e8d3576d81b6987d6f6e98273c",
      "translation_policy": "krv-1961-source-mapped",
