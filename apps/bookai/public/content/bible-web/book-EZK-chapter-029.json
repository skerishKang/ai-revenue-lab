      "sequence": 21203,
      "chapter_label": "EZK 29",
      "verse_label": "19",
      "locator": {
        "book": "EZK",
        "chapter": 29,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 29,
          "verse": 19
        }
      ],
      "en": "Therefore the Lord GOD says: ‘Behold, I will give the land of Egypt to Nebuchadnezzar king of Babylon. He will carry off her multitude, take her plunder, and take her prey. That will be the wages for his army.",
      "ko": "그러므로 나 주 여호와가 말하노라 내가 애굽 땅을 바벨론 왕 느부갓네살에게 붙이리니 그가 그 무리를 옮겨가며 물건을 노략하며 빼앗아 갈 것이라 이것이 그 군대의 보수가 되리라",
      "source_text_hash": "6f21e8dde84871239f4c528ff5605480da72dab775fe9dfd9121f534760ba966",
      "translation_text_hash": "2d3f7de0f34d3b6ef24306b0a5f030b64e8bfb797d1131d0b3f3adcc2b95f77e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 나 주 여호와가 말하노라 내가 애굽 땅을 바벨론 왕 느부갓네살에게 붙이리니 그가 그 무리를 옮겨가며 물건을 노략하며 빼앗아 갈 것이라 이것이 그 군대의 보수가 되리라"
      ],
      "raw_text_hashes": [
