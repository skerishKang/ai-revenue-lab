    {
      "canonical_locator": "bible:web:EZK:29:12",
      "sequence": 21196,
      "chapter_label": "EZK 29",
      "verse_label": "12",
      "locator": {
        "book": "EZK",
        "chapter": 29,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 29,
          "verse": 12
        }
      ],
      "en": "I will make the land of Egypt a desolation in the middle of the countries that are desolate. Her cities among the cities that are laid waste will be a desolation forty years. I will scatter the Egyptians among the nations, and will disperse them through the countries.”",
      "ko": "내가 애굽 땅으로 황무한 열국 같이 황무하게 하며 애굽 성읍도 사막이 된 열국의 성읍 같이 사십년 동안 황무하게 하고 애굽 사람들은 각국 가운데로 흩으며 열방 가운데로 헤치리라",
      "source_text_hash": "4c1ceaf78e6ec34e870a90750cbce59b10beb5c64de1deb67467b3388d8de08a",
      "translation_text_hash": "1c739926faa72a61d10dc1a515994b9ae55f284fa0d41068856d6d0593898f5c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 애굽 땅으로 황무한 열국 같이 황무하게 하며 애굽 성읍도 사막이 된 열국의 성읍 같이 사십년 동안 황무하게 하고 애굽 사람들은 각국 가운데로 흩으며 열방 가운데로 헤치리라"
      ],
      "raw_text_hashes": [
        "1c739926faa72a61d10dc1a515994b9ae55f284fa0d41068856d6d0593898f5c"
