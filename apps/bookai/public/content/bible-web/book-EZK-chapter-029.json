    {
      "canonical_locator": "bible:web:EZK:29:11",
      "sequence": 21195,
      "chapter_label": "EZK 29",
      "verse_label": "11",
      "locator": {
        "book": "EZK",
        "chapter": 29,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 29,
          "verse": 11
        }
      ],
      "en": "No foot of man will pass through it, nor will any animal foot pass through it. It won’t be inhabited for forty years.",
      "ko": "그 가운데로 사람의 발도 지나가지 아니하며 짐승의 발도 지나가지 아니하고 거접하는 사람이 없이 사십년이 지날찌라",
      "source_text_hash": "0096ff62bdecf943bf40bda84727bcd811ad5d2827b3486f3359573c67e416d9",
      "translation_text_hash": "ccdcc4aab56e00eb81e0efb3c27ed6e6a69bc6765f205ec27ac1d9a9b9a80307",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 가운데로 사람의 발도 지나가지 아니하며 짐승의 발도 지나가지 아니하고 거접하는 사람이 없이 사십년이 지날찌라"
      ],
      "raw_text_hashes": [
        "ccdcc4aab56e00eb81e0efb3c27ed6e6a69bc6765f205ec27ac1d9a9b9a80307"
      ]
