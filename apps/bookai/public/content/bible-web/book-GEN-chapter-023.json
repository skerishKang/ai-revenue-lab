      ],
      "en": "Sarah lived one hundred twenty-seven years. This was the length of Sarah’s life.",
      "ko": "사라가 일백 이십 칠세를 살았으니 이것이 곧 사라의 향년이라",
      "source_text_hash": "ae0005aae630d62229361123d0c6618053d85ef65caddc2aa5b50791553af459",
      "translation_text_hash": "3c32844e800591370d50e8a650036a85518eb4d469d667612d2296087a9943db",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사라가 일백 이십 칠세를 살았으니 이것이 곧 사라의 향년이라"
      ],
      "raw_text_hashes": [
        "3c32844e800591370d50e8a650036a85518eb4d469d667612d2296087a9943db"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:23:2",
      "sequence": 574,
      "chapter_label": "GEN 23",
      "verse_label": "2",
