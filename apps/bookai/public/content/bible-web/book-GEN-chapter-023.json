        }
      ],
      "en": "Abraham bowed himself down before the people of the land.",
      "ko": "아브라함이 이에 그 땅 백성을 대하여 몸을 굽히고",
      "source_text_hash": "a78f2827c4b4d4bbd31314a841d4c68f68a417cc8959140da7d8e04ec418bd68",
      "translation_text_hash": "2245e9d0048535dd82dbf1308e97f5e3c52ee49e021dc4e9adc4f445283eb994",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브라함이 이에 그 땅 백성을 대하여 몸을 굽히고"
      ],
      "raw_text_hashes": [
        "2245e9d0048535dd82dbf1308e97f5e3c52ee49e021dc4e9adc4f445283eb994"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:23:13",
      "sequence": 585,
      "chapter_label": "GEN 23",
      "verse_label": "13",
      "locator": {
        "book": "GEN",
