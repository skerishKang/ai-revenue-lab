        "verse": 3
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 23,
          "verse": 3
        }
      ],
      "en": "Abraham rose up from before his dead and spoke to the children of Heth, saying,",
      "ko": "그 시체 앞에서 일어나 나가서 헷 족속에게 말하여 가로되",
      "source_text_hash": "a8722897bbe52c3fd446366fcf47876f84e1e7882c317b09f88b04cd098d6c8f",
      "translation_text_hash": "33d2e05d72d713decc4501926b682d242f65692086aa819e009a1f98510207cd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 시체 앞에서 일어나 나가서 헷 족속에게 말하여 가로되"
      ],
      "raw_text_hashes": [
        "33d2e05d72d713decc4501926b682d242f65692086aa819e009a1f98510207cd"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:23:4",
      "sequence": 576,
      "chapter_label": "GEN 23",
      "verse_label": "4",
      "locator": {
        "book": "GEN",
        "chapter": 23,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 23,
          "verse": 4
        }
      ],
      "en": "“I am a stranger and a foreigner living with you. Give me a possession of a burying-place with you, that I may bury my dead out of my sight.”",
      "ko": "나는 당신들 중에 나그네요 우거한 자니 청컨대 당신들 중에서 내게 매장지를 주어 소유를 삼아 나로 내 죽은 자를 내어 장사하게 하시오",
      "source_text_hash": "1a837fda3f2a1eae7080d16ca425952afb33e945f37830cca932a8ce7d027cba",
      "translation_text_hash": "c0e302c73cfb97015c3a79174ce1980627afd6ccbeb1b164df984d90223b0e98",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 당신들 중에 나그네요 우거한 자니 청컨대 당신들 중에서 내게 매장지를 주어 소유를 삼아 나로 내 죽은 자를 내어 장사하게 하시오"
      ],
      "raw_text_hashes": [
        "c0e302c73cfb97015c3a79174ce1980627afd6ccbeb1b164df984d90223b0e98"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:23:5",
      "sequence": 577,
      "chapter_label": "GEN 23",
      "verse_label": "5",
      "locator": {
