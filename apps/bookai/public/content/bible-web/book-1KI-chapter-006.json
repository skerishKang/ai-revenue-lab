      "en": "He made windows of fixed lattice work for the house.",
      "ko": "전을 위하여 붙박이 교창을 내고",
      "source_text_hash": "389f223179a19d2c9700a78c298c210e6e108809692f1c23e2106915e64f0e68",
      "translation_text_hash": "16ceee4ffdbdd88b27d7e52c847e69f5cafe97f86d877a6cc3f4c901cce2b474",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "전을 위하여 붙박이 교창을 내고"
      ],
      "raw_text_hashes": [
        "16ceee4ffdbdd88b27d7e52c847e69f5cafe97f86d877a6cc3f4c901cce2b474"
      ]
