      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 6,
          "verse": 6
        }
      ],
      "en": "The lowest floor was five cubits wide, and the middle was six cubits wide, and the third was seven cubits wide; for on the outside he made offsets in the wall of the house all around, that the beams should not be inserted into the walls of the house.",
      "ko": "하층 다락의 광은 다섯 규빗이요 중층 다락의 광은 여섯 규빗이요 제 삼층 다락의 광은 일곱 규빗이라 전의 벽 바깥으로 돌아가며 턱을 내어 골방 들보들로 전의 벽에 박히지 않게 하였으며",
      "source_text_hash": "b3e590c628e37684291452cf622b826e94c49d689d3cf40de19b0f93100adcdc",
      "translation_text_hash": "3ae985f31fde005f95ce0798148226019894c88e90f48d6d2bf1907a9cb519b2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하층 다락의 광은 다섯 규빗이요 중층 다락의 광은 여섯 규빗이요 제 삼층 다락의 광은 일곱 규빗이라 전의 벽 바깥으로 돌아가며 턱을 내어 골방 들보들로 전의 벽에 박히지 않게 하였으며"
      ],
      "raw_text_hashes": [
