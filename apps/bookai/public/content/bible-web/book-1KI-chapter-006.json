      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "솔로몬이 정금으로 외소 안에 입히고 내소 앞에 금사슬로 건너지르고 내소를 금으로 입히고"
      ],
      "raw_text_hashes": [
        "a1747affb1a16b37164c08b41e6ad2fcb6adee0449e506feecb32c344cde975a"
      ]
    },
