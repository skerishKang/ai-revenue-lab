      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 6,
          "verse": 11
        }
      ],
      "en": "The LORD’s word came to Solomon, saying,",
      "ko": "여호와의 말씀이 솔로몬에게 임하여 가라사대",
      "source_text_hash": "850f65009a4fedca785028d0c46c5afa32484e112af8d0368df83db3f442d5dc",
      "translation_text_hash": "2c8038708d0a62b6b14feb4fae097c781a3f69dcb583b7a6525beced83f9fa21",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 솔로몬에게 임하여 가라사대"
      ],
      "raw_text_hashes": [
        "2c8038708d0a62b6b14feb4fae097c781a3f69dcb583b7a6525beced83f9fa21"
      ]
    },
    {
