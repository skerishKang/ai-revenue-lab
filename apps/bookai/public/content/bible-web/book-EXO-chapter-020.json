      "source_text_hash": "ff9dbbc32767d8bab766ef6c8fe8f7a5cefcc351709ad5487d71aa1de56bb21b",
      "translation_text_hash": "7f00b642fb796b40ea76ed7173f947f08eca752d27430fd3cc6b6681b6d9be30",
      "translation_policy": "krv-1961-source-mapped",
