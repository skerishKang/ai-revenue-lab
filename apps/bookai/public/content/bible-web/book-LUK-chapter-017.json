      "ko": "명한대로 하였다고 종에게 사례하겠느냐",
      "source_text_hash": "edd4b069b490dd42fcbf0dbabdac7750ed98d444698e2657472f6e2d2c606ba0",
      "translation_text_hash": "808b80e93042763bf6658153cce08dfd0a4764be35eb3ae5f38043befb91271b",
      "translation_policy": "krv-1961-source-mapped",
