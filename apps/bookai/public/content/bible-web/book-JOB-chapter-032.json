      "en": "When Elihu saw that there was no answer in the mouth of these three men, his wrath was kindled.",
      "ko": "세 사람의 입에 대답이 없음을 보고 노를 발하니라",
      "source_text_hash": "1c04617c614858e0c76404b53e9f8444c819164ca88e1971694c352dba194d97",
      "translation_text_hash": "d163fbcc8c853e6eb810a0becb11e2dc80e6b72f9a62f4001dbe28ac4ce77b61",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "세 사람의 입에 대답이 없음을 보고 노를 발하니라"
      ],
      "raw_text_hashes": [
        "d163fbcc8c853e6eb810a0becb11e2dc80e6b72f9a62f4001dbe28ac4ce77b61"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:32:6",
      "sequence": 13635,
