      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "욥이 스스로 의롭게 여기므로 그 세 사람의 대답이 그치매"
      ],
      "raw_text_hashes": [
        "31d677610246b0ee25772331ce4db7f22a8c6e94342b5ed21d08d2355a5c8095"
      ]
