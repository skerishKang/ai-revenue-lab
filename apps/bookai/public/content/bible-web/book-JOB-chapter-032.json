      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 32,
          "verse": 9
        }
      ],
      "en": "It is not the great who are wise, nor the aged who understand justice.",
      "ko": "대인이라고 지혜로운 것이 아니요 노인이라고 공의를 깨닫는 것이 아니라",
      "source_text_hash": "fb3247fab2d5598c6872eb49b7fd2f43230f5adaf65451651af6653002b6d727",
      "translation_text_hash": "448fbc6ae6e4fe20c023e43dbf437021ff5c49430824d62e52d90afde3e18705",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대인이라고 지혜로운 것이 아니요 노인이라고 공의를 깨닫는 것이 아니라"
      ],
      "raw_text_hashes": [
        "448fbc6ae6e4fe20c023e43dbf437021ff5c49430824d62e52d90afde3e18705"
      ]
    },
    {
