      ],
      "en": "But there is a spirit in man, and the Spirit of the Almighty gives them understanding.",
      "ko": "사람의 속에는 심령이 있고 전능자의 기운이 사람에게 총명을 주시나니",
      "source_text_hash": "48d2bb638bdeba8931e09fa898e2e0bd594adf89504a05bf7f85af34445e7e4d",
      "translation_text_hash": "904376c94ffbaefd3fa84737daccc6b70286622a63725ca429333b97bba6b71d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람의 속에는 심령이 있고 전능자의 기운이 사람에게 총명을 주시나니"
      ],
      "raw_text_hashes": [
        "904376c94ffbaefd3fa84737daccc6b70286622a63725ca429333b97bba6b71d"
      ]
    },
    {
