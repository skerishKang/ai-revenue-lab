  "passages": [
    {
      "canonical_locator": "bible:web:1TI:6:1",
      "sequence": 29786,
      "chapter_label": "1TI 6",
      "verse_label": "1",
      "locator": {
        "book": "1TI",
        "chapter": 6,
        "verse": 1
