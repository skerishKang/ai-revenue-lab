        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 6,
          "verse": 6
        }
      ],
      "en": "But godliness with contentment is great gain.",
      "ko": "그러나 지족하는 마음이 있으면 경건이 큰 이익이 되느니라",
      "source_text_hash": "53629658917c8a4ea517ee8fc80ae5cb7530907ff728c2bfccdb14e4b1f89cc2",
      "translation_text_hash": "5870798dca0abcfa5015b897a1acc89d2f7296dc56a2ae40bb43aae9e86c7ef7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 지족하는 마음이 있으면 경건이 큰 이익이 되느니라"
      ],
      "raw_text_hashes": [
        "5870798dca0abcfa5015b897a1acc89d2f7296dc56a2ae40bb43aae9e86c7ef7"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:6:7",
      "sequence": 29792,
      "chapter_label": "1TI 6",
      "verse_label": "7",
      "locator": {
        "book": "1TI",
