      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사악을 행하는 자에게서 나를 건지시고 피흘리기를 즐기는 자에게서 나를 구원하소서"
      ],
      "raw_text_hashes": [
        "74cbd06f08779bb281fc5c9cc924809567ea8c98339f31e71f5396000e63439c"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:59:3",
      "sequence": 14794,
      "chapter_label": "PSA 59",
