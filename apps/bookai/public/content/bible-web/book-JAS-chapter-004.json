    {
      "canonical_locator": "bible:web:JAS:4:2",
      "sequence": 30336,
      "chapter_label": "JAS 4",
      "verse_label": "2",
      "locator": {
        "book": "JAS",
        "chapter": 4,
        "verse": 2
      },
      "raw_locator": [
        {
          "book": "JAS",
          "chapter": 4,
          "verse": 2
        }
      ],
      "en": "You lust, and don’t have. You murder and covet, and can’t obtain. You fight and make war. You don’t have, because you don’t ask.",
      "ko": "너희가 욕심을 내어도 얻지 못하고 살인하며 시기하여도 능히 취하지 못하나니 너희가 다투고 싸우는도다 너희가 얻지 못함은 구하지 아니함이요",
      "source_text_hash": "8cdb39e928997f7bfc673aff38943e34210c44a85921a65d52773d039c97bcf4",
      "translation_text_hash": "bb22f28384b0c4d006cbf7edc60658023372c79114c8791af6febd6a636d4168",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 욕심을 내어도 얻지 못하고 살인하며 시기하여도 능히 취하지 못하나니 너희가 다투고 싸우는도다 너희가 얻지 못함은 구하지 아니함이요"
      ],
      "raw_text_hashes": [
        "bb22f28384b0c4d006cbf7edc60658023372c79114c8791af6febd6a636d4168"
      ]
