      "translation_text_hash": "75b2cd6caa5f3fe91abaf8ff870fb1c3d3a56e1fd5a612f56058989e7cd12180",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
