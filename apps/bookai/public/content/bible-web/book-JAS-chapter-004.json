        "verse": 9
      },
      "raw_locator": [
        {
          "book": "JAS",
          "chapter": 4,
          "verse": 9
        }
      ],
      "en": "Lament, mourn, and weep. Let your laughter be turned to mourning and your joy to gloom.",
      "ko": "슬퍼하며 애통하며 울찌어다 너희 웃음을 애통으로, 너희 즐거움을 근심으로 바꿀찌어다",
      "source_text_hash": "d7aee166176b7374e83290013abcaea98b0e7e3beb5350e47b24863fffefd9b1",
      "translation_text_hash": "943c6204f1504271f29fd3aa315a97391a27018439f055951175719d32229bb5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "슬퍼하며 애통하며 울찌어다 너희 웃음을 애통으로, 너희 즐거움을 근심으로 바꿀찌어다"
      ],
      "raw_text_hashes": [
