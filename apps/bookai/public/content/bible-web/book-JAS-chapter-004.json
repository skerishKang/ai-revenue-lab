        "verse": 3
      },
      "raw_locator": [
        {
          "book": "JAS",
          "chapter": 4,
          "verse": 3
        }
      ],
      "en": "You ask, and don’t receive, because you ask with wrong motives, so that you may spend it on your pleasures.",
      "ko": "구하여도 받지 못함은 정욕으로 쓰려고 잘못 구함이니라",
      "source_text_hash": "8fd9c785d948c59e43f6bd098869c237a8b28f6fd5a7847734f4b2c3801efa85",
      "translation_text_hash": "b4dd919f19e9dda31c115a82ffe3875bae6828a0ab06a3bc5356db04ad805e82",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "구하여도 받지 못함은 정욕으로 쓰려고 잘못 구함이니라"
      ],
      "raw_text_hashes": [
        "b4dd919f19e9dda31c115a82ffe3875bae6828a0ab06a3bc5356db04ad805e82"
      ]
    },
    {
      "canonical_locator": "bible:web:JAS:4:4",
      "sequence": 30338,
      "chapter_label": "JAS 4",
      "verse_label": "4",
