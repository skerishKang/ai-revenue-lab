      "source_text_hash": "33afa7ad8176abafda8d92bf3a988df5dd59280763d6f35e40245043439860ab",
      "translation_text_hash": "47f4525a662c1e52fba33d1cd72a7cc6354a4413ff527f403e2e98870e0d09d4",
      "translation_policy": "krv-1961-source-mapped",
