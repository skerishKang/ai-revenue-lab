      "translation_text_hash": "6e8e87300f865f595ee048e3b29507cd5718a752ef1d00c5bbb6879759be6d66",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
