      "source_text_hash": "edbbd822f8f5feabb687aa73bb0983d314f1526efb8e58fc8ef881c71a0cb166",
      "translation_text_hash": "14005611349cf8790b17145532fc39b9ba7543f9854362c7a8e31e8a1f81d7f6",
