        {
          "book": "ISA",
          "chapter": 22,
          "verse": 7
        }
      ],
      "en": "Your choicest valleys were full of chariots, and the horsemen set themselves in array at the gate.",
      "ko": "병거는 너의 아름다운 골짜기에 가득하였고 마병은 성문에 정렬되었도다",
      "source_text_hash": "80a727f973a65a6de743eb2e002782dec3513876d5724a54df744d3d3d54a648",
      "translation_text_hash": "c1a43dd8477d7b04b9ccd711516bb7d81864177b3d8bfbd8cdc6eab7bb22d2b6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "병거는 너의 아름다운 골짜기에 가득하였고 마병은 성문에 정렬되었도다"
      ],
      "raw_text_hashes": [
        "c1a43dd8477d7b04b9ccd711516bb7d81864177b3d8bfbd8cdc6eab7bb22d2b6"
