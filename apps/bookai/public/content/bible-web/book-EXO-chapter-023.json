      "en": "You shall not favor a poor man in his cause.",
      "ko": "가난한 자의 송사라고 편벽되이 두호하지 말찌니라",
      "source_text_hash": "4405adb64923543de1e227b2106448403fadfd9135ecbe3d14552ec0df95cb4e",
      "translation_text_hash": "068f240011fcb6d0c00043a8fd11aa35875a2a57e8ccf417b130b43cd0af66cb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가난한 자의 송사라고 편벽되이 두호하지 말찌니라"
      ],
      "raw_text_hashes": [
        "068f240011fcb6d0c00043a8fd11aa35875a2a57e8ccf417b130b43cd0af66cb"
      ]
    },
