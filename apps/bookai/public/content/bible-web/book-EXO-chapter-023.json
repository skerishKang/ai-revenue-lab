    {
      "canonical_locator": "bible:web:EXO:23:27",
      "sequence": 2172,
      "chapter_label": "EXO 23",
      "verse_label": "27",
      "locator": {
        "book": "EXO",
        "chapter": 23,
        "verse": 27
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 23,
          "verse": 27
        }
      ],
      "en": "I will send my terror before you, and will confuse all the people to whom you come, and I will make all your enemies turn their backs to you.",
      "ko": "내가 내 위엄을 네 앞서 보내어 너의 이를 곳의 모든 백성을 파하고 너의 모든 원수로 너를 등지게 할 것이며",
      "source_text_hash": "2778fea9fc934a452f9f1d2f02cdfb18af66bdbf3346dbfa217412d265e5bbed",
      "translation_text_hash": "c780024a3c207f9007e4759d181c87b411a82b25d2d5cb794617374556dd2e42",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 내 위엄을 네 앞서 보내어 너의 이를 곳의 모든 백성을 파하고 너의 모든 원수로 너를 등지게 할 것이며"
      ],
      "raw_text_hashes": [
        "c780024a3c207f9007e4759d181c87b411a82b25d2d5cb794617374556dd2e42"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:23:28",
      "sequence": 2173,
      "chapter_label": "EXO 23",
      "verse_label": "28",
      "locator": {
