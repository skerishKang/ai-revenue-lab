      "source_text_hash": "d9911592d81d8ace9e60d0bbc0b490991a09f42ac07b864f2e11016ba61a1496",
      "translation_text_hash": "e0491f167a2919e594c661adc7ec894c85076bf0a73507e7a554ac7bc764c1d4",
      "translation_policy": "krv-1961-source-mapped",
