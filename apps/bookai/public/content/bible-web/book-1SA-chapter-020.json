      "mapping_note": null,
      "raw_texts": [
        "요나단이 아이 뒤에서 또 외치되 지체 말고 빨리 달음질하라 하매 요나단의 아이가 살을 주워가지고 주인에게로 돌아왔으나"
      ],
      "raw_text_hashes": [
        "119ccd63d514950a032fb09d947815f9c7fe7b71ee9f34ee00ba04846056d3c8"
      ]
    },
