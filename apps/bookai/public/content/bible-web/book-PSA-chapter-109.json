      "translation_text_hash": "917e6a805ba049d0f6f4fc44b5da8975b7493dcb40f20ea58a86b0149155d256",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
