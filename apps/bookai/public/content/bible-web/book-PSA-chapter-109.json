      "translation_text_hash": "09c26d854fb2bf62105f6ea0606b1e31774f2995cc2771790e625d4aa928b844",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 사랑하나 저희는 도리어 나를 대적하니 나는 기도할 뿐이라"
      ],
      "raw_text_hashes": [
        "09c26d854fb2bf62105f6ea0606b1e31774f2995cc2771790e625d4aa928b844"
      ]
    },
    {
