      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 109,
          "verse": 7
        }
      ],
      "en": "When he is judged, let him come out guilty. Let his prayer be turned into sin.",
      "ko": "저가 판단을 받을 때에 죄를 지고 나오게 하시며 그 기도가 죄로 변케 하시며",
      "source_text_hash": "7dd412b6ee08c22096dd0dce9a65edad5bb8607e3e2e64ec9ad6b5c0fb91b92e",
      "translation_text_hash": "cff95ff57da8144486d3075349d9c6f1a890a37149b23e52b26f8f7d296d31c9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
