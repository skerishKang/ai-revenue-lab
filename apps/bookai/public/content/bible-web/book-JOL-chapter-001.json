        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JOL",
          "chapter": 1,
          "verse": 10
        }
      ],
      "en": "The field is laid waste. The land mourns, for the grain is destroyed, The new wine has dried up, and the oil languishes.",
      "ko": "밭이 황무하고 토지가 처량하니 곡식이 진하여 새 포도주가 말랐고 기름이 다하였도다",
      "source_text_hash": "5ddc396ce93a038c04f051bdb5de93efac42996d2f057af74fc37d1a60286f60",
      "translation_text_hash": "a5064de517a49e104dd4c088f66b38883113542c1f62791a9571e07f3dfc868e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "밭이 황무하고 토지가 처량하니 곡식이 진하여 새 포도주가 말랐고 기름이 다하였도다"
      ],
      "raw_text_hashes": [
        "a5064de517a49e104dd4c088f66b38883113542c1f62791a9571e07f3dfc868e"
      ]
    },
    {
      "canonical_locator": "bible:web:JOL:1:11",
      "sequence": 22303,
      "chapter_label": "JOL 1",
      "verse_label": "11",
      "locator": {
        "book": "JOL",
