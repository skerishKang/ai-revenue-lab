      "source_text_hash": "95cd1493e91ac66de447793d1f7a4db57b8dcac3363ae717d039aa856d704463",
      "translation_text_hash": "668fc8ab0a1173e5b22e8b3a17aaf8a096b65f0afdfd49f36b0a02e6e35d019d",
