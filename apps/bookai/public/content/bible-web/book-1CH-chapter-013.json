        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 13,
          "verse": 9
        }
      ],
      "en": "When they came to Chidon’s threshing floor, Uzza put out his hand to hold the ark, for the oxen stumbled.",
      "ko": "기돈의 타작 마당에 이르러서는 소들이 뛰므로 웃사가 손을 펴서 궤를 붙들었더니",
      "source_text_hash": "b90e7b927f3ca8d298cea89da5d8cb0540080b81bf4b207d702c891e8bd4a45f",
      "translation_text_hash": "fb184b7017daa24acd53acb0077a969caeda2155ecb4f1ced306aee2bbfc18e2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "기돈의 타작 마당에 이르러서는 소들이 뛰므로 웃사가 손을 펴서 궤를 붙들었더니"
      ],
      "raw_text_hashes": [
        "fb184b7017daa24acd53acb0077a969caeda2155ecb4f1ced306aee2bbfc18e2"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:13:10",
      "sequence": 10771,
      "chapter_label": "1CH 13",
