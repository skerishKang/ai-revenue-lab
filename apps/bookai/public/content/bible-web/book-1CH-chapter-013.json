      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 13,
          "verse": 4
        }
      ],
      "en": "All the assembly said that they would do so, for the thing was right in the eyes of all the people.",
      "ko": "뭇 백성이 이 일을 선히 여기므로 온 회중이 그대로 행하겠다 한지라",
      "source_text_hash": "e9c56080b364973f1b92d40c5c53321a95192398b7154caa10d42ed40c596d80",
      "translation_text_hash": "a2f2d3958235a09b86d73345b64965edc68116f4b79c9a524ef07ee1fa9c498d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "뭇 백성이 이 일을 선히 여기므로 온 회중이 그대로 행하겠다 한지라"
      ],
      "raw_text_hashes": [
        "a2f2d3958235a09b86d73345b64965edc68116f4b79c9a524ef07ee1fa9c498d"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:13:5",
      "sequence": 10766,
      "chapter_label": "1CH 13",
