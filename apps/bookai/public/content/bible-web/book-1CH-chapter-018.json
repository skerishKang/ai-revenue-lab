        "verse": 2
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 18,
          "verse": 2
        }
      ],
      "en": "He defeated Moab; and the Moabites became servants to David and brought tribute.",
      "ko": "또 모압을 치매 모압 사람이 다윗의 종이 되어 조공을 바치니라",
      "source_text_hash": "8cdfc1496dfdd80927dcc9ecee5d863f737b0752a72ce14f7f9d838540193f26",
      "translation_text_hash": "1b3a5dd6a0a8c85f4df5b1d4409be939b72f2cc3bc0820020abfa26ed4695bdf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 모압을 치매 모압 사람이 다윗의 종이 되어 조공을 바치니라"
      ],
      "raw_text_hashes": [
        "1b3a5dd6a0a8c85f4df5b1d4409be939b72f2cc3bc0820020abfa26ed4695bdf"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:18:3",
      "sequence": 10894,
      "chapter_label": "1CH 18",
      "verse_label": "3",
      "locator": {
        "book": "1CH",
        "chapter": 18,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 18,
          "verse": 3
        }
      ],
      "en": "David defeated Hadadezer king of Zobah, toward Hamath, as he went to establish his dominion by the river Euphrates.",
      "ko": "소바 왕 하닷에셀이 유브라데강 가에서 자기 권세를 펴고자 하매 다윗이 저를 쳐서 하맛까지 이르고",
      "source_text_hash": "1b9858bac8b41aa29c9c65e895e82af605a5536b8b2c9e9eb2e3a622cea790ef",
      "translation_text_hash": "41c834d8bc491e5433edf4bebb66e186cd6f0e423c5cd710922cefbda04a63da",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "소바 왕 하닷에셀이 유브라데강 가에서 자기 권세를 펴고자 하매 다윗이 저를 쳐서 하맛까지 이르고"
      ],
      "raw_text_hashes": [
        "41c834d8bc491e5433edf4bebb66e186cd6f0e423c5cd710922cefbda04a63da"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:18:4",
      "sequence": 10895,
      "chapter_label": "1CH 18",
      "verse_label": "4",
      "locator": {
        "book": "1CH",
        "chapter": 18,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 18,
          "verse": 4
        }
      ],
      "en": "David took from him one thousand chariots, seven thousand horsemen, and twenty thousand footmen; and David hamstrung all the chariot horses, but reserved of them enough for one hundred chariots.",
      "ko": "그 병거 일천승과 기병 칠천과 보병 이만을 빼앗고 그 병거 일백승의 말만 남기고 그 외의 병거의 말은 다 발의 힘줄을 끊었더니",
      "source_text_hash": "76c69e133175d75ce3f0d69eb8671a9727edfe87252e8d0d710882b488324634",
      "translation_text_hash": "ff7709c650608d2aec89895bcad5df80f6a8c25533185ad391ba11fcf0a3c786",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 병거 일천승과 기병 칠천과 보병 이만을 빼앗고 그 병거 일백승의 말만 남기고 그 외의 병거의 말은 다 발의 힘줄을 끊었더니"
      ],
      "raw_text_hashes": [
        "ff7709c650608d2aec89895bcad5df80f6a8c25533185ad391ba11fcf0a3c786"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:18:5",
      "sequence": 10896,
      "chapter_label": "1CH 18",
      "verse_label": "5",
      "locator": {
        "book": "1CH",
        "chapter": 18,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 18,
          "verse": 5
        }
      ],
      "en": "When the Syrians of Damascus came to help Hadadezer king of Zobah, David struck twenty-two thousand men of the Syrians.",
      "ko": "다메섹 아람 사람이 소바 왕 하닷에셀을 도우러 온지라 다윗이 아람 사람 이만 이천을 죽이고",
      "source_text_hash": "cf0464ccf00052ee81efc706c877b1a01271867df8abcbc2c9fdf5f46514ae11",
      "translation_text_hash": "7fd4673d8bf0648f3ae18babb1239e7153471aed233662003a240ea51bb82cd4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다메섹 아람 사람이 소바 왕 하닷에셀을 도우러 온지라 다윗이 아람 사람 이만 이천을 죽이고"
      ],
      "raw_text_hashes": [
        "7fd4673d8bf0648f3ae18babb1239e7153471aed233662003a240ea51bb82cd4"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:18:6",
      "sequence": 10897,
      "chapter_label": "1CH 18",
      "verse_label": "6",
      "locator": {
        "book": "1CH",
        "chapter": 18,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 18,
          "verse": 6
        }
      ],
      "en": "Then David put garrisons in Syria of Damascus; and the Syrians became servants to David and brought tribute. The LORD gave victory to David wherever he went.",
      "ko": "다메섹 아람에 수비대를 두매 아람 사람이 다윗의 종이 되어 조공을 바치니라 다윗이 어디로 가든지 여호와께서 이기게 하시니라",
      "source_text_hash": "72e13076998aec76205035321c4944de6b98ba498f8b7ab30c8af89a1de9d2d4",
      "translation_text_hash": "f220df5bf96b1405cb4f1dfb15eed05b564f83f985ea142d8976ad8a199f9f2c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다메섹 아람에 수비대를 두매 아람 사람이 다윗의 종이 되어 조공을 바치니라 다윗이 어디로 가든지 여호와께서 이기게 하시니라"
      ],
      "raw_text_hashes": [
        "f220df5bf96b1405cb4f1dfb15eed05b564f83f985ea142d8976ad8a199f9f2c"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:18:7",
      "sequence": 10898,
      "chapter_label": "1CH 18",
      "verse_label": "7",
      "locator": {
        "book": "1CH",
