    {
      "canonical_locator": "bible:web:JER:15:6",
      "sequence": 19322,
      "chapter_label": "JER 15",
      "verse_label": "6",
      "locator": {
        "book": "JER",
        "chapter": 15,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 15,
          "verse": 6
        }
      ],
      "en": "You have rejected me,” says the LORD. “You have gone backward. Therefore I have stretched out my hand against you and destroyed you. I am weary of showing compassion.",
      "ko": "여호와께서 가라사대 네가 나를 버렸고 내게서 물러갔으므로 네게로 내 손을 펴서 너를 멸하였노니 이는 내가 뜻을 돌이키기에 염증이 났음이로다",
      "source_text_hash": "03cf4bca23e853dd8d17c050db7d3001ee86669349e921bad5738b277b94e8a5",
      "translation_text_hash": "1f7deaa977726395809ece184f8adec38c87bb119be617bc6eecf58e6f450544",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 가라사대 네가 나를 버렸고 내게서 물러갔으므로 네게로 내 손을 펴서 너를 멸하였노니 이는 내가 뜻을 돌이키기에 염증이 났음이로다"
      ],
      "raw_text_hashes": [
