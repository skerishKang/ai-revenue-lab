        "verse": 12
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 15,
          "verse": 12
        }
      ],
      "en": "Can one break iron, even iron from the north, and bronze?",
      "ko": "누가 능히 철 곧 북방의 철과 놋을 꺾으리요",
      "source_text_hash": "6949b16039d31c3b54e3e8044b5954e23dbfcaee587a69d715171cea37fd9faa",
      "translation_text_hash": "8fcb43fd77619b724cb695c6994e33cd77f44d863eb0e930d50d9cc2110725d7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "누가 능히 철 곧 북방의 철과 놋을 꺾으리요"
      ],
