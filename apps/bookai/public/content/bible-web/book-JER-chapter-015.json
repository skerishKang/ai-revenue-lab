        "verse": 7
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 15,
          "verse": 7
        }
      ],
      "en": "I have winnowed them with a fan in the gates of the land. I have bereaved them of children. I have destroyed my people. They didn’t return from their ways.",
      "ko": "내가 그들을 그 땅의 여러 성문에서 키로 까불러 그 자식을 끊어서 내 백성을 멸하였나니 이는 그들이 그 길에서 돌이키지 아니하였음이라",
      "source_text_hash": "9b80565789a080811059a8029a55fd93cfafdf0194d16a9f2cdf7f7233caf374",
      "translation_text_hash": "8149ca7b2e142be34042b94cd15ee3751c733061f47ed9914c7f19cd5ca9b06d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 그들을 그 땅의 여러 성문에서 키로 까불러 그 자식을 끊어서 내 백성을 멸하였나니 이는 그들이 그 길에서 돌이키지 아니하였음이라"
      ],
      "raw_text_hashes": [
