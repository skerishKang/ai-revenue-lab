      "translation_text_hash": "86a8194c0d2dc5ef01d09eb50e299ec288656949d3c382ca9074790d6f0dfa63",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 선한 싸움을 싸우고 나의 달려갈 길을 마치고 믿음을 지켰으니"
      ],
      "raw_text_hashes": [
        "86a8194c0d2dc5ef01d09eb50e299ec288656949d3c382ca9074790d6f0dfa63"
      ]
    },
    {
