      "translation_text_hash": "b987e9f1f57d1c7275a3909e8cb563ef6806ea7b6c2f937258ddf96a904649f3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
