      "translation_text_hash": "fa67944ecf24a92f5a8b8546f21c8a69efd753ac9543f449198e245d4d30666c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
