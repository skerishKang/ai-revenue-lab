      "translation_text_hash": "8adbcc0cf27c2c3e51692d4cdba043f8111410b45bc7d4c0b31ce5630e4ccc33",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
