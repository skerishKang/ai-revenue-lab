    {
      "canonical_locator": "bible:web:LEV:5:12",
      "sequence": 2843,
      "chapter_label": "LEV 5",
      "verse_label": "12",
      "locator": {
        "book": "LEV",
        "chapter": 5,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 5,
          "verse": 12
        }
      ],
      "en": "He shall bring it to the priest, and the priest shall take his handful of it as the memorial portion, and burn it on the altar, on the offerings of the LORD made by fire. It is a sin offering.",
      "ko": "그것을 제사장에게로 가져갈 것이요 제사장은 그것을 기념물로 한 움큼을 취하여 단 위 여호와의 화제물 위에 불사를찌니 이는 속죄제라",
      "source_text_hash": "56014a9ee5d48187160ab814939521538bd43709a7ac89bf742cb9f4ed937e1f",
      "translation_text_hash": "689a5904ca403f13efd5c8037e70192032f1376ef5e109c0ec27bc95d162cbef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그것을 제사장에게로 가져갈 것이요 제사장은 그것을 기념물로 한 움큼을 취하여 단 위 여호와의 화제물 위에 불사를찌니 이는 속죄제라"
      ],
      "raw_text_hashes": [
