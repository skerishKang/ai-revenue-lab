      ]
    },
    {
      "canonical_locator": "bible:web:1CH:22:11",
      "sequence": 10976,
      "chapter_label": "1CH 22",
      "verse_label": "11",
      "locator": {
        "book": "1CH",
        "chapter": 22,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 22,
          "verse": 11
        }
      ],
      "en": "Now, my son, may the LORD be with you and prosper you, and build the house of the LORD your God, as he has spoken concerning you.",
      "ko": "내 아들아 여호와께서 너와 함께 하시기를 원하며 네가 형통하여 여호와께서 네게 대하여 말씀하신대로 여호와의 전을 건축하며",
      "source_text_hash": "2d40e5ba870f9d18aa24581bbd211149b655926451c472b6265acf024e9e2c52",
      "translation_text_hash": "8449f1004e955dde7b25e7ffebdc42bc789987d169ef39edd1df0b5b7e1882a6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 아들아 여호와께서 너와 함께 하시기를 원하며 네가 형통하여 여호와께서 네게 대하여 말씀하신대로 여호와의 전을 건축하며"
      ],
      "raw_text_hashes": [
        "8449f1004e955dde7b25e7ffebdc42bc789987d169ef39edd1df0b5b7e1882a6"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:22:12",
      "sequence": 10977,
      "chapter_label": "1CH 22",
      "verse_label": "12",
      "locator": {
        "book": "1CH",
        "chapter": 22,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 22,
          "verse": 12
        }
      ],
      "en": "May the LORD give you discretion and understanding, and put you in charge of Israel, so that you may keep the law of the LORD your God.",
      "ko": "여호와께서 네게 지혜와 총명을 주사 너로 이스라엘을 다스리게 하시고 너의 하나님 여호와의 율법을 지키게 하시기를 더욱 원하노라",
      "source_text_hash": "403a77b04d8af3a8f4e6777f3f6e745711d2e2de96b5aeab1b37eaa5ef3af2a9",
      "translation_text_hash": "eaa1218e34796c7beccf830a430673a62f5bafd5c2315c1aa3c62e21338138b1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 네게 지혜와 총명을 주사 너로 이스라엘을 다스리게 하시고 너의 하나님 여호와의 율법을 지키게 하시기를 더욱 원하노라"
      ],
      "raw_text_hashes": [
        "eaa1218e34796c7beccf830a430673a62f5bafd5c2315c1aa3c62e21338138b1"
      ]
    },
    {
      "canonical_locator": "bible:web:1CH:22:13",
      "sequence": 10978,
      "chapter_label": "1CH 22",
      "verse_label": "13",
      "locator": {
        "book": "1CH",
        "chapter": 22,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 22,
          "verse": 13
        }
      ],
      "en": "Then you will prosper, if you observe to do the statutes and the ordinances which the LORD gave Moses concerning Israel. Be strong and courageous. Don’t be afraid and don’t be dismayed.",
      "ko": "네가 만일 여호와께서 모세로 이스라엘에게 명하신 모든 율례와 규례를 삼가 행하면 형통하리니 강하고 담대하여 두려워 말고 놀라지 말찌어다",
      "source_text_hash": "038a4c97c84a7ceb7c58d90a9f8103ad5ac88a50d28945eb2604ce39595f30d8",
      "translation_text_hash": "0a09ca258c5e11bb95351c56ad382543f02db7f8c6b0197d7d8a6869eda32539",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 만일 여호와께서 모세로 이스라엘에게 명하신 모든 율례와 규례를 삼가 행하면 형통하리니 강하고 담대하여 두려워 말고 놀라지 말찌어다"
