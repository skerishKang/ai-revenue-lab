    {
      "canonical_locator": "bible:web:1CH:22:9",
      "sequence": 10974,
      "chapter_label": "1CH 22",
      "verse_label": "9",
      "locator": {
        "book": "1CH",
        "chapter": 22,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 22,
          "verse": 9
        }
      ],
      "en": "Behold, a son shall be born to you, who shall be a man of peace. I will give him rest from all his enemies all around; for his name shall be Solomon, and I will give peace and quietness to Israel in his days.",
      "ko": "한 아들이 네게서 나리니 저는 평강의 사람이라 내가 저로 사면 모든 대적에게서 평강하게 하리라 그 이름을 솔로몬이라 하리니 이는 내가 저의 생전에 평안과 안정을 이스라엘에게 줄 것임이니라",
      "source_text_hash": "677fd236da373ab54a030aab2c3110123e7085944e932b7078389fec7c44f3ea",
      "translation_text_hash": "ded0b89d3a2989723a81a8b87556db54714a524f196a986e08fc9ee761902450",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한 아들이 네게서 나리니 저는 평강의 사람이라 내가 저로 사면 모든 대적에게서 평강하게 하리라 그 이름을 솔로몬이라 하리니 이는 내가 저의 생전에 평안과 안정을 이스라엘에게 줄 것임이니라"
      ],
      "raw_text_hashes": [
        "ded0b89d3a2989723a81a8b87556db54714a524f196a986e08fc9ee761902450"
      ]
