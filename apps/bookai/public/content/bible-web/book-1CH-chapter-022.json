    {
      "canonical_locator": "bible:web:1CH:22:10",
      "sequence": 10975,
      "chapter_label": "1CH 22",
      "verse_label": "10",
      "locator": {
        "book": "1CH",
        "chapter": 22,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 22,
          "verse": 10
        }
      ],
      "en": "He shall build a house for my name; and he will be my son, and I will be his father; and I will establish the throne of his kingdom over Israel forever.’",
      "ko": "저가 내 이름을 위하여 전을 건축할찌라 저는 내 아들이 되고 나는 저의 아비가 되어 그 나라 위를 이스라엘 위에 굳게 세워 영원까지 이르게 하리라 하셨나니",
      "source_text_hash": "002d4cd2408b906a947c7c21377901c20c7edff52f3e752e1208786297d8e5d1",
      "translation_text_hash": "293cd08a6da0bfa6557d419e57292ec0422071ea0bf6d6eb4cc083f25d02826b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 내 이름을 위하여 전을 건축할찌라 저는 내 아들이 되고 나는 저의 아비가 되어 그 나라 위를 이스라엘 위에 굳게 세워 영원까지 이르게 하리라 하셨나니"
      ],
      "raw_text_hashes": [
