      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 7,
          "verse": 17
        }
      ],
      "en": "but what remains of the meat of the sacrifice on the third day shall be burned with fire.",
      "ko": "그 희생의 고기가 제 삼일까지 남았으면 불사를찌니",
      "source_text_hash": "2c0486d88c2473fb5c1420dc304cd378493faecee2838198eb42c8db7999d848",
      "translation_text_hash": "159dc0b097f2a03e9e4b3ac1dbe325051304121ca315de7ce1442ccd0c199138",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 희생의 고기가 제 삼일까지 남았으면 불사를찌니"
      ],
      "raw_text_hashes": [
        "159dc0b097f2a03e9e4b3ac1dbe325051304121ca315de7ce1442ccd0c199138"
      ]
