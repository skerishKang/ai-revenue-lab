      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 소제물은 기름 섞은 것이나 마른 것이나 아론의 모든 자손이 평균히 분배할 것이니라"
      ],
      "raw_text_hashes": [
        "a40819fb0d423a1e4ca6a8a48275157b77363eb9bc9df8b798186c3e696ca391"
      ]
    },
