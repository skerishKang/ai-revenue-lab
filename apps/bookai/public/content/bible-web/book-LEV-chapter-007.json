      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 고기가 부정한 물건에 접촉되었으면 먹지 말고 불사를 것이라 그 고기는 깨끗한 자만 먹을 것이니"
      ],
      "raw_text_hashes": [
        "2d9b09f8c9e7b4b67ae29d5f255bbbfb6dea8c412ad80ef51e21c85695a8ce43"
