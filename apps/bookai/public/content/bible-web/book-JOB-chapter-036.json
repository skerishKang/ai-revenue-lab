        "verse": 12
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 12
        }
      ],
      "en": "But if they don’t listen, they will perish by the sword; they will die without knowledge.",
      "ko": "만일 그들이 청종치 아니하면 칼에 망하며 지식 없이 죽을 것이니라",
      "source_text_hash": "027a63034eb76dd54f03d2ce78e6523eca9a2f89c1f552bb2958a7d29816cff0",
      "translation_text_hash": "d5d13d9c3943fa2ad5af7d3d3cd9690ee3d72f102d81e8508e15208f4c119db7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 그들이 청종치 아니하면 칼에 망하며 지식 없이 죽을 것이니라"
      ],
      "raw_text_hashes": [
        "d5d13d9c3943fa2ad5af7d3d3cd9690ee3d72f102d81e8508e15208f4c119db7"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:36:13",
      "sequence": 13750,
      "chapter_label": "JOB 36",
      "verse_label": "13",
      "locator": {
        "book": "JOB",
