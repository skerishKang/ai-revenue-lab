        "verse": 8
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 8
        }
      ],
      "en": "If they are bound in fetters, and are taken in the cords of afflictions,",
      "ko": "혹시 그들이 누설에 매이거나 환난의 줄에 얽혔으면",
      "source_text_hash": "27cbe24a2258be93764359105764348d8cd9e498c711cc5e67afc6e22256167a",
      "translation_text_hash": "7fcc992e540aa82d17a920acfcf1280fd673979eb0bc74296605da08386ec4bf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "혹시 그들이 누설에 매이거나 환난의 줄에 얽혔으면"
      ],
      "raw_text_hashes": [
        "7fcc992e540aa82d17a920acfcf1280fd673979eb0bc74296605da08386ec4bf"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:36:9",
      "sequence": 13746,
      "chapter_label": "JOB 36",
      "verse_label": "9",
      "locator": {
        "book": "JOB",
