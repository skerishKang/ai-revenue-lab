      ],
      "raw_text_hashes": [
        "dad1e1889502af3086b5972bd973bcc4e44e26696bf473710255c9a1ee3e1e5b"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:36:15",
      "sequence": 13752,
      "chapter_label": "JOB 36",
      "verse_label": "15",
      "locator": {
        "book": "JOB",
