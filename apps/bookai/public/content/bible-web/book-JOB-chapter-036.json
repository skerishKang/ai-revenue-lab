        "verse": 9
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 9
        }
      ],
      "en": "then he shows them their work, and their transgressions, that they have behaved themselves proudly.",
      "ko": "그들의 소행과 허물을 보이사 그 교만한 행위를 알게 하시고",
      "source_text_hash": "6d2a7c9d6a2c6ad29e4f738073e6373a5beda2a388808cf22aad166490374018",
      "translation_text_hash": "f942e364a05e855ec74f58859a94d09080bf811b18fe66c407745f2379416e51",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들의 소행과 허물을 보이사 그 교만한 행위를 알게 하시고"
      ],
      "raw_text_hashes": [
        "f942e364a05e855ec74f58859a94d09080bf811b18fe66c407745f2379416e51"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:36:10",
      "sequence": 13747,
      "chapter_label": "JOB 36",
      "verse_label": "10",
      "locator": {
        "book": "JOB",
        "chapter": 36,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 10
        }
      ],
