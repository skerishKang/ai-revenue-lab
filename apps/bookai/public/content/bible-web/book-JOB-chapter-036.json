        "verse": 6
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 6
        }
      ],
      "en": "He doesn’t preserve the life of the wicked, but gives justice to the afflicted.",
      "ko": "악인을 살려 두지 않으시며 고난 받는 자를 위하여 신원하시며",
      "source_text_hash": "fac0df629a889cd8a2d035ae61b19e4cda69c0ce3ba9159c830e2e272761ba8b",
      "translation_text_hash": "fde6981b3a290d81a915a1c03a52633cc0ab9e4dbfee3f60b0b6764d007f9b9d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악인을 살려 두지 않으시며 고난 받는 자를 위하여 신원하시며"
      ],
      "raw_text_hashes": [
        "fde6981b3a290d81a915a1c03a52633cc0ab9e4dbfee3f60b0b6764d007f9b9d"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:36:7",
      "sequence": 13744,
      "chapter_label": "JOB 36",
      "verse_label": "7",
      "locator": {
        "book": "JOB",
        "chapter": 36,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 7
        }
      ],
      "en": "He doesn’t withdraw his eyes from the righteous, but with kings on the throne, he sets them forever, and they are exalted.",
      "ko": "그 눈을 의인에게서 돌이키지 아니하시고 그를 왕과 함께 영원히 위에 앉히사 존귀하게 하시며",
      "source_text_hash": "dbe9a1499a5de68b03e94d5b980eaa3ab380295bf791a2572dc4fc666b202242",
      "translation_text_hash": "5ebd06977492a31afe5ebd2a166224c50d1fa82efe8869a500409dd98385d3d8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 눈을 의인에게서 돌이키지 아니하시고 그를 왕과 함께 영원히 위에 앉히사 존귀하게 하시며"
      ],
      "raw_text_hashes": [
        "5ebd06977492a31afe5ebd2a166224c50d1fa82efe8869a500409dd98385d3d8"
      ]
    },
    {
