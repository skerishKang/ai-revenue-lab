        "verse": 4
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 4
        }
      ],
      "en": "For truly my words are not false. One who is perfect in knowledge is with you.",
      "ko": "진실로 내 말이 거짓이 아니라 지식이 구비한 자가 너와 함께 있느니라",
      "source_text_hash": "6ff6a175d85a45e0a27d629230fae51cbb483f68fdc3e5348b2ee4ef67f94055",
      "translation_text_hash": "41431dfe7250924ae4d044e3e532380299fb07274576f9aa81a1ce9809d10951",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "진실로 내 말이 거짓이 아니라 지식이 구비한 자가 너와 함께 있느니라"
      ],
      "raw_text_hashes": [
        "41431dfe7250924ae4d044e3e532380299fb07274576f9aa81a1ce9809d10951"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:36:5",
      "sequence": 13742,
      "chapter_label": "JOB 36",
