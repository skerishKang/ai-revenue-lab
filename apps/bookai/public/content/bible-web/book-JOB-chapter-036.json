      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 36,
          "verse": 5
        }
      ],
      "en": "“Behold, God is mighty, and doesn’t despise anyone. He is mighty in strength of understanding.",
      "ko": "하나님은 전능하시나 아무도 멸시치 아니하시며 그 지능이 무궁하사",
      "source_text_hash": "496c94a7ecdc98dfbb442b7d98135a7e82a649f37d33e4a12cdecfd499661737",
      "translation_text_hash": "ed955e2a7735a5b3c242d64cb055173fbda203b877751bba32d6688091f71246",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님은 전능하시나 아무도 멸시치 아니하시며 그 지능이 무궁하사"
      ],
      "raw_text_hashes": [
        "ed955e2a7735a5b3c242d64cb055173fbda203b877751bba32d6688091f71246"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:36:6",
      "sequence": 13743,
      "chapter_label": "JOB 36",
      "verse_label": "6",
      "locator": {
        "book": "JOB",
