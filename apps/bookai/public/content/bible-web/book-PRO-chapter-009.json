      "translation_text_hash": "41522d8f0031cb4aea0fd6186c67ff8483da0da330a77a750144ac9192aaa751",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 여종을 보내어 성중 높은 곳에서 불러 이르기를"
      ],
      "raw_text_hashes": [
        "41522d8f0031cb4aea0fd6186c67ff8483da0da330a77a750144ac9192aaa751"
