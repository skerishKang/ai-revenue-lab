      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 9,
          "verse": 11
        }
      ],
      "en": "For by me your days will be multiplied. The years of your life will be increased.",
      "ko": "나 지혜로 말미암아 네 날이 많아질 것이요 네 생명의 해가 더하리라",
      "source_text_hash": "9d84137c032f8ff63f1b3ba39b5502ca86180ea28f523ce8d9c82dea65b30c73",
      "translation_text_hash": "7ad52b6191e4fca1b5ee8444f183b1187c3eb013cc15f747f945619a92ae18fc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나 지혜로 말미암아 네 날이 많아질 것이요 네 생명의 해가 더하리라"
      ],
      "raw_text_hashes": [
        "7ad52b6191e4fca1b5ee8444f183b1187c3eb013cc15f747f945619a92ae18fc"
      ]
    },
    {
