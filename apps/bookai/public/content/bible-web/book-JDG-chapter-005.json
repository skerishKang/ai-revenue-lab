      ],
      "en": "Then Deborah and Barak the son of Abinoam sang on that day, saying,",
      "ko": "이 날에 드보라와 아비노암의 아들 바락이 노래하여 가로되",
      "source_text_hash": "de7036e230070de295eb156d6712594e234090faf1320e66b27c53f5e3885818",
      "translation_text_hash": "850a783136e744385abd2c1e2f9ff644f64df2eb35af86f0d0341c98aa0be29f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 날에 드보라와 아비노암의 아들 바락이 노래하여 가로되"
      ],
      "raw_text_hashes": [
        "850a783136e744385abd2c1e2f9ff644f64df2eb35af86f0d0341c98aa0be29f"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:5:2",
      "sequence": 6626,
      "chapter_label": "JDG 5",
      "verse_label": "2",
