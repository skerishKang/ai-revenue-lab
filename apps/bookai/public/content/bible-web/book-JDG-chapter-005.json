        "verse": 9
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 5,
          "verse": 9
        }
      ],
      "en": "My heart is toward the governors of Israel, who offered themselves willingly among the people. Bless the LORD!",
      "ko": "내 마음이 이스라엘의 방백을 사모함은 그들이 백성 중에서 즐거이 헌신하였음이라 여호와를 찬송하라",
      "source_text_hash": "a04a3e6bc11ad957964e164b36f1397e5564ec68822f6351b2cb2a340c8631b0",
      "translation_text_hash": "9ed8655ad915f04d2516a87332f87964f8c82459fd65db2ba46a9dd9315131ce",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 마음이 이스라엘의 방백을 사모함은 그들이 백성 중에서 즐거이 헌신하였음이라 여호와를 찬송하라"
      ],
      "raw_text_hashes": [
        "9ed8655ad915f04d2516a87332f87964f8c82459fd65db2ba46a9dd9315131ce"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:5:10",
      "sequence": 6634,
