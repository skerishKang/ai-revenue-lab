      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 내 입 앞에 파숫군을 세우시고 내 입술의 문을 지키소서"
      ],
      "raw_text_hashes": [
        "fdd00279c8c231d53eabe4feecd31ee61eb528352cfc6c431d0b74ac179e4466"
      ]
    },
