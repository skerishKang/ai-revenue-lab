      "source_text_hash": "9790b70c11dd84b87a271444782d0e8cff49d6ab59db9f0275a645af8597b646",
      "translation_text_hash": "2c072412718ec126b4440a744027b34f86935882e35d77fca62208041584d38d",
      "translation_policy": "krv-1961-source-mapped",
