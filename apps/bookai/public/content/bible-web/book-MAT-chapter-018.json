        "verse": 4
      },
      "raw_locator": [
        {
          "book": "MAT",
          "chapter": 18,
          "verse": 4
        }
      ],
      "en": "Whoever therefore humbles himself as this little child is the greatest in the Kingdom of Heaven.",
      "ko": "그러므로 누구든지 이 어린 아이와 같이 자기를 낮추는 그이가 천국에서 큰 자니라",
      "source_text_hash": "7d7c8dc5f3fddb737857d1ed26c606dd8daa0ba5dabddda7bf772677e5cf25bd",
      "translation_text_hash": "85aa28cfec12a355f997ff83cea5b2ed93c0a70c9ff4cbbe8d8b79bb04c52e95",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 누구든지 이 어린 아이와 같이 자기를 낮추는 그이가 천국에서 큰 자니라"
      ],
      "raw_text_hashes": [
        "85aa28cfec12a355f997ff83cea5b2ed93c0a70c9ff4cbbe8d8b79bb04c52e95"
      ]
    },
    {
      "canonical_locator": "bible:web:MAT:18:5",
      "sequence": 23733,
      "chapter_label": "MAT 18",
      "verse_label": "5",
      "locator": {
