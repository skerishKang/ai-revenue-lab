        "verse": 5
      },
      "raw_locator": [
        {
          "book": "MAT",
          "chapter": 18,
          "verse": 5
        }
      ],
      "en": "Whoever receives one such little child in my name receives me,",
      "ko": "또 누구든지 내 이름으로 이런 어린 아이 하나를 영접하면 곧 나를 영접함이니",
      "source_text_hash": "12fa1f867d7ab8284f1a636d671ada4127a01b87641d6d32e11a3102af93f502",
      "translation_text_hash": "67cff7540499727c00f614e54f4e7a80d483cd169b34b1992095abf8d157f930",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 누구든지 내 이름으로 이런 어린 아이 하나를 영접하면 곧 나를 영접함이니"
      ],
      "raw_text_hashes": [
        "67cff7540499727c00f614e54f4e7a80d483cd169b34b1992095abf8d157f930"
      ]
    },
    {
      "canonical_locator": "bible:web:MAT:18:6",
      "sequence": 23734,
      "chapter_label": "MAT 18",
      "verse_label": "6",
      "locator": {
