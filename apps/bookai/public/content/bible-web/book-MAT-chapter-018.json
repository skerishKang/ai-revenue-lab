        {
          "book": "MAT",
          "chapter": 18,
          "verse": 2
        }
      ],
      "en": "Jesus called a little child to himself, and set him in the middle of them",
      "ko": "예수께서 한 어린 아이를 불러 저희 가운데 세우시고",
      "source_text_hash": "ac832a495bc3ed400275eb9ab4a7ad550af2f0b5e750c82382cf6bd983bcfdf6",
      "translation_text_hash": "8f50e8edaae1e601a47b734f776ed36fc085d80d6a9ba6c5b4f59fd6d595a8bf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "예수께서 한 어린 아이를 불러 저희 가운데 세우시고"
      ],
      "raw_text_hashes": [
        "8f50e8edaae1e601a47b734f776ed36fc085d80d6a9ba6c5b4f59fd6d595a8bf"
      ]
    },
    {
      "canonical_locator": "bible:web:MAT:18:3",
      "sequence": 23731,
      "chapter_label": "MAT 18",
