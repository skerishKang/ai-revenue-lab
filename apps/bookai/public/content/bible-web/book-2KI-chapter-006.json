      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "선지자의 생도가 엘리사에게 이르되 보소서 우리가 당신과 함께 거한 곳이 우리에게는 좁으니"
      ],
      "raw_text_hashes": [
