    {
      "canonical_locator": "bible:web:JDG:3:9",
      "sequence": 6578,
      "chapter_label": "JDG 3",
      "verse_label": "9",
      "locator": {
        "book": "JDG",
        "chapter": 3,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 3,
          "verse": 9
        }
      ],
      "en": "When the children of Israel cried to the LORD, the LORD raised up a savior to the children of Israel, who saved them, even Othniel the son of Kenaz, Caleb’s younger brother.",
      "ko": "이스라엘 자손이 여호와께 부르짖으매 여호와께서 그들을 위하여 한 구원자를 세워 구원하게 하시니 그는 곧 갈렙의 아우 그나스의 아들 옷니엘이라",
      "source_text_hash": "b3e28430ee9866605850f331e1bcd7b2ed475b2c87be142f0f921f9b9c6f1f62",
      "translation_text_hash": "f1b0ff9866bd6f34f3b7003787c377eae3f49832e6fe97ee5fc85f1b0963f758",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손이 여호와께 부르짖으매 여호와께서 그들을 위하여 한 구원자를 세워 구원하게 하시니 그는 곧 갈렙의 아우 그나스의 아들 옷니엘이라"
      ],
      "raw_text_hashes": [
        "f1b0ff9866bd6f34f3b7003787c377eae3f49832e6fe97ee5fc85f1b0963f758"
      ]
