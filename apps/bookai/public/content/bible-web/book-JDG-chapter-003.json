    {
      "canonical_locator": "bible:web:JDG:3:10",
      "sequence": 6579,
      "chapter_label": "JDG 3",
      "verse_label": "10",
      "locator": {
        "book": "JDG",
        "chapter": 3,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 3,
          "verse": 10
        }
      ],
      "en": "The LORD’s Spirit came on him, and he judged Israel; and he went out to war, and the LORD delivered Cushan Rishathaim king of Mesopotamia into his hand. His hand prevailed against Cushan Rishathaim.",
      "ko": "여호와의 신이 그에게 임하셨으므로 그가 이스라엘 사사가 되어 나가서 싸울 때에 여호와께서 메소보다미아 왕 구산 리사다임을 그 손에 붙이시매 옷니엘의 손이 구산 리사다임을 이기니라",
      "source_text_hash": "a060ab49e2c7511167ed5b623ed057a31ebe80bc1587406e37e62de93e407a94",
      "translation_text_hash": "f4ff505397d2a69c3795159ee67546666cd11fe5f1d5a4cfabb92000c7878fc5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 신이 그에게 임하셨으므로 그가 이스라엘 사사가 되어 나가서 싸울 때에 여호와께서 메소보다미아 왕 구산 리사다임을 그 손에 붙이시매 옷니엘의 손이 구산 리사다임을 이기니라"
      ],
