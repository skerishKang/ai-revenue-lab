    {
      "canonical_locator": "bible:web:JDG:3:6",
      "sequence": 6575,
      "chapter_label": "JDG 3",
      "verse_label": "6",
      "locator": {
        "book": "JDG",
        "chapter": 3,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 3,
          "verse": 6
        }
      ],
      "en": "They took their daughters to be their wives, and gave their own daughters to their sons and served their gods.",
      "ko": "그들의 딸들을 취하여 아내를 삼으며 자기 딸들을 그들의 아들에게 주며 또 그들의 신들을 섬겼더라",
      "source_text_hash": "3536e0b74228837eb275a970af6fde10cfc3e551d2acc5342a635b1c16e92bbe",
      "translation_text_hash": "3d086093ccf8538bf14e805c69b0a8fdfc2c645c3acc501587ffd5aec58cf95d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들의 딸들을 취하여 아내를 삼으며 자기 딸들을 그들의 아들에게 주며 또 그들의 신들을 섬겼더라"
      ],
      "raw_text_hashes": [
        "3d086093ccf8538bf14e805c69b0a8fdfc2c645c3acc501587ffd5aec58cf95d"
