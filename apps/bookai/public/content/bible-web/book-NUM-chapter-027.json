        "verse": 9
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 27,
          "verse": 9
        }
      ],
      "en": "If he has no daughter, then you shall give his inheritance to his brothers.",
      "ko": "딸도 없거든 그 기업을 그 형제에게 줄 것이요",
      "source_text_hash": "f542397e08d46aabdf9b983d9a605e29bd0ec7884a524e58e6649a2ae8c69ad2",
      "translation_text_hash": "7f71656e1a28cab423e0ff385a7b31293af8b498fbe137869d3ede78190a238c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "딸도 없거든 그 기업을 그 형제에게 줄 것이요"
      ],
      "raw_text_hashes": [
        "7f71656e1a28cab423e0ff385a7b31293af8b498fbe137869d3ede78190a238c"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:27:10",
      "sequence": 4565,
      "chapter_label": "NUM 27",
      "verse_label": "10",
      "locator": {
        "book": "NUM",
        "chapter": 27,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 27,
          "verse": 10
        }
      ],
      "en": "If he has no brothers, then you shall give his inheritance to his father’s brothers.",
      "ko": "형제도 없거든 그 기업을 그 아비의 형제에게 줄 것이요",
      "source_text_hash": "49c3ae4531e505aa703ec8df944d54c8a54df9b37c38c541fe0a159ea16b9be1",
      "translation_text_hash": "1526e427062b8cda3f39eaf250de70416f8ca98b2c086a338887f581be83a5cb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "형제도 없거든 그 기업을 그 아비의 형제에게 줄 것이요"
      ],
      "raw_text_hashes": [
        "1526e427062b8cda3f39eaf250de70416f8ca98b2c086a338887f581be83a5cb"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:27:11",
      "sequence": 4566,
      "chapter_label": "NUM 27",
      "verse_label": "11",
      "locator": {
        "book": "NUM",
        "chapter": 27,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 27,
          "verse": 11
        }
      ],
      "en": "If his father has no brothers, then you shall give his inheritance to his kinsman who is next to him of his family, and he shall possess it. This shall be a statute and ordinance for the children of Israel, as the LORD commanded Moses.’”",
      "ko": "그 아비의 형제도 없거든 그 기업을 가장 가까운 친족에게 주어 얻게 할찌니라 하고 나 여호와가 너 모세에게 명한대로 이스라엘 자손에게 판결의 율례가 되게 할찌니라",
      "source_text_hash": "8fc949b012c61eaa5c678583d03f35f7db6e73908820159017ea673e238a3f1d",
      "translation_text_hash": "34566cd059637500014fff2dce3afcd77e7ceb90806cc02a4f8aaeb16640e702",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 아비의 형제도 없거든 그 기업을 가장 가까운 친족에게 주어 얻게 할찌니라 하고 나 여호와가 너 모세에게 명한대로 이스라엘 자손에게 판결의 율례가 되게 할찌니라"
      ],
