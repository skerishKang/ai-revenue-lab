      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 27,
          "verse": 3
        }
      ],
      "en": "“Our father died in the wilderness. He was not among the company of those who gathered themselves together against the LORD in the company of Korah, but he died in his own sin. He had no sons.",
      "ko": "우리 아버지가 광야에서 죽었으나 여호와를 거스려 모인 고라의 무리에 들지 아니하고 자기 죄에 죽었고 아들이 없나이다",
      "source_text_hash": "2abc9a2b9e8dc9e04a45633f15eff4b498f84ae6e8790193771ea3e0d2acbefc",
      "translation_text_hash": "4ffa9288d550f63cfe0bf71f5bbc08bcd46320dcdb5794733448694e9ebb9bfd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 아버지가 광야에서 죽었으나 여호와를 거스려 모인 고라의 무리에 들지 아니하고 자기 죄에 죽었고 아들이 없나이다"
      ],
      "raw_text_hashes": [
        "4ffa9288d550f63cfe0bf71f5bbc08bcd46320dcdb5794733448694e9ebb9bfd"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:27:4",
      "sequence": 4559,
      "chapter_label": "NUM 27",
      "verse_label": "4",
      "locator": {
