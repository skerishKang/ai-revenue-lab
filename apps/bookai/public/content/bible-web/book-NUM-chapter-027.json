      "en": "Moses brought their cause before the LORD.",
      "ko": "모세가 그 사연을 여호와께 품하니라",
      "source_text_hash": "8fb02ef8144ccd933411c4f30dd6def252710f98e78a5df4fedbfe6519320b6a",
      "translation_text_hash": "f9c46d0afe37813e1b62e096bafb5dc24526c319062510ae0a972f99912f5b05",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세가 그 사연을 여호와께 품하니라"
      ],
      "raw_text_hashes": [
        "f9c46d0afe37813e1b62e096bafb5dc24526c319062510ae0a972f99912f5b05"
      ]
    },
    {
