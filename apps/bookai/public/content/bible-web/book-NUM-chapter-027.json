      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 27,
          "verse": 13
        }
      ],
      "en": "When you have seen it, you also shall be gathered to your people, as Aaron your brother was gathered;",
      "ko": "본 후에는 네 형 아론의 돌아간것 같이 너도 조상에게로 돌아가리니",
      "source_text_hash": "0445026c39091f9ee0bf975395ca466c0a5fbf58ef969573a136762acddafbfd",
      "translation_text_hash": "ba60d722f32207e8ffa0e9678266b146ba1c233d715dbe821ef57daa61f2d9fc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "본 후에는 네 형 아론의 돌아간것 같이 너도 조상에게로 돌아가리니"
      ],
      "raw_text_hashes": [
        "ba60d722f32207e8ffa0e9678266b146ba1c233d715dbe821ef57daa61f2d9fc"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:27:14",
      "sequence": 4569,
      "chapter_label": "NUM 27",
      "verse_label": "14",
      "locator": {
        "book": "NUM",
        "chapter": 27,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 27,
          "verse": 14
        }
      ],
      "en": "because in the strife of the congregation, you rebelled against my word in the wilderness of Zin, to honor me as holy at the waters before their eyes.” (These are the waters of Meribah of Kadesh in the wilderness of Zin.)",
      "ko": "이는 신 광야에서 회중이 분쟁할제 너희가 내 명을 거역하고 그 물 가에서 나의 거룩함을 그들의 목전에 나타내지 아니하였음이니라 이 물은 신 광야 가데스의 므리바 물이니라",
      "source_text_hash": "3df1ed81f901cdbe384665f54a018ede5566113511350555c44fb7b877f91e45",
