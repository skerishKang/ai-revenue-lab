      "translation_text_hash": "a851058ace8a6a3514166c7cda65a0018cf494fb47b76fb3c8795b2ce076d442",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하늘이 그 공의를 선포하리니 하나님 그는 심판장이심이로다(셀라)"
      ],
      "raw_text_hashes": [
        "a851058ace8a6a3514166c7cda65a0018cf494fb47b76fb3c8795b2ce076d442"
      ]
    },
    {
