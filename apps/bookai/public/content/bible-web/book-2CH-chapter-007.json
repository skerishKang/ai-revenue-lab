      "raw_texts": [
        "이 전이 비록 높을찌라도 무릇 그리로 지나가는 자가 놀라 가로되 여호와께서 무슨 까닭으로 이 땅과 이 전에 이같이 행하셨는고 하면"
      ],
      "raw_text_hashes": [
