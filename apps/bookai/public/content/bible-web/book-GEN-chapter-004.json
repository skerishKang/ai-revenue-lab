      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가인이 그 아우 아벨에게 고하니라 그 후 그들이 들에 있을 때에 가인이 그 아우 아벨을 쳐 죽이니라"
      ],
      "raw_text_hashes": [
        "d79e75fb1533c614326ae80a65cd3d2fd387ecdb8c42756302a5d72a486a2d85"
      ]
