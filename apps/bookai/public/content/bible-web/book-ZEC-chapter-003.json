      "en": "The LORD’s angel solemnly assured Joshua, saying,",
      "ko": "여호와의 사자가 여호수아에게 증거하여 가로되",
      "source_text_hash": "980f9de495d49242f162c8d0b46587b2a5ec8d8ec36b8203aa58c8141de7cb28",
      "translation_text_hash": "cb2c4c7f09f83fb6f1a3a64a1f095364a99caadf8077d92c143e277317377ead",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 사자가 여호수아에게 증거하여 가로되"
      ],
      "raw_text_hashes": [
        "cb2c4c7f09f83fb6f1a3a64a1f095364a99caadf8077d92c143e277317377ead"
      ]
    },
