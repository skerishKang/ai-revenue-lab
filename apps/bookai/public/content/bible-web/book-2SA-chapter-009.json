    {
      "canonical_locator": "bible:web:2SA:9:11",
      "sequence": 8239,
      "chapter_label": "2SA 9",
      "verse_label": "11",
      "locator": {
        "book": "2SA",
        "chapter": 9,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 9,
          "verse": 11
        }
      ],
      "en": "Then Ziba said to the king, “According to all that my lord the king commands his servant, so your servant will do.” So Mephibosheth ate at the king’s table like one of the king’s sons.",
      "ko": "시바가 왕께 고하되 내 주 왕께서 온갖 일을 종에게 명하신대로 종이 준행하겠나이다 하니라 므비보셋은 왕자 중 하나처럼 왕의 상에서 먹으니라",
      "source_text_hash": "07b805583fa8b3ea3ce04edca50be69eb51f27b3a816b4f8a7ef8222a3a5146d",
      "translation_text_hash": "0e82dc6501ed8c6049e337159c8c36c86af474bb9d226d86b3c4d6869f7067fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시바가 왕께 고하되 내 주 왕께서 온갖 일을 종에게 명하신대로 종이 준행하겠나이다 하니라 므비보셋은 왕자 중 하나처럼 왕의 상에서 먹으니라"
      ],
      "raw_text_hashes": [
