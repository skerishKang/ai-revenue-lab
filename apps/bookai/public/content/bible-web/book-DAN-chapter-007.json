        {
          "book": "DAN",
          "chapter": 7,
          "verse": 3
        }
      ],
      "en": "Four great animals came up from the sea, different from one another.",
      "ko": "큰 짐승 넷이 바다에서 나왔는데 그 모양이 각각 다르니",
      "source_text_hash": "878fa3cb3a03a6b55a38ae961f8690d56601528bf6d067c859fcdf8c5209e221",
      "translation_text_hash": "c8fc7f94af93e4fdbbd15cdfaf57682b582d33fcb50b08017f20ff273768666b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "큰 짐승 넷이 바다에서 나왔는데 그 모양이 각각 다르니"
      ],
      "raw_text_hashes": [
        "c8fc7f94af93e4fdbbd15cdfaf57682b582d33fcb50b08017f20ff273768666b"
      ]
