      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "두 사람이 기도하러 성전에 올라가니 하나는 바리새인이요 하나는 세리라"
      ],
      "raw_text_hashes": [
        "10404ae290fd86229403961439f8d5481d0a56c9cd6d83aa30a44fc14d6e275a"
