      "translation_text_hash": "473302a40318b5246194e77ba2341933034ba8a6d3b52fbf62927a909539ba94",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
