      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 16,
          "verse": 4
        }
      ],
      "en": "If it is appropriate for me to go also, they will go with me.",
      "ko": "만일 나도 가는 것이 합당하면 저희가 나와 함께 가리라",
      "source_text_hash": "278c84ae93bfa341c3951cd1713ec0cb86d74f8a42c7b4082857229c4413d065",
      "translation_text_hash": "6a7e7cba50de95494d6ffbeface5494ad8f3cc0c8511c31d9df04a10c71a6c7c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 나도 가는 것이 합당하면 저희가 나와 함께 가리라"
      ],
      "raw_text_hashes": [
        "6a7e7cba50de95494d6ffbeface5494ad8f3cc0c8511c31d9df04a10c71a6c7c"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:16:5",
      "sequence": 28778,
      "chapter_label": "1CO 16",
      "verse_label": "5",
      "locator": {
