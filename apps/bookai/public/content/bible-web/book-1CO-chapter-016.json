        "verse": 2
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 16,
          "verse": 2
        }
      ],
      "en": "On the first day of every week, let each one of you save as he may prosper, that no collections are made when I come.",
      "ko": "매주일 첫날에 너희 각 사람이 이를 얻은대로 저축하여 두어서 내가 갈 때에 연보를 하지 않게 하라",
      "source_text_hash": "9ec24aac6438097089fe6169c320454cbc5c2c34146dbd5df7f7de221a51b58c",
      "translation_text_hash": "a9f93592fcfc30bd3b76fd4932a97cc5b1209f2a6d5b1cc043894806ebc5344c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "매주일 첫날에 너희 각 사람이 이를 얻은대로 저축하여 두어서 내가 갈 때에 연보를 하지 않게 하라"
      ],
      "raw_text_hashes": [
        "a9f93592fcfc30bd3b76fd4932a97cc5b1209f2a6d5b1cc043894806ebc5344c"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:16:3",
      "sequence": 28776,
      "chapter_label": "1CO 16",
      "verse_label": "3",
      "locator": {
