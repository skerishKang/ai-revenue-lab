        "verse": 14
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 16,
          "verse": 14
        }
      ],
      "en": "Let all that you do be done in love.",
      "ko": "너희 모든 일을 사랑으로 행하라",
      "source_text_hash": "fa90c11fe5414cb8be267dcb25f38a1606629254a7a24c3f43b249d5634a2ee0",
      "translation_text_hash": "e4fa044cdf8373271eb493763c9f4affa99db9ff4640d00925b505d9a9387adf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 모든 일을 사랑으로 행하라"
      ],
      "raw_text_hashes": [
        "e4fa044cdf8373271eb493763c9f4affa99db9ff4640d00925b505d9a9387adf"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:16:15",
      "sequence": 28788,
      "chapter_label": "1CO 16",
      "verse_label": "15",
      "locator": {
        "book": "1CO",
        "chapter": 16,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 16,
          "verse": 15
        }
      ],
      "en": "Now I beg you, brothers—you know the house of Stephanas, that it is the first fruits of Achaia, and that they have set themselves to serve the saints—",
