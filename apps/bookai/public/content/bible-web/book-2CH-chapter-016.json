    {
      "canonical_locator": "bible:web:2CH:16:9",
      "sequence": 11519,
      "chapter_label": "2CH 16",
      "verse_label": "9",
      "locator": {
        "book": "2CH",
        "chapter": 16,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 16,
          "verse": 9
        }
      ],
      "en": "For the LORD’s eyes run back and forth throughout the whole earth, to show himself strong in the behalf of them whose heart is perfect toward him. You have done foolishly in this; for from now on you will have wars.”",
      "ko": "여호와의 눈은 온 땅을 두루 감찰하사 전심으로 자기에게 향하는 자를 위하여 능력을 베푸시나니 이 일은 왕이 망령되이 행하였은즉 이 후부터는 왕에게 전쟁이 있으리이다 하매",
      "source_text_hash": "de177e1a2e86ef1238d1b304cfc6cae78111685709f81077c9c85d63f7b1e9a0",
      "translation_text_hash": "7e3576c40f38562ac137a007d4bb0c080f45753895ed40eddb14f939a855b2f6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 눈은 온 땅을 두루 감찰하사 전심으로 자기에게 향하는 자를 위하여 능력을 베푸시나니 이 일은 왕이 망령되이 행하였은즉 이 후부터는 왕에게 전쟁이 있으리이다 하매"
      ],
      "raw_text_hashes": [
