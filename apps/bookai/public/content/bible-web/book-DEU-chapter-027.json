      "en": "Moses commanded the people the same day, saying,",
      "ko": "모세가 당일에 백성에게 명하여 가로되",
      "source_text_hash": "7dea0f9f29d27a54ef5f287c1b09ee0735e652b279f71ff8c3ce98322710ab48",
      "translation_text_hash": "ca9ada6f2b83c1de1e3408f20468d8015870c6e044b213be5c45c2e2b947cf1f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세가 당일에 백성에게 명하여 가로되"
      ],
      "raw_text_hashes": [
        "ca9ada6f2b83c1de1e3408f20468d8015870c6e044b213be5c45c2e2b947cf1f"
      ]
    },
