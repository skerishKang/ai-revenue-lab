      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그의 택하신 사도들에게 성령으로 명하시고 승천하신 날까지의 일을 기록하였노라"
      ],
      "raw_text_hashes": [
        "11c5d56171e4dbef0f0b6e87b90e205013cc7ed33fe5046d583b048fc972ffd4"
