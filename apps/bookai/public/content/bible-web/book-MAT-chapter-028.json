      "raw_locator": [
        {
          "book": "MAT",
          "chapter": 28,
          "verse": 6
        }
      ],
      "en": "He is not here, for he has risen, just like he said. Come, see the place where the Lord was lying.",
      "ko": "그가 여기 계시지 않고 그의 말씀하시던대로 살아나셨느니라 와서 그의 누우셨던 곳을 보라",
      "source_text_hash": "9f34479a80782fe0480f3044c60e5f89f072e44fba798813d327f1933a4251ff",
      "translation_text_hash": "0e6568de41dda27689bc73b18028996f5d500f95f1067790865d2a5034e597df",
      "translation_policy": "krv-1961-source-mapped",
