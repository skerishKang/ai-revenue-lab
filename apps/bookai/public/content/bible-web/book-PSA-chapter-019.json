        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 19,
          "verse": 8
        }
      ],
      "en": "The LORD’s precepts are right, rejoicing the heart. The LORD’s commandment is pure, enlightening the eyes.",
      "ko": "여호와의 교훈은 정직하여 마음을 기쁘게 하고 여호와의 계명은 순결하여 눈을 밝게 하도다",
      "source_text_hash": "b9a10e09d0c3defddc0b8092e4bdf88f33feb63320862f65e647f00c9f0bdacf",
      "translation_text_hash": "af8076337101a1f124644f59063ef7e3381313f9cf78781e091d548f8fae4283",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 교훈은 정직하여 마음을 기쁘게 하고 여호와의 계명은 순결하여 눈을 밝게 하도다"
      ],
      "raw_text_hashes": [
        "af8076337101a1f124644f59063ef7e3381313f9cf78781e091d548f8fae4283"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:19:9",
      "sequence": 14178,
      "chapter_label": "PSA 19",
