        {
          "book": "PSA",
          "chapter": 19,
          "verse": 2
        }
      ],
      "en": "Day after day they pour out speech, and night after night they display knowledge.",
      "ko": "날은 날에게 말하고 밤은 밤에게 지식을 전하니",
      "source_text_hash": "f56df503767c9ea4e6a739825f3671bc6db334cc01e90af5820911778f0db032",
      "translation_text_hash": "d8d8772f4e2e11d84298b241a2a4f58279168d5b6dcd2c7f47034309550c1e3f",
      "translation_policy": "krv-1961-source-mapped",
