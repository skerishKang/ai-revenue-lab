        {
          "book": "PSA",
          "chapter": 19,
          "verse": 11
        }
      ],
      "en": "Moreover your servant is warned by them. In keeping them there is great reward.",
      "ko": "또 주의 종이 이로 경계를 받고 이를 지킴으로 상이 크니이다",
      "source_text_hash": "547e957b8172a870d6db811cfbf5de8dae731528ef699714b057aa8eb0ccea5f",
      "translation_text_hash": "8ac53afca891efb0e39f494d8543c31459578b411a0ae0a21eaead62b04dfdbd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 주의 종이 이로 경계를 받고 이를 지킴으로 상이 크니이다"
      ],
      "raw_text_hashes": [
        "8ac53afca891efb0e39f494d8543c31459578b411a0ae0a21eaead62b04dfdbd"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:19:12",
      "sequence": 14181,
      "chapter_label": "PSA 19",
      "verse_label": "12",
      "locator": {
        "book": "PSA",
