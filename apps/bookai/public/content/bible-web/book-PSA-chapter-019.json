      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 19,
          "verse": 3
        }
      ],
      "en": "There is no speech nor language where their voice is not heard.",
      "ko": "언어가 없고 들리는 소리도 없으나",
      "source_text_hash": "6905af83aed6fa56343a8d4c48d613967a643cecd0a650ba85d645b75b9aa997",
      "translation_text_hash": "63988c83d0354c5d56389f4976c6898969c5e7b734fdc247ae79c5efc12c45c0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "언어가 없고 들리는 소리도 없으나"
      ],
      "raw_text_hashes": [
        "63988c83d0354c5d56389f4976c6898969c5e7b734fdc247ae79c5efc12c45c0"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:19:4",
      "sequence": 14173,
      "chapter_label": "PSA 19",
