      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "해는 그 방에서 나오는 신랑과 같고 그 길을 달리기 기뻐하는 장사 같아서"
      ],
      "raw_text_hashes": [
        "c960e371578b8432a61919bc433a2c514ac421345d1bccc610b0137a2a1c598f"
      ]
