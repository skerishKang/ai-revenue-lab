      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 15,
          "verse": 13
        }
      ],
      "en": "“You, in your loving kindness, have led the people that you have redeemed. You have guided them in your strength to your holy habitation.",
      "ko": "주께서 그 구속하신 백성을 은혜로 인도하시되 주의 힘으로 그들을 주의 성결한 처소에 들어가게 하시나이다",
      "source_text_hash": "72cd166c0f2ae4c36ec957789f1ff5dae8b22eeba6aa112498987329748659a6",
      "translation_text_hash": "6fc3c7fb316d7cf7cdde3dbb1d72dbe49c943b43d3302fc01ccbc079e201ddcc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 그 구속하신 백성을 은혜로 인도하시되 주의 힘으로 그들을 주의 성결한 처소에 들어가게 하시나이다"
      ],
      "raw_text_hashes": [
        "6fc3c7fb316d7cf7cdde3dbb1d72dbe49c943b43d3302fc01ccbc079e201ddcc"
      ]
