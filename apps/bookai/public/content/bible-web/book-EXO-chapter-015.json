        {
          "book": "EXO",
          "chapter": 15,
          "verse": 4
        }
      ],
      "en": "He has cast Pharaoh’s chariots and his army into the sea. His chosen captains are sunk in the Red Sea.",
      "ko": "그가 바로의 병거와 그 군대를 바다에 던지시니 그 택한 장관이 홍해에 잠겼고",
      "source_text_hash": "f52cbf57ce130f7e90e6bed7610a5bdc8c35b1cdce8b2dc0f2d945cdcaff1857",
      "translation_text_hash": "4b478bdaa12681dcf69db44a87c2c28e952daa9598b9061a634d03b97b776456",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 바로의 병거와 그 군대를 바다에 던지시니 그 택한 장관이 홍해에 잠겼고"
      ],
      "raw_text_hashes": [
        "4b478bdaa12681dcf69db44a87c2c28e952daa9598b9061a634d03b97b776456"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:15:5",
      "sequence": 1926,
