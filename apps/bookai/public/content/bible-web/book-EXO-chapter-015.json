        {
          "book": "EXO",
          "chapter": 15,
          "verse": 3
        }
      ],
      "en": "The LORD is a man of war. The LORD is his name.",
      "ko": "여호와는 용사시니 여호와는 그의 이름이시로다",
      "source_text_hash": "68babf047d2131247fa2d472b4a3c09aa1152411ab3d1088c39519cb536043f3",
      "translation_text_hash": "16f9a63da9c22a6d47bf475b26d86625fc07ea54bea727be71b588920d6debac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와는 용사시니 여호와는 그의 이름이시로다"
      ],
      "raw_text_hashes": [
        "16f9a63da9c22a6d47bf475b26d86625fc07ea54bea727be71b588920d6debac"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:15:4",
      "sequence": 1925,
      "chapter_label": "EXO 15",
      "verse_label": "4",
      "locator": {
