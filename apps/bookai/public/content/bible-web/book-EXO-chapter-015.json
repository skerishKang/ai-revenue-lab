      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 15,
          "verse": 14
        }
      ],
      "en": "The peoples have heard. They tremble. Pangs have taken hold of the inhabitants of Philistia.",
      "ko": "열방이 듣고 떨며 블레셋 거민이 두려움에 잡히며",
      "source_text_hash": "8f39a1ed5b689ccb8039f85a73ec7f59a71b6b6b08ecd4c1f090c4b407ac8867",
      "translation_text_hash": "d0c2709971fe5216e5089e32c83f908ff4388896b151eef36eabfcd7306c5767",
      "translation_policy": "krv-1961-source-mapped",
