      "translation_text_hash": "45fda2b17cd380bb80542f4de466e17e505b53d2449e9617ffd11147ee787542",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 어찌하여 멀리 서시며 어찌하여 환난 때에 숨으시나이까"
      ],
      "raw_text_hashes": [
