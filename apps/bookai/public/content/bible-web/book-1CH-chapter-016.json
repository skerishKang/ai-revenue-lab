      "ko": "그에게 노래하며 그를 찬양하며 그 모든 기사를 말할찌어다",
      "source_text_hash": "7a011393a211089af622960ba1f2bd435e6328409bbbcd7fa9bfa92bfe4dcfc2",
      "translation_text_hash": "9106f395380d8012b5716544ea46f9121390c91afed7ff9d86bc9620fd96f8fd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그에게 노래하며 그를 찬양하며 그 모든 기사를 말할찌어다"
      ],
      "raw_text_hashes": [
        "9106f395380d8012b5716544ea46f9121390c91afed7ff9d86bc9620fd96f8fd"
      ]
    },
