      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하늘은 기뻐하고 땅은 즐거워하며 열방 중에서는 이르기를 여호와께서 통치하신다 할찌로다"
      ],
      "raw_text_hashes": [
        "c67ab1691fd3047b07ace6e18fb6edeb6004024a323545b0543c26966760f5b1"
