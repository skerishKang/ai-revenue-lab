        {
          "book": "ISA",
          "chapter": 7,
          "verse": 10
        }
      ],
      "en": "The LORD spoke again to Ahaz, saying,",
      "ko": "여호와께서 또 아하스에게 일러 가라사대",
      "source_text_hash": "37be1aa2f0e4d61235afbdca70f4cdb66871db757de7da94ed04717a0e84f012",
      "translation_text_hash": "d381cbcdb8fa826c036f3b32c595491805945e7851af62e0ea9f62f070f20bc0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 또 아하스에게 일러 가라사대"
      ],
      "raw_text_hashes": [
        "d381cbcdb8fa826c036f3b32c595491805945e7851af62e0ea9f62f070f20bc0"
      ]
    },
