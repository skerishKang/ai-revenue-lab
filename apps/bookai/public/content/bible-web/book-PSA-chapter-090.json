        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 12
        }
      ],
      "en": "So teach us to count our days, that we may gain a heart of wisdom.",
      "ko": "우리에게 우리 날 계수함을 가르치사 지혜의 마음을 얻게 하소서",
      "source_text_hash": "f9e1f0d2ce5567d2f176180c1bc967a68816dc28295c2c706562fc673f7a9611",
      "translation_text_hash": "9c2cae15167c358d563ad408f2d7fec60735d05e7e69438706da84868603c9f3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리에게 우리 날 계수함을 가르치사 지혜의 마음을 얻게 하소서"
      ],
      "raw_text_hashes": [
        "9c2cae15167c358d563ad408f2d7fec60735d05e7e69438706da84868603c9f3"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:13",
      "sequence": 15392,
      "chapter_label": "PSA 90",
      "verse_label": "13",
      "locator": {
        "book": "PSA",
