        "verse": 4
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 4
        }
      ],
      "en": "For a thousand years in your sight are just like yesterday when it is past, like a watch in the night.",
      "ko": "주의 목전에는 천년이 지나간 어제 같으며 밤의 한 경점 같을 뿐임이니이다",
      "source_text_hash": "7d9223a572ff6217009965ff70ddd49063ccff6e0dff5693746b49d4d8201431",
      "translation_text_hash": "0a19fc5ecabdc1685dd78dd0485298ea93eb878aa663530d6535ec47bdc55601",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 목전에는 천년이 지나간 어제 같으며 밤의 한 경점 같을 뿐임이니이다"
      ],
      "raw_text_hashes": [
        "0a19fc5ecabdc1685dd78dd0485298ea93eb878aa663530d6535ec47bdc55601"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:5",
      "sequence": 15384,
      "chapter_label": "PSA 90",
      "verse_label": "5",
      "locator": {
