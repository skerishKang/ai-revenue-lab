        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 11
        }
      ],
      "en": "Who knows the power of your anger, your wrath according to the fear that is due to you?",
      "ko": "누가 주의 노의 능력을 알며 누가 주를 두려워하여야 할대로 주의 진노를 알리이까",
      "source_text_hash": "569432af261ea98c3635ed349f2471d0424a95b3badd0bb9ff7f54021aa13999",
      "translation_text_hash": "9b181daa043786019e52b7c5fa536e5167575e342c6562ba5680ef26a704c59a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "누가 주의 노의 능력을 알며 누가 주를 두려워하여야 할대로 주의 진노를 알리이까"
      ],
      "raw_text_hashes": [
        "9b181daa043786019e52b7c5fa536e5167575e342c6562ba5680ef26a704c59a"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:12",
      "sequence": 15391,
      "chapter_label": "PSA 90",
      "verse_label": "12",
      "locator": {
