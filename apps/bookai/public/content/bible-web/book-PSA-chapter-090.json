        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 10
        }
      ],
      "en": "The days of our years are seventy, or even by reason of strength eighty years; yet their pride is but labor and sorrow, for it passes quickly, and we fly away.",
      "ko": "우리의 년수가 칠십이요 강건하면 팔십이라도 그 년수의 자랑은 수고와 슬픔 뿐이요 신속히 가니 우리가 날아가나이다",
      "source_text_hash": "1615ac81e07ccdc9f1e9288a436d352658d21900f5791e54d88c1d2d8501dbb6",
      "translation_text_hash": "8ed026d913a238225e2661be808bf492dd45c78dab0e5d44baaf18d52944f0a8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리의 년수가 칠십이요 강건하면 팔십이라도 그 년수의 자랑은 수고와 슬픔 뿐이요 신속히 가니 우리가 날아가나이다"
      ],
      "raw_text_hashes": [
        "8ed026d913a238225e2661be808bf492dd45c78dab0e5d44baaf18d52944f0a8"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:11",
      "sequence": 15390,
      "chapter_label": "PSA 90",
      "verse_label": "11",
      "locator": {
