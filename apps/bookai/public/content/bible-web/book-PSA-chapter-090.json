        "verse": 15
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 15
        }
      ],
      "en": "Make us glad for as many days as you have afflicted us, for as many years as we have seen evil.",
      "ko": "우리를 곤고케 하신 날수대로와 우리의 화를 당한 년수대로 기쁘게 하소서",
      "source_text_hash": "b5d6550b14e5180b7b0b02d03bb06835140f1c895f051da4524a6e6c5a86b7c5",
      "translation_text_hash": "051d3b81c0cce9ea9d8443f97fcf22e8fc78fd1030594dd84689fb25692c46c0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
