        "verse": 14
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 14
        }
      ],
      "en": "Satisfy us in the morning with your loving kindness, that we may rejoice and be glad all our days.",
      "ko": "아침에 주의 인자로 우리를 만족케 하사 우리 평생에 즐겁고 기쁘게 하소서",
      "source_text_hash": "a0c5a3c12ae559071a6ce9543a4181e86fddcaf63f3f2c581fb391bc1b55f5e5",
      "translation_text_hash": "298971a37863cc1840a7c2c02ac62468e9ec0bcad98c491fdfdfa6d8e7452b42",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아침에 주의 인자로 우리를 만족케 하사 우리 평생에 즐겁고 기쁘게 하소서"
      ],
      "raw_text_hashes": [
        "298971a37863cc1840a7c2c02ac62468e9ec0bcad98c491fdfdfa6d8e7452b42"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:15",
      "sequence": 15394,
      "chapter_label": "PSA 90",
      "verse_label": "15",
      "locator": {
        "book": "PSA",
