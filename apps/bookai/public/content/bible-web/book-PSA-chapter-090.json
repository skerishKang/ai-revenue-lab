        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 5
        }
      ],
      "en": "You sweep them away as they sleep. In the morning they sprout like new grass.",
      "ko": "주께서 저희를 홍수처럼 쓸어 가시나이다 저희는 잠간 자는것 같으며 아침에 돋는 풀 같으니이다",
      "source_text_hash": "342df6b405943f983a80db0ad63ac4ec0ad3317ae00701afc33478099ac983d8",
      "translation_text_hash": "c6266d8dd84f60da4addd80cbfb2def9068d1932e32af3c04e46f1e64c051835",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 저희를 홍수처럼 쓸어 가시나이다 저희는 잠간 자는것 같으며 아침에 돋는 풀 같으니이다"
      ],
      "raw_text_hashes": [
        "c6266d8dd84f60da4addd80cbfb2def9068d1932e32af3c04e46f1e64c051835"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:6",
      "sequence": 15385,
      "chapter_label": "PSA 90",
      "verse_label": "6",
      "locator": {
        "book": "PSA",
        "chapter": 90,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 6
        }
      ],
      "en": "In the morning it sprouts and springs up. By evening, it is withered and dry.",
      "ko": "풀은 아침에 꽃이 피어 자라다가 저녁에는 벤바 되어 마르나이다",
      "source_text_hash": "eda5047f1b6df71e14a10bc5821218914d321de490ab820af5489a19fa5bcb8b",
      "translation_text_hash": "a8da701b5d117894c6edf61d601f32984d6662b675cd58113f160b41feefe6fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "풀은 아침에 꽃이 피어 자라다가 저녁에는 벤바 되어 마르나이다"
      ],
      "raw_text_hashes": [
        "a8da701b5d117894c6edf61d601f32984d6662b675cd58113f160b41feefe6fe"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:7",
      "sequence": 15386,
      "chapter_label": "PSA 90",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 90,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 7
        }
      ],
      "en": "For we are consumed in your anger. We are troubled in your wrath.",
      "ko": "우리는 주의 노에 소멸되며 주의 분내심에 놀라나이다",
      "source_text_hash": "51e3ba26aa93cde6cdd2b5619cadb57e84cace9d905a56299e324edae33cbbfe",
      "translation_text_hash": "1ed8e41eb36598075c6f3209c647c237c51ab79b3b7f33291aab670c9dc4b995",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리는 주의 노에 소멸되며 주의 분내심에 놀라나이다"
      ],
      "raw_text_hashes": [
        "1ed8e41eb36598075c6f3209c647c237c51ab79b3b7f33291aab670c9dc4b995"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:8",
      "sequence": 15387,
      "chapter_label": "PSA 90",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
        "chapter": 90,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 8
        }
      ],
      "en": "You have set our iniquities before you, our secret sins in the light of your presence.",
      "ko": "주께서 우리의 죄악을 주의 앞에 놓으시며 우리의 은밀한 죄를 주의 얼굴 빛 가운데 두셨사오니",
      "source_text_hash": "e0f2521cd8a5ebaaa6b60e49919818a241212fd0514a82dd01b6a8d2e48e6945",
      "translation_text_hash": "b567c1b7427b8b074eeb40aef5e4917f46d4eb7ae94d072cf7b8e05aa90ae7f0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 우리의 죄악을 주의 앞에 놓으시며 우리의 은밀한 죄를 주의 얼굴 빛 가운데 두셨사오니"
      ],
      "raw_text_hashes": [
        "b567c1b7427b8b074eeb40aef5e4917f46d4eb7ae94d072cf7b8e05aa90ae7f0"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:9",
      "sequence": 15388,
      "chapter_label": "PSA 90",
      "verse_label": "9",
      "locator": {
        "book": "PSA",
        "chapter": 90,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 90,
          "verse": 9
        }
      ],
      "en": "For all our days have passed away in your wrath. We bring our years to an end as a sigh.",
      "ko": "우리의 모든 날이 주의 분노 중에 지나가며 우리의 평생이 일식간에 다하였나이다",
      "source_text_hash": "57265bf753f840fb7a5eb0ff19856d5a474a037169f59496a3304496016e1250",
      "translation_text_hash": "28819b91e226a4e40bf7647ce0784a605e1bf894c0097ae381f462fb3b29544a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리의 모든 날이 주의 분노 중에 지나가며 우리의 평생이 일식간에 다하였나이다"
      ],
      "raw_text_hashes": [
        "28819b91e226a4e40bf7647ce0784a605e1bf894c0097ae381f462fb3b29544a"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:90:10",
      "sequence": 15389,
      "chapter_label": "PSA 90",
      "verse_label": "10",
      "locator": {
