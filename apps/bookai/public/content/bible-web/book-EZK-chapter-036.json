      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 36,
          "verse": 28
        }
      ],
      "en": "You will dwell in the land that I gave to your fathers. You will be my people, and I will be your God.",
      "ko": "내가 너희 열조에게 준 땅에 너희가 거하여 내 백성이 되고 나는 너희 하나님이 되리라",
      "source_text_hash": "0a9083bce521a7579f7fc0843665a0c9ab487bd412c43ebd96ce643448d0df3c",
      "translation_text_hash": "120757735a119b3d4366700aad4823b9f5faabdd8af2631f7927ba305fabb0f6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너희 열조에게 준 땅에 너희가 거하여 내 백성이 되고 나는 너희 하나님이 되리라"
      ],
      "raw_text_hashes": [
        "120757735a119b3d4366700aad4823b9f5faabdd8af2631f7927ba305fabb0f6"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:36:29",
      "sequence": 21389,
      "chapter_label": "EZK 36",
      "verse_label": "29",
      "locator": {
