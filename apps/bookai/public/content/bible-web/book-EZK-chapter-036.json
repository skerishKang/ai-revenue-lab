        "verse": 29
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 36,
          "verse": 29
        }
      ],
      "en": "I will save you from all your uncleanness. I will call for the grain and will multiply it, and lay no famine on you.",
      "ko": "내가 너희를 모든 더러운데서 구원하고 곡식으로 풍성하게 하여 기근이 너희에게 임하지 아니하게 할 것이며",
      "source_text_hash": "3c673db42717bcc6bf0c64f725cbee5a5d0c597ce316d106965024ee8ed68713",
      "translation_text_hash": "5cfe82c5553377f3741634d325248e1da46d1f72163f6d7ece45c1c98cd10327",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너희를 모든 더러운데서 구원하고 곡식으로 풍성하게 하여 기근이 너희에게 임하지 아니하게 할 것이며"
      ],
      "raw_text_hashes": [
        "5cfe82c5553377f3741634d325248e1da46d1f72163f6d7ece45c1c98cd10327"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:36:30",
      "sequence": 21390,
      "chapter_label": "EZK 36",
      "verse_label": "30",
      "locator": {
