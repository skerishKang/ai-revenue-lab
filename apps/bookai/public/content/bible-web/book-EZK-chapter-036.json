        "verse": 30
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 36,
          "verse": 30
        }
      ],
      "en": "I will multiply the fruit of the tree and the increase of the field, that you may receive no more the reproach of famine among the nations.",
      "ko": "또 나무의 실과와 밭의 소산을 풍성케 하여 너희로 다시는 기근의 욕을 열국에게 받지 않게 하리니",
      "source_text_hash": "4fa253b4ba6475e595983d84985d513bd4ac3bd87c261b35e07b4c5f406a01b9",
      "translation_text_hash": "ff4146a06ae77a043c35004747d6914950adf907925bff886f047fa153790712",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 나무의 실과와 밭의 소산을 풍성케 하여 너희로 다시는 기근의 욕을 열국에게 받지 않게 하리니"
      ],
      "raw_text_hashes": [
