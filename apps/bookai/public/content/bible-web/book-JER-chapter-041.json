      ],
      "en": "The second day after he had killed Gedaliah, and no man knew it,",
      "ko": "그가 그다랴를 죽인지 이틀이 되었어도 이를 아는 사람이 없었더라",
      "source_text_hash": "dda6133cdd26267cc2299c2975292db7b23cb4d2362479086a504805fcfc6902",
      "translation_text_hash": "89e97e8864a49857491dd912cebe5f464c596b6e9db10f771e7a78b2808a92da",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 그다랴를 죽인지 이틀이 되었어도 이를 아는 사람이 없었더라"
      ],
      "raw_text_hashes": [
        "89e97e8864a49857491dd912cebe5f464c596b6e9db10f771e7a78b2808a92da"
      ]
    },
