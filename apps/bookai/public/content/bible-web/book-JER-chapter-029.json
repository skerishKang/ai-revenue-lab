    {
      "canonical_locator": "bible:web:JER:29:12",
      "sequence": 19648,
      "chapter_label": "JER 29",
      "verse_label": "12",
      "locator": {
        "book": "JER",
        "chapter": 29,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 29,
          "verse": 12
        }
      ],
      "en": "You shall call on me, and you shall go and pray to me, and I will listen to you.",
      "ko": "너희는 내게 부르짖으며 와서 내게 기도하면 내가 너희를 들을 것이요",
      "source_text_hash": "e98f8e04eb2445bfe7733fa3f58bbd6e38bd85a36717f8685d0fea47b2eea1c5",
      "translation_text_hash": "5ae883ca3256e0184b9283f307212f141b76a1a218a868e28d711336a9e4476a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 내게 부르짖으며 와서 내게 기도하면 내가 너희를 들을 것이요"
      ],
      "raw_text_hashes": [
        "5ae883ca3256e0184b9283f307212f141b76a1a218a868e28d711336a9e4476a"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:29:13",
      "sequence": 19649,
      "chapter_label": "JER 29",
      "verse_label": "13",
      "locator": {
        "book": "JER",
        "chapter": 29,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 29,
          "verse": 13
        }
      ],
      "en": "You shall seek me and find me, when you search for me with all your heart.",
      "ko": "너희가 전심으로 나를 찾고 찾으면 나를 만나리라",
      "source_text_hash": "9ebd7f3c2008195f6a40b702f20c08da53b3c8e889ff376df01546e46ba6222f",
      "translation_text_hash": "c552fc5e47cacc4aa3d12e7e7964a5124b1df349a72ec33066639ecd935c1eb0",
      "translation_policy": "krv-1961-source-mapped",
