      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 29,
          "verse": 18
        }
      ],
      "en": "I will pursue after them with the sword, with the famine, and with the pestilence, and will deliver them to be tossed back and forth among all the kingdoms of the earth, to be an object of horror, an astonishment, a hissing, and a reproach among all the nations where I have driven them,",
      "ko": "내가 칼과 기근과 염병으로 그들을 따르게 하며 그들을 세계 열방 중에 흩어 학대를 당하게 할 것이며 내가 그들을 쫓아 보낸 열방 중에서 저줏거리와 놀램과 치소와 모욕거리가 되게 하리니",
      "source_text_hash": "988d7e623f99dce2023df9396f89fc7b14ed6d763981224283c04143c206bd99",
      "translation_text_hash": "4f2024e266e166eecd72d71e06f16116f8f6418ddeab5393055dba1c189b6b59",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
