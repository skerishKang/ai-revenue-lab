      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 2
        }
      ],
      "en": "Our inheritance has been turned over to strangers, our houses to aliens.",
      "ko": "우리 기업이 외인에게, 우리 집들도 외인에게 돌아갔나이다",
      "source_text_hash": "34f6eab6a34b2097fb42e7195c91da70242021e89a38f17c1ead819174d91a20",
      "translation_text_hash": "1139e300cdff6ca1b7642b4297ad7c804a0d56d7cbd7a9a2f1cae71faf24a8f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 기업이 외인에게, 우리 집들도 외인에게 돌아갔나이다"
      ],
      "raw_text_hashes": [
        "1139e300cdff6ca1b7642b4297ad7c804a0d56d7cbd7a9a2f1cae71faf24a8f5"
      ]
