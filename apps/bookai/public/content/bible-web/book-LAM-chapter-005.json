      "sequence": 20457,
      "chapter_label": "LAM 5",
      "verse_label": "14",
      "locator": {
        "book": "LAM",
        "chapter": 5,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 14
        }
      ],
      "en": "The elders have ceased from the gate, and the young men from their music.",
      "ko": "노인은 다시 성문에 앉지 못하며 소년은 다시 노래하지 못하나이다",
      "source_text_hash": "e63abc830c5927b2823a011c2fd52c77b73c6609daf6fdd12b7975406a2aef4a",
      "translation_text_hash": "c9dfc63583d2f0908473a1e60509b19e1e0377ecafee0f3b18fdb47dfd6ccd64",
      "translation_policy": "krv-1961-source-mapped",
