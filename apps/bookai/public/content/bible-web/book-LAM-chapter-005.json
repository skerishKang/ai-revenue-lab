        "verse": 4
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 4
        }
      ],
      "en": "We must pay for water to drink. Our wood is sold to us.",
      "ko": "우리가 은을 주고 물을 마시며 값을 주고 섶을 얻으오며",
      "source_text_hash": "a09841050de098e69b9bfc073b4d95362157b0b203e1f122bb9663f44e0a4c63",
      "translation_text_hash": "d6c2752edc7ee435615790f79e6d900928e18ed4e1c6174e4e9db4eeacb3edeb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 은을 주고 물을 마시며 값을 주고 섶을 얻으오며"
      ],
      "raw_text_hashes": [
        "d6c2752edc7ee435615790f79e6d900928e18ed4e1c6174e4e9db4eeacb3edeb"
      ]
    },
    {
      "canonical_locator": "bible:web:LAM:5:5",
      "sequence": 20448,
      "chapter_label": "LAM 5",
      "verse_label": "5",
      "locator": {
