      "sequence": 20453,
      "chapter_label": "LAM 5",
      "verse_label": "10",
      "locator": {
        "book": "LAM",
        "chapter": 5,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 10
        }
      ],
      "en": "Our skin is black like an oven, because of the burning heat of famine.",
      "ko": "주림의 열기로 인하여 우리의 피부가 아궁이처럼 검으니이다",
      "source_text_hash": "746e0f8c0a9c6b554ef8e884de20f53db3ded96fb231c8e59f4cca8bdfc1927b",
      "translation_text_hash": "dcee7770026830b03144f6c7d164585fa72d8c71fcbf7979a8e6eb1b32ebfef4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주림의 열기로 인하여 우리의 피부가 아궁이처럼 검으니이다"
