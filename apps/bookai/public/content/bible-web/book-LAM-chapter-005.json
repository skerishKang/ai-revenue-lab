      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 15
        }
      ],
      "en": "The joy of our heart has ceased. Our dance is turned into mourning.",
      "ko": "우리 마음에 희락이 그쳤고 우리의 무도가 변하여 애통이 되었사오며",
      "source_text_hash": "728bc0e9a222337b33b06924da9778e91737f4c4034255e05e8f01c85bb5b44d",
      "translation_text_hash": "76382b5737f81ccc9d7d18c4d924147d9e08526f01af2adebc8be2b7de5abf25",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 마음에 희락이 그쳤고 우리의 무도가 변하여 애통이 되었사오며"
      ],
      "raw_text_hashes": [
        "76382b5737f81ccc9d7d18c4d924147d9e08526f01af2adebc8be2b7de5abf25"
      ]
    },
    {
      "canonical_locator": "bible:web:LAM:5:16",
      "sequence": 20459,
      "chapter_label": "LAM 5",
      "verse_label": "16",
      "locator": {
        "book": "LAM",
        "chapter": 5,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 16
        }
      ],
      "en": "The crown has fallen from our head. Woe to us, for we have sinned!",
      "ko": "우리 머리에서 면류관이 떨어졌사오니 오호라 우리의 범죄함을 인함이니이다",
