      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 우리의 당한 것을 기억하시고 우리의 수욕을 감찰하옵소서"
      ],
      "raw_text_hashes": [
        "36e89c17377c9317c69bc37fc58c34b4f6b154c0b4a8aefe9bb5b2fbb64ce3dd"
      ]
