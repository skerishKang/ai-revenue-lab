        "verse": 7
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 7
        }
      ],
      "en": "Our fathers sinned, and are no more. We have borne their iniquities.",
      "ko": "우리 열조는 범죄하고 없어졌고 우리는 그 죄악을 담당하였나이다",
      "source_text_hash": "682d7a8812df5ea3ef5fb4cf3782dd0b5bf8a4974583193f7146290290d34305",
      "translation_text_hash": "9f6730353afcc35074c04eca94cca2bed691fc155bd2fd0e99a7087cfab36064",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 열조는 범죄하고 없어졌고 우리는 그 죄악을 담당하였나이다"
      ],
      "raw_text_hashes": [
        "9f6730353afcc35074c04eca94cca2bed691fc155bd2fd0e99a7087cfab36064"
      ]
    },
    {
      "canonical_locator": "bible:web:LAM:5:8",
      "sequence": 20451,
      "chapter_label": "LAM 5",
      "verse_label": "8",
      "locator": {
        "book": "LAM",
        "chapter": 5,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 8
        }
      ],
      "en": "Servants rule over us. There is no one to deliver us out of their hand.",
      "ko": "종들이 우리를 관할함이여 그 손에서 건져낼 자가 없나이다",
      "source_text_hash": "a0cceeebe6809722d2f540517d9d2dbbe0136a3ebf2b954f344e32a71bb641ee",
      "translation_text_hash": "6acf9b1a755507964279476486336ced40f8d2207203cd875235d70437af433e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "종들이 우리를 관할함이여 그 손에서 건져낼 자가 없나이다"
      ],
      "raw_text_hashes": [
        "6acf9b1a755507964279476486336ced40f8d2207203cd875235d70437af433e"
      ]
    },
    {
      "canonical_locator": "bible:web:LAM:5:9",
      "sequence": 20452,
      "chapter_label": "LAM 5",
      "verse_label": "9",
      "locator": {
        "book": "LAM",
        "chapter": 5,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 9
        }
      ],
      "en": "We get our bread at the peril of our lives, because of the sword in the wilderness.",
      "ko": "광야에는 칼이 있으므로 죽기를 무릅써야 양식을 얻사오니",
      "source_text_hash": "53a6e43da317a65b7c86af872501727eadca61775c2ddf3619baf4389fd5da5d",
      "translation_text_hash": "e4ff7b019bf127db1a92349ff76d476d5488c7a519a5ffa97adea10339864f27",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "광야에는 칼이 있으므로 죽기를 무릅써야 양식을 얻사오니"
      ],
      "raw_text_hashes": [
        "e4ff7b019bf127db1a92349ff76d476d5488c7a519a5ffa97adea10339864f27"
      ]
