      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 3
        }
      ],
      "en": "We are orphans and fatherless. Our mothers are as widows.",
      "ko": "우리는 아비 없는 외로운 자식이오며 우리 어미는 과부 같으니",
      "source_text_hash": "90060249dac875dd5940ed5a9b960d59a8574024cd45836c053ddd4b53ac1a36",
      "translation_text_hash": "f40d9f8a0b97ba2fba18b794345099c404857c5fc66d484d9428eb633c4e8457",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리는 아비 없는 외로운 자식이오며 우리 어미는 과부 같으니"
      ],
      "raw_text_hashes": [
        "f40d9f8a0b97ba2fba18b794345099c404857c5fc66d484d9428eb633c4e8457"
      ]
    },
    {
      "canonical_locator": "bible:web:LAM:5:4",
      "sequence": 20447,
      "chapter_label": "LAM 5",
      "verse_label": "4",
      "locator": {
        "book": "LAM",
