      },
      "raw_locator": [
        {
          "book": "LAM",
          "chapter": 5,
          "verse": 13
        }
      ],
      "en": "The young men carry millstones. The children stumbled under loads of wood.",
      "ko": "소년들이 맷돌을 지오며 아이들이 섶을 지다가 엎드러지오며",
      "source_text_hash": "edcf1261c8890be79f4a40037bc9d41abe7e11bf5a63518bf9fdfe4691a44b27",
      "translation_text_hash": "7f427f8f69f74c45f42240b5d8944684876f3e8a02ab2ec0dcd58dde2134c6f2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "소년들이 맷돌을 지오며 아이들이 섶을 지다가 엎드러지오며"
      ],
      "raw_text_hashes": [
        "7f427f8f69f74c45f42240b5d8944684876f3e8a02ab2ec0dcd58dde2134c6f2"
      ]
    },
