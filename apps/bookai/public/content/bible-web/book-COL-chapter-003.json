      "source_text_hash": "2ff528412f29c22e90e0b760438ba2a875e68c783a8e01116688acb9d9c3436a",
      "translation_text_hash": "e20257d51c40c0e97cf4ad081a6899a6624b1824dd1534aaded7e9280fb3678d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
