      "source_text_hash": "fa4b2017290b3878088beeb190a3bdd8ddb4dc874ab59fc134e4f12ea330ccd4",
      "translation_text_hash": "60e5dd17765960990bf32b3c5e04ba73706281c9bf3a8f45e9e3ec5a13166794",
