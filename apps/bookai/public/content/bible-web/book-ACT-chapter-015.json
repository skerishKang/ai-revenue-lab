      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다만 우상의 더러운 것과 음행과 목매어 죽인 것과 피를 멀리 하라고 편지하는 것이 가하니"
      ],
      "raw_text_hashes": [
        "df45995e59675ec7c335b0a267f8b089fe10782af5718050add4fc0dd539194d"
      ]
