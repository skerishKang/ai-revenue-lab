      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 후에 내가 돌아와서 다윗의 무너진 장막을 다시 지으며 또 그 퇴락한 것을 다시 지어 일으키리니"
      ],
      "raw_text_hashes": [
        "c88879a5a3b523f4c8382896c5a89f8d32fe042156765c02051a9a443b12f3c4"
