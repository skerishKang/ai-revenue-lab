      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "예루살렘에 이르러 교회와 사도와 장로들에게 영접을 받고 하나님이 자기들과 함께 계셔 행하신 모든 일을 말하매"
      ],
      "raw_text_hashes": [
        "98fb0022dfdc44946fded0c61ea1d578e5f5ed534156cdbade48c915e670b4e1"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:15:5",
