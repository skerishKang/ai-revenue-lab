      "source_text_hash": "d0287da5898efcc9dd8e21a96ac990dabfe03e4a9b9980aeefd3ea4968cd22d5",
      "translation_text_hash": "fea03d17a6379b7d9b496827f2251105cdfbf296b75a9c488402e32e9278e44a",
