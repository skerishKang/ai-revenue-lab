      "source_text_hash": "57b2bfe4f512fb193238671e660afdb364b215fb382fcfadb8e8345793e042cf",
      "translation_text_hash": "0e67537f661afd8506e09a81901bbf38d8b0b19118f2c1c78a48d806026f4ded",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
