      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "선지자들의 말씀이 이와 합하도다 기록된바"
      ],
      "raw_text_hashes": [
        "48eaf53815b07a36edd461520e5bdef6eb91944adf4990a38425961f5b7e8961"
      ]
