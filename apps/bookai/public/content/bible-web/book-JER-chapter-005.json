    {
      "canonical_locator": "bible:web:JER:5:7",
      "sequence": 19066,
      "chapter_label": "JER 5",
      "verse_label": "7",
      "locator": {
        "book": "JER",
        "chapter": 5,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 5,
          "verse": 7
        }
      ],
      "en": "“How can I pardon you? Your children have forsaken me, and sworn by what are no gods. When I had fed them to the full, they committed adultery, and assembled themselves in troops at the prostitutes’ houses.",
      "ko": "내가 어찌 너를 사하겠느냐 네 자녀가 나를 버리고 신이 아닌 것들로 맹세하였으며 내가 그들을 배불리 먹인즉 그들이 행음하며 창기의 집에 허다히 모이며",
      "source_text_hash": "d1d7f61c6fb23d79a01751e9c584802d8e39feb8678bb6017b9955a464060af6",
      "translation_text_hash": "2b95a519b31683cbafc45dc9356955ac6d9c23c8cf71cf9083ceacc9ec86c933",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 어찌 너를 사하겠느냐 네 자녀가 나를 버리고 신이 아닌 것들로 맹세하였으며 내가 그들을 배불리 먹인즉 그들이 행음하며 창기의 집에 허다히 모이며"
      ],
      "raw_text_hashes": [
