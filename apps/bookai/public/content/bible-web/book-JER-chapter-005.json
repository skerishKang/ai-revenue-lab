        "chapter": 5,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 5,
          "verse": 10
        }
      ],
      "en": "“Go up on her walls, and destroy, but don’t make a full end. Take away her branches, for they are not the LORD’s.",
      "ko": "너희는 그 성벽에 올라가 훼파하되 다 훼파하지 말고 그 가지만 꺾어버리라 여호와의 것이 아님이니라",
      "source_text_hash": "e952e6a4ea1c94551953d744e7449edd618d21175115d0ac1f12c490dc741c32",
      "translation_text_hash": "310f78b22d83386467170dc4496891f327cb3a8d0ddd1fc1c5c1dadb028f92b9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 그 성벽에 올라가 훼파하되 다 훼파하지 말고 그 가지만 꺾어버리라 여호와의 것이 아님이니라"
      ],
      "raw_text_hashes": [
        "310f78b22d83386467170dc4496891f327cb3a8d0ddd1fc1c5c1dadb028f92b9"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:5:11",
      "sequence": 19070,
      "chapter_label": "JER 5",
      "verse_label": "11",
      "locator": {
        "book": "JER",
