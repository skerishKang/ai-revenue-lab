      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 20,
          "verse": 6
        }
      ],
      "en": "Moses and Aaron went from the presence of the assembly to the door of the Tent of Meeting, and fell on their faces. The LORD’s glory appeared to them.",
      "ko": "모세와 아론이 총회 앞을 떠나 회막 문에 이르러 엎드리매 여호와의 영광이 그들에게 나타나며",
      "source_text_hash": "26f9b4f564479f8abd5351e3d2dccf032ad67f6def417dace017fdd29a0145b0",
      "translation_text_hash": "72ba04caf89e3316e89f4397743f350dd7aea89afcd8c554eff7ebfe908a16e2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세와 아론이 총회 앞을 떠나 회막 문에 이르러 엎드리매 여호와의 영광이 그들에게 나타나며"
      ],
      "raw_text_hashes": [
        "72ba04caf89e3316e89f4397743f350dd7aea89afcd8c554eff7ebfe908a16e2"
      ]
