      "raw_texts": [
        "너는 아론과 그 아들 엘르아살을 데리고 호르산에 올라"
      ],
      "raw_text_hashes": [
        "4d862c0bb4a7d7db5bd29c133fdb9fc0d5466574aed4b13490b01eaa6b09595d"
