      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 11,
          "verse": 8
        }
      ],
      "en": "He counted them in Bezek; and the children of Israel were three hundred thousand, and the men of Judah thirty thousand.",
      "ko": "사울이 베섹에서 그들을 계수하니 이스라엘 자손이 삼십만이요 유다 사람이 삼만이더라",
      "source_text_hash": "4a249466d8118a26fe3a4f8826c020c55c3791e33ccfeb43b3ffcc38a5104b46",
      "translation_text_hash": "21aa7db35a26354f278ae8e258f667ffdec7d56e0d0316902b9db7b459d80f48",
      "translation_policy": "krv-1961-source-mapped",
