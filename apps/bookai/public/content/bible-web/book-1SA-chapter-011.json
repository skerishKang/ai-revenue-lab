      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울이 베섹에서 그들을 계수하니 이스라엘 자손이 삼십만이요 유다 사람이 삼만이더라"
      ],
      "raw_text_hashes": [
