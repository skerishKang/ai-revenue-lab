        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1PE",
          "chapter": 3,
          "verse": 11
        }
      ],
      "en": "Let him turn away from evil and do good. Let him seek peace and pursue it.",
      "ko": "악에서 떠나 선을 행하고 화평을 구하여 이를 좇으라",
      "source_text_hash": "d9d635dedd07b57b6dbdd401c4abce7b091c6e121bc3e7e0fda3d1baecefc3ce",
      "translation_text_hash": "d7f4f38a18b23abf6ec37cf0a9c8aa9ecd3772f38907934aafb40353a2143cec",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악에서 떠나 선을 행하고 화평을 구하여 이를 좇으라"
      ],
      "raw_text_hashes": [
        "d7f4f38a18b23abf6ec37cf0a9c8aa9ecd3772f38907934aafb40353a2143cec"
      ]
    },
    {
      "canonical_locator": "bible:web:1PE:3:12",
      "sequence": 30433,
      "chapter_label": "1PE 3",
      "verse_label": "12",
      "locator": {
        "book": "1PE",
        "chapter": 3,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "1PE",
          "chapter": 3,
          "verse": 12
        }
      ],
      "en": "For the eyes of the Lord are on the righteous, and his ears open to their prayer; but the face of the Lord is against those who do evil.”",
      "ko": "주의 눈은 의인을 향하시고 그의 귀는 저의 간구에 기울이시되 주의 낯은 악행하는 자들을 향하시느니라 하였느니라",
      "source_text_hash": "403e976cf02664131bb15c0e4b4c2ea477cc0400457628d555f603e60e88c266",
      "translation_text_hash": "f53f14d3d86f4f89f51303903ecfe18b13032c2c3c1c4509c59ba78a7ed38a0c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 눈은 의인을 향하시고 그의 귀는 저의 간구에 기울이시되 주의 낯은 악행하는 자들을 향하시느니라 하였느니라"
      ],
      "raw_text_hashes": [
        "f53f14d3d86f4f89f51303903ecfe18b13032c2c3c1c4509c59ba78a7ed38a0c"
