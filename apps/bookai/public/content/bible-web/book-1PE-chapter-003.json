        "verse": 13
      },
      "raw_locator": [
        {
          "book": "1PE",
          "chapter": 3,
          "verse": 13
        }
      ],
      "en": "Now who will harm you if you become imitators of that which is good?",
      "ko": "또 너희가 열심으로 선을 행하면 누가 너희를 해하리요",
      "source_text_hash": "2ba43dc181a8b4920a60e813af5e0cdab744348fc14d1e664241f9c5c2072091",
      "translation_text_hash": "9605fd25f19df8bd1fb8d9e67be7ea1659932a2fc1502dbf7c5816c1579936be",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 너희가 열심으로 선을 행하면 누가 너희를 해하리요"
      ],
      "raw_text_hashes": [
        "9605fd25f19df8bd1fb8d9e67be7ea1659932a2fc1502dbf7c5816c1579936be"
      ]
    },
    {
      "canonical_locator": "bible:web:1PE:3:14",
      "sequence": 30435,
      "chapter_label": "1PE 3",
      "verse_label": "14",
      "locator": {
        "book": "1PE",
        "chapter": 3,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "1PE",
          "chapter": 3,
          "verse": 14
        }
      ],
      "en": "But even if you should suffer for righteousness’ sake, you are blessed. “Don’t fear what they fear, neither be troubled.”",
      "ko": "그러나 의를 위하여 고난을 받으면 복 있는 자니 저희의 두려워함을 두려워 말며 소동치 말고",
      "source_text_hash": "2d7c03292f4244dc2f49f610e23ed062e33ab551549a56118bca61efd15cbb53",
