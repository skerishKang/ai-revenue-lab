      "translation_text_hash": "0c1bb3434e1325510bfc0191c0b66fc60bc82bf2e9b9c09e8cdf1b728679dccc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
