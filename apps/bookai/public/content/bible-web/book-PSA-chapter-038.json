      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 38,
          "verse": 6
        }
      ],
      "en": "I am in pain and bowed down greatly. I go mourning all day long.",
      "ko": "내가 아프고 심히 구부러졌으며 종일토록 슬픈 중에 다니나이다",
      "source_text_hash": "8fd95fed027d9953472aa874fce81adbddce79e97e0607fee2ad05bee5d2b7a1",
      "translation_text_hash": "16723ad1b91390563be26c3bec6f70c8497ab224bb6d1162e20c5024a8c4acba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
