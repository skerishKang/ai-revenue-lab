      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주의 노로 나를 책하지 마시고 분노로 나를 징계치 마소서"
      ],
      "raw_text_hashes": [
        "2418cc248a7f15835fbd8ce1a10215ab024438a8e067098f3b55a45b69b883e4"
      ]
    },
    {
