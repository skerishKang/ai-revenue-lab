        "verse": 4
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 38,
          "verse": 4
        }
      ],
      "en": "For my iniquities have gone over my head. As a heavy burden, they are too heavy for me.",
      "ko": "내 죄악이 내 머리에 넘쳐서 무거운 짐 같으니 감당할 수 없나이다",
      "source_text_hash": "8e2eac5b1d1e124b89b137feac46e07418e5628cf9d2f3efdad0bcda93b95390",
      "translation_text_hash": "fd6ae4b0ab560f2ee332b6774bd83df27fd89978a2b2eb73a17b7c0d0a631b73",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 죄악이 내 머리에 넘쳐서 무거운 짐 같으니 감당할 수 없나이다"
      ],
      "raw_text_hashes": [
        "fd6ae4b0ab560f2ee332b6774bd83df27fd89978a2b2eb73a17b7c0d0a631b73"
      ]
    },
    {
