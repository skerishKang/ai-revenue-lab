        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 38,
          "verse": 12
        }
      ],
      "en": "They also who seek after my life lay snares. Those who seek my hurt speak mischievous things, and meditate deceits all day long.",
      "ko": "내 생명을 찾는 자가 올무를 놓고 나를 해하려는 자가 괴악한 일을 말하여 종일토록 궤계를 도모하오나",
      "source_text_hash": "526866269eab619c4705dd0605e6113c859cd46409479fa8ff28ed096d62c2b8",
      "translation_text_hash": "4ce5593f15bb76cfb41952ad7053871dbf9d33fa63306071cda8a2056fb5ff06",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 생명을 찾는 자가 올무를 놓고 나를 해하려는 자가 괴악한 일을 말하여 종일토록 궤계를 도모하오나"
      ],
      "raw_text_hashes": [
        "4ce5593f15bb76cfb41952ad7053871dbf9d33fa63306071cda8a2056fb5ff06"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:38:13",
      "sequence": 14504,
      "chapter_label": "PSA 38",
      "verse_label": "13",
