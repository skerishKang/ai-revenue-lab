        "verse": 9
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 16,
          "verse": 9
        }
      ],
      "en": "Aaron shall present the goat on which the lot fell for the LORD, and offer him for a sin offering.",
      "ko": "아론은 여호와를 위하여 제비 뽑은 염소를 속죄제로 드리고",
      "source_text_hash": "73f939f0d17f07115a071a52867c5e476159e1b995fbb0071c65a55b5a46faec",
      "translation_text_hash": "0a2895c85610541907d21d236a115756075a7104b1e6023afc0d5c02bfba4a77",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아론은 여호와를 위하여 제비 뽑은 염소를 속죄제로 드리고"
      ],
      "raw_text_hashes": [
        "0a2895c85610541907d21d236a115756075a7104b1e6023afc0d5c02bfba4a77"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:16:10",
      "sequence": 3212,
      "chapter_label": "LEV 16",
      "verse_label": "10",
      "locator": {
        "book": "LEV",
