        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 4,
          "verse": 11
        }
      ],
      "en": "Command and teach these things.",
      "ko": "네가 이것들을 명하고 가르치라",
      "source_text_hash": "4343fe133e299c5d2efd9fa6cbe79106119d5c128edcc5717d725140683d6e68",
      "translation_text_hash": "0e7b9be3d57a3d5b665b9e37f3d7f1670ac3faa12de9b3281cfed188b529ae00",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 이것들을 명하고 가르치라"
      ],
      "raw_text_hashes": [
        "0e7b9be3d57a3d5b665b9e37f3d7f1670ac3faa12de9b3281cfed188b529ae00"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:4:12",
      "sequence": 29756,
      "chapter_label": "1TI 4",
      "verse_label": "12",
      "locator": {
        "book": "1TI",
        "chapter": 4,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 4,
          "verse": 12
        }
      ],
      "en": "Let no man despise your youth; but be an example to those who believe, in word, in your way of life, in love, in spirit, in faith, and in purity.",
      "ko": "누구든지 네 연소함을 업신여기지 못하게 하고 오직 말과 행실과 사랑과 믿음과 정절에 대하여 믿는 자에게 본이 되어",
      "source_text_hash": "70336c5d908ade97c76dc23bca947d5f46b4a434aa5c0e6a8411acfaeddeca9e",
      "translation_text_hash": "3a215f61b8ea7f5782ea237d57db38bc76d8b0b967fa73686bada66fa143f354",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "누구든지 네 연소함을 업신여기지 못하게 하고 오직 말과 행실과 사랑과 믿음과 정절에 대하여 믿는 자에게 본이 되어"
      ],
      "raw_text_hashes": [
        "3a215f61b8ea7f5782ea237d57db38bc76d8b0b967fa73686bada66fa143f354"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:4:13",
      "sequence": 29757,
      "chapter_label": "1TI 4",
      "verse_label": "13",
