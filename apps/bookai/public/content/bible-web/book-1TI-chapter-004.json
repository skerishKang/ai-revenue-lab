        "verse": 13
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 4,
          "verse": 13
        }
      ],
      "en": "Until I come, pay attention to reading, to exhortation, and to teaching.",
      "ko": "내가 이를 때까지 읽는 것과 권하는 것과 가르치는 것에 착념하라",
      "source_text_hash": "8b9d3220ff5079e0d949e513b424f2cca12bdb852d61e0e0bcebdb96fb1a16fd",
      "translation_text_hash": "2a87be32b375fe4b83614d22c49087969cb4b8b1834ebcc728fc5780375d6b96",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 이를 때까지 읽는 것과 권하는 것과 가르치는 것에 착념하라"
      ],
      "raw_text_hashes": [
        "2a87be32b375fe4b83614d22c49087969cb4b8b1834ebcc728fc5780375d6b96"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:4:14",
      "sequence": 29758,
      "chapter_label": "1TI 4",
      "verse_label": "14",
      "locator": {
        "book": "1TI",
        "chapter": 4,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 4,
          "verse": 14
        }
      ],
      "en": "Don’t neglect the gift that is in you, which was given to you by prophecy with the laying on of the hands of the elders.",
      "ko": "네 속에 있는 은사 곧 장로의 회에서 안수 받을 때에 예언으로 말미암아 받은 것을 조심 없이 말며",
      "source_text_hash": "88017d7a1dec9b9fbac7d431608097b14909916c1cc5469a90680a97786e9a76",
      "translation_text_hash": "35c5dca8bcea48a77a39002c66abc44e370de8592aba95dc19f61f02b726518b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 속에 있는 은사 곧 장로의 회에서 안수 받을 때에 예언으로 말미암아 받은 것을 조심 없이 말며"
      ],
      "raw_text_hashes": [
        "35c5dca8bcea48a77a39002c66abc44e370de8592aba95dc19f61f02b726518b"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:4:15",
      "sequence": 29759,
      "chapter_label": "1TI 4",
      "verse_label": "15",
      "locator": {
        "book": "1TI",
        "chapter": 4,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 4,
          "verse": 15
        }
      ],
