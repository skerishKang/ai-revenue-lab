      "raw_texts": [
        "우리가 항상 예수 죽인 것을 몸에 짊어짐은 예수의 생명도 우리 몸에 나타나게 하려 함이라"
      ],
      "raw_text_hashes": [
        "143f198e6849dd0186bb683d43b7960e7aeb267089ea86a47321ffe305aac596"
