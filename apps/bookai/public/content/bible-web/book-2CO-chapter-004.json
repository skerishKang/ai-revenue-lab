      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 4,
          "verse": 3
        }
      ],
      "en": "Even if our Good News is veiled, it is veiled in those who are dying,",
      "ko": "만일 우리 복음이 가리웠으면 망하는 자들에게 가리운 것이라",
      "source_text_hash": "0cf22f2bf3374906c7b7774b91930811971ef012f07e55de24563f5c51e2123a",
      "translation_text_hash": "447fffe94ed9a0f480974c213ba58afd15034e530e1d72d9ea1008018172acb4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 우리 복음이 가리웠으면 망하는 자들에게 가리운 것이라"
      ],
      "raw_text_hashes": [
        "447fffe94ed9a0f480974c213ba58afd15034e530e1d72d9ea1008018172acb4"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:4:4",
      "sequence": 28860,
      "chapter_label": "2CO 4",
      "verse_label": "4",
