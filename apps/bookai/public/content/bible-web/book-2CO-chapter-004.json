      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "기록한바 내가 믿는 고로 말하였다 한 것 같이 우리가 같은 믿음의 마음을 가졌으니 우리도 믿는 고로 또한 말하노라"
      ],
      "raw_text_hashes": [
        "b66db9055f7f7127be676b32ea923e973b272e3af1b8c98413a75e7b90afe05a"
