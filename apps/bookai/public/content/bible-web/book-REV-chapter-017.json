        "verse": 13
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 17,
          "verse": 13
        }
      ],
      "en": "These have one mind, and they give their power and authority to the beast.",
      "ko": "저희가 한 뜻을 가지고 자기의 능력과 권세를 짐승에게 주더라",
      "source_text_hash": "04d626207ad20b320eac7824d2caab353dbb3fb29a88c4c021bd36a95c22bf75",
      "translation_text_hash": "78a55c33c4ef588e2c44e83aae41966a8096a001f965b9719910bfa632f5e7fc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
