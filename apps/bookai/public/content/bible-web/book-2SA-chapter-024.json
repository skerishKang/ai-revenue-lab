        "verse": 12
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 24,
          "verse": 12
        }
      ],
      "en": "“Go and speak to David, ‘The LORD says, “I offer you three things. Choose one of them, that I may do it to you.”’”",
      "ko": "가서 다윗에게 말하기를 여호와의 말씀에 내가 네게 세가지를 보이노니 너는 그 중에서 하나를 택하라 내가 그것을 네게 행하리라 하셨다 하라",
      "source_text_hash": "c4ce1c6474b6d0d0fee75652f7ebbe1dd71b1986cc414e2e65d871b9134f3647",
      "translation_text_hash": "96909c6e7bc9cd98819025c831018baf832fad8622dd1ec98a832a213c0d5a41",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가서 다윗에게 말하기를 여호와의 말씀에 내가 네게 세가지를 보이노니 너는 그 중에서 하나를 택하라 내가 그것을 네게 행하리라 하셨다 하라"
      ],
      "raw_text_hashes": [
