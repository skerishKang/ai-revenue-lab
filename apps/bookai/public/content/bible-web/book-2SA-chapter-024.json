      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요단을 건너 갓 골짜기 가운데 성읍 아로엘 우편 곧 야셀 맞은편에 이르러 장막을 치고"
      ],
      "raw_text_hashes": [
        "eb1f8ba01136d648663f229cb71b3ea9a7ebe7d5e4c7b75e7a2a6073c9a9acb7"
