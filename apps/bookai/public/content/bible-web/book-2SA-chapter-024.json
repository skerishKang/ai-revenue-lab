      ]
    },
    {
      "canonical_locator": "bible:web:2SA:24:13",
      "sequence": 8706,
      "chapter_label": "2SA 24",
      "verse_label": "13",
      "locator": {
        "book": "2SA",
        "chapter": 24,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 24,
          "verse": 13
        }
      ],
      "en": "So Gad came to David, and told him, saying, “Shall seven years of famine come to you in your land? Or will you flee three months before your foes while they pursue you? Or shall there be three days’ pestilence in your land? Now answer, and consider what answer I shall return to him who sent me.”",
      "ko": "갓이 다윗에게 이르러 고하여 가로되 왕의 땅에 칠년 기근이 있을 것이니이까 혹시 왕이 왕의 대적에게 쫓겨 석달을 그 앞에서 도망하실 것이니이까 혹시 왕의 땅에 삼일 동안 온역이 있을 것이니이까 왕은 생각하여 보고 나를 보내신이에게 대답하게 하소서",
      "source_text_hash": "bc24cebfc7fd77043a5523e8c104b4f01c24e832b18c92de090732dae324b466",
      "translation_text_hash": "13eba6efd37ea3f3c6dd4fd8a36003625722b85ab1b8142d027b562cba856e28",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "갓이 다윗에게 이르러 고하여 가로되 왕의 땅에 칠년 기근이 있을 것이니이까 혹시 왕이 왕의 대적에게 쫓겨 석달을 그 앞에서 도망하실 것이니이까 혹시 왕의 땅에 삼일 동안 온역이 있을 것이니이까 왕은 생각하여 보고 나를 보내신이에게 대답하게 하소서"
      ],
      "raw_text_hashes": [
