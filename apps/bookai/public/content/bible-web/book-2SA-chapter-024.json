        "verse": 11
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 24,
          "verse": 11
        }
      ],
      "en": "When David rose up in the morning, the LORD’s word came to the prophet Gad, David’s seer, saying,",
      "ko": "다윗이 아침에 일어날 때에 여호와의 말씀이 다윗의 선견자 된 선지자 갓에게 임하여 가라사대",
      "source_text_hash": "4493417b365e3868c16cca0bafb0081aa5c57038e263e0f65390913ce64b5de3",
      "translation_text_hash": "ee55a5b4771130d341db6ad46adff18b71a03f4bb689333e22ef2bfc3a11e645",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 아침에 일어날 때에 여호와의 말씀이 다윗의 선견자 된 선지자 갓에게 임하여 가라사대"
      ],
      "raw_text_hashes": [
        "ee55a5b4771130d341db6ad46adff18b71a03f4bb689333e22ef2bfc3a11e645"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:24:12",
      "sequence": 8705,
      "chapter_label": "2SA 24",
      "verse_label": "12",
      "locator": {
        "book": "2SA",
