        {
          "book": "PSA",
          "chapter": 36,
          "verse": 3
        }
      ],
      "en": "The words of his mouth are iniquity and deceit. He has ceased to be wise and to do good.",
      "ko": "그 입의 말은 죄악과 궤휼이라 지혜와 선행을 그쳤도다",
      "source_text_hash": "64a8ab669b2e92f6505c7433b8f7b30ba734079eaef39d3375140c76bba27ea0",
      "translation_text_hash": "3af5d6a1198e54f0d1ff515b8c1ab7fb54d5450c458cff8431e35ecac9c531be",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 입의 말은 죄악과 궤휼이라 지혜와 선행을 그쳤도다"
      ],
      "raw_text_hashes": [
        "3af5d6a1198e54f0d1ff515b8c1ab7fb54d5450c458cff8431e35ecac9c531be"
      ]
    },
    {
