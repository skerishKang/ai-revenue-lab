        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 36,
          "verse": 6
        }
      ],
      "en": "Your righteousness is like the mountains of God. Your judgments are like a great deep. LORD, you preserve man and animal.",
      "ko": "주의 의는 하나님의 산들과 같고 주의 판단은 큰 바다와 일반이라 여호와여 주는 사람과 짐승을 보호하시나이다",
      "source_text_hash": "86216a1984441fde8da1f503f592050543cd91771cffa89e52478d2dbbec9ff8",
      "translation_text_hash": "dd02a1483b054d5e53323989538adc9677f1b3866c0af83b8d3f2f7dfe350721",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 의는 하나님의 산들과 같고 주의 판단은 큰 바다와 일반이라 여호와여 주는 사람과 짐승을 보호하시나이다"
      ],
      "raw_text_hashes": [
        "dd02a1483b054d5e53323989538adc9677f1b3866c0af83b8d3f2f7dfe350721"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:36:7",
      "sequence": 14446,
      "chapter_label": "PSA 36",
      "verse_label": "7",
      "locator": {
