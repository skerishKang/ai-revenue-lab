      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대저 생명의 원천이 주께 있사오니 주의 광명 중에 우리가 광명을 보리이다"
      ],
      "raw_text_hashes": [
        "4d778741ba4fd7445d29b303d31c367216305207097f02d2c790c9cfa18aff16"
      ]
