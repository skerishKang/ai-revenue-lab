      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 36,
          "verse": 7
        }
      ],
      "en": "How precious is your loving kindness, God! The children of men take refuge under the shadow of your wings.",
      "ko": "하나님이여 주의 인자하심이 어찌 그리 보배로우신지요 인생이 주의 날개 그늘 아래 피하나이다",
      "source_text_hash": "769588093898eee5491ead3e34bffe6b32d2046dbe43a3b31d6b64e3d48666cd",
      "translation_text_hash": "013c7b356009f3795cd7c6c92faffc24026719f272ad3cb8949e09056bdfe303",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 주의 인자하심이 어찌 그리 보배로우신지요 인생이 주의 날개 그늘 아래 피하나이다"
      ],
      "raw_text_hashes": [
        "013c7b356009f3795cd7c6c92faffc24026719f272ad3cb8949e09056bdfe303"
      ]
    },
    {
