      "source_text_hash": "2d632d1d946b29803b03a6a48817f749b76049ef359387ead91167dddd59d132",
      "translation_text_hash": "c33e91a12cdf4ada7b9aad31833719e16c9bbcaea3db7727c605fc931e3bc80f",
