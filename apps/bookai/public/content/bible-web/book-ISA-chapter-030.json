        "verse": 2
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 30,
          "verse": 2
        }
      ],
      "en": "who set out to go down into Egypt without asking for my advice, to strengthen themselves in the strength of Pharaoh, and to take refuge in the shadow of Egypt!",
      "ko": "(1절에 포함되어 있음)",
      "source_text_hash": "a1b51ebf0dca886c3a4b873ddb052eee9698a65e68a82c69f8a526523c4e890a",
      "translation_text_hash": "253b718e6a12d2bbd3630b6fd63da0bb9fdae2f1058f047b1053efe936f06e24",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
