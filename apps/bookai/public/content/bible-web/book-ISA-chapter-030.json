      ],
      "raw_text_hashes": [
        "253b718e6a12d2bbd3630b6fd63da0bb9fdae2f1058f047b1053efe936f06e24"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:30:3",
      "sequence": 18221,
      "chapter_label": "ISA 30",
      "verse_label": "3",
      "locator": {
        "book": "ISA",
        "chapter": 30,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 30,
          "verse": 3
        }
      ],
      "en": "Therefore the strength of Pharaoh will be your shame, and the refuge in the shadow of Egypt your confusion.",
      "ko": "그러므로 바로의 세력이 너희의 수치가 되며 애굽의 그늘에 피함이 너희의 수욕이 될 것이라",
      "source_text_hash": "2ec41aeeec5c2b8380981b5d722becb78c74664d0bd216d7a95c8c584815a690",
      "translation_text_hash": "5f71baab62c681448dd1937220be3ba64efa55f79ca7901d239e65b500ddcf9b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 바로의 세력이 너희의 수치가 되며 애굽의 그늘에 피함이 너희의 수욕이 될 것이라"
      ],
      "raw_text_hashes": [
        "5f71baab62c681448dd1937220be3ba64efa55f79ca7901d239e65b500ddcf9b"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:30:4",
