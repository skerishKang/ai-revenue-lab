        {
          "book": "PSA",
          "chapter": 55,
          "verse": 1
        }
      ],
      "en": "Listen to my prayer, God. Don’t hide yourself from my supplication.",
      "ko": "하나님이여 내 기도에 귀를 기울이시고 내가 간구할 때에 숨지 마소서",
      "source_text_hash": "a6769d68d6ee1315a0924ea9ce463a5ecbb76d802ca10ca04baed1bb3ec39fda",
      "translation_text_hash": "24447a215f7483ad318c2abf83c3d7e1d59a497f7898f2b388483a27975b2bfd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 내 기도에 귀를 기울이시고 내가 간구할 때에 숨지 마소서"
      ],
      "raw_text_hashes": [
        "24447a215f7483ad318c2abf83c3d7e1d59a497f7898f2b388483a27975b2bfd"
      ]
