        {
          "book": "PSA",
          "chapter": 55,
          "verse": 2
        }
      ],
      "en": "Attend to me, and answer me. I am restless in my complaint, and moan",
      "ko": "내게 굽히사 응답하소서 내가 근심으로 편치 못하여 탄식하오니",
      "source_text_hash": "a9c5243ee6f3ea210ca13ecdf62d38a3262fa456782bbc47930a88e7c6f89020",
      "translation_text_hash": "59ae706461684178f57b503c737903a0cfe698915c6b9cac9187e0c85c767e40",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게 굽히사 응답하소서 내가 근심으로 편치 못하여 탄식하오니"
      ],
      "raw_text_hashes": [
        "59ae706461684178f57b503c737903a0cfe698915c6b9cac9187e0c85c767e40"
      ]
    },
    {
