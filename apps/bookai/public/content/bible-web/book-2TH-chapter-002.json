      },
      "raw_locator": [
        {
          "book": "2TH",
          "chapter": 2,
          "verse": 6
        }
      ],
      "en": "Now you know what is restraining him, to the end that he may be revealed in his own season.",
      "ko": "저로 하여금 저의 때에 나타나게 하려 하여 막는 것을 지금도 너희가 아나니",
      "source_text_hash": "a7cba7d6a7412fbaca1e7b9226b0e417c68380713ebeae356c549e5e37c48a00",
      "translation_text_hash": "6f7b869ba1d9aa37f36a0fd657f49700b68640f220f2748e3dd80f3c02d61394",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저로 하여금 저의 때에 나타나게 하려 하여 막는 것을 지금도 너희가 아나니"
      ],
      "raw_text_hashes": [
        "6f7b869ba1d9aa37f36a0fd657f49700b68640f220f2748e3dd80f3c02d61394"
      ]
    },
    {
      "canonical_locator": "bible:web:2TH:2:7",
      "sequence": 29665,
      "chapter_label": "2TH 2",
      "verse_label": "7",
      "locator": {
        "book": "2TH",
