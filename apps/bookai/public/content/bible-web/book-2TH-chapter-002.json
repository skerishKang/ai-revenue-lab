      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "진리를 믿지 않고 불의를 좋아하는 모든 자로 심판을 받게 하려 하심이니라"
      ],
      "raw_text_hashes": [
        "e0b60a714030c8969c367db0248c05d02b201b8e2fb38ef875c42c2cf10c7fda"
      ]
