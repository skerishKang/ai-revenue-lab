      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 9,
          "verse": 2
        }
      ],
      "en": "“Let the children of Israel keep the Passover in its appointed season.",
      "ko": "이스라엘 자손으로 유월절을 그 정기에 지키게 하라",
      "source_text_hash": "c78590c953d580898f170d75d4729697d74ac7f4eb608e6adde05fa8e0256474",
      "translation_text_hash": "6ba92d7164ba6fa6e18759975fc715707e4049f64226b856d48fcaa6ed7c58f8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손으로 유월절을 그 정기에 지키게 하라"
      ],
      "raw_text_hashes": [
        "6ba92d7164ba6fa6e18759975fc715707e4049f64226b856d48fcaa6ed7c58f8"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:9:3",
      "sequence": 3969,
      "chapter_label": "NUM 9",
      "verse_label": "3",
      "locator": {
        "book": "NUM",
        "chapter": 9,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 9,
          "verse": 3
        }
      ],
      "en": "On the fourteenth day of this month, at evening, you shall keep it in its appointed season. You shall keep it according to all its statutes and according to all its ordinances.”",
      "ko": "그 정기 곧 이달 십사일 해질 때에 너희는 그것을 지키되 그 모든 율례와 그 모든 규례대로 지킬찌니라",
      "source_text_hash": "541807c5a685241c3d0f96787dec165cabf95b2e2a5fcfaf6a53dfea829007c7",
      "translation_text_hash": "f2f233fbce462b9e2d5355c1fa7ac5a3c4fb1f04d3fccc44920e5df0d64a6adf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 정기 곧 이달 십사일 해질 때에 너희는 그것을 지키되 그 모든 율례와 그 모든 규례대로 지킬찌니라"
      ],
      "raw_text_hashes": [
        "f2f233fbce462b9e2d5355c1fa7ac5a3c4fb1f04d3fccc44920e5df0d64a6adf"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:9:4",
