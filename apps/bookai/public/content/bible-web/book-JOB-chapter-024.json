      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사람의 담 안에서 기름을 짜며 목말라하면서 술 틀을 밟느니라"
      ],
      "raw_text_hashes": [
        "20344bf314912f606f61ecdbaa4ee9c384a37b8cfcf2b315a7b6f4aaeac2b57f"
