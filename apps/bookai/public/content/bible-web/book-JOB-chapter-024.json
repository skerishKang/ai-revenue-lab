      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 24,
          "verse": 2
        }
      ],
      "en": "There are people who remove the landmarks. They violently take away flocks, and feed them.",
      "ko": "어떤 사람은 지계표를 옮기며 양떼를 빼앗아 기르며",
      "source_text_hash": "ea28b006258d504f6df0b4573e7fe7389b276b10b577fcc85b56dbdccca744d6",
      "translation_text_hash": "82f4b54185fc49917ca67ea17f60ab8bd475a52c34dd9a43654de6a6eae87851",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어떤 사람은 지계표를 옮기며 양떼를 빼앗아 기르며"
      ],
      "raw_text_hashes": [
        "82f4b54185fc49917ca67ea17f60ab8bd475a52c34dd9a43654de6a6eae87851"
      ]
    },
    {
