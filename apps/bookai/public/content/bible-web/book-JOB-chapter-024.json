        "verse": 12
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 24,
          "verse": 12
        }
      ],
      "en": "From out of the populous city, men groan. The soul of the wounded cries out, yet God doesn’t regard the folly.",
      "ko": "인구 많은 성중에서 사람들이 신음하며 상한 자가 부르짖으나 하나님이 그 불의를 보지 아니하시느니라",
      "source_text_hash": "274f2aed4e9c444f2618fcb3a37b8746cae7f3f2d097be7aae185dc1534cf437",
      "translation_text_hash": "1dc614e7eba2fd4194216a4c5c23711c8a5c88a2881cc0a4977e744ac8d9d13c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "인구 많은 성중에서 사람들이 신음하며 상한 자가 부르짖으나 하나님이 그 불의를 보지 아니하시느니라"
      ],
      "raw_text_hashes": [
        "1dc614e7eba2fd4194216a4c5c23711c8a5c88a2881cc0a4977e744ac8d9d13c"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:24:13",
      "sequence": 13450,
      "chapter_label": "JOB 24",
      "verse_label": "13",
      "locator": {
