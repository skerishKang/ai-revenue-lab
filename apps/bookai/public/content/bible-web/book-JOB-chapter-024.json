      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 24,
          "verse": 6
        }
      ],
      "en": "They cut their food in the field. They glean the vineyard of the wicked.",
      "ko": "밭에서 남의 곡식을 베며 악인의 남겨 둔 포도를 따며",
      "source_text_hash": "cb846c104ab5e8fca59b72acf83f4c31a959fd596fa04a9e1062421c7aa600d0",
      "translation_text_hash": "8532340fe8300e7186377381e1734a23a6520eb9157c2d31014656444bef80cb",
      "translation_policy": "krv-1961-source-mapped",
