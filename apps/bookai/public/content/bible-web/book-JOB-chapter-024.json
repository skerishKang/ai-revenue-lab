      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 24,
          "verse": 3
        }
      ],
      "en": "They drive away the donkey of the fatherless, and they take the widow’s ox for a pledge.",
      "ko": "고아의 나귀를 몰아 가며 과부의 소를 볼모 잡으며",
      "source_text_hash": "31a05bc22696127fe6aac1aab90402d8b7e24154b0f9abe9fcaba75a0a461298",
      "translation_text_hash": "c582cbbd9763824b4e0fb6ae11354ff7e4456b0f1329f4b02c581c95b3b81820",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "고아의 나귀를 몰아 가며 과부의 소를 볼모 잡으며"
      ],
      "raw_text_hashes": [
        "c582cbbd9763824b4e0fb6ae11354ff7e4456b0f1329f4b02c581c95b3b81820"
      ]
