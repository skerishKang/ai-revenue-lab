      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 24,
          "verse": 7
        }
      ],
      "en": "They lie all night naked without clothing, and have no covering in the cold.",
      "ko": "의복이 없어 벗은 몸으로 밤을 지내며 추위에 덮을 것이 없으며",
      "source_text_hash": "7a22ea42ac0f8a98d24b2c3845ccf620b5bbe8f5b645456cb2d9f365db59d238",
      "translation_text_hash": "aefb42aa9fae089678576704d9852a73429e2fb8167ff26a34c05181103cda5a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
