      "raw_locator": [
        {
          "book": "ECC",
          "chapter": 11,
          "verse": 7
        }
      ],
      "en": "Truly the light is sweet, and it is a pleasant thing for the eyes to see the sun.",
      "ko": "빛은 실로 아름다운 것이라 눈으로 해를 보는 것이 즐거운 일이로다",
      "source_text_hash": "1c2b9ad4eac7bfa6a87fa9cab449e27228510d9a7019f0768f1d57a7a14c880b",
      "translation_text_hash": "cc39f7bf266bfc31eb9df734b6f587a2bc6f23c59ac8d5e1b663d4919b242388",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "빛은 실로 아름다운 것이라 눈으로 해를 보는 것이 즐거운 일이로다"
      ],
      "raw_text_hashes": [
        "cc39f7bf266bfc31eb9df734b6f587a2bc6f23c59ac8d5e1b663d4919b242388"
