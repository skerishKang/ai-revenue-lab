      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "곧 여호와께서 우리의 목전에서 크고 두려운 이적과 기사를 애굽과 바로와 그 온 집에 베푸시고"
      ],
      "raw_text_hashes": [
        "854208c96424a2bfe1f7addb3f913e72d2d3db926cf9a13b8b834c609c882eb0"
      ]
