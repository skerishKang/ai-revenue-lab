      "mapping_note": null,
      "raw_texts": [
        "이스라엘아 들으라 우리 하나님 여호와는 오직 하나인 여호와시니"
      ],
      "raw_text_hashes": [
        "8ac16d4363c3582f3840953a1dfcae02ead682134c9cee1f292389469e3bd6de"
      ]
