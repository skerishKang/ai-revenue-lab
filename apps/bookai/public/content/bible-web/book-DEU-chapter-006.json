    {
      "canonical_locator": "bible:web:DEU:6:18",
      "sequence": 5105,
      "chapter_label": "DEU 6",
      "verse_label": "18",
      "locator": {
        "book": "DEU",
        "chapter": 6,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 6,
          "verse": 18
        }
      ],
      "en": "You shall do that which is right and good in the LORD’s sight, that it may be well with you and that you may go in and possess the good land which the LORD swore to your fathers,",
      "ko": "여호와의 보시기에 정직하고 선량한 일을 행하라 그리하면 네가 복을 얻고 여호와께서 네 열조에게 맹세하사 네 대적을 몰수히 네 앞에서 쫓아내리라 하신 아름다운 땅을 들어가서 얻으리니 여호와의 말씀과 같으리라",
      "source_text_hash": "b636ab4d0f497b7056ddc3e03322c55338e5ac601297610e1f04d3cfe9d9199f",
      "translation_text_hash": "d8bb63c3e9e45c9691c3fc8922ca8bc8e0f52ad7a5058aa73777ba397ffec71b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 보시기에 정직하고 선량한 일을 행하라 그리하면 네가 복을 얻고 여호와께서 네 열조에게 맹세하사 네 대적을 몰수히 네 앞에서 쫓아내리라 하신 아름다운 땅을 들어가서 얻으리니 여호와의 말씀과 같으리라"
      ],
      "raw_text_hashes": [
        "d8bb63c3e9e45c9691c3fc8922ca8bc8e0f52ad7a5058aa73777ba397ffec71b"
      ]
    },
