      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 열조에게 맹세하신 땅으로 우리에게 주어 들어가게 하시려고 우리를 거기서 인도하여 내시고"
      ],
      "raw_text_hashes": [
        "e1f7e55e4620c896ad77c2581919242a3c1ef1500ac4413aae83db945a4d2148"
      ]
    },
