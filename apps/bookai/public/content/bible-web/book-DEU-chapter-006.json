      "translation_text_hash": "539210c39e5d1d3fe57bb64dc69fcc6b61060b9fe0d0c8069cf8491e5005a710",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오늘날 내가 네게 명하는 이 말씀을 너는 마음에 새기고"
      ],
      "raw_text_hashes": [
        "539210c39e5d1d3fe57bb64dc69fcc6b61060b9fe0d0c8069cf8491e5005a710"
      ]
    },
