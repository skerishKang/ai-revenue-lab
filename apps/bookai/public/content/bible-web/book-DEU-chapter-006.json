      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 다른 신들 곧 네 사면에 있는 백성의 신들을 좇지 말라"
      ],
      "raw_text_hashes": [
        "fa537a85421acc06f5d5a4c3454bfbb48cfe6ed5de1b2cb73b805c639e4dd055"
      ]
    },
    {
