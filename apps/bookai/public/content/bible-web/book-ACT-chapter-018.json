      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 18,
          "verse": 5
        }
      ],
      "en": "When Silas and Timothy came down from Macedonia, Paul was compelled by the Spirit, testifying to the Jews that Jesus was the Christ.",
      "ko": "실라와 디모데가 마게도냐로서 내려오매 바울이 하나님의 말씀에 붙잡혀 유대인들에게 예수는 그리스도라 밝히 증거하니",
      "source_text_hash": "36a6eea9230153d366e5a8af890d786d5e3a68a7cca8d69bcc50c814bcbb58a9",
      "translation_text_hash": "e5f078f5b34415d79095225ea89ff6b347714caa46dc9cfbc889f5b453cf6597",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "실라와 디모데가 마게도냐로서 내려오매 바울이 하나님의 말씀에 붙잡혀 유대인들에게 예수는 그리스도라 밝히 증거하니"
      ],
      "raw_text_hashes": [
