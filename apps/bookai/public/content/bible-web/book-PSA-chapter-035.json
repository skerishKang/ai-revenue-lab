      "source_text_hash": "8dfa1ba32e1357db7842ff52ee327bcc423dc7fe4aebbba5f2dfcf960d33674b",
      "translation_text_hash": "cd0f63c0b4143b8ee0a11bb22ecfeb132e87e171dbda087b8e2457383cdff270",
      "translation_policy": "krv-1961-source-mapped",
