        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 35,
          "verse": 12
        }
      ],
      "en": "They reward me evil for good, to the bereaving of my soul.",
      "ko": "내게 선을 악으로 갚아 나의 영혼을 외롭게 하나",
      "source_text_hash": "306555b7c70a39084367087aa4ccb5be093113d3b4c38ed27e88fabac61c055f",
      "translation_text_hash": "d1025419f29de31ad82cfa0f13150f63c7eb81b265a63679f9a93a72af9a707c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게 선을 악으로 갚아 나의 영혼을 외롭게 하나"
      ],
      "raw_text_hashes": [
        "d1025419f29de31ad82cfa0f13150f63c7eb81b265a63679f9a93a72af9a707c"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:35:13",
      "sequence": 14424,
      "chapter_label": "PSA 35",
      "verse_label": "13",
      "locator": {
        "book": "PSA",
