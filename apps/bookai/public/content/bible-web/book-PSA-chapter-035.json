      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 35,
          "verse": 9
        }
      ],
      "en": "My soul shall be joyful in the LORD. It shall rejoice in his salvation.",
      "ko": "내 영혼이 여호와를 즐거워함이여 그 구원을 기뻐하리로다",
      "source_text_hash": "48ad08e512f7113c9d9a690c66d0d55fc13c13b5d789a35dce429e617c192d00",
      "translation_text_hash": "d8dabde68e1212ece27cc6500dfc51f5402a7b9397f654c29e7311a261e3b151",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 영혼이 여호와를 즐거워함이여 그 구원을 기뻐하리로다"
      ],
      "raw_text_hashes": [
        "d8dabde68e1212ece27cc6500dfc51f5402a7b9397f654c29e7311a261e3b151"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:35:10",
      "sequence": 14421,
      "chapter_label": "PSA 35",
      "verse_label": "10",
      "locator": {
