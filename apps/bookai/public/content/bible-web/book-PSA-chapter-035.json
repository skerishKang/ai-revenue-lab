      ],
      "en": "Let them be as chaff before the wind, the LORD’s angel driving them on.",
      "ko": "저희로 바람 앞에 겨와 같게 하시고 여호와의 사자로 몰아내소서",
      "source_text_hash": "60c8208e53785ee482c05ee5d7f90d1b626a9b1f2e4766827b0539d459336c7b",
      "translation_text_hash": "c7376aaee70f35a10311a5210259c23636749337549e4d7a66d045357d90ffb2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희로 바람 앞에 겨와 같게 하시고 여호와의 사자로 몰아내소서"
      ],
      "raw_text_hashes": [
        "c7376aaee70f35a10311a5210259c23636749337549e4d7a66d045357d90ffb2"
      ]
    },
    {
