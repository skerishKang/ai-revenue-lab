      "source_text_hash": "b261b825c30d7e299a7b729825af1780ae059d4b1be31014cb254e6c8a3dc2ee",
      "translation_text_hash": "5f04c83b205f74a4ff67bd02609292525955591c6c33fcf1133d7d258136a00d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
