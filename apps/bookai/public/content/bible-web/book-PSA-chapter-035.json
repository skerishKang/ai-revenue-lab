      ],
      "en": "Contend, LORD, with those who contend with me. Fight against those who fight against me.",
      "ko": "여호와여 나와 다투는 자와 다투시고 나와 싸우는 자와 싸우소서",
      "source_text_hash": "4363f60d665c0c0979a907b38638e5df1c078164390947cef1758d99b4a7d58a",
      "translation_text_hash": "59912c5bf610d4d0eab00071b2aa977c241a61b208ef45ff1069fe8a3563c56c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나와 다투는 자와 다투시고 나와 싸우는 자와 싸우소서"
      ],
      "raw_text_hashes": [
