      "source_text_hash": "5acabaa12dbdfe7c92c4acf2d0db8e30ec639cf25535096ceb2b345f7a60f540",
      "translation_text_hash": "38b9aecbd3d36e571b9077e7a9387c5d8a2fb9374258684f2bf3983d4160fe8c",
