      "raw_locator": [
        {
          "book": "JOL",
          "chapter": 3,
          "verse": 7
        }
      ],
      "en": "Behold, I will stir them up out of the place where you have sold them, and will return your repayment on your own head;",
      "ko": "보라 내가 그들을 너희가 팔아 이르게 한 곳에서 일으켜 나오게 하고 너희의 행한 것을 너희 머리에 돌려서",
      "source_text_hash": "325569e945a4dc767fcecb8b45472d9d4231f2996b7edf12b4e9f7354239b655",
      "translation_text_hash": "b5cb0224470abf443da7c44d16c9df07f594e7432523a0470b20516b1be974bc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 내가 그들을 너희가 팔아 이르게 한 곳에서 일으켜 나오게 하고 너희의 행한 것을 너희 머리에 돌려서"
      ],
      "raw_text_hashes": [
        "b5cb0224470abf443da7c44d16c9df07f594e7432523a0470b20516b1be974bc"
      ]
