      "raw_locator": [
        {
          "book": "JOL",
          "chapter": 3,
          "verse": 11
        }
      ],
      "en": "Hurry and come, all you surrounding nations, and gather yourselves together.” Cause your mighty ones to come down there, LORD.",
      "ko": "사면의 열국아 너희는 속히 와서 모일찌어다 여호와여 주의 용사들로 그리로 내려오게 하옵소서",
      "source_text_hash": "435cf1ccf5324a1852e34aa6324886c5cc799aab4b343269ad9fab059c49d39b",
      "translation_text_hash": "25e8769bdb29f51350ebd201ce2cb44ddaaa03451bcbd0ac2db1463e639da43c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사면의 열국아 너희는 속히 와서 모일찌어다 여호와여 주의 용사들로 그리로 내려오게 하옵소서"
      ],
      "raw_text_hashes": [
        "25e8769bdb29f51350ebd201ce2cb44ddaaa03451bcbd0ac2db1463e639da43c"
      ]
    },
    {
