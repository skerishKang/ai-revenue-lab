      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 제비 뽑아 내 백성을 취하고 동남으로 기생을 바꾸며 동녀로 술을 바꾸어 마셨음이니라"
      ],
      "raw_text_hashes": [
