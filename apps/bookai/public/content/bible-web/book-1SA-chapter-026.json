        "verse": 4
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 26,
          "verse": 4
        }
      ],
      "en": "David therefore sent out spies, and understood that Saul had certainly come.",
      "ko": "이에 탐정을 보내어 사울이 과연 이른줄 알고",
      "source_text_hash": "5033618358629b001e3224ef7eeaf05fd501b5c73e477c43bacb76d7f22efc6f",
      "translation_text_hash": "2cb287ca499d75ca321b2c67b4db52de7e3e290305aa1452fcdef37bc4658fa9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이에 탐정을 보내어 사울이 과연 이른줄 알고"
      ],
      "raw_text_hashes": [
        "2cb287ca499d75ca321b2c67b4db52de7e3e290305aa1452fcdef37bc4658fa9"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:26:5",
      "sequence": 7911,
      "chapter_label": "1SA 26",
      "verse_label": "5",
      "locator": {
        "book": "1SA",
        "chapter": 26,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 26,
          "verse": 5
        }
      ],
      "en": "Then David arose and came to the place where Saul had encamped; and David saw the place where Saul lay, with Abner the son of Ner, the captain of his army. Saul lay within the place of the wagons, and the people were encamped around him.",
      "ko": "일어나 사울의 진 친 곳에 이르러 사울과 넬의 아들 군대장관 아브넬의 유하는 곳을 본즉 사울이 진 가운데 누웠고 백성은 그를 둘러 진 쳤더라",
      "source_text_hash": "1cd774c8643ae706d1f7826c7988ab09af346b8ea8c0199aba8454170c23d86f",
      "translation_text_hash": "420b85ff1145e3fa1421827481164846fbe4469daf5cc99e316132b1ceab8f9a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "일어나 사울의 진 친 곳에 이르러 사울과 넬의 아들 군대장관 아브넬의 유하는 곳을 본즉 사울이 진 가운데 누웠고 백성은 그를 둘러 진 쳤더라"
      ],
      "raw_text_hashes": [
        "420b85ff1145e3fa1421827481164846fbe4469daf5cc99e316132b1ceab8f9a"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:26:6",
      "sequence": 7912,
      "chapter_label": "1SA 26",
      "verse_label": "6",
      "locator": {
        "book": "1SA",
        "chapter": 26,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 26,
          "verse": 6
        }
      ],
      "en": "Then David answered and said to Ahimelech the Hittite, and to Abishai the son of Zeruiah, brother of Joab, saying, “Who will go down with me to Saul to the camp?” Abishai said, “I will go down with you.”",
      "ko": "이에 다윗이 헷 사람 아히멜렉과 스루야의 아들 요압의 아우 아비새에게 물어 가로되 누가 나로 더불어 진에 내려 가서 사울에게 이르겠느냐 아비새가 가로되 내가 함께 가겠나이다",
      "source_text_hash": "80fc5392548c8318ff0a5270c9cf3d720b4842d3022271905fb2e4d83eaafc01",
      "translation_text_hash": "e6e160bb8f86c167ef94f428aba6c0172cff1ff308cf1b44abefec1ccd086884",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이에 다윗이 헷 사람 아히멜렉과 스루야의 아들 요압의 아우 아비새에게 물어 가로되 누가 나로 더불어 진에 내려 가서 사울에게 이르겠느냐 아비새가 가로되 내가 함께 가겠나이다"
      ],
      "raw_text_hashes": [
        "e6e160bb8f86c167ef94f428aba6c0172cff1ff308cf1b44abefec1ccd086884"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:26:7",
      "sequence": 7913,
      "chapter_label": "1SA 26",
      "verse_label": "7",
      "locator": {
        "book": "1SA",
        "chapter": 26,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 26,
          "verse": 7
        }
      ],
      "en": "So David and Abishai came to the people by night; and, behold, Saul lay sleeping within the place of the wagons, with his spear stuck in the ground at his head; and Abner and the people lay around him.",
      "ko": "다윗과 아비새가 밤에 그 백성에게 나아가 본즉 사울이 진 가운데 누워 자고 창은 머리 곁 땅에 꽂혔고 아브넬과 백성들은 그를 둘러 누웠는지라",
      "source_text_hash": "9415a5db96ddf2ff511d9912ceb71fa3cb7ee1848cd205047e91004a58c6a268",
      "translation_text_hash": "d2fe0c2953fef54e940ebd60dec72277e1a1ff7b77785300c9ad197ec97df1bb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗과 아비새가 밤에 그 백성에게 나아가 본즉 사울이 진 가운데 누워 자고 창은 머리 곁 땅에 꽂혔고 아브넬과 백성들은 그를 둘러 누웠는지라"
      ],
      "raw_text_hashes": [
        "d2fe0c2953fef54e940ebd60dec72277e1a1ff7b77785300c9ad197ec97df1bb"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:26:8",
      "sequence": 7914,
      "chapter_label": "1SA 26",
      "verse_label": "8",
      "locator": {
        "book": "1SA",
        "chapter": 26,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 26,
          "verse": 8
        }
      ],
      "en": "Then Abishai said to David, “God has delivered up your enemy into your hand today. Now therefore please let me strike him with the spear to the earth at one stroke, and I will not strike him the second time.”",
      "ko": "아비새가 다윗에게 이르되 하나님이 오늘날 당신의 원수를 당신의 손에 붙이셨나이다 그러므로 청하오니 나로 창으로 그를 찔러서 단번에 땅에 꽂게 하소서 내가 그를 두번 찌를 것이 없으리이다",
      "source_text_hash": "9619a5dc01f14ac1612a5ed335bcbd7ff8381dee8c8f86ae480bc8e91290221b",
      "translation_text_hash": "a672295b15be9eeeb7ae76badfa243c0fc3f3cba150f712fa4eaa6b2e621a82d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아비새가 다윗에게 이르되 하나님이 오늘날 당신의 원수를 당신의 손에 붙이셨나이다 그러므로 청하오니 나로 창으로 그를 찔러서 단번에 땅에 꽂게 하소서 내가 그를 두번 찌를 것이 없으리이다"
      ],
      "raw_text_hashes": [
        "a672295b15be9eeeb7ae76badfa243c0fc3f3cba150f712fa4eaa6b2e621a82d"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:26:9",
      "sequence": 7915,
      "chapter_label": "1SA 26",
      "verse_label": "9",
      "locator": {
        "book": "1SA",
        "chapter": 26,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 26,
          "verse": 9
        }
      ],
      "en": "David said to Abishai, “Don’t destroy him, for who can stretch out his hand against the LORD’s anointed, and be guiltless?”",
      "ko": "다윗이 아비새에게 이르되 죽이지 말라 누구든지 손을 들어 여호와의 기름 부음을 받은 자를 치면 죄가 없겠느냐",
      "source_text_hash": "0b0e402767fae73c2fed5ad2e9b8ac0cd72a598c82c0bc9a968df49a46ae4a73",
      "translation_text_hash": "dbb1288a3a518d0945c3ab744de965e937798e1f81dbba86f292a36236554de0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 아비새에게 이르되 죽이지 말라 누구든지 손을 들어 여호와의 기름 부음을 받은 자를 치면 죄가 없겠느냐"
      ],
      "raw_text_hashes": [
        "dbb1288a3a518d0945c3ab744de965e937798e1f81dbba86f292a36236554de0"
      ]
