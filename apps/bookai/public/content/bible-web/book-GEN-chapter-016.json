      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브람의 아내 사래는 생산치 못하였고 그에게 한 여종이 있으니 애굽 사람이요 이름은 하갈이라"
      ],
      "raw_text_hashes": [
        "050b7ab2cc7058d42a5b611962c4598f6b72b1eb49f6dbb5b815b4a8547330a4"
      ]
