        "verse": 10
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 16,
          "verse": 10
        }
      ],
      "en": "The LORD’s angel said to her, “I will greatly multiply your offspring, that they will not be counted for multitude.”",
      "ko": "여호와의 사자가 또 그에게 이르되 내가 네 자손으로 크게 번성하여 그 수가 많아 셀 수 없게 하리라",
      "source_text_hash": "652e4a327b169430c5be82e8ef509130bcdf23a395fe3e8a613179797a941a0e",
      "translation_text_hash": "50022d3986d25f20f636244c2b87b96508f1297e976f8981297077cf76c80d26",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
