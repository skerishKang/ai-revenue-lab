        "verse": 7
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 16,
          "verse": 7
        }
      ],
      "en": "The LORD’s angel found her by a fountain of water in the wilderness, by the fountain on the way to Shur.",
      "ko": "여호와의 사자가 광야의 샘곁 곧 술 길 샘물 곁에서 그를 만나",
      "source_text_hash": "e096761fb63559e16751c4795fe6f43e7c6617a3d562d09db71c1ac4cc0dda94",
      "translation_text_hash": "47c042b95d2056a567f22451ee51e72e9df8ae62c4eb88fad09cd6495aa35a5e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 사자가 광야의 샘곁 곧 술 길 샘물 곁에서 그를 만나"
      ],
      "raw_text_hashes": [
        "47c042b95d2056a567f22451ee51e72e9df8ae62c4eb88fad09cd6495aa35a5e"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:16:8",
      "sequence": 390,
      "chapter_label": "GEN 16",
      "verse_label": "8",
      "locator": {
        "book": "GEN",
