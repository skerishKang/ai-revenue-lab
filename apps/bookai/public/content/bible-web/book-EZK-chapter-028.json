      "en": "The LORD’s word came again to me, saying,",
      "ko": "여호와의 말씀이 또 내게 임하여 가라사대",
      "source_text_hash": "53317430a9b7a9fdbe9156a35ae512112bae6b6f909738ce12aa74f8e4a71377",
      "translation_text_hash": "d80f64c74466735890f0e38292da375b0a0ec48e42ba77cef849f80e52a6bc56",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 또 내게 임하여 가라사대"
      ],
      "raw_text_hashes": [
        "d80f64c74466735890f0e38292da375b0a0ec48e42ba77cef849f80e52a6bc56"
      ]
