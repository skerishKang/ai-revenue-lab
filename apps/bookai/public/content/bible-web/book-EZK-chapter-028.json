      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 28,
          "verse": 17
        }
      ],
      "en": "Your heart was lifted up because of your beauty. You have corrupted your wisdom by reason of your splendor. I have cast you to the ground. I have laid you before kings, that they may see you.",
      "ko": "네가 아름다우므로 마음이 교만하였으며 네가 영화로우므로 네 지혜를 더럽혔음이여 내가 너를 땅에 던져 열왕 앞에 두어 그들의 구경거리가 되게 하였도다",
      "source_text_hash": "a635e02b5a7088a81b212f514f79563f55777a4e21476cce0f570785130e6e7f",
      "translation_text_hash": "ab54c89addd857dcf5f565af32e07940e22d365143bcccaa161615e226145f84",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 아름다우므로 마음이 교만하였으며 네가 영화로우므로 네 지혜를 더럽혔음이여 내가 너를 땅에 던져 열왕 앞에 두어 그들의 구경거리가 되게 하였도다"
      ],
      "raw_text_hashes": [
