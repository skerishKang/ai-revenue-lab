      "locator": {
        "book": "JER",
        "chapter": 30,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 30,
          "verse": 15
        }
      ],
      "en": "Why do you cry over your injury? Your pain is incurable. For the greatness of your iniquity, because your sins have increased, I have done these things to you.",
      "ko": "어찌하여 네 상처를 인하여 부르짖느뇨 네 고통이 낫지 못하리라 네 죄악의 큼과 죄의 수다함을 인하여 내가 네게 이 일을 행하였느니라",
      "source_text_hash": "c1a6115b6ed22fb5d13701bf79737cb4a27e606f60f453b5cf1310184e59aa62",
      "translation_text_hash": "48f44e29f297ffbe6cf40c2cf93e04e7f8475e0225bb838a1e74a4d958e4e596",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어찌하여 네 상처를 인하여 부르짖느뇨 네 고통이 낫지 못하리라 네 죄악의 큼과 죄의 수다함을 인하여 내가 네게 이 일을 행하였느니라"
      ],
      "raw_text_hashes": [
