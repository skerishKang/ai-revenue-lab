      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 자손은 여전하겠고 그 회중은 내 앞에 굳게 설 것이며 무릇 그를 압박하는 자는 내가 다 벌하리라"
      ],
      "raw_text_hashes": [
        "0e80120765188cde38627f1a19bc623795b4fbb0e581e26cc1bcc979f6760447"
      ]
