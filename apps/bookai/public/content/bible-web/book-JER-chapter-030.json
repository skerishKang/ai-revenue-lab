      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께로서 말씀이 예레미야에게 임하여 이르시니라"
      ],
      "raw_text_hashes": [
        "596aa7f5a8f2c40395add81341d02a0889aab3fff0feb6eea6ebe13a3f1cbdd3"
      ]
