      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 우리가 사람들의 증거를 받을찐대 하나님의 증거는 더욱 크도다 하나님의 증거는 이것이니 그 아들에 관하여 증거하신 것이니라"
      ],
      "raw_text_hashes": [
        "c7a5d5eb5c64d4b86f2a37bc143af7f67c2a1a59b953eeacba974e80f32fc527"
