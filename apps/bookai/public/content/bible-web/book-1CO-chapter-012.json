        }
      ],
      "en": "There are various kinds of service, and the same Lord.",
      "ko": "직임은 여러 가지나 주는 같으며",
      "source_text_hash": "07e653638a7526800c2ed04075b1ad60801814fdb53c017fffa7d61fd4dce3c7",
      "translation_text_hash": "8992e6d8a555669a444a4eb64e914359423cf23dede7c397483c6daf649fd0fa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "직임은 여러 가지나 주는 같으며"
      ],
      "raw_text_hashes": [
        "8992e6d8a555669a444a4eb64e914359423cf23dede7c397483c6daf649fd0fa"
      ]
    },
    {
