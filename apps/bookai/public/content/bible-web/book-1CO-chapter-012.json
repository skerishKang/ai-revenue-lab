        {
          "book": "1CO",
          "chapter": 12,
          "verse": 4
        }
      ],
      "en": "Now there are various kinds of gifts, but the same Spirit.",
      "ko": "은사는 여러 가지나 성령은 같고",
      "source_text_hash": "b7cc0cab1199033ae251d9442117f2ae2852ef1f621433357856c923364146c0",
      "translation_text_hash": "5db2ad18b74138c398d30032422d57ddc50b29f7142cb4324ff1867f86e9f5a2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "은사는 여러 가지나 성령은 같고"
      ],
      "raw_text_hashes": [
        "5db2ad18b74138c398d30032422d57ddc50b29f7142cb4324ff1867f86e9f5a2"
      ]
    },
    {
