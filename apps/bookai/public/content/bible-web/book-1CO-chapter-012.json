        "verse": 12
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 12,
          "verse": 12
        }
      ],
      "en": "For as the body is one and has many members, and all the members of the body, being many, are one body; so also is Christ.",
      "ko": "몸은 하나인데 많은 지체가 있고 몸의 지체가 많으나 한 몸임과 같이 그리스도도 그러하니라",
      "source_text_hash": "3a6c34a1d5c9a3680c28fd2a0cd37c0ea664c20e13a493a369843812546459d1",
      "translation_text_hash": "3940c179131337ef8472702fdca8f35ee2d426fbb3c00c18cd71e9f6f0b48100",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "몸은 하나인데 많은 지체가 있고 몸의 지체가 많으나 한 몸임과 같이 그리스도도 그러하니라"
      ],
      "raw_text_hashes": [
        "3940c179131337ef8472702fdca8f35ee2d426fbb3c00c18cd71e9f6f0b48100"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:12:13",
      "sequence": 28644,
      "chapter_label": "1CO 12",
      "verse_label": "13",
      "locator": {
