      "translation_text_hash": "d3eb4d70348a64eee6b760e293ad18f5834c38ca3afdfe96478711a162d501cf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "몸은 한 지체뿐 아니요 여럿이니"
      ],
      "raw_text_hashes": [
        "d3eb4d70348a64eee6b760e293ad18f5834c38ca3afdfe96478711a162d501cf"
      ]
    },
    {
