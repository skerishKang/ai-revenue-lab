        "verse": 6
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 19,
          "verse": 6
        }
      ],
      "en": "Saul listened to the voice of Jonathan; and Saul swore, “As the LORD lives, he shall not be put to death.”",
      "ko": "사울이 요나단의 말을 듣고 맹세하되 여호와께서 사시거니와 그가 죽임을 당치 아니하리라",
      "source_text_hash": "e55cb5b194cfc0ee518b5767e166aca261c0f856b1b22d8fd22741b5aa759ba6",
      "translation_text_hash": "14bf6b226840bd66d8bc0a67f28083a17057a25f05c5160865df7a23018f438b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울이 요나단의 말을 듣고 맹세하되 여호와께서 사시거니와 그가 죽임을 당치 아니하리라"
      ],
      "raw_text_hashes": [
        "14bf6b226840bd66d8bc0a67f28083a17057a25f05c5160865df7a23018f438b"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:19:7",
      "sequence": 7714,
      "chapter_label": "1SA 19",
