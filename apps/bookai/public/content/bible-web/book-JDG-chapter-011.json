      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "길르앗 장로들이 입다에게 이르되 여호와는 우리 사이의 증인이시니 당신의 말대로 우리가 반드시 행하리이다"
      ],
      "raw_text_hashes": [
