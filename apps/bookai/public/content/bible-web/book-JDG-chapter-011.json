    {
      "canonical_locator": "bible:web:JDG:11:25",
      "sequence": 6855,
      "chapter_label": "JDG 11",
      "verse_label": "25",
      "locator": {
        "book": "JDG",
        "chapter": 11,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 11,
          "verse": 25
        }
      ],
      "en": "Now are you anything better than Balak the son of Zippor, king of Moab? Did he ever strive against Israel, or did he ever fight against them?",
      "ko": "이제 네가 모압 왕 십볼의 아들 발락보다 나은 것이 있느냐 그가 이스라엘로 더불어 다툰 일이 있었느냐 싸운 일이 있었느냐",
      "source_text_hash": "c87963c4b97f96ceac73bad07c4643aecc1a9e8d9303801a30a02fa716d45bfb",
      "translation_text_hash": "3129ed6e8ea4e896a3502ba6aab8534b4ffb3caf9fc10e9e3d32434d86d41c65",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이제 네가 모압 왕 십볼의 아들 발락보다 나은 것이 있느냐 그가 이스라엘로 더불어 다툰 일이 있었느냐 싸운 일이 있었느냐"
      ],
      "raw_text_hashes": [
