          "book": "JDG",
          "chapter": 11,
          "verse": 14
        }
      ],
      "en": "Jephthah sent messengers again to the king of the children of Ammon;",
      "ko": "입다가 암몬 자손의 왕에게 다시 사자를 보내어",
      "source_text_hash": "2c54c71248cb78b42667398986cebbcb6a90cdf51f2011647d9b1c19e2ddccc0",
      "translation_text_hash": "2380a748f3786719d40e55af1248071129fb9573226111b03d205ba72a2a2d3a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "입다가 암몬 자손의 왕에게 다시 사자를 보내어"
      ],
      "raw_text_hashes": [
        "2380a748f3786719d40e55af1248071129fb9573226111b03d205ba72a2a2d3a"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:11:15",
      "sequence": 6845,
      "chapter_label": "JDG 11",
      "verse_label": "15",
      "locator": {
        "book": "JDG",
