    {
      "canonical_locator": "bible:web:JDG:11:21",
      "sequence": 6851,
      "chapter_label": "JDG 11",
      "verse_label": "21",
      "locator": {
        "book": "JDG",
        "chapter": 11,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 11,
          "verse": 21
        }
      ],
      "en": "The LORD, the God of Israel, delivered Sihon and all his people into the hand of Israel, and they struck them. So Israel possessed all the land of the Amorites, the inhabitants of that country.",
      "ko": "이스라엘의 하나님 여호와께서 시혼과 그 모든 백성을 이스라엘의 손에 붙이시매 이스라엘이 쳐서 그 땅 거민 아모리 사람의 온 땅을 취하되",
      "source_text_hash": "bf252068d5ec469978658f426ee3d39de08dece3e8d54361c6459df1762e596f",
      "translation_text_hash": "dfe38009b2768f2ca57905346c24900c99f0818ac6eb493d27ee7a9971711f3e",
      "translation_policy": "krv-1961-source-mapped",
