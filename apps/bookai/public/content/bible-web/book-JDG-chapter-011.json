      ],
      "en": "Now Jephthah the Gileadite was a mighty man of valor. He was the son of a prostitute. Gilead became the father of Jephthah.",
      "ko": "길르앗 사람 큰 용사 입다는 기생이 길르앗에게 낳은 아들이었고",
      "source_text_hash": "09aa23e03c5299bd24355ca7fb216b115ad289090da9cce291d9b49370b5a878",
      "translation_text_hash": "71b15a1e2e30a8405acf4c786db65a8e97f18f536601a9da0302d8f3d1bc497e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "길르앗 사람 큰 용사 입다는 기생이 길르앗에게 낳은 아들이었고"
      ],
      "raw_text_hashes": [
        "71b15a1e2e30a8405acf4c786db65a8e97f18f536601a9da0302d8f3d1bc497e"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:11:2",
      "sequence": 6832,
      "chapter_label": "JDG 11",
