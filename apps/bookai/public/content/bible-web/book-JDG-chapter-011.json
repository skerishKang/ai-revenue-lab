    {
      "canonical_locator": "bible:web:JDG:11:19",
      "sequence": 6849,
      "chapter_label": "JDG 11",
      "verse_label": "19",
      "locator": {
        "book": "JDG",
        "chapter": 11,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 11,
          "verse": 19
        }
      ],
      "en": "Israel sent messengers to Sihon king of the Amorites, the king of Heshbon; and Israel said to him, ‘Please let us pass through your land to my place.’",
      "ko": "이스라엘이 헤스본 왕 곧 아모리 왕 시혼에게 사자를 보내어 그에게 이르되 청컨대 우리를 용납하여 당신의 땅으로 지나 우리 곳에 이르게 하라 하였으나",
      "source_text_hash": "8ce93217994413a9c298f18983e1c011c9f17bcaf3719ef1507228ba86d29651",
      "translation_text_hash": "7c85f7edf489b94c6f6ec900bf0f109d63a984e4f4a2936dd02048b230086e27",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘이 헤스본 왕 곧 아모리 왕 시혼에게 사자를 보내어 그에게 이르되 청컨대 우리를 용납하여 당신의 땅으로 지나 우리 곳에 이르게 하라 하였으나"
      ],
      "raw_text_hashes": [
