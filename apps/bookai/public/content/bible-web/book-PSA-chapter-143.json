        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 143,
          "verse": 6
        }
      ],
      "en": "I spread out my hands to you. My soul thirsts for you, like a parched land. Selah.",
      "ko": "주를 향하여 손을 펴고 내 영혼이 마른 땅 같이 주를 사모하나이다(셀라)",
      "source_text_hash": "7cb1992243a9e4a59038d01e810bff7834219f60879d7ae22f9e6f70020cb372",
      "translation_text_hash": "9a503a1081e56100c390a681b69ffe3b63482f4b85e99f62d8993ba48b3f54f3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주를 향하여 손을 펴고 내 영혼이 마른 땅 같이 주를 사모하나이다(셀라)"
      ],
      "raw_text_hashes": [
        "9a503a1081e56100c390a681b69ffe3b63482f4b85e99f62d8993ba48b3f54f3"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:143:7",
      "sequence": 16301,
      "chapter_label": "PSA 143",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 143,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 143,
          "verse": 7
        }
      ],
      "en": "Hurry to answer me, LORD. My spirit fails. Don’t hide your face from me, so that I don’t become like those who go down into the pit.",
      "ko": "여호와여 속히 내게 응답하소서 내 영혼이 피곤하니이다 주의 얼굴을 내게서 숨기지 마소서 내가 무덤에 내려가는 자 같을까 두려워하나이다",
      "source_text_hash": "1a69db16e83ec8e288c0658b78b624633043091af4030fc08b2293793406eb75",
      "translation_text_hash": "7cc4396b476e2b2714c82e99124ce63baa649960613920cb3b94e9ef8b0acefd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 속히 내게 응답하소서 내 영혼이 피곤하니이다 주의 얼굴을 내게서 숨기지 마소서 내가 무덤에 내려가는 자 같을까 두려워하나이다"
      ],
      "raw_text_hashes": [
        "7cc4396b476e2b2714c82e99124ce63baa649960613920cb3b94e9ef8b0acefd"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:143:8",
      "sequence": 16302,
      "chapter_label": "PSA 143",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
        "chapter": 143,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 143,
          "verse": 8
        }
      ],
      "en": "Cause me to hear your loving kindness in the morning, for I trust in you. Cause me to know the way in which I should walk, for I lift up my soul to you.",
      "ko": "아침에 나로 주의 인자한 말씀을 듣게 하소서 내가 주를 의뢰함이니이다 나의 다닐 길을 알게 하소서 내가 내 영혼을 주께 받듦이니이다",
      "source_text_hash": "573af3376bde5e94fc1475499e3c95dbc86b5cfb97ab149f301f05c4e22681ae",
      "translation_text_hash": "011e93f6d12ff38eef13cdab3c6880be757949d8d6d44f863d6285b931728735",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아침에 나로 주의 인자한 말씀을 듣게 하소서 내가 주를 의뢰함이니이다 나의 다닐 길을 알게 하소서 내가 내 영혼을 주께 받듦이니이다"
      ],
      "raw_text_hashes": [
        "011e93f6d12ff38eef13cdab3c6880be757949d8d6d44f863d6285b931728735"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:143:9",
