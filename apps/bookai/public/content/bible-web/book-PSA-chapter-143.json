        {
          "book": "PSA",
          "chapter": 143,
          "verse": 5
        }
      ],
      "en": "I remember the days of old. I meditate on all your doings. I contemplate the work of your hands.",
      "ko": "내가 옛날을 기억하고 주의 모든 행하신 것을 묵상하며 주의 손의 행사를 생각하고",
      "source_text_hash": "f2829051033acebe1c742b4a1241556398c2ec8669f6f290ebd6c48e433e77b8",
      "translation_text_hash": "4cb5b33574a9b1fe7386127734b4d692cfa7c7a569fe49e6ec6e2fb5c1df04db",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 옛날을 기억하고 주의 모든 행하신 것을 묵상하며 주의 손의 행사를 생각하고"
      ],
      "raw_text_hashes": [
        "4cb5b33574a9b1fe7386127734b4d692cfa7c7a569fe49e6ec6e2fb5c1df04db"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:143:6",
      "sequence": 16300,
      "chapter_label": "PSA 143",
