      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 내 심령이 속에서 상하며 내 마음이 속에서 참담하니이다"
      ],
      "raw_text_hashes": [
        "7cc3d2c85bd57537e9c45594fc38b01a5975cb0803ea72aa9f166d871c7d4f69"
      ]
