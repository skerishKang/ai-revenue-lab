      "locator": {
        "book": "PSA",
        "chapter": 143,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 143,
          "verse": 9
        }
      ],
      "en": "Deliver me, LORD, from my enemies. I flee to you to hide me.",
      "ko": "여호와여 나를 내 원수들에게서 건지소서 내가 주께 피하여 숨었나이다",
      "source_text_hash": "3caa2ff286c9ca5a58b3d4f14491584aaf1a3dfa5d4b3f1ef8a4e8059981956e",
      "translation_text_hash": "7c6cab41d698b23b6d8fed969291c358dd179b4b47f888c819a36bdec37ef42e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나를 내 원수들에게서 건지소서 내가 주께 피하여 숨었나이다"
      ],
      "raw_text_hashes": [
        "7c6cab41d698b23b6d8fed969291c358dd179b4b47f888c819a36bdec37ef42e"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:143:10",
      "sequence": 16304,
      "chapter_label": "PSA 143",
      "verse_label": "10",
      "locator": {
