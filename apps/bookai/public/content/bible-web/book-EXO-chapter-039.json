    {
      "canonical_locator": "bible:web:EXO:39:14",
      "sequence": 2679,
      "chapter_label": "EXO 39",
      "verse_label": "14",
      "locator": {
        "book": "EXO",
        "chapter": 39,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 39,
          "verse": 14
        }
      ],
      "en": "The stones were according to the names of the children of Israel, twelve, according to their names; like the engravings of a signet, everyone according to his name, for the twelve tribes.",
      "ko": "이 보석들은 이스라엘 아들들의 이름 곧 그들의 이름대로 열 둘이라 인을 새김 같이 그 열 두 지파의 각 이름을 새겼으며",
      "source_text_hash": "6421e3480a732b4c8c3ad26a1ded28dd016490ece6710e6af54e606e5aac8a90",
      "translation_text_hash": "2e3b06169e883d916109a625cfb77866be10f70f52d3b38cc60bf075562b7650",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 보석들은 이스라엘 아들들의 이름 곧 그들의 이름대로 열 둘이라 인을 새김 같이 그 열 두 지파의 각 이름을 새겼으며"
