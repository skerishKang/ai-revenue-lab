      ],
      "en": "The Spirit of God came on Azariah the son of Oded.",
      "ko": "하나님의 신이 오뎃의 아들 아사랴에게 임하시매",
      "source_text_hash": "9f269f1b3c77f560a7b44c78be50c05800db6cfce23588720325d5b99a678353",
      "translation_text_hash": "43c88ad6ee125774871d52278edf3035269db2b2fae85cf82be72f2a0dc8a83f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님의 신이 오뎃의 아들 아사랴에게 임하시매"
      ],
      "raw_text_hashes": [
        "43c88ad6ee125774871d52278edf3035269db2b2fae85cf82be72f2a0dc8a83f"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:15:2",
      "sequence": 11493,
      "chapter_label": "2CH 15",
