        "verse": 12
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 15,
          "verse": 12
        }
      ],
      "en": "They entered into the covenant to seek the LORD, the God of their fathers, with all their heart and with all their soul;",
      "ko": "또 마음을 다하고 성품을 다하여 열조의 하나님 여호와를 찾기로 언약하고",
      "source_text_hash": "8040ceaeb38fbb33cf591c6162418ba788c8834b9b8459d34f7f3d46d62096cc",
      "translation_text_hash": "7813d9a9763088a20ca9ba616318d9f951da28939f8a327c2392469bcd2fc5b0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 마음을 다하고 성품을 다하여 열조의 하나님 여호와를 찾기로 언약하고"
      ],
      "raw_text_hashes": [
        "7813d9a9763088a20ca9ba616318d9f951da28939f8a327c2392469bcd2fc5b0"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:15:13",
      "sequence": 11504,
      "chapter_label": "2CH 15",
      "verse_label": "13",
      "locator": {
        "book": "2CH",
        "chapter": 15,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 15,
          "verse": 13
        }
      ],
      "en": "and that whoever would not seek the LORD, the God of Israel, should be put to death, whether small or great, whether man or woman.",
      "ko": "무릇 이스라엘 하나님 여호와를 찾지 아니하는 자는 대소 남녀를 무론하고 죽이는 것이 마땅하다 하고",
      "source_text_hash": "837040ec570c8e3073963a4ece7311666da63e10f273f1e46758f44dd653b3b5",
      "translation_text_hash": "ee0aaa0589a2bfe884a24f77139cd60030b5e3bc60e9d3f62944bdd09b6cd012",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
