        "verse": 5
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 5
        }
      ],
      "en": "I knew you in the wilderness, in the land of great drought.",
      "ko": "내가 광야 마른 땅에서 너를 권고하였거늘",
      "source_text_hash": "7f762b99e2558833c3414a7a1122fa74d6eb0f304d90205f1b1cee70fa6a5861",
      "translation_text_hash": "21f295e2bc9b3345f301809fa57710f4bcc594b1a3f37a416a46cc8c255a7dd7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 광야 마른 땅에서 너를 권고하였거늘"
      ],
      "raw_text_hashes": [
        "21f295e2bc9b3345f301809fa57710f4bcc594b1a3f37a416a46cc8c255a7dd7"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:13:6",
      "sequence": 22273,
      "chapter_label": "HOS 13",
      "verse_label": "6",
      "locator": {
        "book": "HOS",
