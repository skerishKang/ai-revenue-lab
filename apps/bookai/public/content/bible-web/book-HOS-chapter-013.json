        "verse": 11
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 11
        }
      ],
      "en": "I have given you a king in my anger, and have taken him away in my wrath.",
      "ko": "내가 분노하므로 네게 왕을 주고 진노하므로 폐하였노라",
      "source_text_hash": "c50679626b12239723fc7cf5c70eeb74037b6c8adb7a983a978788785e019077",
      "translation_text_hash": "9f76da5fa40e466e72292263117ebfb9c4335e8f7c8ffd1d3a002f019e0a2131",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 분노하므로 네게 왕을 주고 진노하므로 폐하였노라"
      ],
      "raw_text_hashes": [
        "9f76da5fa40e466e72292263117ebfb9c4335e8f7c8ffd1d3a002f019e0a2131"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:13:12",
      "sequence": 22279,
      "chapter_label": "HOS 13",
      "verse_label": "12",
      "locator": {
        "book": "HOS",
        "chapter": 13,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 12
        }
      ],
      "en": "The guilt of Ephraim is stored up. His sin is stored up.",
      "ko": "에브라임의 불의가 봉함되었고 그 죄가 저장되었나니",
      "source_text_hash": "c16b0f9b5a294511e9f574bb8124381afc8fe00e7d0399b16845fad89a1812ff",
      "translation_text_hash": "b7c3a8ece144f9dfe1daca15756781c3aa89f9300095aeb655fce2ec9a2ea26d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에브라임의 불의가 봉함되었고 그 죄가 저장되었나니"
      ],
      "raw_text_hashes": [
        "b7c3a8ece144f9dfe1daca15756781c3aa89f9300095aeb655fce2ec9a2ea26d"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:13:13",
      "sequence": 22280,
      "chapter_label": "HOS 13",
      "verse_label": "13",
      "locator": {
        "book": "HOS",
        "chapter": 13,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 13
        }
      ],
      "en": "The sorrows of a travailing woman will come on him. He is an unwise son, for when it is time, he doesn’t come to the opening of the womb.",
      "ko": "해산하는 여인의 어려움이 저에게 임하리라 저는 어리석은 자식이로다 때가 임하였나니 산문에서 지체할 것이 아니니라",
      "source_text_hash": "94c89112d7cd75ffbdf577e0bb8eb033e16feea7b9a2267e9570ac2e13a599d1",
      "translation_text_hash": "3cf3f8dce4bc5dc7cbd6f09844412d1d5000ff9b0a25b4a60020360ca9b598d6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "해산하는 여인의 어려움이 저에게 임하리라 저는 어리석은 자식이로다 때가 임하였나니 산문에서 지체할 것이 아니니라"
      ],
      "raw_text_hashes": [
        "3cf3f8dce4bc5dc7cbd6f09844412d1d5000ff9b0a25b4a60020360ca9b598d6"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:13:14",
      "sequence": 22281,
      "chapter_label": "HOS 13",
      "verse_label": "14",
      "locator": {
        "book": "HOS",
        "chapter": 13,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 14
        }
      ],
      "en": "I will ransom them from the power of Sheol. I will redeem them from death! Death, where are your plagues? Sheol, where is your destruction? “Compassion will be hidden from my eyes.",
