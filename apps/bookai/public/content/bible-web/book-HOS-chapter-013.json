        "verse": 7
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 7
        }
      ],
      "en": "Therefore I am like a lion to them. Like a leopard, I will lurk by the path.",
      "ko": "그러므로 내가 저희에게 사자 같고 길 가에서 기다리는 표범 같으니라",
      "source_text_hash": "492161f7038458c11595031c1083b39622790d6f06dd84b60bf360ba45dbee3a",
      "translation_text_hash": "a5f6de617c8941aec977c0efc778b538977ac3a24ae6dce75b1c4fbba940d6cd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 내가 저희에게 사자 같고 길 가에서 기다리는 표범 같으니라"
      ],
      "raw_text_hashes": [
        "a5f6de617c8941aec977c0efc778b538977ac3a24ae6dce75b1c4fbba940d6cd"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:13:8",
      "sequence": 22275,
      "chapter_label": "HOS 13",
      "verse_label": "8",
      "locator": {
        "book": "HOS",
        "chapter": 13,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 8
        }
      ],
      "en": "I will meet them like a bear that is bereaved of her cubs, and will tear the covering of their heart. There I will devour them like a lioness. The wild animal will tear them.",
      "ko": "내가 새끼 잃은 곰 같이 저희를 만나 그 염통 꺼풀을 찢고 거기서 암사자 같이 저희를 삼키리라 들짐승이 저희를 찢으리라",
      "source_text_hash": "ec3792d740d9ca6a3cf9a88d59922b0a41919eb7b99ddeaf7639669e1b890aba",
      "translation_text_hash": "5d864569ce469c1c61265fd6890743943e3df8fa1421fa205405bc9524701f55",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 새끼 잃은 곰 같이 저희를 만나 그 염통 꺼풀을 찢고 거기서 암사자 같이 저희를 삼키리라 들짐승이 저희를 찢으리라"
      ],
      "raw_text_hashes": [
        "5d864569ce469c1c61265fd6890743943e3df8fa1421fa205405bc9524701f55"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:13:9",
      "sequence": 22276,
