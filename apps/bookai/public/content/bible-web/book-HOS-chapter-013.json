        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 13,
          "verse": 6
        }
      ],
      "en": "According to their pasture, so were they filled; they were filled, and their heart was exalted. Therefore they have forgotten me.",
      "ko": "저희가 먹이운대로 배부르며 배부름으로 마음이 교만하며 이로 인하여 나를 잊었느니라",
      "source_text_hash": "78b14fe6e78115ba95768343c264b6680d3e699c30beba34bce404c83c2daf7d",
      "translation_text_hash": "0b47a2331bf379e8eea2f9b6f3fb07cf677b27f28d2bddd420dd5db818e06649",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 먹이운대로 배부르며 배부름으로 마음이 교만하며 이로 인하여 나를 잊었느니라"
      ],
      "raw_text_hashes": [
        "0b47a2331bf379e8eea2f9b6f3fb07cf677b27f28d2bddd420dd5db818e06649"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:13:7",
      "sequence": 22274,
      "chapter_label": "HOS 13",
      "verse_label": "7",
      "locator": {
