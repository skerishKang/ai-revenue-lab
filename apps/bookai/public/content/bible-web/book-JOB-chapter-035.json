      "translation_text_hash": "b3a0ae7ae1e86bb174faee487a02103735459c2f593631e4971eb54c80840575",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이르기를 유익이 무엇인고 범죄한 것보다 내게 이익이 무엇인고 하는구나"
      ],
      "raw_text_hashes": [
        "b3a0ae7ae1e86bb174faee487a02103735459c2f593631e4971eb54c80840575"
      ]
    },
