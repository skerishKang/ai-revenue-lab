    {
      "canonical_locator": "bible:web:EXO:19:13",
      "sequence": 2040,
      "chapter_label": "EXO 19",
      "verse_label": "13",
      "locator": {
        "book": "EXO",
        "chapter": 19,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 19,
          "verse": 13
        }
      ],
      "en": "No hand shall touch him, but he shall surely be stoned or shot through; whether it is animal or man, he shall not live.’ When the trumpet sounds long, they shall come up to the mountain.”",
      "ko": "손을 그에게 댐이 없이 그런 자는 돌에 맞아 죽임을 당하거나 살에 쐬어 죽임을 당하리니 짐승이나 사람을 무론하고 살지 못하리라 나팔을 길게 불거든 산 앞에 이를 것이니라 하라",
      "source_text_hash": "58ccec060a8d896a16a1c3986ca591e32ab8072730668de98a9899280c537d0d",
      "translation_text_hash": "dd6bc9ae6e6a9c5cf1fab9d4a3f5004b2bdf44ee1f1a59303e920f5dc4b9cd54",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
