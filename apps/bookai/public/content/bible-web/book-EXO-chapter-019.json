        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 19,
          "verse": 8
        }
      ],
      "en": "All the people answered together, and said, “All that the LORD has spoken we will do.” Moses reported the words of the people to the LORD.",
      "ko": "백성이 일제히 응답하여 가로되 여호와의 명하신대로 우리가 다 행하리이다 모세가 백성의 말로 여호와께 회보하매",
      "source_text_hash": "e1f1ec3c7e2036fefb1e765ff27eed96537b9f19260f43b437d90664e6563106",
      "translation_text_hash": "3f15f04c33f19907d81fc084a3d690c06dc5860a4761a246ab6585a01a86a099",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "백성이 일제히 응답하여 가로되 여호와의 명하신대로 우리가 다 행하리이다 모세가 백성의 말로 여호와께 회보하매"
      ],
      "raw_text_hashes": [
        "3f15f04c33f19907d81fc084a3d690c06dc5860a4761a246ab6585a01a86a099"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:19:9",
      "sequence": 2036,
      "chapter_label": "EXO 19",
      "verse_label": "9",
      "locator": {
