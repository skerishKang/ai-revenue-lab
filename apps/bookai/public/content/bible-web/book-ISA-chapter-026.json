        "verse": 6
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 6
        }
      ],
      "en": "The foot shall tread it down, even the feet of the poor and the steps of the needy.”",
      "ko": "발이 그것을 밟으리니 곧 빈궁한 자의 발과 곤핍한 자의 걸음이리로다",
      "source_text_hash": "1eb8cc6dd3f3fd7de44cc76d0bdd103ab9934c63e2a4fbe91161231996509ee4",
      "translation_text_hash": "2f41b3536bc8039827e89d16eb361ec3752aeecd1fe0e885f03d4cebaad02758",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "발이 그것을 밟으리니 곧 빈궁한 자의 발과 곤핍한 자의 걸음이리로다"
      ],
      "raw_text_hashes": [
        "2f41b3536bc8039827e89d16eb361ec3752aeecd1fe0e885f03d4cebaad02758"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:7",
      "sequence": 18138,
      "chapter_label": "ISA 26",
      "verse_label": "7",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 7
        }
      ],
      "en": "The way of the just is uprightness. You who are upright make the path of the righteous level.",
      "ko": "의인의 길은 정직함이여 정직하신 주께서 의인의 첩경을 평탄케 하시도다",
      "source_text_hash": "ea39ea00f3d600fa5d9e789894206e2f876fa605f44fd449c5c7b201cc3bf6f7",
      "translation_text_hash": "9b1d5540b12e70dfeba7a9f651b9ff65b72ee697e545359a47c8a42df1d1e183",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "의인의 길은 정직함이여 정직하신 주께서 의인의 첩경을 평탄케 하시도다"
      ],
      "raw_text_hashes": [
        "9b1d5540b12e70dfeba7a9f651b9ff65b72ee697e545359a47c8a42df1d1e183"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:8",
      "sequence": 18139,
      "chapter_label": "ISA 26",
      "verse_label": "8",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 8
        }
      ],
      "en": "Yes, in the way of your judgments, LORD, we have waited for you. Your name and your renown are the desire of our soul.",
      "ko": "여호와여 주의 심판하시는 길에서 우리가 주를 기다렸사오며 주의 이름 곧 주의 기념 이름을 우리 영혼이 사모하나이다",
      "source_text_hash": "3762467cf4847486472b205e361e31026ff0ac106203d460011e0d5e5b10dec2",
      "translation_text_hash": "d4e612002a9cc8e7a289e7d3ee6ab6fb6f4b663e037265bf61a654ae5e96d4a0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주의 심판하시는 길에서 우리가 주를 기다렸사오며 주의 이름 곧 주의 기념 이름을 우리 영혼이 사모하나이다"
      ],
      "raw_text_hashes": [
        "d4e612002a9cc8e7a289e7d3ee6ab6fb6f4b663e037265bf61a654ae5e96d4a0"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:9",
      "sequence": 18140,
      "chapter_label": "ISA 26",
      "verse_label": "9",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 9
        }
      ],
      "en": "With my soul I have desired you in the night. Yes, with my spirit within me I will seek you earnestly; for when your judgments are on the earth, the inhabitants of the world learn righteousness.",
      "ko": "밤에 내 영혼이 주를 사모하였사온즉 내 중심이 주를 간절히 구하오리니 이는 주께서 땅에서 심판하시는 때에 세계의 거민이 의를 배움이니이다",
      "source_text_hash": "84be11b9db3873424313e51dbbfe5ad077e37b24931344e205216e8b29309025",
      "translation_text_hash": "1aa553afde372ceb47e4c4f7c9a5c4d6f2ba523b489104dddcbcab8d97d3d380",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "밤에 내 영혼이 주를 사모하였사온즉 내 중심이 주를 간절히 구하오리니 이는 주께서 땅에서 심판하시는 때에 세계의 거민이 의를 배움이니이다"
      ],
      "raw_text_hashes": [
        "1aa553afde372ceb47e4c4f7c9a5c4d6f2ba523b489104dddcbcab8d97d3d380"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:10",
      "sequence": 18141,
      "chapter_label": "ISA 26",
      "verse_label": "10",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 10
        }
      ],
      "en": "Let favor be shown to the wicked, yet he will not learn righteousness. In the land of uprightness he will deal wrongfully, and will not see the LORD’s majesty.",
      "ko": "악인은 은총을 입을찌라도 의를 배우지 아니하며 정직한 땅에서 불의를 행하고 여호와의 위엄을 돌아보지 아니하는도다",
      "source_text_hash": "3e72d32a9e38605d166bc6243fb286ca5d87adf0eb71f88170efe83e5a5c9315",
      "translation_text_hash": "cd2fe2195aea423a8f8740287501a7b86fd249ba2635fbe5e2bd3ac81084e331",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악인은 은총을 입을찌라도 의를 배우지 아니하며 정직한 땅에서 불의를 행하고 여호와의 위엄을 돌아보지 아니하는도다"
      ],
      "raw_text_hashes": [
        "cd2fe2195aea423a8f8740287501a7b86fd249ba2635fbe5e2bd3ac81084e331"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:11",
      "sequence": 18142,
      "chapter_label": "ISA 26",
      "verse_label": "11",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 11
        }
      ],
      "en": "LORD, your hand is lifted up, yet they don’t see; but they will see your zeal for the people and be disappointed. Yes, fire will consume your adversaries.",
      "ko": "여호와여 주의 손이 높이 들릴찌라도 그들이 보지 아니하나이다마는 백성을 위하시는 주의 열성을 보면 부끄러워할 것이라 불이 주의 대적을 사르리이다",
      "source_text_hash": "ff301beca19fb10900488b92ddbfcf20a187ee585bc9ccc2f49dee0a2c67e83c",
      "translation_text_hash": "554e60842f23acfdd020ea817381433ff1eae7eb8327ff02f4490741c14d6c02",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주의 손이 높이 들릴찌라도 그들이 보지 아니하나이다마는 백성을 위하시는 주의 열성을 보면 부끄러워할 것이라 불이 주의 대적을 사르리이다"
      ],
      "raw_text_hashes": [
        "554e60842f23acfdd020ea817381433ff1eae7eb8327ff02f4490741c14d6c02"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:12",
      "sequence": 18143,
      "chapter_label": "ISA 26",
      "verse_label": "12",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 12
        }
      ],
      "en": "LORD, you will ordain peace for us, for you have also done all our work for us.",
      "ko": "여호와여 주께서 우리를 위하여 평강을 베푸시오리니 주께서 우리 모든 일을 우리를 위하여 이루심이니이다",
      "source_text_hash": "c6bd991057fd22603bac753e435ca84ba9e88e5e50cdb5187aa825952b39e604",
      "translation_text_hash": "eb196b1f9b0136db4f6cadd6a1e0befde71ba6ea41a85eed3c5d0d3657d22a97",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주께서 우리를 위하여 평강을 베푸시오리니 주께서 우리 모든 일을 우리를 위하여 이루심이니이다"
      ],
      "raw_text_hashes": [
        "eb196b1f9b0136db4f6cadd6a1e0befde71ba6ea41a85eed3c5d0d3657d22a97"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:13",
      "sequence": 18144,
      "chapter_label": "ISA 26",
      "verse_label": "13",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 13
        }
      ],
      "en": "LORD our God, other lords besides you have had dominion over us, but we will only acknowledge your name.",
      "ko": "여호와 우리 하나님이시여 주 외에 다른 주들이 우리를 관할하였사오나 우리가 주만 의뢰하고 주의 이름을 부르리이다",
      "source_text_hash": "5854cfdc5228982127ed5defce4808f80c530114ea60c08c9fa70bb23d507e4b",
      "translation_text_hash": "5698c9add4a1513c0f01c6c2736c7e571a3583be32d9bae2afc77278b3c05b69",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와 우리 하나님이시여 주 외에 다른 주들이 우리를 관할하였사오나 우리가 주만 의뢰하고 주의 이름을 부르리이다"
      ],
      "raw_text_hashes": [
        "5698c9add4a1513c0f01c6c2736c7e571a3583be32d9bae2afc77278b3c05b69"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:14",
      "sequence": 18145,
      "chapter_label": "ISA 26",
      "verse_label": "14",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 14
        }
      ],
      "en": "The dead shall not live. The departed spirits shall not rise. Therefore you have visited and destroyed them, and caused all memory of them to perish.",
      "ko": "그들은 죽었은즉 다시 살지 못하겠고 사망하였은즉 일어나지 못할 것이니 이는 주께서 벌하여 멸하사 그 모든 기억을 멸절하셨음이니이다",
      "source_text_hash": "51439920101c4c8751c32ed41fb30ee7ca9d0d1e378d4b4463153019a7ffdcfb",
      "translation_text_hash": "606c7ac535498d928adbea25da5161ac55b3f8726c8fcee68e4825a2a5f9def6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들은 죽었은즉 다시 살지 못하겠고 사망하였은즉 일어나지 못할 것이니 이는 주께서 벌하여 멸하사 그 모든 기억을 멸절하셨음이니이다"
      ],
      "raw_text_hashes": [
        "606c7ac535498d928adbea25da5161ac55b3f8726c8fcee68e4825a2a5f9def6"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:15",
      "sequence": 18146,
      "chapter_label": "ISA 26",
      "verse_label": "15",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 15
        }
      ],
      "en": "You have increased the nation, O LORD. You have increased the nation! You are glorified! You have enlarged all the borders of the land.",
      "ko": "여호와여 주께서 이 나라를 더 크게 하셨고 이 나라를 더 크게 하셨나이다 스스로 영광을 얻으시고 이 땅의 모든 경계를 확장하셨나이다",
      "source_text_hash": "bddf75fa17fb08626b3a7d5a6c9f60772ba24448b7e29d222e9c3aab5346e0b0",
      "translation_text_hash": "0355e36d36e725e8ed09f4bc8fabd93b2494207178ca224c817e7291d9c9f78f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주께서 이 나라를 더 크게 하셨고 이 나라를 더 크게 하셨나이다 스스로 영광을 얻으시고 이 땅의 모든 경계를 확장하셨나이다"
      ],
      "raw_text_hashes": [
        "0355e36d36e725e8ed09f4bc8fabd93b2494207178ca224c817e7291d9c9f78f"
