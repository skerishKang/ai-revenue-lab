        "verse": 17
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 17
        }
      ],
      "en": "Just as a woman with child, who draws near the time of her delivery, is in pain and cries out in her pangs, so we have been before you, LORD.",
      "ko": "여호와여 잉태한 여인이 산기가 임박하여 구로하며 부르짖음 같이 우리가 주의 앞에 이러하니이다",
      "source_text_hash": "4ba5b10b83c7605b9c9e50eed0ee19180d4cd9413c2203f57dabe26132f870e3",
      "translation_text_hash": "2a9bd56fe2d58707fb3332a653bd98845f2dd77595d2d53b86105fc67fb5187e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 잉태한 여인이 산기가 임박하여 구로하며 부르짖음 같이 우리가 주의 앞에 이러하니이다"
      ],
      "raw_text_hashes": [
        "2a9bd56fe2d58707fb3332a653bd98845f2dd77595d2d53b86105fc67fb5187e"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:18",
      "sequence": 18149,
      "chapter_label": "ISA 26",
      "verse_label": "18",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 18
        }
      ],
      "en": "We have been with child. We have been in pain. We gave birth, it seems, only to wind. We have not worked any deliverance on the earth; neither have the inhabitants of the world fallen.",
      "ko": "우리가 잉태하고 고통하였을찌라도 낳은 것은 바람 같아서 땅에 구원을 베풀지 못하였고 세계의 거민을 생산치 못하였나이다",
      "source_text_hash": "cb0230985aff35c3aae75e871c7c1a2af32ec6b847ab7cd530bebf779218c58c",
      "translation_text_hash": "118e8664511eae72b2bd68dfdfbbec64731561e67263e9b7b0c8fe0be9739b39",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 잉태하고 고통하였을찌라도 낳은 것은 바람 같아서 땅에 구원을 베풀지 못하였고 세계의 거민을 생산치 못하였나이다"
      ],
      "raw_text_hashes": [
        "118e8664511eae72b2bd68dfdfbbec64731561e67263e9b7b0c8fe0be9739b39"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:19",
      "sequence": 18150,
      "chapter_label": "ISA 26",
      "verse_label": "19",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 19
        }
      ],
      "en": "Your dead shall live. Their dead bodies shall arise. Awake and sing, you who dwell in the dust; for your dew is like the dew of herbs, and the earth will cast out the departed spirits.",
      "ko": "주의 죽은 자들은 살아나고 우리의 시체들은 일어나리이다 티끌에 거하는 자들아 너희는 깨어 노래하라 주의 이슬은 빛난 이슬이니 땅이 죽은 자를 내어 놓으리로다",
      "source_text_hash": "c271111bece11390161172141ef2052bdfdb297295266cd5b7889a14c7e625be",
      "translation_text_hash": "a86d7d4fa49df2ae8b53c7a5cf212ec75e983cb94048f4a8b3d3bf7c0b4a6ff8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 죽은 자들은 살아나고 우리의 시체들은 일어나리이다 티끌에 거하는 자들아 너희는 깨어 노래하라 주의 이슬은 빛난 이슬이니 땅이 죽은 자를 내어 놓으리로다"
      ],
      "raw_text_hashes": [
        "a86d7d4fa49df2ae8b53c7a5cf212ec75e983cb94048f4a8b3d3bf7c0b4a6ff8"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:20",
      "sequence": 18151,
      "chapter_label": "ISA 26",
      "verse_label": "20",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 20
        }
      ],
      "en": "Come, my people, enter into your rooms, and shut your doors behind you. Hide yourself for a little moment, until the indignation is past.",
      "ko": "내 백성아 갈찌어다 네 밀실에 들어가서 네 문을 닫고 분노가 지나기까지 잠간 숨을찌어다",
      "source_text_hash": "b6f29a5594eb4d0862acab1e0db4fb04f78a2a66c5e7d1278c1195e29d77549f",
      "translation_text_hash": "5b9cf4944354397c2b185c1accffdcc62c38ecc5ea8535a0e961ee613c68c791",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 백성아 갈찌어다 네 밀실에 들어가서 네 문을 닫고 분노가 지나기까지 잠간 숨을찌어다"
      ],
      "raw_text_hashes": [
        "5b9cf4944354397c2b185c1accffdcc62c38ecc5ea8535a0e961ee613c68c791"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:26:21",
      "sequence": 18152,
      "chapter_label": "ISA 26",
      "verse_label": "21",
      "locator": {
        "book": "ISA",
        "chapter": 26,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 26,
          "verse": 21
        }
      ],
      "en": "For, behold, the LORD comes out of his place to punish the inhabitants of the earth for their iniquity. The earth also will disclose her blood, and will no longer cover her slain.",
      "ko": "보라 여호와께서 그 처소에서 나오사 땅의 거민의 죄악을 벌하실 것이라 땅이 그 위에 잦았던 피를 드러내고 그 살해 당한 자를 다시는 가리우지 아니하리라",
      "source_text_hash": "86115f920411856bb97a85c11916ce93a6ffa3cb85d28f71533ae18e75b293f4",
      "translation_text_hash": "5ff19996ddd34defd24d430b7654bd35676cda5cbdf0587914f3af207fd63804",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 여호와께서 그 처소에서 나오사 땅의 거민의 죄악을 벌하실 것이라 땅이 그 위에 잦았던 피를 드러내고 그 살해 당한 자를 다시는 가리우지 아니하리라"
      ],
