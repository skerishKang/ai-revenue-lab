      ]
    },
    {
      "canonical_locator": "bible:web:ACT:27:13",
      "sequence": 27865,
      "chapter_label": "ACT 27",
      "verse_label": "13",
      "locator": {
        "book": "ACT",
        "chapter": 27,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 27,
          "verse": 13
        }
      ],
      "en": "When the south wind blew softly, supposing that they had obtained their purpose, they weighed anchor and sailed along Crete, close to shore.",
      "ko": "남풍이 순하게 불매 저희가 득의한줄 알고 닻을 감아 그레데 해변을 가까이 하고 행선하더니",
      "source_text_hash": "9afaa44c04a8f0191544138707e9706bbff3e3c7ece317f46f43754c800c5522",
      "translation_text_hash": "0da69348edc7359e9aae0e9b77cfc37b8008bc454472969fff2f0de7b23f78d9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "남풍이 순하게 불매 저희가 득의한줄 알고 닻을 감아 그레데 해변을 가까이 하고 행선하더니"
      ],
      "raw_text_hashes": [
        "0da69348edc7359e9aae0e9b77cfc37b8008bc454472969fff2f0de7b23f78d9"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:27:14",
