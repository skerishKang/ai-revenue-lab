      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "끌어 올리고 줄을 가지고 선체를 둘러 감고 스르디스에 걸릴까 두려워 연장을 내리고 그냥 쫓겨가더니"
      ],
      "raw_text_hashes": [
