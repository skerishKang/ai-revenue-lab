        "verse": 6
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 27,
          "verse": 6
        }
      ],
      "en": "There the centurion found a ship of Alexandria sailing for Italy, and he put us on board.",
      "ko": "거기서 백부장이 이달리야로 가려하는 알렉산드리아 배를 만나 우리를 오르게 하니",
      "source_text_hash": "1b6d49da0ede574003e92454eb61dd390360ec4407a2e43f6795cc484f40f0eb",
      "translation_text_hash": "8c61696472edee072986167a4b262b0490159d20064248888360f8613d3098f4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "거기서 백부장이 이달리야로 가려하는 알렉산드리아 배를 만나 우리를 오르게 하니"
      ],
      "raw_text_hashes": [
        "8c61696472edee072986167a4b262b0490159d20064248888360f8613d3098f4"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:27:7",
      "sequence": 27859,
      "chapter_label": "ACT 27",
      "verse_label": "7",
      "locator": {
        "book": "ACT",
