        {
          "book": "ACT",
          "chapter": 27,
          "verse": 5
        }
      ],
      "en": "When we had sailed across the sea which is off Cilicia and Pamphylia, we came to Myra, a city of Lycia.",
      "ko": "길리기아와 밤빌리아 바다를 건너 루기아의 무라성에 이르러",
      "source_text_hash": "8f82932bb0e36c7faba6323a206faba07394f943503baeeafbc64a16c3d1d5e8",
      "translation_text_hash": "7114d0fcaf368be9c1630d5b92cf5e0ae23450989d0ec224fe5155467ff77399",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "길리기아와 밤빌리아 바다를 건너 루기아의 무라성에 이르러"
      ],
      "raw_text_hashes": [
        "7114d0fcaf368be9c1630d5b92cf5e0ae23450989d0ec224fe5155467ff77399"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:27:6",
      "sequence": 27858,
      "chapter_label": "ACT 27",
      "verse_label": "6",
      "locator": {
        "book": "ACT",
