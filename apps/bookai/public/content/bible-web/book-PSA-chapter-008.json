      "source_text_hash": "a8522ff9e185654995a48267de225656d25503439cf9e2a6ec3a3016f4284127",
      "translation_text_hash": "6098367d4fa58883f29e40bd731edc039281401d92993992e312246c89a4dee3",
      "translation_policy": "krv-1961-source-mapped",
