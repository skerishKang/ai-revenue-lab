      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 다 모든 사람으로 배우게 하고 모든 사람으로 권면을 받게 하기 위하여 하나씩 하나씩 예언할 수 있느니라"
      ],
      "raw_text_hashes": [
        "bb8c057243fb46e80c79bddee921eb28bab4e3535a955bdad9d4868d74254ff1"
