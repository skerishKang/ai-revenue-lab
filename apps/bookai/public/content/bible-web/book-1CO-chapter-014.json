      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너희 모든 사람보다 방언을 더 말하므로 하나님께 감사하노라"
      ],
      "raw_text_hashes": [
        "9b59e4465bdbd28fb069fa340e28dfb0021d33ce20e27275fde97689274de108"
