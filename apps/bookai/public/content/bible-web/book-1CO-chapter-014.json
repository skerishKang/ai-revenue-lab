      "raw_texts": [
        "하나님은 어지러움의 하나님이 아니시요 오직 화평의 하나님이시니라"
      ],
      "raw_text_hashes": [
        "fc97e5849578a026fef276f2e633581c8f4b7d5afe920ba996155f8fe76d7ece"
      ]
    },
    {
