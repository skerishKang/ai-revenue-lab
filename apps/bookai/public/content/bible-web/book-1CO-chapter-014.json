      "sequence": 28700,
      "chapter_label": "1CO 14",
      "verse_label": "25",
      "locator": {
        "book": "1CO",
        "chapter": 14,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 14,
          "verse": 25
        }
