      ],
      "en": "Then the word of the LORD of Armies came to me, saying,",
      "ko": "만군의 여호와의 말씀이 내게 임하여 이르시되",
      "source_text_hash": "28fd16955fd39d4fbbafd71c0b22d82ed2bf3122aa4483f47c6d68721d228915",
      "translation_text_hash": "721706a954be51c9a3dcfde8c52873896ac880988937f461a02f74b4aa93c9ac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만군의 여호와의 말씀이 내게 임하여 이르시되"
      ],
      "raw_text_hashes": [
        "721706a954be51c9a3dcfde8c52873896ac880988937f461a02f74b4aa93c9ac"
      ]
    },
    {
      "canonical_locator": "bible:web:ZEC:7:5",
      "sequence": 22968,
      "chapter_label": "ZEC 7",
