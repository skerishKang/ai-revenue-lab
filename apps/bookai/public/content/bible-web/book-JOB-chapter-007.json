      "translation_text_hash": "818119cb2a19630f219300f76b602b0aa1d24a13b67108fd369df78c4bafe52f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
