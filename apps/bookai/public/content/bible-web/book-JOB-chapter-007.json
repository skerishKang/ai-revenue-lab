      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "세상에 있는 인생에게 전쟁이 있지 아니하냐 그 날이 품군의 날과 같지 아니하냐"
      ],
      "raw_text_hashes": [
        "db0a390b7f8e4e730b058ec9ed63ba77c8d765884a49356ca4e4d8b11d6095d7"
      ]
