      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 궁핍하므로 말하는 것이 아니라 어떠한 형편에든지 내가 자족하기를 배웠노니"
      ],
      "raw_text_hashes": [
