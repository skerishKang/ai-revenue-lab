      "en": "Let your gentleness be known to all men. The Lord is at hand.",
      "ko": "너희 관용을 모든 사람에게 알게 하라 주께서 가까우시니라",
      "source_text_hash": "af68634b7a4639cef88247f2a4f77c5b44279fcbc53598c32664b84366f1b28e",
      "translation_text_hash": "5b7a5da8871934f6a35b9f8cabcd8aa4df604a5ec1c3af7e8ec4e7cf3cf9173a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 관용을 모든 사람에게 알게 하라 주께서 가까우시니라"
      ],
      "raw_text_hashes": [
        "5b7a5da8871934f6a35b9f8cabcd8aa4df604a5ec1c3af7e8ec4e7cf3cf9173a"
