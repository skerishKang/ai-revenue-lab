      "raw_locator": [
        {
          "book": "PHP",
          "chapter": 4,
          "verse": 7
        }
      ],
      "en": "And the peace of God, which surpasses all understanding, will guard your hearts and your thoughts in Christ Jesus.",
      "ko": "그리하면 모든 지각에 뛰어난 하나님의 평강이 그리스도 예수 안에서 너희 마음과 생각을 지키시리라",
      "source_text_hash": "79c16acc1aa522aa57af15b82be95c441e5b4edf80954e09d9bbf32fc26360f7",
      "translation_text_hash": "de644c61660bd78adaa84d31eb4dc89e581b76a5565b997aae983b2a0b02f1f5",
      "translation_policy": "krv-1961-source-mapped",
