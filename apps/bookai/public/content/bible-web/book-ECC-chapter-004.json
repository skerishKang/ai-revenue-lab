        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ECC",
          "chapter": 4,
          "verse": 12
        }
      ],
      "en": "If a man prevails against one who is alone, two shall withstand him; and a threefold cord is not quickly broken.",
      "ko": "한 사람이면 패하겠거니와 두 사람이면 능히 당하나니 삼겹 줄은 쉽게 끊어지지 아니하느니라",
      "source_text_hash": "bf043724c46302b07608a6c9e2db3fe5038fc244063527196e707a7dbfcffe0f",
      "translation_text_hash": "187ec907ef1cd33ecd49088d8fa26fdd93dbc3838d333808f8aae32e5b6008e9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한 사람이면 패하겠거니와 두 사람이면 능히 당하나니 삼겹 줄은 쉽게 끊어지지 아니하느니라"
      ],
      "raw_text_hashes": [
        "187ec907ef1cd33ecd49088d8fa26fdd93dbc3838d333808f8aae32e5b6008e9"
      ]
    },
    {
      "canonical_locator": "bible:web:ECC:4:13",
      "sequence": 17395,
      "chapter_label": "ECC 4",
      "verse_label": "13",
      "locator": {
        "book": "ECC",
        "chapter": 4,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "ECC",
          "chapter": 4,
          "verse": 13
        }
      ],
      "en": "Better is a poor and wise youth than an old and foolish king who doesn’t know how to receive admonition any more.",
      "ko": "가난하여도 지혜로운 소년은 늙고 둔하여 간함을 받을줄 모르는 왕보다 나으니",
      "source_text_hash": "f342c03bc60f3f18416c594cd8f71291fcbfbe715e9771d58d128216e4ae418a",
      "translation_text_hash": "298734b572dfb0ffbe6bcda74a93dba815049e0ca4f69852e72bd2d3c7416a62",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가난하여도 지혜로운 소년은 늙고 둔하여 간함을 받을줄 모르는 왕보다 나으니"
      ],
      "raw_text_hashes": [
        "298734b572dfb0ffbe6bcda74a93dba815049e0ca4f69852e72bd2d3c7416a62"
      ]
    },
    {
      "canonical_locator": "bible:web:ECC:4:14",
      "sequence": 17396,
      "chapter_label": "ECC 4",
