    {
      "canonical_locator": "bible:web:2KI:25:26",
      "sequence": 10249,
      "chapter_label": "2KI 25",
      "verse_label": "26",
      "locator": {
        "book": "2KI",
        "chapter": 25,
        "verse": 26
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 25,
          "verse": 26
        }
      ],
      "en": "All the people, both small and great, and the captains of the forces arose and came to Egypt; for they were afraid of the Chaldeans.",
