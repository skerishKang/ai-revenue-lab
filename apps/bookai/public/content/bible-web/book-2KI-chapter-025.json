        "verse": 2
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 25,
          "verse": 2
        }
      ],
      "en": "So the city was besieged until the eleventh year of King Zedekiah.",
      "ko": "성이 시드기야왕 십 일년까지 에워싸였더니",
      "source_text_hash": "d3197e80cf9246220c7296004167e656c565a0956fb8a0083c14f32cc6ab5985",
      "translation_text_hash": "b1c3f7175f416fc47ddd215027dcec7f3f8225b19188044df8280cfcde19e652",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "성이 시드기야왕 십 일년까지 에워싸였더니"
      ],
      "raw_text_hashes": [
        "b1c3f7175f416fc47ddd215027dcec7f3f8225b19188044df8280cfcde19e652"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:25:3",
      "sequence": 10226,
      "chapter_label": "2KI 25",
      "verse_label": "3",
      "locator": {
        "book": "2KI",
        "chapter": 25,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 25,
          "verse": 3
        }
      ],
      "en": "On the ninth day of the fourth month, the famine was severe in the city, so that there was no bread for the people of the land.",
      "ko": "그 사월 구일에 성중에 기근이 심하여 그 땅 백성의 양식이 진하였고",
      "source_text_hash": "d5a353511090b57559497e176423cd6cf63b741b66a35ed659c22f73890bcf22",
      "translation_text_hash": "ef08a9ca81b16eef2c953bf2c9d2a288d66ea0e7393f04b04314c89a4244838b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사월 구일에 성중에 기근이 심하여 그 땅 백성의 양식이 진하였고"
      ],
      "raw_text_hashes": [
        "ef08a9ca81b16eef2c953bf2c9d2a288d66ea0e7393f04b04314c89a4244838b"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:25:4",
      "sequence": 10227,
      "chapter_label": "2KI 25",
      "verse_label": "4",
      "locator": {
        "book": "2KI",
        "chapter": 25,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 25,
          "verse": 4
        }
      ],
      "en": "Then a breach was made in the city, and all the men of war fled by night by the way of the gate between the two walls, which was by the king’s garden (now the Chaldeans were against the city around it); and the king went by the way of the Arabah.",
      "ko": "갈대아 사람이 그 성읍을 에워쌌으므로 성벽에 구멍을 뚫은지라 모든 군사가 밤중에 두 성벽 사이 왕의 동산 곁문 길로 도망하여 아라바 길로 가더니",
      "source_text_hash": "c67a9d1c158d260979b9e06ad5b0c816e7aba3c07e033935fe15feb99bea1399",
      "translation_text_hash": "8b9d0cbfa6badfda863de913e6ea4770123c2c2ad0f35fed8711ff7fe40d7a3b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "갈대아 사람이 그 성읍을 에워쌌으므로 성벽에 구멍을 뚫은지라 모든 군사가 밤중에 두 성벽 사이 왕의 동산 곁문 길로 도망하여 아라바 길로 가더니"
      ],
      "raw_text_hashes": [
        "8b9d0cbfa6badfda863de913e6ea4770123c2c2ad0f35fed8711ff7fe40d7a3b"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:25:5",
      "sequence": 10228,
      "chapter_label": "2KI 25",
      "verse_label": "5",
      "locator": {
        "book": "2KI",
        "chapter": 25,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 25,
          "verse": 5
        }
      ],
      "en": "But the Chaldean army pursued the king, and overtook him in the plains of Jericho; and all his army was scattered from him.",
      "ko": "갈대아 군사가 왕을 쫓아가서 여리고 평지에 미치매 왕의 모든 군사가 저를 떠나 흩어진지라",
      "source_text_hash": "6b0493096446691019d793677e19540069509d367e0afdbe30ae277c5f350da6",
      "translation_text_hash": "92df89e2322f2b9721349132351c48306ae036c5aac7ed453fe016b2ad68d9dd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "갈대아 군사가 왕을 쫓아가서 여리고 평지에 미치매 왕의 모든 군사가 저를 떠나 흩어진지라"
      ],
      "raw_text_hashes": [
        "92df89e2322f2b9721349132351c48306ae036c5aac7ed453fe016b2ad68d9dd"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:25:6",
      "sequence": 10229,
      "chapter_label": "2KI 25",
      "verse_label": "6",
      "locator": {
        "book": "2KI",
        "chapter": 25,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 25,
          "verse": 6
        }
      ],
      "en": "Then they captured the king and carried him up to the king of Babylon to Riblah; and they passed judgment on him.",
      "ko": "갈대아 군사가 왕을 잡아 립나 바벨론 왕에게로 끌고 가매 저에게 신문하고",
      "source_text_hash": "5d0c98c9cd58364cbc7a98f31e049e9b490a75094d04936a1663b49219b795fa",
      "translation_text_hash": "5bdb7d8b937fd8f43b39c8d607b340e95c774374bd4e2f105080e3b2194d9313",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "갈대아 군사가 왕을 잡아 립나 바벨론 왕에게로 끌고 가매 저에게 신문하고"
      ],
      "raw_text_hashes": [
        "5bdb7d8b937fd8f43b39c8d607b340e95c774374bd4e2f105080e3b2194d9313"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:25:7",
      "sequence": 10230,
      "chapter_label": "2KI 25",
      "verse_label": "7",
      "locator": {
        "book": "2KI",
        "chapter": 25,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 25,
          "verse": 7
        }
      ],
      "en": "They killed Zedekiah’s sons before his eyes, then put out Zedekiah’s eyes, bound him in fetters, and carried him to Babylon.",
      "ko": "시드기야의 아들들을 저의 목전에서 죽이고 시드기야의 두 눈을 빼고 사슬로 결박하여 바벨론으로 끌어갔더라",
      "source_text_hash": "667f1b7b68c8b7b0020673ca0910992b9a3c958f2cecefe27fd4a66c245aa751",
      "translation_text_hash": "d8f129cfe60b4477f01dbdcdd8bf729243db0e546fe96becfa386aeb8811cb10",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시드기야의 아들들을 저의 목전에서 죽이고 시드기야의 두 눈을 빼고 사슬로 결박하여 바벨론으로 끌어갔더라"
      ],
      "raw_text_hashes": [
        "d8f129cfe60b4477f01dbdcdd8bf729243db0e546fe96becfa386aeb8811cb10"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:25:8",
      "sequence": 10231,
      "chapter_label": "2KI 25",
      "verse_label": "8",
      "locator": {
        "book": "2KI",
