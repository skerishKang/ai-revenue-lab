    {
      "canonical_locator": "bible:web:REV:13:4",
      "sequence": 30909,
      "chapter_label": "REV 13",
      "verse_label": "4",
      "locator": {
        "book": "REV",
        "chapter": 13,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 13,
          "verse": 4
        }
      ],
      "en": "They worshiped the dragon because he gave his authority to the beast; and they worshiped the beast, saying, “Who is like the beast? Who is able to make war with him?”",
      "ko": "용이 짐승에게 권세를 주므로 용에게 경배하며 짐승에게 경배하여 가로되 누가 이 짐승과 같으뇨 누가 능히 이로 더불어 싸우리요 하더라",
      "source_text_hash": "f662d885f26a70558fd0568210d3f0e6108f1bf36da560ede5ffd0ec5a380c5a",
      "translation_text_hash": "dbe3e8988406e660c1de4fd0a6e8b55ff3c596a2e1ea6177ebb47a4e51ba617c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "용이 짐승에게 권세를 주므로 용에게 경배하며 짐승에게 경배하여 가로되 누가 이 짐승과 같으뇨 누가 능히 이로 더불어 싸우리요 하더라"
      ],
      "raw_text_hashes": [
        "dbe3e8988406e660c1de4fd0a6e8b55ff3c596a2e1ea6177ebb47a4e51ba617c"
