    {
      "canonical_locator": "bible:web:REV:13:2",
      "sequence": 30907,
      "chapter_label": "REV 13",
      "verse_label": "2",
      "locator": {
        "book": "REV",
        "chapter": 13,
        "verse": 2
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 13,
          "verse": 2
        }
      ],
      "en": "The beast which I saw was like a leopard, and his feet were like those of a bear, and his mouth like the mouth of a lion. The dragon gave him his power, his throne, and great authority.",
      "ko": "내가 본 짐승은 표범과 비슷하고 그 발은 곰의 발 같고 그 입은 사자의 입 같은데 용이 자기의 능력과 보좌와 큰 권세를 그에게 주었더라",
      "source_text_hash": "29c9abb343641e54699fc08daf993a7d587648774ba5eb07915c10f16000438c",
      "translation_text_hash": "75e3dfc6a728c5162e87656badd81c21a0c98cb8bd72b00d22011627b25a82ac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 본 짐승은 표범과 비슷하고 그 발은 곰의 발 같고 그 입은 사자의 입 같은데 용이 자기의 능력과 보좌와 큰 권세를 그에게 주었더라"
      ],
      "raw_text_hashes": [
