    {
      "canonical_locator": "bible:web:2KI:8:11",
      "sequence": 9739,
      "chapter_label": "2KI 8",
      "verse_label": "11",
      "locator": {
        "book": "2KI",
        "chapter": 8,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 8,
          "verse": 11
        }
      ],
      "en": "He settled his gaze steadfastly on him, until he was ashamed. Then the man of God wept.",
      "ko": "하나님의 사람이 저가 부끄러워하기까지 쏘아보다가 우니",
      "source_text_hash": "2a048c924016e06551b9080a1fc8b5fff273c3d2a57dc081f5f74d82a7eed440",
      "translation_text_hash": "f0373b7bbd77699fdc4df79f2426dcb5951c739270de0a094800cf699b52be21",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님의 사람이 저가 부끄러워하기까지 쏘아보다가 우니"
      ],
      "raw_text_hashes": [
        "f0373b7bbd77699fdc4df79f2426dcb5951c739270de0a094800cf699b52be21"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:8:12",
      "sequence": 9740,
      "chapter_label": "2KI 8",
      "verse_label": "12",
      "locator": {
        "book": "2KI",
        "chapter": 8,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 8,
          "verse": 12
        }
      ],
      "en": "Hazael said, “Why do you weep, my lord?” He answered, “Because I know the evil that you will do to the children of Israel. You will set their strongholds on fire, and you will kill their young men with the sword, and will dash their little ones in pieces, and rip up their pregnant women.”",
      "ko": "하사엘이 가로되 내 주여 어찌하여 우시나이까 대답하되 네가 이스라엘 자손에게 행할 모든 악을 내가 앎이라 네가 저희 성에 불을 놓으며 장정을 칼로 죽이며 어린 아이를 메어치며 아이 밴 부녀를 가르리라",
      "source_text_hash": "3b025bcc84afdb224f6f165f8e977be980a31195f53bf67e2c1fe77f8b7844ab",
      "translation_text_hash": "814dbf1c06fc0d8465bb90a848766e37c3f34085ef1e80250363d738a6fbbe25",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하사엘이 가로되 내 주여 어찌하여 우시나이까 대답하되 네가 이스라엘 자손에게 행할 모든 악을 내가 앎이라 네가 저희 성에 불을 놓으며 장정을 칼로 죽이며 어린 아이를 메어치며 아이 밴 부녀를 가르리라"
      ],
      "raw_text_hashes": [
