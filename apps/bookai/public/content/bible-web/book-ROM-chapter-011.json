      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러면 네 말이 가지들이 꺾이운 것은 나로 접붙임을 받게 하려 함이라 하리니"
      ],
      "raw_text_hashes": [
        "9f7ea125b90df3b8dc42436f97a3534ecbe6aa473fa06aceb2edd47f90f74790"
      ]
