      "sequence": 11184,
      "chapter_label": "1CH 29",
      "verse_label": "19",
      "locator": {
        "book": "1CH",
        "chapter": 29,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 29,
          "verse": 19
