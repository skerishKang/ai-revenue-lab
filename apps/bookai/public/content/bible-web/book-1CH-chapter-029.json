    {
      "canonical_locator": "bible:web:1CH:29:18",
      "sequence": 11183,
      "chapter_label": "1CH 29",
      "verse_label": "18",
      "locator": {
        "book": "1CH",
        "chapter": 29,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 29,
          "verse": 18
        }
      ],
      "en": "LORD, the God of Abraham, of Isaac, and of Israel, our fathers, keep this desire forever in the thoughts of the heart of your people, and prepare their heart for you;",
      "ko": "우리 열조 아브라함과 이삭과 이스라엘의 하나님 여호와여 주께서 이것을 주의 백성의 심중에 영원히 두어 생각하게 하시고 그 마음을 예비하여 주께로 돌아오게 하옵시며",
      "source_text_hash": "c04c506a367ddca75a5f3ec693bd39e35a198537a96dd416da7bfef4eb746c27",
      "translation_text_hash": "fc4ac4851b23c7a72b690e92452bce04849e4e6b572ccd8e4b158acc95e310df",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 열조 아브라함과 이삭과 이스라엘의 하나님 여호와여 주께서 이것을 주의 백성의 심중에 영원히 두어 생각하게 하시고 그 마음을 예비하여 주께로 돌아오게 하옵시며"
      ],
      "raw_text_hashes": [
