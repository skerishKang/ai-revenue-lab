    {
      "canonical_locator": "bible:web:1CH:29:20",
      "sequence": 11185,
      "chapter_label": "1CH 29",
      "verse_label": "20",
      "locator": {
        "book": "1CH",
        "chapter": 29,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 29,
          "verse": 20
        }
      ],
      "en": "Then David said to all the assembly, “Now bless the LORD your God!” All the assembly blessed the LORD, the God of their fathers, and bowed down their heads and prostrated themselves before the LORD and the king.",
      "ko": "다윗이 온 회중에게 이르되 너희는 너희 하나님 여호와를 송축하라 하매 회중이 그 열조의 하나님 여호와를 송축하고 머리를 숙여 여호와와 왕에게 절하고",
      "source_text_hash": "8ea11816826608533c9132c82130e03c330ee359162759bec9e84644c0cad5ff",
      "translation_text_hash": "dd7415182732e655c1cf6998d17f28fcca1a032d8c14140db070e25fdad64745",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 온 회중에게 이르되 너희는 너희 하나님 여호와를 송축하라 하매 회중이 그 열조의 하나님 여호와를 송축하고 머리를 숙여 여호와와 왕에게 절하고"
      ],
      "raw_text_hashes": [
