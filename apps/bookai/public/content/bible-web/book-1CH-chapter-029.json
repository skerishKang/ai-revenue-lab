      "source_text_hash": "6f8baeb88229392bbeeca957e6bee1701ab585bd6d7377b26d318dd1ae044e2a",
      "translation_text_hash": "2880baa02ed1350edd871865c48d97e976cbec6033f98f02a7ec34429ef9d926",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
