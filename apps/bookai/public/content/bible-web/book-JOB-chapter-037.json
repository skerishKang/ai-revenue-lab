      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 37,
          "verse": 2
        }
      ],
      "en": "Hear, oh, hear the noise of his voice, the sound that goes out of his mouth.",
      "ko": "하나님의 음성 곧 그 입에서 나오는 소리를 들으라 들으라",
      "source_text_hash": "f6a571e6fd492786791e2729e927569f5920a6929c805b8853d041c423d71bc8",
      "translation_text_hash": "c46bf4a48bd1ab6d5bb7b4efda51b9fd8886de186c924f2db7aab55e371328fc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님의 음성 곧 그 입에서 나오는 소리를 들으라 들으라"
      ],
      "raw_text_hashes": [
        "c46bf4a48bd1ab6d5bb7b4efda51b9fd8886de186c924f2db7aab55e371328fc"
      ]
    },
    {
