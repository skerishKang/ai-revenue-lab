      ],
      "en": "“Yes, at this my heart trembles, and is moved out of its place.",
      "ko": "이로 인하여 내 마음이 떨며 자기 처소에서 떠나느니라",
      "source_text_hash": "4b785facfff2ec363bafe8440acafa8843d6549efd68118648bfd73bb67d5309",
      "translation_text_hash": "3f64de709b72088fa053aae285c868a7b453d5f53646af76b65899934ebfb7fd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이로 인하여 내 마음이 떨며 자기 처소에서 떠나느니라"
      ],
      "raw_text_hashes": [
        "3f64de709b72088fa053aae285c868a7b453d5f53646af76b65899934ebfb7fd"
      ]
    },
    {
