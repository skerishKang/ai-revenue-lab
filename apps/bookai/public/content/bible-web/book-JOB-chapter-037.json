      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 37,
          "verse": 7
        }
      ],
      "en": "He seals up the hand of every man, that all men whom he has made may know it.",
      "ko": "그가 각 사람의 손을 봉하시나니 이는 그 지으신 모든 사람으로 그것을 알게 하려 하심이니라",
      "source_text_hash": "2d006e406f316a86246806ed9448c408d89c1bf3151a876e652f2a241cfe36b9",
      "translation_text_hash": "41171a1352d9ecaecc5acd9df76975650e59a9081e31be9afc03ce3ae483f6ac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
