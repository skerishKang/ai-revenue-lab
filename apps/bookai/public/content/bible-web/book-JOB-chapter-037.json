        "verse": 3
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 37,
          "verse": 3
        }
      ],
      "en": "He sends it out under the whole sky, and his lightning to the ends of the earth.",
      "ko": "그 소리를 천하에 퍼치시며 번개 빛으로 땅끝까지 이르게 하시고",
      "source_text_hash": "df4ead92f32218ff84e553f4fa626e32bfcff8b5fe04d1c61b38917d3b405108",
      "translation_text_hash": "29325ab00dab86d9f21aa1f13df338e37a0365beedc31a8959b4e9ef333f2747",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 소리를 천하에 퍼치시며 번개 빛으로 땅끝까지 이르게 하시고"
      ],
      "raw_text_hashes": [
        "29325ab00dab86d9f21aa1f13df338e37a0365beedc31a8959b4e9ef333f2747"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:37:4",
      "sequence": 13774,
      "chapter_label": "JOB 37",
