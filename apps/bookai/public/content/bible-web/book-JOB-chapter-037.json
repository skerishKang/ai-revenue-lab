      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님의 부시는 기운에 얼음이 얼고 물의 넓이가 줄어지느니라"
      ],
      "raw_text_hashes": [
        "a704102d33e09956b15854edd5395610c8ab9b32f9f89bc9377de800f8721add"
      ]
