      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 37,
          "verse": 8
        }
      ],
      "en": "Then the animals take cover, and remain in their dens.",
      "ko": "짐승들은 숨는 곳으로 들어가서 그 굴에 머물며",
      "source_text_hash": "29efc2fe6893278cc694664621986f2f48b80d37ec5b678f9d08fa7d68aab37a",
      "translation_text_hash": "9771b3940921176321e0c697b7d443b13c57b4d539ce7de1a56025f4269f5f7e",
      "translation_policy": "krv-1961-source-mapped",
