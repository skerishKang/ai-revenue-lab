      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "레갑의 아들 요나답의 자손은 그 선조가 그들에게 명한 그 명령을 준행하나 이 백성은 나를 듣지 아니하도다"
      ],
      "raw_text_hashes": [
