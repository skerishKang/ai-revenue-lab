      "raw_texts": [
        "거처할 집도 짓지 아니하며 포도원이나 밭이나 종자도 두지 아니하고"
      ],
      "raw_text_hashes": [
        "253691151b7a5245125e2e7f5b54c0806f1ada369569419f9a4b718af552c7f0"
      ]
