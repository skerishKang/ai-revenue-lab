      "raw_locator": [
        {
          "book": "JER",
          "chapter": 35,
          "verse": 5
        }
      ],
      "en": "I set before the sons of the house of the Rechabites bowls full of wine, and cups; and I said to them, “Drink wine!”",
      "ko": "내가 레갑 족속 사람들 앞에 포도주가 가득한 사발과 잔을 놓고 마시라 권하매",
      "source_text_hash": "f2105731dcc8c0278220e123407fa86409845479c520aa78abd6c4b614f9d628",
      "translation_text_hash": "bb2454de5bc234fa0b5e668b9d2302f40a9414e25326b04e444b537d25f37a22",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 레갑 족속 사람들 앞에 포도주가 가득한 사발과 잔을 놓고 마시라 권하매"
      ],
      "raw_text_hashes": [
        "bb2454de5bc234fa0b5e668b9d2302f40a9414e25326b04e444b537d25f37a22"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:35:6",
      "sequence": 19830,
      "chapter_label": "JER 35",
      "verse_label": "6",
      "locator": {
        "book": "JER",
