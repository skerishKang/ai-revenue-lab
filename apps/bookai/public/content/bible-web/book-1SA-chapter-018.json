      ],
      "en": "Saul watched David from that day and forward.",
      "ko": "그 날 후로 사울이 다윗을 주목하였더라",
      "source_text_hash": "2be38d9764dc991ebf401f10e4f7ea37dd0ed59ca0699b9f8f57053f60597ccf",
      "translation_text_hash": "da50f97b8053465cb96b648f26e3c19603cfa117bc34a5af92401b9a22ef1313",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 날 후로 사울이 다윗을 주목하였더라"
      ],
      "raw_text_hashes": [
        "da50f97b8053465cb96b648f26e3c19603cfa117bc34a5af92401b9a22ef1313"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:18:10",
      "sequence": 7687,
      "chapter_label": "1SA 18",
      "verse_label": "10",
      "locator": {
        "book": "1SA",
