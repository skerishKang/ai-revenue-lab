      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 18,
          "verse": 12
        }
      ],
      "en": "Saul was afraid of David, because the LORD was with him, and had departed from Saul.",
      "ko": "여호와께서 사울을 떠나 다윗과 함께 계시므로 사울이 그를 두려워한지라",
      "source_text_hash": "19e62b137c67de5ebc1161be994bba9b86216d27259b8426faa9d7b7bedbf5ca",
      "translation_text_hash": "3544b57ebccd18a153712c2ec530edf996cd546bc50b6fa072444ac3b21519fd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 사울을 떠나 다윗과 함께 계시므로 사울이 그를 두려워한지라"
      ],
      "raw_text_hashes": [
        "3544b57ebccd18a153712c2ec530edf996cd546bc50b6fa072444ac3b21519fd"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:18:13",
      "sequence": 7690,
      "chapter_label": "1SA 18",
      "verse_label": "13",
      "locator": {
        "book": "1SA",
