        {
          "book": "1SA",
          "chapter": 18,
          "verse": 3
        }
      ],
      "en": "Then Jonathan and David made a covenant, because he loved him as his own soul.",
      "ko": "요나단은 다윗을 자기 생명 같이 사랑하여 더불어 언약을 맺었으며",
      "source_text_hash": "e63f397a36cb5dda4cb5e905e9547a4c400a038116ddd44d6eeaea3571ec6859",
      "translation_text_hash": "d096dbe32148e1856750de1b566c7e584f56260b56532edea9604241289322de",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요나단은 다윗을 자기 생명 같이 사랑하여 더불어 언약을 맺었으며"
      ],
      "raw_text_hashes": [
        "d096dbe32148e1856750de1b566c7e584f56260b56532edea9604241289322de"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:18:4",
      "sequence": 7681,
      "chapter_label": "1SA 18",
      "verse_label": "4",
      "locator": {
