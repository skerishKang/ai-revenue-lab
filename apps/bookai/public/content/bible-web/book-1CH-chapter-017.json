      "locator": {
        "book": "1CH",
        "chapter": 17,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 17,
          "verse": 8
        }
      ],
      "en": "I have been with you wherever you have gone, and have cut off all your enemies from before you. I will make you a name like the name of the great ones who are on the earth.",
      "ko": "네가 어디를 가든지 내가 너와 함께 있어 네 모든 대적을 네 앞에서 멸하였은즉 세상에서 존귀한 자의 이름 같은 이름을 네게 만들어 주리라",
      "source_text_hash": "ef112559b5b08e34b626be69ef6a819c5debc0d4b85ed59aaca9d76b8af47f3d",
      "translation_text_hash": "6116823afc6b15a076898be250c6e75ffe9663a0df159c7386818bff688fd670",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 어디를 가든지 내가 너와 함께 있어 네 모든 대적을 네 앞에서 멸하였은즉 세상에서 존귀한 자의 이름 같은 이름을 네게 만들어 주리라"
      ],
      "raw_text_hashes": [
        "6116823afc6b15a076898be250c6e75ffe9663a0df159c7386818bff688fd670"
