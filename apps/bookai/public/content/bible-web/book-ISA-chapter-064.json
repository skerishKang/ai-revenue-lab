          "chapter": 64,
          "verse": 1
        }
      ],
      "en": "Oh that you would tear the heavens, that you would come down, that the mountains might quake at your presence—",
      "ko": "원컨대 주는 하늘을 가르고 강림하시고 주의 앞에서 산들로 진동하기를",
      "source_text_hash": "7a5ffc68e2b9de10258c9838a0ebed90f84180aaaa47f10db447ecd6b767915e",
      "translation_text_hash": "6f291657f962c92f82fee32f1797d9f2df539d1734048416a0b16c255ad19653",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "원컨대 주는 하늘을 가르고 강림하시고 주의 앞에서 산들로 진동하기를"
      ],
      "raw_text_hashes": [
        "6f291657f962c92f82fee32f1797d9f2df539d1734048416a0b16c255ad19653"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:64:2",
      "sequence": 18888,
      "chapter_label": "ISA 64",
      "verse_label": "2",
      "locator": {
        "book": "ISA",
        "chapter": 64,
        "verse": 2
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 64,
          "verse": 2
        }
      ],
      "en": "as when fire kindles the brushwood, and the fire causes the water to boil. Make your name known to your adversaries, that the nations may tremble at your presence!",
      "ko": "불이 섶을 사르며 불이 물을 끓임 같게 하사 주의 대적으로 주의 이름을 알게 하시며 열방으로 주의 앞에서 떨게 하옵소서",
      "source_text_hash": "0b52959291a2dfed738b312fc44590ccd658c8cc2f70209a255a61556006d87e",
      "translation_text_hash": "069026d3e8b64acdfc06ae2e0bf74b15ae33e75616b551ffe5a0c811d6da815d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "불이 섶을 사르며 불이 물을 끓임 같게 하사 주의 대적으로 주의 이름을 알게 하시며 열방으로 주의 앞에서 떨게 하옵소서"
      ],
      "raw_text_hashes": [
        "069026d3e8b64acdfc06ae2e0bf74b15ae33e75616b551ffe5a0c811d6da815d"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:64:3",
      "sequence": 18889,
      "chapter_label": "ISA 64",
      "verse_label": "3",
      "locator": {
        "book": "ISA",
