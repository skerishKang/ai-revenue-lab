      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "율법은 진노를 이루게 하나니 율법이 없는 곳에는 범함도 없느니라"
      ],
      "raw_text_hashes": [
        "a3b70498c910dc5d569b902b276a707a62a92054ea1896872cda9ef25307d845"
      ]
