      "source_text_hash": "c48297a7b6af7ea123d86e6ee9c77923167ffa973e23ffadff3b0a28c7811cd8",
      "translation_text_hash": "274db526e732ff3921fd7fdd0af5020a24bff5ca3c9d716c41f763fce8f6605e",
