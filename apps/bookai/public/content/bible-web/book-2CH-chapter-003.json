      ],
      "raw_text_hashes": [
        "022aa80ea947621ca36664c26d8351d9903ff550426a2454412828270f197f41"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:3:11",
      "sequence": 11241,
      "chapter_label": "2CH 3",
      "verse_label": "11",
      "locator": {
        "book": "2CH",
