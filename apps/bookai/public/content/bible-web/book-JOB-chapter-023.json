      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 23,
          "verse": 3
        }
      ],
      "en": "Oh that I knew where I might find him! That I might come even to his seat!",
      "ko": "내가 어찌하면 하나님 발견할 곳을 알꼬 그리하면 그 보좌 앞에 나아가서",
      "source_text_hash": "13c9623f5234e5c846888e631df73249c6973c3d1dcd5eae67b4891bfec616ca",
      "translation_text_hash": "62bab02b319b81f871da9713cf90d2afb789a91e9cff6d465feaec1ce769607c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 어찌하면 하나님 발견할 곳을 알꼬 그리하면 그 보좌 앞에 나아가서"
      ],
      "raw_text_hashes": [
