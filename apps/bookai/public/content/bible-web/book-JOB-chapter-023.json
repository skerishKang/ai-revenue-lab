      ],
      "en": "I would know the words which he would answer me, and understand what he would tell me.",
      "ko": "내게 대답하시는 말씀을 내가 알고 내게 이르시는 것을 내가 깨달으리라",
      "source_text_hash": "ee0472d47f79b6260ccc96071ffa7bb465831494e7011dc3e488f0a512640ea7",
      "translation_text_hash": "7de06fa927c7192454d42e053c0b74fb3c419772d988f259c020c02e22930861",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게 대답하시는 말씀을 내가 알고 내게 이르시는 것을 내가 깨달으리라"
      ],
      "raw_text_hashes": [
        "7de06fa927c7192454d42e053c0b74fb3c419772d988f259c020c02e22930861"
      ]
