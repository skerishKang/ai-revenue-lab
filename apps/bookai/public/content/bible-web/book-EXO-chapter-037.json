      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "브살렐이 조각목으로 궤를 만들었으니 장이 이 규빗 반, 광이 일 규빗 반, 고가 일 규빗 반이며"
      ],
      "raw_text_hashes": [
        "1c923a6037a528ec0ef8f8c95dc34e5ff11b7d09081f2558bb251c8aa3d69444"
      ]
