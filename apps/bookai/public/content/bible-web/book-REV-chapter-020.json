    {
      "canonical_locator": "bible:web:REV:20:12",
      "sequence": 31047,
      "chapter_label": "REV 20",
      "verse_label": "12",
      "locator": {
        "book": "REV",
        "chapter": 20,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 20,
          "verse": 12
        }
      ],
      "en": "I saw the dead, the great and the small, standing before the throne, and they opened books. Another book was opened, which is the book of life. The dead were judged out of the things which were written in the books, according to their works.",
      "ko": "또 내가 보니 죽은 자들이 무론 대소하고 그 보좌 앞에 섰는데 책들이 펴 있고 또 다른 책이 펴졌으니 곧 생명책이라 죽은 자들이 자기 행위를 따라 책들에 기록된대로 심판을 받으니",
      "source_text_hash": "692c40b95465adb6a5ab86ada5d99ced88ab0fbaecfed5242c4726521e2a6ce3",
      "translation_text_hash": "7ac99c8f8292a1707fa0a4206ebc21d66a66ddb00fe384f144377e1983ed2584",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 내가 보니 죽은 자들이 무론 대소하고 그 보좌 앞에 섰는데 책들이 펴 있고 또 다른 책이 펴졌으니 곧 생명책이라 죽은 자들이 자기 행위를 따라 책들에 기록된대로 심판을 받으니"
      ],
      "raw_text_hashes": [
        "7ac99c8f8292a1707fa0a4206ebc21d66a66ddb00fe384f144377e1983ed2584"
      ]
    },
