      ],
      "en": "They will speak of the glory of your kingdom, and talk about your power,",
      "ko": "저희가 주의 나라의 영광을 말하며 주의 능을 일러서",
      "source_text_hash": "699d121b237dee4a27d1054764329d9b15326707e8fb39fb6f5e1417cd4fb961",
      "translation_text_hash": "7bea096265ef4874e7c5c4bd955cc2e840e914cec8a160365a65902511a79bbb",
      "translation_policy": "krv-1961-source-mapped",
