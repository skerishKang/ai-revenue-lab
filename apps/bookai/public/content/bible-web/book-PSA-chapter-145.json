        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 145,
          "verse": 6
        }
      ],
      "en": "Men will speak of the might of your awesome acts. I will declare your greatness.",
      "ko": "사람들은 주의 두려운 일의 세력을 말할 것이요 나도 주의 광대하심을 선포하리이다",
      "source_text_hash": "48da948dc6c3868adccb5d34ddf54d54d12235fb94483d18f1445396a2691ea8",
      "translation_text_hash": "4338d2de428954d1a6e630ce6794609aa4f8b11772684e8af461dbfac45a4fea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람들은 주의 두려운 일의 세력을 말할 것이요 나도 주의 광대하심을 선포하리이다"
      ],
      "raw_text_hashes": [
        "4338d2de428954d1a6e630ce6794609aa4f8b11772684e8af461dbfac45a4fea"
      ]
    },
    {
