      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 145,
          "verse": 10
        }
      ],
      "en": "All your works will give thanks to you, LORD. Your saints will extol you.",
      "ko": "여호와여 주의 지으신 모든 것이 주께 감사하며 주의 성도가 주를 송축하리이다",
      "source_text_hash": "e493082531c9f8c1b0d5120b16e7874a80a5e28f7e34b3e5a3ecc2b5223d1eec",
      "translation_text_hash": "eb60cfd54a9deb4633f7e2b9d9fddfce0fd880f78cc0e83a5f35a65628282cfb",
      "translation_policy": "krv-1961-source-mapped",
