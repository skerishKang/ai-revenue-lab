      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 145,
          "verse": 4
        }
      ],
      "en": "One generation will commend your works to another, and will declare your mighty acts.",
      "ko": "대대로 주의 행사를 크게 칭송하며 주의 능한 일을 선포하리로다",
      "source_text_hash": "365ccd2043ca10fa63d432f1c156ef79f6dd0e559cdbbed786c32776249e9074",
      "translation_text_hash": "b5d9d77c77e8e1123e41aaf41aa0978f92ee2bef3d7cb62aec7884a8545ef6da",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대대로 주의 행사를 크게 칭송하며 주의 능한 일을 선포하리로다"
      ],
      "raw_text_hashes": [
        "b5d9d77c77e8e1123e41aaf41aa0978f92ee2bef3d7cb62aec7884a8545ef6da"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:145:5",
      "sequence": 16326,
      "chapter_label": "PSA 145",
      "verse_label": "5",
      "locator": {
