      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 145,
          "verse": 5
        }
      ],
      "en": "I will meditate on the glorious majesty of your honor, on your wondrous works.",
      "ko": "주의 존귀하고 영광스러운 위엄과 주의 기사를 나는 묵상하리이다",
      "source_text_hash": "cf89d8fc705666af4db44ef2a2a0ace78b2e5d991dcf8ffac714e79986a980ee",
      "translation_text_hash": "5337f2157500611b8ff40510be359c1f1372c0a5e963e65806ddcb2986a1b139",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 존귀하고 영광스러운 위엄과 주의 기사를 나는 묵상하리이다"
      ],
      "raw_text_hashes": [
        "5337f2157500611b8ff40510be359c1f1372c0a5e963e65806ddcb2986a1b139"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:145:6",
      "sequence": 16327,
