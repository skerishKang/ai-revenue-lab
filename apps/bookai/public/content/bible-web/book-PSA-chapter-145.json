      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 145,
          "verse": 8
        }
      ],
      "en": "The LORD is gracious, merciful, slow to anger, and of great loving kindness.",
      "ko": "여호와는 은혜로우시며 자비하시며 노하기를 더디하시며 인자하심이 크시도다",
      "source_text_hash": "4e44b9ce2f2d714412fd5a184442f97b755c0e7d8740459ed4083bb9c5d8aa01",
      "translation_text_hash": "dab15f2ffcd0ccd3de6669fc2f9ca5e79ec18945a84364230c3ab9757652968b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와는 은혜로우시며 자비하시며 노하기를 더디하시며 인자하심이 크시도다"
      ],
      "raw_text_hashes": [
        "dab15f2ffcd0ccd3de6669fc2f9ca5e79ec18945a84364230c3ab9757652968b"
      ]
    },
