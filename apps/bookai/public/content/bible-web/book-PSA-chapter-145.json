      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 145,
          "verse": 13
        }
      ],
      "en": "Your kingdom is an everlasting kingdom. Your dominion endures throughout all generations. The LORD is faithful in all his words, and loving in all his deeds.",
      "ko": "주의 나라는 영원한 나라이니 주의 통치는 대대에 이르리이다",
      "source_text_hash": "9787ff4fe06c5266b6439ead2c89570b89a902356d2681c62fdec1753e5ee672",
      "translation_text_hash": "c6472b1a287bd9c698f52a40a3f516533bb61243330a56e3aad011b9ffce40d6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 나라는 영원한 나라이니 주의 통치는 대대에 이르리이다"
      ],
      "raw_text_hashes": [
        "c6472b1a287bd9c698f52a40a3f516533bb61243330a56e3aad011b9ffce40d6"
      ]
    },
