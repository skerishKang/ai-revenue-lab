      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 145,
          "verse": 7
        }
      ],
      "en": "They will utter the memory of your great goodness, and will sing of your righteousness.",
      "ko": "저희가 주의 크신 은혜를 기념하여 말하며 주의 의를 노래하리이다",
      "source_text_hash": "03350b4ed85169319073065a669c32c6394816c026244ff2901a20b51a4a5e3d",
      "translation_text_hash": "bbd9d0b984d79ad172c422877f6e2b26f7d63e2973c9d35d311b56613fe4afc0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 주의 크신 은혜를 기념하여 말하며 주의 의를 노래하리이다"
      ],
      "raw_text_hashes": [
        "bbd9d0b984d79ad172c422877f6e2b26f7d63e2973c9d35d311b56613fe4afc0"
      ]
