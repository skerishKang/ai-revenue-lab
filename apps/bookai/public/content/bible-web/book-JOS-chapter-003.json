      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 온 땅의 주의 언약궤가 너희 앞서 요단으로 들어가나니"
      ],
      "raw_text_hashes": [
        "eb73cad9d88502c84df5efef0d94808dee5d1be308ce67cd0d3f76e081d1d308"
      ]
    },
