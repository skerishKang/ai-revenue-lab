      "raw_texts": [
        "그의 신하들은 이러하니라 사독의 아들 아사리아는 제사장이요"
      ],
      "raw_text_hashes": [
        "31ed6ef918db369221805bf42bab10766fb336c87f1005b0928653656fcaeb31"
      ]
    },
