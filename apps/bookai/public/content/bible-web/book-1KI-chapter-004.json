      "mapping_note": null,
      "raw_texts": [
        "나단의 아들 아사리아는 관리장이요 나단의 아들 사붓은 대신이니 왕의 벗이요"
      ],
      "raw_text_hashes": [
        "ff1861375d6f243065ad701337d6faa5acba7397b9d90ddc283748a7fbee7cdf"
      ]
