      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시사의 아들 엘리호렙과 아히야는 서기관이요 아힐룻의 아들 여호사밧은 사관이요"
      ],
      "raw_text_hashes": [
        "a43670039e99460edfaa4438b41e8b23a2bafb910af76669b9c14db9f0af6db3"
