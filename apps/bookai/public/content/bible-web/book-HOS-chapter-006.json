      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 6,
          "verse": 8
        }
      ],
      "en": "Gilead is a city of those who work iniquity; it is stained with blood.",
      "ko": "길르앗은 행악자의 고을이라 피 발자취가 편만하도다",
      "source_text_hash": "67b3bb0f55622b39af85a027e93b8fdce3f6805b1fb44071fae9644b3e5c30a6",
      "translation_text_hash": "d166d0988aaf52f11f075fa801eb730c93c78e444c94db30eaf29468366c56a7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "길르앗은 행악자의 고을이라 피 발자취가 편만하도다"
      ],
      "raw_text_hashes": [
        "d166d0988aaf52f11f075fa801eb730c93c78e444c94db30eaf29468366c56a7"
      ]
    },
    {
