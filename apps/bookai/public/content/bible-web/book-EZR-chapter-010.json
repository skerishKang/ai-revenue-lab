        "verse": 4
      },
      "raw_locator": [
        {
          "book": "EZR",
          "chapter": 10,
          "verse": 4
        }
      ],
      "en": "Arise, for the matter belongs to you and we are with you. Be courageous, and do it.”",
      "ko": "이는 당신의 주장할 일이니 일어나소서 우리가 도우리니 힘써 행하소서",
      "source_text_hash": "fec9ecc2fa33ddfbb0e6c1ee9c9ac18fce0b3af4c31413f7d226d77697520b74",
      "translation_text_hash": "7257fdb42c8576000c65df174717d2319ce7a6870124e39cedbf5e2ee5fc9310",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 당신의 주장할 일이니 일어나소서 우리가 도우리니 힘써 행하소서"
      ],
      "raw_text_hashes": [
        "7257fdb42c8576000c65df174717d2319ce7a6870124e39cedbf5e2ee5fc9310"
      ]
    },
    {
      "canonical_locator": "bible:web:EZR:10:5",
      "sequence": 12258,
      "chapter_label": "EZR 10",
      "verse_label": "5",
      "locator": {
