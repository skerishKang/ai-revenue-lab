        {
          "book": "PSA",
          "chapter": 97,
          "verse": 2
        }
      ],
      "en": "Clouds and darkness are around him. Righteousness and justice are the foundation of his throne.",
      "ko": "구름과 흑암이 그에게 둘렸고 의와 공평이 그 보좌의 기초로다",
      "source_text_hash": "1aa0daff041da7a3d3857ddb360ada695eda738220fc056f436abdb5e46345e8",
      "translation_text_hash": "69b5e27e7981105d7a66e31a1a7e8f38ba12d87b4af5eaa23433e935ab0d433c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "구름과 흑암이 그에게 둘렸고 의와 공평이 그 보좌의 기초로다"
      ],
      "raw_text_hashes": [
        "69b5e27e7981105d7a66e31a1a7e8f38ba12d87b4af5eaa23433e935ab0d433c"
      ]
    },
    {
