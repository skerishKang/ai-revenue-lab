      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "산들이 여호와의 앞 곧 온 땅의 주 앞에서 밀 같이 녹았도다"
      ],
      "raw_text_hashes": [
        "bb5632bd21cac5881a93800ef1a269f46339c3dd6115b60056b9d7f5cdace2d1"
