      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 97,
          "verse": 3
        }
      ],
      "en": "A fire goes before him, and burns up his adversaries on every side.",
      "ko": "불이 그 앞에서 발하여 사면의 대적을 사르는도다",
      "source_text_hash": "5e98dd9fb8594e3386214334e4a060b8f1ddfe1da6bf3ed91786e88e91559372",
      "translation_text_hash": "936b2ff676482d14506cbb61f1ef5d311af183356ccae488105700696b9a448f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "불이 그 앞에서 발하여 사면의 대적을 사르는도다"
      ],
      "raw_text_hashes": [
        "936b2ff676482d14506cbb61f1ef5d311af183356ccae488105700696b9a448f"
      ]
