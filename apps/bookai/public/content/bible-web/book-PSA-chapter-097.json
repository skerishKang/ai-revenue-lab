      ],
      "en": "The heavens declare his righteousness. All the peoples have seen his glory.",
      "ko": "하늘이 그 의를 선포하니 모든 백성이 그 영광을 보았도다",
      "source_text_hash": "52ad264e6a2328c0b0624a58e14b666a38adc73eabd860ac1c23e11fd70cd96a",
      "translation_text_hash": "f15332245b9f6633351ec27e5be3cdb186353e358d5979f06075170d2c82de71",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하늘이 그 의를 선포하니 모든 백성이 그 영광을 보았도다"
      ],
      "raw_text_hashes": [
        "f15332245b9f6633351ec27e5be3cdb186353e358d5979f06075170d2c82de71"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:97:7",
      "sequence": 15486,
      "chapter_label": "PSA 97",
