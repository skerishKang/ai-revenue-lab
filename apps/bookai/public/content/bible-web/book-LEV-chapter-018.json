        "verse": 3
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 18,
          "verse": 3
        }
      ],
      "en": "You shall not do as they do in the land of Egypt, where you lived. You shall not do as they do in the land of Canaan, where I am bringing you. You shall not follow their statutes.",
      "ko": "너희는 그 거하던 애굽 땅의 풍속을 좇지 말며 내가 너희를 인도할 가나안 땅의 풍속과 규례도 행하지 말고",
      "source_text_hash": "c75fa64622914af6dc26e30957933db626a2aa98b7dd98922ac5abeba12762f7",
      "translation_text_hash": "cbdec099d981ae9a40dd2e2db865febf8fe310d9e356bc56283cd83d0d6528af",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 그 거하던 애굽 땅의 풍속을 좇지 말며 내가 너희를 인도할 가나안 땅의 풍속과 규례도 행하지 말고"
      ],
      "raw_text_hashes": [
        "cbdec099d981ae9a40dd2e2db865febf8fe310d9e356bc56283cd83d0d6528af"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:18:4",
      "sequence": 3256,
      "chapter_label": "LEV 18",
      "verse_label": "4",
      "locator": {
