    {
      "canonical_locator": "bible:web:AMO:2:10",
      "sequence": 22390,
      "chapter_label": "AMO 2",
      "verse_label": "10",
      "locator": {
        "book": "AMO",
        "chapter": 2,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "AMO",
          "chapter": 2,
          "verse": 10
        }
      ],
      "en": "Also I brought you up out of the land of Egypt and led you forty years in the wilderness, to possess the land of the Amorite.",
      "ko": "내가 너희를 애굽 땅에서 이끌어 내어 사십년 동안 광야에서 인도하고 아모리 사람의 땅을 너희로 차지하게 하였고",
      "source_text_hash": "1563791d738e7e04dd2a6fabef34133dac867eeb64f0f0fdd08a9044cfa32563",
      "translation_text_hash": "19e828f556a849e549e56508d1754daeacf8e304ca3418b9e14ba99cbb8a0436",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너희를 애굽 땅에서 이끌어 내어 사십년 동안 광야에서 인도하고 아모리 사람의 땅을 너희로 차지하게 하였고"
      ],
      "raw_text_hashes": [
        "19e828f556a849e549e56508d1754daeacf8e304ca3418b9e14ba99cbb8a0436"
      ]
