      "translation_text_hash": "080d10aac03ce12976362bd876e39835b69d8425463fb65a65b7dc407c5d8fbb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "분노가 미련한 자를 죽이고 시기가 어리석은 자를 멸하느니라"
      ],
      "raw_text_hashes": [
        "080d10aac03ce12976362bd876e39835b69d8425463fb65a65b7dc407c5d8fbb"
      ]
    },
