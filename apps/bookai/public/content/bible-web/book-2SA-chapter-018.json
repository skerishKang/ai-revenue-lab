      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 18,
          "verse": 21
        }
      ],
      "en": "Then Joab said to the Cushite, “Go, tell the king what you have seen!” The Cushite bowed himself to Joab, and ran.",
      "ko": "구스 사람에게 이르되 네가 가서 본 것을 왕께 고하라 하매 구스 사람이 요압에게 절하고 달음질하여 가니",
      "source_text_hash": "c4eb63d2e1376d87574480b5b28ba9f39d4118c2b5ddc32a56c4caa6a92f1241",
      "translation_text_hash": "c42425aa7c40387d23382242216a1c9b8b5604c8186429dc81a5f71340648a09",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "구스 사람에게 이르되 네가 가서 본 것을 왕께 고하라 하매 구스 사람이 요압에게 절하고 달음질하여 가니"
      ],
      "raw_text_hashes": [
