        "verse": 7
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 18,
          "verse": 7
        }
      ],
      "en": "The people of Israel were struck there before David’s servants, and there was a great slaughter there that day of twenty thousand men.",
      "ko": "거기서 이스라엘 무리가 다윗의 신복들에게 패하매 그 날 그곳에서 살륙이 커서 이만에 이르렀고",
      "source_text_hash": "b60c58f790460a78961497b671ab7ea552a678b8342748602174fefaaeb2027f",
      "translation_text_hash": "59c7d4ef6039fc879e5a8bc2cd6bfcc2a0fea106dec249ae0d188cff6426b50f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "거기서 이스라엘 무리가 다윗의 신복들에게 패하매 그 날 그곳에서 살륙이 커서 이만에 이르렀고"
      ],
      "raw_text_hashes": [
        "59c7d4ef6039fc879e5a8bc2cd6bfcc2a0fea106dec249ae0d188cff6426b50f"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:18:8",
      "sequence": 8487,
      "chapter_label": "2SA 18",
