      "source_text_hash": "d1037fa7d91af025a2b55fb97f3f047453aa1dbebe0e9356fa54bae2bb053e5b",
      "translation_text_hash": "624b154fd1bfa06942196e12bf5dbacf7db5e106a15c48f3f18b2395912c56af",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주의 인자하심을 우리에게 보이시며 주의 구원을 우리에게 주소서"
      ],
      "raw_text_hashes": [
        "624b154fd1bfa06942196e12bf5dbacf7db5e106a15c48f3f18b2395912c56af"
      ]
    },
