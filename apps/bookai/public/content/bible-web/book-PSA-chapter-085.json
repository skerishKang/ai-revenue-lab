        {
          "book": "PSA",
          "chapter": 85,
          "verse": 2
        }
      ],
      "en": "You have forgiven the iniquity of your people. You have covered all their sin. Selah.",
      "ko": "주의 백성의 죄악을 사하시고 저희 모든 죄를 덮으셨나이다(셀라)",
      "source_text_hash": "cab3d1de1ae18f70cdd6972b338253f01c3c576220615e122ea61db5bb260c9d",
      "translation_text_hash": "f7d5b61626869f1181fdefb0f74a43b25a1b266e9359e46206cf545e3436d442",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 백성의 죄악을 사하시고 저희 모든 죄를 덮으셨나이다(셀라)"
      ],
      "raw_text_hashes": [
        "f7d5b61626869f1181fdefb0f74a43b25a1b266e9359e46206cf545e3436d442"
      ]
    },
