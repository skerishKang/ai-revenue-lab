        {
          "book": "PSA",
          "chapter": 85,
          "verse": 4
        }
      ],
      "en": "Turn us, God of our salvation, and cause your indignation toward us to cease.",
      "ko": "우리 구원의 하나님이여 우리를 돌이키시고 우리에게 향하신 주의 분노를 그치소서",
      "source_text_hash": "d4afe806ed4a05b3966c5866c9eac0cfc4cb26e80df646f3b9db6737dea2925c",
      "translation_text_hash": "7f022f236e8da1142e9b81ac0a07ea6138bbce14aa7b6f4ffe0dfd8df06d0d2a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 구원의 하나님이여 우리를 돌이키시고 우리에게 향하신 주의 분노를 그치소서"
      ],
      "raw_text_hashes": [
        "7f022f236e8da1142e9b81ac0a07ea6138bbce14aa7b6f4ffe0dfd8df06d0d2a"
      ]
    },
