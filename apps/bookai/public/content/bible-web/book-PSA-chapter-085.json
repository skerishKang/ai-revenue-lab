      "source_text_hash": "8b739d467b3fed0d16b0a0966f0beb3068b70e43a22a8d4f0e86c11c1de248b9",
      "translation_text_hash": "4746841795db8aa10c4210dcf865f4ece61d63a8a7666a8aed0f183e65057eac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
