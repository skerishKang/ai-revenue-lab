        {
          "book": "PSA",
          "chapter": 41,
          "verse": 7
        }
      ],
      "en": "All who hate me whisper together against me. They imagine the worst for me.",
      "ko": "나를 미워하는 자가 다 내게 대하여 수군거리고 나를 해하려고 꾀하며",
      "source_text_hash": "74202561a7b71113bbfa18bc7facfe53fd91cdca562d063eed3579ce064071db",
      "translation_text_hash": "163b9e58528f400287990fcc07aa395d25773561f4b327acf4106da16f78f9c2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 미워하는 자가 다 내게 대하여 수군거리고 나를 해하려고 꾀하며"
      ],
      "raw_text_hashes": [
        "163b9e58528f400287990fcc07aa395d25773561f4b327acf4106da16f78f9c2"
      ]
    },
