        {
          "book": "EST",
          "chapter": 6,
          "verse": 7
        }
      ],
      "en": "Haman said to the king, “For the man whom the king delights to honor,",
      "ko": "왕께 아뢰되 왕께서 사람을 존귀케 하시려면",
      "source_text_hash": "feb79165111a9e9bffc1f6e3a53ef1b859690780ca278e3d19eb1036ef668ef4",
      "translation_text_hash": "2814e9ba0ae52617396d15e8ecf6d82ac9e22ce497cee750aca05dcc1354df09",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕께 아뢰되 왕께서 사람을 존귀케 하시려면"
      ],
      "raw_text_hashes": [
        "2814e9ba0ae52617396d15e8ecf6d82ac9e22ce497cee750aca05dcc1354df09"
      ]
    },
    {
      "canonical_locator": "bible:web:EST:6:8",
      "sequence": 12802,
