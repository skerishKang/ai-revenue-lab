      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 생명을 파멸에서 구속하시고 인자와 긍휼로 관을 씌우시며"
      ],
      "raw_text_hashes": [
        "7d8f3200a09e1e31b5be4ff1dd60a7cc1d92d5296647dca5cfb71996441f6911"
      ]
