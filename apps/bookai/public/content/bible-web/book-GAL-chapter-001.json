        {
          "book": "GAL",
          "chapter": 1,
          "verse": 2
        }
      ],
      "en": "and all the brothers who are with me, to the assemblies of Galatia:",
      "ko": "함께 있는 모든 형제로 더불어 갈라디아 여러 교회들에게",
      "source_text_hash": "4acd8416e7a532cebd0d0497367cff4c04d43f84c4e550cdb468277e4f688f00",
      "translation_text_hash": "d20f2759629649088e467d447677afe34374faa67565fcdc21f16789016babaf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "함께 있는 모든 형제로 더불어 갈라디아 여러 교회들에게"
      ],
      "raw_text_hashes": [
        "d20f2759629649088e467d447677afe34374faa67565fcdc21f16789016babaf"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:1:3",
      "sequence": 29057,
      "chapter_label": "GAL 1",
      "verse_label": "3",
      "locator": {
