      "translation_text_hash": "708c161a288b8ae80f01d8c500f7de1313bb81a0363e9c9c7099c48ae7981b51",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께 힘을 얻고 그 마음에 시온의 대로가 있는 자는 복이 있나이다"
      ],
      "raw_text_hashes": [
        "708c161a288b8ae80f01d8c500f7de1313bb81a0363e9c9c7099c48ae7981b51"
      ]
    },
    {
