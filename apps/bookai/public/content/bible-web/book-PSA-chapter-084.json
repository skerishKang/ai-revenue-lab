      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 집에 거하는 자가 복이 있나이다 저희가 항상 주를 찬송하리이다(셀라)"
      ],
      "raw_text_hashes": [
        "e09c073a9d7672f8c8dd5efd9e00eba7d98123550fd0e5486c8ea7501fb6ebd6"
