        "verse": 8
      },
      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 11,
          "verse": 8
        }
      ],
      "en": "I robbed other assemblies, taking wages from them that I might serve you.",
      "ko": "내가 너희를 섬기기 위하여 다른 여러 교회에서 요를 받은 것이 탈취한 것이라",
      "source_text_hash": "e1a1d6f23235401c98109972393c9250792a8bbceefb1a91c4fdf6e1b963b77f",
      "translation_text_hash": "fa692bf1e61d69de151299a2f78988f9f99be180669724eb9bd87f784ddb25a6",
      "translation_policy": "krv-1961-source-mapped",
