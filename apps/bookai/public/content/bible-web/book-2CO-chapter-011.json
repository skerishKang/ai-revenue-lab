      "source_text_hash": "301714e476227faa0169541b7714a085562f3696ac3a12ceedecfc3bdbf79ac8",
      "translation_text_hash": "7a49a3e50efb8f59395382cc976dc978a1c1ee7bccebe7d346ae070fa3228156",
      "translation_policy": "krv-1961-source-mapped",
