      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이것이 이상한 일이 아니라 사단도 자기를 광명의 천사로 가장하나니"
      ],
      "raw_text_hashes": [
        "1ebe0e2f3613e475139478ce9ee2c5e0c187dd3c986e01f3b04d6628d20c931a"
      ]
    },
    {
