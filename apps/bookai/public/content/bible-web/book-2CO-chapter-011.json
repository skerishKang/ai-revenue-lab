      ],
      "en": "For I reckon that I am not at all behind the very best apostles.",
      "ko": "내가 지극히 큰 사도들보다 부족한 것이 조금도 없는줄 생각하노라",
      "source_text_hash": "b4cc5fd66be7b63cdc1acd3d8c573a8cb96e4b0de9389b741bd8572948ccbfac",
      "translation_text_hash": "6ec51250952c65ca1d18491c7c96881d5fc6282b8aac19b5ccff51edb27cca0e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 지극히 큰 사도들보다 부족한 것이 조금도 없는줄 생각하노라"
      ],
      "raw_text_hashes": [
        "6ec51250952c65ca1d18491c7c96881d5fc6282b8aac19b5ccff51edb27cca0e"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:11:6",
      "sequence": 28992,
      "chapter_label": "2CO 11",
      "verse_label": "6",
      "locator": {
