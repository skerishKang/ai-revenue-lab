        "verse": 10
      },
      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 11,
          "verse": 10
        }
      ],
      "en": "As the truth of Christ is in me, no one will stop me from this boasting in the regions of Achaia.",
      "ko": "그리스도의 진리가 내 속에 있으니 아가야 지방에서 나의 이 자랑이 막히지 아니하리라",
      "source_text_hash": "6df3e290d584c1d97fc131efa93e674f4c9b1ae492c9e4f6242e89d9723dc99c",
      "translation_text_hash": "e8bdb048b7d08919c40908a2c45833e20438df3f5076587e431955f0e5f5ae6e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그리스도의 진리가 내 속에 있으니 아가야 지방에서 나의 이 자랑이 막히지 아니하리라"
      ],
      "raw_text_hashes": [
        "e8bdb048b7d08919c40908a2c45833e20438df3f5076587e431955f0e5f5ae6e"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:11:11",
      "sequence": 28997,
      "chapter_label": "2CO 11",
      "verse_label": "11",
