      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 11,
          "verse": 26
        }
      ],
      "en": "I have been in travels often, perils of rivers, perils of robbers, perils from my countrymen, perils from the Gentiles, perils in the city, perils in the wilderness, perils in the sea, perils among false brothers;",
      "ko": "여러번 여행에 강의 위험과 강도의 위험과 동족의 위험과 이방인의 위험과 시내의 위험과 광야의 위험과 바다의 위험과 거짓 형제 중의 위험을 당하고",
      "source_text_hash": "5f7faa1a72433a90d8e5bb8121b40b79662fc0d9117537130c2f80ac0dd1a6da",
      "translation_text_hash": "e4cc8bfdf3ef4e308fffdc8a5820f451feff74902ac9e4b943dbc376a7f26a90",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
