        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 34,
          "verse": 10
        }
      ],
      "en": "It won’t be quenched night or day. Its smoke will go up forever. From generation to generation, it will lie waste. No one will pass through it forever and ever.",
      "ko": "낮에나 밤에나 꺼지지 않고 그 연기가 끊임 없이 떠오를 것이며 세세에 황무하여 그리로 지날 자가 영영히 없겠고",
      "source_text_hash": "27dd7a1c9f5620b0a1b9d03547157d56965d45cb3223ac15db50a75f78fdba13",
      "translation_text_hash": "053f434e9ec64c07b76660f8dd4f11af74ecf63b5bb880d0e3c66b64e64f6945",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "낮에나 밤에나 꺼지지 않고 그 연기가 끊임 없이 떠오를 것이며 세세에 황무하여 그리로 지날 자가 영영히 없겠고"
      ],
      "raw_text_hashes": [
        "053f434e9ec64c07b76660f8dd4f11af74ecf63b5bb880d0e3c66b64e64f6945"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:34:11",
      "sequence": 18315,
      "chapter_label": "ISA 34",
      "verse_label": "11",
      "locator": {
