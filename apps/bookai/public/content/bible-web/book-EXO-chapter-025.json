      "raw_text_hashes": [
        "ead674300f376af58b4e3288b5eaad354076d7d9a7604e879ec3c8676afecaae"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:25:19",
      "sequence": 2215,
      "chapter_label": "EXO 25",
      "verse_label": "19",
