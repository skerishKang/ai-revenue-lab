      "ko": "조각목으로 채를 만들고 금으로 싸고",
      "source_text_hash": "710fcc343a1a69ee50983fe6bc22f72a05a3ec12168bfa1efcd12d193e20f68c",
      "translation_text_hash": "6cbf0689e11cff3b2886aaf18556fdc50843e428c5ed63bbfe90dbf47556c73d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "조각목으로 채를 만들고 금으로 싸고"
      ],
      "raw_text_hashes": [
        "6cbf0689e11cff3b2886aaf18556fdc50843e428c5ed63bbfe90dbf47556c73d"
      ]
    },
    {
