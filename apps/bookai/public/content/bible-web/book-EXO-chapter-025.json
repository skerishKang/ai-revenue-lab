        "verse": 16
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 25,
          "verse": 16
        }
      ],
      "en": "You shall put the covenant which I shall give you into the ark.",
      "ko": "내가 네게 줄 증거판을 궤 속에 둘찌며",
