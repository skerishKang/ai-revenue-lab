        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 25,
          "verse": 11
        }
      ],
      "en": "You shall overlay it with pure gold. You shall overlay it inside and outside, and you shall make a gold molding around it.",
      "ko": "너는 정금으로 그것을 싸되 그 안팎을 싸고 윗가로 돌아가며 금테를 두르고",
      "source_text_hash": "6461cd6355517759f6c7f4f7e7c6c0cfe13f4bb4fd2065e0f91e3369900a552b",
      "translation_text_hash": "9a148676162074d8e5082918a9eb2ea9aaf0c72e12a2321d520137573c0c7eac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 정금으로 그것을 싸되 그 안팎을 싸고 윗가로 돌아가며 금테를 두르고"
      ],
      "raw_text_hashes": [
        "9a148676162074d8e5082918a9eb2ea9aaf0c72e12a2321d520137573c0c7eac"
      ]
    },
    {
