      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 25,
          "verse": 21
        }
      ],
      "en": "You shall put the mercy seat on top of the ark, and in the ark you shall put the covenant that I will give you.",
      "ko": "속죄소를 궤 위에 얹고 내가 네게 줄 증거판을 궤 속에 넣으라",
      "source_text_hash": "691339afe24f60a2ab0b6a25ea77924a82dc554ef0f7471261bb76f22bfcab16",
      "translation_text_hash": "4803ae2350264350bcb4d924a0fba7c9e22cb90be02343f7092612a481db800f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "속죄소를 궤 위에 얹고 내가 네게 줄 증거판을 궤 속에 넣으라"
      ],
      "raw_text_hashes": [
        "4803ae2350264350bcb4d924a0fba7c9e22cb90be02343f7092612a481db800f"
      ]
    },
    {
