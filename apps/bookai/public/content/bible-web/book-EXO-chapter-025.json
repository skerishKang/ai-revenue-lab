      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 25,
          "verse": 25
        }
      ],
      "en": "You shall make a rim of a hand width around it. You shall make a golden molding on its rim around it.",
      "ko": "그 사면에 손바닥 넓이만한 턱을 만들고 그 턱 주위에 금으로 테를 만들고",
      "source_text_hash": "390b50a8ca81e90e960dbc91bb88b24f02099d6e67d19a3ee772d97824a40944",
      "translation_text_hash": "42ee40ad37b72986870a338e830e27c5d85c1d0173c7623c781a8870ae9a5bfe",
