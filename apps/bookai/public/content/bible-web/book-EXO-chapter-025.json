      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 25,
          "verse": 8
        }
      ],
      "en": "Let them make me a sanctuary, that I may dwell among them.",
      "ko": "내가 그들 중에 거할 성소를 그들을 시켜 나를 위하여 짓되",
      "source_text_hash": "76cb87d40b0cd5d39f32a2ce866b85a69fec09e0b295d7a74cd6ba1784e51836",
      "translation_text_hash": "149f56902f688d5e4d462027939bdc23aad532a14ab282a2d4aa4965c3bb5cb9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 그들 중에 거할 성소를 그들을 시켜 나를 위하여 짓되"
      ],
      "raw_text_hashes": [
        "149f56902f688d5e4d462027939bdc23aad532a14ab282a2d4aa4965c3bb5cb9"
      ]
