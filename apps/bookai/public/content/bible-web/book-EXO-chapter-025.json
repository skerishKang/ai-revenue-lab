      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 25,
          "verse": 9
        }
      ],
      "en": "According to all that I show you, the pattern of the tabernacle, and the pattern of all of its furniture, even so you shall make it.",
      "ko": "무릇 내가 네게 보이는대로 장막의 식양과 그 기구의 식양을 따라 지을찌니라",
      "source_text_hash": "458a5876a541eca5f35958a2755ab2f199f79cb95446f81a88cc32614b971d12",
      "translation_text_hash": "863160fcd5d2bf8d18978ee2d2cc94235a20309dff034d66355f48fccf6cd0cd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 내가 네게 보이는대로 장막의 식양과 그 기구의 식양을 따라 지을찌니라"
      ],
      "raw_text_hashes": [
        "863160fcd5d2bf8d18978ee2d2cc94235a20309dff034d66355f48fccf6cd0cd"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:25:10",
