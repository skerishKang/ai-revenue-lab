      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사면에 손바닥 넓이만한 턱을 만들고 그 턱 주위에 금으로 테를 만들고"
      ],
      "raw_text_hashes": [
        "42ee40ad37b72986870a338e830e27c5d85c1d0173c7623c781a8870ae9a5bfe"
