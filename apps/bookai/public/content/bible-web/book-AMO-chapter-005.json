      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "마치 사람이 사자를 피하다가 곰을 만나거나 혹 집에 들어가서 손을 벽에 대었다가 뱀에게 물림 같도다"
      ],
      "raw_text_hashes": [
