      ],
      "en": "Listen to this word which I take up for a lamentation over you, O house of Israel:",
      "ko": "이스라엘 족속아 내가 너희에게 대하여 애가로 지은 이 말을 들으라",
      "source_text_hash": "1650eb442e6bd94574ed8909f6ff51a7fdff5b26d8d08135eda681d9dba3ecf9",
      "translation_text_hash": "bb631e1c8d34f9794b417d135cd26ef1dc4a81373a329ada3cb1598377e27579",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 족속아 내가 너희에게 대하여 애가로 지은 이 말을 들으라"
      ],
      "raw_text_hashes": [
        "bb631e1c8d34f9794b417d135cd26ef1dc4a81373a329ada3cb1598377e27579"
      ]
    },
    {
      "canonical_locator": "bible:web:AMO:5:2",
      "sequence": 22426,
      "chapter_label": "AMO 5",
