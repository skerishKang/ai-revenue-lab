      "source_text_hash": "406db4e3c84b9cb1989bd68e58907bdec2be057cf6a15530846fd96eff466b93",
      "translation_text_hash": "586fd957b111bfddca86758ae41c76976fa804256d4ca9562f6a4d99a9e45b47",
