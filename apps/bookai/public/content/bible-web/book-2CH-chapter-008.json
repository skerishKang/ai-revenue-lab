        {
          "book": "2CH",
          "chapter": 8,
          "verse": 3
        }
      ],
      "en": "Solomon went to Hamath Zobah, and prevailed against it.",
      "ko": "솔로몬이 가서 하맛소바를 쳐서 취하고",
      "source_text_hash": "7ff011ef43fe2b5131b64e6af050c29cbd4318dfa9f1067dd5d465a239fccc89",
      "translation_text_hash": "3ff708461f3fd0ac89eb05d15a32793e86a91c196b1fccc12b95e1c64f72875f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "솔로몬이 가서 하맛소바를 쳐서 취하고"
      ],
      "raw_text_hashes": [
        "3ff708461f3fd0ac89eb05d15a32793e86a91c196b1fccc12b95e1c64f72875f"
      ]
