        "verse": 2
      },
      "raw_locator": [
        {
          "book": "HAG",
          "chapter": 2,
          "verse": 2
        }
      ],
      "en": "“Speak now to Zerubbabel the son of Shealtiel, governor of Judah, and to Joshua the son of Jehozadak, the high priest, and to the remnant of the people, saying,",
      "ko": "너는 스알디엘의 아들 유다 총독 스룹바벨과 여호사닥의 아들 대제사장 여호수아와 남은 백성에게 고하여 이르라",
      "source_text_hash": "aeaf8cc3676191089fe5e183dc2caaa24be3e57e4bbcda1ef3be628ec4b588da",
      "translation_text_hash": "e572bf599ad0cf8e8312f655df2da3361d26e96a2fab78e745f2ee4a493e6311",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 스알디엘의 아들 유다 총독 스룹바벨과 여호사닥의 아들 대제사장 여호수아와 남은 백성에게 고하여 이르라"
      ],
      "raw_text_hashes": [
        "e572bf599ad0cf8e8312f655df2da3361d26e96a2fab78e745f2ee4a493e6311"
      ]
    },
    {
      "canonical_locator": "bible:web:HAG:2:3",
      "sequence": 22859,
      "chapter_label": "HAG 2",
      "verse_label": "3",
