      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "레위 사람은 다윗의 악기를 잡고 제사장은 나팔을 잡고 서매"
      ],
      "raw_text_hashes": [
        "813731f03b0aeed8c1289d4c74c1ecf3295859524559fdbfbf0d26617d18f52f"
