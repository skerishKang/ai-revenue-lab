      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 29,
          "verse": 3
        }
      ],
      "en": "In the first year of his reign, in the first month, he opened the doors of the LORD’s house and repaired them.",
      "ko": "원년 정월에 여호와의 전 문들을 열고 수리하고",
      "source_text_hash": "51c9f46089d396772284f683c87bd9a748b3b8e88e918815db6b1059873b6dcb",
      "translation_text_hash": "bfada5a6c2f6dbab8ab5d2f8cae48b7deb87c41057a6218ae42681d599bc1c52",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "원년 정월에 여호와의 전 문들을 열고 수리하고"
      ],
      "raw_text_hashes": [
        "bfada5a6c2f6dbab8ab5d2f8cae48b7deb87c41057a6218ae42681d599bc1c52"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:29:4",
      "sequence": 11796,
      "chapter_label": "2CH 29",
