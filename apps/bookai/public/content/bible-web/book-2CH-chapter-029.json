        "verse": 4
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 29,
          "verse": 4
        }
      ],
      "en": "He brought in the priests and the Levites and gathered them together into the wide place on the east,",
      "ko": "제사장들과 레위 사람들을 동편 광장에 모으고",
      "source_text_hash": "4e3db03b3b23288421f11aff7a23488490b5e9e2eeab73dafeccad4013888461",
      "translation_text_hash": "aa13286ba773165f10922c9e0b84c484dda16b25c39d2a736fa3931afe8718b7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제사장들과 레위 사람들을 동편 광장에 모으고"
      ],
      "raw_text_hashes": [
        "aa13286ba773165f10922c9e0b84c484dda16b25c39d2a736fa3931afe8718b7"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:29:5",
      "sequence": 11797,
      "chapter_label": "2CH 29",
      "verse_label": "5",
      "locator": {
