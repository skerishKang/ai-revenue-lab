      "source_text_hash": "85ce46c1e08eda1c1854c009d05480b11b79a5c7173ba206cff9f15f68d5c844",
      "translation_text_hash": "4af00c00b28dbdd1189037db116d13d947f82afa38febf13da36e46fc4ca723d",
      "translation_policy": "krv-1961-source-mapped",
