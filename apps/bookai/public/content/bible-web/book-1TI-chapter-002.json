      ],
      "en": "For this is good and acceptable in the sight of God our Savior,",
      "ko": "이것이 우리 구주 하나님 앞에 선하고 받으실만한 것이니",
      "source_text_hash": "535267a1d07e03046c369c84343e32953b5d10017e6869242ff6c94fc0f8e940",
      "translation_text_hash": "a5fc22221973e1c2947f57345a507fedfd8ca9ebf28b754e0d9d7c16eec57f09",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이것이 우리 구주 하나님 앞에 선하고 받으실만한 것이니"
      ],
      "raw_text_hashes": [
        "a5fc22221973e1c2947f57345a507fedfd8ca9ebf28b754e0d9d7c16eec57f09"
      ]
    },
