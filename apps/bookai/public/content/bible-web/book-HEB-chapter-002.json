      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 2,
          "verse": 7
        }
      ],
      "en": "You made him a little lower than the angels. You crowned him with glory and honor.",
      "ko": "저를 잠간 동안 천사보다 못하게 하시며 영광과 존귀로 관 씌우시며",
      "source_text_hash": "1fdaf1ff4b9ef723f83fb734ffdcea3c89c2a7afcbc9e899ed905c08bdb326df",
      "translation_text_hash": "b8974960b3646fbcb58a93eb99554696e5d6a40354dcfeeb084d170565fb071c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저를 잠간 동안 천사보다 못하게 하시며 영광과 존귀로 관 씌우시며"
      ],
      "raw_text_hashes": [
        "b8974960b3646fbcb58a93eb99554696e5d6a40354dcfeeb084d170565fb071c"
      ]
    },
    {
