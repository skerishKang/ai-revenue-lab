        }
      ],
      "en": "His work is honor and majesty. His righteousness endures forever.",
      "ko": "그 행사가 존귀하고 엄위하며 그 의가 영원히 있도다",
      "source_text_hash": "10e1cd0babda51015a1796c51bede4a818f3d05260fcd6efd6597aafbc1c8b5a",
      "translation_text_hash": "e9286ed6ec06cc40252e7bbbec1fa119955af1ea6058cd355bd8b7074e9b57ab",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 행사가 존귀하고 엄위하며 그 의가 영원히 있도다"
      ],
      "raw_text_hashes": [
        "e9286ed6ec06cc40252e7bbbec1fa119955af1ea6058cd355bd8b7074e9b57ab"
      ]
    },
    {
