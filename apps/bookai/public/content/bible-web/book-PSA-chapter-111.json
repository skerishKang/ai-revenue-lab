        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 111,
          "verse": 8
        }
      ],
      "en": "They are established forever and ever. They are done in truth and uprightness.",
      "ko": "영원 무궁히 정하신바요 진실과 정의로 행하신 바로다",
      "source_text_hash": "47933f27e116274deb06b316353a45eaabe5cbe051f6d7f8ad2c4d7bc3081e6b",
      "translation_text_hash": "f560a602576f4a59fed7a38364cb50a5a94379380555bc5849771bdb7fd1e391",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "영원 무궁히 정하신바요 진실과 정의로 행하신 바로다"
      ],
      "raw_text_hashes": [
        "f560a602576f4a59fed7a38364cb50a5a94379380555bc5849771bdb7fd1e391"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:111:9",
      "sequence": 15803,
      "chapter_label": "PSA 111",
      "verse_label": "9",
      "locator": {
        "book": "PSA",
        "chapter": 111,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 111,
          "verse": 9
        }
      ],
      "en": "He has sent redemption to his people. He has ordained his covenant forever. His name is holy and awesome!",
      "ko": "여호와께서 그 백성에게 구속을 베푸시며 그 언약을 영원히 세우셨으니 그 이름이 거룩하고 지존하시도다",
      "source_text_hash": "cf21816b658c37824f1e427f7f99872514b34883b37f20c5d9b848d38818b1fc",
      "translation_text_hash": "f3432024ff9950ad7edae2fd1a2e4453edf90d0cf316d5901cecbdfe31ff5534",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 그 백성에게 구속을 베푸시며 그 언약을 영원히 세우셨으니 그 이름이 거룩하고 지존하시도다"
      ],
      "raw_text_hashes": [
        "f3432024ff9950ad7edae2fd1a2e4453edf90d0cf316d5901cecbdfe31ff5534"
      ]
