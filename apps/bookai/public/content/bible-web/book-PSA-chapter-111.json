      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 111,
          "verse": 7
        }
      ],
      "en": "The works of his hands are truth and justice. All his precepts are sure.",
      "ko": "그 손의 행사는 진실과 공의며 그 법도는 다 확실하니",
      "source_text_hash": "b7761ce3ae197c31218f8ad874713ea1fcfc3f08f627e2b3a87aa5a1ce5fb187",
      "translation_text_hash": "8cab5aa43b384395d9acad0c0ed5515f74785fbfe0e6e831fe1aefcb95c75710",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 손의 행사는 진실과 공의며 그 법도는 다 확실하니"
      ],
      "raw_text_hashes": [
        "8cab5aa43b384395d9acad0c0ed5515f74785fbfe0e6e831fe1aefcb95c75710"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:111:8",
      "sequence": 15802,
      "chapter_label": "PSA 111",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
