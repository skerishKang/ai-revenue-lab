      "source_text_hash": "da09699136f1cd44e27fe7149d9209cee45389d65d82776ac282598bc848db2b",
      "translation_text_hash": "1b3999241e07f50ba87e6e0b73539ff7f475cd2aa96864c8e21baa10ce0acd98",
