    {
      "canonical_locator": "bible:web:JER:6:10",
      "sequence": 19100,
      "chapter_label": "JER 6",
      "verse_label": "10",
      "locator": {
        "book": "JER",
        "chapter": 6,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 6,
          "verse": 10
        }
      ],
      "en": "To whom should I speak and testify, that they may hear? Behold, their ear is uncircumcised, and they can’t listen. Behold, the LORD’s word has become a reproach to them. They have no delight in it.",
      "ko": "내가 누구에게 말하며 누구에게 경책하여 듣게 할꼬 보라 그 귀가 할례를 받지 못하였으므로 듣지 못하는도다 보라 여호와의 말씀을 그들이 자기에게 욕으로 여기고 이를 즐겨 아니하니",
      "source_text_hash": "0e748710ebff65cd23beb2b87c8b47620187bac368bb3df8a4b98da894b1cb56",
      "translation_text_hash": "6cce41a15717bd4ae3dd9d0e4780b8dcbfb74e18286f148ea95743a9f82ff91e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 누구에게 말하며 누구에게 경책하여 듣게 할꼬 보라 그 귀가 할례를 받지 못하였으므로 듣지 못하는도다 보라 여호와의 말씀을 그들이 자기에게 욕으로 여기고 이를 즐겨 아니하니"
      ],
      "raw_text_hashes": [
        "6cce41a15717bd4ae3dd9d0e4780b8dcbfb74e18286f148ea95743a9f82ff91e"
      ]
