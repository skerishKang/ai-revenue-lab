      "source_text_hash": "17bd5e434875082296b01c581dcf38793316ed9a9d6e365fba7525572d9f19f2",
      "translation_text_hash": "84ae5e5e0fe27bc215eeb2098534fd1dd07ffc24f5e17acf90f10c513b1f815c",
