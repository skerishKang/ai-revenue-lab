      "raw_locator": [
        {
          "book": "1JN",
          "chapter": 1,
          "verse": 5
        }
      ],
      "en": "This is the message which we have heard from him and announce to you, that God is light, and in him is no darkness at all.",
      "ko": "우리가 저에게서 듣고 너희에게 전하는 소식이 이것이니 곧 하나님은 빛이시라 그에게는 어두움이 조금도 없으시니라",
      "source_text_hash": "d1c5a4e56d332bbbbbc89c498ea4942d952f07d65fcc7439b553830d575e0ee7",
      "translation_text_hash": "fc3da7d17410050006bbfeca5c07701745440b8839ae083c97b39853fcd158bd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 저에게서 듣고 너희에게 전하는 소식이 이것이니 곧 하나님은 빛이시라 그에게는 어두움이 조금도 없으시니라"
      ],
      "raw_text_hashes": [
        "fc3da7d17410050006bbfeca5c07701745440b8839ae083c97b39853fcd158bd"
      ]
    },
    {
      "canonical_locator": "bible:web:1JN:1:6",
      "sequence": 30543,
