      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "태초부터 있는 생명의 말씀에 관하여는 우리가 들은 바요 눈으로 본 바요 주목하고 우리 손으로 만진 바라"
      ],
      "raw_text_hashes": [
