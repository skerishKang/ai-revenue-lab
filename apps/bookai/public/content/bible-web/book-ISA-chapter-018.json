      ],
      "en": "Ah, the land of the rustling of wings, which is beyond the rivers of Ethiopia;",
      "ko": "슬프다 구스의 강 건너편 날개치는 소리 나는 땅이여",
      "source_text_hash": "afd031a851cd0536e7258a15b840e74b38a5964a74b7d6cce9dc0d0c5a9dce73",
      "translation_text_hash": "0de0adb579dca7f1b6361ef49385bbfd7cb15256452e7d46d38a6b491355441a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "슬프다 구스의 강 건너편 날개치는 소리 나는 땅이여"
      ],
      "raw_text_hashes": [
        "0de0adb579dca7f1b6361ef49385bbfd7cb15256452e7d46d38a6b491355441a"
      ]
    },
    {
