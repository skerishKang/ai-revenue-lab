      "source_text_hash": "2bfe3e4df8f87b408958bf04436c11c17c6d681d018adce7641346f240157cc1",
      "translation_text_hash": "c2a9298be7fb05b2881b0b8e096a0b24606134571bc0013d4956f90ac011fbf8",
