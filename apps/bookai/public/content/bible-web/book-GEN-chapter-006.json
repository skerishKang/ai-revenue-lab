      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 6,
          "verse": 6
        }
      ],
      "en": "The LORD was sorry that he had made man on the earth, and it grieved him in his heart.",
      "ko": "땅위에 사람 지으셨음을 한탄하사 마음에 근심하시고",
      "source_text_hash": "30031656b3c31c7defbcb33567d85cc4f896999bdbcb114bc390e810d2859a11",
      "translation_text_hash": "477a134ddf73cecd6830b21ecaf73fa33f37bd30812bf34b6bf9b1ffc0fddd5f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "땅위에 사람 지으셨음을 한탄하사 마음에 근심하시고"
      ],
      "raw_text_hashes": [
        "477a134ddf73cecd6830b21ecaf73fa33f37bd30812bf34b6bf9b1ffc0fddd5f"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:6:7",
      "sequence": 145,
      "chapter_label": "GEN 6",
      "verse_label": "7",
      "locator": {
