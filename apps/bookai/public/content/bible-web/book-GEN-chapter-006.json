      ],
      "en": "When men began to multiply on the surface of the ground, and daughters were born to them,",
      "ko": "사람이 땅위에 번성하기 시작할 때에 그들에게서 딸들이 나니",
      "source_text_hash": "3c4ef613844b320fea331080fc40c2cf0229ef66c442d8524739f136b3fddef3",
      "translation_text_hash": "f72efb1cdf8b9e6902560ec8f8ebe200ff0bce28cc17b01bca3d618a6af6cc61",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 땅위에 번성하기 시작할 때에 그들에게서 딸들이 나니"
      ],
      "raw_text_hashes": [
        "f72efb1cdf8b9e6902560ec8f8ebe200ff0bce28cc17b01bca3d618a6af6cc61"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:6:2",
      "sequence": 140,
      "chapter_label": "GEN 6",
      "verse_label": "2",
      "locator": {
        "book": "GEN",
