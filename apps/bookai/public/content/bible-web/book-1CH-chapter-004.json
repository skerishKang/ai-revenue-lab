      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 4,
          "verse": 11
        }
      ],
      "en": "Chelub the brother of Shuhah became the father of Mehir, who was the father of Eshton.",
      "ko": "수하의 형 글룹이 므힐을 낳았으니 므힐은 에스돈의 아비요",
      "source_text_hash": "7b2a523f22a338f4ac36ee826f7e04f1d3215aec4e374b3603d82a3eec9f2e64",
      "translation_text_hash": "e36cedb8ec00285a7cdf1bb10c5b56b55b264ba83c6887617baef7c574193c68",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "수하의 형 글룹이 므힐을 낳았으니 므힐은 에스돈의 아비요"
      ],
      "raw_text_hashes": [
        "e36cedb8ec00285a7cdf1bb10c5b56b55b264ba83c6887617baef7c574193c68"
      ]
    },
