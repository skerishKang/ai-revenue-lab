      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그돌의 아비 브누엘과 후사의 아비 에셀이니 이는 다 베들레헴의 아비 에브라다의 맏아들 훌의 소생이며"
      ],
      "raw_text_hashes": [
