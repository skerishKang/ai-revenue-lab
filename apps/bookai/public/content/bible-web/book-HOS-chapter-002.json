    {
      "canonical_locator": "bible:web:HOS:2:8",
      "sequence": 22114,
      "chapter_label": "HOS 2",
      "verse_label": "8",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 8
        }
      ],
      "en": "For she didn’t know that I gave her the grain, the new wine, and the oil, and multiplied to her silver and gold, which they used for Baal.",
      "ko": "곡식과 새 포도주와 기름은 내가 저에게 준 것이요 저희가 바알을 위하여 쓴 은과 금도 내가 저에게 더하여 준 것이어늘 저가 알지 못하도다",
      "source_text_hash": "6f1d3e5d875dfa8792370a0c2d425a219baf38ead5c6e3004f21dd12ef565c94",
      "translation_text_hash": "f30505a4c611f5884b8e30a2366d23ffc0dc22130880d9abdb2918cf8fd048fa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "곡식과 새 포도주와 기름은 내가 저에게 준 것이요 저희가 바알을 위하여 쓴 은과 금도 내가 저에게 더하여 준 것이어늘 저가 알지 못하도다"
      ],
      "raw_text_hashes": [
        "f30505a4c611f5884b8e30a2366d23ffc0dc22130880d9abdb2918cf8fd048fa"
      ]
