      "raw_texts": [
        "그러므로 내가 저를 개유하여 거친 들로 데리고 가서 말로 위로하고"
      ],
      "raw_text_hashes": [
        "a39211f5cbf6c69b2e0f343d63fd0154846f528189776499f6003c6ec784bf27"
