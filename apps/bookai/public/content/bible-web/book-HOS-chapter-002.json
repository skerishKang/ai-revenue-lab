          "book": "HOS",
          "chapter": 2,
          "verse": 1
        }
      ],
      "en": "“Say to your brothers, ‘My people!’ and to your sisters, ‘My loved one!’",
      "ko": "너희 형제에게는 암미라 하고 너희 자매에게는 루하마라 하라",
      "source_text_hash": "5d577dcb5ad2185ec5f394fffb86e20418e6b85b277f3f5979b85bb34ca16296",
      "translation_text_hash": "46572bb73b0088b03dd6f00cc675aa627a16daa047415a6eac7f7c4aee7a6df7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 형제에게는 암미라 하고 너희 자매에게는 루하마라 하라"
      ],
      "raw_text_hashes": [
        "46572bb73b0088b03dd6f00cc675aa627a16daa047415a6eac7f7c4aee7a6df7"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:2",
      "sequence": 22108,
      "chapter_label": "HOS 2",
      "verse_label": "2",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 2
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 2
        }
      ],
      "en": "Contend with your mother! Contend, for she is not my wife, neither am I her husband; and let her put away her prostitution from her face, and her adulteries from between her breasts;",
      "ko": "너희 어미와 쟁론하고 쟁론하라 저는 내 아내가 아니요 나는 저의 남편이 아니라 저로 그 얼굴에서 음란을 제하게 하고 그 유방 사이에서 음행을 제하게 하라",
      "source_text_hash": "afa80b0042865e02fec3c0c75c231ff73516696897afc8d93158632da847c377",
      "translation_text_hash": "d638c1b26e6ecf62caecf1b43f02f8b0e59ad8347670119f916db2679a76c18a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 어미와 쟁론하고 쟁론하라 저는 내 아내가 아니요 나는 저의 남편이 아니라 저로 그 얼굴에서 음란을 제하게 하고 그 유방 사이에서 음행을 제하게 하라"
      ],
      "raw_text_hashes": [
        "d638c1b26e6ecf62caecf1b43f02f8b0e59ad8347670119f916db2679a76c18a"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:3",
      "sequence": 22109,
      "chapter_label": "HOS 2",
