        "chapter": 2,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 3
        }
      ],
      "en": "lest I strip her naked, and make her bare as in the day that she was born, and make her like a wilderness, and set her like a dry land, and kill her with thirst.",
      "ko": "그렇지 아니하면 내가 저를 벌거벗겨서 그 나던 날과 같게 할 것이요 저로 광야 같이 되게 하며 마른 땅 같이 되게 하여 목말라 죽게 할것이며",
      "source_text_hash": "90555e17160a957aa33caf57bcaceeef0cba8eb343ce3165cd88ae07f962c0d6",
      "translation_text_hash": "a218253db702cf2cf4d0f7bc66f589534f89316fde0b9684261ad50191359904",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그렇지 아니하면 내가 저를 벌거벗겨서 그 나던 날과 같게 할 것이요 저로 광야 같이 되게 하며 마른 땅 같이 되게 하여 목말라 죽게 할것이며"
      ],
      "raw_text_hashes": [
        "a218253db702cf2cf4d0f7bc66f589534f89316fde0b9684261ad50191359904"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:4",
      "sequence": 22110,
      "chapter_label": "HOS 2",
      "verse_label": "4",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 4
        }
      ],
      "en": "Indeed, on her children I will have no mercy, for they are children of unfaithfulness.",
      "ko": "내가 그 자녀를 긍휼히 여기지 아니하리니 이는 저희가 음란한 자식들임이니라",
      "source_text_hash": "27ebcb27512ffe5bbe15dd3ee5398e28752755091e38f0fa200f00c081cacd7c",
      "translation_text_hash": "bc036c7a61e4d80914d13981a924014041f6769ec0efa4cc4b2b6c1ffc589f4f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 그 자녀를 긍휼히 여기지 아니하리니 이는 저희가 음란한 자식들임이니라"
      ],
      "raw_text_hashes": [
        "bc036c7a61e4d80914d13981a924014041f6769ec0efa4cc4b2b6c1ffc589f4f"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:5",
      "sequence": 22111,
      "chapter_label": "HOS 2",
      "verse_label": "5",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 5
        }
      ],
      "en": "For their mother has played the prostitute. She who conceived them has done shamefully; for she said, ‘I will go after my lovers, who give me my bread and my water, my wool and my flax, my oil and my drink.’",
      "ko": "저희의 어미는 행음하였고 저희를 배었던 자가 부끄러운 일을 행하였나니 대저 저가 이르기를 나는 나를 연애하는 자들을 따르리니 저희가 내 떡과 내 물과 내 양털과 내 삼과 내 기름과 내 술들을 내게 준다 하였느니라",
      "source_text_hash": "b09e117754d3d626cc5571a814f4619cf88b421ed999e310d7c269e3b42ff779",
      "translation_text_hash": "42287788f0fb7617c407f848cdad86d4c781b38ef9d5c85a0d82ff7477f5ece8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희의 어미는 행음하였고 저희를 배었던 자가 부끄러운 일을 행하였나니 대저 저가 이르기를 나는 나를 연애하는 자들을 따르리니 저희가 내 떡과 내 물과 내 양털과 내 삼과 내 기름과 내 술들을 내게 준다 하였느니라"
      ],
      "raw_text_hashes": [
        "42287788f0fb7617c407f848cdad86d4c781b38ef9d5c85a0d82ff7477f5ece8"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:6",
      "sequence": 22112,
      "chapter_label": "HOS 2",
      "verse_label": "6",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 6
        }
      ],
      "en": "Therefore behold, I will hedge up your way with thorns, and I will build a wall against her, that she can’t find her way.",
      "ko": "그러므로 내가 가시로 그 길을 막으며 담을 쌓아 저로 그 길을 찾지 못하게 하리니",
      "source_text_hash": "7aad9bb8ac6a9596fe34ef98fa5c104bb3da0d728a8859f2472b16a3fa340484",
      "translation_text_hash": "f3cb31d4fa1e61f996e37f2ada581fee5606f41c63abae5c1cb8ff4f54d92678",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 내가 가시로 그 길을 막으며 담을 쌓아 저로 그 길을 찾지 못하게 하리니"
      ],
      "raw_text_hashes": [
        "f3cb31d4fa1e61f996e37f2ada581fee5606f41c63abae5c1cb8ff4f54d92678"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:7",
      "sequence": 22113,
      "chapter_label": "HOS 2",
      "verse_label": "7",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 7
        }
      ],
      "en": "She will follow after her lovers, but she won’t overtake them; and she will seek them, but won’t find them. Then she will say, ‘I will go and return to my first husband, for then it was better with me than now.’",
      "ko": "저가 그 연애하는 자를 따라 갈찌라도 미치지 못하며 저희를 찾을찌라도 만나지 못할 것이라 그제야 저가 이르기를 내가 본 남편에게로 돌아가리니 그 때의 내 형편이 지금보다 나았음이라 하리라",
      "source_text_hash": "2077dba36953fb31f149db56ed8fd8db91e8fd43141f39097c90407129c74c79",
      "translation_text_hash": "1c1a6b950934fd646988f76ec5fbe4a7972ecb9db5a9b887d99de470a4f61fcf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 그 연애하는 자를 따라 갈찌라도 미치지 못하며 저희를 찾을찌라도 만나지 못할 것이라 그제야 저가 이르기를 내가 본 남편에게로 돌아가리니 그 때의 내 형편이 지금보다 나았음이라 하리라"
      ],
      "raw_text_hashes": [
        "1c1a6b950934fd646988f76ec5fbe4a7972ecb9db5a9b887d99de470a4f61fcf"
