        "verse": 11
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 11
        }
      ],
      "en": "I will also cause all her celebrations to cease: her feasts, her new moons, her Sabbaths, and all her solemn assemblies.",
      "ko": "내가 그 모든 희락과 절기와 월삭과 안식일과 모든 명절을 폐하겠고",
      "source_text_hash": "9a92f56323f7fd317e89056593d9b2186ffc884b551698c660e20d0794a13c37",
      "translation_text_hash": "6ead1783946979e3f4e9f6361b436cb79f7e98d0b57458dc06551353f956df5b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 그 모든 희락과 절기와 월삭과 안식일과 모든 명절을 폐하겠고"
      ],
      "raw_text_hashes": [
        "6ead1783946979e3f4e9f6361b436cb79f7e98d0b57458dc06551353f956df5b"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:12",
      "sequence": 22118,
      "chapter_label": "HOS 2",
      "verse_label": "12",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 12
        }
      ],
      "en": "I will lay waste her vines and her fig trees, about which she has said, ‘These are my wages that my lovers have given me,’ and I will make them a forest, and the animals of the field shall eat them.",
      "ko": "저가 전에 이르기를 이것은 나를 연애하는 자들이 내게 준 값이라 하던 그 포도나무와 무화과나무를 거칠게 하여 수풀이 되게 하며 들짐승들로 먹게 하리라",
      "source_text_hash": "6e1c00bb5929316b155dde1cbfb060577527e757c22479a668f215cfccb5f401",
      "translation_text_hash": "fde32d1babe203d6bc536aa51cdfa165ae3cee696572e77064632eca3c3aecb5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 전에 이르기를 이것은 나를 연애하는 자들이 내게 준 값이라 하던 그 포도나무와 무화과나무를 거칠게 하여 수풀이 되게 하며 들짐승들로 먹게 하리라"
      ],
      "raw_text_hashes": [
        "fde32d1babe203d6bc536aa51cdfa165ae3cee696572e77064632eca3c3aecb5"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:2:13",
      "sequence": 22119,
      "chapter_label": "HOS 2",
      "verse_label": "13",
      "locator": {
        "book": "HOS",
        "chapter": 2,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 2,
          "verse": 13
        }
      ],
      "en": "I will visit on her the days of the Baals, to which she burned incense when she decked herself with her earrings and her jewels, and went after her lovers and forgot me,” says the LORD.",
      "ko": "저가 귀고리와 패물로 장식하고 그 연애하는 자를 따라가서 나를 잊어버리고 향을 살라 바알들을 섬긴 시일을 따라 내가 저에게 벌을 주리라 나 여호와의 말이니라",
      "source_text_hash": "13950e1df2a140d1341e07a084aacf806544c577fa7dfa22c2de3d384c6a05b5",
      "translation_text_hash": "7596a9de119219d287c7fd2e2aaaf014d186af6b4da0a5ae832b9066a0208922",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 귀고리와 패물로 장식하고 그 연애하는 자를 따라가서 나를 잊어버리고 향을 살라 바알들을 섬긴 시일을 따라 내가 저에게 벌을 주리라 나 여호와의 말이니라"
      ],
      "raw_text_hashes": [
