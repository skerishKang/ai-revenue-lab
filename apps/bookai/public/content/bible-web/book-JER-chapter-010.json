    {
      "canonical_locator": "bible:web:JER:10:6",
      "sequence": 19208,
      "chapter_label": "JER 10",
      "verse_label": "6",
      "locator": {
        "book": "JER",
        "chapter": 10,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 10,
          "verse": 6
        }
      ],
      "en": "There is no one like you, LORD. You are great, and your name is great in might.",
      "ko": "여호와여 주와 같은 자 없나이다 주는 크시니 주의 이름이 그 권능으로 인하여 크시니이다",
      "source_text_hash": "36b355da3103a218f93d6311e140254f6476d100d278bb72d9a450c685c8b9a6",
      "translation_text_hash": "6b0bb07d2aeb2c3314801cbc12fcfd75b003edc149a800af1b5ac503ae0ebabe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주와 같은 자 없나이다 주는 크시니 주의 이름이 그 권능으로 인하여 크시니이다"
      ],
      "raw_text_hashes": [
        "6b0bb07d2aeb2c3314801cbc12fcfd75b003edc149a800af1b5ac503ae0ebabe"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:10:7",
      "sequence": 19209,
      "chapter_label": "JER 10",
      "verse_label": "7",
      "locator": {
        "book": "JER",
        "chapter": 10,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 10,
          "verse": 7
        }
      ],
      "en": "Who shouldn’t fear you, King of the nations? For it belongs to you. Because among all the wise men of the nations, and in all their royal estate, there is no one like you.",
      "ko": "열방의 왕이시여 주를 경외치 아니할 자가 누구리이까 이는 주께 당연한 일이라 열방의 지혜로운 자들과 왕족 중에 주와 같은 자 없음이니이다",
      "source_text_hash": "2294521abd3a8b3ae0b369a6e048d7cdf1b8441a3abb99907a47fd2e167dbe67",
      "translation_text_hash": "db76ce3a3fbdcba52b042b0a44b05c8b23c2e10469a95a8c978714019d1adaa7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "열방의 왕이시여 주를 경외치 아니할 자가 누구리이까 이는 주께 당연한 일이라 열방의 지혜로운 자들과 왕족 중에 주와 같은 자 없음이니이다"
      ],
      "raw_text_hashes": [
        "db76ce3a3fbdcba52b042b0a44b05c8b23c2e10469a95a8c978714019d1adaa7"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:10:8",
      "sequence": 19210,
      "chapter_label": "JER 10",
      "verse_label": "8",
      "locator": {
        "book": "JER",
        "chapter": 10,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 10,
          "verse": 8
        }
      ],
      "en": "But they are together brutish and foolish, instructed by idols! It is just wood.",
      "ko": "그들은 다 무지하고 어리석은 것이니 우상의 도는 나무 뿐이라",
      "source_text_hash": "accf27057be2f9f083ed123b303343356d251bfa98e5ce35531a14ae6daae676",
      "translation_text_hash": "f1b25571ea4ce982f21465c38774a8a2f3013df96e2b7374f8b540c1bb4b97e4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들은 다 무지하고 어리석은 것이니 우상의 도는 나무 뿐이라"
      ],
      "raw_text_hashes": [
        "f1b25571ea4ce982f21465c38774a8a2f3013df96e2b7374f8b540c1bb4b97e4"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:10:9",
      "sequence": 19211,
      "chapter_label": "JER 10",
      "verse_label": "9",
      "locator": {
        "book": "JER",
