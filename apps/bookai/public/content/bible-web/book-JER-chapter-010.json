      "raw_locator": [
        {
          "book": "JER",
          "chapter": 10,
          "verse": 23
        }
      ],
      "en": "LORD, I know that the way of man is not in himself. It is not in man who walks to direct his steps.",
      "ko": "여호와여 내가 알거니와 인생의 길이 자기에게 있지 아니하니 걸음을 지도함이 걷는 자에게 있지 아니하니이다",
      "source_text_hash": "8018af1eef168015e409cba2383cc14436c5b4c38616ad7bc8f95446b0e40b72",
      "translation_text_hash": "3b380bdb7d0624ddd9ca75feba407e2c5adc5ebb83ba880aa5781c863627f5ff",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 내가 알거니와 인생의 길이 자기에게 있지 아니하니 걸음을 지도함이 걷는 자에게 있지 아니하니이다"
      ],
      "raw_text_hashes": [
        "3b380bdb7d0624ddd9ca75feba407e2c5adc5ebb83ba880aa5781c863627f5ff"
      ]
    },
