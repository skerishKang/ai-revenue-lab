      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "목자들은 우준하여 여호와를 찾지 아니하므로 형통치 못하며 그 모든 양떼는 흩어졌도다"
      ],
      "raw_text_hashes": [
        "9d0f5fed46f5b26ea59546d65c899c87a906d7cd060bdbc3c4b9cd26974644f1"
      ]
