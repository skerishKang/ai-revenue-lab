          "book": "JER",
          "chapter": 10,
          "verse": 1
        }
      ],
      "en": "Hear the word which the LORD speaks to you, house of Israel!",
      "ko": "이스라엘 집이여 여호와께서 너희에게 이르시는 말씀을 들을찌어다",
      "source_text_hash": "947d2360f80003510085d79599dc0de4adbf45d4e8d84fe5cc6d1eb824e062c0",
      "translation_text_hash": "620be8723479498ee08e0ddd4469a8e036c648e5ee6f8af66bf91d66ceeae1af",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 집이여 여호와께서 너희에게 이르시는 말씀을 들을찌어다"
      ],
      "raw_text_hashes": [
        "620be8723479498ee08e0ddd4469a8e036c648e5ee6f8af66bf91d66ceeae1af"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:10:2",
      "sequence": 19204,
      "chapter_label": "JER 10",
      "verse_label": "2",
      "locator": {
