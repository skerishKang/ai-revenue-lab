      "raw_locator": [
        {
          "book": "JER",
          "chapter": 10,
          "verse": 21
        }
      ],
      "en": "For the shepherds have become brutish, and have not inquired of the LORD. Therefore they have not prospered, and all their flocks have scattered.",
      "ko": "목자들은 우준하여 여호와를 찾지 아니하므로 형통치 못하며 그 모든 양떼는 흩어졌도다",
      "source_text_hash": "759c5ddc6cf57871cdaca36d83a7c6c1efc1eade55d41a164cfc8d487d5b4ff8",
      "translation_text_hash": "9d0f5fed46f5b26ea59546d65c899c87a906d7cd060bdbc3c4b9cd26974644f1",
      "translation_policy": "krv-1961-source-mapped",
