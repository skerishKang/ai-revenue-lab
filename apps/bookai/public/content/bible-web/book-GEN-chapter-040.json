      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 40,
          "verse": 3
        }
      ],
      "en": "He put them in custody in the house of the captain of the guard, into the prison, the place where Joseph was bound.",
      "ko": "그들을 시위대장의 집안에 있는 옥에 가두니 곧 요셉의 갇힌 곳이라",
      "source_text_hash": "04056f49a194f7ee85a4bcab70c47068fc2cc738a947013d0d04bd6e7dfae562",
      "translation_text_hash": "f54e3c5a701f4a81de6440046712cc98dbb25ce845f142fdbfd486746168f9eb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들을 시위대장의 집안에 있는 옥에 가두니 곧 요셉의 갇힌 곳이라"
      ],
      "raw_text_hashes": [
        "f54e3c5a701f4a81de6440046712cc98dbb25ce845f142fdbfd486746168f9eb"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:40:4",
