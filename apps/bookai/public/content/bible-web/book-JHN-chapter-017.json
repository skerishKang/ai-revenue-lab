    {
      "canonical_locator": "bible:web:JHN:17:9",
      "sequence": 26768,
      "chapter_label": "JHN 17",
      "verse_label": "9",
      "locator": {
        "book": "JHN",
        "chapter": 17,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 17,
          "verse": 9
        }
      ],
      "en": "I pray for them. I don’t pray for the world, but for those whom you have given me, for they are yours.",
      "ko": "내가 저희를 위하여 비옵나니 내가 비옵는 것은 세상을 위함이 아니요 내게 주신 자들을 위함이니이다 저희는 아버지의 것이로소이다",
      "source_text_hash": "62b3cf92566188a627918cecf2e8db3905d8843b4f7843f6b83183ab60a58cca",
      "translation_text_hash": "673eb36c15087a84f4786e24a75a202c5b538a501bb81cdf7f2bf0dccd2474c7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 저희를 위하여 비옵나니 내가 비옵는 것은 세상을 위함이 아니요 내게 주신 자들을 위함이니이다 저희는 아버지의 것이로소이다"
      ],
      "raw_text_hashes": [
        "673eb36c15087a84f4786e24a75a202c5b538a501bb81cdf7f2bf0dccd2474c7"
