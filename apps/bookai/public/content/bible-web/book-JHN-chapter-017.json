      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 17,
          "verse": 5
        }
      ],
      "en": "Now, Father, glorify me with your own self with the glory which I had with you before the world existed.",
      "ko": "아버지여 창세 전에 내가 아버지와 함께 가졌던 영화로써 지금도 아버지와 함께 나를 영화롭게 하옵소서",
      "source_text_hash": "f68e066e3999bd3376b681c2c84b50c5ba21deb51591622b315e63d72abb4765",
      "translation_text_hash": "d8bf2532736f52f1a47f4d3ff62f02d59f966deec7add9dd7c7ac108019286eb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아버지여 창세 전에 내가 아버지와 함께 가졌던 영화로써 지금도 아버지와 함께 나를 영화롭게 하옵소서"
      ],
      "raw_text_hashes": [
        "d8bf2532736f52f1a47f4d3ff62f02d59f966deec7add9dd7c7ac108019286eb"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:17:6",
      "sequence": 26765,
      "chapter_label": "JHN 17",
      "verse_label": "6",
