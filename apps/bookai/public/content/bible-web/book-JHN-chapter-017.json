    {
      "canonical_locator": "bible:web:JHN:17:12",
      "sequence": 26771,
      "chapter_label": "JHN 17",
      "verse_label": "12",
      "locator": {
        "book": "JHN",
        "chapter": 17,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 17,
          "verse": 12
        }
      ],
      "en": "While I was with them in the world, I kept them in your name. I have kept those whom you have given me. None of them is lost except the son of destruction, that the Scripture might be fulfilled.",
      "ko": "내가 저희와 함께 있을 때에 내게 주신 아버지의 이름으로 저희를 보전하와 지키었나이다 그 중에 하나도 멸망치 않고 오직 멸망의 자식 뿐이오니 이는 성경을 응하게 함이니이다",
      "source_text_hash": "7388eea1b8cdec6ae0877c19dca669e4a53b2c5cdd509d812fe05a536ba1f8a3",
      "translation_text_hash": "1ef7e58058c01ae188d6983a1e896432bbf2b75766b8441d38500e4dc13351aa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 저희와 함께 있을 때에 내게 주신 아버지의 이름으로 저희를 보전하와 지키었나이다 그 중에 하나도 멸망치 않고 오직 멸망의 자식 뿐이오니 이는 성경을 응하게 함이니이다"
      ],
      "raw_text_hashes": [
        "1ef7e58058c01ae188d6983a1e896432bbf2b75766b8441d38500e4dc13351aa"
