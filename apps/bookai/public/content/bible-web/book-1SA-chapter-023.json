        "chapter": 23,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 23,
          "verse": 8
        }
      ],
      "en": "Saul summoned all the people to war, to go down to Keilah to besiege David and his men.",
      "ko": "사울이 모든 백성을 군사로 불러 모으고 그일라로 내려가서 다윗과 그의 사람들을 에워싸려 하더니",
      "source_text_hash": "492d41a16a37919ce9cdbe0e55dc005eb70ced0ff071097bbe2835ab00c63ace",
      "translation_text_hash": "35f7ee4eb9204b7e8c4d3276ff1c4b19089c9f3a225488063c30191a5cb5b2ed",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울이 모든 백성을 군사로 불러 모으고 그일라로 내려가서 다윗과 그의 사람들을 에워싸려 하더니"
      ],
      "raw_text_hashes": [
        "35f7ee4eb9204b7e8c4d3276ff1c4b19089c9f3a225488063c30191a5cb5b2ed"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:23:9",
      "sequence": 7820,
      "chapter_label": "1SA 23",
