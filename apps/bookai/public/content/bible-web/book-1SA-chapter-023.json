      ]
    },
    {
      "canonical_locator": "bible:web:1SA:23:12",
      "sequence": 7823,
      "chapter_label": "1SA 23",
      "verse_label": "12",
      "locator": {
        "book": "1SA",
        "chapter": 23,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 23,
          "verse": 12
        }
      ],
      "en": "Then David said, “Will the men of Keilah deliver me and my men into the hand of Saul?” The LORD said, “They will deliver you up.”",
      "ko": "다윗이 가로되 그일라 사람들이 나와 내 사람들을 사울의 손에 붙이겠나이까 여호와께서 가라사대 그들이 너를 붙이리라",
      "source_text_hash": "2bc2e491a605ea77cc5ebb86e361f020e3ca934a2a1587fd497245b8c57704cd",
      "translation_text_hash": "e2b440dcecbba996862ad5b8a971dc788de907eda38ea220fb6b52afa57c9e43",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 가로되 그일라 사람들이 나와 내 사람들을 사울의 손에 붙이겠나이까 여호와께서 가라사대 그들이 너를 붙이리라"
      ],
      "raw_text_hashes": [
