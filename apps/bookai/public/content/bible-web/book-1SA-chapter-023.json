        "verse": 10
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 23,
          "verse": 10
        }
      ],
      "en": "Then David said, “O LORD, the God of Israel, your servant has surely heard that Saul seeks to come to Keilah to destroy the city for my sake.",
      "ko": "다윗이 가로되 이스라엘 하나님 여호와여 사울이 나의 연고로 이 성을 멸하려고 그일라로 내려오기를 꾀한다 함을 주의 종이 분명히 들었나이다",
      "source_text_hash": "521443efe4dddc52e5d7e773971754b0e1e3eba80574c27ee468602d887110cd",
      "translation_text_hash": "f9b8c3136d7db7d4f71295caa232fa410086f375992f480e4aebfdebd1d99aca",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 가로되 이스라엘 하나님 여호와여 사울이 나의 연고로 이 성을 멸하려고 그일라로 내려오기를 꾀한다 함을 주의 종이 분명히 들었나이다"
      ],
      "raw_text_hashes": [
        "f9b8c3136d7db7d4f71295caa232fa410086f375992f480e4aebfdebd1d99aca"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:23:11",
      "sequence": 7822,
      "chapter_label": "1SA 23",
      "verse_label": "11",
      "locator": {
        "book": "1SA",
        "chapter": 23,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 23,
          "verse": 11
        }
      ],
      "en": "Will the men of Keilah deliver me up into his hand? Will Saul come down, as your servant has heard? LORD, the God of Israel, I beg you, tell your servant.” The LORD said, “He will come down.”",
      "ko": "그일라 사람들이 나를 그의 손에 붙이겠나이까 주의 종의 들은대로 사울이 내려 오겠나이까 이스라엘의 하나님 여호와여 원컨대 주의 종에게 일러 주옵소서 여호와께서 가라사대 그가 내려 오리라",
      "source_text_hash": "04b5af695562a6f7049b6a1d42b4121d03d2f9b4a7723dfceb892cbe9692ee5f",
      "translation_text_hash": "307d45f403da998907792cd28763c2e56899f437b2c0311e29ff072528ab5e15",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그일라 사람들이 나를 그의 손에 붙이겠나이까 주의 종의 들은대로 사울이 내려 오겠나이까 이스라엘의 하나님 여호와여 원컨대 주의 종에게 일러 주옵소서 여호와께서 가라사대 그가 내려 오리라"
      ],
      "raw_text_hashes": [
