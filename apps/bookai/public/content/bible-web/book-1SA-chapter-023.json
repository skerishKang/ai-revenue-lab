      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 23,
          "verse": 21
        }
      ],
      "en": "Saul said, “You are blessed by the LORD, for you have had compassion on me.",
      "ko": "사울이 가로되 너희가 나를 긍휼히 여겼으니 여호와께 복 받기를 원하노라",
      "source_text_hash": "ad4f93daf299df3682ce6e5d6fb155360f326ada6195dbe1a940277cdbb6aaeb",
      "translation_text_hash": "473fea66b8c7d63ee106cd5e677431794e5a9084dfbbda14b60fa19d7b259454",
      "translation_policy": "krv-1961-source-mapped",
