        "verse": 2
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 16,
          "verse": 2
        }
      ],
      "en": "“You shall not take a wife, neither shall you have sons or daughters, in this place.”",
      "ko": "너는 이 땅에서 아내를 취하지 말며 자녀를 두지 말찌니라",
      "source_text_hash": "4fabb107a165d375f6e172422d344196378e80fa550937418fdabaef7f8ff83b",
      "translation_text_hash": "1275142129e4ee6754b75c8b37d29ec874d517c02d81ec7c7412fb2f862da47f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 이 땅에서 아내를 취하지 말며 자녀를 두지 말찌니라"
      ],
      "raw_text_hashes": [
        "1275142129e4ee6754b75c8b37d29ec874d517c02d81ec7c7412fb2f862da47f"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:16:3",
      "sequence": 19340,
      "chapter_label": "JER 16",
      "verse_label": "3",
      "locator": {
