      ],
      "en": "Then the LORD’s word came to me, saying,",
      "ko": "여호와의 말씀이 또 내게 임하니라 가라사대",
      "source_text_hash": "f6d95515d1ca6f58e19208de17095f2350084db431e1d848311001bc3487a207",
      "translation_text_hash": "18e915e6f8224946034ce7ce0ea23931e4330990e57709dfd13c42fd4d3d3af8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 또 내게 임하니라 가라사대"
      ],
      "raw_text_hashes": [
        "18e915e6f8224946034ce7ce0ea23931e4330990e57709dfd13c42fd4d3d3af8"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:16:2",
      "sequence": 19339,
      "chapter_label": "JER 16",
      "verse_label": "2",
      "locator": {
        "book": "JER",
