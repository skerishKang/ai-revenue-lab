      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 16,
          "verse": 14
        }
      ],
      "en": "He breaks me with breach on breach. He runs at me like a giant.",
      "ko": "그가 나를 꺾고 다시 꺾고 용사 같이 내게 달려드시니",
      "source_text_hash": "d3927b22197a7044f98bb9be01c80eb2a9533b829b19f166b77afd07c4b45680",
      "translation_text_hash": "ad5023be48504e594c0f2ff2c65617f3683fc2849d88037df446dd9dc017e447",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 나를 꺾고 다시 꺾고 용사 같이 내게 달려드시니"
      ],
      "raw_text_hashes": [
        "ad5023be48504e594c0f2ff2c65617f3683fc2849d88037df446dd9dc017e447"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:16:15",
      "sequence": 13254,
      "chapter_label": "JOB 16",
      "verse_label": "15",
      "locator": {
        "book": "JOB",
        "chapter": 16,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 16,
          "verse": 15
        }
      ],
      "en": "I have sewed sackcloth on my skin, and have thrust my horn in the dust.",
