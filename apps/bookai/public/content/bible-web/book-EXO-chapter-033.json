      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 33,
          "verse": 6
        }
      ],
      "en": "The children of Israel stripped themselves of their jewelry from Mount Horeb onward.",
      "ko": "이스라엘 자손이 호렙산에서부터 그 단장품을 제하니라",
      "source_text_hash": "80d0f1d8af4a5300ebc71b4f3cfc9ef64cc783730eb642b1bc0134b91f28477a",
      "translation_text_hash": "7f1f978b99585e98d0944d2509024ce663eb9dae2f06fe8c9d846c3677769f88",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손이 호렙산에서부터 그 단장품을 제하니라"
      ],
      "raw_text_hashes": [
        "7f1f978b99585e98d0944d2509024ce663eb9dae2f06fe8c9d846c3677769f88"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:33:7",
      "sequence": 2481,
      "chapter_label": "EXO 33",
      "verse_label": "7",
      "locator": {
