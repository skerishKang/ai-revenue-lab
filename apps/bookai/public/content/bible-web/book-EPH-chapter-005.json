        {
          "book": "EPH",
          "chapter": 5,
          "verse": 1
        }
      ],
      "en": "Be therefore imitators of God, as beloved children.",
      "ko": "그러므로 사랑을 입은 자녀 같이 너희는 하나님을 본받는 자가 되고",
      "source_text_hash": "909a362e95c6fd3686c59e2c73cf3c532a786daeab752daa808c703f5e8997b6",
      "translation_text_hash": "c93ff2b64d356de513615be82cb314986a3f7af2f350fe2dd313273a25114284",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 사랑을 입은 자녀 같이 너희는 하나님을 본받는 자가 되고"
      ],
      "raw_text_hashes": [
        "c93ff2b64d356de513615be82cb314986a3f7af2f350fe2dd313273a25114284"
      ]
    },
    {
      "canonical_locator": "bible:web:EPH:5:2",
      "sequence": 29303,
      "chapter_label": "EPH 5",
      "verse_label": "2",
      "locator": {
