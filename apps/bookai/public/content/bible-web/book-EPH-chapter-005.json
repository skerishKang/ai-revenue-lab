        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EPH",
          "chapter": 5,
          "verse": 12
        }
      ],
      "en": "For it is a shame even to speak of the things which are done by them in secret.",
      "ko": "저희의 은밀히 행하는 것들은 말하기도 부끄러움이라",
      "source_text_hash": "3a3915d783770044f530b774af7233298a48acc030f77438cecd6e34cffbd480",
      "translation_text_hash": "156ce6512eadaae0d1dcbd7d95bc5ecb569b2db6262c78f92794b57be09190c8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희의 은밀히 행하는 것들은 말하기도 부끄러움이라"
      ],
      "raw_text_hashes": [
        "156ce6512eadaae0d1dcbd7d95bc5ecb569b2db6262c78f92794b57be09190c8"
      ]
    },
    {
