      ],
      "en": "proving what is well pleasing to the Lord.",
      "ko": "주께 기쁘시게 할 것이 무엇인가 시험하여 보라",
      "source_text_hash": "3f475f60c287e6929195fc3ef22d671eef9e44140d14b209bf5782c6080e89fd",
      "translation_text_hash": "418bef3b81f08af265fbe37757cc8ef8b4ed49588e2e37c9a11cfc466a64f1d9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
