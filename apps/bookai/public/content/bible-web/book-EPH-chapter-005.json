      ]
    },
    {
      "canonical_locator": "bible:web:EPH:5:3",
      "sequence": 29304,
      "chapter_label": "EPH 5",
      "verse_label": "3",
      "locator": {
        "book": "EPH",
        "chapter": 5,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "EPH",
          "chapter": 5,
          "verse": 3
        }
      ],
      "en": "But sexual immorality, and all uncleanness or covetousness, let it not even be mentioned among you, as becomes saints;",
      "ko": "음행과 온갖 더러운 것과 탐욕은 너희 중에서 그 이름이라도 부르지 말라 이는 성도의 마땅한 바니라",
      "source_text_hash": "309cb3b8003440743fcef3541900cc798a47b3f6f5431a622d0b7220f050da5d",
      "translation_text_hash": "0a9a363555ba98be9d56ecdba0b4cab8b692ab5841a3a0edaf7e21255788d994",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "음행과 온갖 더러운 것과 탐욕은 너희 중에서 그 이름이라도 부르지 말라 이는 성도의 마땅한 바니라"
      ],
      "raw_text_hashes": [
        "0a9a363555ba98be9d56ecdba0b4cab8b692ab5841a3a0edaf7e21255788d994"
      ]
    },
    {
      "canonical_locator": "bible:web:EPH:5:4",
