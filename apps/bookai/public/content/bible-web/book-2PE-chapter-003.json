    {
      "canonical_locator": "bible:web:2PE:3:13",
      "sequence": 30532,
      "chapter_label": "2PE 3",
      "verse_label": "13",
      "locator": {
        "book": "2PE",
        "chapter": 3,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 3,
          "verse": 13
        }
      ],
      "en": "But, according to his promise, we look for new heavens and a new earth, in which righteousness dwells.",
      "ko": "우리는 그의 약속대로 의의 거하는바 새 하늘과 새 땅을 바라보도다",
      "source_text_hash": "429ec55be1e55435a270f4f8667d45d72b4add8a27fb1a8d0740ff0eec59feab",
      "translation_text_hash": "69454b525e6cc09f390a2d75cfd05e7902a6f0f6495545d3253068b3ab529a16",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리는 그의 약속대로 의의 거하는바 새 하늘과 새 땅을 바라보도다"
      ],
      "raw_text_hashes": [
        "69454b525e6cc09f390a2d75cfd05e7902a6f0f6495545d3253068b3ab529a16"
      ]
    },
    {
      "canonical_locator": "bible:web:2PE:3:14",
      "sequence": 30533,
      "chapter_label": "2PE 3",
      "verse_label": "14",
      "locator": {
        "book": "2PE",
        "chapter": 3,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 3,
          "verse": 14
        }
      ],
      "en": "Therefore, beloved, seeing that you look for these things, be diligent to be found in peace, without defect and blameless in his sight.",
      "ko": "그러므로 사랑하는 자들아 너희가 이것을 바라보나니 주 앞에서 점도 없고 흠도 없이 평강 가운데서 나타나기를 힘쓰라",
