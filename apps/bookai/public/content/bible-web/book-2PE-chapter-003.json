        "verse": 8
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 3,
          "verse": 8
        }
      ],
      "en": "But don’t forget this one thing, beloved, that one day is with the Lord as a thousand years, and a thousand years as one day.",
      "ko": "사랑하는 자들아 주께는 하루가 천년 같고 천년이 하루 같은 이 한가지를 잊지 말라",
      "source_text_hash": "44bc07a89794fff548e103f6f3b872fc7a2efbb600465abf6b5d4430453bfc83",
      "translation_text_hash": "272924c3dd6ccf7f1c7a966b0a5eed9b86ff7e4da54000673e55b535dae5c775",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사랑하는 자들아 주께는 하루가 천년 같고 천년이 하루 같은 이 한가지를 잊지 말라"
      ],
      "raw_text_hashes": [
        "272924c3dd6ccf7f1c7a966b0a5eed9b86ff7e4da54000673e55b535dae5c775"
      ]
    },
    {
      "canonical_locator": "bible:web:2PE:3:9",
      "sequence": 30528,
      "chapter_label": "2PE 3",
      "verse_label": "9",
      "locator": {
        "book": "2PE",
