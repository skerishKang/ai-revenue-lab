      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 3,
          "verse": 2
        }
      ],
      "en": "that you should remember the words which were spoken before by the holy prophets and the commandment of us, the apostles of the Lord and Savior,",
      "ko": "곧 거룩한 선지자의 예언한 말씀과 주 되신 구주께서 너희의 사도들로 말미암아 명하신 것을 기억하게 하려 하노라",
      "source_text_hash": "32cb96c0ee071d21d371a6b7dc8ec00511425d2cd79dc78263c3ddbf620242b3",
      "translation_text_hash": "de27c4236dda3f545cfc00429b6243ed884989887aca8daa4b3349147f2dbbc9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "곧 거룩한 선지자의 예언한 말씀과 주 되신 구주께서 너희의 사도들로 말미암아 명하신 것을 기억하게 하려 하노라"
      ],
      "raw_text_hashes": [
        "de27c4236dda3f545cfc00429b6243ed884989887aca8daa4b3349147f2dbbc9"
      ]
    },
