      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가라사대 내가 참으로 너희에게 말하노니 이 가난한 과부가 모든 사람보다 많이 넣었도다"
      ],
      "raw_text_hashes": [
        "0c34e9fa516bb8eb44e186970fa2c4526786bbb2bc7e00784c2ab8dd7ca5d36e"
      ]
