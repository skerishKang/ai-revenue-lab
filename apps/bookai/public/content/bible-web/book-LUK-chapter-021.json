      "source_text_hash": "56ea890e925e3c72eaebb2c8d28f2c56f26b368aefad8aaff5a39df781010a0d",
      "translation_text_hash": "ad6d15835cfa960e90badac5394435c890320174d1f3e07e49aaf6890cba49c0",
