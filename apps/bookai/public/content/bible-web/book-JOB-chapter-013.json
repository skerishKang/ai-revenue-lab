      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 13,
          "verse": 8
        }
      ],
      "en": "Will you show partiality to him? Will you contend for God?",
      "ko": "너희가 하나님의 낯을 좇으려느냐 그를 위하여 쟁론하려느냐",
      "source_text_hash": "b007d0ba36a85efaacd055086bff9667386df724e5e670d8b54c0ad498e1e163",
      "translation_text_hash": "37d43fabc6cd914b87924b935d35dfeb18b2a599f24094928fd26bc05fe5fec8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
