      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕과 백성에게 바벨론 왕을 섬기지 아니하리라 하는 선지자의 말을 듣지 마소서 그들은 거짓을 예언하나이다"
      ],
      "raw_text_hashes": [
