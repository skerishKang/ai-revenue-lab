      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "의인은 기뻐하여 하나님 앞에서 뛰놀며 기뻐하고 즐거워할찌어다"
      ],
      "raw_text_hashes": [
        "ed7ce7e3753d0ba93229bb3d7e4c7131920913a51902fea682fbac8b4fc5a517"
      ]
