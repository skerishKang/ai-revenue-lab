      "translation_text_hash": "dc0a952cbdbed5490f8dabcf93571da522134344e5a441afab8c54517a662124",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 지혜로운 여인은 그 집을 세우되 미련한 여인은 자기 손으로 그것을 허느니라"
      ],
      "raw_text_hashes": [
