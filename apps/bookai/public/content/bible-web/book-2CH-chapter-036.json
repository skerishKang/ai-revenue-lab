    {
      "canonical_locator": "bible:web:2CH:36:23",
      "sequence": 12017,
      "chapter_label": "2CH 36",
      "verse_label": "23",
      "locator": {
        "book": "2CH",
        "chapter": 36,
        "verse": 23
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 36,
          "verse": 23
        }
      ],
      "en": "“Cyrus king of Persia says, ‘The LORD, the God of heaven, has given all the kingdoms of the earth to me; and he has commanded me to build him a house in Jerusalem, which is in Judah. Whoever there is among you of all his people, the LORD his God be with him, and let him go up.’”",
      "ko": "바사 왕 고레스는 말하노니 하늘의 신 여호와께서 세상 만국으로 내게 주셨고 나를 명하여 유다 예루살렘에 전을 건축하라 하셨나니 너희 중에 무릇 그 백성 된 자는 다 올라갈찌어다 너희 하나님 여호와께서 함께하시기를 원하노라 하였더라",
      "source_text_hash": "a1227020b0be1269fc68f22d85902dce74e86c03f4cbae999903a439bdb85f70",
      "translation_text_hash": "1ac31a27b54a4b907006005d5d00aaae2d4eab7abc1ba9f36de6b17819822d22",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바사 왕 고레스는 말하노니 하늘의 신 여호와께서 세상 만국으로 내게 주셨고 나를 명하여 유다 예루살렘에 전을 건축하라 하셨나니 너희 중에 무릇 그 백성 된 자는 다 올라갈찌어다 너희 하나님 여호와께서 함께하시기를 원하노라 하였더라"
      ],
      "raw_text_hashes": [
        "1ac31a27b54a4b907006005d5d00aaae2d4eab7abc1ba9f36de6b17819822d22"
      ]
