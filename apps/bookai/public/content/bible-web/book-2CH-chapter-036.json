    {
      "canonical_locator": "bible:web:2CH:36:6",
      "sequence": 12000,
      "chapter_label": "2CH 36",
      "verse_label": "6",
      "locator": {
        "book": "2CH",
        "chapter": 36,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 36,
          "verse": 6
        }
      ],
      "en": "Nebuchadnezzar king of Babylon came up against him, and bound him in fetters to carry him to Babylon.",
      "ko": "바벨론 왕 느부갓네살이 올라와서 치고 저를 쇠사슬로 결박하여 바벨론으로 잡아가고",
      "source_text_hash": "d7b48b57acc730ae9ac8ef8fe1760b9fd9cbb07776da8c057ba462f199a3edbb",
      "translation_text_hash": "3a8586f39c79bd178f5c98280d150391201d15770df17baf05884a4bdc369695",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바벨론 왕 느부갓네살이 올라와서 치고 저를 쇠사슬로 결박하여 바벨론으로 잡아가고"
      ],
      "raw_text_hashes": [
        "3a8586f39c79bd178f5c98280d150391201d15770df17baf05884a4bdc369695"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:36:7",
      "sequence": 12001,
      "chapter_label": "2CH 36",
      "verse_label": "7",
      "locator": {
        "book": "2CH",
