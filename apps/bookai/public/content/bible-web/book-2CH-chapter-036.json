      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "국민이 요시야의 아들 여호아하스를 세워 그 부친을 대신하여 예루살렘에서 왕을 삼으니"
      ],
      "raw_text_hashes": [
        "dc08987526dc0eaa7b5a5ad5aa29e0db0235b4ab3611cc0212a63d7fbf071d68"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:36:2",
      "sequence": 11996,
      "chapter_label": "2CH 36",
      "verse_label": "2",
      "locator": {
