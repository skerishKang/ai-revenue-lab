      ],
      "en": "Honor widows who are widows indeed.",
      "ko": "참과부인 과부를 경대하라",
      "source_text_hash": "69c3b9be13f468a39ac0757bfa453b1c712dd27444d6c2a4c1077dbc9874fe94",
      "translation_text_hash": "cdebad6b00a6257498a50ce52e6fb73b6758ef1def6eb65d0736a0aa1d23b1dd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "참과부인 과부를 경대하라"
      ],
      "raw_text_hashes": [
        "cdebad6b00a6257498a50ce52e6fb73b6758ef1def6eb65d0736a0aa1d23b1dd"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:5:4",
      "sequence": 29764,
      "chapter_label": "1TI 5",
      "verse_label": "4",
      "locator": {
