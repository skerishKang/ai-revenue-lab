      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 5,
          "verse": 6
        }
      ],
      "en": "But she who gives herself to pleasure is dead while she lives.",
      "ko": "일락을 좋아하는 이는 살았으나 죽었느니라",
      "source_text_hash": "f56b43d7bfa4382897fb2c3064c9d66e0da7de64341e7f9e77b45dd9689dc5e2",
      "translation_text_hash": "4a36e720332e09b9324209f6ac652a48a4c39315eef014b381dae2d330d33ee3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "일락을 좋아하는 이는 살았으나 죽었느니라"
      ],
      "raw_text_hashes": [
        "4a36e720332e09b9324209f6ac652a48a4c39315eef014b381dae2d330d33ee3"
      ]
    },
    {
