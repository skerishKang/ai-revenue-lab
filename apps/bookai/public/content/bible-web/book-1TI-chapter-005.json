      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 5,
          "verse": 11
        }
      ],
      "en": "But refuse younger widows, for when they have grown wanton against Christ, they desire to marry,",
      "ko": "젊은 과부는 거절하라 이는 정욕으로 그리스도를 배반할 때에 시집가고자 함이니",
      "source_text_hash": "b138a771687ce7dddb59900a3c899ba817cbb622ad6be156628bf4b7a37472bc",
      "translation_text_hash": "13d0e75412d91c058b3aa39d33a43c5358ecc5e4878fa925768ee130396b161f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "젊은 과부는 거절하라 이는 정욕으로 그리스도를 배반할 때에 시집가고자 함이니"
      ],
      "raw_text_hashes": [
        "13d0e75412d91c058b3aa39d33a43c5358ecc5e4878fa925768ee130396b161f"
      ]
    },
