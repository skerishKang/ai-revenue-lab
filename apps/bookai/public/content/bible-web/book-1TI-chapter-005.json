      ],
      "raw_text_hashes": [
        "b8c0437a6aea4ec2092844b4d4811008127a03f230e0245b55785ad88277c615"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:5:8",
      "sequence": 29768,
      "chapter_label": "1TI 5",
      "verse_label": "8",
      "locator": {
        "book": "1TI",
        "chapter": 5,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 5,
          "verse": 8
        }
      ],
      "en": "But if anyone doesn’t provide for his own, and especially his own household, he has denied the faith and is worse than an unbeliever.",
      "ko": "누구든지 자기 친족 특히 자기 가족을 돌아보지 아니하면 믿음을 배반한 자요 불신자보다 더 악한 자니라",
      "source_text_hash": "43bcc7f0e149526381ee6cf87f41be1994d8f7378e006ea02716d5840031a74e",
      "translation_text_hash": "d02303b34aaddfd4db6d82ab4d2b762b8f954d994f2e0da291188ad500d1b581",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "누구든지 자기 친족 특히 자기 가족을 돌아보지 아니하면 믿음을 배반한 자요 불신자보다 더 악한 자니라"
      ],
      "raw_text_hashes": [
        "d02303b34aaddfd4db6d82ab4d2b762b8f954d994f2e0da291188ad500d1b581"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:5:9",
      "sequence": 29769,
      "chapter_label": "1TI 5",
      "verse_label": "9",
      "locator": {
