        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1TI",
          "chapter": 5,
          "verse": 9
        }
      ],
      "en": "Let no one be enrolled as a widow under sixty years old, having been the wife of one man,",
      "ko": "과부로 명부에 올릴 자는 나이 육십이 덜 되지 아니하고 한 남편의 아내이었던 자로서",
      "source_text_hash": "911366c65df3004a78dddd07f80710602c5bbfd708c5c53b1562f08f3aa2b605",
      "translation_text_hash": "81354a7016ae7acf8ceed1dc7ddb4a437e8c7bef62a68ba31a09385eb3938b2c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "과부로 명부에 올릴 자는 나이 육십이 덜 되지 아니하고 한 남편의 아내이었던 자로서"
      ],
      "raw_text_hashes": [
        "81354a7016ae7acf8ceed1dc7ddb4a437e8c7bef62a68ba31a09385eb3938b2c"
      ]
    },
    {
      "canonical_locator": "bible:web:1TI:5:10",
      "sequence": 29770,
      "chapter_label": "1TI 5",
