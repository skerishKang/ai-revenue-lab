        "verse": 10
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 17,
          "verse": 10
        }
      ],
      "en": "“‘Any man of the house of Israel, or of the strangers who live as foreigners among them, who eats any kind of blood, I will set my face against that soul who eats blood, and will cut him off from among his people.",
      "ko": "무릇 이스라엘 집 사람이나 그들 중에 우거하는 타국인 중에 어떤 피든지 먹는 자가 있으면 내가 그 피 먹는 사람에게 진노하여 그를 백성 중에서 끊으리니",
      "source_text_hash": "06cdcbfa435eb7c44396b9faa40a1a7777895bd2b9532dc70330b88ae957261a",
      "translation_text_hash": "21017e40b7823bbeb985fc39546cfed6e4ffcd6c0eef4642a5b4310a5ec4b7c6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 이스라엘 집 사람이나 그들 중에 우거하는 타국인 중에 어떤 피든지 먹는 자가 있으면 내가 그 피 먹는 사람에게 진노하여 그를 백성 중에서 끊으리니"
      ],
      "raw_text_hashes": [
        "21017e40b7823bbeb985fc39546cfed6e4ffcd6c0eef4642a5b4310a5ec4b7c6"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:17:11",
      "sequence": 3247,
      "chapter_label": "LEV 17",
      "verse_label": "11",
      "locator": {
        "book": "LEV",
        "chapter": 17,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 17,
          "verse": 11
        }
      ],
      "en": "For the life of the flesh is in the blood. I have given it to you on the altar to make atonement for your souls; for it is the blood that makes atonement by reason of the life.",
      "ko": "육체의 생명은 피에 있음이라 내가 이 피를 너희에게 주어 단에 뿌려 너희의 생명을 위하여 속하게 하였나니 생명이 피에 있으므로 피가 죄를 속하느니라",
      "source_text_hash": "208526216adea6dd00ad98ef63a5ef284dc7ca8796fda009a70cac746e972509",
      "translation_text_hash": "f63b787eb6d98e7abd723e96612a1f1c9279efa93791db573db81d3585191fa3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "육체의 생명은 피에 있음이라 내가 이 피를 너희에게 주어 단에 뿌려 너희의 생명을 위하여 속하게 하였나니 생명이 피에 있으므로 피가 죄를 속하느니라"
      ],
      "raw_text_hashes": [
        "f63b787eb6d98e7abd723e96612a1f1c9279efa93791db573db81d3585191fa3"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:17:12",
      "sequence": 3248,
      "chapter_label": "LEV 17",
      "verse_label": "12",
      "locator": {
