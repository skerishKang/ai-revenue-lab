    {
      "canonical_locator": "bible:web:LEV:17:13",
      "sequence": 3249,
      "chapter_label": "LEV 17",
      "verse_label": "13",
      "locator": {
        "book": "LEV",
        "chapter": 17,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 17,
          "verse": 13
        }
      ],
      "en": "“‘Whatever man there is of the children of Israel, or of the strangers who live as foreigners among them, who takes in hunting any animal or bird that may be eaten, he shall pour out its blood, and cover it with dust.",
      "ko": "무릇 이스라엘 자손이나 그들 중에 우거하는 타국인이 먹을만한 짐승이나 새를 사냥하여 잡거든 그 피를 흘리고 흙으로 덮을찌니라",
      "source_text_hash": "599be99c60c9a0c88745ca9d1d0f633c4a36155d8aee01d538432c13cd3da2e5",
      "translation_text_hash": "3588b71ba4d84a7b5bc95f6e8d2bcd3373bf021bc4c0055fd7093b7177844d4e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 이스라엘 자손이나 그들 중에 우거하는 타국인이 먹을만한 짐승이나 새를 사냥하여 잡거든 그 피를 흘리고 흙으로 덮을찌니라"
      ],
