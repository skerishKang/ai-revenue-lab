      ],
      "en": "But because I have told you these things, sorrow has filled your heart.",
      "ko": "도리어 내가 이 말을 하므로 너희 마음에 근심이 가득하였도다",
      "source_text_hash": "2bb5e2ca16b683da764e2bb47c7e37ab47ed0a2c2a78a300f6c7d400235a8ae0",
      "translation_text_hash": "9471add171de63073727de76cbec74c63499e7ee98a5930b9c12c798a30e41ca",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "도리어 내가 이 말을 하므로 너희 마음에 근심이 가득하였도다"
      ],
      "raw_text_hashes": [
        "9471add171de63073727de76cbec74c63499e7ee98a5930b9c12c798a30e41ca"
      ]
    },
    {
      "canonical_locator": "bible:web:JHN:16:7",
      "sequence": 26733,
