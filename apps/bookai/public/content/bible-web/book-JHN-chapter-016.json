        "verse": 25
      },
      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 16,
          "verse": 25
        }
      ],
      "en": "“I have spoken these things to you in figures of speech. But the time is coming when I will no more speak to you in figures of speech, but will tell you plainly about the Father.",
      "ko": "이것을 비사로 너희에게 일렀거니와 때가 이르면 다시 비사로 너희에게 이르지 않고 아버지에 대한 것을 밝히 이르리라",
      "source_text_hash": "bddcc04fad0751a6098933cde02e7085c3963f4c9e8a88cbad5ebdf7bec90c65",
      "translation_text_hash": "05f3fd146ebd117b77da0e249d1423b5b67d0a0dbff8bcc7b4b9a12d07c6b0fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이것을 비사로 너희에게 일렀거니와 때가 이르면 다시 비사로 너희에게 이르지 않고 아버지에 대한 것을 밝히 이르리라"
      ],
      "raw_text_hashes": [
        "05f3fd146ebd117b77da0e249d1423b5b67d0a0dbff8bcc7b4b9a12d07c6b0fe"
      ]
