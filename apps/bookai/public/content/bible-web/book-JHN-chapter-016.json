      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 와서 죄에 대하여, 의에 대하여, 심판에 대하여 세상을 책망하시리라"
      ],
      "raw_text_hashes": [
        "78346d8cfd08ef3c7baaec371befea14cc5a49c4d828c384813cdb44e6f5ea9c"
