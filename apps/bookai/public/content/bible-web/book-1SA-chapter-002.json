    {
      "canonical_locator": "bible:web:1SA:2:9",
      "sequence": 7250,
      "chapter_label": "1SA 2",
      "verse_label": "9",
      "locator": {
        "book": "1SA",
        "chapter": 2,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 2,
          "verse": 9
        }
      ],
      "en": "He will keep the feet of his holy ones, but the wicked will be put to silence in darkness; for no man will prevail by strength.",
      "ko": "그가 그 거룩한 자들의 발을 지키실 것이요 악인으로 흑암 중에서 잠잠케 하시리니 힘으로는 이길 사람이 없음이로다",
      "source_text_hash": "174d08ebc790ad17d2ad25339027c9b42e7a5e9b872961b6d5a83400b22c3657",
      "translation_text_hash": "2f0722d1a6880d6950cc70d7ca216ebd06cb0eb2aa64c3a35eba82a8de685ff2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 그 거룩한 자들의 발을 지키실 것이요 악인으로 흑암 중에서 잠잠케 하시리니 힘으로는 이길 사람이 없음이로다"
      ],
      "raw_text_hashes": [
