    {
      "canonical_locator": "bible:web:1SA:2:28",
      "sequence": 7269,
      "chapter_label": "1SA 2",
      "verse_label": "28",
      "locator": {
        "book": "1SA",
        "chapter": 2,
        "verse": 28
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 2,
          "verse": 28
        }
      ],
      "en": "Didn’t I choose him out of all the tribes of Israel to be my priest, to go up to my altar, to burn incense, to wear an ephod before me? Didn’t I give to the house of your father all the offerings of the children of Israel made by fire?",
      "ko": "이스라엘 모든 지파 중에서 내가 그를 택하여 나의 제사장을 삼아 그로 내 단에 올라 분향하며 내 앞에서 에봇을 입게 하지 아니하였느냐 이스라엘 자손의 드리는 모든 화제를 내가 네 조상의 집에 주지 아니하였느냐",
      "source_text_hash": "3f6ff3ab68d7454a30efad2473f0eae8cc9d395f1489ced30031d782bc6c5090",
      "translation_text_hash": "14e0e77bedfe4ea6c28927399c09ceb3085d054038295edfb2e3148b4102b27d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 모든 지파 중에서 내가 그를 택하여 나의 제사장을 삼아 그로 내 단에 올라 분향하며 내 앞에서 에봇을 입게 하지 아니하였느냐 이스라엘 자손의 드리는 모든 화제를 내가 네 조상의 집에 주지 아니하였느냐"
      ],
      "raw_text_hashes": [
        "14e0e77bedfe4ea6c28927399c09ceb3085d054038295edfb2e3148b4102b27d"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:2:29",
      "sequence": 7270,
      "chapter_label": "1SA 2",
      "verse_label": "29",
      "locator": {
        "book": "1SA",
        "chapter": 2,
        "verse": 29
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 2,
          "verse": 29
        }
      ],
      "en": "Why do you kick at my sacrifice and at my offering, which I have commanded in my habitation, and honor your sons above me, to make yourselves fat with the best of all the offerings of Israel my people?’",
      "ko": "너희는 어찌하여 내가 나의 처소에서 명한 나의 제물과 예물을 밟으며 네 아들들을 나보다 더 중히 여겨 내 백성 이스라엘의 드리는 가장 좋은 것으로 스스로 살찌게 하느냐",
      "source_text_hash": "ef3abc83f8fc10a5f5ad762af2eeec7dbd856856d594f8daf48a8beb58b39539",
      "translation_text_hash": "7d47d2d6d31d6cd0cad61621c6dfd617e1e45286eab9c68ec111e192243732bb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 어찌하여 내가 나의 처소에서 명한 나의 제물과 예물을 밟으며 네 아들들을 나보다 더 중히 여겨 내 백성 이스라엘의 드리는 가장 좋은 것으로 스스로 살찌게 하느냐"
      ],
      "raw_text_hashes": [
        "7d47d2d6d31d6cd0cad61621c6dfd617e1e45286eab9c68ec111e192243732bb"
      ]
