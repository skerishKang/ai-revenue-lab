        "verse": 10
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 21,
          "verse": 10
        }
      ],
      "en": "“‘He who is the high priest among his brothers, upon whose head the anointing oil is poured, and who is consecrated to put on the garments, shall not let the hair of his head hang loose, or tear his clothes.",
      "ko": "자기 형제중 관유로 부음을 받고 위임되어 예복을 입은 대제사장은 그 머리를 풀지 말며 그 옷을 찢지 말며",
      "source_text_hash": "5be81736d1b41e842cd408304b9f73cdb2d8d25059f27437f3062ea9bfd31374",
      "translation_text_hash": "417146c9f911deefe73ba5d3959478edfed0a946ba9528c05489e7062f47c0e4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "자기 형제중 관유로 부음을 받고 위임되어 예복을 입은 대제사장은 그 머리를 풀지 말며 그 옷을 찢지 말며"
      ],
      "raw_text_hashes": [
        "417146c9f911deefe73ba5d3959478edfed0a946ba9528c05489e7062f47c0e4"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:21:11",
      "sequence": 3357,
      "chapter_label": "LEV 21",
      "verse_label": "11",
      "locator": {
        "book": "LEV",
        "chapter": 21,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 21,
          "verse": 11
        }
      ],
      "en": "He must not go in to any dead body, or defile himself for his father or for his mother.",
      "ko": "어떤 시체에든지 가까이 말찌니 부모로 인하여도 더러워지게 말며",
      "source_text_hash": "6cef3cf5339017e28c6b7b71d0bede3625f42fd9adfc9f22d53b7be44171a924",
      "translation_text_hash": "46b6d8c0830266e32196e29e6e5ed8b045db210b0ec5abb3060cfa548be4984f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어떤 시체에든지 가까이 말찌니 부모로 인하여도 더러워지게 말며"
      ],
      "raw_text_hashes": [
        "46b6d8c0830266e32196e29e6e5ed8b045db210b0ec5abb3060cfa548be4984f"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:21:12",
      "sequence": 3358,
      "chapter_label": "LEV 21",
      "verse_label": "12",
      "locator": {
        "book": "LEV",
        "chapter": 21,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 21,
          "verse": 12
        }
      ],
      "en": "He shall not go out of the sanctuary, nor profane the sanctuary of his God; for the crown of the anointing oil of his God is upon him. I am the LORD.",
      "ko": "성소에서 나오지 말며 그 하나님의 성소를 더럽히지 말라 이는 하나님의 위임한 관유가 그 위에 있음이니라 나는 여호와니라",
      "source_text_hash": "4795fc94e19896082d18b757b2d3b9f5a73f0c4029a1eff06503cef3e4c1073f",
      "translation_text_hash": "1fbc9925038e78ef0f7a6b8dd52909ef237a6bf967328fa50102992431663fa7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "성소에서 나오지 말며 그 하나님의 성소를 더럽히지 말라 이는 하나님의 위임한 관유가 그 위에 있음이니라 나는 여호와니라"
      ],
      "raw_text_hashes": [
        "1fbc9925038e78ef0f7a6b8dd52909ef237a6bf967328fa50102992431663fa7"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:21:13",
      "sequence": 3359,
      "chapter_label": "LEV 21",
      "verse_label": "13",
      "locator": {
        "book": "LEV",
        "chapter": 21,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 21,
          "verse": 13
        }
      ],
      "en": "“‘He shall take a wife in her virginity.",
      "ko": "그는 처녀를 취하여 아내를 삼을찌니",
      "source_text_hash": "aa40b91bfcbefc38c1c5256757f108c1c66e7cb0c08057d67a3b017dd9419169",
      "translation_text_hash": "0b5402bbbc1b38e61bb8a89a7f15bb0acde0ab051600f8a6641f0cbef7635b4d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그는 처녀를 취하여 아내를 삼을찌니"
      ],
      "raw_text_hashes": [
        "0b5402bbbc1b38e61bb8a89a7f15bb0acde0ab051600f8a6641f0cbef7635b4d"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:21:14",
      "sequence": 3360,
      "chapter_label": "LEV 21",
      "verse_label": "14",
      "locator": {
        "book": "LEV",
        "chapter": 21,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 21,
          "verse": 14
        }
      ],
      "en": "He shall not marry a widow, or one divorced, or a woman who has been defiled, or a prostitute. He shall take a virgin of his own people as a wife.",
      "ko": "과부나 이혼 된 여인이나 더러운 여인이나 기생을 취하지 말고 자기 백성중 처녀를 취하여 아내를 삼아",
      "source_text_hash": "01816a054114090a52376988efe9a0a4334ade7b01f97535f2eaeacc60881731",
      "translation_text_hash": "a50e4eb3a85aac7d319fbbf0044b43d8888d061ac1e2b3693434e35511b02b1a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "과부나 이혼 된 여인이나 더러운 여인이나 기생을 취하지 말고 자기 백성중 처녀를 취하여 아내를 삼아"
      ],
      "raw_text_hashes": [
