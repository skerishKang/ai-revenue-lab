      "mapping_note": null,
      "raw_texts": [
        "뛰어 서서 걸으며 그들과 함께 성전으로 들어 가면서 걷기도 하고 뛰기도 하며 하나님을 찬미하니"
      ],
      "raw_text_hashes": [
        "a0156a9d825d52e46441deed29a2607408d499010159e69f63bf08586bbc82ea"
      ]
    },
    {
