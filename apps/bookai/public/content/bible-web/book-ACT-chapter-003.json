    },
    {
      "canonical_locator": "bible:web:ACT:3:14",
      "sequence": 27010,
      "chapter_label": "ACT 3",
      "verse_label": "14",
      "locator": {
        "book": "ACT",
        "chapter": 3,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 3,
          "verse": 14
        }
      ],
      "en": "But you denied the Holy and Righteous One and asked for a murderer to be granted to you,",
      "ko": "너희가 거룩하고 의로운 자를 부인하고 도리어 살인한 사람을 놓아 주기를 구하여",
      "source_text_hash": "23a2eb69dcd39c3964f05a558c135b6117bf45b3d553d8bc707d42406cc442a8",
      "translation_text_hash": "a7dd002606ac454177b80c452d2349b1d792d7b6d5e311f5f573127b276d5c5a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 거룩하고 의로운 자를 부인하고 도리어 살인한 사람을 놓아 주기를 구하여"
