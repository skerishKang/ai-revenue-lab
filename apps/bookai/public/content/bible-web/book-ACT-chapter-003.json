        {
          "book": "ACT",
          "chapter": 3,
          "verse": 7
        }
      ],
      "en": "He took him by the right hand and raised him up. Immediately his feet and his ankle bones received strength.",
      "ko": "오른손을 잡아 일으키니 발과 발목이 곧 힘을 얻고",
      "source_text_hash": "facf6e50938ef8173875786caceef1220b0efea93014d171b993a902e5fc5a73",
      "translation_text_hash": "eebbacde94f78ba3841dd50012977d15df58e60531bca29e57943b51e8c36159",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
