      ],
      "raw_text_hashes": [
        "d1508f05b26debd7976db3b133912f82fe381dfaca7017d5011bb7a85fba3dcd"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:3:10",
      "sequence": 27006,
      "chapter_label": "ACT 3",
      "verse_label": "10",
      "locator": {
