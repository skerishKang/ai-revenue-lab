      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "베드로가 요한으로 더불어 주목하여 가로되 우리를 보라 하니"
      ],
      "raw_text_hashes": [
        "338d98945c20850d528dd23e566e54b3e9ffeb44beb673700d72ffb54ab5679b"
      ]
    },
