      "locator": {
        "book": "ACT",
        "chapter": 3,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 3,
          "verse": 13
        }
      ],
      "en": "The God of Abraham, Isaac, and Jacob, the God of our fathers, has glorified his Servant Jesus, whom you delivered up and denied in the presence of Pilate, when he had determined to release him.",
      "ko": "아브라함과 이삭과 야곱의 하나님 곧 우리 조상의 하나님이 그 종 예수를 영화롭게 하셨느니라 너희가 저를 넘겨주고 빌라도가 놓아 주기로 결안한 것을 너희가 그 앞에서 부인하였으니",
      "source_text_hash": "01fd134eb21235d677933ace2a1eea3725ccbcc7086ec6e3767f3625228ba9ca",
      "translation_text_hash": "8df3d4e8d556c8c788394dd70465c48f9a8f9c7c7909744d5e28ab8337129201",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브라함과 이삭과 야곱의 하나님 곧 우리 조상의 하나님이 그 종 예수를 영화롭게 하셨느니라 너희가 저를 넘겨주고 빌라도가 놓아 주기로 결안한 것을 너희가 그 앞에서 부인하였으니"
      ],
      "raw_text_hashes": [
        "8df3d4e8d556c8c788394dd70465c48f9a8f9c7c7909744d5e28ab8337129201"
