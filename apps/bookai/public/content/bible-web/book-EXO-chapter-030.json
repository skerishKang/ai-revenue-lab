      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 아론과 그 아들들에게 기름을 발라 그들을 거룩하게 하고 그들로 내게 제사장 직분을 행하게 하고"
      ],
      "raw_text_hashes": [
