      "source_text_hash": "dea4eec466f6af3c4dcc0aa55af0e659f7171843ff153f9d2f825fa384d0d6fd",
      "translation_text_hash": "3ab0fda487a818ca9799c1272d701f721549d3b8647592fec0b6ef2af98a6e64",
      "translation_policy": "krv-1961-source-mapped",
