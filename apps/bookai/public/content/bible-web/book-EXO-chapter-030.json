      "raw_texts": [
        "그것들을 지성물로 구별하라 무릇 이것에 접촉하는 것이 거룩하리라"
      ],
      "raw_text_hashes": [
        "ae85e098f6cfca33a0f6f8db8775be1944b6790a87fb858aa48c98189f838d27"
