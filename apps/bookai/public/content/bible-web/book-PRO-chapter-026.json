      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "미련한 자 편에 기별하는 것은 자기의 발을 베어 버림이라 해를 받느니라"
      ],
      "raw_text_hashes": [
        "200058baf8bd9de6d110cbc6ed28de7502e9d76b4690fbdedea02f897cd65954"
      ]
    },
    {
