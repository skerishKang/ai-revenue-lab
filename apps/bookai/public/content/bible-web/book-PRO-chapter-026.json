      "translation_text_hash": "a6895a876377a40588ab00b8f0565a47e3d830d4036ee9635b1b4ae81f1e9630",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
