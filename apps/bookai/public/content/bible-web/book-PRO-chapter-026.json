        {
          "book": "PRO",
          "chapter": 26,
          "verse": 6
        }
      ],
      "en": "One who sends a message by the hand of a fool is cutting off feet and drinking violence.",
      "ko": "미련한 자 편에 기별하는 것은 자기의 발을 베어 버림이라 해를 받느니라",
      "source_text_hash": "7d3268744302c9af0eb3e2ca0f19c31173b1052c47514f6181470170dd4577bf",
      "translation_text_hash": "200058baf8bd9de6d110cbc6ed28de7502e9d76b4690fbdedea02f897cd65954",
      "translation_policy": "krv-1961-source-mapped",
