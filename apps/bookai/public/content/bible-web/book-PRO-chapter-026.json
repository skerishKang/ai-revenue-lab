      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "미련한 자의 어리석은 것을 따라 그에게 대답하라 두렵건대 그가 스스로 지혜롭게 여길까 하노라"
      ],
      "raw_text_hashes": [
        "fdada38507adbbeb4c38538c4701824f020657a3a0ecfe86a7e8a6806dd7ce52"
