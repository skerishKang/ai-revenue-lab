      "translation_text_hash": "9c9c14502828af4bab00c3371d1e7aa7e07726d966280b7386053d4aa0cd1428",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "미련한 자에게 영예를 주는 것은 돌을 물매에 매는 것과 같으니라"
