      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "장인이 온갖 것을 만들찌라도 미련한 자를 고용하는 것은 지나가는 자를 고용함과 같으니라"
      ],
      "raw_text_hashes": [
        "dc23eec2908e274442eaf2939c6fa6e92b4910d07d876e2473402e67188b45a0"
      ]
