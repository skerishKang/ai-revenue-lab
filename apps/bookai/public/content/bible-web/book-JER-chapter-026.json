      "raw_locator": [
        {
          "book": "JER",
          "chapter": 26,
          "verse": 14
        }
      ],
      "en": "But as for me, behold, I am in your hand. Do with me what is good and right in your eyes.",
      "ko": "보라 나는 너희 손에 있으니 너희 소견에 선한대로, 옳은대로 하려니와",
      "source_text_hash": "04d4f978b12062e2bb57d32f7d0dbfb407402f3b95169bd4a2981b78bd88be33",
      "translation_text_hash": "9206bc6f05dc83a28ad77d5698b85f7f84c7c0846088da3f296b0f5f843d3317",
      "translation_policy": "krv-1961-source-mapped",
