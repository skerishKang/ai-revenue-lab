      "raw_locator": [
        {
          "book": "JER",
          "chapter": 26,
          "verse": 17
        }
      ],
      "en": "Then certain of the elders of the land rose up, and spoke to all the assembly of the people, saying,",
      "ko": "때에 그 땅 장로 중 몇 사람이 일어나 백성의 온 회중에 말하여 가로되",
      "source_text_hash": "f6cc4dd93129e8b51e082b12c29ba32232c5498ab04691f0928c427da43de11b",
      "translation_text_hash": "583f50cd242203fdccab6ba8a7f99fbf8aa024060bb4b7747011a95b5768494b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "때에 그 땅 장로 중 몇 사람이 일어나 백성의 온 회중에 말하여 가로되"
      ],
      "raw_text_hashes": [
        "583f50cd242203fdccab6ba8a7f99fbf8aa024060bb4b7747011a95b5768494b"
      ]
