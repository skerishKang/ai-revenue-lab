      "raw_locator": [
        {
          "book": "PHP",
          "chapter": 1,
          "verse": 16
        }
      ],
      "en": "The former insincerely preach Christ from selfish ambition, thinking that they add affliction to my chains;",
      "ko": "이들은 내가 복음을 변명하기 위하여 세우심을 받은줄 알고 사랑으로 하나",
      "source_text_hash": "5c622808cab51e568068c3da237bf65c2cbedbe3ef1127a858445f8fc2ec4e76",
      "translation_text_hash": "a136fa7db75b93cc561dcbc0a53cdc036a24c4acda3057d307530ca3a8f1ebcd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이들은 내가 복음을 변명하기 위하여 세우심을 받은줄 알고 사랑으로 하나"
      ],
      "raw_text_hashes": [
        "a136fa7db75b93cc561dcbc0a53cdc036a24c4acda3057d307530ca3a8f1ebcd"
      ]
