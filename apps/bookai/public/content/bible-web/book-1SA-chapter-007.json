    {
      "canonical_locator": "bible:web:1SA:7:11",
      "sequence": 7364,
      "chapter_label": "1SA 7",
      "verse_label": "11",
      "locator": {
        "book": "1SA",
        "chapter": 7,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 7,
          "verse": 11
        }
      ],
      "en": "The men of Israel went out of Mizpah and pursued the Philistines, and struck them until they came under Beth Kar.",
      "ko": "이스라엘 사람들이 미스바에서 나가서 블레셋 사람을 따라 벧갈 아래에 이르기까지 쳤더라",
      "source_text_hash": "ff1d6aee59dce795b90cb8bbee04dc2e3d5bb3b10d8a9f4d0c0e1636000b06c3",
      "translation_text_hash": "7da9fdec90b31f771c534dc87975a145ced46e8e018e865adca2a99f701c15a6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 사람들이 미스바에서 나가서 블레셋 사람을 따라 벧갈 아래에 이르기까지 쳤더라"
      ],
      "raw_text_hashes": [
        "7da9fdec90b31f771c534dc87975a145ced46e8e018e865adca2a99f701c15a6"
