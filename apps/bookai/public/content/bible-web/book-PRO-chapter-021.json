      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "부지런한 자의 경영은 풍부함에 이를 것이나 조급한 자는 궁핍함에 이를 따름이니라"
      ],
      "raw_text_hashes": [
        "218066c0eecdf13882ee08e92746adeb9086f4f41c2b390ee75a85c4016fb44e"
