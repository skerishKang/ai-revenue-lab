      "source_text_hash": "1d98034cf343a6d0c751bf08d3c972d5c609af3bfdaa11f9133bdf78f28e2227",
      "translation_text_hash": "b70ba5c014be68e1cb48e87ac215bb8aea9451047c90182f1f5d2b5bba0b7b1a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 방패는 마음이 정직한 자를 구원하시는 하나님께 있도다"
