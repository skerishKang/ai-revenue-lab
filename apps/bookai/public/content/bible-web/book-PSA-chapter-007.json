      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 7,
          "verse": 9
        }
      ],
      "en": "Oh let the wickedness of the wicked come to an end, but establish the righteous; their minds and hearts are searched by the righteous God.",
      "ko": "악인의 악을 끊고 의인을 세우소서 의로우신 하나님이 사람의 심장을 감찰하시나이다",
      "source_text_hash": "a84c5d9207be43ee30eda9c3b602a9263acc177d77d1ce78e94eb36c876dc96a",
      "translation_text_hash": "a2ea001454e28d83922c1a92b56ec4c475c7af99e1adce1edca453e326fc2acc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악인의 악을 끊고 의인을 세우소서 의로우신 하나님이 사람의 심장을 감찰하시나이다"
      ],
      "raw_text_hashes": [
        "a2ea001454e28d83922c1a92b56ec4c475c7af99e1adce1edca453e326fc2acc"
      ]
