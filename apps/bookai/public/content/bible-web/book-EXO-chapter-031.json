      "source_text_hash": "ba560cb64010651b9c6fac6c657683ff4afd741798dc9c6d6948751c93499311",
      "translation_text_hash": "034f9bbc12c38805ffdd0374e124d6785f8ae3d4882a12a079af99093a4269a6",
