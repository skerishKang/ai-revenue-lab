      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "인자야 내가 네 눈에 기뻐하는 것을 한번 쳐서 빼앗으리니 너는 슬퍼 하거나 울거나 눈물을 흘리거나 하지 말며"
      ],
      "raw_text_hashes": [
