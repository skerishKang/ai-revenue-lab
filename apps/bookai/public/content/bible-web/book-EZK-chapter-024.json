        {
          "book": "EZK",
          "chapter": 24,
          "verse": 1
        }
      ],
      "en": "Again, in the ninth year, in the tenth month, in the tenth day of the month, the LORD’s word came to me, saying,",
      "ko": "제 구년 시월 십일에 여호와의 말씀이 내게 임하여 가라사대",
      "source_text_hash": "537ab1f299d4d75858670a9a448c701b02c1ac616644614e0f885d44a483140a",
      "translation_text_hash": "fa0ccad323374e6f6263fde3246c9998e412f202787083a5b861ab02b804bdb8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제 구년 시월 십일에 여호와의 말씀이 내게 임하여 가라사대"
      ],
      "raw_text_hashes": [
        "fa0ccad323374e6f6263fde3246c9998e412f202787083a5b861ab02b804bdb8"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:24:2",
      "sequence": 21059,
      "chapter_label": "EZK 24",
