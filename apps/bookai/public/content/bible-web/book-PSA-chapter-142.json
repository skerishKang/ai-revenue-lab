      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 심령이 속에서 상할 때에도 주께서 내 길을 아셨나이다 나의 행하는 길에 저희가 나를 잡으려고 올무를 숨겼나이다"
      ],
      "raw_text_hashes": [
        "ad2111846538ad32b72a525a6e739a63289ff93365ea1ed73f36afd68dd6a5b1"
