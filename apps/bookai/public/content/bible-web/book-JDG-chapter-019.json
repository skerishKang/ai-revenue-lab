    {
      "canonical_locator": "bible:web:JDG:19:9",
      "sequence": 7034,
      "chapter_label": "JDG 19",
      "verse_label": "9",
      "locator": {
        "book": "JDG",
        "chapter": 19,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 19,
          "verse": 9
        }
      ],
      "en": "When the man rose up to depart, he, and his concubine, and his servant, his father-in-law, the young lady’s father, said to him, “Behold, now the day draws toward evening, please stay all night. Behold, the day is ending. Stay here, that your heart may be merry; and tomorrow go on your way early, that you may go home.”",
      "ko": "그 사람이 첩과 하인으로 더불어 일어나 떠나고자 하매 그 첩장인 곧 여자의 아비가 그에게 이르되 보라 이제 해가 저물어가니 청컨대 이 밤도 유숙하라 보라 해가 기울었느니라 그대는 여기서 유숙하여 그대의 마음을 즐겁게 하고 내일 일찌기 그대의 길을 행하여 그대의 집으로 돌아가라",
      "source_text_hash": "f22832ab101bc784a02cd6bf2047ae29a4a835b9cb922f3c780bb4a9bef03ad0",
      "translation_text_hash": "124317cf4280afad8ef6f90c2aeb7299522222850c3ef58ff6d78944953d32e1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사람이 첩과 하인으로 더불어 일어나 떠나고자 하매 그 첩장인 곧 여자의 아비가 그에게 이르되 보라 이제 해가 저물어가니 청컨대 이 밤도 유숙하라 보라 해가 기울었느니라 그대는 여기서 유숙하여 그대의 마음을 즐겁게 하고 내일 일찌기 그대의 길을 행하여 그대의 집으로 돌아가라"
      ],
      "raw_text_hashes": [
