        {
          "book": "2KI",
          "chapter": 15,
          "verse": 11
        }
      ],
      "en": "Now the rest of the acts of Zechariah, behold, they are written in the book of the chronicles of the kings of Israel.",
      "ko": "스가랴의 남은 사적은 이스라엘 왕 역대지략에 기록되니라",
      "source_text_hash": "404ef362b7230bca50664465da4ab94d841e30f0faa4440e1ea9c8d190319c8a",
      "translation_text_hash": "0274fd971f7c6509c57aecd3733851293d5778628adab2f152b3cb1d8d04d96f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "스가랴의 남은 사적은 이스라엘 왕 역대지략에 기록되니라"
      ],
      "raw_text_hashes": [
        "0274fd971f7c6509c57aecd3733851293d5778628adab2f152b3cb1d8d04d96f"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:15:12",
      "sequence": 9938,
      "chapter_label": "2KI 15",
