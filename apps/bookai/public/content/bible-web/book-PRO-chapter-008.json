        "verse": 15
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 15
        }
      ],
      "en": "By me kings reign, and princes decree justice.",
      "ko": "나로 말미암아 왕들이 치리하며 방백들이 공의를 세우며",
      "source_text_hash": "cf10910667beb61754cf0be07ece3d5368b5703d7832770d7384d8dccc15fd57",
      "translation_text_hash": "79cf9d0724e8488ed053fe427f35b8d09cbf1aec833c64f5c9d9fdf992de688b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나로 말미암아 왕들이 치리하며 방백들이 공의를 세우며"
      ],
      "raw_text_hashes": [
        "79cf9d0724e8488ed053fe427f35b8d09cbf1aec833c64f5c9d9fdf992de688b"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:16",
      "sequence": 16619,
      "chapter_label": "PRO 8",
      "verse_label": "16",
      "locator": {
        "book": "PRO",
        "chapter": 8,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 16
        }
      ],
