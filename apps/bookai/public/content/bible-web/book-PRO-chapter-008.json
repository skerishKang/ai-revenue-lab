      "translation_text_hash": "8c6b2f478cd06dc158af1b35445e9c4b34e461d563ee84089bbcbbc27a07b829",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
