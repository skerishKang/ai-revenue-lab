        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 5
        }
      ],
      "en": "You simple, understand prudence! You fools, be of an understanding heart!",
      "ko": "어리석은 자들아 너희는 명철할찌니라 미련한 자들아 너희는 마음이 밝을찌니라 너희는 들을찌어다",
      "source_text_hash": "807c4c573f8f5a0b84968e4ce4a2cad5f89ad7c62af6579a432e2948d2305590",
      "translation_text_hash": "c57ca0f23ecfc510ac270561c34a71ede17bacc37f6c5fb370bf0af6953aa4ea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어리석은 자들아 너희는 명철할찌니라 미련한 자들아 너희는 마음이 밝을찌니라 너희는 들을찌어다"
      ],
      "raw_text_hashes": [
        "c57ca0f23ecfc510ac270561c34a71ede17bacc37f6c5fb370bf0af6953aa4ea"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:6",
      "sequence": 16609,
      "chapter_label": "PRO 8",
      "verse_label": "6",
      "locator": {
        "book": "PRO",
