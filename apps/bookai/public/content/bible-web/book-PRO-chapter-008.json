        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 10
        }
      ],
      "en": "Receive my instruction rather than silver, knowledge rather than choice gold.",
      "ko": "너희가 은을 받지 말고 나의 훈계를 받으며 정금보다 지식을 얻으라",
      "source_text_hash": "90f823f3a519080901d8324c64e4b62f004d7a5d3492f396f3fd139efb59911b",
      "translation_text_hash": "6763e853cde1055733d3ceeee3df21f054b23cdf6b282070b0794fb5f0dd8a77",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 은을 받지 말고 나의 훈계를 받으며 정금보다 지식을 얻으라"
      ],
      "raw_text_hashes": [
        "6763e853cde1055733d3ceeee3df21f054b23cdf6b282070b0794fb5f0dd8a77"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:11",
      "sequence": 16614,
      "chapter_label": "PRO 8",
      "verse_label": "11",
      "locator": {
        "book": "PRO",
