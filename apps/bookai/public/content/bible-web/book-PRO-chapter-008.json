      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 4
        }
      ],
      "en": "“I call to you men! I send my voice to the sons of mankind.",
      "ko": "사람들아 내가 너희를 부르며 내가 인자들에게 소리를 높이노라",
      "source_text_hash": "7d4fac7e7643c6033132fedfb2df4be58afc287d59f5bfedcfc0de92a74bd404",
      "translation_text_hash": "d80a9a6146251e9795659ba450be86b1d3bd841b063a2b6c9edcb5dd62b6ef52",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람들아 내가 너희를 부르며 내가 인자들에게 소리를 높이노라"
      ],
      "raw_text_hashes": [
        "d80a9a6146251e9795659ba450be86b1d3bd841b063a2b6c9edcb5dd62b6ef52"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:5",
      "sequence": 16608,
      "chapter_label": "PRO 8",
      "verse_label": "5",
      "locator": {
