        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 6
        }
      ],
      "en": "Hear, for I will speak excellent things. The opening of my lips is for right things.",
      "ko": "내가 가장 선한 것을 말하리라 내 입술을 열어 정직을 내리라",
      "source_text_hash": "74173b75277a8f1aa7a7a08fe8a099ad476e3bd6767523561c34df0c22425bcd",
      "translation_text_hash": "d81747ab2976e954796bab973c805494419a57eaa141082b2591784590598281",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 가장 선한 것을 말하리라 내 입술을 열어 정직을 내리라"
      ],
      "raw_text_hashes": [
        "d81747ab2976e954796bab973c805494419a57eaa141082b2591784590598281"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:7",
      "sequence": 16610,
      "chapter_label": "PRO 8",
      "verse_label": "7",
      "locator": {
        "book": "PRO",
        "chapter": 8,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 7
        }
      ],
      "en": "For my mouth speaks truth. Wickedness is an abomination to my lips.",
      "ko": "내 입은 진리를 말하며 내 입술은 악을 미워하느니라",
      "source_text_hash": "dc7d463148ac8ab1283a2069f92cac1ce0746919707ba66d86789d64f2cd4649",
      "translation_text_hash": "03a8fb9b992140a28d6854fc37375156596306476de251913684852f723bf1b7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 입은 진리를 말하며 내 입술은 악을 미워하느니라"
      ],
      "raw_text_hashes": [
        "03a8fb9b992140a28d6854fc37375156596306476de251913684852f723bf1b7"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:8",
      "sequence": 16611,
      "chapter_label": "PRO 8",
      "verse_label": "8",
      "locator": {
        "book": "PRO",
        "chapter": 8,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 8
        }
      ],
      "en": "All the words of my mouth are in righteousness. There is nothing crooked or perverse in them.",
      "ko": "내 입의 말은 다 의로운즉 그 가운데 굽은 것과 패역한 것이 없나니",
      "source_text_hash": "c61c7b27e7f43da1160fb68cdd293c4e2aa9af2c040ed5476eb8e80adbc0cfac",
      "translation_text_hash": "88bbc71d8aacbe72e9d579e4512eec6c8932c48a617159668a5c08b391b51867",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 입의 말은 다 의로운즉 그 가운데 굽은 것과 패역한 것이 없나니"
      ],
      "raw_text_hashes": [
        "88bbc71d8aacbe72e9d579e4512eec6c8932c48a617159668a5c08b391b51867"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:9",
      "sequence": 16612,
      "chapter_label": "PRO 8",
      "verse_label": "9",
      "locator": {
        "book": "PRO",
