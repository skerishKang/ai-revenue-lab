      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "지혜가 부르지 아니하느냐 명철이 소리를 높이지 아니하느냐"
      ],
      "raw_text_hashes": [
        "b6aa9d690c0e2e3b312c81d47fad944ea006d29347955680ab58f278fffe2d1a"
