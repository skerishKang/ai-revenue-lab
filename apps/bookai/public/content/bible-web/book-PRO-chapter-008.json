        {
          "book": "PRO",
          "chapter": 8,
          "verse": 2
        }
      ],
      "en": "On the top of high places by the way, where the paths meet, she stands.",
      "ko": "그가 길 가의 높은 곳과 사거리에 서며",
      "source_text_hash": "916af5532e2482b1680e75c55ece3e9c584da49bf9e9e4b816cfbaa15ac4a29e",
      "translation_text_hash": "a4edf2c156e8cb721aeeda107443952be85195c26ea49b16dbc2affff5440aea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
