      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 8,
          "verse": 14
        }
      ],
      "en": "Counsel and sound knowledge are mine. I have understanding and power.",
      "ko": "내게는 도략과 참 지식이 있으며 나는 명철이라 내게 능력이 있으므로",
      "source_text_hash": "dec15c4b57565332d64c7e39b31b4fc2ee3a9cc41c4ccacff4b63f6ef6aef263",
      "translation_text_hash": "1e5184203158604880a6cefba335c507ae0843a8384789cda25237e2c10380a9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내게는 도략과 참 지식이 있으며 나는 명철이라 내게 능력이 있으므로"
      ],
      "raw_text_hashes": [
        "1e5184203158604880a6cefba335c507ae0843a8384789cda25237e2c10380a9"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:8:15",
      "sequence": 16618,
      "chapter_label": "PRO 8",
      "verse_label": "15",
      "locator": {
        "book": "PRO",
