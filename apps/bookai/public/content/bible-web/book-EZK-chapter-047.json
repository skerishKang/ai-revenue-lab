    {
      "canonical_locator": "bible:web:EZK:47:10",
      "sequence": 21690,
      "chapter_label": "EZK 47",
      "verse_label": "10",
      "locator": {
        "book": "EZK",
        "chapter": 47,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 47,
          "verse": 10
        }
      ],
      "en": "It will happen that fishermen will stand by it. From En Gedi even to En Eglaim will be a place for the spreading of nets. Their fish will be after their kinds, as the fish of the great sea, exceedingly many.",
      "ko": "또 이 강 가에 어부가 설 것이니 엔게디에서부터 에네글라임까지 그물 치는 곳이 될 것이라 그 고기가 각기 종류를 따라 큰 바다의 고기 같이 심히 많으려니와",
      "source_text_hash": "afd8246e6a1c549c1edb1615267ce7d75ccae9bc4440611c940c6143c13b38f3",
      "translation_text_hash": "da836306ed1350f8e96fc802391663e639b98a07c33b0de472476837617cda64",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 이 강 가에 어부가 설 것이니 엔게디에서부터 에네글라임까지 그물 치는 곳이 될 것이라 그 고기가 각기 종류를 따라 큰 바다의 고기 같이 심히 많으려니와"
      ],
      "raw_text_hashes": [
