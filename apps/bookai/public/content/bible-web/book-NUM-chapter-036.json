      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 36,
          "verse": 8
        }
      ],
      "en": "Every daughter who possesses an inheritance in any tribe of the children of Israel shall be wife to one of the family of the tribe of her father, that the children of Israel may each possess the inheritance of his fathers.",
      "ko": "이스라엘 자손의 지파 중 무릇 그 기업을 이은 딸들은 자기 조상 지파 가족 되는 사람에게로 시집갈 것이라 그리하면 이스라엘 자손이 각기 조상의 기업을 보존하게 되어서",
      "source_text_hash": "fede71358b7b28cbd7175610ff3c603b50e74b75b387bdecaf2018bd7b95ad7c",
      "translation_text_hash": "a40d47d303908097e1f3680a1e37cc502bc367bafcca5b11015463a905d751ee",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손의 지파 중 무릇 그 기업을 이은 딸들은 자기 조상 지파 가족 되는 사람에게로 시집갈 것이라 그리하면 이스라엘 자손이 각기 조상의 기업을 보존하게 되어서"
      ],
      "raw_text_hashes": [
