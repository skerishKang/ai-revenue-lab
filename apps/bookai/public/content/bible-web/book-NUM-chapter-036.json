      "mapping_note": null,
      "raw_texts": [
        "그 기업으로 이 지파에서 저 지파로 옮기게 하지 아니하고 이스라엘 자손 지파가 각각 자기 기업을 지키리라"
      ],
      "raw_text_hashes": [
