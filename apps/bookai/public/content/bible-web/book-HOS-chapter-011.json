        "verse": 5
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 11,
          "verse": 5
        }
      ],
      "en": "“They won’t return into the land of Egypt; but the Assyrian will be their king, because they refused to repent.",
      "ko": "저희가 애굽 땅으로 다시 가지 못하겠거늘 내게 돌아 오기를 싫어하니 앗수르 사람이 그 임금이 될 것이라",
      "source_text_hash": "8d7af78541cfc64697a3407cb4f121aa13ffa380073670c52837f9dd7a428ad2",
      "translation_text_hash": "e34f5a1721c45d07b86fedf61df5315a28bd675362986bd559633e77d77ab323",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 애굽 땅으로 다시 가지 못하겠거늘 내게 돌아 오기를 싫어하니 앗수르 사람이 그 임금이 될 것이라"
      ],
      "raw_text_hashes": [
        "e34f5a1721c45d07b86fedf61df5315a28bd675362986bd559633e77d77ab323"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:11:6",
      "sequence": 22247,
      "chapter_label": "HOS 11",
      "verse_label": "6",
      "locator": {
        "book": "HOS",
        "chapter": 11,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 11,
          "verse": 6
        }
      ],
      "en": "The sword will fall on their cities, and will destroy the bars of their gates, and will put an end to their plans.",
      "ko": "칼이 저희의 성읍들을 치며 빗장을 깨뜨려 없이 하리니 이는 저희의 계책을 인함이니라",
      "source_text_hash": "53fce5e6694742a459505a3be94fd839c2065a1b5ca76555a20b69eda313ad66",
      "translation_text_hash": "b1c91c08e33006c2f4b6047e92db61b97c52a7bfadfa8b3afba507838f19ff72",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "칼이 저희의 성읍들을 치며 빗장을 깨뜨려 없이 하리니 이는 저희의 계책을 인함이니라"
      ],
      "raw_text_hashes": [
        "b1c91c08e33006c2f4b6047e92db61b97c52a7bfadfa8b3afba507838f19ff72"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:11:7",
      "sequence": 22248,
      "chapter_label": "HOS 11",
      "verse_label": "7",
      "locator": {
        "book": "HOS",
        "chapter": 11,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 11,
          "verse": 7
        }
      ],
      "en": "My people are determined to turn from me. Though they call to the Most High, he certainly won’t exalt them.",
      "ko": "내 백성이 결심하고 내게서 물러가나니 비록 저희를 불러 위에 계신 자에게로 돌아오라 할찌라도 일어나는 자가 하나도 없도다",
      "source_text_hash": "6b3cceb554db5a1d1a99d6f1dc547e093868536d53ae118fb32adb4e5c0f6e8f",
      "translation_text_hash": "539cd3b13337123d745d006397e23bffbabc62c118851cbccfae6bc5f1638b01",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 백성이 결심하고 내게서 물러가나니 비록 저희를 불러 위에 계신 자에게로 돌아오라 할찌라도 일어나는 자가 하나도 없도다"
      ],
      "raw_text_hashes": [
        "539cd3b13337123d745d006397e23bffbabc62c118851cbccfae6bc5f1638b01"
      ]
    },
    {
