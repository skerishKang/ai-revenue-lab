      "en": "The LORD spoke to me yet again, saying,",
      "ko": "여호와께서 다시 내게 일러 가라사대",
      "source_text_hash": "e12e927b06a37db24e59f66c60e6844ed2366113af658206eb0bab025d6d7163",
      "translation_text_hash": "ea68b0cd15223d951c4c45bafb354a7a4fca6f76ceccf80cbe8e803ed99c2b22",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 다시 내게 일러 가라사대"
      ],
      "raw_text_hashes": [
        "ea68b0cd15223d951c4c45bafb354a7a4fca6f76ceccf80cbe8e803ed99c2b22"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:8:6",
      "sequence": 17814,
      "chapter_label": "ISA 8",
      "verse_label": "6",
      "locator": {
