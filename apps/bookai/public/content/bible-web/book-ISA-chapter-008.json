      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 8,
          "verse": 13
        }
      ],
      "en": "The LORD of Armies is who you must respect as holy. He is the one you must fear. He is the one you must dread.",
      "ko": "만군의 여호와 그를 너희가 거룩하다 하고 그로 너희의 두려워하며 놀랄 자를 삼으라",
      "source_text_hash": "6632fc163e4461a2cf3a8a3aff16ba9f70fdc722a350f6a4e3d93f80b3feac18",
      "translation_text_hash": "b587ad6bb15449247d5cc788e12636274982d74023b4f58e0fa8456885b92eb5",
