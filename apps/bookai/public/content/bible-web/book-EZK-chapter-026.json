    {
      "canonical_locator": "bible:web:EZK:26:11",
      "sequence": 21112,
      "chapter_label": "EZK 26",
      "verse_label": "11",
      "locator": {
        "book": "EZK",
        "chapter": 26,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 26,
          "verse": 11
        }
      ],
      "en": "He will tread down all your streets with the hoofs of his horses. He will kill your people with the sword. The pillars of your strength will go down to the ground.",
      "ko": "그가 그 말굽으로 네 모든 거리를 밟을 것이며 칼로 네 백성을 죽일 것이며 네 견고한 석상을 땅에 엎드러뜨릴 것이며",
      "source_text_hash": "88a4202d4ee1a1a99583087611bab31a035fd2669897be2253e04ce9af1e28d9",
      "translation_text_hash": "a0b521028a09aea8e22b3e8353be67578e398a91f478ef931946afdcc01ca3d8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 그 말굽으로 네 모든 거리를 밟을 것이며 칼로 네 백성을 죽일 것이며 네 견고한 석상을 땅에 엎드러뜨릴 것이며"
      ],
      "raw_text_hashes": [
        "a0b521028a09aea8e22b3e8353be67578e398a91f478ef931946afdcc01ca3d8"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:26:12",
      "sequence": 21113,
      "chapter_label": "EZK 26",
      "verse_label": "12",
      "locator": {
        "book": "EZK",
        "chapter": 26,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 26,
          "verse": 12
        }
      ],
      "en": "They will make a plunder of your riches and make a prey of your merchandise. They will break down your walls and destroy your pleasant houses. They will lay your stones, your timber, and your dust in the middle of the waters.",
      "ko": "네 재물을 빼앗을 것이며 네 무역한 것을 노략할 것이며 네 성을 헐 것이며 네 기뻐하는 집을 무너뜨릴 것이며 또 네 돌들과 네 재목과 네 흙을 다 물 가운데 던질 것이라",
      "source_text_hash": "a1196d5d063a20cb33bcf48a0837582c620ee83da3c26d0602eb89d83947894f",
      "translation_text_hash": "14946e8c8a4dfd06ff7373fdb0f197be5a8da29786cdd38714f785873b6c6633",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 재물을 빼앗을 것이며 네 무역한 것을 노략할 것이며 네 성을 헐 것이며 네 기뻐하는 집을 무너뜨릴 것이며 또 네 돌들과 네 재목과 네 흙을 다 물 가운데 던질 것이라"
      ],
      "raw_text_hashes": [
        "14946e8c8a4dfd06ff7373fdb0f197be5a8da29786cdd38714f785873b6c6633"
