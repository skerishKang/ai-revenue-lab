        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 26,
          "verse": 6
        }
      ],
      "en": "Her daughters who are in the field will be slain with the sword. Then they will know that I am the LORD.’",
      "ko": "들에 있는 그의 딸들은 칼에 죽으리니 그들이 나를 여호와인줄 알리라",
      "source_text_hash": "7e3790ba35f515037ab9050d2ec4635160b3297cf4b112f0864abdc0bae83eeb",
      "translation_text_hash": "c1510e6634b58e40d0fc0f7f9b05f4f748323403439dbfbd50b63f19bf147cd8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "들에 있는 그의 딸들은 칼에 죽으리니 그들이 나를 여호와인줄 알리라"
      ],
      "raw_text_hashes": [
        "c1510e6634b58e40d0fc0f7f9b05f4f748323403439dbfbd50b63f19bf147cd8"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:26:7",
      "sequence": 21108,
      "chapter_label": "EZK 26",
      "verse_label": "7",
      "locator": {
