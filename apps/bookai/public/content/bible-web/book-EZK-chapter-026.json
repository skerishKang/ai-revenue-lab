        "verse": 3
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 26,
          "verse": 3
        }
      ],
      "en": "therefore the Lord GOD says, ‘Behold, I am against you, Tyre, and will cause many nations to come up against you, as the sea causes its waves to come up.",
      "ko": "그러므로 나 주 여호와가 말하노라 두로야 내가 너를 대적하여 바다가 그 파도로 흉용케 함 같이 열국으로 와서 너를 치게 하리니",
      "source_text_hash": "bbeb0bcc018668842a3680c3e8fe67d4f93076912b1c198164508111ed0df0e7",
      "translation_text_hash": "19552e5b1a1d124a9a6920067304644ea251b9cd4a399347e3aaf816e7a937ab",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 나 주 여호와가 말하노라 두로야 내가 너를 대적하여 바다가 그 파도로 흉용케 함 같이 열국으로 와서 너를 치게 하리니"
      ],
      "raw_text_hashes": [
        "19552e5b1a1d124a9a6920067304644ea251b9cd4a399347e3aaf816e7a937ab"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:26:4",
      "sequence": 21105,
      "chapter_label": "EZK 26",
      "verse_label": "4",
      "locator": {
        "book": "EZK",
        "chapter": 26,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 26,
          "verse": 4
        }
      ],
      "en": "They will destroy the walls of Tyre, and break down her towers. I will also scrape her dust from her, and make her a bare rock.",
      "ko": "그들이 두로의 성벽을 훼파하며 그 망대를 헐 것이요 나도 티끌을 그 위에서 쓸어 버려서 말간 반석이 되게 하며",
      "source_text_hash": "bf7bb17a061393e7f9513460dca4a0da521be00955ff9463c402bdc26c5cdc29",
      "translation_text_hash": "0e3eb9d78a4bbf127eccec96467bf083ba65a9bb56c61bb55c27360816e114f0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들이 두로의 성벽을 훼파하며 그 망대를 헐 것이요 나도 티끌을 그 위에서 쓸어 버려서 말간 반석이 되게 하며"
      ],
      "raw_text_hashes": [
        "0e3eb9d78a4bbf127eccec96467bf083ba65a9bb56c61bb55c27360816e114f0"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:26:5",
      "sequence": 21106,
      "chapter_label": "EZK 26",
      "verse_label": "5",
      "locator": {
