    {
      "canonical_locator": "bible:web:EZK:26:13",
      "sequence": 21114,
      "chapter_label": "EZK 26",
      "verse_label": "13",
      "locator": {
        "book": "EZK",
        "chapter": 26,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 26,
          "verse": 13
        }
      ],
      "en": "I will cause the noise of your songs to cease. The sound of your harps won’t be heard any more.",
      "ko": "내가 네 노래 소리로 그치게 하며 네 수금 소리로 다시 들리지 않게 하고",
      "source_text_hash": "afda6769269982ba81392d90701205577ded0d883664c9f82c5140e04b5ce5d9",
      "translation_text_hash": "8ad2c1933858dbd2779945dd5305918640add950777838c638440f32a9527df7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 네 노래 소리로 그치게 하며 네 수금 소리로 다시 들리지 않게 하고"
      ],
      "raw_text_hashes": [
        "8ad2c1933858dbd2779945dd5305918640add950777838c638440f32a9527df7"
      ]
    },
    {
