      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 9
        }
      ],
      "en": "He will guide the humble in justice. He will teach the humble his way.",
      "ko": "온유한 자를 공의로 지도하심이여 온유한 자에게 그 도를 가르치시리로다",
      "source_text_hash": "35ea9f232018ec472c513b083ef0446129e09440eadfc34c777e879e8049645b",
      "translation_text_hash": "18e29cf7389169ddfc6237f902627b4a623dc4992aa51b149c57491f2ad119f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "온유한 자를 공의로 지도하심이여 온유한 자에게 그 도를 가르치시리로다"
      ],
      "raw_text_hashes": [
        "18e29cf7389169ddfc6237f902627b4a623dc4992aa51b149c57491f2ad119f5"
      ]
    },
