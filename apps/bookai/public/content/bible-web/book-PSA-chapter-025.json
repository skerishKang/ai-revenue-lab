        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 8
        }
      ],
      "en": "Good and upright is the LORD, therefore he will instruct sinners in the way.",
      "ko": "여호와는 선하시고 정직하시니 그러므로 그 도로 죄인을 교훈하시리로다",
      "source_text_hash": "fdfc9b348458616848f21fd41dc97dac246190ecac296067da6206f7f8a2e24c",
      "translation_text_hash": "7d39d4084b0e0adb0b29782f9eca707b481a8e2965c976f0db03e32b9c6018e8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와는 선하시고 정직하시니 그러므로 그 도로 죄인을 교훈하시리로다"
      ],
      "raw_text_hashes": [
        "7d39d4084b0e0adb0b29782f9eca707b481a8e2965c976f0db03e32b9c6018e8"
      ]
