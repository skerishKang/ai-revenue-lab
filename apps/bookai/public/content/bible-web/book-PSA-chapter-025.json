      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 13
        }
      ],
      "en": "His soul will dwell at ease. His offspring will inherit the land.",
      "ko": "저의 영혼은 평안히 거하고 그 자손은 땅을 상속하리로다",
      "source_text_hash": "46d9f34c3c0d6fb912702c088a6c33b231767149b981d45190437b95a8f1fa0b",
      "translation_text_hash": "6fece7af960dee9e9ded76cd5bc9c7ed9eab0254762705eb77e03f0e666d4f1c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
