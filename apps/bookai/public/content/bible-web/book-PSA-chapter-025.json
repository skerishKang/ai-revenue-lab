      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 11
        }
      ],
      "en": "For your name’s sake, LORD, pardon my iniquity, for it is great.",
      "ko": "여호와여 나의 죄악이 중대하오니 주의 이름을 인하여 사하소서",
      "source_text_hash": "9177fa4c2befd90a245135364722147104d572e715b4280ad24cada5784e9293",
      "translation_text_hash": "9a354be0fc53e629594c708296c38a11d00a9b5d7971895b56a08a5aa13aad56",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나의 죄악이 중대하오니 주의 이름을 인하여 사하소서"
      ],
      "raw_text_hashes": [
        "9a354be0fc53e629594c708296c38a11d00a9b5d7971895b56a08a5aa13aad56"
      ]
