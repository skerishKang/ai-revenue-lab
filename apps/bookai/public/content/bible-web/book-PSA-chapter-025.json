      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 12
        }
      ],
      "en": "What man is he who fears the LORD? He shall instruct him in the way that he shall choose.",
      "ko": "여호와를 경외하는 자 누구뇨 그 택할 길을 저에게 가르치시리로다",
      "source_text_hash": "5552abb94f3c7589a5281a64a995dd37050908349d2f17b9e0b17bb598b7e04b",
      "translation_text_hash": "3bcb6b8351a41d6797318b0bc2895b1bfaa545d12e048af366c410568c1bcb63",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와를 경외하는 자 누구뇨 그 택할 길을 저에게 가르치시리로다"
      ],
      "raw_text_hashes": [
        "3bcb6b8351a41d6797318b0bc2895b1bfaa545d12e048af366c410568c1bcb63"
      ]
    },
