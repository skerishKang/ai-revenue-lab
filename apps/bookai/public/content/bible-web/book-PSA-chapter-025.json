        "verse": 4
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 4
        }
      ],
      "en": "Show me your ways, LORD. Teach me your paths.",
      "ko": "여호와여 주의 도를 내게 보이시고 주의 길을 내게 가르치소서",
      "source_text_hash": "4541a1d36405d9a08d5ea66aea987d3a106d1897b666e5c6f20d34a90baaf2bb",
      "translation_text_hash": "90b21e8c18e409a7ad4f00a7845ee3f6555b33b7a807acf1f0f8a7ad7ff2735d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주의 도를 내게 보이시고 주의 길을 내게 가르치소서"
      ],
      "raw_text_hashes": [
        "90b21e8c18e409a7ad4f00a7845ee3f6555b33b7a807acf1f0f8a7ad7ff2735d"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:25:5",
      "sequence": 14257,
      "chapter_label": "PSA 25",
      "verse_label": "5",
      "locator": {
        "book": "PSA",
        "chapter": 25,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 5
        }
      ],
      "en": "Guide me in your truth, and teach me, for you are the God of my salvation. I wait for you all day long.",
      "ko": "주의 진리로 나를 지도하시고 교훈하소서 주는 내 구원의 하나님이시니 내가 종일 주를 바라나이다",
      "source_text_hash": "400f260c102abf8edcd53fe30fbb61d15c4403dc81ff14f34398f46b35a3540d",
      "translation_text_hash": "fc2d53d8147f18e3bd12eb540e67969e44a462f178a322f0932821978281dc0a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 진리로 나를 지도하시고 교훈하소서 주는 내 구원의 하나님이시니 내가 종일 주를 바라나이다"
      ],
      "raw_text_hashes": [
        "fc2d53d8147f18e3bd12eb540e67969e44a462f178a322f0932821978281dc0a"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:25:6",
      "sequence": 14258,
      "chapter_label": "PSA 25",
      "verse_label": "6",
      "locator": {
