      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 25,
          "verse": 15
        }
      ],
      "en": "My eyes are ever on the LORD, for he will pluck my feet out of the net.",
      "ko": "내 눈이 항상 여호와를 앙망함은 내 발을 그물에서 벗어나게 하실 것임이로다",
      "source_text_hash": "e7d8715e089a82c261b4c53af0552dc36e1fc65ffc7fdb4ade5216658619670f",
      "translation_text_hash": "7a4b6cf885f736d632bffb51b9a49f69d886d32030bc30d5ed9b51f7d6da0664",
