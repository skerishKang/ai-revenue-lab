    {
      "canonical_locator": "bible:web:2CH:1:9",
      "sequence": 11204,
      "chapter_label": "2CH 1",
      "verse_label": "9",
      "locator": {
        "book": "2CH",
        "chapter": 1,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 1,
          "verse": 9
        }
      ],
      "en": "Now, LORD God, let your promise to David my father be established; for you have made me king over a people like the dust of the earth in multitude.",
      "ko": "여호와 하나님이여 원컨대 주는 내 아비 다윗에게 허하신 것을 이제 굳게 하옵소서 주께서 나로 땅의 티끌 같이 많은 백성의 왕을 삼으셨사오니",
      "source_text_hash": "6ff2bf2ee736d5b32cdb1b1047d1b604f9963a655c7074dc416afd69e211f718",
      "translation_text_hash": "892142e55b07ee3b582d8a5d8fd60da921356c0b19dd76d802fc58b211a340a7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와 하나님이여 원컨대 주는 내 아비 다윗에게 허하신 것을 이제 굳게 하옵소서 주께서 나로 땅의 티끌 같이 많은 백성의 왕을 삼으셨사오니"
      ],
      "raw_text_hashes": [
        "892142e55b07ee3b582d8a5d8fd60da921356c0b19dd76d802fc58b211a340a7"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:1:10",
      "sequence": 11205,
      "chapter_label": "2CH 1",
      "verse_label": "10",
      "locator": {
        "book": "2CH",
        "chapter": 1,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 1,
          "verse": 10
        }
      ],
      "en": "Now give me wisdom and knowledge, that I may go out and come in before this people; for who can judge this great people of yours?”",
      "ko": "주는 이제 내게 지혜와 지식을 주사 이 백성 앞에서 출입하게 하옵소서 이렇게 많은 주의 백성을 누가 능히 재판하리이까",
      "source_text_hash": "b6f786f1ceb84ef3b0173503dd8a056497ba3e91fc9d71d3471de6903773e30f",
      "translation_text_hash": "1db0120857dc23054d4e15a2a7b967adcdd7eb6afd010586b7b8445be027dd41",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주는 이제 내게 지혜와 지식을 주사 이 백성 앞에서 출입하게 하옵소서 이렇게 많은 주의 백성을 누가 능히 재판하리이까"
      ],
      "raw_text_hashes": [
        "1db0120857dc23054d4e15a2a7b967adcdd7eb6afd010586b7b8445be027dd41"
      ]
