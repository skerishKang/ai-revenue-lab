      ],
      "raw_text_hashes": [
        "013b6d78f9d0a43dcd93fbd7fad083183b4cfe194a88cf757e831f6e93bb2357"
      ]
    },
    {
      "canonical_locator": "bible:web:LUK:14:7",
      "sequence": 25561,
      "chapter_label": "LUK 14",
