      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 63,
          "verse": 2
        }
      ],
      "en": "So I have seen you in the sanctuary, watching your power and your glory.",
      "ko": "내가 주의 권능과 영광을 보려 하여 이와 같이 성소에서 주를 바라보았나이다",
      "source_text_hash": "e942193de44fc1ba4fc7f1ede29c817427a3af761efb2027322867d493cab9e4",
      "translation_text_hash": "d7ff91650b877b837acf693390411383c026f56237c8aea8764bf594891240ba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 주의 권능과 영광을 보려 하여 이와 같이 성소에서 주를 바라보았나이다"
      ],
      "raw_text_hashes": [
        "d7ff91650b877b837acf693390411383c026f56237c8aea8764bf594891240ba"
      ]
    },
