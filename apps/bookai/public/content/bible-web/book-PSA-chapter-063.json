      ],
      "en": "My soul stays close to you. Your right hand holds me up.",
      "ko": "나의 영혼이 주를 가까이 따르니 주의 오른손이 나를 붙드시거니와",
      "source_text_hash": "ec162755f4678e7ad5b52dbac83818f9442177b4b5806e5bc310d0e38bdf7300",
      "translation_text_hash": "dabea0f3bb81e8c38c0f41afd58709d3d22d94520e159b9fd13aad46f1680302",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 영혼이 주를 가까이 따르니 주의 오른손이 나를 붙드시거니와"
      ],
      "raw_text_hashes": [
        "dabea0f3bb81e8c38c0f41afd58709d3d22d94520e159b9fd13aad46f1680302"
      ]
    },
