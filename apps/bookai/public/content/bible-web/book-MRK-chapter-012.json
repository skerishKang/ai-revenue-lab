      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 성경에 건축자들의 버린 돌이 모퉁이의 머릿돌이 되었나니"
      ],
      "raw_text_hashes": [
        "8558c65372d34f5fa594510ef283a34f4af63c3adc48357bc410ab2520cbf034"
      ]
    },
