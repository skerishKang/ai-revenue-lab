      "en": "They took him, killed him, and cast him out of the vineyard.",
      "ko": "이에 잡아 죽여 포도원 밖에 내어던졌느니라",
      "source_text_hash": "cd12c37e44c3bdaa23c62c0fcea509bfd972239b7c334c8829de60e8fa6ee2e1",
      "translation_text_hash": "9f3065f14e426fc20fb4a170eceb8e02dec928be864848e3f05f9150dced6409",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이에 잡아 죽여 포도원 밖에 내어던졌느니라"
      ],
      "raw_text_hashes": [
        "9f3065f14e426fc20fb4a170eceb8e02dec928be864848e3f05f9150dced6409"
      ]
    },
    {
      "canonical_locator": "bible:web:MRK:12:9",
      "sequence": 24683,
      "chapter_label": "MRK 12",
