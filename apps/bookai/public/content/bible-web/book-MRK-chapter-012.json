      ],
      "en": "They took him, beat him, and sent him away empty.",
      "ko": "저희가 종을 잡아 심히 때리고 거저 보내었거늘",
      "source_text_hash": "323a86cece7902410cb4a9cd560facde8029d8d4b7a77c95fb62f3263c39f526",
      "translation_text_hash": "b0dae43f9243e24ee17eb71b2e7829b955f993c4b5cc3e7749d30c31b72abe1c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
