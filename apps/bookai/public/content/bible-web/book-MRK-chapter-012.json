      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 죽은 자 가운데서 살아날 때에는 장가도 아니가고 시집도 아니가고 하늘에 있는 천사들과 같으니라"
      ],
      "raw_text_hashes": [
