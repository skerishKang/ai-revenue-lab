      "source_text_hash": "10ffbf8b62475396cd3d0cae3bcda92d22ea9d70fb25de3dd10aca299bbe6e9c",
      "translation_text_hash": "f356e147c9e4fb3abfbfc438f90c5fe6ccf94df9afd08691cf8cfa1bf2eae560",
