      "translation_text_hash": "acec378bd4d6c92e72293ce3f9cc1f069c3c982d2d9d115bb6d55633760289f8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
