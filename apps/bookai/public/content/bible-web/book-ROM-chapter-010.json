        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 10,
          "verse": 10
        }
      ],
      "en": "For with the heart one believes resulting in righteousness; and with the mouth confession is made resulting in salvation.",
      "ko": "사람이 마음으로 믿어 의에 이르고 입으로 시인하여 구원에 이르느니라",
      "source_text_hash": "a6e0816fc2e267679f988a6c64f756ea959ab50dd06c19e93343e8e80b2f35f1",
      "translation_text_hash": "55cc118795015d69a8c56ca6be6e835a9318afbfef02895b4403a131ad82a203",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 마음으로 믿어 의에 이르고 입으로 시인하여 구원에 이르느니라"
      ],
      "raw_text_hashes": [
        "55cc118795015d69a8c56ca6be6e835a9318afbfef02895b4403a131ad82a203"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:10:11",
      "sequence": 28196,
      "chapter_label": "ROM 10",
      "verse_label": "11",
      "locator": {
        "book": "ROM",
        "chapter": 10,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 10,
          "verse": 11
        }
      ],
      "en": "For the Scripture says, “Whoever believes in him will not be disappointed.”",
      "ko": "성경에 이르되 누구든지 저를 믿는 자는 부끄러움을 당하지 아니하리라 하니",
      "source_text_hash": "d101a1ff99b8aa0a94d1af8bc01c96a22480f068e3b142eabff2aff18ee45bde",
      "translation_text_hash": "d25f2b924af8dc5300afea443c3503b7511edd63f1fe6fc954fcfc2b2e205308",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "성경에 이르되 누구든지 저를 믿는 자는 부끄러움을 당하지 아니하리라 하니"
      ],
      "raw_text_hashes": [
        "d25f2b924af8dc5300afea443c3503b7511edd63f1fe6fc954fcfc2b2e205308"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:10:12",
      "sequence": 28197,
      "chapter_label": "ROM 10",
      "verse_label": "12",
      "locator": {
        "book": "ROM",
        "chapter": 10,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 10,
          "verse": 12
        }
      ],
      "en": "For there is no distinction between Jew and Greek; for the same Lord is Lord of all, and is rich to all who call on him.",
      "ko": "유대인이나 헬라인이나 차별이 없음이라 한 주께서 모든 사람의 주가 되사 저를 부르는 모든 사람에게 부요하시도다",
      "source_text_hash": "9298338e70e3aa85a362582bbd05ffe3a1ec4fb16cf515cadb055b28834d121b",
      "translation_text_hash": "287a5b138dbad58a13f9758ca2fa1cd1e4759160d4645127ee7be4a19dd93ddb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "유대인이나 헬라인이나 차별이 없음이라 한 주께서 모든 사람의 주가 되사 저를 부르는 모든 사람에게 부요하시도다"
      ],
      "raw_text_hashes": [
        "287a5b138dbad58a13f9758ca2fa1cd1e4759160d4645127ee7be4a19dd93ddb"
      ]
    },
    {
      "canonical_locator": "bible:web:ROM:10:13",
