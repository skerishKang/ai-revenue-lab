      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 타작 마당과 포도주 틀의 소출을 수장한 후에 칠일 동안 초막절을 지킬 것이요"
      ],
      "raw_text_hashes": [
        "f05f785146b0de6e7e72bca0b1e203107fba8896801b4e59544f9d1ba7d73d51"
