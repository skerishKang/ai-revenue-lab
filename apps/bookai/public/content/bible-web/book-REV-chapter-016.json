        "verse": 8
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 16,
          "verse": 8
        }
      ],
      "en": "The fourth poured out his bowl on the sun, and it was given to him to scorch men with fire.",
      "ko": "네째가 그 대접을 해에 쏟으매 해가 권세를 받아 불로 사람들을 태우니",
      "source_text_hash": "0d4f949ecefe9109e5b647431fba6f635ddfbacf67ce1b69a7eb3e2da48a04f0",
      "translation_text_hash": "9105db9c963e86190ee839b3c2d7f75e1d080a6b08779f451e8ace29d1b8ce99",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네째가 그 대접을 해에 쏟으매 해가 권세를 받아 불로 사람들을 태우니"
      ],
      "raw_text_hashes": [
        "9105db9c963e86190ee839b3c2d7f75e1d080a6b08779f451e8ace29d1b8ce99"
      ]
