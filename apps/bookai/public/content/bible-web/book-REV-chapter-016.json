        "verse": 6
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 16,
          "verse": 6
        }
      ],
      "en": "For they poured out the blood of saints and prophets, and you have given them blood to drink. They deserve this.”",
      "ko": "저희가 성도들과 선지자들의 피를 흘렸으므로 저희로 피를 마시게 하신 것이 합당하니이다 하더라",
      "source_text_hash": "236103e9e01f7295e3f72a7a2a4464e168bef0f7c1cb7eea2d61a52529c13432",
      "translation_text_hash": "d53871446c45dd9a2306c5e88d80db166f572781949d07c8fd38bdb020e041d9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 성도들과 선지자들의 피를 흘렸으므로 저희로 피를 마시게 하신 것이 합당하니이다 하더라"
      ],
      "raw_text_hashes": [
        "d53871446c45dd9a2306c5e88d80db166f572781949d07c8fd38bdb020e041d9"
      ]
    },
    {
      "canonical_locator": "bible:web:REV:16:7",
      "sequence": 30958,
      "chapter_label": "REV 16",
      "verse_label": "7",
      "locator": {
