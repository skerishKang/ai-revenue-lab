      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 12,
          "verse": 5
        }
      ],
      "en": "Abram took Sarai his wife, Lot his brother’s son, all their possessions that they had gathered, and the people whom they had acquired in Haran, and they went to go into the land of Canaan. They entered into the land of Canaan.",
      "ko": "아브람이 그 아내 사래와 조카 롯과 하란에서 모은 모든 소유와 얻은 사람들을 이끌고 가나안 땅으로 가려고 떠나서 마침내 가나안 땅에 들어 갔더라",
      "source_text_hash": "624664cd9f753a10c9bfb78eddf6fda307f2d11206f5f0d2cf67514c8c9c35ff",
      "translation_text_hash": "1a0f976daf65b85db3caa6918a716b34c720760b25ce6f6a86a49598d0e83ce9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브람이 그 아내 사래와 조카 롯과 하란에서 모은 모든 소유와 얻은 사람들을 이끌고 가나안 땅으로 가려고 떠나서 마침내 가나안 땅에 들어 갔더라"
      ],
      "raw_text_hashes": [
