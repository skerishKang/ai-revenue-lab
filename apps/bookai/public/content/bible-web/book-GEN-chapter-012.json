      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 12,
          "verse": 9
        }
      ],
      "en": "Abram traveled, still going on toward the South.",
      "ko": "점점 남방으로 옮겨 갔더라",
      "source_text_hash": "31fa511b15ecaadaf2c341ea998848a65ac9a9338ce3ac8e55d1437b6b231634",
      "translation_text_hash": "efd2348d7fbcd0ac500dddc1dc23723ef4da714abd6b5255fbd2e05ee81272aa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "점점 남방으로 옮겨 갔더라"
      ],
      "raw_text_hashes": [
        "efd2348d7fbcd0ac500dddc1dc23723ef4da714abd6b5255fbd2e05ee81272aa"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:12:10",
      "sequence": 309,
      "chapter_label": "GEN 12",
      "verse_label": "10",
      "locator": {
        "book": "GEN",
        "chapter": 12,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 12,
          "verse": 10
        }
      ],
      "en": "There was a famine in the land. Abram went down into Egypt to live as a foreigner there, for the famine was severe in the land.",
      "ko": "그 땅에 기근이 있으므로 아브람이 애굽에 우거하려 하여 그리로 내려갔으니 이는 그 땅에 기근이 심하였음이라",
      "source_text_hash": "21d0a0804619d3c2c1f72d2878dd31a3423e631d17d45252735bc17cd6f2c974",
      "translation_text_hash": "c9bbf73b9e3c9816800d459689d0ab0bf39a780d77ac6a7c4453c31cead9aaa0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 땅에 기근이 있으므로 아브람이 애굽에 우거하려 하여 그리로 내려갔으니 이는 그 땅에 기근이 심하였음이라"
      ],
      "raw_text_hashes": [
        "c9bbf73b9e3c9816800d459689d0ab0bf39a780d77ac6a7c4453c31cead9aaa0"
      ]
