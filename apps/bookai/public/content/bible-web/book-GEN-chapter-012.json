      "locator": {
        "book": "GEN",
        "chapter": 12,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 12,
          "verse": 6
        }
      ],
      "en": "Abram passed through the land to the place of Shechem, to the oak of Moreh. At that time, Canaanites were in the land.",
      "ko": "아브람이 그 땅을 통과하여 세겜 땅 모레 상수리 나무에 이르니 그 때에 가나안 사람이 그 땅에 거하였더라",
      "source_text_hash": "2aa6f0f2ec20cb68d97e5be29b6ec07f352755c3cc31257493c3228999f2226b",
      "translation_text_hash": "9cdb8af704e53d8890a664cb79d2e5ecbd26fdaeba384cadb8325fe4b281df0a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브람이 그 땅을 통과하여 세겜 땅 모레 상수리 나무에 이르니 그 때에 가나안 사람이 그 땅에 거하였더라"
      ],
      "raw_text_hashes": [
        "9cdb8af704e53d8890a664cb79d2e5ecbd26fdaeba384cadb8325fe4b281df0a"
      ]
