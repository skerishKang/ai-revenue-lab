    {
      "canonical_locator": "bible:web:2CO:8:9",
      "sequence": 28938,
      "chapter_label": "2CO 8",
      "verse_label": "9",
      "locator": {
        "book": "2CO",
        "chapter": 8,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 8,
          "verse": 9
        }
      ],
      "en": "For you know the grace of our Lord Jesus Christ, that though he was rich, yet for your sakes he became poor, that you through his poverty might become rich.",
      "ko": "우리 주 예수 그리스도의 은혜를 너희가 알거니와 부요하신 자로서 너희를 위하여 가난하게 되심은 그의 가난함을 인하여 너희로 부요케 하려 하심이니라",
      "source_text_hash": "d62bd6494ffe076322971ecc2d9ca72102782d354feeeb1916d11f327ad6d8d2",
      "translation_text_hash": "ec97bb482d8fb3d3b63716955c3e03f20e9f4cbaa9f36b20b5c43d8a3989ee9d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 주 예수 그리스도의 은혜를 너희가 알거니와 부요하신 자로서 너희를 위하여 가난하게 되심은 그의 가난함을 인하여 너희로 부요케 하려 하심이니라"
      ],
      "raw_text_hashes": [
        "ec97bb482d8fb3d3b63716955c3e03f20e9f4cbaa9f36b20b5c43d8a3989ee9d"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:8:10",
      "sequence": 28939,
      "chapter_label": "2CO 8",
      "verse_label": "10",
      "locator": {
        "book": "2CO",
        "chapter": 8,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 8,
          "verse": 10
        }
      ],
      "en": "I give advice in this: it is expedient for you who were the first to start a year ago, not only to do, but also to be willing.",
      "ko": "이 일에 내가 뜻만 보이노니 이것은 너희에게 유익함이라 너희가 일년 전에 행하기를 먼저 시작할뿐 아니라 원하기도 하였은즉",
      "source_text_hash": "5cf787ed2b8fd0ae6da1daa22ce000190c2ff769890df754b1bfce96c5b54afc",
      "translation_text_hash": "f96a533991101bd45e8f81d9d5d9498016693ae278cdbdd9acb9f37b4a98ca06",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 일에 내가 뜻만 보이노니 이것은 너희에게 유익함이라 너희가 일년 전에 행하기를 먼저 시작할뿐 아니라 원하기도 하였은즉"
      ],
      "raw_text_hashes": [
        "f96a533991101bd45e8f81d9d5d9498016693ae278cdbdd9acb9f37b4a98ca06"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:8:11",
      "sequence": 28940,
      "chapter_label": "2CO 8",
      "verse_label": "11",
      "locator": {
