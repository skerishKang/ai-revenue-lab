        "verse": 13
      },
      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 8,
          "verse": 13
        }
      ],
      "en": "For this is not that others may be eased and you distressed,",
      "ko": "이는 다른 사람들은 평안하게 하고 너희는 곤고하게 하려는 것이 아니요 평균케 하려 함이니",
      "source_text_hash": "29abfe1d9ffdb99849cb372b11969f745dffe1667936d76360ec74fc6fc92453",
      "translation_text_hash": "7e3a0e0c67b1dbc5d26740a69fbfffcc6d74e08f7e38a213da155fe461c2afee",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 다른 사람들은 평안하게 하고 너희는 곤고하게 하려는 것이 아니요 평균케 하려 함이니"
      ],
      "raw_text_hashes": [
        "7e3a0e0c67b1dbc5d26740a69fbfffcc6d74e08f7e38a213da155fe461c2afee"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:8:14",
      "sequence": 28943,
      "chapter_label": "2CO 8",
      "verse_label": "14",
      "locator": {
