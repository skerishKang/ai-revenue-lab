      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 15,
          "verse": 9
        }
      ],
      "en": "The king said to him, “Go in peace.” So he arose and went to Hebron.",
      "ko": "왕이 저에게 이르되 평안히 가라 하니 저가 일어나 헤브론으로 가니라",
      "source_text_hash": "b4b510961d7578116aea44c619116e785ca29ccfb3432ce2777587518a984094",
      "translation_text_hash": "d1d8d12c879544d1950d3513297249757a7862b53d0e699ca87df2cc73b9def9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕이 저에게 이르되 평안히 가라 하니 저가 일어나 헤브론으로 가니라"
      ],
      "raw_text_hashes": [
        "d1d8d12c879544d1950d3513297249757a7862b53d0e699ca87df2cc73b9def9"
