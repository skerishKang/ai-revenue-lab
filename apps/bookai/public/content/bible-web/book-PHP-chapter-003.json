      "ko": "어찌하든지 죽은 자 가운데서 부활에 이르려 하노니",
      "source_text_hash": "38465196c224787111be4b2eda6aa2b76f6568a5f3af098978b5653fdf46aae8",
      "translation_text_hash": "8109fcb66ab5ecef9895eb8945e4bffc467f582a895a684bb1237ac03d108e05",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어찌하든지 죽은 자 가운데서 부활에 이르려 하노니"
      ],
      "raw_text_hashes": [
        "8109fcb66ab5ecef9895eb8945e4bffc467f582a895a684bb1237ac03d108e05"
      ]
    },
    {
      "canonical_locator": "bible:web:PHP:3:12",
