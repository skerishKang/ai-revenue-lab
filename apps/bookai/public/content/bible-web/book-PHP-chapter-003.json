        {
          "book": "PHP",
          "chapter": 3,
          "verse": 2
        }
      ],
      "en": "Beware of the dogs; beware of the evil workers; beware of the false circumcision.",
      "ko": "개들을 삼가고 행악하는 자들을 삼가고 손할례당을 삼가라",
      "source_text_hash": "55035148bc94094e7deaa64cb8a176152165eaf3afec441dd98fee49f14eac08",
      "translation_text_hash": "a13d104526239fd9e059589f08c031670309f8b6f73ec6fa3330c358e64bfb4e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "개들을 삼가고 행악하는 자들을 삼가고 손할례당을 삼가라"
      ],
      "raw_text_hashes": [
        "a13d104526239fd9e059589f08c031670309f8b6f73ec6fa3330c358e64bfb4e"
      ]
    },
    {
      "canonical_locator": "bible:web:PHP:3:3",
      "sequence": 29421,
