      ],
      "en": "that I may know him and the power of his resurrection, and the fellowship of his sufferings, becoming conformed to his death,",
      "ko": "내가 그리스도와 그 부활의 권능과 그 고난에 참예함을 알려하여 그의 죽으심을 본받아",
      "source_text_hash": "6a820906e8ae2fde5cd056eb76e69e3913ec77effafcec4863723895ad35150d",
      "translation_text_hash": "485d3816b55dad1d2eafd1af2fedbab8a9ed33324506ce4db370652462189a0e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 그리스도와 그 부활의 권능과 그 고난에 참예함을 알려하여 그의 죽으심을 본받아"
      ],
      "raw_text_hashes": [
        "485d3816b55dad1d2eafd1af2fedbab8a9ed33324506ce4db370652462189a0e"
      ]
    },
