      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 3,
          "verse": 7
        }
      ],
      "en": "The LORD said, “I have surely seen the affliction of my people who are in Egypt, and have heard their cry because of their taskmasters, for I know their sorrows.",
      "ko": "여호와께서 가라사대 내가 애굽에 있는 내 백성의 고통을 정녕히 보고 그들이 그 간역자로 인하여 부르짖음을 듣고 그 우고를 알고",
      "source_text_hash": "5521ef7e4fee3844d20cdf43aefac9f2a195647103fd6736103b4eaf935cfcb9",
      "translation_text_hash": "1d76a29f525970d3bea061add07d48a48adad8b6bb5a1dba566285968c6542a9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 가라사대 내가 애굽에 있는 내 백성의 고통을 정녕히 보고 그들이 그 간역자로 인하여 부르짖음을 듣고 그 우고를 알고"
      ],
      "raw_text_hashes": [
        "1d76a29f525970d3bea061add07d48a48adad8b6bb5a1dba566285968c6542a9"
      ]
