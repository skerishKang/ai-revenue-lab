        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 3,
          "verse": 8
        }
      ],
      "en": "I have come down to deliver them out of the hand of the Egyptians, and to bring them up out of that land to a good and large land, to a land flowing with milk and honey; to the place of the Canaanite, the Hittite, the Amorite, the Perizzite, the Hivite, and the Jebusite.",
      "ko": "내가 내려와서 그들을 애굽인의 손에서 건져내고 그들을 그 땅에서 인도하여 아름답고 광대한 땅, 젖과 꿀이 흐르는 땅 곧 가나안 족속, 헷 족속, 아모리 족속, 브리스 족속, 히위 족속, 여부스 족속의 지방에 이르려 하노라",
      "source_text_hash": "1a41a18588da9bf2bfd5d03271052b08219962e9e3f2a7488688f2f4d397ce9a",
      "translation_text_hash": "b2b9b13fa603efa37587592bb713ace44482582c769d438ed050906ea37434d6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 내려와서 그들을 애굽인의 손에서 건져내고 그들을 그 땅에서 인도하여 아름답고 광대한 땅, 젖과 꿀이 흐르는 땅 곧 가나안 족속, 헷 족속, 아모리 족속, 브리스 족속, 히위 족속, 여부스 족속의 지방에 이르려 하노라"
      ],
      "raw_text_hashes": [
        "b2b9b13fa603efa37587592bb713ace44482582c769d438ed050906ea37434d6"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:3:9",
      "sequence": 1589,
      "chapter_label": "EXO 3",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
