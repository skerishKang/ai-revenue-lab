      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 17,
          "verse": 2
        }
      ],
      "en": "“Son of man, tell a riddle, and speak a parable to the house of Israel;",
      "ko": "인자야 너는 수수께끼와 비유를 이스라엘 족속에게 베풀어",
      "source_text_hash": "2215ebae129d2b831362eedb2999198868ef173c3d90ce310d5e45782f8e22ad",
      "translation_text_hash": "195a5d8675ad93ef612fd62cc1ad13ad406a3a1ac0e80eaa43209177f5913da3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "인자야 너는 수수께끼와 비유를 이스라엘 족속에게 베풀어"
      ],
      "raw_text_hashes": [
        "195a5d8675ad93ef612fd62cc1ad13ad406a3a1ac0e80eaa43209177f5913da3"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:17:3",
      "sequence": 20829,
      "chapter_label": "EZK 17",
