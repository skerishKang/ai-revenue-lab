        "verse": 7
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 22,
          "verse": 7
        }
      ],
      "en": "When the sun is down, he shall be clean; and afterward he shall eat of the holy things, because it is his bread.",
      "ko": "해 질 때에야 정하리니 그 후에 성물을 먹을 것이라 이는 자기의 응식이 됨이니라",
      "source_text_hash": "60dafcc36e6228c79b0be06ee0652520277f0f236b08ee66f6dca4d179cc6249",
      "translation_text_hash": "ba9574624e69a7da4fbdca8b57dba79aa6075a9a2e4c8601eebb5b0da4a66144",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "해 질 때에야 정하리니 그 후에 성물을 먹을 것이라 이는 자기의 응식이 됨이니라"
      ],
      "raw_text_hashes": [
        "ba9574624e69a7da4fbdca8b57dba79aa6075a9a2e4c8601eebb5b0da4a66144"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:22:8",
      "sequence": 3378,
      "chapter_label": "LEV 22",
