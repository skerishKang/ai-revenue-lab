      ],
      "en": "The LORD spoke to Moses, saying,",
      "ko": "여호와께서 모세에게 일러 가라사대",
      "source_text_hash": "28219e5da0d26514843495c6edb280f326aa0ccffb0d2bb642d0e1b0f4478ca1",
      "translation_text_hash": "1213bc72e4be9e9f17f4b9129e3f0d4cbde2d4cf24000ea629c6671d78ca8075",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 모세에게 일러 가라사대"
      ],
      "raw_text_hashes": [
        "1213bc72e4be9e9f17f4b9129e3f0d4cbde2d4cf24000ea629c6671d78ca8075"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:22:2",
      "sequence": 3372,
      "chapter_label": "LEV 22",
      "verse_label": "2",
      "locator": {
        "book": "LEV",
