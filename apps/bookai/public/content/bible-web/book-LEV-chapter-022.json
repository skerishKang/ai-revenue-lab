      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손이 여호와께 드리는 성물을 그들은 더럽히지 말찌니"
      ],
      "raw_text_hashes": [
        "a2e913f6d27a9e63af21a4851aafd252775c8a3cbd07c45b87b3a4704053b0ee"
      ]
