        {
          "book": "1SA",
          "chapter": 31,
          "verse": 11
        }
      ],
      "en": "When the inhabitants of Jabesh Gilead heard what the Philistines had done to Saul,",
      "ko": "길르앗 야베스 거민들이 블레셋 사람들의 사울에게 행한 일을 듣고",
      "source_text_hash": "32f04315cce9c623aeba33310a6af504ac5027270ab382a7784c9c5d9708c11b",
      "translation_text_hash": "64e5c9ec2efd473e3618d998c785b35c780d652bd200acc3a046d73804855535",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "길르앗 야베스 거민들이 블레셋 사람들의 사울에게 행한 일을 듣고"
      ],
      "raw_text_hashes": [
        "64e5c9ec2efd473e3618d998c785b35c780d652bd200acc3a046d73804855535"
      ]
    },
