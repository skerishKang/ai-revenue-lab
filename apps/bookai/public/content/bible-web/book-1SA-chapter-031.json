    {
      "canonical_locator": "bible:web:1SA:31:8",
      "sequence": 8018,
      "chapter_label": "1SA 31",
      "verse_label": "8",
      "locator": {
        "book": "1SA",
        "chapter": 31,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 31,
          "verse": 8
        }
      ],
      "en": "On the next day, when the Philistines came to strip the slain, they found Saul and his three sons fallen on Mount Gilboa.",
      "ko": "그 이튿날 블레셋 사람들이 죽은 자를 벗기러 왔다가 사울과 그 세 아들이 길보아 산에서 죽은 것을 보고",
      "source_text_hash": "8027421ed57a9b8d482b646e03fe41c077a989b9c19527ec29cf741731ab2af3",
      "translation_text_hash": "17215603d2f7e7e55598a192baba2bec93300ee0c7e56a5428e1c2246635fcfa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 이튿날 블레셋 사람들이 죽은 자를 벗기러 왔다가 사울과 그 세 아들이 길보아 산에서 죽은 것을 보고"
      ],
      "raw_text_hashes": [
        "17215603d2f7e7e55598a192baba2bec93300ee0c7e56a5428e1c2246635fcfa"
      ]
