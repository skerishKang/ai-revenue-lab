      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "백성이 벧엘에 이르러 거기서 저녁까지 하나님 앞에 앉아서 대성통곡하여"
      ],
      "raw_text_hashes": [
        "698a446058121381ed0321b374d1c6cdf16dd7af5f724c1c8ab0fef671e9f62b"
