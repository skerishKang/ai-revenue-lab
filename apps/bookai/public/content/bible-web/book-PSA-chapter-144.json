      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 144,
          "verse": 6
        }
      ],
      "en": "Throw out lightning, and scatter them. Send out your arrows, and rout them.",
      "ko": "번개를 번득이사 대적을 흩으시며 주의 살을 발하사 저희를 파하소서",
      "source_text_hash": "381a207a6cc0779da0955c9c05550507975eb62a78646a1c45168293753c9b8a",
      "translation_text_hash": "fffb8527943cec37cce706f67c89c87e31e8892b4e38034a2436131b631de0ec",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "번개를 번득이사 대적을 흩으시며 주의 살을 발하사 저희를 파하소서"
      ],
      "raw_text_hashes": [
        "fffb8527943cec37cce706f67c89c87e31e8892b4e38034a2436131b631de0ec"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:144:7",
      "sequence": 16313,
      "chapter_label": "PSA 144",
      "verse_label": "7",
      "locator": {
