        "verse": 9
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 144,
          "verse": 9
        }
      ],
      "en": "I will sing a new song to you, God. On a ten-stringed lyre, I will sing praises to you.",
      "ko": "하나님이여 내가 주께 새 노래로 노래하며 열 줄 비파로 주를 찬양하리이다",
      "source_text_hash": "a25b7af3976395e41ff0ee5ca710a1a0746961d2118900c7d312c5ab306751f7",
      "translation_text_hash": "158d0517b4f86f649c1b9574786b5648184d06f005600ffbe32ec7dd3ef75052",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 내가 주께 새 노래로 노래하며 열 줄 비파로 주를 찬양하리이다"
      ],
      "raw_text_hashes": [
        "158d0517b4f86f649c1b9574786b5648184d06f005600ffbe32ec7dd3ef75052"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:144:10",
      "sequence": 16316,
      "chapter_label": "PSA 144",
      "verse_label": "10",
      "locator": {
        "book": "PSA",
