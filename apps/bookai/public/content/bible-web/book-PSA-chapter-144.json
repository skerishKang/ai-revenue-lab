        {
          "book": "PSA",
          "chapter": 144,
          "verse": 4
        }
      ],
      "en": "Man is like a breath. His days are like a shadow that passes away.",
      "ko": "사람은 헛것 같고 그의 날은 지나가는 그림자 같으니이다",
      "source_text_hash": "89d17bf97c06e634dbb284a9956c76423fde88213f73aaae27a6b14df3aed063",
      "translation_text_hash": "616a92c3ef969612e019aa0614d69db688ad3d0a4b8778199f83e93f8836c6fd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람은 헛것 같고 그의 날은 지나가는 그림자 같으니이다"
      ],
      "raw_text_hashes": [
        "616a92c3ef969612e019aa0614d69db688ad3d0a4b8778199f83e93f8836c6fd"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:144:5",
      "sequence": 16311,
