        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 144,
          "verse": 7
        }
      ],
      "en": "Stretch out your hand from above, rescue me, and deliver me out of great waters, out of the hands of foreigners,",
      "ko": "위에서부터 주의 손을 펴사 나를 큰 물과 이방인의 손에서 구하여 건지소서",
      "source_text_hash": "d768aba973ca8e4caad06bcf4e8989fe19a351d667186d0649ef5860eb48b473",
      "translation_text_hash": "54607fcebcfc516df5748228a1da85317e82c35073253017f78a42b5794546cc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "위에서부터 주의 손을 펴사 나를 큰 물과 이방인의 손에서 구하여 건지소서"
      ],
      "raw_text_hashes": [
        "54607fcebcfc516df5748228a1da85317e82c35073253017f78a42b5794546cc"
      ]
    },
    {
