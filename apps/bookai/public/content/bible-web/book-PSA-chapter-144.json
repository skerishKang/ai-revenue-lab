        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 144,
          "verse": 10
        }
      ],
      "en": "You are he who gives salvation to kings, who rescues David, his servant, from the deadly sword.",
      "ko": "주는 왕들에게 구원을 베푸시는 자시요 종 다윗을 그 해하는 칼에서 구하시는 자시니이다",
      "source_text_hash": "c81a9d7470d846fb0594be1c16979e70735225a5322c6df2986157bb194c47cd",
      "translation_text_hash": "e966d4bb027e48c6be18bfd75aff33e652ef0ae4382495edec2d39fb24d34907",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주는 왕들에게 구원을 베푸시는 자시요 종 다윗을 그 해하는 칼에서 구하시는 자시니이다"
      ],
      "raw_text_hashes": [
        "e966d4bb027e48c6be18bfd75aff33e652ef0ae4382495edec2d39fb24d34907"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:144:11",
      "sequence": 16317,
      "chapter_label": "PSA 144",
      "verse_label": "11",
      "locator": {
        "book": "PSA",
        "chapter": 144,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 144,
          "verse": 11
        }
      ],
      "en": "Rescue me, and deliver me out of the hands of foreigners, whose mouths speak deceit, whose right hand is a right hand of falsehood.",
      "ko": "이방인의 손에서 나를 구하여 건지소서 저희 입은 궤사를 말하며 그 오른손은 거짓의 오른손이니이다",
      "source_text_hash": "e81b46a3c7c29a3c3e35b1b56c29cc817c32d06136959589bfb43e3c0a2bdf56",
      "translation_text_hash": "fba0c6c1bbae4b5517d12ce699efc3e4f354c33eae4ac2cbf7db04d8fdd1b8f7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이방인의 손에서 나를 구하여 건지소서 저희 입은 궤사를 말하며 그 오른손은 거짓의 오른손이니이다"
      ],
      "raw_text_hashes": [
        "fba0c6c1bbae4b5517d12ce699efc3e4f354c33eae4ac2cbf7db04d8fdd1b8f7"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:144:12",
      "sequence": 16318,
      "chapter_label": "PSA 144",
      "verse_label": "12",
      "locator": {
