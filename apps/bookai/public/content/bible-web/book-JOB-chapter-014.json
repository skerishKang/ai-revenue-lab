          "book": "JOB",
          "chapter": 14,
          "verse": 1
        }
      ],
      "en": "“Man, who is born of a woman, is of few days, and full of trouble.",
      "ko": "여인에게서 난 사람은 사는 날이 적고 괴로움이 가득하며",
      "source_text_hash": "f961ad6ac3effdcad0c12731338927ab5d96259e6901d6b70654e9ecb0863d8a",
      "translation_text_hash": "fe8539c19b8cd503a910d42e0fec3402ba5aab17308135a960e64734bbaf50f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여인에게서 난 사람은 사는 날이 적고 괴로움이 가득하며"
      ],
      "raw_text_hashes": [
        "fe8539c19b8cd503a910d42e0fec3402ba5aab17308135a960e64734bbaf50f5"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:14:2",
      "sequence": 13184,
