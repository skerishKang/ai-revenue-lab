      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "동편에 세 문, 북편에 세 문, 남편에 세 문, 서편에 세 문이니"
      ],
      "raw_text_hashes": [
        "606f9042a24b5415507d306166f2483a26387b3f487cf892600bcc04cccd960a"
      ]
