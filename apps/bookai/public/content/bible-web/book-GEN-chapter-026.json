        }
      ],
      "en": "Isaac lived in Gerar.",
      "ko": "이삭이 그랄에 거하였더니",
      "source_text_hash": "c2fca381cf4c029abb8236af98e83453c535352d7b84d170da4d3dff34a1b27e",
      "translation_text_hash": "25098c1bf3fa699452c5506b311d29adce8d8feadb81b016442ab307c79ff64f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이삭이 그랄에 거하였더니"
      ],
      "raw_text_hashes": [
        "25098c1bf3fa699452c5506b311d29adce8d8feadb81b016442ab307c79ff64f"
      ]
