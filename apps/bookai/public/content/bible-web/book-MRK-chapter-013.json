      "source_text_hash": "3c30c495df0c46356529b018429bf641f66526fa608058ca1e34c98c9a51c72a",
      "translation_text_hash": "086721d28da7815acd4694d8c5eeeec339c96f2da54feae915376280f686dac2",
      "translation_policy": "krv-1961-source-mapped",
