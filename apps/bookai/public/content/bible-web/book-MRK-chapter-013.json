      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "많은 사람이 내 이름으로 와서 이르되 내가 그로라 하여 많은 사람을 미혹케 하리라"
      ],
      "raw_text_hashes": [
        "66557d6c6d49547a032a555dbbf95119fc4024d6dedeae06d4fed6bade92e011"
      ]
    },
    {
      "canonical_locator": "bible:web:MRK:13:7",
      "sequence": 24725,
      "chapter_label": "MRK 13",
