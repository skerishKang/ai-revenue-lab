      "source_text_hash": "3372efa2a0580ef8f7b6341b6cf1b1f45d39728e746a8bf1bad31cafb98dc77a",
      "translation_text_hash": "66e942e8bc47023c88bf046e5e346bd5e1c42f628d4d8614076417837e845864",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 주께서 그날들을 감하지 아니하셨더면 모든 육체가 구원을 얻지 못할 것이어늘 자기의 택하신 백성을 위하여 그날들을 감하셨느니라"
      ],
      "raw_text_hashes": [
