    {
      "canonical_locator": "bible:web:REV:3:9",
      "sequence": 30752,
      "chapter_label": "REV 3",
      "verse_label": "9",
      "locator": {
        "book": "REV",
        "chapter": 3,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 3,
          "verse": 9
        }
      ],
      "en": "Behold, I make some of the synagogue of Satan, of those who say they are Jews, and they are not, but lie—behold, I will make them to come and worship before your feet, and to know that I have loved you.",
      "ko": "보라 사단의 회 곧 자칭 유대인이라 하나 그렇지 않고 거짓말 하는 자들 중에서 몇을 네게 주어 저희로 와서 네 발앞에 절하게 하고 내가 너를 사랑하는 줄을 알게 하리라",
      "source_text_hash": "f3ddaf4a713c0cca2e10094a5cd1e9ed1bfb9c05eb491544973784ecb9c493e3",
      "translation_text_hash": "2f08cd85ecc8e36bb70a34516e29c1fcfd29e7f8f974852258c0accf607406d5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 사단의 회 곧 자칭 유대인이라 하나 그렇지 않고 거짓말 하는 자들 중에서 몇을 네게 주어 저희로 와서 네 발앞에 절하게 하고 내가 너를 사랑하는 줄을 알게 하리라"
      ],
      "raw_text_hashes": [
        "2f08cd85ecc8e36bb70a34516e29c1fcfd29e7f8f974852258c0accf607406d5"
