      "raw_locator": [
        {
          "book": "REV",
          "chapter": 3,
          "verse": 6
        }
      ],
      "en": "He who has an ear, let him hear what the Spirit says to the assemblies.",
      "ko": "귀 있는 자는 성령이 교회들에게 하시는 말씀을 들을찌어다",
      "source_text_hash": "41efec26bd2928dedbfc339464fd23c8bf79b9600f81c52a8d9ece8417f24924",
      "translation_text_hash": "5fe2cef06aab47bca7ac7e99cf1ac8d0af5607c0b869a621793ef8936ea855b2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "귀 있는 자는 성령이 교회들에게 하시는 말씀을 들을찌어다"
      ],
      "raw_text_hashes": [
        "5fe2cef06aab47bca7ac7e99cf1ac8d0af5607c0b869a621793ef8936ea855b2"
      ]
