    {
      "canonical_locator": "bible:web:REV:3:10",
      "sequence": 30753,
      "chapter_label": "REV 3",
      "verse_label": "10",
      "locator": {
        "book": "REV",
        "chapter": 3,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "REV",
          "chapter": 3,
          "verse": 10
        }
      ],
      "en": "Because you kept my command to endure, I also will keep you from the hour of testing which is to come on the whole world, to test those who dwell on the earth.",
      "ko": "네가 나의 인내의 말씀을 지켰은즉 내가 또한 너를 지키어 시험의 때를 면하게 하리니 이는 장차 온 세상에 임하여 땅에 거하는 자들을 시험할 때라",
      "source_text_hash": "2d464d1edfb29aed8b88c964ab39c11a211331a8ef7f82435f6bd966bca6e744",
      "translation_text_hash": "6898e276d7e4f9cb01cfccc1c3cee61a469b549ee1734ed152107361eb69ec69",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 나의 인내의 말씀을 지켰은즉 내가 또한 너를 지키어 시험의 때를 면하게 하리니 이는 장차 온 세상에 임하여 땅에 거하는 자들을 시험할 때라"
      ],
      "raw_text_hashes": [
