      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사천은 문지기요 사천은 다윗의 찬송하기 위하여 지은 악기로 여호와를 찬송하는 자라"
      ],
      "raw_text_hashes": [
        "5d4f97e3c2dcab0c79232afcc2d21ca745e718485ebc3d9fd44e0c9f64771cb2"
