      "raw_texts": [
        "또 시므이의 아들들은 야핫과 시나와 여우스와 브리아니 이 네 사람도 시므이의 아들이라"
      ],
      "raw_text_hashes": [
        "d590ac1226788df0775566edd44752d7de7247da6057ae607fa7ee8675a2e6e3"
