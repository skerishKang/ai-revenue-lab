      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 레위의 아들 게르손과 그핫과 므라리의 각 족속을 따라 그 반열을 나누었더라"
      ],
      "raw_text_hashes": [
        "c08981a824305a312caf9cc7aaabe9bb0efb144282948f8e2d87fc45f1c791df"
      ]
