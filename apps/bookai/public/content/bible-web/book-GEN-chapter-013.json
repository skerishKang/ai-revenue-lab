        "verse": 12
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 13,
          "verse": 12
        }
      ],
      "en": "Abram lived in the land of Canaan, and Lot lived in the cities of the plain, and moved his tent as far as Sodom.",
      "ko": "아브람은 가나안 땅에 거하였고 롯은 평지 성읍들에 머무르며 그 장막을 옮겨 소돔까지 이르렀더라",
      "source_text_hash": "16df1f117fb317e626ecc7b0e9225c4be2db051b04a0abc67f8800232f20b5f8",
      "translation_text_hash": "545db04c5c2bc9aae0d239704567f10a7574c317af503ac5826046f1b2b125c7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브람은 가나안 땅에 거하였고 롯은 평지 성읍들에 머무르며 그 장막을 옮겨 소돔까지 이르렀더라"
      ],
      "raw_text_hashes": [
