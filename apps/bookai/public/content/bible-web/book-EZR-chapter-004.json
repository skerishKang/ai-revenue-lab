      "raw_locator": [
        {
          "book": "EZR",
          "chapter": 4,
          "verse": 18
        }
      ],
      "en": "The letter which you sent to us has been plainly read before me.",
      "ko": "너희의 올린 글을 내 앞에서 낭독시키고",
      "source_text_hash": "a8dd702a076f2999056dbc6e71933a1729297c674479594df0e4fe883674bb8b",
      "translation_text_hash": "c38b4501237f00672ac7cbea707c8fa671501f02c81b1955f96642a5e3f68644",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희의 올린 글을 내 앞에서 낭독시키고"
      ],
      "raw_text_hashes": [
        "c38b4501237f00672ac7cbea707c8fa671501f02c81b1955f96642a5e3f68644"
      ]
