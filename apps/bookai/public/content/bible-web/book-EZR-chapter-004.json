      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 이제 궁의 소금을 먹는고로 왕의 수치 당함을 참아 보지못하여 보내어 왕에게 고하오니"
      ],
      "raw_text_hashes": [
