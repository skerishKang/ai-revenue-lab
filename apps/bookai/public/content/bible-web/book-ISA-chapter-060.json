        {
          "book": "ISA",
          "chapter": 60,
          "verse": 3
        }
      ],
      "en": "Nations will come to your light, and kings to the brightness of your rising.",
      "ko": "열방은 네 빛으로, 열왕은 비취는 네 광명으로 나아오리라",
      "source_text_hash": "916c5304e7513b70afb199501e80a04500e0ad4deb9513b9e14c6a743399fce3",
      "translation_text_hash": "d8b3549dd03a29235a4954556194a8c081dc492e59580f45bc795bf1ecefe736",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "열방은 네 빛으로, 열왕은 비취는 네 광명으로 나아오리라"
      ],
      "raw_text_hashes": [
        "d8b3549dd03a29235a4954556194a8c081dc492e59580f45bc795bf1ecefe736"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:60:4",
      "sequence": 18826,
