      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 60,
          "verse": 13
        }
      ],
      "en": "“The glory of Lebanon shall come to you, the cypress tree, the pine, and the box tree together, to beautify the place of my sanctuary; and I will make the place of my feet glorious.",
      "ko": "레바논의 영광 곧 잣나무와 소나무와 황양목이 함께 네게 이르러 내 거룩한 곳을 아름답게 할 것이며 내가 나의 발 둘 곳을 영화롭게 할것이라",
      "source_text_hash": "cb92e8666a10da2612bf3a084650c1166f0a385bb33d33592f6309f0f5d03ab7",
      "translation_text_hash": "d2d7d05638514536a6efd3b21e66a7728e85f48871ad64ad801f316e058ca72a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "레바논의 영광 곧 잣나무와 소나무와 황양목이 함께 네게 이르러 내 거룩한 곳을 아름답게 할 것이며 내가 나의 발 둘 곳을 영화롭게 할것이라"
      ],
      "raw_text_hashes": [
