      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 9,
          "verse": 9
        }
      ],
      "en": "I will make Ahab’s house like the house of Jeroboam the son of Nebat, and like the house of Baasha the son of Ahijah.",
      "ko": "아합의 집을 느밧의 아들 여로보암의 집과 같게 하며 또 아히야의 아들 바아사의 집과 같게 할찌라",
      "source_text_hash": "3e6fc3457623dd01b09005e80e5a9af751c81031ba72a626b6feeb8f40cf806a",
      "translation_text_hash": "3db1c032e977515408aa8cf0526fbd46b4b348e7c355971341a628f1bf86bd56",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아합의 집을 느밧의 아들 여로보암의 집과 같게 하며 또 아히야의 아들 바아사의 집과 같게 할찌라"
      ],
