      "translation_text_hash": "ff0d57fb20a9ebe226a0d8d4d5cd15a8125f9a2d1c0c38f2d1238a6d48efd556",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
