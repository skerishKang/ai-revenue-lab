        "verse": 2
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 10,
          "verse": 2
        }
      ],
      "en": "He judged Israel twenty-three years, and died, and was buried in Shamir.",
      "ko": "이스라엘의 사사가 된지 이십 삼년만에 죽으매 사밀에 장사되었더라",
      "source_text_hash": "8c4b16ae419726fb82d5822113429d79fcaaf77e8155228e2db64a74cd9bb833",
      "translation_text_hash": "2222b159a715423b1e68c080707ef672ffd7390caf9ffa1b38f3635b6e483779",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘의 사사가 된지 이십 삼년만에 죽으매 사밀에 장사되었더라"
      ],
      "raw_text_hashes": [
        "2222b159a715423b1e68c080707ef672ffd7390caf9ffa1b38f3635b6e483779"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:10:3",
      "sequence": 6815,
      "chapter_label": "JDG 10",
      "verse_label": "3",
      "locator": {
        "book": "JDG",
