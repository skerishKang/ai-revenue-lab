        {
          "book": "1SA",
          "chapter": 15,
          "verse": 7
        }
      ],
      "en": "Saul struck the Amalekites, from Havilah as you go to Shur, which is before Egypt.",
      "ko": "사울이 하윌라에서부터 애굽 앞 술에 이르기까지 아말렉 사람을 치고",
      "source_text_hash": "3f8155c16f75b110e9ec34053a9d408a9d32fa3486c09c28b89e9b1eb488c16e",
      "translation_text_hash": "1bea9805b292896fe033624b7626d9f81093fc1bcb3e1c41266a20d8c0bc84a8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울이 하윌라에서부터 애굽 앞 술에 이르기까지 아말렉 사람을 치고"
      ],
      "raw_text_hashes": [
        "1bea9805b292896fe033624b7626d9f81093fc1bcb3e1c41266a20d8c0bc84a8"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:15:8",
      "sequence": 7569,
      "chapter_label": "1SA 15",
      "verse_label": "8",
      "locator": {
        "book": "1SA",
