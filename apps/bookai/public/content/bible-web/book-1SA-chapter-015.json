        {
          "book": "1SA",
          "chapter": 15,
          "verse": 5
        }
      ],
      "en": "Saul came to the city of Amalek, and set an ambush in the valley.",
      "ko": "사울이 아말렉성에 이르러 골짜기에 복병하니라",
      "source_text_hash": "37afb84719b5e47467d4a43593397864a55c0338a3ef076b67cd0cb7d3079d9f",
      "translation_text_hash": "2164d109a777421abc9f6b8c971d887ad99f75adb7ae40bfda700228c05aebc8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울이 아말렉성에 이르러 골짜기에 복병하니라"
      ],
      "raw_text_hashes": [
        "2164d109a777421abc9f6b8c971d887ad99f75adb7ae40bfda700228c05aebc8"
      ]
