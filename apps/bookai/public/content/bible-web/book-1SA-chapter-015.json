        "verse": 8
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 15,
          "verse": 8
        }
      ],
      "en": "He took Agag the king of the Amalekites alive, and utterly destroyed all the people with the edge of the sword.",
      "ko": "아말렉 사람의 왕 아각을 사로잡고 칼날로 그 모든 백성을 진멸하였으되",
      "source_text_hash": "5befb6226d030f34deac1cbb307d684763f5ace5ae0c5465fbcb0734157f2683",
      "translation_text_hash": "8b625543d030e187b402037a73a28103a54e23f73760d725c179156261347235",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아말렉 사람의 왕 아각을 사로잡고 칼날로 그 모든 백성을 진멸하였으되"
      ],
      "raw_text_hashes": [
        "8b625543d030e187b402037a73a28103a54e23f73760d725c179156261347235"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:15:9",
      "sequence": 7570,
      "chapter_label": "1SA 15",
      "verse_label": "9",
      "locator": {
        "book": "1SA",
