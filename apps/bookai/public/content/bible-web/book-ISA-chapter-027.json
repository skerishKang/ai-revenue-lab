    {
      "canonical_locator": "bible:web:ISA:27:12",
      "sequence": 18164,
      "chapter_label": "ISA 27",
      "verse_label": "12",
      "locator": {
        "book": "ISA",
        "chapter": 27,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 27,
          "verse": 12
        }
      ],
      "en": "It will happen in that day that the LORD will thresh from the flowing stream of the Euphrates to the brook of Egypt; and you will be gathered one by one, children of Israel.",
      "ko": "너희 이스라엘 자손들아 그 날에 여호와께서 창일하는 하수에서부터 애굽 시내에까지 과실을 떠는것 같이 너희를 일일이 모으시리라",
      "source_text_hash": "e546bdb2e00f21f6fbb62ad70248cf36dd2b6bc6b5c10f1079659a8c4499d7dd",
      "translation_text_hash": "3bd528c90a7e067288b3f94512f6be0f31821dc74900d96aa17122bebcc25d7f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 이스라엘 자손들아 그 날에 여호와께서 창일하는 하수에서부터 애굽 시내에까지 과실을 떠는것 같이 너희를 일일이 모으시리라"
      ],
      "raw_text_hashes": [
        "3bd528c90a7e067288b3f94512f6be0f31821dc74900d96aa17122bebcc25d7f"
