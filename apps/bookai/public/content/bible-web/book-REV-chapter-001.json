      "translation_text_hash": "415a15c0a2deff6bfd3648cdf18e457215305ab6d91090ccc55d89b8456225d9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
