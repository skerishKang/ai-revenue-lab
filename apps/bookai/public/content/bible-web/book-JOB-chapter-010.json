      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 하나님께 아뢰오리니 나를 정죄하지 마옵시고 무슨 연고로 나로 더불어 쟁변하시는지 나로 알게 하옵소서"
      ],
      "raw_text_hashes": [
