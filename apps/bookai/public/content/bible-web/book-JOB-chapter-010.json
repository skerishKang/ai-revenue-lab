          "book": "JOB",
          "chapter": 10,
          "verse": 5
        }
      ],
      "en": "Are your days as the days of mortals, or your years as man’s years,",
      "ko": "주의 날이 어찌 인생의 날과 같으며 주의 해가 어찌 인생의 날과 같기로",
      "source_text_hash": "b215067e60ebc18d7b4245a788f36c70490760323299c8ac826a36766637d3e3",
      "translation_text_hash": "3a51b2f055830c35042f5f0d200f7ac0a1a782079fa839182792964425f32d0b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 날이 어찌 인생의 날과 같으며 주의 해가 어찌 인생의 날과 같기로"
      ],
      "raw_text_hashes": [
        "3a51b2f055830c35042f5f0d200f7ac0a1a782079fa839182792964425f32d0b"
      ]
