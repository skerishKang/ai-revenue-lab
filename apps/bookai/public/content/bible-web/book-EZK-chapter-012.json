      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "인자야 이스라엘 족속 곧 그 패역한 족속이 네게 묻기를 무엇을 하느냐 하지 아니하더냐"
      ],
      "raw_text_hashes": [
        "e870009db5d8b3624d1014f6b9dd279f6dac9ec225ac1dcfdd37421cb6cb7c86"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:12:10",
      "sequence": 20691,
