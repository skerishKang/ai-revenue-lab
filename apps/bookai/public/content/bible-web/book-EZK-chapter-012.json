    {
      "canonical_locator": "bible:web:EZK:12:13",
      "sequence": 20694,
      "chapter_label": "EZK 12",
      "verse_label": "13",
      "locator": {
        "book": "EZK",
        "chapter": 12,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 12,
          "verse": 13
        }
      ],
      "en": "I will also spread my net on him, and he will be taken in my snare. I will bring him to Babylon to the land of the Chaldeans; yet he will not see it, though he will die there.",
      "ko": "내가 또 내 그물을 그의 위에 치고 내 올무에 걸리게 하여 그를 끌고 갈대아 땅 바벨론에 이르리니 그가 거기서 죽으려니와 그 땅을 보지 못하리라",
      "source_text_hash": "8308ec7d8383541ed3ed3b2e72d8514e431c47a0e38ed213071fa2958915d64d",
      "translation_text_hash": "d14a14fd50e50db1e9ca5ed99735cfb850f7a1a4d14f4209ec450fe5c618e919",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 또 내 그물을 그의 위에 치고 내 올무에 걸리게 하여 그를 끌고 갈대아 땅 바벨론에 이르리니 그가 거기서 죽으려니와 그 땅을 보지 못하리라"
      ],
      "raw_text_hashes": [
