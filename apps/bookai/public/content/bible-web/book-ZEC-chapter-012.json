    {
      "canonical_locator": "bible:web:ZEC:12:8",
      "sequence": 23054,
      "chapter_label": "ZEC 12",
      "verse_label": "8",
      "locator": {
        "book": "ZEC",
        "chapter": 12,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "ZEC",
          "chapter": 12,
          "verse": 8
        }
      ],
      "en": "In that day the LORD will defend the inhabitants of Jerusalem. He who is feeble among them at that day will be like David, and David’s house will be like God, like the LORD’s angel before them.",
      "ko": "그 날에 여호와가 예루살렘 거민을 보호하리니 그 중에 약한 자가 그 날에는 다윗 같겠고 다윗의 족속은 하나님 같고 무리 앞에 있는 여호와의 사자 같을 것이라",
      "source_text_hash": "291b5588e7eeda2eb221feac7e69a9a8631c284434f4e33239b5b15b80a64edd",
      "translation_text_hash": "670d7414457cf220faee16e1b30cd6f5390c45608079117ab98ca310a287ff82",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 날에 여호와가 예루살렘 거민을 보호하리니 그 중에 약한 자가 그 날에는 다윗 같겠고 다윗의 족속은 하나님 같고 무리 앞에 있는 여호와의 사자 같을 것이라"
      ],
      "raw_text_hashes": [
