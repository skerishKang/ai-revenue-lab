      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 기스의 아들 사울을 인하여 시글락에 숨어 있을 때에 그에게 와서 싸움을 돕는 용사 중에 든 자가 있었으니"
      ],
      "raw_text_hashes": [
        "7a7221534c0b701aadc1fa3f18b984c4feea3df6078229e49079e7a7026edc2f"
