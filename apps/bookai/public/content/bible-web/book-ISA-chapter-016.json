    {
      "canonical_locator": "bible:web:ISA:16:10",
      "sequence": 17980,
      "chapter_label": "ISA 16",
      "verse_label": "10",
      "locator": {
        "book": "ISA",
        "chapter": 16,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 16,
          "verse": 10
        }
      ],
      "en": "Gladness is taken away, and joy out of the fruitful field; and in the vineyards there will be no singing, neither joyful noise. Nobody will tread out wine in the presses. I have made the shouting stop.",
      "ko": "즐거움과 기쁨이 기름진 밭에서 떠났고 포도원에는 노래와 즐거운 소리가 없어지겠고 틀에는 포도를 밟을 사람이 없으리니 이는 내가 그 소리를 그치게 하였음이라",
      "source_text_hash": "402fd89fdadc3c7e1e11e5d9e0b8780d3c66e4282596f536401c462df30e0b40",
      "translation_text_hash": "c99ffad5a68004ad97b43168ecb59ca0081add24f3d7c0713c184a5a6340c4ef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "즐거움과 기쁨이 기름진 밭에서 떠났고 포도원에는 노래와 즐거운 소리가 없어지겠고 틀에는 포도를 밟을 사람이 없으리니 이는 내가 그 소리를 그치게 하였음이라"
      ],
      "raw_text_hashes": [
        "c99ffad5a68004ad97b43168ecb59ca0081add24f3d7c0713c184a5a6340c4ef"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:16:11",
      "sequence": 17981,
      "chapter_label": "ISA 16",
      "verse_label": "11",
      "locator": {
        "book": "ISA",
        "chapter": 16,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 16,
          "verse": 11
        }
      ],
      "en": "Therefore my heart sounds like a harp for Moab, and my inward parts for Kir Heres.",
      "ko": "이러므로 나의 마음이 모압을 위하여 수금 같이 소리를 발하며 나의 창자가 길하레셋을 위하여 그러하도다",
      "source_text_hash": "0e2304ae7451276a40aa41c24ba1d61eff35f2528d5f4a35c70c61257d4c2ecf",
      "translation_text_hash": "14f6e3ceef2af284d0eef029ef485038444cca9ffbefe6854c993ff4d45d373d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이러므로 나의 마음이 모압을 위하여 수금 같이 소리를 발하며 나의 창자가 길하레셋을 위하여 그러하도다"
      ],
      "raw_text_hashes": [
        "14f6e3ceef2af284d0eef029ef485038444cca9ffbefe6854c993ff4d45d373d"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:16:12",
      "sequence": 17982,
      "chapter_label": "ISA 16",
