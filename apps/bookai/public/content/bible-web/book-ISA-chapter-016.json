      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 16,
          "verse": 13
        }
      ],
      "en": "This is the word that the LORD spoke concerning Moab in time past.",
      "ko": "이는 여호와께서 전에 모압을 들어 하신 말씀이어니와",
      "source_text_hash": "faf5580c64b48a778cc454f35bfab41cfffe03895d0950eb74dab638d0a49cfc",
      "translation_text_hash": "28b846693885e056f9896619fb9512bfdfc512acaa8bc3dff51994389028b01b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
