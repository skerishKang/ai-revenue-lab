        "verse": 7
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 5,
          "verse": 7
        }
      ],
      "en": "“You shall have no other gods before me.",
      "ko": "나 외에는 위하는 신들을 네게 있게 말찌니라",
      "source_text_hash": "b83afeb8091631e55436b6d33885c3879211112d01dffc5e8b56e5976bc53f65",
      "translation_text_hash": "b7682f211b9bdbb58247f0db392dd66c18c0d87ae809111d00d664e3351de6c9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
