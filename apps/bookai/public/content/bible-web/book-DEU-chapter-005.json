      ],
      "raw_text_hashes": [
        "b7682f211b9bdbb58247f0db392dd66c18c0d87ae809111d00d664e3351de6c9"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:5:8",
      "sequence": 5062,
      "chapter_label": "DEU 5",
      "verse_label": "8",
      "locator": {
        "book": "DEU",
        "chapter": 5,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 5,
          "verse": 8
        }
      ],
      "en": "“You shall not make a carved image for yourself—any likeness of what is in heaven above, or what is on the earth beneath, or that is in the water under the earth.",
      "ko": "너는 자기를 위하여 새긴 우상을 만들지 말고 위로 하늘에 있는 것이나 아래로 땅에 있는 것이나 땅 밑 물 속에 있는 것의 아무 형상이든지 만들지 말며",
      "source_text_hash": "af3866b28020fdee723e998fefc0f9dc1fd2163a3ba82c4d8dabc1590cb17b38",
      "translation_text_hash": "eb8a7334057925c5a3bfad6b61fc192d8b0252a5ed13b9f35492cdefba9c29b4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 자기를 위하여 새긴 우상을 만들지 말고 위로 하늘에 있는 것이나 아래로 땅에 있는 것이나 땅 밑 물 속에 있는 것의 아무 형상이든지 만들지 말며"
      ],
      "raw_text_hashes": [
        "eb8a7334057925c5a3bfad6b61fc192d8b0252a5ed13b9f35492cdefba9c29b4"
      ]
