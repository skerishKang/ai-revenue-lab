    {
      "canonical_locator": "bible:web:DEU:5:6",
      "sequence": 5060,
      "chapter_label": "DEU 5",
      "verse_label": "6",
      "locator": {
        "book": "DEU",
        "chapter": 5,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 5,
          "verse": 6
        }
      ],
      "en": "“I am the LORD your God, who brought you out of the land of Egypt, out of the house of bondage.",
      "ko": "나는 너를 애굽 땅에서 종 되었던 집에서 인도하여 낸 너희 하나님 여호와로라",
      "source_text_hash": "6dc63617225e6acdf4400a27bb9207bef363149b8928640283ed8df92b7abcc5",
      "translation_text_hash": "f3c8d7506e51c31cac4f68fee66edea9c3c48a2b0a42c4d7f46ddd9608860dc2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나는 너를 애굽 땅에서 종 되었던 집에서 인도하여 낸 너희 하나님 여호와로라"
      ],
      "raw_text_hashes": [
        "f3c8d7506e51c31cac4f68fee66edea9c3c48a2b0a42c4d7f46ddd9608860dc2"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:5:7",
      "sequence": 5061,
      "chapter_label": "DEU 5",
      "verse_label": "7",
      "locator": {
        "book": "DEU",
