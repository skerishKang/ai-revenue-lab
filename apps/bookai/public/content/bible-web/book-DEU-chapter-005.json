      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 5,
          "verse": 12
        }
      ],
      "en": "“Observe the Sabbath day, to keep it holy, as the LORD your God commanded you.",
      "ko": "여호와 너의 하나님이 네게 명한대로 안식일을 지켜 거룩하게 하라",
      "source_text_hash": "67887d5f1fbdb343f1aa0bc4af3f9cf78f1672f308997c4f97c0b9c777ad26c3",
      "translation_text_hash": "fb2701ae962c17aa94eee3d354eeef716170b562506991ecf1f80f3131660a8c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와 너의 하나님이 네게 명한대로 안식일을 지켜 거룩하게 하라"
      ],
      "raw_text_hashes": [
        "fb2701ae962c17aa94eee3d354eeef716170b562506991ecf1f80f3131660a8c"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:5:13",
      "sequence": 5067,
      "chapter_label": "DEU 5",
      "verse_label": "13",
      "locator": {
        "book": "DEU",
        "chapter": 5,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 5,
          "verse": 13
        }
      ],
      "en": "You shall labor six days, and do all your work;",
      "ko": "엿새 동안은 힘써 네 모든 일을 행할 것이나",
      "source_text_hash": "eab8405664a2aec93d7bb65ffab425442a93bd3015d150dca549bc1f32db2674",
      "translation_text_hash": "1622ce55de004fb6b17d3d9e32a9e960eb179cad497b5a97491a9d51dd95fefe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "엿새 동안은 힘써 네 모든 일을 행할 것이나"
      ],
      "raw_text_hashes": [
        "1622ce55de004fb6b17d3d9e32a9e960eb179cad497b5a97491a9d51dd95fefe"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:5:14",
      "sequence": 5068,
      "chapter_label": "DEU 5",
      "verse_label": "14",
      "locator": {
        "book": "DEU",
        "chapter": 5,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 5,
          "verse": 14
        }
      ],
      "en": "but the seventh day is a Sabbath to the LORD your God, in which you shall not do any work—neither you, nor your son, nor your daughter, nor your male servant, nor your female servant, nor your ox, nor your donkey, nor any of your livestock, nor your stranger who is within your gates; that your male servant and your female servant may rest as well as you.",
      "ko": "제 칠일은 너의 하나님 여호와의 안식인즉 너나 네 아들이나 네 딸이나 네 남종이나 네 여종이나 네 소나 네 나귀나 네 모든 육축이나 네 문 안에 유하는 객이라도 아무 일도 하지 말고 네 남종이나 네 여종으로 너 같이 안식하게 할찌니라",
      "source_text_hash": "801f6ed42e8c50e80c27ca31dedd4f0bfb0940af6c131f916920ccb8619b10e3",
      "translation_text_hash": "f807bb68354fc1dee4b655a056d7d94b5df55c7a3da48125596a6c5a3d6bfd97",
      "translation_policy": "krv-1961-source-mapped",
