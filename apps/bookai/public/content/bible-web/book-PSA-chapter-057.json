      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 지극히 높으신 하나님께 부르짖음이여 곧 나를 위하여 모든 것을 이루시는 하나님께로다"
      ],
      "raw_text_hashes": [
        "0e9d250298c3a0ee461ccefcca8d051b76fd0026de0c6ce708f2c82e197c280e"
