      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 3,
          "verse": 11
        }
      ],
      "en": "Woe to the wicked! Disaster is upon them, for the deeds of their hands will be paid back to them.",
      "ko": "악인에게는 화가 있으리니 화가 있을 것은 그 손으로 행한대로 보응을 받을 것임이니라",
      "source_text_hash": "00724d906211192101c0faeb4795d6971ad0a4672d62828d9e14378a690ae05b",
      "translation_text_hash": "eebc0c6351343f6601f3f0d5c8162cc2c61f9b2a21427a5771396c76bb613b55",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악인에게는 화가 있으리니 화가 있을 것은 그 손으로 행한대로 보응을 받을 것임이니라"
      ],
      "raw_text_hashes": [
        "eebc0c6351343f6601f3f0d5c8162cc2c61f9b2a21427a5771396c76bb613b55"
      ]
