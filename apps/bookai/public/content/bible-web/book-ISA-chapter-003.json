      "translation_text_hash": "82942412bc96a7be2dd690665372b994c8b232a3a67fef78e52c9a1de44b5b3d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
