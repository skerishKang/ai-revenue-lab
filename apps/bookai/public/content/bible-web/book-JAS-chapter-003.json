        "chapter": 3,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "JAS",
          "chapter": 3,
          "verse": 10
        }
      ],
      "en": "Out of the same mouth comes blessing and cursing. My brothers, these things ought not to be so.",
      "ko": "한 입으로 찬송과 저주가 나는도다 내 형제들아 이것이 마땅치 아니하니라",
      "source_text_hash": "96a4f85a9cbdcbddb6911d9617d9b3a8862e837a793960435ccc0111298c077a",
      "translation_text_hash": "015d7b67c0e6a06ca6965c1754df2c939e5fd01ea0c51af9bf7ad041fa3342a5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한 입으로 찬송과 저주가 나는도다 내 형제들아 이것이 마땅치 아니하니라"
      ],
      "raw_text_hashes": [
        "015d7b67c0e6a06ca6965c1754df2c939e5fd01ea0c51af9bf7ad041fa3342a5"
      ]
    },
    {
      "canonical_locator": "bible:web:JAS:3:11",
      "sequence": 30327,
      "chapter_label": "JAS 3",
      "verse_label": "11",
