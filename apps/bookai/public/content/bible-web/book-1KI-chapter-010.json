        {
          "book": "1KI",
          "chapter": 10,
          "verse": 4
        }
      ],
      "en": "When the queen of Sheba had seen all the wisdom of Solomon, the house that he had built,",
      "ko": "스바 여왕이 솔로몬의 모든 지혜와 그 건축한 궁과",
      "source_text_hash": "4ccadd2925db12239e57aca735dacaa86091895375bfa93dc60baaf6ac6f0ebb",
      "translation_text_hash": "59c6d51dead38b8640236a566afa951b33ff5f0652e99422ab2781059d2167a1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "스바 여왕이 솔로몬의 모든 지혜와 그 건축한 궁과"
      ],
      "raw_text_hashes": [
        "59c6d51dead38b8640236a566afa951b33ff5f0652e99422ab2781059d2167a1"
      ]
    },
    {
      "canonical_locator": "bible:web:1KI:10:5",
      "sequence": 9085,
