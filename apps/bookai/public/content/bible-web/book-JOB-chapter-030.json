      "translation_text_hash": "5ca34691a74ac6c0d3b7bebe4b2de02821de28841016de56c16f357bc805a3ef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
