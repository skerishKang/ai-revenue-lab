      "translation_text_hash": "89688f5784e5653325be41649c4468c7a7af6838bc4f5737853fa604086949da",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들은 장년의 기력이 쇠한 자니 그 손의 힘이 내게 무엇이 유익하랴"
      ],
      "raw_text_hashes": [
        "89688f5784e5653325be41649c4468c7a7af6838bc4f5737853fa604086949da"
