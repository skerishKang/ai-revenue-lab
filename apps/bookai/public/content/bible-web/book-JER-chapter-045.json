      ],
      "en": "“The LORD, the God of Israel, says to you, Baruch:",
      "ko": "바룩아 이스라엘의 하나님 여호와께서 네게 이같이 말씀하시되",
      "source_text_hash": "f959bed3c3f9c0427f0107b5b2b0d6ac36acfab7122c37f120dd5b4a5cd3b5a1",
      "translation_text_hash": "a8acb00563677b3e8a828e12376e7f6b535ff944d1037dcdaf37fb9b0185996a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바룩아 이스라엘의 하나님 여호와께서 네게 이같이 말씀하시되"
      ],
      "raw_text_hashes": [
        "a8acb00563677b3e8a828e12376e7f6b535ff944d1037dcdaf37fb9b0185996a"
      ]
    },
