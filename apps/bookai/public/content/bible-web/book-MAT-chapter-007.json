      "source_text_hash": "c7c94c339f5590bc97ab48fec32107c1054973550f7c1aaccf0cde551d7c48a1",
      "translation_text_hash": "c1bff6744f178cd7a44011b7dfcdf48e8db6fae8f63012b254d693fb349357d6",
