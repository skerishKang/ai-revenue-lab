      "translation_text_hash": "efbc9adb7263a26cd707f8a6135da78f55c6d4dfe4b3bc291600f347f777fd33",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
