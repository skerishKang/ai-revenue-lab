      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "미쁘다 이 말이여, 우리가 주와 함께 죽었으면 또한 함께 살 것이요"
      ],
      "raw_text_hashes": [
        "3c01322b82fddcbec57f06044d4bdec66702b733279aba34f39a791abac21931"
      ]
