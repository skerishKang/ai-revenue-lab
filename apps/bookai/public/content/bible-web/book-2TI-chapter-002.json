      "translation_text_hash": "0ea1dadcb14b80fc8489ccca8b06aa5733b5e8216dc10542e7c0ee7921d91f11",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "참으면 또한 함께 왕노릇할 것이요 우리가 주를 부인하면 주도 우리를 부인하실 것이라"
      ],
      "raw_text_hashes": [
