      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 1,
          "verse": 7
        }
      ],
      "en": "The LORD said to Satan, “Where have you come from?” Then Satan answered the LORD, and said, “From going back and forth on the earth, and from walking up and down in it.”",
      "ko": "여호와께서 사단에게 이르시되 네가 어디서 왔느냐 사단이 여호와께 대답하여 가로되 땅에 두루 돌아 여기 저기 다녀 왔나이다",
      "source_text_hash": "a7631d182c0ef90724219535eec5cbfb36702a85c6f4d4079663055490a74aba",
      "translation_text_hash": "2308eaedf0bc0f6f6cc4a3d0067008261b035c7170b91506f90185f1e790e2e1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 사단에게 이르시되 네가 어디서 왔느냐 사단이 여호와께 대답하여 가로되 땅에 두루 돌아 여기 저기 다녀 왔나이다"
      ],
      "raw_text_hashes": [
