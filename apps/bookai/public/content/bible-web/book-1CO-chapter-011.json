      "translation_text_hash": "ed65f7c77f57b8131a73a5bd62cbab46e208a560e143bcec2be6d9460ed8fa5c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
