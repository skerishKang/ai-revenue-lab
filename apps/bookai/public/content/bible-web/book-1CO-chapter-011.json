      "source_text_hash": "05a485110dbc212d9d755a686730e8006b31c64f9c09e08b80275bc0d16769d1",
      "translation_text_hash": "13b16a385533a174a5fbeaa497911491ff5ac830a2e5b30a8051cd2b43ebfd76",
      "translation_policy": "krv-1961-source-mapped",
