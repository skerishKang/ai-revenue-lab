      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여자가 남자에게서 난것 같이 남자도 여자로 말미암아 났으나 모든것이 하나님에게서 났느니라"
      ],
      "raw_text_hashes": [
        "deef24bd468138a5858b339ad3caa0efd021b352b326030c5db0bf87a69993b1"
      ]
    },
