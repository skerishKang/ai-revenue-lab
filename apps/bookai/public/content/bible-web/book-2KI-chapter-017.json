    {
      "canonical_locator": "bible:web:2KI:17:17",
      "sequence": 10001,
      "chapter_label": "2KI 17",
      "verse_label": "17",
      "locator": {
        "book": "2KI",
        "chapter": 17,
        "verse": 17
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 17,
          "verse": 17
        }
      ],
      "en": "They caused their sons and their daughters to pass through the fire, used divination and enchantments, and sold themselves to do that which was evil in the LORD’s sight, to provoke him to anger.",
      "ko": "또 자기 자녀를 불 가운데로 지나가게 하며 복술과 사술을 행하고 스스로 팔려 여호와 보시기에 악을 행하여 그 노를 격발케 하였으므로",
      "source_text_hash": "362b4dce4a2f6175f5055b62108d64931bd02b1f187a7950eba41c2fee560494",
      "translation_text_hash": "ee1617983b33b3e5ec987f76ad5df33471d0f5d9584d7718dc4cc6c40397a4b0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 자기 자녀를 불 가운데로 지나가게 하며 복술과 사술을 행하고 스스로 팔려 여호와 보시기에 악을 행하여 그 노를 격발케 하였으므로"
      ],
      "raw_text_hashes": [
        "ee1617983b33b3e5ec987f76ad5df33471d0f5d9584d7718dc4cc6c40397a4b0"
