      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바벨론 사람들은 숙곳브놋을 만들었고 굿 사람들은 네르갈을 만들었고 하맛 사람들은 아시마를 만들었고"
      ],
      "raw_text_hashes": [
