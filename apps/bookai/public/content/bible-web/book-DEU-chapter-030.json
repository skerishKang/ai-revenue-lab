  "passages": [
    {
      "canonical_locator": "bible:web:DEU:30:1",
      "sequence": 5710,
      "chapter_label": "DEU 30",
      "verse_label": "1",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 1
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 1
        }
      ],
      "en": "It shall happen, when all these things have come on you, the blessing and the curse, which I have set before you, and you shall call them to mind among all the nations where the LORD your God has driven you,",
      "ko": "내가 네게 진술한 모든 복과 저주가 네게 임하므로 네가 네 하나님 여호와께 쫓겨간 모든 나라 가운데서 이 일이 마음에서 기억이 나거든",
      "source_text_hash": "8cdcbea97054719e1ed202000dcaa5969cbaddf724de82f13ec9d823b82d639e",
      "translation_text_hash": "4990a261be540df9b31b51e5a8a8f371355ed7bf5d0cc5205ceca91d9d0e4164",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 네게 진술한 모든 복과 저주가 네게 임하므로 네가 네 하나님 여호와께 쫓겨간 모든 나라 가운데서 이 일이 마음에서 기억이 나거든"
      ],
      "raw_text_hashes": [
        "4990a261be540df9b31b51e5a8a8f371355ed7bf5d0cc5205ceca91d9d0e4164"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:2",
      "sequence": 5711,
      "chapter_label": "DEU 30",
      "verse_label": "2",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 2
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 2
        }
      ],
      "en": "and return to the LORD your God and obey his voice according to all that I command you today, you and your children, with all your heart and with all your soul,",
      "ko": "너와 네 자손이 네 하나님 여호와께로 돌아와 내가 오늘날 네게 명한 것을 온전히 따라서 마음을 다하고 성품을 다하여 여호와의 말씀을 순종하면",
      "source_text_hash": "cf70aac6ab3f330a1aa20d0bbe0949da86c5d0ad8f96ed76280faf1a4844afbc",
      "translation_text_hash": "1703985f86908c2756b40255ff20d2cc49d2c98e9a8199de97a7f83546959457",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너와 네 자손이 네 하나님 여호와께로 돌아와 내가 오늘날 네게 명한 것을 온전히 따라서 마음을 다하고 성품을 다하여 여호와의 말씀을 순종하면"
      ],
      "raw_text_hashes": [
        "1703985f86908c2756b40255ff20d2cc49d2c98e9a8199de97a7f83546959457"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:3",
      "sequence": 5712,
      "chapter_label": "DEU 30",
      "verse_label": "3",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 3
        }
      ],
      "en": "that then the LORD your God will release you from captivity, have compassion on you, and will return and gather you from all the peoples where the LORD your God has scattered you.",
      "ko": "네 하나님 여호와께서 마음을 돌이키시고 너를 긍휼히 여기사 네 포로를 돌리시되 네 하나님 여호와께서 너를 흩으신 그 모든 백성 중에서 너를 모으시리니",
      "source_text_hash": "c5f285b77d638cf87a6da5fd22460379e2f24ea4b4f32e88081f5b502cdd42e8",
      "translation_text_hash": "6f19053572bb12b39f3d62b246798be65a7f43f7e63a64408fb1a09fb1535a8f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께서 마음을 돌이키시고 너를 긍휼히 여기사 네 포로를 돌리시되 네 하나님 여호와께서 너를 흩으신 그 모든 백성 중에서 너를 모으시리니"
      ],
      "raw_text_hashes": [
        "6f19053572bb12b39f3d62b246798be65a7f43f7e63a64408fb1a09fb1535a8f"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:4",
      "sequence": 5713,
      "chapter_label": "DEU 30",
      "verse_label": "4",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 4
        }
      ],
      "en": "If your outcasts are in the uttermost parts of the heavens, from there the LORD your God will gather you, and from there he will bring you back.",
      "ko": "너의 쫓겨간 자들이 하늘 가에 있을찌라도 네 하나님 여호와께서 거기서 너를 모으실 것이며 거기서부터 너를 이끄실 것이라",
      "source_text_hash": "757c2118648b875a1a810c6f5a0ba8404ded47839e224410779b45a52290e787",
      "translation_text_hash": "04c7be3fff027db438f473d8d73a26c9e2445baabf71e2f267be6df0e421b89c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너의 쫓겨간 자들이 하늘 가에 있을찌라도 네 하나님 여호와께서 거기서 너를 모으실 것이며 거기서부터 너를 이끄실 것이라"
      ],
      "raw_text_hashes": [
        "04c7be3fff027db438f473d8d73a26c9e2445baabf71e2f267be6df0e421b89c"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:5",
      "sequence": 5714,
      "chapter_label": "DEU 30",
      "verse_label": "5",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 5
        }
      ],
      "en": "The LORD your God will bring you into the land which your fathers possessed, and you will possess it. He will do you good, and increase your numbers more than your fathers.",
      "ko": "네 하나님 여호와께서 너를 네 열조가 얻은 땅으로 돌아오게 하사 너로 다시 그것을 얻게 하실 것이며 여호와께서 또 네게 선을 행하사 너로 네 열조보다 더 번성케 하실 것이며",
      "source_text_hash": "d70a31463e96fb599b04bc32a060b41c3998c2685493f4c1ada635b620b75c34",
      "translation_text_hash": "11eca6b6ec9d78f1cbfac6f5bfccbd1e8e329f90866235e53efc6a259744e68a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께서 너를 네 열조가 얻은 땅으로 돌아오게 하사 너로 다시 그것을 얻게 하실 것이며 여호와께서 또 네게 선을 행하사 너로 네 열조보다 더 번성케 하실 것이며"
      ],
      "raw_text_hashes": [
        "11eca6b6ec9d78f1cbfac6f5bfccbd1e8e329f90866235e53efc6a259744e68a"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:6",
      "sequence": 5715,
      "chapter_label": "DEU 30",
      "verse_label": "6",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 6
        }
      ],
      "en": "The LORD your God will circumcise your heart, and the heart of your offspring, to love the LORD your God with all your heart and with all your soul, that you may live.",
      "ko": "네 하나님 여호와께서 네 마음과 네 자손의 마음에 할례를 베푸사 너로 마음을 다하며 성품을 다하여 네 하나님 여호와를 사랑하게 하사 너로 생명을 얻게 하실 것이며",
      "source_text_hash": "ba61be917026ff20932c0e05bea7e227361ad812b87fb5ae8767ce576c044069",
      "translation_text_hash": "f2fd0c23885d1753c8bfd98271d45c454ad36a40a8321012078f74f5ed90251f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께서 네 마음과 네 자손의 마음에 할례를 베푸사 너로 마음을 다하며 성품을 다하여 네 하나님 여호와를 사랑하게 하사 너로 생명을 얻게 하실 것이며"
      ],
      "raw_text_hashes": [
        "f2fd0c23885d1753c8bfd98271d45c454ad36a40a8321012078f74f5ed90251f"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:7",
      "sequence": 5716,
      "chapter_label": "DEU 30",
      "verse_label": "7",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 7
        }
      ],
      "en": "The LORD your God will put all these curses on your enemies and on those who hate you, who persecuted you.",
      "ko": "네 하나님 여호와께서 네 대적과 너를 미워하고 핍박하던 자에게 이 모든 저주로 임하게 하시리니",
      "source_text_hash": "b788ce72b01f158b41bc519f9e3133da75c8f9a8fb13836da7e8c232d45c21d5",
      "translation_text_hash": "30abe8580af3493f66d68b65cf5f1d4db1a4abb25100e329f2a08d7111a19c13",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께서 네 대적과 너를 미워하고 핍박하던 자에게 이 모든 저주로 임하게 하시리니"
      ],
      "raw_text_hashes": [
        "30abe8580af3493f66d68b65cf5f1d4db1a4abb25100e329f2a08d7111a19c13"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:8",
      "sequence": 5717,
      "chapter_label": "DEU 30",
      "verse_label": "8",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 8
        }
      ],
      "en": "You shall return and obey the LORD’s voice, and do all his commandments which I command you today.",
      "ko": "너는 돌아와 다시 여호와의 말씀을 순종하고 내가 오늘날 네게 명한 그 모든 명령을 행할 것이라",
      "source_text_hash": "3992f8569c3a6a1c8e9af4c3af780b5680888656b408ded16aa6188376c01744",
      "translation_text_hash": "8d69b1de82e62fb643b29048a58eec15393578f3985282a270eae6dc86b6e790",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 돌아와 다시 여호와의 말씀을 순종하고 내가 오늘날 네게 명한 그 모든 명령을 행할 것이라"
      ],
      "raw_text_hashes": [
        "8d69b1de82e62fb643b29048a58eec15393578f3985282a270eae6dc86b6e790"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:9",
      "sequence": 5718,
      "chapter_label": "DEU 30",
      "verse_label": "9",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 9
        }
      ],
      "en": "The LORD your God will make you prosperous in all the work of your hand, in the fruit of your body, in the fruit of your livestock, and in the fruit of your ground, for good; for the LORD will again rejoice over you for good, as he rejoiced over your fathers,",
      "ko": "네가 네 하나님 여호와의 말씀을 순종하여 이 율법 책에 기록된 그 명령과 규례를 지키고 네 마음을 다하며 성품을 다하여 여호와 네 하나님께 돌아오면 네 하나님 여호와께서 네 손으로 하는 모든 일과 네 몸의 소생과 네 육축의 새끼와 네 토지 소산을 많게 하시고 네게 복을 주시되 곧 여호와께서 네 열조를 기뻐하신 것과 같이 너를 다시 기뻐하사 네게 복을 주시리라",
      "source_text_hash": "9df7ad4af3a9ba264f35b9276882ddaca2b9b77d12ad6500fecf62cd3f1f27f6",
      "translation_text_hash": "2088a3fd9df8519c33f816b1d96cfdad01de41044f77959fc9ae2b49885584fa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 네 하나님 여호와의 말씀을 순종하여 이 율법 책에 기록된 그 명령과 규례를 지키고 네 마음을 다하며 성품을 다하여 여호와 네 하나님께 돌아오면 네 하나님 여호와께서 네 손으로 하는 모든 일과 네 몸의 소생과 네 육축의 새끼와 네 토지 소산을 많게 하시고 네게 복을 주시되 곧 여호와께서 네 열조를 기뻐하신 것과 같이 너를 다시 기뻐하사 네게 복을 주시리라"
      ],
      "raw_text_hashes": [
        "2088a3fd9df8519c33f816b1d96cfdad01de41044f77959fc9ae2b49885584fa"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:10",
      "sequence": 5719,
      "chapter_label": "DEU 30",
      "verse_label": "10",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 10
        }
      ],
      "en": "if you will obey the LORD your God’s voice, to keep his commandments and his statutes which are written in this book of the law, if you turn to the LORD your God with all your heart and with all your soul.",
      "ko": "(9절에 포함되어 있음)",
      "source_text_hash": "865cbd2f089398381aa966b36a89a62f5f2c552a36e96703bae96c3b4d471858",
      "translation_text_hash": "d6102cbd284ed98997dd534c98278fd7717161db9af5d85c57374354062f14db",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "(9절에 포함되어 있음)"
      ],
      "raw_text_hashes": [
        "d6102cbd284ed98997dd534c98278fd7717161db9af5d85c57374354062f14db"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:11",
      "sequence": 5720,
      "chapter_label": "DEU 30",
      "verse_label": "11",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 11
        }
      ],
      "en": "For this commandment which I command you today is not too hard for you or too distant.",
      "ko": "내가 오늘날 네게 명한 이 명령은 네게 어려운 것도 아니요 먼 것도 아니라",
      "source_text_hash": "682520ff90df988634fc59bcf8b62516416548453ead06213fe5844f88dc595a",
      "translation_text_hash": "dd90771b095062b23b85bd66be58bb51f0079e733df700bd721bd6c026abc46e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 오늘날 네게 명한 이 명령은 네게 어려운 것도 아니요 먼 것도 아니라"
      ],
      "raw_text_hashes": [
        "dd90771b095062b23b85bd66be58bb51f0079e733df700bd721bd6c026abc46e"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:30:12",
      "sequence": 5721,
      "chapter_label": "DEU 30",
      "verse_label": "12",
      "locator": {
        "book": "DEU",
        "chapter": 30,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 30,
          "verse": 12
        }
      ],
      "en": "It is not in heaven, that you should say, “Who will go up for us to heaven, bring it to us, and proclaim it to us, that we may do it?”",
      "ko": "하늘에 있는 것이 아니니 네가 이르기를 누가 우리를 위하여 하늘에 올라가서 그 명령을 우리에게로 가지고 와서 우리에게 들려 행하게 할꼬 할것이 아니요",
      "source_text_hash": "76975a4936496d48115f67e68507548ef20550f6fd92a0f0be4b6b3435a0864f",
      "translation_text_hash": "6787281f5fc11c4e8de6bc54b8d711534144123e50e0e52df309ce98cbdb5689",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하늘에 있는 것이 아니니 네가 이르기를 누가 우리를 위하여 하늘에 올라가서 그 명령을 우리에게로 가지고 와서 우리에게 들려 행하게 할꼬 할것이 아니요"
      ],
      "raw_text_hashes": [
