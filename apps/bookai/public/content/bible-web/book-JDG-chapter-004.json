      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시스라가 모든 병거 곧 철병거 구백승과 자기와 함께 있는 온 군사를 이방 하로셋에서부터 기손강으로 모은지라"
      ],
      "raw_text_hashes": [
        "3463efe9e66afff79cd828d83906125d7c50b3ded2b4f1e655aeb2110f3d2020"
