        "verse": 8
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 11,
          "verse": 8
        }
      ],
      "en": "Therefore you shall keep the entire commandment which I command you today, that you may be strong, and go in and possess the land that you go over to possess;",
      "ko": "그러므로 너희는 내가 오늘날 너희에게 명하는 모든 명령을 지키라 그리하면 너희가 강성할 것이요 너희가 건너가서 얻을 땅에 들어가서 그것을 얻을 것이며",
      "source_text_hash": "56495260efced715f281d6ebc1db07646c2dfdc4ad7aa303ab37f107be6d9ec5",
      "translation_text_hash": "5eb944ccff972dbe6b727d3e11d7950063cec50486a19d37ec4287bb749a2855",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 너희는 내가 오늘날 너희에게 명하는 모든 명령을 지키라 그리하면 너희가 강성할 것이요 너희가 건너가서 얻을 땅에 들어가서 그것을 얻을 것이며"
      ],
      "raw_text_hashes": [
        "5eb944ccff972dbe6b727d3e11d7950063cec50486a19d37ec4287bb749a2855"
      ]
