        "verse": 3
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 11,
          "verse": 3
        }
      ],
      "en": "his signs, and his works, which he did in the middle of Egypt to Pharaoh the king of Egypt, and to all his land;",
      "ko": "애굽에서 그 왕 바로와 그 전국에 행하신 이적과 기사와",
      "source_text_hash": "2f589c6def35f0006eb8c42c3ce94799c41b76b9f7b3b399f628cd47824b094c",
      "translation_text_hash": "a056706fe267d7b62c42029303e58888c03cb17e403e5cbd215cf6e4727677eb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "애굽에서 그 왕 바로와 그 전국에 행하신 이적과 기사와"
      ],
      "raw_text_hashes": [
        "a056706fe267d7b62c42029303e58888c03cb17e403e5cbd215cf6e4727677eb"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:11:4",
      "sequence": 5213,
      "chapter_label": "DEU 11",
