        }
      ],
      "en": "Moses commanded the Levites, who bore the ark of the LORD’s covenant, saying,",
      "ko": "여호와의 언약궤를 메는 레위 사람에게 명하여 가로되",
      "source_text_hash": "388d33e61280e57256d16c16fa7e640fd874d695c3efe911f019151621773849",
      "translation_text_hash": "8221e947f74ff541b0e13ab533b3c4484df78ee2de2dfd91e54e1653f9bf370b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 언약궤를 메는 레위 사람에게 명하여 가로되"
      ],
      "raw_text_hashes": [
        "8221e947f74ff541b0e13ab533b3c4484df78ee2de2dfd91e54e1653f9bf370b"
      ]
