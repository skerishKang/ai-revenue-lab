          "book": "DEU",
          "chapter": 31,
          "verse": 1
        }
      ],
      "en": "Moses went and spoke these words to all Israel.",
      "ko": "모세가 가서 온 이스라엘에게 이 말씀을 베푸니라",
      "source_text_hash": "5a1cb25ca90dd86a923a9fe2d8f537f723f71b32fb0307857ccd2ed1a616828b",
      "translation_text_hash": "e8cfe37a24789b7fd70dfa3f608486d1e37f6448cf6fc5efa207d36bff77abda",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세가 가서 온 이스라엘에게 이 말씀을 베푸니라"
      ],
      "raw_text_hashes": [
        "e8cfe37a24789b7fd70dfa3f608486d1e37f6448cf6fc5efa207d36bff77abda"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:31:2",
      "sequence": 5731,
      "chapter_label": "DEU 31",
      "verse_label": "2",
      "locator": {
