      "source_text_hash": "d8e94e2e4c2c2381bf2c50a56c3487be2d09795c44a1f47226ed676b048b58c0",
      "translation_text_hash": "00476015c22bc5b0f70d40e847f371754eebf708a8f6437332ba11e7fbe2e4b3",
