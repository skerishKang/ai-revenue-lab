        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 27,
          "verse": 8
        }
      ],
      "en": "You shall make it hollow with planks. They shall make it as it has been shown you on the mountain.",
      "ko": "단은 널판으로 비게 만들되 산에서 네게 보인대로 그들이 만들찌니라",
      "source_text_hash": "3765eeec8e4896952dafa31da07fd1bda9f77127eb3e24dabdc65df2b3c8e277",
      "translation_text_hash": "77ff40d2e86ab0472e63f03e681972323d3e1140a2abefa50cc1d06a0065604e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "단은 널판으로 비게 만들되 산에서 네게 보인대로 그들이 만들찌니라"
      ],
      "raw_text_hashes": [
        "77ff40d2e86ab0472e63f03e681972323d3e1140a2abefa50cc1d06a0065604e"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:27:9",
      "sequence": 2282,
      "chapter_label": "EXO 27",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
        "chapter": 27,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 27,
          "verse": 9
        }
      ],
      "en": "“You shall make the court of the tabernacle: for the south side southward there shall be hangings for the court of fine twined linen one hundred cubits long for one side.",
      "ko": "너는 성막의 뜰을 만들찌니 남을 향하여 뜰 남편에 광이 백 규빗의 세마포장을 쳐서 그 한 편을 당하게 할찌니",
      "source_text_hash": "78838eb1a5fab0d29d3dc2595a591f5d1ae9908e85fe005f97545d42a1779639",
      "translation_text_hash": "58d6e2b3551def63252f3681990bb8bd78dad220dbd2f72f437448c154d6436c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 성막의 뜰을 만들찌니 남을 향하여 뜰 남편에 광이 백 규빗의 세마포장을 쳐서 그 한 편을 당하게 할찌니"
      ],
      "raw_text_hashes": [
        "58d6e2b3551def63252f3681990bb8bd78dad220dbd2f72f437448c154d6436c"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:27:10",
      "sequence": 2283,
      "chapter_label": "EXO 27",
      "verse_label": "10",
