        "verse": 7
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 27,
          "verse": 7
        }
      ],
      "en": "Its poles shall be put into the rings, and the poles shall be on the two sides of the altar when carrying it.",
      "ko": "단 양편 고리에 그 채를 꿰어 단을 메게 할찌며",
      "source_text_hash": "d070fab5099024d72572ba5460329742f96c16ff0c5503935fa9318f3c905927",
      "translation_text_hash": "5f2ab05c4b4113b1170e45a8bf40fa13ed5b8c9d6bc29037d8e25771d27febda",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "단 양편 고리에 그 채를 꿰어 단을 메게 할찌며"
      ],
      "raw_text_hashes": [
        "5f2ab05c4b4113b1170e45a8bf40fa13ed5b8c9d6bc29037d8e25771d27febda"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:27:8",
      "sequence": 2281,
      "chapter_label": "EXO 27",
      "verse_label": "8",
      "locator": {
