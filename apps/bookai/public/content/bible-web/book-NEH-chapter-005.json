        "verse": 4
      },
      "raw_locator": [
        {
          "book": "NEH",
          "chapter": 5,
          "verse": 4
        }
      ],
      "en": "There were also some who said, “We have borrowed money for the king’s tribute using our fields and our vineyards as collateral.",
      "ko": "혹은 말하기를 우리는 밭과 포도원으로 돈을 빚내어 세금을 바쳤도다",
      "source_text_hash": "e63c8330c754e96090ed71a6361b26470c70a154c051547686ed81f4131874fa",
      "translation_text_hash": "dcf7cf8a31ed157e340a80885af69f87ab9d1387621f885f445f5ac8d69ccfa9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "혹은 말하기를 우리는 밭과 포도원으로 돈을 빚내어 세금을 바쳤도다"
      ],
      "raw_text_hashes": [
        "dcf7cf8a31ed157e340a80885af69f87ab9d1387621f885f445f5ac8d69ccfa9"
      ]
    },
    {
      "canonical_locator": "bible:web:NEH:5:5",
      "sequence": 12388,
      "chapter_label": "NEH 5",
      "verse_label": "5",
      "locator": {
