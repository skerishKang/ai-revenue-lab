      "raw_locator": [
        {
          "book": "NEH",
          "chapter": 5,
          "verse": 17
        }
      ],
      "en": "Moreover there were at my table, of the Jews and the rulers, one hundred fifty men, in addition to those who came to us from among the nations that were around us.",
      "ko": "또 내 상에는 유다 사람들과 민장들 일백 오십인이 있고 그 외에도 우리 사면 이방인 중에서 우리에게 나아온 자들이 있었는데",
      "source_text_hash": "a0233a9028e7037a4f6dd5bdf1721783a14823f004a5fb23b01bc17a4a696a80",
      "translation_text_hash": "274f0c20be34b035e76bafb50d360f2545b8a3b5643d8ddf657ddaf3b20b474d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
