    {
      "canonical_locator": "bible:web:2JN:1:8",
      "sequence": 30650,
      "chapter_label": "2JN 1",
      "verse_label": "8",
      "locator": {
        "book": "2JN",
        "chapter": 1,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "2JN",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "Watch yourselves, that we don’t lose the things which we have accomplished, but that we receive a full reward.",
      "ko": "너희는 너희를 삼가 우리의 일한 것을 잃지 말고 오직 온전한 상을 얻으라",
      "source_text_hash": "7f300049632a3e08534b3f511e4cfb3adb27bfb00c5c4316a73e8bfbd85eaa92",
      "translation_text_hash": "093c49f8387c4e74908f2edf4f6909e8a3a2903011a7f3609bfd095e9c5d9e6a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 너희를 삼가 우리의 일한 것을 잃지 말고 오직 온전한 상을 얻으라"
      ],
      "raw_text_hashes": [
        "093c49f8387c4e74908f2edf4f6909e8a3a2903011a7f3609bfd095e9c5d9e6a"
      ]
    },
    {
      "canonical_locator": "bible:web:2JN:1:9",
      "sequence": 30651,
      "chapter_label": "2JN 1",
      "verse_label": "9",
      "locator": {
        "book": "2JN",
