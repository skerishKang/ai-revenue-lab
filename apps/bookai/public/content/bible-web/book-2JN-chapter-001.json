        "verse": 5
      },
      "raw_locator": [
        {
          "book": "2JN",
          "chapter": 1,
          "verse": 5
        }
      ],
      "en": "Now I beg you, dear lady, not as though I wrote to you a new commandment, but that which we had from the beginning, that we love one another.",
      "ko": "부녀여, 내가 이제 네게 구하노니 서로 사랑하자 이는 새 계명 같이 네게 쓰는 것이 아니요 오직 처음부터 우리가 가진 것이라",
      "source_text_hash": "6018a6a014a1b4e89dfd175408174ecbd00055ce1c5ce6f8e0fd9708ccc21b61",
      "translation_text_hash": "4a5c16ce21bdb23ec45838a34e6cdb5c9f40be0762bdf74e80796fdfc8a7e6d1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "부녀여, 내가 이제 네게 구하노니 서로 사랑하자 이는 새 계명 같이 네게 쓰는 것이 아니요 오직 처음부터 우리가 가진 것이라"
      ],
      "raw_text_hashes": [
        "4a5c16ce21bdb23ec45838a34e6cdb5c9f40be0762bdf74e80796fdfc8a7e6d1"
      ]
