    {
      "canonical_locator": "bible:web:2JN:1:6",
      "sequence": 30648,
      "chapter_label": "2JN 1",
      "verse_label": "6",
      "locator": {
        "book": "2JN",
        "chapter": 1,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "2JN",
          "chapter": 1,
          "verse": 6
        }
      ],
      "en": "This is love, that we should walk according to his commandments. This is the commandment, even as you heard from the beginning, that you should walk in it.",
      "ko": "또 사랑은 이것이니 우리가 그 계명을 좇아 행하는 것이요 계명은 이것이니 너희가 처음부터 들은 바와 같이 그 가운데서 행하라 하심이라",
      "source_text_hash": "55755f1f290d55fb796c291164064f24d6efc53bc489188a8d65b993bbfa7040",
      "translation_text_hash": "e565c765cb9a3d8424904e45e613f88ce9d3b57581d646cb82126c7e0ef482f2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 사랑은 이것이니 우리가 그 계명을 좇아 행하는 것이요 계명은 이것이니 너희가 처음부터 들은 바와 같이 그 가운데서 행하라 하심이라"
      ],
      "raw_text_hashes": [
