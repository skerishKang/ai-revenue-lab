    {
      "canonical_locator": "bible:web:2SA:2:6",
      "sequence": 8056,
      "chapter_label": "2SA 2",
      "verse_label": "6",
      "locator": {
        "book": "2SA",
        "chapter": 2,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 6
        }
      ],
      "en": "Now may the LORD show loving kindness and truth to you. I also will reward you for this kindness, because you have done this thing.",
      "ko": "너희가 이 일을 하였으니 이제 여호와께서 은혜와 진리로 너희에게 베푸시기를 원하고 나도 이 선한 일을 너희에게 갚으리니",
      "source_text_hash": "dfe0d62abf014b948bfbe065c44a1c2f5a5687e337e80f5cf692f04b338706c2",
      "translation_text_hash": "5796bfef8c634c83485aa34749d7d199924535ea107e9e59a406ad83ae11e11d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 이 일을 하였으니 이제 여호와께서 은혜와 진리로 너희에게 베푸시기를 원하고 나도 이 선한 일을 너희에게 갚으리니"
      ],
      "raw_text_hashes": [
        "5796bfef8c634c83485aa34749d7d199924535ea107e9e59a406ad83ae11e11d"
      ]
