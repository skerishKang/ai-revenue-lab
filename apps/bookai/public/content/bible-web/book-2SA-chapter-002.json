      ]
    },
    {
      "canonical_locator": "bible:web:2SA:2:24",
      "sequence": 8074,
      "chapter_label": "2SA 2",
      "verse_label": "24",
      "locator": {
        "book": "2SA",
        "chapter": 2,
        "verse": 24
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 24
        }
      ],
      "en": "But Joab and Abishai pursued Abner. The sun went down when they had come to the hill of Ammah, that lies before Giah by the way of the wilderness of Gibeon.",
      "ko": "요압과 아비새가 아브넬의 뒤를 쫓아 기브온 거친 땅의 길 가 기아 맞은편 암마산에 이를 때에 해가 졌고",
      "source_text_hash": "13174bff7d9ac6d6d5c826163fcabfbbdde271d3a26e41e67d059f4d7a81d606",
      "translation_text_hash": "ba649d7f3a11acaf3617f2af83c8af70741aaa28620ecf831e0cadc7ef798d41",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요압과 아비새가 아브넬의 뒤를 쫓아 기브온 거친 땅의 길 가 기아 맞은편 암마산에 이를 때에 해가 졌고"
      ],
      "raw_text_hashes": [
        "ba649d7f3a11acaf3617f2af83c8af70741aaa28620ecf831e0cadc7ef798d41"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:2:25",
      "sequence": 8075,
      "chapter_label": "2SA 2",
      "verse_label": "25",
      "locator": {
        "book": "2SA",
        "chapter": 2,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 25
        }
      ],
      "en": "The children of Benjamin gathered themselves together after Abner and became one band, and stood on the top of a hill.",
      "ko": "베냐민 족속은 함께 모여 아브넬을 따라 한 떼를 이루고 작은 산꼭대기에 섰더라",
      "source_text_hash": "c1c99459d154a3b48793127820f14cd71a8ce9c459e9dfda581cac11993572e9",
      "translation_text_hash": "ed61cd2cddfd7590efd685dd1460967886ee4b70fb841a43c65ce90e55a3a3d6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "베냐민 족속은 함께 모여 아브넬을 따라 한 떼를 이루고 작은 산꼭대기에 섰더라"
      ],
      "raw_text_hashes": [
        "ed61cd2cddfd7590efd685dd1460967886ee4b70fb841a43c65ce90e55a3a3d6"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:2:26",
      "sequence": 8076,
      "chapter_label": "2SA 2",
      "verse_label": "26",
      "locator": {
        "book": "2SA",
        "chapter": 2,
        "verse": 26
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 26
        }
      ],
      "en": "Then Abner called to Joab, and said, “Shall the sword devour forever? Don’t you know that it will be bitterness in the latter end? How long will it be then, before you ask the people to return from following their brothers?”",
      "ko": "아브넬이 요압에게 외쳐 가로되 칼이 영영히 사람을 상하겠느냐 마침내 참혹한 일이 생길 줄을 알지 못하느냐 네가 언제나 무리에게 그 형제 쫓기를 그치라 명하겠느냐",
      "source_text_hash": "4e2b639e049cdd685bb08fe6276b7de4a2748f92537f45ac01ecb8bb9486564c",
