        "verse": 10
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 10
        }
      ],
      "en": "Ishbosheth, Saul’s son, was forty years old when he began to reign over Israel, and he reigned two years. But the house of Judah followed David.",
      "ko": "사울의 아들 이스보셋이 비로소 이스라엘 왕이 될 때에 나이 사십세며 두해 동안 위에 있으니라 유다 족속은 다윗을 따르니",
      "source_text_hash": "3bde555149e34054b7ddb33d20e014e34bbf1f4c3184d03666628d43606339ab",
      "translation_text_hash": "0f2d849981fb76e993eab1735323315f877aa10a3c0026005b29a93e4151f646",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울의 아들 이스보셋이 비로소 이스라엘 왕이 될 때에 나이 사십세며 두해 동안 위에 있으니라 유다 족속은 다윗을 따르니"
      ],
      "raw_text_hashes": [
        "0f2d849981fb76e993eab1735323315f877aa10a3c0026005b29a93e4151f646"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:2:11",
      "sequence": 8061,
      "chapter_label": "2SA 2",
      "verse_label": "11",
      "locator": {
        "book": "2SA",
        "chapter": 2,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 11
        }
      ],
      "en": "The time that David was king in Hebron over the house of Judah was seven years and six months.",
      "ko": "다윗이 헤브론에서 유다 족속의 왕이 된 날 수는 일곱해 여섯달이더라",
      "source_text_hash": "b117b91c7d1f46440765dff8f3bed1dbde8e152634f360162bee8a8f6f22e84b",
      "translation_text_hash": "c9aa9bae70db2c2961fa189c2b8528e0dac166399fe2a6a4bce7d9a71a1d80d7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 헤브론에서 유다 족속의 왕이 된 날 수는 일곱해 여섯달이더라"
      ],
      "raw_text_hashes": [
        "c9aa9bae70db2c2961fa189c2b8528e0dac166399fe2a6a4bce7d9a71a1d80d7"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:2:12",
      "sequence": 8062,
      "chapter_label": "2SA 2",
