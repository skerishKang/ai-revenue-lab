        "verse": 20
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 20
        }
      ],
      "en": "Then Abner looked behind him and said, “Is that you, Asahel?” He answered, “It is.”",
      "ko": "아브넬이 뒤를 돌아 보며 가로되 아사헬아 너냐 대답하되 내로라",
      "source_text_hash": "0eaeecc19e3b3d6c41526ff7869184e781a1eccb2296d462073c8b66eff6772a",
      "translation_text_hash": "e4c1926d8f65ed58e6c0dc2c3b0041b1753ba46a5ac456e686c4f5a034d43870",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브넬이 뒤를 돌아 보며 가로되 아사헬아 너냐 대답하되 내로라"
      ],
      "raw_text_hashes": [
        "e4c1926d8f65ed58e6c0dc2c3b0041b1753ba46a5ac456e686c4f5a034d43870"
      ]
