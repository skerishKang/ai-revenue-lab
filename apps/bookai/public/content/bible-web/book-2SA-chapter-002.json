        "verse": 8
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 2,
          "verse": 8
        }
      ],
      "en": "Now Abner the son of Ner, captain of Saul’s army, had taken Ishbosheth the son of Saul and brought him over to Mahanaim.",
      "ko": "사울의 군장 넬의 아들 아브넬이 이미 사울의 아들 이스보셋을 데리고 마하나임으로 건너가서",
      "source_text_hash": "2d24a450204225a5d98caeb1128f958b39ee2a78012fa230c4d52d977931882e",
      "translation_text_hash": "c7e1f826867e0d293d82063daa1cd09fcb1959563e425d75c3294ff71bb62c58",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울의 군장 넬의 아들 아브넬이 이미 사울의 아들 이스보셋을 데리고 마하나임으로 건너가서"
      ],
      "raw_text_hashes": [
        "c7e1f826867e0d293d82063daa1cd09fcb1959563e425d75c3294ff71bb62c58"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:2:9",
      "sequence": 8059,
