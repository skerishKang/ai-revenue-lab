      ],
      "en": "For he will never be shaken. The righteous will be remembered forever.",
      "ko": "저가 영영히 요동치 아니함이여 의인은 영원히 기념하게 되리로다",
      "source_text_hash": "9546e503f2bb105bca395fc866be86e998ea2997ff6b6da6a1acead6ee04a35f",
      "translation_text_hash": "5b8605113592b9cf49142130166dbee520801d3236072e2687d5c1ceecf61a05",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 영영히 요동치 아니함이여 의인은 영원히 기념하게 되리로다"
      ],
      "raw_text_hashes": [
        "5b8605113592b9cf49142130166dbee520801d3236072e2687d5c1ceecf61a05"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:112:7",
      "sequence": 15811,
      "chapter_label": "PSA 112",
      "verse_label": "7",
      "locator": {
