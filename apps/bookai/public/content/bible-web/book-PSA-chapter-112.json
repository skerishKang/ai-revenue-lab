      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 112,
          "verse": 5
        }
      ],
      "en": "It is well with the man who deals graciously and lends. He will maintain his cause in judgment.",
      "ko": "은혜를 베풀며 꾸이는 자는 잘 되나니 그 일을 공의로 하리로다",
      "source_text_hash": "d41d77a2f31494c6ea5a9e81f334fe19ad2109a176c5056e6b1bbdd8d2ce6fc6",
      "translation_text_hash": "475ca5eddb1ca028ad8d275252bf390ef5c50ba11962b9fd7c3df90f8e08f47f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
