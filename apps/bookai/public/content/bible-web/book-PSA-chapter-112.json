      "translation_text_hash": "aa74f8fabb7e893e28b82db6b884cc13d0420167e971a4f354865985442fda50",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
