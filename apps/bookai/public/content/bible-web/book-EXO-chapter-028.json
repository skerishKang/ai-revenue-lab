        "chapter": 28,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 13
        }
      ],
      "en": "You shall make settings of gold,",
      "ko": "너는 금으로 테를 만들고",
      "source_text_hash": "36bdb170206a5665fef388eb55f61fa43bd6f85a75ba3d9c7f46161c87f82964",
      "translation_text_hash": "ea090b173a3bfd60ae41cbb831bfec3a9d8300f024f365e11d72700f18b8d541",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 금으로 테를 만들고"
      ],
      "raw_text_hashes": [
        "ea090b173a3bfd60ae41cbb831bfec3a9d8300f024f365e11d72700f18b8d541"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:14",
      "sequence": 2308,
      "chapter_label": "EXO 28",
      "verse_label": "14",
      "locator": {
        "book": "EXO",
        "chapter": 28,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 14
        }
      ],
      "en": "and two chains of pure gold; you shall make them like cords of braided work. You shall put the braided chains on the settings.",
      "ko": "정금으로 노끈처럼 두 사슬을 땋고 그 땋은 사슬을 그 테에 달찌니라",
      "source_text_hash": "c8920ef9bc81b2fc91691db166a33baafbffd3f797b4bf618b14ed9fec44ec2b",
