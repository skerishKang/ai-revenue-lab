        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 8
        }
      ],
      "en": "The skillfully woven band, which is on it, shall be like its work and of the same piece; of gold, blue, purple, scarlet, and fine twined linen.",
      "ko": "에봇 위에 매는 띠는 에봇 짜는 법으로 금실과 청색 자색 홍색실과 가늘게 꼰 베실로 에봇에 공교히 붙여 짤찌며",
      "source_text_hash": "4a8333656f117082a52e7876b9f739123a9c920a1bf78fa3db40a801e2268aa7",
      "translation_text_hash": "e65cda2aa87ac2077a669467e5c5913a51af4b46a5b6118feaa4c2c4b6be28ea",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에봇 위에 매는 띠는 에봇 짜는 법으로 금실과 청색 자색 홍색실과 가늘게 꼰 베실로 에봇에 공교히 붙여 짤찌며"
      ],
      "raw_text_hashes": [
        "e65cda2aa87ac2077a669467e5c5913a51af4b46a5b6118feaa4c2c4b6be28ea"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:9",
      "sequence": 2303,
      "chapter_label": "EXO 28",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
        "chapter": 28,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 9
        }
      ],
      "en": "You shall take two onyx stones, and engrave on them the names of the children of Israel.",
      "ko": "호마노 두개를 취하여 그 위에 이스라엘 아들들의 이름을 새기되",
      "source_text_hash": "147bfbcecbc899b1834257d6824f3aa0fe19194e20c3237e877bff80368b9e45",
      "translation_text_hash": "ab48ffb1e107d2d4e016a03279cb33102c2d9e69bb3f7eedd82438751467439b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "호마노 두개를 취하여 그 위에 이스라엘 아들들의 이름을 새기되"
      ],
      "raw_text_hashes": [
        "ab48ffb1e107d2d4e016a03279cb33102c2d9e69bb3f7eedd82438751467439b"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:10",
      "sequence": 2304,
      "chapter_label": "EXO 28",
      "verse_label": "10",
      "locator": {
        "book": "EXO",
        "chapter": 28,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 10
        }
      ],
      "en": "Six of their names on the one stone, and the names of the six that remain on the other stone, in the order of their birth.",
      "ko": "그들의 연치대로 여섯 이름을 한 보석에, 나머지 여섯 이름은 다른 보석에",
      "source_text_hash": "ba1678e5b5426b1779b5feefeb10e4c057361f737185b24ac3b864089fa488ed",
      "translation_text_hash": "792a5ffbb22ff9d7485c171f25d9996ab9cebd1490848eb89051e3f8084d1ba3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들의 연치대로 여섯 이름을 한 보석에, 나머지 여섯 이름은 다른 보석에"
      ],
      "raw_text_hashes": [
        "792a5ffbb22ff9d7485c171f25d9996ab9cebd1490848eb89051e3f8084d1ba3"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:11",
      "sequence": 2305,
      "chapter_label": "EXO 28",
      "verse_label": "11",
      "locator": {
        "book": "EXO",
        "chapter": 28,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 11
        }
      ],
      "en": "With the work of an engraver in stone, like the engravings of a signet, you shall engrave the two stones, according to the names of the children of Israel. You shall make them to be enclosed in settings of gold.",
      "ko": "보석을 새기는 자가 인에 새김 같이 너는 이스라엘 아들들의 이름을 그 두 보석에 새겨 금테에 물리고",
      "source_text_hash": "752bf620a21bdc3d5dc037059d20a915ff62d5d5a69f8e59466c69d0186aea30",
      "translation_text_hash": "45b0af701a07b8c7cb752038f31dd72d93a9532388764a5cd9360e81625f8772",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보석을 새기는 자가 인에 새김 같이 너는 이스라엘 아들들의 이름을 그 두 보석에 새겨 금테에 물리고"
      ],
      "raw_text_hashes": [
        "45b0af701a07b8c7cb752038f31dd72d93a9532388764a5cd9360e81625f8772"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:12",
      "sequence": 2306,
      "chapter_label": "EXO 28",
      "verse_label": "12",
      "locator": {
        "book": "EXO",
        "chapter": 28,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 12
        }
      ],
      "en": "You shall put the two stones on the shoulder straps of the ephod, to be stones of memorial for the children of Israel. Aaron shall bear their names before the LORD on his two shoulders for a memorial.",
      "ko": "그 두 보석을 에봇 두 견대에 붙여 이스라엘 아들들의 기념 보석을 삼되 아론이 여호와 앞에서 그들의 이름을 그 두 어깨에 메어서 기념이 되게 할찌며",
      "source_text_hash": "2877d2552abb81c09d4440212a26e34ca20b679c22ad6d3ffbc5e03018d8ac08",
      "translation_text_hash": "49b1ea4ceb9f4b6ca93086b13152370a670cac58ee57fc710321dd73c78486e2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 두 보석을 에봇 두 견대에 붙여 이스라엘 아들들의 기념 보석을 삼되 아론이 여호와 앞에서 그들의 이름을 그 두 어깨에 메어서 기념이 되게 할찌며"
      ],
      "raw_text_hashes": [
        "49b1ea4ceb9f4b6ca93086b13152370a670cac58ee57fc710321dd73c78486e2"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:13",
      "sequence": 2307,
      "chapter_label": "EXO 28",
      "verse_label": "13",
      "locator": {
