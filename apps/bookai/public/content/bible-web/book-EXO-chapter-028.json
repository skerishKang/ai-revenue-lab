      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 7
        }
      ],
      "en": "It shall have two shoulder straps joined to the two ends of it, that it may be joined together.",
      "ko": "그것에 견대 둘을 달아 그 두 끝을 연하게 하고",
      "source_text_hash": "317dfcd869f773dc718744bfcf361ec91af60aef717e2cbb4e7667b59f90a7ee",
      "translation_text_hash": "c6f9498f144ba03d489624cb0d37fdef11252378e5f537ae7e99f6ed3396bf9c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그것에 견대 둘을 달아 그 두 끝을 연하게 하고"
      ],
      "raw_text_hashes": [
        "c6f9498f144ba03d489624cb0d37fdef11252378e5f537ae7e99f6ed3396bf9c"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:8",
      "sequence": 2302,
      "chapter_label": "EXO 28",
      "verse_label": "8",
      "locator": {
