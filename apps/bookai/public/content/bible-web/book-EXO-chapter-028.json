      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 28,
          "verse": 5
        }
      ],
      "en": "They shall use the gold, and the blue, and the purple, and the scarlet, and the fine linen.",
      "ko": "그들의 쓸 것은 금실과 청색 자색 홍색실과 가늘게 꼰 베실이니라",
      "source_text_hash": "d8839dd2fb05527385714d208b7362def21a6386574dd0e2849eb33599aae60a",
      "translation_text_hash": "eb52000cb9fc83061818ed85b3cdff30510ddb591112234ea8b97e43c0027253",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들의 쓸 것은 금실과 청색 자색 홍색실과 가늘게 꼰 베실이니라"
      ],
      "raw_text_hashes": [
        "eb52000cb9fc83061818ed85b3cdff30510ddb591112234ea8b97e43c0027253"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:28:6",
      "sequence": 2300,
      "chapter_label": "EXO 28",
