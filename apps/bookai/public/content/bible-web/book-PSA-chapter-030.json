        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 30,
          "verse": 11
        }
      ],
      "en": "You have turned my mourning into dancing for me. You have removed my sackcloth, and clothed me with gladness,",
      "ko": "주께서 나의 슬픔을 변하여 춤이 되게 하시며 나의 베옷을 벗기고 기쁨으로 띠 띠우셨나이다",
      "source_text_hash": "fc8e79a1553946367b73470d8e48bb61c7e480c486d9b40a6770522821b1d50e",
      "translation_text_hash": "1572f715aeca025280fc6c00571292d694e089570b74e0b204d2c6117686494e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 나의 슬픔을 변하여 춤이 되게 하시며 나의 베옷을 벗기고 기쁨으로 띠 띠우셨나이다"
      ],
      "raw_text_hashes": [
        "1572f715aeca025280fc6c00571292d694e089570b74e0b204d2c6117686494e"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:30:12",
      "sequence": 14332,
