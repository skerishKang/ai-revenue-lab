        "verse": 3
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 30,
          "verse": 3
        }
      ],
      "en": "LORD, you have brought up my soul from Sheol. You have kept me alive, that I should not go down to the pit.",
      "ko": "여호와여 주께서 내 영혼을 음부에서 끌어내어 나를 살리사 무덤으로 내려가지 않게 하셨나이다",
      "source_text_hash": "14b4d8d37e73a54d74eb570432cab01db3740c9ce856b8e304a81bdabea3f265",
      "translation_text_hash": "7867905769a49974f44865e7b5b143acdb1ec8addd136e3478194f424bd004ff",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 주께서 내 영혼을 음부에서 끌어내어 나를 살리사 무덤으로 내려가지 않게 하셨나이다"
      ],
      "raw_text_hashes": [
        "7867905769a49974f44865e7b5b143acdb1ec8addd136e3478194f424bd004ff"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:30:4",
      "sequence": 14324,
