      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 30,
          "verse": 7
        }
      ],
      "en": "You, LORD, when you favored me, made my mountain stand strong; but when you hid your face, I was troubled.",
      "ko": "여호와께서 주의 은혜로 내 산을 굳게 세우셨더니 주의 얼굴을 가리우시매 내가 근심하였나이다",
      "source_text_hash": "58316b13d1989e730d7abdf29e50304953b3729b183280f0b1c79019922ffeab",
      "translation_text_hash": "ed1e6ffb9e7519b8bdf61a8b10a331b61fc922f6987a867102231aafb8aae63c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 주의 은혜로 내 산을 굳게 세우셨더니 주의 얼굴을 가리우시매 내가 근심하였나이다"
      ],
      "raw_text_hashes": [
        "ed1e6ffb9e7519b8bdf61a8b10a331b61fc922f6987a867102231aafb8aae63c"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:30:8",
      "sequence": 14328,
      "chapter_label": "PSA 30",
      "verse_label": "8",
      "locator": {
