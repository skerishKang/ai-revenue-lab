      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 30,
          "verse": 4
        }
      ],
      "en": "Sing praise to the LORD, you saints of his. Give thanks to his holy name.",
      "ko": "주의 성도들아 여호와를 찬송하며 그 거룩한 이름에 감사할찌어다",
      "source_text_hash": "923831bb2b6fd11b40690ca36ab575165b4855211559d7dee5cb4290c8d78bef",
      "translation_text_hash": "30c2ff2b1d347410f9ea5179ce31826094d74ff486f13cfd638f429948bc1b95",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 성도들아 여호와를 찬송하며 그 거룩한 이름에 감사할찌어다"
      ],
      "raw_text_hashes": [
        "30c2ff2b1d347410f9ea5179ce31826094d74ff486f13cfd638f429948bc1b95"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:30:5",
      "sequence": 14325,
      "chapter_label": "PSA 30",
      "verse_label": "5",
      "locator": {
