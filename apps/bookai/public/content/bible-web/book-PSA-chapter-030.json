        {
          "book": "PSA",
          "chapter": 30,
          "verse": 2
        }
      ],
      "en": "LORD my God, I cried to you, and you have healed me.",
      "ko": "여호와 내 하나님이여 내가 주께 부르짖으매 나를 고치셨나이다",
      "source_text_hash": "2049b600ce7726eb2a46e8d0172c0d02953a8a1f5e3c44ceac215f67314ea6ff",
      "translation_text_hash": "a28e84839ec62e44f1a7c98f5aebc708f93c25729f5f50cd0e60c7d3599fb1b2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와 내 하나님이여 내가 주께 부르짖으매 나를 고치셨나이다"
      ],
      "raw_text_hashes": [
        "a28e84839ec62e44f1a7c98f5aebc708f93c25729f5f50cd0e60c7d3599fb1b2"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:30:3",
      "sequence": 14323,
      "chapter_label": "PSA 30",
      "verse_label": "3",
      "locator": {
