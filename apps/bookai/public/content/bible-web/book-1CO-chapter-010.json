      "source_text_hash": "02adf9e736197d574312039f329382a5d527411bea4933473fdb211f9aeb660e",
      "translation_text_hash": "0a9810cfe9a73a7b1ef27e5e3ee073cf81607b86e5609170f0573c57de79ba95",
      "translation_policy": "krv-1961-source-mapped",
