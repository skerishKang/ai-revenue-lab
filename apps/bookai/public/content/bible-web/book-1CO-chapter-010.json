      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희에게 당한 이런 일이 거울이 되고 또한 말세를 만난 우리의 경계로 기록하였느니라"
      ],
      "raw_text_hashes": [
