      "source_text_hash": "95e85eafb2b4cd3f0652d353b9b6226000c74ac19bd6f9c6eb60465130dc145c",
      "translation_text_hash": "a67f1eeae30ead6e3f421f2ae831ac93fe87464154a646a23553452e87ab43de",
      "translation_policy": "krv-1961-source-mapped",
