      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 13,
          "verse": 2
        }
      ],
      "en": "“This is the land that still remains: all the regions of the Philistines, and all the Geshurites;",
      "ko": "이 남은 땅은 이러하니 블레셋 사람의 온 지방과 그술 사람의 전경",
      "source_text_hash": "479d2d675fa4c7689526501a09b816360455db431cda72e77a8e41ef9458b1e6",
      "translation_text_hash": "7034ea10876dd50621654d85edccc38890a51d0311d1a2e5b2b7d8e104106c07",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 남은 땅은 이러하니 블레셋 사람의 온 지방과 그술 사람의 전경"
      ],
      "raw_text_hashes": [
        "7034ea10876dd50621654d85edccc38890a51d0311d1a2e5b2b7d8e104106c07"
      ]
    },
    {
      "canonical_locator": "bible:web:JOS:13:3",
      "sequence": 6158,
      "chapter_label": "JOS 13",
