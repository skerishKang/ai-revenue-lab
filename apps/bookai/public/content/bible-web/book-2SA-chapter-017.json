    {
      "canonical_locator": "bible:web:2SA:17:22",
      "sequence": 8472,
      "chapter_label": "2SA 17",
      "verse_label": "22",
      "locator": {
        "book": "2SA",
        "chapter": 17,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 17,
          "verse": 22
        }
      ],
      "en": "Then David arose, and all the people who were with him, and they passed over the Jordan. By the morning light there lacked not one of them who had not gone over the Jordan.",
      "ko": "다윗이 일어나 모든 백성과 함께 요단을 건널쌔 새벽에 미쳐서 한 사람도 요단을 건너지 못한 자가 없었더라",
      "source_text_hash": "619818c094dbce1fc70757a9a92ae6b2c8706a53f96770951f472cd0e25be77a",
      "translation_text_hash": "fd398fbf9a408921d0eb35fd80eebabbb3a7de1c9091a514c75cb83e34ae4472",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 일어나 모든 백성과 함께 요단을 건널쌔 새벽에 미쳐서 한 사람도 요단을 건너지 못한 자가 없었더라"
      ],
      "raw_text_hashes": [
