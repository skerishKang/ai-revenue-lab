      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 2,
          "verse": 9
        }
      ],
      "en": "When I looked, behold, a hand was stretched out to me; and behold, a scroll of a book was in it.",
      "ko": "내가 보니 한 손이 나를 향하여 펴지고 그 손에 두루마리 책이 있더라",
      "source_text_hash": "b5f7f2794770ebdfc9de4e247b63ab8d0eaede1fa2997fa1a8806cc294ef5fd5",
      "translation_text_hash": "6d40bea21a40140aa373c00dae3313657cefbe58da50d4d686607539532bd2ef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 보니 한 손이 나를 향하여 펴지고 그 손에 두루마리 책이 있더라"
      ],
      "raw_text_hashes": [
        "6d40bea21a40140aa373c00dae3313657cefbe58da50d4d686607539532bd2ef"
      ]
    },
