        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 40,
          "verse": 7
        }
      ],
      "en": "Then I said, “Behold, I have come. It is written about me in the book in the scroll.",
      "ko": "그 때에 내가 말하기를 내가 왔나이다 나를 가리켜 기록한 것이 두루마리 책에 있나이다",
      "source_text_hash": "07d8fbeb2fbbd400a1f92eb91d96f705042a9b39b9ec19be6202aece99d0db1c",
      "translation_text_hash": "1c5faed7e42497009c678da06a13cbcfe88899a7ab5f618efcf2a6a8f4d2650b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 때에 내가 말하기를 내가 왔나이다 나를 가리켜 기록한 것이 두루마리 책에 있나이다"
      ],
      "raw_text_hashes": [
        "1c5faed7e42497009c678da06a13cbcfe88899a7ab5f618efcf2a6a8f4d2650b"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:40:8",
      "sequence": 14534,
      "chapter_label": "PSA 40",
      "verse_label": "8",
      "locator": {
        "book": "PSA",
