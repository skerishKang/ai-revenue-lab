        "verse": 8
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 26,
          "verse": 8
        }
      ],
      "en": "The Ammonites gave tribute to Uzziah. His name spread abroad even to the entrance of Egypt, for he grew exceedingly strong.",
      "ko": "암몬 사람이 웃시야에게 조공을 바치매 웃시야가 심히 강성하여 이름이 애굽 변방까지 퍼졌더라",
      "source_text_hash": "ae9c2f8095b066080d1bd16124b07ea5b34f59a0ba74ad558ff6082c19bce549",
      "translation_text_hash": "96bf1bd59ed16d033d955bad790725713c872cf963151f1f8965634ae440245c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "암몬 사람이 웃시야에게 조공을 바치매 웃시야가 심히 강성하여 이름이 애굽 변방까지 퍼졌더라"
      ],
      "raw_text_hashes": [
        "96bf1bd59ed16d033d955bad790725713c872cf963151f1f8965634ae440245c"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:26:9",
      "sequence": 11742,
