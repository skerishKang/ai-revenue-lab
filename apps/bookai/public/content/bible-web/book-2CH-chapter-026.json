      "verse_label": "12",
      "locator": {
        "book": "2CH",
        "chapter": 26,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 26,
          "verse": 12
        }
      ],
      "en": "The whole number of the heads of fathers’ households, even the mighty men of valor, was two thousand six hundred.",
      "ko": "족장의 총수가 이천 육백명이니 모두 큰 용사요",
      "source_text_hash": "23d28e5decc337274313269ffccd74effd0c2a91d14baf9487bd6ac6b19d25c2",
      "translation_text_hash": "3bc80f17f0007cc33a9bb13a56af88ecb3e82a2d6a02184f23bb7b7021f4f521",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "족장의 총수가 이천 육백명이니 모두 큰 용사요"
      ],
      "raw_text_hashes": [
        "3bc80f17f0007cc33a9bb13a56af88ecb3e82a2d6a02184f23bb7b7021f4f521"
      ]
    },
    {
