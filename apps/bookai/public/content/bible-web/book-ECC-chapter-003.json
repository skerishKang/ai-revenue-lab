      "translation_text_hash": "29186d67b5d72c454c4d776602015405c8e34fa2c8ca4384bb970995bb692648",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "날 때가 있고 죽을 때가 있으며 심을 때가 있고 심은 것을 뽑을 때가 있으며"
      ],
      "raw_text_hashes": [
        "29186d67b5d72c454c4d776602015405c8e34fa2c8ca4384bb970995bb692648"
      ]
    },
