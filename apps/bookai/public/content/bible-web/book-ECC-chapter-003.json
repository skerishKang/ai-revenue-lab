      "chapter_label": "ECC 3",
      "verse_label": "15",
      "locator": {
        "book": "ECC",
        "chapter": 3,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "ECC",
          "chapter": 3,
          "verse": 15
