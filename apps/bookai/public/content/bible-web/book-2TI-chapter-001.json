      ],
      "en": "longing to see you, remembering your tears, that I may be filled with joy;",
      "ko": "네 눈물을 생각하여 너 보기를 원함은 내 기쁨이 가득하게 하려 함이니",
      "source_text_hash": "c21822ce530926a548d58b2543e86984e5e039d7b9dd0baad87a994f353710a4",
      "translation_text_hash": "1228cd2780123910f6c27ff2d1340720907df45a6e28b80cd9b3e387c780a59b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 눈물을 생각하여 너 보기를 원함은 내 기쁨이 가득하게 하려 함이니"
      ],
      "raw_text_hashes": [
        "1228cd2780123910f6c27ff2d1340720907df45a6e28b80cd9b3e387c780a59b"
      ]
    },
    {
      "canonical_locator": "bible:web:2TI:1:5",
      "sequence": 29811,
      "chapter_label": "2TI 1",
      "verse_label": "5",
      "locator": {
