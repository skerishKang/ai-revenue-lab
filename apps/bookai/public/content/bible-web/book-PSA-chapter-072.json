        {
          "book": "PSA",
          "chapter": 72,
          "verse": 1
        }
      ],
      "en": "God, give the king your justice; your righteousness to the royal son.",
      "ko": "하나님이여 주의 판단력을 왕에게 주시고 주의 의를 왕의 아들에게 주소서",
      "source_text_hash": "7319a32367acd2c9c967a09887c25ee4064a74636b8a06acdffe3583d535e28c",
      "translation_text_hash": "f05291c1eb945889951969332c89e59309e9241653f2864efad251aef12c62b1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 주의 판단력을 왕에게 주시고 주의 의를 왕의 아들에게 주소서"
      ],
      "raw_text_hashes": [
        "f05291c1eb945889951969332c89e59309e9241653f2864efad251aef12c62b1"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:2",
      "sequence": 15003,
      "chapter_label": "PSA 72",
