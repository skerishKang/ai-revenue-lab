      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 2
        }
      ],
      "en": "He will judge your people with righteousness, and your poor with justice.",
      "ko": "저가 주의 백성을 의로 판단하며 주의 가난한 자를 공의로 판단하리니",
      "source_text_hash": "fc6a806dd56a69b2612a714e4d1724e29eb73d5dd26235c6e4f5747594cb4cc2",
      "translation_text_hash": "c8d2322abab665c9387b36a727671e9aa398eb0e7378774652260c9c279f3bef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 주의 백성을 의로 판단하며 주의 가난한 자를 공의로 판단하리니"
      ],
      "raw_text_hashes": [
        "c8d2322abab665c9387b36a727671e9aa398eb0e7378774652260c9c279f3bef"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:3",
      "sequence": 15004,
      "chapter_label": "PSA 72",
      "verse_label": "3",
      "locator": {
