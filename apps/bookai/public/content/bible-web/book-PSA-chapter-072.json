        "verse": 6
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 6
        }
      ],
      "en": "He will come down like rain on the mown grass, as showers that water the earth.",
      "ko": "저는 벤 풀에 내리는 비 같이, 땅을 적시는 소낙비 같이 임하리니",
      "source_text_hash": "309e9a18a220de718970204e10568ea29983231cf6cb1aabae46009c4a776467",
      "translation_text_hash": "a1dd49a8908df83a31d17066aa7985324def50af6c88924f8875296e6ba2f58d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저는 벤 풀에 내리는 비 같이, 땅을 적시는 소낙비 같이 임하리니"
      ],
      "raw_text_hashes": [
        "a1dd49a8908df83a31d17066aa7985324def50af6c88924f8875296e6ba2f58d"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:7",
      "sequence": 15008,
      "chapter_label": "PSA 72",
      "verse_label": "7",
      "locator": {
        "book": "PSA",
        "chapter": 72,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 7
        }
      ],
      "en": "In his days, the righteous shall flourish, and abundance of peace, until the moon is no more.",
      "ko": "저의 날에 의인이 흥왕하여 평강의 풍성함이 달이 다할 때까지 이르리로다",
      "source_text_hash": "41a582664067d11ebd03a9a5500788ba545d61d068554f750a8adc91599c56d2",
      "translation_text_hash": "826215124b706bd27a2b1c676258b6b749533a2757c2777cb6e61627104e819d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저의 날에 의인이 흥왕하여 평강의 풍성함이 달이 다할 때까지 이르리로다"
      ],
      "raw_text_hashes": [
        "826215124b706bd27a2b1c676258b6b749533a2757c2777cb6e61627104e819d"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:8",
      "sequence": 15009,
      "chapter_label": "PSA 72",
      "verse_label": "8",
