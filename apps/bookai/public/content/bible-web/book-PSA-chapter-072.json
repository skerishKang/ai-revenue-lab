        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 11
        }
      ],
      "en": "Yes, all kings shall fall down before him. All nations shall serve him.",
      "ko": "만왕이 그 앞에 부복하며 열방이 다 그를 섬기리로다",
      "source_text_hash": "b2b4f638e81a11ace38b294b7ebb1260414d31d5808141fbeece378e44a94f9d",
      "translation_text_hash": "06a6e3540e28f0a3b25ad24e12483063e5257331fa9f3680546828972e825cf5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만왕이 그 앞에 부복하며 열방이 다 그를 섬기리로다"
      ],
      "raw_text_hashes": [
        "06a6e3540e28f0a3b25ad24e12483063e5257331fa9f3680546828972e825cf5"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:12",
      "sequence": 15013,
      "chapter_label": "PSA 72",
      "verse_label": "12",
      "locator": {
        "book": "PSA",
        "chapter": 72,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 12
        }
      ],
      "en": "For he will deliver the needy when he cries; the poor, who has no helper.",
      "ko": "저는 궁핍한 자의 부르짖을 때에 건지며 도움이 없는 가난한 자도 건지며",
      "source_text_hash": "64b2acbe453ac60fe84258a9ac8507d35d42594de28e14152146308fb678dfe2",
      "translation_text_hash": "35e8e256b230eba5333349bd97d9f1c5b778deb6bccd7781c819ce3cc1048116",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저는 궁핍한 자의 부르짖을 때에 건지며 도움이 없는 가난한 자도 건지며"
      ],
      "raw_text_hashes": [
        "35e8e256b230eba5333349bd97d9f1c5b778deb6bccd7781c819ce3cc1048116"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:13",
      "sequence": 15014,
      "chapter_label": "PSA 72",
      "verse_label": "13",
      "locator": {
        "book": "PSA",
        "chapter": 72,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 13
        }
      ],
      "en": "He will have pity on the poor and needy. He will save the souls of the needy.",
      "ko": "저는 가난한 자와 궁핍한 자를 긍휼히 여기며 궁핍한 자의 생명을 구원하며",
      "source_text_hash": "48e66ee87d3b38689d117cb446a603fca9c35a3c572ec6828850edfe97c8cdf1",
      "translation_text_hash": "21f4cd89b1af1a695a9d006a602591428b3c02d1a40ca60a6c5d3272dcb15011",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저는 가난한 자와 궁핍한 자를 긍휼히 여기며 궁핍한 자의 생명을 구원하며"
      ],
      "raw_text_hashes": [
        "21f4cd89b1af1a695a9d006a602591428b3c02d1a40ca60a6c5d3272dcb15011"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:14",
      "sequence": 15015,
      "chapter_label": "PSA 72",
      "verse_label": "14",
      "locator": {
        "book": "PSA",
        "chapter": 72,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 14
        }
      ],
      "en": "He will redeem their soul from oppression and violence. Their blood will be precious in his sight.",
      "ko": "저희 생명을 압박과 강포에서 구속하리니 저희 피가 그 목전에 귀하리로다",
      "source_text_hash": "4b51639de3dcf72f380ef04f885f7dc8db45785c11bc981fd28de2fdacdde9e9",
      "translation_text_hash": "c36c6b1bebdfa4161465b935d5c1fcea8b2da2d4c54e47e01029db8a4e4af277",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희 생명을 압박과 강포에서 구속하리니 저희 피가 그 목전에 귀하리로다"
      ],
      "raw_text_hashes": [
        "c36c6b1bebdfa4161465b935d5c1fcea8b2da2d4c54e47e01029db8a4e4af277"
      ]
    },
    {
