        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 5
        }
      ],
      "en": "They shall fear you while the sun endures; and as long as the moon, throughout all generations.",
      "ko": "저희가 해가 있을 동안에 주를 두려워하며 달이 있을 동안에 대대로 그리하리로다",
      "source_text_hash": "f73fb7f0c209cb070dae387d645c3c8bff508458bcbea0bab22d579f9b20122b",
      "translation_text_hash": "add4884af8cea5d52a8c79a6896ab4d97a2cab21b0636eb6980146ffa30d38b6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 해가 있을 동안에 주를 두려워하며 달이 있을 동안에 대대로 그리하리로다"
      ],
      "raw_text_hashes": [
        "add4884af8cea5d52a8c79a6896ab4d97a2cab21b0636eb6980146ffa30d38b6"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:6",
      "sequence": 15007,
      "chapter_label": "PSA 72",
      "verse_label": "6",
      "locator": {
        "book": "PSA",
