        "verse": 3
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 3
        }
      ],
      "en": "The mountains shall bring prosperity to the people. The hills bring the fruit of righteousness.",
      "ko": "의로 인하여 산들이 백성에게 평강을 주며 작은 산들도 그리하리로다",
      "source_text_hash": "2b4c91a27145120c540b5f476737743a3754e884b74d45409f95a1abf294518a",
      "translation_text_hash": "47ea5fe875561726247fab901b9cd312085278c201a7d6ae462f35ef96e68357",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "의로 인하여 산들이 백성에게 평강을 주며 작은 산들도 그리하리로다"
      ],
      "raw_text_hashes": [
        "47ea5fe875561726247fab901b9cd312085278c201a7d6ae462f35ef96e68357"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:4",
      "sequence": 15005,
      "chapter_label": "PSA 72",
      "verse_label": "4",
      "locator": {
