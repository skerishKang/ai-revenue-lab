        "verse": 8
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 72,
          "verse": 8
        }
      ],
      "en": "He shall have dominion also from sea to sea, from the River to the ends of the earth.",
      "ko": "저가 바다에서부터 바다까지와 강에서부터 땅 끝까지 다스리리니",
      "source_text_hash": "612a366162af73e89c1ba221070cf1a3887eeede132a05704904c02bc16ca4f2",
      "translation_text_hash": "34185ce1779de20d797ebe5824a7492d530ec2be8ea4a834a53f08a7f3dd2e67",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 바다에서부터 바다까지와 강에서부터 땅 끝까지 다스리리니"
      ],
      "raw_text_hashes": [
        "34185ce1779de20d797ebe5824a7492d530ec2be8ea4a834a53f08a7f3dd2e67"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:72:9",
      "sequence": 15010,
      "chapter_label": "PSA 72",
      "verse_label": "9",
      "locator": {
        "book": "PSA",
