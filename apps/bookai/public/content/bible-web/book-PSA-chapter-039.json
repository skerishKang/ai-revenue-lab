      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 나의 종말과 연한의 어떠함을 알게 하사 나로 나의 연약함을 알게 하소서"
      ],
      "raw_text_hashes": [
        "ab62f611acf4dd745e17e8e233b7adef4f151796536ffe8546b95353aaa41434"
      ]
    },
