      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 12,
          "verse": 17
        }
      ],
      "en": "You may not eat within your gates the tithe of your grain, or of your new wine, or of your oil, or the firstborn of your herd or of your flock, nor any of your vows which you vow, nor your free will offerings, nor the wave offering of your hand;",
      "ko": "너는 곡식과 포도주와 기름의 십일조와 네 우양의 처음 낳은 것과 너의 서원을 갚는 예물과 너의 낙헌 예물과 네 손의 거제물은 너의 각 성에서 먹지 말고",
      "source_text_hash": "6de33358c1cb791e963a95802a7252ca6a3444397fa2d743700f7a7daf313484",
      "translation_text_hash": "f1a2d17736e3507140bc01a972f1e6c9c560568eb7844ce33e2acd66ff3ada2e",
      "translation_policy": "krv-1961-source-mapped",
