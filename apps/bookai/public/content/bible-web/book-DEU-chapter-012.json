        "verse": 4
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 12,
          "verse": 4
        }
      ],
      "en": "You shall not do so to the LORD your God.",
      "ko": "너희 하나님 여호와에게는 너희가 그처럼 행하지 말고",
      "source_text_hash": "1cb26ff0a5add6f1a1ae52bdb5ffdba8d229436f45427d3e29d7e1d2622be4c2",
      "translation_text_hash": "5cd320cb40219c23405640660564e1950a2a4777d4e5413474dca9f2bc612730",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 하나님 여호와에게는 너희가 그처럼 행하지 말고"
      ],
      "raw_text_hashes": [
        "5cd320cb40219c23405640660564e1950a2a4777d4e5413474dca9f2bc612730"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:12:5",
      "sequence": 5246,
      "chapter_label": "DEU 12",
      "verse_label": "5",
      "locator": {
        "book": "DEU",
        "chapter": 12,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 12,
          "verse": 5
        }
      ],
      "en": "But to the place which the LORD your God shall choose out of all your tribes, to put his name there, you shall seek his habitation, and you shall come there.",
      "ko": "오직 너희 하나님 여호와께서 자기 이름을 두시려고 너희 모든 지파 중에서 택하신 곳인 그 거하실 곳으로 찾아 나아가서",
      "source_text_hash": "d233e83e04a34dff0a17a9e8437db32937dacdec9a281e1d97074b725786a549",
      "translation_text_hash": "0d253720b8d15d501376b9b8a044f8e7bad0653714388395f0cc709709e7be41",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 너희 하나님 여호와께서 자기 이름을 두시려고 너희 모든 지파 중에서 택하신 곳인 그 거하실 곳으로 찾아 나아가서"
      ],
      "raw_text_hashes": [
        "0d253720b8d15d501376b9b8a044f8e7bad0653714388395f0cc709709e7be41"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:12:6",
      "sequence": 5247,
      "chapter_label": "DEU 12",
      "verse_label": "6",
      "locator": {
        "book": "DEU",
        "chapter": 12,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 12,
          "verse": 6
        }
      ],
      "en": "You shall bring your burnt offerings, your sacrifices, your tithes, the wave offering of your hand, your vows, your free will offerings, and the firstborn of your herd and of your flock there.",
      "ko": "너희 번제와 너희 희생과 너희의 십일조와 너희 손의 거제와 너희 서원제와 낙헌 예물과 너희 우양의 처음 낳은 것들을 너희는 그리로 가져다가 드리고",
      "source_text_hash": "3793fb10d10769bf04c72be6f28295de64a0c1d029aabdcf893a1131ce8824d6",
      "translation_text_hash": "8332e504df41a020a82ec0fc515c8b97ce8c287c9bda5004bf5d2bcd19250096",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희 번제와 너희 희생과 너희의 십일조와 너희 손의 거제와 너희 서원제와 낙헌 예물과 너희 우양의 처음 낳은 것들을 너희는 그리로 가져다가 드리고"
      ],
      "raw_text_hashes": [
        "8332e504df41a020a82ec0fc515c8b97ce8c287c9bda5004bf5d2bcd19250096"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:12:7",
      "sequence": 5248,
      "chapter_label": "DEU 12",
      "verse_label": "7",
      "locator": {
        "book": "DEU",
        "chapter": 12,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 12,
          "verse": 7
        }
      ],
      "en": "There you shall eat before the LORD your God, and you shall rejoice in all that you put your hand to, you and your households, in which the LORD your God has blessed you.",
      "ko": "거기 곧 너희 하나님 여호와 앞에서 먹고 너희 하나님 여호와께서 너희 손으로 수고한 일에 복 주심을 인하여 너희와 너희 가족이 즐거워할찌니라",
      "source_text_hash": "6cece165d980da76ebb592ee535f0a87a100d8e4b4810386ba1fdc333955ca24",
      "translation_text_hash": "30ff5d104356c7d54f8afb766181097f58a15e758bc5107be7901503ac305b29",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "거기 곧 너희 하나님 여호와 앞에서 먹고 너희 하나님 여호와께서 너희 손으로 수고한 일에 복 주심을 인하여 너희와 너희 가족이 즐거워할찌니라"
      ],
      "raw_text_hashes": [
        "30ff5d104356c7d54f8afb766181097f58a15e758bc5107be7901503ac305b29"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:12:8",
      "sequence": 5249,
      "chapter_label": "DEU 12",
      "verse_label": "8",
      "locator": {
        "book": "DEU",
        "chapter": 12,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 12,
          "verse": 8
        }
      ],
      "en": "You shall not do all the things that we do here today, every man whatever is right in his own eyes;",
      "ko": "우리가 오늘날 여기서는 각기 소견대로 하였거니와 너희가 거기서는 하지 말찌니라",
      "source_text_hash": "3204a50feb4aba650c6c2cb94d34eb2545f966cf1321b64adb84b362765ee24e",
      "translation_text_hash": "6835c1cec52b877af9a0f0f47bee122962b532c5add7e564ede651fb17e3e4fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 오늘날 여기서는 각기 소견대로 하였거니와 너희가 거기서는 하지 말찌니라"
      ],
      "raw_text_hashes": [
        "6835c1cec52b877af9a0f0f47bee122962b532c5add7e564ede651fb17e3e4fe"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:12:9",
      "sequence": 5250,
      "chapter_label": "DEU 12",
      "verse_label": "9",
      "locator": {
