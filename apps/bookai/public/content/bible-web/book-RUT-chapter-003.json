        "chapter": 3,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "RUT",
          "chapter": 3,
          "verse": 11
        }
      ],
      "en": "Now, my daughter, don’t be afraid. I will do to you all that you say; for all the city of my people knows that you are a worthy woman.",
      "ko": "내 딸아 두려워 말라 내가 네 말대로 네게 다 행하리라 네가 현숙한 여자인줄 나의 성읍 백성이 다 아느니라",
      "source_text_hash": "fc2db5e5f8b56667a2835b04bd7835d03816c5ca104cedc41043179c045a1888",
      "translation_text_hash": "6315ebd8cd5d91209814c30fd08cc4433df05c7c1dc28ddc21da5c7e1401db80",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 딸아 두려워 말라 내가 네 말대로 네게 다 행하리라 네가 현숙한 여자인줄 나의 성읍 백성이 다 아느니라"
      ],
      "raw_text_hashes": [
        "6315ebd8cd5d91209814c30fd08cc4433df05c7c1dc28ddc21da5c7e1401db80"
