      "raw_locator": [
        {
          "book": "JHN",
          "chapter": 21,
          "verse": 14
        }
      ],
      "en": "This is now the third time that Jesus was revealed to his disciples after he had risen from the dead.",
      "ko": "이것은 예수께서 죽은자 가운데서 살아나신 후에 세 번째로 제자들에게 나타나신 것이라",
      "source_text_hash": "5d819ffaf0ab3778cf3004b433e66eea44389c99a84c2c4078d4810ee37ec5f2",
      "translation_text_hash": "16d1cc5a780b66cc5686647012dac4e7c032c6cc7894e7b871c7588d2081029b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이것은 예수께서 죽은자 가운데서 살아나신 후에 세 번째로 제자들에게 나타나신 것이라"
      ],
      "raw_text_hashes": [
        "16d1cc5a780b66cc5686647012dac4e7c032c6cc7894e7b871c7588d2081029b"
      ]
