      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "예수께서 가라사대 내가 올 때까지 그를 머물게 하고자 할찌라도 네게 무슨 상관이냐 너는 나를 따르라 하시더라"
      ],
