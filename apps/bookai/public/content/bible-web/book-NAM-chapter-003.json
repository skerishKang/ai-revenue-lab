      "raw_locator": [
        {
          "book": "NAM",
          "chapter": 3,
          "verse": 18
        }
      ],
      "en": "Your shepherds slumber, king of Assyria. Your nobles lie down. Your people are scattered on the mountains, and there is no one to gather them.",
      "ko": "앗수르 왕이여 네 목자가 자고 네 귀족은 누워 쉬며 네 백성은 산들에 흩어지나 그들을 모을 사람이 없도다",
      "source_text_hash": "8b572b4e363c74e1a9edf26f017f4e8ee540e3e8478bfe5ccdb524823aac64eb",
      "translation_text_hash": "c4465e8f073fc395d393bab5c30edce015bef12b75765c4bf415b01e2149e49a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "앗수르 왕이여 네 목자가 자고 네 귀족은 누워 쉬며 네 백성은 산들에 흩어지나 그들을 모을 사람이 없도다"
      ],
      "raw_text_hashes": [
