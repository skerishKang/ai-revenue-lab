      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "자주 책망을 받으면서도 목이 곧은 사람은 갑자기 패망을 당하고 피하지 못하리라"
      ],
      "raw_text_hashes": [
