      "raw_texts": [
        "이에 군대와 천부장과 유대인의 하속들이 예수를 잡아 결박하여"
      ],
      "raw_text_hashes": [
        "f5606fd825b53cc7956642880da07485b29aedc901fccb899344fa9183d82093"
