      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "먼저 안나스에게로 끌고 가니 안나스는 그 해의 대제사장인 가야바의 장인이라"
      ],
      "raw_text_hashes": [
