      "raw_locator": [
        {
          "book": "EPH",
          "chapter": 1,
          "verse": 7
        }
      ],
      "en": "In him we have our redemption through his blood, the forgiveness of our trespasses, according to the riches of his grace",
      "ko": "우리가 그리스도 안에서 그의 은혜의 풍성함을 따라 그의 피로 말미암아 구속 곧 죄 사함을 받았으니",
      "source_text_hash": "b811d4caa8ce7b81cb88573c5e3da8a47bf532f50a0e1b3f73cd4f64536683e0",
      "translation_text_hash": "8aadfc49785e775155d735344b6a9c128468cd5628523f35729a0a3c996403d1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 그리스도 안에서 그의 은혜의 풍성함을 따라 그의 피로 말미암아 구속 곧 죄 사함을 받았으니"
      ],
      "raw_text_hashes": [
        "8aadfc49785e775155d735344b6a9c128468cd5628523f35729a0a3c996403d1"
      ]
    },
