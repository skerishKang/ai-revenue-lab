      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "갈대아 땅 그발강 가에서 여호와의 말씀이 부시의 아들 제사장 나 에스겔에게 특별히 임하고 여호와의 권능이 내 위에 있으니라"
      ],
      "raw_text_hashes": [
        "5a55879a77793c4a463a4bce734d88fac1e10e4e0575b801c652d5c795505dd3"
