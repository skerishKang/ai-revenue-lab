      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호야긴왕의 사로잡힌지 오년 그 달 오일이라"
      ],
      "raw_text_hashes": [
        "21ebae209e43a6b03d2caebe0e86df042d0e7347e2cbeb2ef8c694849d8c0225"
