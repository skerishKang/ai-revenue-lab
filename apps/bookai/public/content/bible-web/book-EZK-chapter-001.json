      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 다리는 곧고 그 발바닥은 송아지 발바닥 같고 마광한 구리 같이 빛나며"
      ],
      "raw_text_hashes": [
