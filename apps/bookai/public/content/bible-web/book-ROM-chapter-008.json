      "raw_texts": [
        "피조물이 다 이제까지 함께 탄식하며 함께 고통하는 것을 우리가 아나니"
      ],
      "raw_text_hashes": [
        "77acd82b9a9b93f3143858b5cdb3cf163f98de5c9c001de07a4a89a060e7326b"
