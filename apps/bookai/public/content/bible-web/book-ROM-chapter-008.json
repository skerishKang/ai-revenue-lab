      "translation_text_hash": "377f877d5f2ba0517bf1cbef0e5e6faae9be65f6356ddb5faa020e5c5955b66f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "피조물의 고대하는 바는 하나님의 아들들의 나타나는 것이니"
