      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "생각건대 현재의 고난은 장차 우리에게 나타날 영광과 족히 비교할 수 없도다"
      ],
      "raw_text_hashes": [
        "3cbbfa16ae973f02700e6665659b56ee1ac4feaaa25ccc5cab947dacecd6d5e1"
      ]
    },
