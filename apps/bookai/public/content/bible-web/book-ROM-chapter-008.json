      "source_text_hash": "9c07e82bce72213c4985642032a27ac06f07b6f08025188f546337774d9e6529",
      "translation_text_hash": "1b331aa2610e6ac7b6192200e6ec1430ebae0a5d2f1548c79ae0f3fae213092b",
