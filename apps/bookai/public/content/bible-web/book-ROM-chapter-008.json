      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "피조물이 허무한데 굴복하는 것은 자기 뜻이 아니요 오직 굴복케 하시는 이로 말미암음이라"
      ],
      "raw_text_hashes": [
        "ed349ea159fe11577e4122d3a73f96d757e8cad682e1b1f4258f9295d4a2921b"
      ]
