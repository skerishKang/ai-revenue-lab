        "verse": 3
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 34,
          "verse": 3
        }
      ],
      "en": "and the south, and the Plain of the valley of Jericho the city of palm trees, to Zoar.",
      "ko": "남방과 종려의 성읍 여리고 골짜기 평지를 소알까지 보이시고",
      "source_text_hash": "3c52bc6bc5d831cc38182334b9ca8d0cc90d9686d6cf0aaae9bc2a073da42b04",
      "translation_text_hash": "03adb49e2030f26b8860c8b4373b50b8fc1ce0e47248d764cf39564c1472e840",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "남방과 종려의 성읍 여리고 골짜기 평지를 소알까지 보이시고"
      ],
      "raw_text_hashes": [
        "03adb49e2030f26b8860c8b4373b50b8fc1ce0e47248d764cf39564c1472e840"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:34:4",
      "sequence": 5844,
      "chapter_label": "DEU 34",
      "verse_label": "4",
      "locator": {
