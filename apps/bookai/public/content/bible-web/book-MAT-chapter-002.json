      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "유대인의 왕으로 나신 이가 어디 계시뇨 우리가 동방에서 그의 별을 보고 그에게 경배하러 왔노라 하니"
      ],
      "raw_text_hashes": [
