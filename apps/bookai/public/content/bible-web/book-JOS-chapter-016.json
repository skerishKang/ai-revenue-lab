        {
          "book": "JOS",
          "chapter": 16,
          "verse": 4
        }
      ],
      "en": "The children of Joseph, Manasseh and Ephraim, took their inheritance.",
      "ko": "요셉의 자손 므낫세와 에브라임이 그 기업을 얻었더라",
      "source_text_hash": "7f004df4735e6deef6b383db4ad49232d7775cf9b591dc1ad97ed6fd67fdcf49",
      "translation_text_hash": "a3cf944ed59c5701eebea0cd758b4f1e655318fa8f01615c5dc0d5de445376ab",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요셉의 자손 므낫세와 에브라임이 그 기업을 얻었더라"
      ],
      "raw_text_hashes": [
        "a3cf944ed59c5701eebea0cd758b4f1e655318fa8f01615c5dc0d5de445376ab"
      ]
    },
    {
      "canonical_locator": "bible:web:JOS:16:5",
      "sequence": 6271,
      "chapter_label": "JOS 16",
