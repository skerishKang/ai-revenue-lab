      "source_text_hash": "49a9fba3915fbb897f0b95378c117e61512a60ab0b27e17d205bde0bc1bb4c78",
      "translation_text_hash": "a21a253b34b8fec7f4ce6aeff79a5c2f2813725af745c30a46d4a6724b6abfad",
