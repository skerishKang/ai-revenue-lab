      "raw_texts": [
        "지혜자의 입의 말은 은혜로우나 우매자의 입술은 자기를 삼키나니"
      ],
      "raw_text_hashes": [
        "62883592b2c88ce66d17f718b21699e5a696f8bbd5a09846d3e5aa4ac5cadc38"
      ]
    },
