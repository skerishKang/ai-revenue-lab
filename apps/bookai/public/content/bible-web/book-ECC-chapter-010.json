      "translation_text_hash": "020b6b6c8a6fecd6792ac513b42197980df79bff13f339746d669711a3e37db4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
