      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 132,
          "verse": 9
        }
      ],
      "en": "Let your priests be clothed with righteousness. Let your saints shout for joy!",
      "ko": "주의 제사장들은 의를 입고 주의 성도들은 즐거이 외칠찌어다",
      "source_text_hash": "cf5c1e94fb43d685f6f66a78c9ed96febb06fad92e30d7b76de79564fe667b65",
      "translation_text_hash": "1166dc9aadefaa6e8b0fc8a379ff3f1b0b6959f3b2e0b0bb1be4cef5156dc93e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 제사장들은 의를 입고 주의 성도들은 즐거이 외칠찌어다"
      ],
      "raw_text_hashes": [
        "1166dc9aadefaa6e8b0fc8a379ff3f1b0b6959f3b2e0b0bb1be4cef5156dc93e"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:132:10",
      "sequence": 16162,
      "chapter_label": "PSA 132",
      "verse_label": "10",
      "locator": {
        "book": "PSA",
