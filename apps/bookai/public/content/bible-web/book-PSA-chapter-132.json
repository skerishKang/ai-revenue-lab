      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 132,
          "verse": 8
        }
      ],
      "en": "Arise, LORD, into your resting place, you, and the ark of your strength.",
      "ko": "여호와여 일어나사 주의 권능의 궤와 함께 평안한 곳으로 들어 가소서",
      "source_text_hash": "82f08d7ed3d1142314c3a5dc9ed7151f5dd803967ccc9245f16830a7c4786997",
      "translation_text_hash": "516c181d38ba94ef9eb8f9bc12ad631d009ebfbed49cc09ecbadebf2ec305153",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 일어나사 주의 권능의 궤와 함께 평안한 곳으로 들어 가소서"
      ],
      "raw_text_hashes": [
        "516c181d38ba94ef9eb8f9bc12ad631d009ebfbed49cc09ecbadebf2ec305153"
      ]
    },
    {
