      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저가 여호와께 맹세하며 야곱의 전능자에게 서원하기를"
      ],
      "raw_text_hashes": [
        "5049be093c63cc3cb0d7d3e9a51c0e10d483989041656d1f808c1592fd06e21d"
