        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 132,
          "verse": 10
        }
      ],
      "en": "For your servant David’s sake, don’t turn away the face of your anointed one.",
      "ko": "주의 종 다윗을 위하여 주의 기름 받은 자의 얼굴을 물리치지 마옵소서",
      "source_text_hash": "2c87473b18a93fb2dfa5065137817974b18bd154ec642b5fb832c779931b8593",
      "translation_text_hash": "2f94af33f2a292aa8b957e36f4977231b7a9cd793182f09216f627dfe3efeb01",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 종 다윗을 위하여 주의 기름 받은 자의 얼굴을 물리치지 마옵소서"
      ],
      "raw_text_hashes": [
        "2f94af33f2a292aa8b957e36f4977231b7a9cd793182f09216f627dfe3efeb01"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:132:11",
      "sequence": 16163,
      "chapter_label": "PSA 132",
