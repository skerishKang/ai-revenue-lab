      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 132,
          "verse": 4
        }
      ],
      "en": "I will not give sleep to my eyes, or slumber to my eyelids,",
      "ko": "내 눈으로 잠들게 아니하며 내 눈꺼풀로 졸게 아니하기를",
      "source_text_hash": "d31e57ba8e25e5e634f38149a2426c714dafd607c730a0cc2f36f3a8999c3706",
      "translation_text_hash": "46ba4f5c156b259c874a27d3be96d3647a109cc98da5bb015280d96d0a68c488",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 눈으로 잠들게 아니하며 내 눈꺼풀로 졸게 아니하기를"
      ],
      "raw_text_hashes": [
        "46ba4f5c156b259c874a27d3be96d3647a109cc98da5bb015280d96d0a68c488"
      ]
    },
