      "raw_locator": [
        {
          "book": "EZR",
          "chapter": 1,
          "verse": 9
        }
      ],
      "en": "This is the number of them: thirty platters of gold, one thousand platters of silver, twenty-nine knives,",
      "ko": "그 수효는 금반이 삼십이요 은반이 일천이요 칼이 이십 구요",
      "source_text_hash": "1a147c3d4ebe2d1ed386c1616ed7a41feb5a8c111892faaf0c29d3415890e7e0",
      "translation_text_hash": "3b55a3f9fb445c8e807e45edb08fdf80df34867c041fd084c3850b90298c34d6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 수효는 금반이 삼십이요 은반이 일천이요 칼이 이십 구요"
      ],
      "raw_text_hashes": [
        "3b55a3f9fb445c8e807e45edb08fdf80df34867c041fd084c3850b90298c34d6"
      ]
    },
    {
