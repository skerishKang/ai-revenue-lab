      "en": "The LORD’s word came to me, saying,",
      "ko": "여호와의 말씀이 내게 임하여 이르시되",
      "source_text_hash": "9896c4581212f69b0f4adc87dc02e9102477b3f2cc043645fc2c8a0c2e7ce852",
      "translation_text_hash": "b68bc1e5bd880cd364f849c5190aa187d1586b7303a58d18e396d2e4e12ced22",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 내게 임하여 이르시되"
      ],
      "raw_text_hashes": [
        "b68bc1e5bd880cd364f849c5190aa187d1586b7303a58d18e396d2e4e12ced22"
      ]
