        {
          "book": "GEN",
          "chapter": 17,
          "verse": 3
        }
      ],
      "en": "Abram fell on his face. God talked with him, saying,",
      "ko": "아브람이 엎드린대 하나님이 또 그에게 일러 가라사대",
      "source_text_hash": "29c53ec499762842e098b857a710ebb9be969c6874adc98ee02cf89a335801e9",
      "translation_text_hash": "5f65145ab8535b44ef35f884c42c0a2ea14acaae4ec90a305d22f080dd2c1cb0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브람이 엎드린대 하나님이 또 그에게 일러 가라사대"
      ],
      "raw_text_hashes": [
        "5f65145ab8535b44ef35f884c42c0a2ea14acaae4ec90a305d22f080dd2c1cb0"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:17:4",
      "sequence": 402,
      "chapter_label": "GEN 17",
      "verse_label": "4",
      "locator": {
        "book": "GEN",
