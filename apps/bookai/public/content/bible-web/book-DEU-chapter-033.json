      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 33,
          "verse": 26
        }
      ],
      "en": "“There is no one like God, Jeshurun, who rides on the heavens for your help, in his excellency on the skies.",
      "ko": "여수룬이여 하나님 같은 자 없도다 그가 너를 도우시려고 하늘을 타시고 궁창에서 위엄을 나타내시는도다",
      "source_text_hash": "e2b6a0a76d65a3c79dce4d6521dc07fd7011262f7332bb3415f85b7581ccb143",
      "translation_text_hash": "ce61bbed0fa7651777b1fb3deaca9584c2113fd33e60d1baa50c88268dc12e11",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
