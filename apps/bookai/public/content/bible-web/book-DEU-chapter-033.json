      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "스불론에 대하여는 일렀으되 스불론이여 너는 나감을 기뻐하라 잇사갈이여 너는 장막에 있음을 즐거워하라"
      ],
      "raw_text_hashes": [
