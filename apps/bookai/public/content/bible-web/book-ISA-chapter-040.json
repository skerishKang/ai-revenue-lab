      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 40,
          "verse": 8
        }
      ],
      "en": "The grass withers, the flower fades; but the word of our God stands forever.”",
      "ko": "풀은 마르고 꽃은 시드나 우리 하나님의 말씀은 영영히 서리라 하라",
      "source_text_hash": "a9902aab824969eb0ada7a380c7a0ed3d8b484abb6e667ffbd413f07680e7c96",
      "translation_text_hash": "fc98e99b2754c521f86fd49751fce6a2397a5825b6812fff24aebcfceb434e9e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "풀은 마르고 꽃은 시드나 우리 하나님의 말씀은 영영히 서리라 하라"
      ],
      "raw_text_hashes": [
        "fc98e99b2754c521f86fd49751fce6a2397a5825b6812fff24aebcfceb434e9e"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:40:9",
