    {
      "canonical_locator": "bible:web:DAN:8:4",
      "sequence": 21966,
      "chapter_label": "DAN 8",
      "verse_label": "4",
      "locator": {
        "book": "DAN",
        "chapter": 8,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "DAN",
          "chapter": 8,
          "verse": 4
        }
      ],
      "en": "I saw the ram pushing westward, northward, and southward. No animals could stand before him. There wasn’t any who could deliver out of his hand, but he did according to his will, and magnified himself.",
      "ko": "내가 본즉 그 수양이 서와 북과 남을 향하여 받으나 그것을 당할 짐승이 하나도 없고 그 손에서 능히 구할이가 절대로 없으므로 그것이 임의로 행하고 스스로 강대하더라",
      "source_text_hash": "4df17d696dd302e65e83ef6dbd9d5408437c9557868fa0f51d592a0477ac0276",
      "translation_text_hash": "f1f714606140870f41482fc3ef4bf784f2ba1056e5953cb7a3053059e1d40bfc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 본즉 그 수양이 서와 북과 남을 향하여 받으나 그것을 당할 짐승이 하나도 없고 그 손에서 능히 구할이가 절대로 없으므로 그것이 임의로 행하고 스스로 강대하더라"
      ],
      "raw_text_hashes": [
