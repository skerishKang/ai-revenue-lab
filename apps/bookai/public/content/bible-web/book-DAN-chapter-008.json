    {
      "canonical_locator": "bible:web:DAN:8:3",
      "sequence": 21965,
      "chapter_label": "DAN 8",
      "verse_label": "3",
      "locator": {
        "book": "DAN",
        "chapter": 8,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "DAN",
          "chapter": 8,
          "verse": 3
        }
      ],
      "en": "Then I lifted up my eyes and saw, and behold, a ram which had two horns stood before the river. The two horns were high, but one was higher than the other, and the higher came up last.",
      "ko": "내가 눈을 들어 본즉 강 가에 두 뿔 가진 수양이 섰는데 그 두 뿔이 다 길어도 한 뿔은 다른 뿔보다도 길었고 그 긴 것은 나중에 난 것이더라",
      "source_text_hash": "c7534babc1da890fe962472eecdd3c8f9deb092c079167083ca91b9c8ddf0984",
      "translation_text_hash": "f55ef8fedde03112b5c7a7a440a74c1f16ca8d9754baf2a96cddf9c65ba421f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 눈을 들어 본즉 강 가에 두 뿔 가진 수양이 섰는데 그 두 뿔이 다 길어도 한 뿔은 다른 뿔보다도 길었고 그 긴 것은 나중에 난 것이더라"
      ],
      "raw_text_hashes": [
        "f55ef8fedde03112b5c7a7a440a74c1f16ca8d9754baf2a96cddf9c65ba421f5"
