      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어떤 여인이 유출을 하되 그 유출이 피면 칠일 동안 불결하니 무릇 그를 만지는 자는 저녁까지 부정할 것이요"
      ],
      "raw_text_hashes": [
