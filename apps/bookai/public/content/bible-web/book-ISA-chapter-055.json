        "verse": 8
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 55,
          "verse": 8
        }
      ],
      "en": "“For my thoughts are not your thoughts, and your ways are not my ways,” says the LORD.",
      "ko": "여호와의 말씀에 내 생각은 너희 생각과 다르며 내 길은 너희 길과 달라서",
      "source_text_hash": "eabd3ffb117d0a9625b5aece0cd4b57f9afcb07d385cb94b979032579a76b153",
      "translation_text_hash": "aa6c2ddbb74a489e4f0587ed4437caee96736ed80d47646a7fdf567179920d32",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀에 내 생각은 너희 생각과 다르며 내 길은 너희 길과 달라서"
      ],
      "raw_text_hashes": [
        "aa6c2ddbb74a489e4f0587ed4437caee96736ed80d47646a7fdf567179920d32"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:55:9",
