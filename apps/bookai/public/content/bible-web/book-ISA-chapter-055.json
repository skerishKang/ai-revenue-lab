      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 55,
          "verse": 4
        }
      ],
      "en": "Behold, I have given him for a witness to the peoples, a leader and commander to the peoples.",
      "ko": "내가 그를 만민에게 증거로 세웠고 만민의 인도자와 명령자를 삼았었나니",
      "source_text_hash": "bb504aee0749790d55c073738bf16fe57c154ab7f9f317e77b7a8123807c8f7b",
      "translation_text_hash": "d53fefbcba34039a2105c7c02cb08e2c37b52718d9fb2aed0da99fb13b13a294",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 그를 만민에게 증거로 세웠고 만민의 인도자와 명령자를 삼았었나니"
      ],
      "raw_text_hashes": [
        "d53fefbcba34039a2105c7c02cb08e2c37b52718d9fb2aed0da99fb13b13a294"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:55:5",
      "sequence": 18746,
      "chapter_label": "ISA 55",
