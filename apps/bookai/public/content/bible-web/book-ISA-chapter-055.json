      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 55,
          "verse": 3
        }
      ],
      "en": "Turn your ear, and come to me. Hear, and your soul will live. I will make an everlasting covenant with you, even the sure mercies of David.",
      "ko": "너희는 귀를 기울이고 내게 나아와 들으라 그리하면 너희 영혼이 살리라 내가 너희에게 영원한 언약을 세우리니 곧 다윗에게 허락한 확실한 은혜니라",
      "source_text_hash": "d4ed3014c42c5d3601d638c9da74bcad0d8f2b594e53e18e98f51358262a32b3",
      "translation_text_hash": "18ecf43c8301ab66ebf5b5ed1a510443c7f21b9623d826c6ac2f0d517f829144",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 귀를 기울이고 내게 나아와 들으라 그리하면 너희 영혼이 살리라 내가 너희에게 영원한 언약을 세우리니 곧 다윗에게 허락한 확실한 은혜니라"
      ],
      "raw_text_hashes": [
