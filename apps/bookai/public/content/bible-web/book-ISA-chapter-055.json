      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 55,
          "verse": 7
        }
      ],
      "en": "Let the wicked forsake his way, and the unrighteous man his thoughts. Let him return to the LORD, and he will have mercy on him, to our God, for he will freely pardon.",
      "ko": "악인은 그 길을, 불의한 자는 그 생각을 버리고 여호와께로 돌아오라 그리하면 그가 긍휼히 여기시리라 우리 하나님께로 나아오라 그가 널리 용서하시리라",
      "source_text_hash": "80ff45da40f15fa51743a0d616ad471f18326e75890418b006091c684d18ca94",
      "translation_text_hash": "cdb8ec945db9fd12455e6dc4015ac671e4766b301bdd113b3ecfefbd56abc514",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악인은 그 길을, 불의한 자는 그 생각을 버리고 여호와께로 돌아오라 그리하면 그가 긍휼히 여기시리라 우리 하나님께로 나아오라 그가 널리 용서하시리라"
      ],
      "raw_text_hashes": [
