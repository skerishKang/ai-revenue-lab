      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 24,
          "verse": 2
        }
      ],
      "en": "When he was called, Tertullus began to accuse him, saying, “Seeing that by you we enjoy much peace, and that prosperity is coming to this nation by your foresight,",
      "ko": "바울을 부르매 더둘로가 송사하여 가로되",
      "source_text_hash": "bdc0afca2bd679488ff49d6cf88f6de519085bceefab6072d0b0627855e10502",
      "translation_text_hash": "67d3eee61c48c75d4b3684d04da40421a5e58d78b9c8c7242745bf71f9d6a9bb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바울을 부르매 더둘로가 송사하여 가로되"
      ],
      "raw_text_hashes": [
        "67d3eee61c48c75d4b3684d04da40421a5e58d78b9c8c7242745bf71f9d6a9bb"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:24:3",
      "sequence": 27770,
      "chapter_label": "ACT 24",
      "verse_label": "3",
      "locator": {
        "book": "ACT",
