      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 24,
          "verse": 8
        }
      ],
      "en": "By examining him yourself you may ascertain all these things of which we accuse him.”",
      "ko": "우리의 송사하는 이 모든 일을 아실 수 있나이다 하니",
      "source_text_hash": "212f9594938931ca45e17290ba8240c007c9b6757e986d102a8f56409c287411",
      "translation_text_hash": "6a774b883cca58292a8ab73068c3145fb344dd1363619ea3f2635c4eb4c51a5f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
