      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너 모세만 여호와에게 가까이 나아오고 그들은 가까이 나아오지 말며 백성은 너와 함께 올라오지 말찌니라"
      ],
      "raw_text_hashes": [
