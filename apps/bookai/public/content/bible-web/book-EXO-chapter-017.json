      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호수아가 모세의 말대로 행하여 아말렉과 싸우고 모세와 아론과 훌은 산꼭대기에 올라가서"
      ],
      "raw_text_hashes": [
