      "canonical_locator": "bible:web:JER:49:31",
      "sequence": 20159,
      "chapter_label": "JER 49",
      "verse_label": "31",
      "locator": {
        "book": "JER",
        "chapter": 49,
        "verse": 31
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 49,
          "verse": 31
        }
      ],
      "en": "Arise! Go up to a nation that is at ease, that dwells without care,” says the LORD; “that has neither gates nor bars, that dwells alone.",
      "ko": "나 여호와가 말하노라 너는 일어나 저 평안하고 염려 없이 거하는 백성 곧 성문이나 문빗장이 없이 홀로 거하는 국민을 치라",
      "source_text_hash": "1e79d900b0b070580b7b815162c6be4ff90664990584d967e59706cc440df5a7",
      "translation_text_hash": "2259e4ff2d24cff8d2c07b9cb1bf5273e9fa04c6218dc6e65f11986ba7cd8bf5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나 여호와가 말하노라 너는 일어나 저 평안하고 염려 없이 거하는 백성 곧 성문이나 문빗장이 없이 홀로 거하는 국민을 치라"
      ],
      "raw_text_hashes": [
