      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "악인에게는 많은 슬픔이 있으나 여호와를 신뢰하는 자에게는 인자하심이 두르리로다"
      ],
      "raw_text_hashes": [
        "e1ef31529b1a73f00fca32686cafdd83b119d99551dc1bd4611ad08b21e4cfff"
      ]
