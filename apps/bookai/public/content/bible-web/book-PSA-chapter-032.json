      ],
      "en": "I will instruct you and teach you in the way which you shall go. I will counsel you with my eye on you.",
      "ko": "내가 너의 갈 길을 가르쳐 보이고 너를 주목하여 훈계하리로다",
      "source_text_hash": "d411c5b0d644ccf7936988a18f1d1a2fe5dacab0aa4fd608b7a075a2f129f62b",
      "translation_text_hash": "7ccd27159b73cd5e80230b3dc39b01450a256e22ba825d7b8b9d0e068ce31018",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 너의 갈 길을 가르쳐 보이고 너를 주목하여 훈계하리로다"
      ],
      "raw_text_hashes": [
        "7ccd27159b73cd5e80230b3dc39b01450a256e22ba825d7b8b9d0e068ce31018"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:32:9",
      "sequence": 14365,
      "chapter_label": "PSA 32",
      "verse_label": "9",
      "locator": {
