      "raw_locator": [
        {
          "book": "SNG",
          "chapter": 5,
          "verse": 4
        }
      ],
      "en": "My beloved thrust his hand in through the latch opening. My heart pounded for him.",
      "ko": "나의 사랑하는 자가 문틈으로 손을 들이밀매 내 마음이 동하여서",
      "source_text_hash": "007b263d6bddf5cd5cc3e8fe78c0594dcd777bc907d3ee580fabb3360e5d7d10",
      "translation_text_hash": "afafd169d18c6399e08425bf178918dfe8400376d5481aabbe13b41465ac4eaa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 사랑하는 자가 문틈으로 손을 들이밀매 내 마음이 동하여서"
      ],
      "raw_text_hashes": [
        "afafd169d18c6399e08425bf178918dfe8400376d5481aabbe13b41465ac4eaa"
      ]
    },
    {
      "canonical_locator": "bible:web:SNG:5:5",
      "sequence": 17604,
      "chapter_label": "SNG 5",
