      ]
    },
    {
      "canonical_locator": "bible:web:ISA:45:23",
      "sequence": 18585,
      "chapter_label": "ISA 45",
      "verse_label": "23",
      "locator": {
        "book": "ISA",
        "chapter": 45,
        "verse": 23
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 45,
          "verse": 23
        }
      ],
      "en": "I have sworn by myself. The word has gone out of my mouth in righteousness, and will not be revoked, that to me every knee shall bow, every tongue shall take an oath.",
      "ko": "내가 나를 두고 맹세하기를 나의 입에서 의로운 말이 나갔은즉 돌아오지 아니 하나니 내게 모든 무릎이 꿇겠고 모든 혀가 맹약하리라 하였노라",
      "source_text_hash": "d27f3448c2288e06543f71a71b8bd5b1a6f1bf9969efcb048eb271d44f93c11f",
      "translation_text_hash": "7f7c01e77bb4d3fa9d33a784d72404e8e643505f640ef60853febc64f503461a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 나를 두고 맹세하기를 나의 입에서 의로운 말이 나갔은즉 돌아오지 아니 하나니 내게 모든 무릎이 꿇겠고 모든 혀가 맹약하리라 하였노라"
      ],
      "raw_text_hashes": [
