    {
      "canonical_locator": "bible:web:ISA:45:20",
      "sequence": 18582,
      "chapter_label": "ISA 45",
      "verse_label": "20",
      "locator": {
        "book": "ISA",
        "chapter": 45,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 45,
          "verse": 20
        }
      ],
      "en": "“Assemble yourselves and come. Draw near together, you who have escaped from the nations. Those have no knowledge who carry the wood of their engraved image, and pray to a god that can’t save.",
      "ko": "열방 중에서 피난한 자들아 너희는 모여 오라 한 가지로 가까이 나아 오라 나무 우상을 가지고 다니며 능히 구원치 못하는 신에게 기도하는 자들은 무지한 자니라",
      "source_text_hash": "c91b18ea4ed251f51d5ae5e83241eb6501e75a168a08c078981cab1386925262",
      "translation_text_hash": "8c37f439fd5c74a46b290f335beea8a0e46cb34f6663ada02e562ee1f7f6639d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "열방 중에서 피난한 자들아 너희는 모여 오라 한 가지로 가까이 나아 오라 나무 우상을 가지고 다니며 능히 구원치 못하는 신에게 기도하는 자들은 무지한 자니라"
      ],
      "raw_text_hashes": [
        "8c37f439fd5c74a46b290f335beea8a0e46cb34f6663ada02e562ee1f7f6639d"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:45:21",
      "sequence": 18583,
      "chapter_label": "ISA 45",
      "verse_label": "21",
      "locator": {
        "book": "ISA",
        "chapter": 45,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 45,
          "verse": 21
        }
      ],
      "en": "Declare and present it. Yes, let them take counsel together. Who has shown this from ancient time? Who has declared it of old? Haven’t I, the LORD? There is no other God besides me, a just God and a Savior. There is no one besides me.",
      "ko": "너희는 고하며 진술하고 또 피차 상의하여 보라 이 일을 이전부터 보인 자가 누구냐 예로부터 고한 자가 누구냐 나 여호와가 아니냐 나 외에 다른 신이 없나니 나는 공의를 행하며 구원을 베푸는 하나님이라 나 외에 다른이가 없느니라",
      "source_text_hash": "8873d033ada1387dbcb4fda23f97f025e91991307647a6a4abe597148de64cc5",
      "translation_text_hash": "b29e58b37732548da28819aea66caa7e9231fae565d5e57da592a6d4fc8368e0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 고하며 진술하고 또 피차 상의하여 보라 이 일을 이전부터 보인 자가 누구냐 예로부터 고한 자가 누구냐 나 여호와가 아니냐 나 외에 다른 신이 없나니 나는 공의를 행하며 구원을 베푸는 하나님이라 나 외에 다른이가 없느니라"
      ],
      "raw_text_hashes": [
        "b29e58b37732548da28819aea66caa7e9231fae565d5e57da592a6d4fc8368e0"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:45:22",
      "sequence": 18584,
      "chapter_label": "ISA 45",
      "verse_label": "22",
      "locator": {
        "book": "ISA",
