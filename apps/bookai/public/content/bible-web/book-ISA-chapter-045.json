    {
      "canonical_locator": "bible:web:ISA:45:17",
      "sequence": 18579,
      "chapter_label": "ISA 45",
      "verse_label": "17",
      "locator": {
        "book": "ISA",
        "chapter": 45,
        "verse": 17
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 45,
          "verse": 17
        }
      ],
      "en": "Israel will be saved by the LORD with an everlasting salvation. You will not be disappointed nor confounded to ages everlasting.",
      "ko": "이스라엘은 여호와께 구원을 입어 영원한 구원을 얻으리니 영세에 부끄러움을 당하거나 욕을 받지 아니하리로다",
      "source_text_hash": "d310d18e18f2c07ab9cca12d118f7d69fe01262a03c3e2b3017251f03deb2daa",
      "translation_text_hash": "0bd72fdae1b0a0e86abd23276b4455095f1c1d47e3f5e1d6fffc1207d5520ec7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘은 여호와께 구원을 입어 영원한 구원을 얻으리니 영세에 부끄러움을 당하거나 욕을 받지 아니하리로다"
      ],
      "raw_text_hashes": [
        "0bd72fdae1b0a0e86abd23276b4455095f1c1d47e3f5e1d6fffc1207d5520ec7"
      ]
