        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 45,
          "verse": 12
        }
      ],
      "en": "I have made the earth, and created man on it. I, even my hands, have stretched out the heavens. I have commanded all their army.",
      "ko": "내가 땅을 만들고 그 위에 사람을 창조하였으며 내가 친수로 하늘을 펴고 그 만상을 명하였노라",
      "source_text_hash": "933ebb044861a9b42f48ca17edecf1b823361d1d1c5294bb3405df9f2098870d",
      "translation_text_hash": "e78954cf69c3ed7e6e8dcca8af39965ab5fdf8b137e49c4d35e743b113269894",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 땅을 만들고 그 위에 사람을 창조하였으며 내가 친수로 하늘을 펴고 그 만상을 명하였노라"
      ],
      "raw_text_hashes": [
        "e78954cf69c3ed7e6e8dcca8af39965ab5fdf8b137e49c4d35e743b113269894"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:45:13",
      "sequence": 18575,
