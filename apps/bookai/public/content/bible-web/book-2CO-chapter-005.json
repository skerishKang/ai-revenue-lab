      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 5,
          "verse": 7
        }
      ],
      "en": "for we walk by faith, not by sight.",
      "ko": "이는 우리가 믿음으로 행하고 보는 것으로 하지 아니함이로라",
      "source_text_hash": "d024c9186cc7de310c21b4c1bf8407db6d2f7c65a3c77ad734ac83720e75d513",
      "translation_text_hash": "965461d25a02c698dbbbb0c81fa0ceba2a736e16d6ffb4703617e567d9386b7e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 우리가 믿음으로 행하고 보는 것으로 하지 아니함이로라"
      ],
      "raw_text_hashes": [
        "965461d25a02c698dbbbb0c81fa0ceba2a736e16d6ffb4703617e567d9386b7e"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:5:8",
      "sequence": 28882,
      "chapter_label": "2CO 5",
      "verse_label": "8",
      "locator": {
