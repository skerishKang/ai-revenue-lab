      ],
      "en": "if indeed being clothed, we will not be found naked.",
      "ko": "이렇게 입음은 벗은 자들로 발견되지 않으려 함이라",
      "source_text_hash": "9cb5c5fadfa990c6fe4cc270337c5c6b3c9dcab05e38a1f47334170500fcb226",
      "translation_text_hash": "e81550bb30ebe2ceed7baae828687e1e6f375b3c317306519c9b214b8959ca5a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이렇게 입음은 벗은 자들로 발견되지 않으려 함이라"
      ],
      "raw_text_hashes": [
        "e81550bb30ebe2ceed7baae828687e1e6f375b3c317306519c9b214b8959ca5a"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:5:4",
      "sequence": 28878,
      "chapter_label": "2CO 5",
      "verse_label": "4",
      "locator": {
