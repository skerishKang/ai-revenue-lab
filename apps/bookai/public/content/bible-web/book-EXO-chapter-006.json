    {
      "canonical_locator": "bible:web:EXO:6:7",
      "sequence": 1663,
      "chapter_label": "EXO 6",
      "verse_label": "7",
      "locator": {
        "book": "EXO",
        "chapter": 6,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 6,
          "verse": 7
        }
      ],
      "en": "I will take you to myself for a people. I will be your God; and you shall know that I am the LORD your God, who brings you out from under the burdens of the Egyptians.",
      "ko": "너희로 내 백성을 삼고 나는 너희 하나님이 되리니 나는 애굽 사람의 무거운 짐 밑에서 너희를 빼어낸 너희 하나님 여호와인줄 너희가 알찌라",
      "source_text_hash": "a56f11568ad631c5f3fe10e570f356beadf4aa17033d6d2c824a7aa903ce62d3",
      "translation_text_hash": "041a1e9ec526cda767e86ff1cee32955267988cd0fc140e97603c71bc9025135",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희로 내 백성을 삼고 나는 너희 하나님이 되리니 나는 애굽 사람의 무거운 짐 밑에서 너희를 빼어낸 너희 하나님 여호와인줄 너희가 알찌라"
      ],
      "raw_text_hashes": [
