        "verse": 5
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 6,
          "verse": 5
        }
      ],
      "en": "Moreover I have heard the groaning of the children of Israel, whom the Egyptians keep in bondage, and I have remembered my covenant.",
      "ko": "이제 애굽 사람이 종을 삼은 이스라엘 자손의 신음을 듣고 나의 언약을 기억하노라",
      "source_text_hash": "b22f58a2d29506de246fdde9581caeee638805f434c4b1aa70faa7d1e2f3a3d3",
      "translation_text_hash": "89a3e02e49780ebfa9970f0c72dcf70cb5babb98e3c343f24677b42efc268ad0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이제 애굽 사람이 종을 삼은 이스라엘 자손의 신음을 듣고 나의 언약을 기억하노라"
      ],
      "raw_text_hashes": [
        "89a3e02e49780ebfa9970f0c72dcf70cb5babb98e3c343f24677b42efc268ad0"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:6:6",
      "sequence": 1662,
      "chapter_label": "EXO 6",
      "verse_label": "6",
      "locator": {
