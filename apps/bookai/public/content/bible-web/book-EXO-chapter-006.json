      ],
      "en": "God spoke to Moses, and said to him, “I am the LORD.",
      "ko": "하나님이 모세에게 말씀하여 가라사대 나는 여호와로라",
      "source_text_hash": "7bba127a21b46d5cfbff29fc01bac2f1e4403263bc5cbc39bca8f603c316801d",
      "translation_text_hash": "b0aa6adc1fa0786c4dd6d3780105d6db11d3ec5eae6f56950ce58bf08d941700",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이 모세에게 말씀하여 가라사대 나는 여호와로라"
      ],
      "raw_text_hashes": [
        "b0aa6adc1fa0786c4dd6d3780105d6db11d3ec5eae6f56950ce58bf08d941700"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:6:3",
      "sequence": 1659,
      "chapter_label": "EXO 6",
