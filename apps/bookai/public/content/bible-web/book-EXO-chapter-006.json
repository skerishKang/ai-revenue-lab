        "verse": 4
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 6,
          "verse": 4
        }
      ],
      "en": "I have also established my covenant with them, to give them the land of Canaan, the land of their travels, in which they lived as aliens.",
      "ko": "가나안 땅 곧 그들의 우거하는 땅을 주기로 그들과 언약하였더니",
      "source_text_hash": "0d6ae6fa43d1cbccc191d254767012b2121467554792f8546d0b344cd94f2102",
      "translation_text_hash": "e42024af5c486c36c0aefc36ce32e20ecb5dcd4c171996e536d9e2d3ce832fbd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가나안 땅 곧 그들의 우거하는 땅을 주기로 그들과 언약하였더니"
      ],
      "raw_text_hashes": [
        "e42024af5c486c36c0aefc36ce32e20ecb5dcd4c171996e536d9e2d3ce832fbd"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:6:5",
      "sequence": 1661,
      "chapter_label": "EXO 6",
      "verse_label": "5",
      "locator": {
