    {
      "canonical_locator": "bible:web:2CH:20:22",
      "sequence": 11610,
      "chapter_label": "2CH 20",
      "verse_label": "22",
      "locator": {
        "book": "2CH",
        "chapter": 20,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 20,
          "verse": 22
        }
      ],
      "en": "When they began to sing and to praise, the LORD set ambushers against the children of Ammon, Moab, and Mount Seir, who had come against Judah; and they were struck.",
      "ko": "그 노래와 찬송이 시작될 때에 여호와께서 복병을 두어 유다를 치러 온 암몬 자손과 모압과 세일산 사람을 치게 하시므로 저희가 패하였으니",
      "source_text_hash": "c3a58d70da9ec50685a8110a5a0f9aca7129a7c8815741a3e75977f081bd53bd",
      "translation_text_hash": "a47058982750f9ddd8eb47351103da333acb92b8fec3e8b1bdbb9f4b3bef77a2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 노래와 찬송이 시작될 때에 여호와께서 복병을 두어 유다를 치러 온 암몬 자손과 모압과 세일산 사람을 치게 하시므로 저희가 패하였으니"
      ],
