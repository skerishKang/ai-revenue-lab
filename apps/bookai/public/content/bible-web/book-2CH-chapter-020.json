      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "곧 암몬과 모압 자손이 일어나 세일산 거민을 쳐서 진멸하고 세일 거민을 멸한 후에는 저희가 피차에 살륙하였더라"
      ],
      "raw_text_hashes": [
