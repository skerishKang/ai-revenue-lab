      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호사밧이 몸을 굽혀 얼굴을 땅에 대니 온 유다와 예루살렘 거민들도 여호와 앞에 엎드려 경배하고"
      ],
      "raw_text_hashes": [
