    {
      "canonical_locator": "bible:web:2CH:20:32",
      "sequence": 11620,
      "chapter_label": "2CH 20",
      "verse_label": "32",
      "locator": {
        "book": "2CH",
        "chapter": 20,
        "verse": 32
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 20,
          "verse": 32
        }
      ],
      "en": "He walked in the way of Asa his father, and didn’t turn away from it, doing that which was right in the LORD’s eyes.",
      "ko": "여호사밧이 그 부친 아사의 길로 행하여 돌이켜 떠나지 아니하고 여호와 보시기에 정직히 행하였으나",
      "source_text_hash": "46677dcc09ac0e2aa3a25578e8992a8a622d69e93f5db2b7d4c3fa6d616f17a5",
      "translation_text_hash": "0332bc2e93552097277b42f691e1d0474416f18dcd09aa3e59a55038b1834cd4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호사밧이 그 부친 아사의 길로 행하여 돌이켜 떠나지 아니하고 여호와 보시기에 정직히 행하였으나"
      ],
      "raw_text_hashes": [
        "0332bc2e93552097277b42f691e1d0474416f18dcd09aa3e59a55038b1834cd4"
      ]
