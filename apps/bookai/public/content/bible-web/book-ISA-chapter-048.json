    {
      "canonical_locator": "bible:web:ISA:48:18",
      "sequence": 18633,
      "chapter_label": "ISA 48",
      "verse_label": "18",
      "locator": {
        "book": "ISA",
        "chapter": 48,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 48,
          "verse": 18
        }
      ],
      "en": "Oh that you had listened to my commandments! Then your peace would have been like a river and your righteousness like the waves of the sea.",
      "ko": "슬프다 네가 나의 명령을 듣지 아니하였도다 만일 들었더면 네 평강이 강과 같았겠고 네 의가 바다 물결 같았을 것이며",
      "source_text_hash": "83bffe08cb5dfdb3e502a041599d5a9d2be1ff568ddc013cb49ccaa664e8a159",
      "translation_text_hash": "3a1ee249cd71beb3fb4dcf817eef1cf50144c8ef9e2d2b36caa2d6dfd9a2ab82",
      "translation_policy": "krv-1961-source-mapped",
