        "verse": 4
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 48,
          "verse": 4
        }
      ],
      "en": "Because I knew that you are obstinate, and your neck is an iron sinew, and your brow bronze;",
      "ko": "내가 알거니와 너는 완악하며 네 목의 힘줄은 무쇠요 네 이마는 놋이라",
      "source_text_hash": "76678058b80018731293ef078a18cb35d169138a8921f16f0091c821c6240be1",
      "translation_text_hash": "0fa1a68cf2581e056e964fffc8420f266905760a73fb1c6edcb30eebac7e84fa",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 알거니와 너는 완악하며 네 목의 힘줄은 무쇠요 네 이마는 놋이라"
      ],
      "raw_text_hashes": [
        "0fa1a68cf2581e056e964fffc8420f266905760a73fb1c6edcb30eebac7e84fa"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:48:5",
