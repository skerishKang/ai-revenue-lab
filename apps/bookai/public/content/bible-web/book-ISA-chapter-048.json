      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 내가 너를 연단하였으나 은처럼 하지 아니하고 너를 고난의 풀무에서 택하였노라"
      ],
      "raw_text_hashes": [
        "a894b2726d0e01ffde49bb04422dbb707640806df8ab6f526cc7e51106870c77"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:48:11",
      "sequence": 18626,
      "chapter_label": "ISA 48",
      "verse_label": "11",
      "locator": {
