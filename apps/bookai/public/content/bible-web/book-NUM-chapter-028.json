      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 28,
          "verse": 6
        }
      ],
      "en": "It is a continual burnt offering which was ordained in Mount Sinai for a pleasant aroma, an offering made by fire to the LORD.",
      "ko": "이는 시내산에서 정한 상번제로서 여호와께 드리는 향기로운 화제며",
      "source_text_hash": "b8b10bee5f13cc88b30b87fc799d02e4fdd7ede42ef903f5766ab79036c37459",
      "translation_text_hash": "ea30f3a8e94371c4d6c15a3c88c7fb04fe6c603a5e64a233acab7e5bed403fd0",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 시내산에서 정한 상번제로서 여호와께 드리는 향기로운 화제며"
      ],
      "raw_text_hashes": [
        "ea30f3a8e94371c4d6c15a3c88c7fb04fe6c603a5e64a233acab7e5bed403fd0"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:28:7",
      "sequence": 4585,
      "chapter_label": "NUM 28",
      "verse_label": "7",
      "locator": {
        "book": "NUM",
