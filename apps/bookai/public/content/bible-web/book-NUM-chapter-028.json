      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 28,
          "verse": 4
        }
      ],
      "en": "You shall offer the one lamb in the morning, and you shall offer the other lamb at evening,",
      "ko": "한 어린 양은 아침에 드리고 한 어린 양은 해 질 때에 드릴 것이요",
      "source_text_hash": "e956260e677e5cc663cede649d9fc06492e3d09211326769a797f8e5a3248db3",
      "translation_text_hash": "b30f8ad3dc73ef32e4a6ff0e1ac8bf91e0e0bb695e13bd8835e95f835e373d44",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "한 어린 양은 아침에 드리고 한 어린 양은 해 질 때에 드릴 것이요"
      ],
      "raw_text_hashes": [
        "b30f8ad3dc73ef32e4a6ff0e1ac8bf91e0e0bb695e13bd8835e95f835e373d44"
      ]
    },
    {
