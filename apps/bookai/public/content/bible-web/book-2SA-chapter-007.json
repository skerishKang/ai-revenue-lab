      "sequence": 8193,
      "chapter_label": "2SA 7",
      "verse_label": "12",
      "locator": {
        "book": "2SA",
        "chapter": 7,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 7,
          "verse": 12
        }
      ],
      "en": "When your days are fulfilled and you sleep with your fathers, I will set up your offspring after you, who will proceed out of your body, and I will establish his kingdom.",
      "ko": "네 수한이 차서 네 조상들과 함께 잘 때에 내가 네 몸에서 날 자식을 네 뒤에 세워 그 나라를 견고케 하리라",
      "source_text_hash": "d9f4de207467dc0ac164f17d20c91cfb23c07de402fc3b3df6e06e68be34aaa8",
      "translation_text_hash": "9a94b7696faa6f91d34558a67e4a20d2c1491bf7fe2da766fd6136a1013638d6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 수한이 차서 네 조상들과 함께 잘 때에 내가 네 몸에서 날 자식을 네 뒤에 세워 그 나라를 견고케 하리라"
      ],
      "raw_text_hashes": [
        "9a94b7696faa6f91d34558a67e4a20d2c1491bf7fe2da766fd6136a1013638d6"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:7:13",
      "sequence": 8194,
      "chapter_label": "2SA 7",
      "verse_label": "13",
      "locator": {
