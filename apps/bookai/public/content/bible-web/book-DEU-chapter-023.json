      "raw_texts": [
        "네 이웃의 곡식밭에 들어갈 때에 네가 손으로 그 이삭을 따도 가하니라 그러나 네 이웃의 곡식 밭에 낫을 대지 말찌니라"
      ],
      "raw_text_hashes": [
