      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 서원치 아니하였으면 무죄하니라 마는"
      ],
      "raw_text_hashes": [
