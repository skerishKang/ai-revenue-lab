    {
      "canonical_locator": "bible:web:DEU:23:21",
      "sequence": 5522,
      "chapter_label": "DEU 23",
      "verse_label": "21",
      "locator": {
        "book": "DEU",
        "chapter": 23,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 23,
          "verse": 21
        }
      ],
      "en": "When you vow a vow to the LORD your God, you shall not be slack to pay it, for the LORD your God will surely require it of you; and it would be sin in you.",
      "ko": "네 하나님 여호와께 서원하거든 갚기를 더디하지 말라 네 하나님 여호와께서 반드시 그것을 네게 요구하시리니 더디면 네게 죄라",
      "source_text_hash": "7d4257e21002d74949e0152bdf62c1affa676aacd5bc5f5efe6ed75523e494c1",
      "translation_text_hash": "b4c1b74cf339fdfbc39a4a9f618e90d2129f26fd40caf1e07ce430f3c2c7f4b8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께 서원하거든 갚기를 더디하지 말라 네 하나님 여호와께서 반드시 그것을 네게 요구하시리니 더디면 네게 죄라"
      ],
      "raw_text_hashes": [
