        {
          "book": "DEU",
          "chapter": 23,
          "verse": 1
        }
      ],
      "en": "He who is emasculated by crushing or cutting shall not enter into the LORD’s assembly.",
      "ko": "신낭이 상한 자나 신을 베인 자는 여호와의 총회에 들어오지 못하리라",
      "source_text_hash": "fedac6eb78c51d7fa13c39188f23defbc911240df7a5349812f58b1a8f3a890b",
      "translation_text_hash": "59f53573b52189808d9df61a6889735379dc5123d9a96b65483767d6b0183b69",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "신낭이 상한 자나 신을 베인 자는 여호와의 총회에 들어오지 못하리라"
      ],
      "raw_text_hashes": [
        "59f53573b52189808d9df61a6889735379dc5123d9a96b65483767d6b0183b69"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:23:2",
      "sequence": 5503,
      "chapter_label": "DEU 23",
      "verse_label": "2",
      "locator": {
