        "verse": 8
      },
      "raw_locator": [
        {
          "book": "GAL",
          "chapter": 5,
          "verse": 8
        }
      ],
      "en": "This persuasion is not from him who calls you.",
      "ko": "그 권면이 너희를 부르신 이에게서 난 것이 아니라",
      "source_text_hash": "5a32d5643636cc1e369e9c9b20c5e9a5a2bb78036edc93d7fec007cbd13ead2f",
      "translation_text_hash": "9fadec22cb2c9086b59c95e136fa6dc8d7e9a13f882cf3e0294ad23f9405e693",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 권면이 너희를 부르신 이에게서 난 것이 아니라"
      ],
      "raw_text_hashes": [
        "9fadec22cb2c9086b59c95e136fa6dc8d7e9a13f882cf3e0294ad23f9405e693"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:5:9",
      "sequence": 29168,
      "chapter_label": "GAL 5",
      "verse_label": "9",
      "locator": {
