        {
          "book": "GAL",
          "chapter": 5,
          "verse": 5
        }
      ],
      "en": "For we through the Spirit, by faith wait for the hope of righteousness.",
      "ko": "우리가 성령으로 믿음을 좇아 의의 소망을 기다리노니",
      "source_text_hash": "20731255247c441724096cd2186cb61550d466e77d1a080adc447a28d83176ef",
      "translation_text_hash": "44e5ffad8fc383c8915ea8e32572947c169c2bec40c724c93634b94c6b6e9354",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 성령으로 믿음을 좇아 의의 소망을 기다리노니"
      ],
      "raw_text_hashes": [
        "44e5ffad8fc383c8915ea8e32572947c169c2bec40c724c93634b94c6b6e9354"
      ]
    },
    {
      "canonical_locator": "bible:web:GAL:5:6",
      "sequence": 29165,
      "chapter_label": "GAL 5",
      "verse_label": "6",
      "locator": {
