      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 33,
          "verse": 7
        }
      ],
      "en": "Behold, their valiant ones cry outside; the ambassadors of peace weep bitterly.",
      "ko": "보라 그들의 용사가 밖에서 부르짖으며 평화의 사신들이 슬피 곡하며",
      "source_text_hash": "bc3f4c8bf18efbb9b68c8eb3a18c5802a0ef1e797d46577954101fca71ece613",
      "translation_text_hash": "22b772a007a6e079d61d6821b0451c935939723429e71d94d1f7d5b9f8b8c489",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 그들의 용사가 밖에서 부르짖으며 평화의 사신들이 슬피 곡하며"
      ],
      "raw_text_hashes": [
        "22b772a007a6e079d61d6821b0451c935939723429e71d94d1f7d5b9f8b8c489"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:33:8",
      "sequence": 18288,
      "chapter_label": "ISA 33",
      "verse_label": "8",
      "locator": {
        "book": "ISA",
