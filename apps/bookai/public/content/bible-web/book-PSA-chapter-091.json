      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 91,
          "verse": 5
        }
      ],
      "en": "You shall not be afraid of the terror by night, nor of the arrow that flies by day,",
      "ko": "너는 밤에 놀램과 낮에 흐르는 살과",
      "source_text_hash": "ae9be842c74e9d9f540e69de31659c6d9ec7d30f2273713cc6c98ac5bb895ad1",
      "translation_text_hash": "77649c19eb656b37a1238fb89745f466897665ef42979dec73028ac8956af23e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 밤에 놀램과 낮에 흐르는 살과"
      ],
      "raw_text_hashes": [
        "77649c19eb656b37a1238fb89745f466897665ef42979dec73028ac8956af23e"
      ]
    },
    {
