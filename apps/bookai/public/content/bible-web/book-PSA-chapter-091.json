      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 91,
          "verse": 15
        }
      ],
      "en": "He will call on me, and I will answer him. I will be with him in trouble. I will deliver him, and honor him.",
      "ko": "저가 내게 간구하리니 내가 응답하리라 저희 환난 때에 내가 저와 함께하여 저를 건지고 영화롭게 하리라",
      "source_text_hash": "02f3c8c02c074a56f445360c204507c384ba4c36c2a7aed36853b354c1495068",
      "translation_text_hash": "1da263904c7548a0c265bf76266525c8f5ec0fd2457b5ec4d72000bf0f302ac5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
