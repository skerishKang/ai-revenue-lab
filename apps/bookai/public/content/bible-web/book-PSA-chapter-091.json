      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 91,
          "verse": 3
        }
      ],
      "en": "For he will deliver you from the snare of the fowler, and from the deadly pestilence.",
      "ko": "이는 저가 너를 새 사냥군의 올무에서와 극한 염병에서 건지실 것임이로다",
      "source_text_hash": "6642a3d37fcbe2422eecd13cf338d3c1f55bf4c58e61a75bf8e48d0afbeccf57",
      "translation_text_hash": "67df5eba58014c777987a752896da47abaa848971ad970eab5470532a608a453",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 저가 너를 새 사냥군의 올무에서와 극한 염병에서 건지실 것임이로다"
      ],
      "raw_text_hashes": [
        "67df5eba58014c777987a752896da47abaa848971ad970eab5470532a608a453"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:91:4",
      "sequence": 15400,
