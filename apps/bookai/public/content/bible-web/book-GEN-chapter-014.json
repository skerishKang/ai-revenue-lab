      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "당시에 시날왕 아므라벨과 엘라살왕 아리옥과 엘람왕 그돌라오멜과 고임왕 디달이"
      ],
      "raw_text_hashes": [
