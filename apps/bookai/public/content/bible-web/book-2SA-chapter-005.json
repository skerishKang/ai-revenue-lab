      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 5,
          "verse": 7
        }
      ],
      "en": "Nevertheless David took the stronghold of Zion. This is David’s city.",
      "ko": "다윗이 시온 산성을 빼앗았으니 이는 다윗성이더라",
      "source_text_hash": "e975557a11cc6b179f7d00c540a72f55540c1b49ebdd2f0683d78d9ffa59ecc8",
      "translation_text_hash": "4eec68f88eca8289b2821ea76910c15125af9b686ed99d7cae8d703a8d399ea4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗이 시온 산성을 빼앗았으니 이는 다윗성이더라"
      ],
      "raw_text_hashes": [
        "4eec68f88eca8289b2821ea76910c15125af9b686ed99d7cae8d703a8d399ea4"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:5:8",
      "sequence": 8141,
      "chapter_label": "2SA 5",
      "verse_label": "8",
      "locator": {
        "book": "2SA",
        "chapter": 5,
        "verse": 8
