        {
          "book": "2SA",
          "chapter": 5,
          "verse": 10
        }
      ],
      "en": "David grew greater and greater, for the LORD, the God of Armies, was with him.",
      "ko": "만군의 하나님 여호와께서 함께 계시니 다윗이 점점 강성하여 가니라",
      "source_text_hash": "1aa8bce68923fdacf6253205b732fae111665582081b15c1d51566394be89597",
      "translation_text_hash": "b0df497c6afc7d7f07dc7e58564fa325327bb9ab1c8954daa3d9110712e20f46",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만군의 하나님 여호와께서 함께 계시니 다윗이 점점 강성하여 가니라"
      ],
      "raw_text_hashes": [
        "b0df497c6afc7d7f07dc7e58564fa325327bb9ab1c8954daa3d9110712e20f46"
      ]
