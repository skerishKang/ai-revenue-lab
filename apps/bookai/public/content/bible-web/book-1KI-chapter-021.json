      "verse_label": "21",
      "locator": {
        "book": "1KI",
        "chapter": 21,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "1KI",
          "chapter": 21,
          "verse": 21
        }
      ],
      "en": "Behold, I will bring evil on you, and will utterly sweep you away and will cut off from Ahab everyone who urinates against a wall, and him who is shut up and him who is left at large in Israel.",
      "ko": "여호와의 말씀이 내가 재앙을 네게 내려 너를 쓸어 버리되 네게 속한 남자는 이스라엘 가운데 매인 자나 놓인 자를 다 멸할 것이요",
      "source_text_hash": "9017cf145232eaba8943891ac3078726baa0638162788d0bcc76c55d58fa3025",
      "translation_text_hash": "3ea4140ee6d40d252799b42314931dd2b3e0f4423686dcdef41dc2174fa1a24a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 내가 재앙을 네게 내려 너를 쓸어 버리되 네게 속한 남자는 이스라엘 가운데 매인 자나 놓인 자를 다 멸할 것이요"
      ],
      "raw_text_hashes": [
        "3ea4140ee6d40d252799b42314931dd2b3e0f4423686dcdef41dc2174fa1a24a"
      ]
