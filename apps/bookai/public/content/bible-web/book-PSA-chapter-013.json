      "source_text_hash": "1ee0448e85ed746eded98dafc17274e6f1d076bb35a9e535609f3e5d18af751a",
      "translation_text_hash": "ea506dd893195cd4ce8a71c8ca1e345c32f2cbb9fa2288e0530d961db47040ef",
      "translation_policy": "krv-1961-source-mapped",
