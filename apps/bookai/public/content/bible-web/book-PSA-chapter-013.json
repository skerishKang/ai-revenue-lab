      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와 내 하나님이여 나를 생각하사 응답하시고 나의 눈을 밝히소서 두렵건대 내가 사망의 잠을 잘까 하오며"
      ],
      "raw_text_hashes": [
