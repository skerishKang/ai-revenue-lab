        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 25,
          "verse": 10
        }
      ],
      "en": "lest one who hears it put you to shame, and your bad reputation never depart.",
      "ko": "듣는 자가 너를 꾸짖을 터이요 또 수욕이 네게서 떠나지 아니할까 두려우니라",
      "source_text_hash": "d8ee056b7f8cd59e6bd8089ca03b22a50b1cb93459102d0ccdab8875013f7d0b",
      "translation_text_hash": "c64bc805b48d1d17aa81bca23b12e51e62f208cf0cadd5c267d6aac17d0f0ecc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "듣는 자가 너를 꾸짖을 터이요 또 수욕이 네게서 떠나지 아니할까 두려우니라"
      ],
      "raw_text_hashes": [
        "c64bc805b48d1d17aa81bca23b12e51e62f208cf0cadd5c267d6aac17d0f0ecc"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:25:11",
      "sequence": 17125,
      "chapter_label": "PRO 25",
      "verse_label": "11",
      "locator": {
        "book": "PRO",
        "chapter": 25,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 25,
          "verse": 11
        }
      ],
      "en": "A word fitly spoken is like apples of gold in settings of silver.",
      "ko": "경우에 합당한 말은 아로새긴 은쟁반에 금사과니라",
      "source_text_hash": "815f2e7f339d82e089b7d00d5d45916e50d4af6372ede613302b1b55afb68330",
      "translation_text_hash": "489cd364d59b2b86344d043bc1f46d2dec6c550e522cba654ff5f7dbd7cec213",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "경우에 합당한 말은 아로새긴 은쟁반에 금사과니라"
      ],
      "raw_text_hashes": [
        "489cd364d59b2b86344d043bc1f46d2dec6c550e522cba654ff5f7dbd7cec213"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:25:12",
      "sequence": 17126,
      "chapter_label": "PRO 25",
      "verse_label": "12",
      "locator": {
        "book": "PRO",
        "chapter": 25,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 25,
          "verse": 12
        }
      ],
      "en": "As an earring of gold, and an ornament of fine gold, so is a wise reprover to an obedient ear.",
      "ko": "슬기로운 자의 책망은 청종하는 귀에 금고리와 정금 장식이니라",
      "source_text_hash": "a7bf32ecd4c275572b1829fb5fd3fb0709ba17a6ee3af6fa2a6c8a65703edf6d",
      "translation_text_hash": "a1a89be39a1255607686d9dc6489fa1d11ecfff206485847a657a170718c25f6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "슬기로운 자의 책망은 청종하는 귀에 금고리와 정금 장식이니라"
      ],
      "raw_text_hashes": [
        "a1a89be39a1255607686d9dc6489fa1d11ecfff206485847a657a170718c25f6"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:25:13",
      "sequence": 17127,
      "chapter_label": "PRO 25",
      "verse_label": "13",
      "locator": {
        "book": "PRO",
        "chapter": 25,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 25,
          "verse": 13
        }
      ],
      "en": "As the cold of snow in the time of harvest, so is a faithful messenger to those who send him; for he refreshes the soul of his masters.",
      "ko": "충성된 사자는 그를 보낸 이에게 마치 추수하는 날에 얼음 냉수 같아서 능히 그 주인의 마음을 시원케 하느니라",
      "source_text_hash": "7991d01b71bda5477567ccd8233ba2e40aa378279b93680ffc86bd486762551a",
      "translation_text_hash": "9540b70eab0e3935bf6331284daf2f0344966b9626b8b25162e4024a99965753",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "충성된 사자는 그를 보낸 이에게 마치 추수하는 날에 얼음 냉수 같아서 능히 그 주인의 마음을 시원케 하느니라"
      ],
      "raw_text_hashes": [
        "9540b70eab0e3935bf6331284daf2f0344966b9626b8b25162e4024a99965753"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:25:14",
      "sequence": 17128,
      "chapter_label": "PRO 25",
      "verse_label": "14",
      "locator": {
        "book": "PRO",
        "chapter": 25,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 25,
          "verse": 14
        }
      ],
      "en": "As clouds and wind without rain, so is he who boasts of gifts deceptively.",
      "ko": "선물한다고 거짓 자랑하는 자는 비 없는 구름과 바람 같으니라",
      "source_text_hash": "f1ae56871249701936a6a67ef86c7a83cea40dd7a61e2ed16a73a010d915a2f3",
      "translation_text_hash": "cacf9ea3d4f9cd0dab3e7fb343a74dfcd9dd99f9c6725ec05cc1806c85f37176",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "선물한다고 거짓 자랑하는 자는 비 없는 구름과 바람 같으니라"
      ],
      "raw_text_hashes": [
        "cacf9ea3d4f9cd0dab3e7fb343a74dfcd9dd99f9c6725ec05cc1806c85f37176"
      ]
    },
    {
      "canonical_locator": "bible:web:PRO:25:15",
      "sequence": 17129,
      "chapter_label": "PRO 25",
      "verse_label": "15",
      "locator": {
        "book": "PRO",
