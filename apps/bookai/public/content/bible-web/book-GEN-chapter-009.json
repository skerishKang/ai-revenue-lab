      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 9,
          "verse": 3
        }
      ],
      "en": "Every moving thing that lives will be food for you. As I gave you the green herb, I have given everything to you.",
      "ko": "무릇 산 동물은 너희의 식물이 될찌라 채소 같이 내가 이것을 다 너희에게 주노라",
      "source_text_hash": "6c8337be5902d1abdf5ec1e224908b2c94376c05f2c72945a6f70eb149f699f5",
      "translation_text_hash": "35f88c65e49fd25eaa43ef41321a394fd120f529aa30a89e77bc67d6d1f135bd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무릇 산 동물은 너희의 식물이 될찌라 채소 같이 내가 이것을 다 너희에게 주노라"
      ],
      "raw_text_hashes": [
        "35f88c65e49fd25eaa43ef41321a394fd120f529aa30a89e77bc67d6d1f135bd"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:9:4",
      "sequence": 210,
      "chapter_label": "GEN 9",
      "verse_label": "4",
      "locator": {
