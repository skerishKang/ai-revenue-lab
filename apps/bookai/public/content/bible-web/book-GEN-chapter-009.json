      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 9,
          "verse": 14
        }
      ],
      "en": "When I bring a cloud over the earth, that the rainbow will be seen in the cloud,",
      "ko": "내가 구름으로 땅을 덮을 때에 무지개가 구름 속에 나타나면",
      "source_text_hash": "3a4d8a2f16941830295889ede8d93c533fa74eda730565ad6b45d55f8098c462",
      "translation_text_hash": "51076570628f0501029e93d0c374ec18df3abdd5cef4170d39a6c1833c95e660",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 구름으로 땅을 덮을 때에 무지개가 구름 속에 나타나면"
      ],
      "raw_text_hashes": [
        "51076570628f0501029e93d0c374ec18df3abdd5cef4170d39a6c1833c95e660"
      ]
