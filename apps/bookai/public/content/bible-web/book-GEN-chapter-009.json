        "verse": 4
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 9,
          "verse": 4
        }
      ],
      "en": "But flesh with its life, that is, its blood, you shall not eat.",
      "ko": "그러나 고기를 그 생명 되는 피채 먹지 말것이니라",
      "source_text_hash": "b0c062c1512ebba24e294f879f877a885c152a5e64a28edfc9ada6e41c1c92fa",
      "translation_text_hash": "ad22736639ddbde1c934e323c762e01fa74f25becb9e86e4705a29bfbf5e0f22",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 고기를 그 생명 되는 피채 먹지 말것이니라"
      ],
      "raw_text_hashes": [
        "ad22736639ddbde1c934e323c762e01fa74f25becb9e86e4705a29bfbf5e0f22"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:9:5",
      "sequence": 211,
      "chapter_label": "GEN 9",
      "verse_label": "5",
      "locator": {
        "book": "GEN",
