      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 9,
          "verse": 7
        }
      ],
      "en": "Be fruitful and multiply. Increase abundantly on the earth, and multiply in it.”",
      "ko": "너희는 생육하고 번성하며 땅에 편만하여 그 중에서 번성하라 하셨더라",
      "source_text_hash": "41be126f57c5acebf136bc6cddad1130e116f716242c961a6e389de769867037",
      "translation_text_hash": "7de178b0df5d7ef064d0738a3670bb38b3ed63447eb402aa5b7a4904e560a594",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 생육하고 번성하며 땅에 편만하여 그 중에서 번성하라 하셨더라"
      ],
      "raw_text_hashes": [
        "7de178b0df5d7ef064d0738a3670bb38b3ed63447eb402aa5b7a4904e560a594"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:9:8",
      "sequence": 214,
