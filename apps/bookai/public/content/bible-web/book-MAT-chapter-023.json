      "translation_text_hash": "984a916cbd3b01a24f38d090e77bfdd4be4f4009af2f5fe32636b525012db30f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
