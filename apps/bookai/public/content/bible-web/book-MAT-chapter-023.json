      "ko": "잔치의 상석과 회당의 상좌와",
      "source_text_hash": "964e772fc0f7f76829a7e56a5d1e7fc8944feaa5753ea09d91100a5e55f20c47",
      "translation_text_hash": "e4aa60d0b8e0cc30d09d9e360a95d20fcdea80757f6eef78b3acfff130b51c23",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
