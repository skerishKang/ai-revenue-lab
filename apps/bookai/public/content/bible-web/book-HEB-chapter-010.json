        "verse": 3
      },
      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 10,
          "verse": 3
        }
      ],
      "en": "But in those sacrifices there is a yearly reminder of sins.",
      "ko": "그러나 이 제사들은 해마다 죄를 생각하게 하는 것이 있나니",
      "source_text_hash": "e40d720ef6cf716424578afbedfd0df37d14323e4995c75566fd26d83bfe2a02",
      "translation_text_hash": "2d560a2c44008a0d8f1aeb4130d3dcc59d606cf2145d530f39186c85f4221983",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 이 제사들은 해마다 죄를 생각하게 하는 것이 있나니"
      ],
      "raw_text_hashes": [
        "2d560a2c44008a0d8f1aeb4130d3dcc59d606cf2145d530f39186c85f4221983"
      ]
    },
    {
      "canonical_locator": "bible:web:HEB:10:4",
      "sequence": 30134,
      "chapter_label": "HEB 10",
      "verse_label": "4",
      "locator": {
