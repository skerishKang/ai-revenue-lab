        "verse": 4
      },
      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 10,
          "verse": 4
        }
      ],
      "en": "For it is impossible that the blood of bulls and goats should take away sins.",
      "ko": "이는 황소와 염소의 피가 능히 죄를 없이 하지 못함이라",
      "source_text_hash": "fcfa28514db0c281c56372c43b89745b10dd500359d498a29fa5f4d59b7fcc0e",
      "translation_text_hash": "80fdace003c54295fbcfd0c14026389539aed4503b51a8d351d49fa53b2a80a2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 황소와 염소의 피가 능히 죄를 없이 하지 못함이라"
      ],
      "raw_text_hashes": [
        "80fdace003c54295fbcfd0c14026389539aed4503b51a8d351d49fa53b2a80a2"
      ]
    },
    {
      "canonical_locator": "bible:web:HEB:10:5",
      "sequence": 30135,
      "chapter_label": "HEB 10",
      "verse_label": "5",
      "locator": {
        "book": "HEB",
        "chapter": 10,
        "verse": 5
