        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HEB",
          "chapter": 10,
          "verse": 6
        }
      ],
      "en": "You had no pleasure in whole burnt offerings and sacrifices for sin.",
      "ko": "전체로 번제함과 속죄제는 기뻐하지 아니하시나니",
      "source_text_hash": "72cd7c931aa7441085b198403acf0a6da46ee7bc5d79aa358d8dbac58230989d",
      "translation_text_hash": "0f760e85d6b5427b303237c3c7127a1468ad23092ea188a6da9d0861d661cc57",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "전체로 번제함과 속죄제는 기뻐하지 아니하시나니"
      ],
      "raw_text_hashes": [
        "0f760e85d6b5427b303237c3c7127a1468ad23092ea188a6da9d0861d661cc57"
      ]
    },
    {
      "canonical_locator": "bible:web:HEB:10:7",
      "sequence": 30137,
      "chapter_label": "HEB 10",
      "verse_label": "7",
      "locator": {
