      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 항상 내 하나님께 감사하고 기도할 때에 너를 말함은"
      ],
      "raw_text_hashes": [
        "5c686677790b5db1140ff1cbdcc229da8c81777514ca38a2643433459c6e41c6"
      ]
    },
