      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 또 내게 임하여 가라사대"
      ],
      "raw_text_hashes": [
        "d80f64c74466735890f0e38292da375b0a0ec48e42ba77cef849f80e52a6bc56"
