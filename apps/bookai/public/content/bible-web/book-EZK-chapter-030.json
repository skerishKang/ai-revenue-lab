      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아웬과 비베셋의 소년들은 칼에 엎드러질 것이며 그 성읍 거민들은 포로 될 것이라"
      ],
      "raw_text_hashes": [
