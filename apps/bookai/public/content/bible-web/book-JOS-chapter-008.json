    },
    {
      "canonical_locator": "bible:web:JOS:8:21",
      "sequence": 6024,
      "chapter_label": "JOS 8",
      "verse_label": "21",
      "locator": {
        "book": "JOS",
        "chapter": 8,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 8,
          "verse": 21
        }
      ],
      "en": "When Joshua and all Israel saw that the ambush had taken the city, and that the smoke of the city ascended, then they turned back and killed the men of Ai.",
      "ko": "여호수아와 온 이스라엘이 그 복병이 성읍을 점령함과 성읍에 연기가 오름을 보고 다시 돌이켜 아이 사람을 죽이고",
      "source_text_hash": "27879adce84dcf923328395d157a6168d5fe84a179cb7c9a77eee2eedb71815b",
      "translation_text_hash": "ad6f150fa770a73df31efae6726e9bff180e87e6a44a7439f73122123d93abfe",
      "translation_policy": "krv-1961-source-mapped",
