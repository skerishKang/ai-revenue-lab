        "verse": 23
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 8,
          "verse": 23
        }
      ],
      "en": "They captured the king of Ai alive, and brought him to Joshua.",
      "ko": "아이 왕을 사로잡아 여호수아 앞으로 끌어 왔더라",
      "source_text_hash": "ed9b950a428d9e4d895669d3fcede9ac37613bfda3cef8def4259b491ee12cf8",
      "translation_text_hash": "36180ba42a2602506475ee8fab14faa5cf56960e2a3d28225267655a9234d3d7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아이 왕을 사로잡아 여호수아 앞으로 끌어 왔더라"
      ],
      "raw_text_hashes": [
        "36180ba42a2602506475ee8fab14faa5cf56960e2a3d28225267655a9234d3d7"
      ]
    },
    {
      "canonical_locator": "bible:web:JOS:8:24",
      "sequence": 6027,
      "chapter_label": "JOS 8",
      "verse_label": "24",
      "locator": {
        "book": "JOS",
        "chapter": 8,
        "verse": 24
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 8,
          "verse": 24
        }
      ],
      "en": "When Israel had finished killing all the inhabitants of Ai in the field, in the wilderness in which they pursued them, and they had all fallen by the edge of the sword until they were consumed, all Israel returned to Ai and struck it with the edge of the sword.",
      "ko": "이스라엘이 자기를 광야로 따르던 아이 모든 거민을 들에서 죽이되 그들을 다 칼날에 엎드러지게 하여 진멸하기를 마치고 온 이스라엘이 아이로 돌아와서 칼날로 죽이매",
      "source_text_hash": "862bb2e91a4a1d1b65d5e2afa2f168b3701aa1338b3b1a2099739ead001f7274",
      "translation_text_hash": "fa4249588288582504b60d1c7d0ba0df9535cea3bc3fd7fac8ceeca4e6466eb2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘이 자기를 광야로 따르던 아이 모든 거민을 들에서 죽이되 그들을 다 칼날에 엎드러지게 하여 진멸하기를 마치고 온 이스라엘이 아이로 돌아와서 칼날로 죽이매"
      ],
      "raw_text_hashes": [
