      ]
    },
    {
      "canonical_locator": "bible:web:JOS:8:25",
      "sequence": 6028,
      "chapter_label": "JOS 8",
      "verse_label": "25",
      "locator": {
        "book": "JOS",
        "chapter": 8,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 8,
          "verse": 25
        }
      ],
      "en": "All that fell that day, both of men and women, were twelve thousand, even all the people of Ai.",
      "ko": "그 날에 아이 사람의 전부가 죽었으니 남녀가 일만 이천이라",
      "source_text_hash": "9ad760cd880f329f734980069dc42dd3757f038b65c3bf936c90fdceaccbcdb3",
      "translation_text_hash": "5206b5ac7603955fb71b3ebaf7296b15ee1bda0d2225e11d4f8e6417345cf354",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 날에 아이 사람의 전부가 죽었으니 남녀가 일만 이천이라"
      ],
      "raw_text_hashes": [
        "5206b5ac7603955fb71b3ebaf7296b15ee1bda0d2225e11d4f8e6417345cf354"
      ]
    },
    {
      "canonical_locator": "bible:web:JOS:8:26",
      "sequence": 6029,
      "chapter_label": "JOS 8",
      "verse_label": "26",
      "locator": {
        "book": "JOS",
        "chapter": 8,
        "verse": 26
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 8,
          "verse": 26
        }
      ],
      "en": "For Joshua didn’t draw back his hand, with which he stretched out the javelin, until he had utterly destroyed all the inhabitants of Ai.",
      "ko": "아이 거민을 진멸하기까지 여호수아가 단창을 잡아 든 손을 거두지 아니하였고",
      "source_text_hash": "90ea081c6b9f1ee318c6e98e97381bdc3b111cdb7e254285b35d49a18e65c40c",
      "translation_text_hash": "0802884fd7f8bdb9e437f168ddded4b2828d31d7246124587cd1ee759f0402f2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아이 거민을 진멸하기까지 여호수아가 단창을 잡아 든 손을 거두지 아니하였고"
      ],
      "raw_text_hashes": [
        "0802884fd7f8bdb9e437f168ddded4b2828d31d7246124587cd1ee759f0402f2"
