    {
      "canonical_locator": "bible:web:JOS:8:22",
      "sequence": 6025,
      "chapter_label": "JOS 8",
      "verse_label": "22",
      "locator": {
        "book": "JOS",
        "chapter": 8,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "JOS",
          "chapter": 8,
          "verse": 22
        }
      ],
      "en": "The others came out of the city against them, so they were in the middle of Israel, some on this side, and some on that side. They struck them, so that they let none of them remain or escape.",
      "ko": "복병도 성읍에서 나와 그들을 치매 그들이 이스라엘 중간에 든지라 혹은 이편에서 혹은 저편에서 쳐 죽여서 한 사람도 남거나 도망하지 못하게 하였고",
      "source_text_hash": "f2398c06dbd458fb8fe84f715b005d4ff6f2bcdcee743e40c00af2bdc4af95cf",
      "translation_text_hash": "1ed994310807cf22b85e316c2ded9230c0402658da272d22ed7fa0a58d83f34b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "복병도 성읍에서 나와 그들을 치매 그들이 이스라엘 중간에 든지라 혹은 이편에서 혹은 저편에서 쳐 죽여서 한 사람도 남거나 도망하지 못하게 하였고"
      ],
      "raw_text_hashes": [
        "1ed994310807cf22b85e316c2ded9230c0402658da272d22ed7fa0a58d83f34b"
