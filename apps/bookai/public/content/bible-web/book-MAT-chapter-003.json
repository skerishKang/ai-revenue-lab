      "translation_text_hash": "886b50867213489e7a613db07d4395e8e404ac85f270f9547981044a3f3d1e76",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 때에 세례 요한이 이르러 유대 광야에서 전파하여 가로되"
      ],
      "raw_text_hashes": [
        "886b50867213489e7a613db07d4395e8e404ac85f270f9547981044a3f3d1e76"
      ]
    },
