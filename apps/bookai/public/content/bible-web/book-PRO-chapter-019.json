      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "재물은 많은 친구를 더하게 하나 가난한즉 친구가 끊어지느니라"
      ],
      "raw_text_hashes": [
        "b7e284b0aae8b00aaf83645d604646e4a300a525c31a72db6d4007bbfd2d52cc"
      ]
    },
    {
