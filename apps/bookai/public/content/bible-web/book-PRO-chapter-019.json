      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "지식 없는 소원은 선치 못하고 발이 급한 사람은 그릇하느니라"
      ],
      "raw_text_hashes": [
        "55bb00523ee2117d95b53154d73067cda401c94cd9c486385a2e2e70b3a90391"
      ]
    },
