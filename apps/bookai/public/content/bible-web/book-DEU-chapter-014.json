        "verse": 4
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 14,
          "verse": 4
        }
      ],
      "en": "These are the animals which you may eat: the ox, the sheep, the goat,",
      "ko": "너희의 먹을만한 짐승은 이러하니 곧 소와 양과 염소와",
      "source_text_hash": "92e535c895217f1ac74b1f34b0514dbc75acb3f17807fd4a4663b3d02c27e028",
      "translation_text_hash": "032f20162bceb5694f4a56f00eff75dd9945f721f8a26ee479be85eb59ef4e8d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희의 먹을만한 짐승은 이러하니 곧 소와 양과 염소와"
      ],
      "raw_text_hashes": [
        "032f20162bceb5694f4a56f00eff75dd9945f721f8a26ee479be85eb59ef4e8d"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:14:5",
      "sequence": 5296,
      "chapter_label": "DEU 14",
      "verse_label": "5",
      "locator": {
        "book": "DEU",
