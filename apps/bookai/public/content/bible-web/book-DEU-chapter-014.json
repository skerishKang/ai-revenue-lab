    {
      "canonical_locator": "bible:web:DEU:14:21",
      "sequence": 5312,
      "chapter_label": "DEU 14",
      "verse_label": "21",
      "locator": {
        "book": "DEU",
        "chapter": 14,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 14,
          "verse": 21
        }
      ],
      "en": "You shall not eat of anything that dies of itself. You may give it to the foreigner living among you who is within your gates, that he may eat it; or you may sell it to a foreigner; for you are a holy people to the LORD your God. You shall not boil a young goat in its mother’s milk.",
      "ko": "너희는 너희 하나님 여호와의 성민이라 무릇 스스로 죽은 것은 먹지 말 것이니 그것을 성중에 우거하는 객에게 주어 먹게 하거나 이방인에게 팔아도 가하니라 너는 염소 새끼를 그 어미의 젖에 삶지 말찌니라",
      "source_text_hash": "93f973479fee85fb6a46c11df5e308d962d356d2c5eaf39cbc09ec0e2ca1c0f9",
      "translation_text_hash": "be33765e6934e55a117f53d8cac30d2c1323d1dd4c44c073a53e0ff843222b73",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 너희 하나님 여호와의 성민이라 무릇 스스로 죽은 것은 먹지 말 것이니 그것을 성중에 우거하는 객에게 주어 먹게 하거나 이방인에게 팔아도 가하니라 너는 염소 새끼를 그 어미의 젖에 삶지 말찌니라"
      ],
      "raw_text_hashes": [
        "be33765e6934e55a117f53d8cac30d2c1323d1dd4c44c073a53e0ff843222b73"
      ]
