      "raw_texts": [
        "너는 마땅히 매년에 토지 소산의 십일조를 드릴것이며"
      ],
      "raw_text_hashes": [
        "2af93f285e6351797d2e0657c3d62d227c2eecb8d524fb5199a16e0aefa6fa52"
