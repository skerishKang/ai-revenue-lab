        "verse": 3
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 14,
          "verse": 3
        }
      ],
      "en": "You shall not eat any abominable thing.",
      "ko": "너는 가증한 물건은 무엇이든지 먹지 말라",
      "source_text_hash": "58c088c3da668ff6d140bb54d4d7b60535e43481181569e247143cf17fd7694c",
      "translation_text_hash": "ee64724b956bca471e171447caf4c9e5e506599f1e87585a7b05e68b43eb8f2a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 가증한 물건은 무엇이든지 먹지 말라"
      ],
      "raw_text_hashes": [
        "ee64724b956bca471e171447caf4c9e5e506599f1e87585a7b05e68b43eb8f2a"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:14:4",
      "sequence": 5295,
      "chapter_label": "DEU 14",
      "verse_label": "4",
      "locator": {
