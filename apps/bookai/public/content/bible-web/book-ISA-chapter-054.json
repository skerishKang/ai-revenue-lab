        }
      ],
      "en": "“For a small moment I have forsaken you, but I will gather you with great mercies.",
      "ko": "내가 잠시 너를 버렸으나 큰 긍휼로 너를 모을 것이요",
      "source_text_hash": "23c220bb34d6c5fd2561928c69a48cdc4f2fe9e6d6dd172705fef839f431ae9d",
      "translation_text_hash": "d93e0941c10e8f2d66c409e5cc039cc18f0d05ce0bb17a6b7dce4a9df69de129",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 잠시 너를 버렸으나 큰 긍휼로 너를 모을 것이요"
      ],
      "raw_text_hashes": [
        "d93e0941c10e8f2d66c409e5cc039cc18f0d05ce0bb17a6b7dce4a9df69de129"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:54:8",
      "sequence": 18732,
