      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 54,
          "verse": 8
        }
      ],
      "en": "In overflowing wrath I hid my face from you for a moment, but with everlasting loving kindness I will have mercy on you,” says the LORD your Redeemer.",
      "ko": "내가 넘치는 진노로 내 얼굴을 네게서 잠시 가리웠으나 영원한 자비로 너를 긍휼히 여기리라 네 구속자 여호와의 말이니라",
      "source_text_hash": "0e0dd7d7a62348853da1eb2ff8cc07dd7dc1bf216ba4328afb33fee3cab1aed6",
      "translation_text_hash": "eccb77823d87c8825d7c99193ab5bbb4c282765cd5b27bd2aa11909b2dc10e72",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 넘치는 진노로 내 얼굴을 네게서 잠시 가리웠으나 영원한 자비로 너를 긍휼히 여기리라 네 구속자 여호와의 말이니라"
      ],
      "raw_text_hashes": [
