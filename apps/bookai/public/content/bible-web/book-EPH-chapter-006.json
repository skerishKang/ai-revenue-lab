        {
          "book": "EPH",
          "chapter": 6,
          "verse": 2
        }
      ],
      "en": "“Honor your father and mother,” which is the first commandment with a promise:",
      "ko": "네 아버지와 어머니를 공경하라 이것이 약속 있는 첫계명이니",
      "source_text_hash": "adfb3806ec1bc92e0a504609e77d1153cb399f9d1efcf12a637aabc9624a84a9",
      "translation_text_hash": "64b3dbf328c97d2fd94d24499ac25839e4e9a8dd7e231ed02a58d9e66c90b313",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 아버지와 어머니를 공경하라 이것이 약속 있는 첫계명이니"
      ],
      "raw_text_hashes": [
        "64b3dbf328c97d2fd94d24499ac25839e4e9a8dd7e231ed02a58d9e66c90b313"
      ]
    },
