      "raw_locator": [
        {
          "book": "EPH",
          "chapter": 6,
          "verse": 7
        }
      ],
      "en": "with good will doing service as to the Lord and not to men,",
      "ko": "단 마음으로 섬기기를 주께 하듯하고 사람들에게 하듯하지 말라",
      "source_text_hash": "dbff10c8b8498f3ad433905b7f77b267eb19d87aba7d92e650b9d9e79d32c20c",
      "translation_text_hash": "3ed57ecfb51a60384d158b97707f756a93fcc8b0b2e26b4408050a4562337b72",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "단 마음으로 섬기기를 주께 하듯하고 사람들에게 하듯하지 말라"
      ],
      "raw_text_hashes": [
        "3ed57ecfb51a60384d158b97707f756a93fcc8b0b2e26b4408050a4562337b72"
      ]
    },
    {
      "canonical_locator": "bible:web:EPH:6:8",
      "sequence": 29342,
      "chapter_label": "EPH 6",
      "verse_label": "8",
      "locator": {
        "book": "EPH",
