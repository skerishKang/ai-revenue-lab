          "book": "EPH",
          "chapter": 6,
          "verse": 3
        }
      ],
      "en": "“that it may be well with you, and you may live long on the earth.”",
      "ko": "이는 네가 잘 되고 땅에서 장수하리라",
      "source_text_hash": "81f157f402744be22e05f13f7eb32322c5d127f2a861c10f54b45e190fcaf806",
      "translation_text_hash": "26da0ea86b069dcd6d6efd5f748e7750247740c46e7727959301278d6347fd81",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 네가 잘 되고 땅에서 장수하리라"
      ],
      "raw_text_hashes": [
        "26da0ea86b069dcd6d6efd5f748e7750247740c46e7727959301278d6347fd81"
      ]
    },
    {
