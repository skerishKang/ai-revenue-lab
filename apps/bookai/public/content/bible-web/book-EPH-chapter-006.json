        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EPH",
          "chapter": 6,
          "verse": 8
        }
      ],
      "en": "knowing that whatever good thing each one does, he will receive the same good again from the Lord, whether he is bound or free.",
      "ko": "이는 각 사람이 무슨 선을 행하든지 종이나 자유하는 자나 주에게 그대로 받을 줄을 앎이니라",
      "source_text_hash": "4846e0f17ac5a8ae6c41dc6cc058f59f6843367c2606f95dd94d891f61f0ff2b",
      "translation_text_hash": "ab6404df3d61bde61e478302d589d33754c856cd1958683bcc4ea472b8397541",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 각 사람이 무슨 선을 행하든지 종이나 자유하는 자나 주에게 그대로 받을 줄을 앎이니라"
      ],
      "raw_text_hashes": [
        "ab6404df3d61bde61e478302d589d33754c856cd1958683bcc4ea472b8397541"
      ]
    },
    {
      "canonical_locator": "bible:web:EPH:6:9",
      "sequence": 29343,
      "chapter_label": "EPH 6",
      "verse_label": "9",
      "locator": {
        "book": "EPH",
        "chapter": 6,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EPH",
          "chapter": 6,
          "verse": 9
        }
      ],
      "en": "You masters, do the same things to them, and give up threatening, knowing that he who is both their Master and yours is in heaven, and there is no partiality with him.",
      "ko": "상전들아 너희도 저희에게 이와 같이 하고 공갈을 그치라 이는 저희와 너희의 상전이 하늘에 계시고 그에게는 외모로 사람을 취하는 일이 없는줄 너희가 앎이니라",
      "source_text_hash": "b50737ce7fccac95fb592a90f1c42e0a492724d7bb6404034b97e3845c0b83dd",
      "translation_text_hash": "8eb725157e1c93d7811e9c5f9562bcde87ffcdb097fb265cc29f4ad9a39ad584",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "상전들아 너희도 저희에게 이와 같이 하고 공갈을 그치라 이는 저희와 너희의 상전이 하늘에 계시고 그에게는 외모로 사람을 취하는 일이 없는줄 너희가 앎이니라"
      ],
      "raw_text_hashes": [
        "8eb725157e1c93d7811e9c5f9562bcde87ffcdb097fb265cc29f4ad9a39ad584"
      ]
    },
    {
      "canonical_locator": "bible:web:EPH:6:10",
      "sequence": 29344,
      "chapter_label": "EPH 6",
