      "raw_text_hashes": [
        "2fcb54244475e91bef0fbc3c3374d04d74406d7f7556cf1f7a2dd6aaa6668237"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:22:18",
      "sequence": 20995,
      "chapter_label": "EZK 22",
      "verse_label": "18",
      "locator": {
        "book": "EZK",
        "chapter": 22,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 22,
          "verse": 18
        }
      ],
      "en": "“Son of man, the house of Israel has become dross to me. All of them are bronze, tin, iron, and lead in the middle of the furnace. They are the dross of silver.",
      "ko": "인자야 이스라엘 족속이 내게 찌끼가 되었나니 곧 풀무 가운데 있는 놋이나 상납이나 철이나 납이며 은의 찌끼로다",
      "source_text_hash": "03ba16dfc9a7588483c24b5b7322a8f5d4a735bf98d4172b90ac316e45fd39df",
      "translation_text_hash": "72b40b8134ef07bb01b20d730ca8a61a5c1eff421994a07b1c1316a26ebcaa2c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "인자야 이스라엘 족속이 내게 찌끼가 되었나니 곧 풀무 가운데 있는 놋이나 상납이나 철이나 납이며 은의 찌끼로다"
      ],
      "raw_text_hashes": [
        "72b40b8134ef07bb01b20d730ca8a61a5c1eff421994a07b1c1316a26ebcaa2c"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:22:19",
      "sequence": 20996,
      "chapter_label": "EZK 22",
      "verse_label": "19",
      "locator": {
        "book": "EZK",
        "chapter": 22,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 22,
          "verse": 19
        }
      ],
      "en": "Therefore the Lord GOD says: ‘Because you have all become dross, therefore, behold, I will gather you into the middle of Jerusalem.",
      "ko": "그러므로 나 주 여호와가 말하노라 너희가 다 찌끼가 되었은즉 내가 너희를 예루살렘 가운데로 모으고",
      "source_text_hash": "17d46ac5bd5e86b4407b39cd8f55836a94a97ec50c2eb9fe6461b5a5e91cce4a",
      "translation_text_hash": "822e54a227dc1b90d2cd92e7d048bf2d282121f9e1180658e72fe9135ee31e71",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 나 주 여호와가 말하노라 너희가 다 찌끼가 되었은즉 내가 너희를 예루살렘 가운데로 모으고"
      ],
      "raw_text_hashes": [
        "822e54a227dc1b90d2cd92e7d048bf2d282121f9e1180658e72fe9135ee31e71"
      ]
