      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 22,
          "verse": 14
        }
      ],
      "en": "Can your heart endure, or can your hands be strong, in the days that I will deal with you? I, the LORD, have spoken it, and will do it.",
      "ko": "내가 네게 보응하는 날에 네 마음이 견디겠느냐 네 손이 힘이 있겠느냐 나 여호와가 말하였으니 이룰찌라",
      "source_text_hash": "c896ec8abefd1d0d3c65064ae4df5c6a93b605eede70f4c33f114274081b8676",
      "translation_text_hash": "913239d91035cc1f31b9f812cf302be6cc644d8f3d6973920b775c6a8a14612b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 네게 보응하는 날에 네 마음이 견디겠느냐 네 손이 힘이 있겠느냐 나 여호와가 말하였으니 이룰찌라"
      ],
      "raw_text_hashes": [
        "913239d91035cc1f31b9f812cf302be6cc644d8f3d6973920b775c6a8a14612b"
      ]
