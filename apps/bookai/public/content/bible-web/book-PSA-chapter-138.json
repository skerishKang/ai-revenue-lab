        "verse": 5
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 138,
          "verse": 5
        }
      ],
      "en": "Yes, they will sing of the ways of the LORD, for the LORD’s glory is great!",
      "ko": "저희가 여호와의 도를 노래할 것은 여호와의 영광이 크심이니이다",
      "source_text_hash": "38282adf69dccf0fa026e972191341cf66eb04614e569c8e8cc5a57555c382d8",
      "translation_text_hash": "142928d33b4d911eab92c890c17a1e3304909be30a4556767bd8a07edfaf23cf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 여호와의 도를 노래할 것은 여호와의 영광이 크심이니이다"
      ],
      "raw_text_hashes": [
        "142928d33b4d911eab92c890c17a1e3304909be30a4556767bd8a07edfaf23cf"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:138:6",
      "sequence": 16238,
      "chapter_label": "PSA 138",
      "verse_label": "6",
      "locator": {
