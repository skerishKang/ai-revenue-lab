      ],
      "en": "I will give you thanks with my whole heart. Before the gods, I will sing praises to you.",
      "ko": "내가 전심으로 주께 감사하며 신들 앞에서 주께 찬양하리이다",
      "source_text_hash": "7551154b61c6da611cfc589504e5d9c9de6b89c6037cfef3d048a74028d352c7",
      "translation_text_hash": "0139c7b4a73425c40594f43fdcd2a7023b4b4d70acfe7a352e7c96ef00ca15ae",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 전심으로 주께 감사하며 신들 앞에서 주께 찬양하리이다"
      ],
      "raw_text_hashes": [
        "0139c7b4a73425c40594f43fdcd2a7023b4b4d70acfe7a352e7c96ef00ca15ae"
      ]
    },
