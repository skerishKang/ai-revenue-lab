  "passages": [
    {
      "canonical_locator": "bible:web:EXO:22:1",
      "sequence": 2115,
      "chapter_label": "EXO 22",
      "verse_label": "1",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 1
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 1
        }
      ],
      "en": "“If a man steals an ox or a sheep, and kills it or sells it, he shall pay five oxen for an ox, and four sheep for a sheep.",
      "ko": "사람이 소나 양을 도적질하여 잡거나 팔면 그는 소 하나에 소 다섯으로 갚고 양 하나에 양 넷으로 갚을찌니라",
      "source_text_hash": "60fb4fad2d41dedadc17c5a2ffa0d870f30cb2de11b7751af4eaa42fccd1a06c",
      "translation_text_hash": "13aa857da25acfedebeac32cc24203c1c9d6a28c593767f54999245e2cc78c2c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 소나 양을 도적질하여 잡거나 팔면 그는 소 하나에 소 다섯으로 갚고 양 하나에 양 넷으로 갚을찌니라"
      ],
      "raw_text_hashes": [
        "13aa857da25acfedebeac32cc24203c1c9d6a28c593767f54999245e2cc78c2c"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:2",
      "sequence": 2116,
      "chapter_label": "EXO 22",
      "verse_label": "2",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 2
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 2
        }
      ],
      "en": "If the thief is found breaking in, and is struck so that he dies, there shall be no guilt of bloodshed for him.",
      "ko": "도적이 뚫고 들어옴을 보고 그를 쳐 죽이면 피 흘린 죄가 없으나",
      "source_text_hash": "f370d00fcfe4afbdcc04944051d11d769c5963279a1e5bd8c6ccdcd13f09c24a",
      "translation_text_hash": "57affd192eb3220a73797efa58c06ac23f7225a8dbe71fe236acdd8b2a9ffbe2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "도적이 뚫고 들어옴을 보고 그를 쳐 죽이면 피 흘린 죄가 없으나"
      ],
      "raw_text_hashes": [
        "57affd192eb3220a73797efa58c06ac23f7225a8dbe71fe236acdd8b2a9ffbe2"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:3",
      "sequence": 2117,
      "chapter_label": "EXO 22",
      "verse_label": "3",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 3
        }
      ],
      "en": "If the sun has risen on him, he is guilty of bloodshed. He shall make restitution. If he has nothing, then he shall be sold for his theft.",
      "ko": "해 돋은 후이면 피 흘린 죄가 있으리라 도적은 반드시 배상할 것이나 배상할 것이 없으면 그 몸을 팔아 그 도적질한 것을 배상할 것이요",
      "source_text_hash": "fda6d00de43722221eaeeceef1335fc04d3826c3f60ae5da756a3b91e057fe63",
      "translation_text_hash": "a1596aff2fa98aa7f2ca2c3c3a5593df73a49b542d3ead5e210fd57201b100f1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "해 돋은 후이면 피 흘린 죄가 있으리라 도적은 반드시 배상할 것이나 배상할 것이 없으면 그 몸을 팔아 그 도적질한 것을 배상할 것이요"
      ],
      "raw_text_hashes": [
        "a1596aff2fa98aa7f2ca2c3c3a5593df73a49b542d3ead5e210fd57201b100f1"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:4",
      "sequence": 2118,
      "chapter_label": "EXO 22",
      "verse_label": "4",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 4
        }
      ],
      "en": "If the stolen property is found in his hand alive, whether it is ox, donkey, or sheep, he shall pay double.",
      "ko": "도적질한 것이 살아 그 손에 있으면 소나 나귀나 양을 무론하고 갑절을 배상할찌니라",
      "source_text_hash": "cd8e923fd3b27f75454bce6aa43be6fa4e764bfc972eb51ac0a9bd88009a441c",
      "translation_text_hash": "6a403749f60be0dacb5f0a3c91478ce6e2570138c5d01782f1d979709f9f6bed",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "도적질한 것이 살아 그 손에 있으면 소나 나귀나 양을 무론하고 갑절을 배상할찌니라"
      ],
      "raw_text_hashes": [
        "6a403749f60be0dacb5f0a3c91478ce6e2570138c5d01782f1d979709f9f6bed"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:5",
      "sequence": 2119,
      "chapter_label": "EXO 22",
      "verse_label": "5",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 5
        }
      ],
      "en": "“If a man causes a field or vineyard to be eaten by letting his animal loose, and it grazes in another man’s field, he shall make restitution from the best of his own field, and from the best of his own vineyard.",
      "ko": "사람이 밭에서나 포도원에서 먹이다가 그 짐승을 놓아서 남의 밭에서 먹게 하면 자기 밭의 제일 좋은 것과 자기 포도원의 제일 좋은 것으로 배상할찌니라",
      "source_text_hash": "ac5062d0943f3fbd2a09d02bc3841f343dee1f3c733d310833af75bf671fb28b",
      "translation_text_hash": "130724fe241bd09e1aad551c386ce2ef4b11eea7d9409f6dc5a8f108b2f6bd6d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 밭에서나 포도원에서 먹이다가 그 짐승을 놓아서 남의 밭에서 먹게 하면 자기 밭의 제일 좋은 것과 자기 포도원의 제일 좋은 것으로 배상할찌니라"
      ],
      "raw_text_hashes": [
        "130724fe241bd09e1aad551c386ce2ef4b11eea7d9409f6dc5a8f108b2f6bd6d"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:6",
      "sequence": 2120,
      "chapter_label": "EXO 22",
      "verse_label": "6",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 6
        }
      ],
      "en": "“If fire breaks out, and catches in thorns so that the shocks of grain, or the standing grain, or the field are consumed; he who kindled the fire shall surely make restitution.",
      "ko": "불이 나서 가시나무에 미쳐 낟가리나 거두지 못한 곡식이나 전원을 태우면 불 놓은 자가 반드시 배상할찌니라",
      "source_text_hash": "3acb740894805d44ecb4a0b7a2c8381d2dbde11e19d07fa55406a68965b33e64",
      "translation_text_hash": "a02b8922ec9b33fe405e7be201a135db59ccccff0d9ca1d54a031e531b324e35",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "불이 나서 가시나무에 미쳐 낟가리나 거두지 못한 곡식이나 전원을 태우면 불 놓은 자가 반드시 배상할찌니라"
      ],
      "raw_text_hashes": [
        "a02b8922ec9b33fe405e7be201a135db59ccccff0d9ca1d54a031e531b324e35"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:7",
      "sequence": 2121,
      "chapter_label": "EXO 22",
      "verse_label": "7",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 7
        }
      ],
      "en": "“If a man delivers to his neighbor money or stuff to keep, and it is stolen out of the man’s house, if the thief is found, he shall pay double.",
      "ko": "사람이 돈이나 물품을 이웃에게 맡겨 지키게 하였다가 그 이웃의 집에서 봉적하였는데 그 도적이 잡히면 갑절을 배상할 것이요",
      "source_text_hash": "64a6f2d9e99486185d9dad23bf4704e3307bd82911d3690f60d9fc7ae8d06465",
      "translation_text_hash": "73bfc798da7f268cbe5cc5e4d036bb821d53465c380c7cd6c2416d0c7c334945",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 돈이나 물품을 이웃에게 맡겨 지키게 하였다가 그 이웃의 집에서 봉적하였는데 그 도적이 잡히면 갑절을 배상할 것이요"
      ],
      "raw_text_hashes": [
        "73bfc798da7f268cbe5cc5e4d036bb821d53465c380c7cd6c2416d0c7c334945"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:8",
      "sequence": 2122,
      "chapter_label": "EXO 22",
      "verse_label": "8",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 8
        }
      ],
      "en": "If the thief isn’t found, then the master of the house shall come near to God, to find out whether or not he has put his hand on his neighbor’s goods.",
      "ko": "도적이 잡히지 아니하면 그 집 주인이 재판장 앞에 가서 자기가 그 이웃의 물품에 손 댄 여부의 조사를 받을 것이며",
      "source_text_hash": "aa9e4171bb491ce8fac525f27646f3f6e8b16fb732e25ddff3eef7b07def2cac",
      "translation_text_hash": "121638adc5f691aa5d991e41ddd55f179b4be468c08a1a9f6c10adfd60020444",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "도적이 잡히지 아니하면 그 집 주인이 재판장 앞에 가서 자기가 그 이웃의 물품에 손 댄 여부의 조사를 받을 것이며"
      ],
      "raw_text_hashes": [
        "121638adc5f691aa5d991e41ddd55f179b4be468c08a1a9f6c10adfd60020444"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:9",
      "sequence": 2123,
      "chapter_label": "EXO 22",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 9
        }
      ],
      "en": "For every matter of trespass, whether it is for ox, for donkey, for sheep, for clothing, or for any kind of lost thing, about which one says, ‘This is mine,’ the cause of both parties shall come before God. He whom God condemns shall pay double to his neighbor.",
      "ko": "어떠한 과실에든지 소에든지 나귀에든지 양에든지 의복에든지 또는 아무 잃은 물건에든지 그것에 대하여 혹이 이르기를 이것이 그것이라 하면 두 편이 재판장 앞에 나아갈 것이요 재판장이 죄 있다고 하는 자가 그 상대편에게 갑절을 배상할찌니라",
      "source_text_hash": "b4da37e13b3a0661d2faeae517ac723decc55e3745d99a3f8cd270867a9563e7",
      "translation_text_hash": "44ff6796a1b7722f2938af74c692949389c267864a39858528332f775e97dded",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어떠한 과실에든지 소에든지 나귀에든지 양에든지 의복에든지 또는 아무 잃은 물건에든지 그것에 대하여 혹이 이르기를 이것이 그것이라 하면 두 편이 재판장 앞에 나아갈 것이요 재판장이 죄 있다고 하는 자가 그 상대편에게 갑절을 배상할찌니라"
      ],
      "raw_text_hashes": [
        "44ff6796a1b7722f2938af74c692949389c267864a39858528332f775e97dded"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:10",
      "sequence": 2124,
      "chapter_label": "EXO 22",
      "verse_label": "10",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 10
        }
      ],
      "en": "“If a man delivers to his neighbor a donkey, an ox, a sheep, or any animal to keep, and it dies or is injured, or driven away, no man seeing it;",
      "ko": "사람이 나귀나 소나 양이나 다른 짐승을 이웃에게 맡겨 지키게 하였다가 죽거나 상하거나 몰려 가도 본 사람이 없으면",
      "source_text_hash": "59772fc448a15262861b958702150d8f3644ea5f33caf0644529f279108828fd",
      "translation_text_hash": "9322ba478cfef30c37e265cba810f337dc0d9a9c051ac1475b236929c5480c96",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 나귀나 소나 양이나 다른 짐승을 이웃에게 맡겨 지키게 하였다가 죽거나 상하거나 몰려 가도 본 사람이 없으면"
      ],
      "raw_text_hashes": [
        "9322ba478cfef30c37e265cba810f337dc0d9a9c051ac1475b236929c5480c96"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:11",
      "sequence": 2125,
      "chapter_label": "EXO 22",
      "verse_label": "11",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 11
        }
      ],
      "en": "the oath of the LORD shall be between them both, he has not put his hand on his neighbor’s goods; and its owner shall accept it, and he shall not make restitution.",
      "ko": "두 사람 사이에 맡은 자가 이웃의 것에 손을 대지 아니하였다고 여호와로 맹세할 것이요 그 임자는 그대로 믿을 것이며 그 사람은 배상하지 아니하려니와",
      "source_text_hash": "20c2f9f9e96907d185a0f1f1a23c6a774c26585ed3b08a397887e704c3595380",
      "translation_text_hash": "ec1c52060e46550bc805880c0d69f1d96d0b1f1cfde6e593a599d5e184c47040",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "두 사람 사이에 맡은 자가 이웃의 것에 손을 대지 아니하였다고 여호와로 맹세할 것이요 그 임자는 그대로 믿을 것이며 그 사람은 배상하지 아니하려니와"
      ],
      "raw_text_hashes": [
        "ec1c52060e46550bc805880c0d69f1d96d0b1f1cfde6e593a599d5e184c47040"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:12",
      "sequence": 2126,
      "chapter_label": "EXO 22",
      "verse_label": "12",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 12
        }
      ],
      "en": "But if it is stolen from him, the one who stole shall make restitution to its owner.",
      "ko": "만일 자기에게서 봉적하였으면 그 임자에게 배상할 것이며",
      "source_text_hash": "1af0af7ed3b5135b2ad5f5d268a249a45033fd993de96caf07e97d236c85da6b",
      "translation_text_hash": "7b2319a195234181d7122e0ac63fe582da9b4525a18b16c35f790dd9a1772142",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 자기에게서 봉적하였으면 그 임자에게 배상할 것이며"
      ],
      "raw_text_hashes": [
        "7b2319a195234181d7122e0ac63fe582da9b4525a18b16c35f790dd9a1772142"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:13",
      "sequence": 2127,
      "chapter_label": "EXO 22",
      "verse_label": "13",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 13
        }
      ],
      "en": "If it is torn in pieces, let him bring it for evidence. He shall not make good that which was torn.",
      "ko": "만일 찢겼으면 그것을 가져다가 증거할 것이요 그 찢긴 것에 대하여 배상하지 않을찌니라",
      "source_text_hash": "1c2ef78fd17d05cfbbf1fe0a3442510e3bb1467122ad3bb22b55257e3c986ef6",
      "translation_text_hash": "53e5f39875cd549af0983cbfae72a829c5503ae80622190ffeab590646c86e3e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 찢겼으면 그것을 가져다가 증거할 것이요 그 찢긴 것에 대하여 배상하지 않을찌니라"
      ],
      "raw_text_hashes": [
        "53e5f39875cd549af0983cbfae72a829c5503ae80622190ffeab590646c86e3e"
