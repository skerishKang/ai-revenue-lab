        "verse": 25
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 25
        }
      ],
      "en": "“If you lend money to any of my people with you who is poor, you shall not be to him as a creditor. You shall not charge him interest.",
      "ko": "네가 만일 너와 함께한 나의 백성 중 가난한 자에게 돈을 꾸이거든 너는 그에게 채주 같이 하지 말며 변리를 받지 말 것이며",
      "source_text_hash": "f763f9ed66015fca709576a7d8f764f3e89ff3f81d5645fd658b330cca0fe834",
      "translation_text_hash": "3950eac423d92f817ca7a0ebe52066eed32aa973a9f2bd1392255d45b0a911bc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 만일 너와 함께한 나의 백성 중 가난한 자에게 돈을 꾸이거든 너는 그에게 채주 같이 하지 말며 변리를 받지 말 것이며"
      ],
      "raw_text_hashes": [
        "3950eac423d92f817ca7a0ebe52066eed32aa973a9f2bd1392255d45b0a911bc"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:26",
      "sequence": 2140,
      "chapter_label": "EXO 22",
      "verse_label": "26",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 26
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 26
        }
      ],
      "en": "If you take your neighbor’s garment as collateral, you shall restore it to him before the sun goes down,",
      "ko": "네가 만일 이웃의 옷을 전당잡거든 해가 지기 전에 그에게 돌려 보내라",
      "source_text_hash": "0f7d907c46abed600468a2cdabdffabc0e5b6aad28ec61456bdb7936cc4d7f94",
      "translation_text_hash": "b9f2af1730b3c7af4988ed3e6773e8ff23ddd723b681fb58ac03abac9775dd38",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 만일 이웃의 옷을 전당잡거든 해가 지기 전에 그에게 돌려 보내라"
      ],
      "raw_text_hashes": [
        "b9f2af1730b3c7af4988ed3e6773e8ff23ddd723b681fb58ac03abac9775dd38"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:27",
      "sequence": 2141,
      "chapter_label": "EXO 22",
      "verse_label": "27",
      "locator": {
        "book": "EXO",
        "chapter": 22,
        "verse": 27
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 22,
          "verse": 27
        }
      ],
      "en": "for that is his only covering, it is his garment for his skin. What would he sleep in? It will happen, when he cries to me, that I will hear, for I am gracious.",
      "ko": "그 몸을 가릴 것이 이뿐이라 이는 그 살의 옷인즉 그가 무엇을 입고 자겠느냐 그가 내게 부르짖으면 내가 들으리니 나는 자비한 자임이니라",
      "source_text_hash": "67df4f99198d1dbbeb959c59158432cae6d78798ecfa603e34e28556c7bb8319",
      "translation_text_hash": "d8a528c2d4a57306f9caf7dc5e24f38f86fc4466b49d95a73628d06c505c70bb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 몸을 가릴 것이 이뿐이라 이는 그 살의 옷인즉 그가 무엇을 입고 자겠느냐 그가 내게 부르짖으면 내가 들으리니 나는 자비한 자임이니라"
      ],
      "raw_text_hashes": [
        "d8a528c2d4a57306f9caf7dc5e24f38f86fc4466b49d95a73628d06c505c70bb"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:22:28",
