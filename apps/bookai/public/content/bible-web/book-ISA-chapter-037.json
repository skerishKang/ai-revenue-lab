      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 37,
          "verse": 18
        }
      ],
      "en": "Truly, LORD, the kings of Assyria have destroyed all the countries and their land,",
      "ko": "여호와여 앗수르 왕들이 과연 열국과 그 땅을 황폐케 하였고",
      "source_text_hash": "04084dab99bb18b381b6e0f363f4f6e7b6883b051addbebf65208308fe68087b",
      "translation_text_hash": "f1c97f49a30bbaee855f1ae17852d7236fb5d53981311c680dcabdf719ef3abd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와여 앗수르 왕들이 과연 열국과 그 땅을 황폐케 하였고"
      ],
      "raw_text_hashes": [
        "f1c97f49a30bbaee855f1ae17852d7236fb5d53981311c680dcabdf719ef3abd"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:37:19",
      "sequence": 18372,
      "chapter_label": "ISA 37",
      "verse_label": "19",
