      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 37,
          "verse": 20
        }
      ],
      "en": "Now therefore, LORD our God, save us from his hand, that all the kingdoms of the earth may know that you are the LORD, even you only.”",
      "ko": "우리 하나님 여호와여 이제 우리를 그의 손에서 구원하사 천하 만국으로 주만 여호와이신 줄을 알게 하옵소서",
      "source_text_hash": "937b259481fc58a4d4a824b421f2192e0559854daa15fb12f349f20ad448067a",
      "translation_text_hash": "ff3413b80de1e27a95e946b7babf894a117ce2c301aa74bd446a579d40ac553a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리 하나님 여호와여 이제 우리를 그의 손에서 구원하사 천하 만국으로 주만 여호와이신 줄을 알게 하옵소서"
      ],
      "raw_text_hashes": [
