      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "실상은 그가 이미 그들을 이끌고 지붕에 올라가서 그 지붕에 벌여놓은 삼대에 숨겼더라"
      ],
      "raw_text_hashes": [
