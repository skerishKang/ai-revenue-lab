      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사람들은 요단 길로 나루턱까지 따라갔고 그 따르는 자들이 나가자 곧 성문을 닫았더라"
      ],
      "raw_text_hashes": [
