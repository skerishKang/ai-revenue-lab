          "book": "ZEP",
          "chapter": 3,
          "verse": 1
        }
      ],
      "en": "Woe to her who is rebellious and polluted, the oppressing city!",
      "ko": "패역하고 더러운 곳, 포학한 그 성읍이 화 있을찐저",
      "source_text_hash": "f561e6f4c59d7aa53d32aa3016f8c62cd212bb49c931ca44030d60c3326916aa",
      "translation_text_hash": "8c5f962543a6bfca2d1f6cbddeb937ca4966e439bb36229de5a0dee7a6284ac1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "패역하고 더러운 곳, 포학한 그 성읍이 화 있을찐저"
      ],
      "raw_text_hashes": [
        "8c5f962543a6bfca2d1f6cbddeb937ca4966e439bb36229de5a0dee7a6284ac1"
      ]
    },
    {
      "canonical_locator": "bible:web:ZEP:3:2",
      "sequence": 22823,
      "chapter_label": "ZEP 3",
      "verse_label": "2",
      "locator": {
        "book": "ZEP",
