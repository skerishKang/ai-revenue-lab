    {
      "canonical_locator": "bible:web:EZK:13:6",
      "sequence": 20715,
      "chapter_label": "EZK 13",
      "verse_label": "6",
      "locator": {
        "book": "EZK",
        "chapter": 13,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 13,
          "verse": 6
        }
      ],
      "en": "They have seen falsehood and lying divination, who say, ‘The LORD says;’ but the LORD has not sent them. They have made men to hope that the word would be confirmed.",
      "ko": "여호와께서 말씀하셨다고 하는 자들이 허탄한 것과 거짓된 점괘를 보며 사람으로 그 말이 굳게 이루기를 바라게 하거니와 여호와가 보낸 자가 아니라",
      "source_text_hash": "e19e7b00846427faa34d9ed500b227a13134832c29687b7f5b4fc4ec814df6a8",
      "translation_text_hash": "efd1242930aa8cb91711ed39b316052b92d14205fd1129f1c1b29e3041fe0d48",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 말씀하셨다고 하는 자들이 허탄한 것과 거짓된 점괘를 보며 사람으로 그 말이 굳게 이루기를 바라게 하거니와 여호와가 보낸 자가 아니라"
      ],
      "raw_text_hashes": [
        "efd1242930aa8cb91711ed39b316052b92d14205fd1129f1c1b29e3041fe0d48"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:13:7",
      "sequence": 20716,
      "chapter_label": "EZK 13",
