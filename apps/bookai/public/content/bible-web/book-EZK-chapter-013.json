    {
      "canonical_locator": "bible:web:EZK:13:21",
      "sequence": 20730,
      "chapter_label": "EZK 13",
      "verse_label": "21",
      "locator": {
        "book": "EZK",
        "chapter": 13,
        "verse": 21
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 13,
          "verse": 21
        }
      ],
      "en": "I will also tear your veils and deliver my people out of your hand; and they will no longer be in your hand to be ensnared. Then you will know that I am the LORD.",
      "ko": "또 너희 수건을 찢고 내 백성을 너희 손에서 건지고 다시는 너희 손에 사냥물이 되지 않게 하리니 너희가 나를 여호와인줄 알리라",
      "source_text_hash": "ec7740bc3c5947298bae8d3dd7a6a5ab0a481806bc9398e18f49d8de13acefdf",
      "translation_text_hash": "f3615d3879e0e5fab6bad97f7770756c0de365318072ad28050b2e68c551b486",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 너희 수건을 찢고 내 백성을 너희 손에서 건지고 다시는 너희 손에 사냥물이 되지 않게 하리니 너희가 나를 여호와인줄 알리라"
      ],
      "raw_text_hashes": [
