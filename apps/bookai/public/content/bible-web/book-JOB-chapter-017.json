      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 17,
          "verse": 7
        }
      ],
      "en": "My eye also is dim by reason of sorrow. All my members are as a shadow.",
      "ko": "내 눈은 근심으로 하여 어두워지고 나의 온 지체는 그림자 같구나",
      "source_text_hash": "d0fd48a16df5f01abeda5ce8f7cd6a6c779b8a52b81010ea4ca7e45ccfb96146",
      "translation_text_hash": "a5e6d5955e1d991ca7926598db859a00ab500a4298972630dbf4e93f4d548c3b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 눈은 근심으로 하여 어두워지고 나의 온 지체는 그림자 같구나"
      ],
      "raw_text_hashes": [
        "a5e6d5955e1d991ca7926598db859a00ab500a4298972630dbf4e93f4d548c3b"
      ]
