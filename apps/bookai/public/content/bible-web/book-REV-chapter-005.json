      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 보매 보좌에 앉으신 이의 오른손에 책이 있으니 안팎으로 썼고 일곱 인으로 봉하였더라"
      ],
      "raw_text_hashes": [
