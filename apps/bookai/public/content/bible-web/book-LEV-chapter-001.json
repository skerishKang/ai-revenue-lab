        "verse": 2
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 1,
          "verse": 2
        }
      ],
      "en": "“Speak to the children of Israel, and tell them, ‘When anyone of you offers an offering to the LORD, you shall offer your offering of the livestock, from the herd and from the flock.",
      "ko": "이스라엘 자손에게 고하여 이르라 너희 중에 누구든지 여호와께 예물을 드리려거든 생축 중에서 소나 양으로 예물을 드릴찌니라",
      "source_text_hash": "fc9e2eff1d4b28949a571b7bfb27fab6e51da147eacc94832b5ff65a833c3ced",
      "translation_text_hash": "9da17a36bcfdd9a56e9c6a0f80d73ea93097b1355a510f8f5edad85e5ccb41cb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손에게 고하여 이르라 너희 중에 누구든지 여호와께 예물을 드리려거든 생축 중에서 소나 양으로 예물을 드릴찌니라"
      ],
      "raw_text_hashes": [
        "9da17a36bcfdd9a56e9c6a0f80d73ea93097b1355a510f8f5edad85e5ccb41cb"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:1:3",
      "sequence": 2749,
      "chapter_label": "LEV 1",
