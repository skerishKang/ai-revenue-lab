      "raw_texts": [
        "베레스의 세계는 이러하니라 베레스는 헤스론을 낳았고"
      ],
      "raw_text_hashes": [
        "fff1cc5a9c32257346b285f6e23c063f58ee0fe00c092d6532392b362ee0dce7"
