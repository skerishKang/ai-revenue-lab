      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모든 골짜기가 메워지고 모든 산과 작은 산이 낮아지고 굽은 것이 곧아지고 험한 길이 평탄하여질 것이요"
      ],
      "raw_text_hashes": [
