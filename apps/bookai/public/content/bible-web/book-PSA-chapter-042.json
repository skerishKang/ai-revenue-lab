      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 폭포 소리에 깊은 바다가 서로 부르며 주의 파도와 물결이 나를 엄몰하도소이다"
      ],
      "raw_text_hashes": [
        "3ddd1494a17e7c1b30e9f397e2f400c2cfb72bd621cc46936e4eefe9dea56d35"
