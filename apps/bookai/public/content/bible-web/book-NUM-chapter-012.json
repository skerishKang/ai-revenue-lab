        "verse": 7
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 12,
          "verse": 7
        }
      ],
      "en": "My servant Moses is not so. He is faithful in all my house.",
      "ko": "내 종 모세와는 그렇지 아니하니 그는 나의 온 집에 충성됨이라",
      "source_text_hash": "0c4872fb30ce75bfd43dbaf92b2ec6a7e6b299d85da4146d8f23f56b4ad798ad",
      "translation_text_hash": "2b626855c8f76cc8154abd3e99b0dd67c3f49350f269e50660f88c7f8e79ce62",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 종 모세와는 그렇지 아니하니 그는 나의 온 집에 충성됨이라"
      ],
      "raw_text_hashes": [
        "2b626855c8f76cc8154abd3e99b0dd67c3f49350f269e50660f88c7f8e79ce62"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:12:8",
