        {
          "book": "NUM",
          "chapter": 12,
          "verse": 3
        }
      ],
      "en": "Now the man Moses was very humble, more than all the men who were on the surface of the earth.",
      "ko": "이 사람 모세는 온유함이 지면의 모든 사람보다 승하더라",
      "source_text_hash": "14e602a6b65702efd45ed70eb92fff8ff13d2b71eb4192c0b3067205d66f69de",
      "translation_text_hash": "6fc75c54ab34947f3ef04a0e10e63a83a5985a83ac91b217bbce54690482195e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 사람 모세는 온유함이 지면의 모든 사람보다 승하더라"
      ],
      "raw_text_hashes": [
        "6fc75c54ab34947f3ef04a0e10e63a83a5985a83ac91b217bbce54690482195e"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:12:4",
