    {
      "canonical_locator": "bible:web:EZK:21:23",
      "sequence": 20968,
      "chapter_label": "EZK 21",
      "verse_label": "23",
      "locator": {
        "book": "EZK",
        "chapter": 21,
        "verse": 23
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 21,
          "verse": 23
        }
      ],
      "en": "It will be to them as a false divination in their sight, who have sworn oaths to them; but he brings iniquity to memory, that they may be taken.",
      "ko": "전에 그들에게 맹약한 자들은 그것을 헛점으로 여길 것이나 바벨론 왕은 그 죄악을 기억하고 그 무리를 잡으리라",
      "source_text_hash": "7abd6e1301ff4660aa9213cf4d56a6d2c8f9511eec5d94a7e1629d9c4a4b61c6",
      "translation_text_hash": "f8001ee922824e6b23413b0fe972dc0a373b63b246f5a7845eab63fd2853fec3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "전에 그들에게 맹약한 자들은 그것을 헛점으로 여길 것이나 바벨론 왕은 그 죄악을 기억하고 그 무리를 잡으리라"
      ],
      "raw_text_hashes": [
        "f8001ee922824e6b23413b0fe972dc0a373b63b246f5a7845eab63fd2853fec3"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:21:24",
      "sequence": 20969,
      "chapter_label": "EZK 21",
      "verse_label": "24",
      "locator": {
