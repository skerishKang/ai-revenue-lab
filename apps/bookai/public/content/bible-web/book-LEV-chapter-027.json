      "source_text_hash": "6bc91e0e239928b613f6aa32af96b2d9b0e218bfedec892393defe1092c118db",
      "translation_text_hash": "412063b1389d8d5b0ddf604071cea5828f8e5377a9e951fa19a326aeda8ca720",
