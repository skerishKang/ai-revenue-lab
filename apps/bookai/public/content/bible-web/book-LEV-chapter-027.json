      "source_text_hash": "b17e6705328a914ae935dcfce3b7e9db99ce829e0bfa996b2ab0e7afb7c5e083",
      "translation_text_hash": "37bb73036d5cf120c33deb77f4b7abf8f9c71a0e30e09abe63bcd7a9d8cf428f",
