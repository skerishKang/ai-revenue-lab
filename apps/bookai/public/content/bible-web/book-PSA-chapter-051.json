        {
          "book": "PSA",
          "chapter": 51,
          "verse": 2
        }
      ],
      "en": "Wash me thoroughly from my iniquity. Cleanse me from my sin.",
      "ko": "나의 죄악을 말갛게 씻기시며 나의 죄를 깨끗이 제하소서",
      "source_text_hash": "35ee59fd0ebf0b92dc7489f2af1a539e5b74dc29716c816c1f51ad97ad8830d8",
      "translation_text_hash": "be7b74ac217a97d3cf4811a36018c6f48e355bd720e06306d5324e632f11cce9",
      "translation_policy": "krv-1961-source-mapped",
