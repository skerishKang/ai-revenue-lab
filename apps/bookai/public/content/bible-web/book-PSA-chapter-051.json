      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나로 즐겁고 기쁜 소리를 듣게 하사 주께서 꺾으신 뼈로 즐거워하게 하소서"
      ],
      "raw_text_hashes": [
        "d578b91857341c4f03bf05cc854f404de22808d5387e9cbb5505dbc503f4fd67"
      ]
