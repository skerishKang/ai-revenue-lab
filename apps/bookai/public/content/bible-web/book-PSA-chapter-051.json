      "source_text_hash": "c4c9b902a4640cb55cea867e5ec85fe8167ce1b5f555aab1e94e5cd598ceabb4",
      "translation_text_hash": "08b5262c43fe142b7e0b1c0e77e4d6ff623bcef1c2f3abe9bf6084b8adadca53",
