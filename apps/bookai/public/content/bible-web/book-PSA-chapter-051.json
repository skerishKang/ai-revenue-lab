      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 죄악을 말갛게 씻기시며 나의 죄를 깨끗이 제하소서"
      ],
      "raw_text_hashes": [
        "be7b74ac217a97d3cf4811a36018c6f48e355bd720e06306d5324e632f11cce9"
      ]
