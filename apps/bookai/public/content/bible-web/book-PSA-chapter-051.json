      "translation_text_hash": "003ddc47e563f6f453368d571b606054c4eb0dbab26acb492d87e9f5072b7085",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대저 나는 내 죄과를 아오니 내 죄가 항상 내 앞에 있나이다"
      ],
      "raw_text_hashes": [
        "003ddc47e563f6f453368d571b606054c4eb0dbab26acb492d87e9f5072b7085"
      ]
    },
    {
