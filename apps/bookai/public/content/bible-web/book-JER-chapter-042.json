      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 가레아의 아들 요하난과 그와 함께 있는 모든 군대장관과 백성의 작은 자로부터 큰 자까지 다 부르고"
      ],
