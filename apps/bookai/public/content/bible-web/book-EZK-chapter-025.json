        {
          "book": "EZK",
          "chapter": 25,
          "verse": 3
        }
      ],
      "en": "Tell the children of Ammon, ‘Hear the word of the Lord GOD! The Lord GOD says, “Because you said, ‘Aha!’ against my sanctuary when it was profaned, and against the land of Israel when it was made desolate, and against the house of Judah when they went into captivity,",
      "ko": "(2절에 포함되어 있음)",
      "source_text_hash": "a21f2fd09ef5415d1634f36c0ae5f86fac2077a54158aede2f133266468b363a",
      "translation_text_hash": "07656b50f41822f5bb5b5526a53474ff98b41282acf1da78f2ac89ececd1d0fc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "(2절에 포함되어 있음)"
      ],
      "raw_text_hashes": [
        "07656b50f41822f5bb5b5526a53474ff98b41282acf1da78f2ac89ececd1d0fc"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:25:4",
      "sequence": 21088,
      "chapter_label": "EZK 25",
