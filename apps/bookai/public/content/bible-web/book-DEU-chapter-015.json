    {
      "canonical_locator": "bible:web:DEU:15:15",
      "sequence": 5335,
      "chapter_label": "DEU 15",
      "verse_label": "15",
      "locator": {
        "book": "DEU",
        "chapter": 15,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 15,
          "verse": 15
        }
      ],
      "en": "You shall remember that you were a slave in the land of Egypt, and the LORD your God redeemed you. Therefore I command you this thing today.",
      "ko": "너는 애굽 땅에서 종 되었던 것과 네 하나님 여호와께서 너를 속하셨음을 기억하라 그를 인하여 내가 오늘날 이같이 네게 명하노라",
      "source_text_hash": "cd516ce8f25ac3a96ea0c268d9c174b7b965a5fccbe887f49221de772c06b4a5",
      "translation_text_hash": "e2d44cdcf58c5fdb8c65cd239610387f858dc6b5fd82c156060bcac66565f9ed",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 애굽 땅에서 종 되었던 것과 네 하나님 여호와께서 너를 속하셨음을 기억하라 그를 인하여 내가 오늘날 이같이 네게 명하노라"
      ],
      "raw_text_hashes": [
        "e2d44cdcf58c5fdb8c65cd239610387f858dc6b5fd82c156060bcac66565f9ed"
      ]
