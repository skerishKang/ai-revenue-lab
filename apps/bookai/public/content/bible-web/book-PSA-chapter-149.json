      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서는 자기 백성을 기뻐하시며 겸손한 자를 구원으로 아름답게 하심이로다"
      ],
      "raw_text_hashes": [
        "7546cb6ccf7d876b726c188ffab3cea88fc5c5d08e02787018213515809b7562"
