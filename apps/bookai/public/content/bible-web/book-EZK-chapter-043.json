      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 43,
          "verse": 16
        }
      ],
      "en": "The altar hearth shall be twelve cubits long by twelve wide, square in its four sides.",
      "ko": "그 번제하는 바닥의 장이 십 이척이요 광이 십 이척이니 네모 반듯하고",
      "source_text_hash": "769aa8081f22a9e9df26cc90efae8f8039fd1b9d61e263a91870e24b2f71f0b7",
      "translation_text_hash": "8e1d2a21d1c3b8a251285c39ec53e80d3c6167aa45d443173058c41408a1a3e5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 번제하는 바닥의 장이 십 이척이요 광이 십 이척이니 네모 반듯하고"
      ],
      "raw_text_hashes": [
        "8e1d2a21d1c3b8a251285c39ec53e80d3c6167aa45d443173058c41408a1a3e5"
