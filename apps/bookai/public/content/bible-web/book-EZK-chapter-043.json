      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 하나님의 영광이 동편에서부터 오는데 하나님의 음성이 많은 물소리 같고 땅은 그 영광으로 인하여 빛나니"
      ],
      "raw_text_hashes": [
        "0f71130e97c51442553adf275832dc7915c85bdedc76f989d5972de4d4db1e85"
