        "verse": 11
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 11
        }
      ],
      "en": "Ephraim is oppressed, he is crushed in judgment, because he is intent in his pursuit of idols.",
      "ko": "에브라임은 사람의 명령 좇기를 좋아하므로 학대를 받고 재판의 압제를 당하는도다",
      "source_text_hash": "a8014fcfaf0198c897403abbb20d228c7a5917bdf2a1761fe82880960ea19373",
      "translation_text_hash": "f2515b107287d059c92a468eb9aa782bf6edf70691eeb2f6adac2bca432847c7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에브라임은 사람의 명령 좇기를 좋아하므로 학대를 받고 재판의 압제를 당하는도다"
      ],
      "raw_text_hashes": [
        "f2515b107287d059c92a468eb9aa782bf6edf70691eeb2f6adac2bca432847c7"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:12",
      "sequence": 22165,
      "chapter_label": "HOS 5",
      "verse_label": "12",
      "locator": {
        "book": "HOS",
        "chapter": 5,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 12
        }
      ],
      "en": "Therefore I am to Ephraim like a moth, and to the house of Judah like rottenness.",
      "ko": "그러므로 내가 에브라임에게는 좀 같으며 유다 족속에게는 썩이는 것 같도다",
      "source_text_hash": "de4da004238e5798376eb0d2d8cb06b4a1c3f1c873aa19e66d8e80d817317a90",
      "translation_text_hash": "f9a4ba7e6ef05f0981cd0d3c7f13f9a66f516da54054fdfc7525e31a5eaad90f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 내가 에브라임에게는 좀 같으며 유다 족속에게는 썩이는 것 같도다"
      ],
      "raw_text_hashes": [
        "f9a4ba7e6ef05f0981cd0d3c7f13f9a66f516da54054fdfc7525e31a5eaad90f"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:13",
      "sequence": 22166,
