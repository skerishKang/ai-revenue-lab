        "verse": 2
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 2
        }
      ],
      "en": "The rebels are deep in slaughter, but I discipline all of them.",
      "ko": "패역자가 살륙죄에 깊이 빠졌으매 내가 저희를 다 징책하노라",
      "source_text_hash": "4e8a02916487532fef29b2a107c676ca0d4f7e09981f0969dcee536bb575d9aa",
      "translation_text_hash": "c82eb3f5164aef6185e2cb0f460fbefa29e9fc9d8f6ed0202c93cdbde6ddd4b3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "패역자가 살륙죄에 깊이 빠졌으매 내가 저희를 다 징책하노라"
      ],
      "raw_text_hashes": [
        "c82eb3f5164aef6185e2cb0f460fbefa29e9fc9d8f6ed0202c93cdbde6ddd4b3"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:3",
      "sequence": 22156,
      "chapter_label": "HOS 5",
      "verse_label": "3",
      "locator": {
        "book": "HOS",
        "chapter": 5,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 3
        }
      ],
      "en": "I know Ephraim, and Israel is not hidden from me; for now, Ephraim, you have played the prostitute. Israel is defiled.",
      "ko": "에브라임은 내가 알고 이스라엘은 내게 숨기지 못하나니 에브라임아 이제 네가 행음하였고 이스라엘이 이미 더러웠느니라",
      "source_text_hash": "e758816b63673d47cd00bae927dc54f29ee7e3cb8cd2ac7fe90ce5b0178283cc",
      "translation_text_hash": "fd528c9c693d1e5d9eb9a6187664b02ea485e50f13c4d7b1c87663e3575c099d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에브라임은 내가 알고 이스라엘은 내게 숨기지 못하나니 에브라임아 이제 네가 행음하였고 이스라엘이 이미 더러웠느니라"
      ],
      "raw_text_hashes": [
        "fd528c9c693d1e5d9eb9a6187664b02ea485e50f13c4d7b1c87663e3575c099d"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:4",
      "sequence": 22157,
      "chapter_label": "HOS 5",
      "verse_label": "4",
      "locator": {
        "book": "HOS",
        "chapter": 5,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 4
        }
      ],
      "en": "Their deeds won’t allow them to turn to their God, for the spirit of prostitution is within them, and they don’t know the LORD.",
      "ko": "저희의 행위가 저희로 자기 하나님에게 돌아가지 못하게 하나니 이는 음란한 마음이 그 속에 있어 여호와를 알지 못하는 까닭이라",
      "source_text_hash": "2725d8f91a4becf4d233999d800f58b1f72898d4bd7ec9bf770986b7e76933ec",
      "translation_text_hash": "0fab8184c9e856f3d652137f346d0211a134e6389adf5253962a61bf55d012ad",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희의 행위가 저희로 자기 하나님에게 돌아가지 못하게 하나니 이는 음란한 마음이 그 속에 있어 여호와를 알지 못하는 까닭이라"
      ],
      "raw_text_hashes": [
        "0fab8184c9e856f3d652137f346d0211a134e6389adf5253962a61bf55d012ad"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:5",
      "sequence": 22158,
      "chapter_label": "HOS 5",
      "verse_label": "5",
      "locator": {
        "book": "HOS",
        "chapter": 5,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 5
        }
      ],
      "en": "The pride of Israel testifies to his face. Therefore Israel and Ephraim will stumble in their iniquity. Judah also will stumble with them.",
      "ko": "이스라엘의 교만이 그 얼굴에 증거가 되나니 그 죄악을 인하여 이스라엘과 에브라임이 넘어지고 유다도 저희와 한가지로 넘어지리라",
      "source_text_hash": "1bfb3107144ad2e971e82f987a67e70be8bf944c74bb0fd4a21fb604c7bcc6a2",
      "translation_text_hash": "8538b07f61b6ed71e651e18f086534f3fbc814a446f8d2c86dd8b618435748f6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘의 교만이 그 얼굴에 증거가 되나니 그 죄악을 인하여 이스라엘과 에브라임이 넘어지고 유다도 저희와 한가지로 넘어지리라"
      ],
      "raw_text_hashes": [
        "8538b07f61b6ed71e651e18f086534f3fbc814a446f8d2c86dd8b618435748f6"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:6",
      "sequence": 22159,
      "chapter_label": "HOS 5",
      "verse_label": "6",
      "locator": {
        "book": "HOS",
        "chapter": 5,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 6
        }
      ],
      "en": "They will go with their flocks and with their herds to seek the LORD, but they won’t find him. He has withdrawn himself from them.",
      "ko": "저희가 양떼와 소떼를 끌고 여호와를 찾으러 갈찌라도 만나지 못할 것은 이미 저희에게서 떠나셨음이라",
      "source_text_hash": "fc15afa6494d1521d9735e7c545b2ad5ff16ba07d207083576bd003de681a471",
      "translation_text_hash": "300976ad652009e8c3c3e8247959db27f3ef42d09c718ca28034068521a6e3a6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 양떼와 소떼를 끌고 여호와를 찾으러 갈찌라도 만나지 못할 것은 이미 저희에게서 떠나셨음이라"
      ],
      "raw_text_hashes": [
        "300976ad652009e8c3c3e8247959db27f3ef42d09c718ca28034068521a6e3a6"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:7",
      "sequence": 22160,
      "chapter_label": "HOS 5",
      "verse_label": "7",
      "locator": {
        "book": "HOS",
        "chapter": 5,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 5,
          "verse": 7
        }
      ],
      "en": "They are unfaithful to the LORD; for they have borne illegitimate children. Now the new moon will devour them with their fields.",
      "ko": "저희가 여호와께 정조를 지키지 아니하고 사생자를 낳았으니 그러므로 새 달이 저희와 그 기업을 함께 삼키리로다",
      "source_text_hash": "c3b83021123900e25e13aeadd1eacac9c799f568d195a297b4be6aa52d7ad051",
      "translation_text_hash": "5129ac843c44b732ab1bf94a6483964bcc8f8a76431064bcadb0b9f8bb9d3c22",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 여호와께 정조를 지키지 아니하고 사생자를 낳았으니 그러므로 새 달이 저희와 그 기업을 함께 삼키리로다"
      ],
      "raw_text_hashes": [
        "5129ac843c44b732ab1bf94a6483964bcc8f8a76431064bcadb0b9f8bb9d3c22"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:5:8",
      "sequence": 22161,
      "chapter_label": "HOS 5",
      "verse_label": "8",
      "locator": {
        "book": "HOS",
