      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이와 같이 집사들도 단정하고 일구 이언을 하지 아니하고 술에 인박이지 아니하고 더러운 이를 탐하지 아니하고"
      ],
      "raw_text_hashes": [
        "1962e1acb3ec224050e632be4baa308b550dfb13a6b32685ad7c077910851962"
      ]
