      "chapter_label": "EST 1",
      "verse_label": "20",
      "locator": {
        "book": "EST",
        "chapter": 1,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "EST",
          "chapter": 1,
          "verse": 20
        }
      ],
      "en": "When the king’s decree which he shall make is published throughout all his kingdom (for it is great), all the wives will give their husbands honor, both great and small.”",
      "ko": "왕의 조서가 이 광대한 전국에 반포되면 귀천을 무론하고 모든 부녀가 그 남편을 존경하리이다",
      "source_text_hash": "d7d2fa9bcd9ba96095dd4b671c54fd0ab414afa777d02c52b259aef609b6ea3e",
      "translation_text_hash": "e35f523da8fcf23c6488d6c6131fbc386e490a8f2cfd99cd502da4241ca640ef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕의 조서가 이 광대한 전국에 반포되면 귀천을 무론하고 모든 부녀가 그 남편을 존경하리이다"
      ],
      "raw_text_hashes": [
        "e35f523da8fcf23c6488d6c6131fbc386e490a8f2cfd99cd502da4241ca640ef"
      ]
