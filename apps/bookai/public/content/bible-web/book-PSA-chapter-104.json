      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 104,
          "verse": 4
        }
      ],
      "en": "He makes his messengers winds, and his servants flames of fire.",
      "ko": "바람으로 자기 사자를 삼으시며 화염으로 자기 사역자를 삼으시며",
      "source_text_hash": "590d2b5ed8240d2f5004ff19788c0588dd9dd2e58a6227db423d0745178af82e",
      "translation_text_hash": "4dadb33a5827613f9e41f46df6d54df6412b8972e77abae0ccc64c1eb333590f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바람으로 자기 사자를 삼으시며 화염으로 자기 사역자를 삼으시며"
      ],
      "raw_text_hashes": [
        "4dadb33a5827613f9e41f46df6d54df6412b8972e77abae0ccc64c1eb333590f"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:104:5",
      "sequence": 15577,
