        "verse": 7
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 104,
          "verse": 7
        }
      ],
      "en": "At your rebuke they fled. At the voice of your thunder they hurried away.",
      "ko": "주의 견책을 인하여 도망하며 주의 우뢰 소리를 인하여 빨리 가서",
      "source_text_hash": "717c2801eff8b1c474d475720137d6d194cda4445c6293deb2745bc9a8e472c9",
      "translation_text_hash": "3354dfddf5f7f7104d316bd84d0cc2589b0970fadba1ad14aec7e5515ceace78",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 견책을 인하여 도망하며 주의 우뢰 소리를 인하여 빨리 가서"
      ],
      "raw_text_hashes": [
        "3354dfddf5f7f7104d316bd84d0cc2589b0970fadba1ad14aec7e5515ceace78"
      ]
