        "verse": 10
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 104,
          "verse": 10
        }
      ],
      "en": "He sends springs into the valleys. They run among the mountains.",
      "ko": "여호와께서 샘으로 골짜기에서 솟아나게 하시고 산 사이에 흐르게 하사",
      "source_text_hash": "426b305b492d11f14b367de396c795933a4aef610733cff3a0d6e6649e53fbe1",
      "translation_text_hash": "88dc7eb7e6b5941e0b313f286855c40023711af5814df8f045db215b6e90e537",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 샘으로 골짜기에서 솟아나게 하시고 산 사이에 흐르게 하사"
      ],
      "raw_text_hashes": [
        "88dc7eb7e6b5941e0b313f286855c40023711af5814df8f045db215b6e90e537"
      ]
