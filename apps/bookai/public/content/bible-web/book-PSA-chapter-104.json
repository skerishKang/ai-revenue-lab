      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 104,
          "verse": 2
        }
      ],
      "en": "He covers himself with light as with a garment. He stretches out the heavens like a curtain.",
      "ko": "주께서 옷을 입음 같이 빛을 입으시며 하늘을 휘장 같이 치시며",
      "source_text_hash": "c37ea92ff9154c05f02b31794feefc9aced4744e4b98547935bad980f29b2d5e",
      "translation_text_hash": "5de116196871d62524f9261ca2c99db5460ded87163a1a566e2ad92385e9329f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주께서 옷을 입음 같이 빛을 입으시며 하늘을 휘장 같이 치시며"
      ],
      "raw_text_hashes": [
        "5de116196871d62524f9261ca2c99db5460ded87163a1a566e2ad92385e9329f"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:104:3",
      "sequence": 15575,
