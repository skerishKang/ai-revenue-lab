      "source_text_hash": "e26617cbb3df3505385571434d5c31d5b578e8eac4b7258967764ff271867bda",
      "translation_text_hash": "5284efa19361d807a9004448f8aa97b78f85c14afb51090afc0bd2fcb7388cc3",
      "translation_policy": "krv-1961-source-mapped",
