      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 104,
          "verse": 15
        }
      ],
      "en": "wine that makes the heart of man glad, oil to make his face to shine, and bread that strengthens man’s heart.",
      "ko": "사람의 마음을 기쁘게 하는 포도주와 사람의 얼굴을 윤택케 하는 기름과 사람의 마음을 힘있게 하는 양식을 주셨도다",
      "source_text_hash": "9b47a6ac4456c26a3a0c92b30c298210099033f8eb29948c1cc04fab701ec463",
      "translation_text_hash": "f9fedc50b0eac6d47c3e1b0ef64e6e9eb08678fe7508c5c3efc46cb02afa6473",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
