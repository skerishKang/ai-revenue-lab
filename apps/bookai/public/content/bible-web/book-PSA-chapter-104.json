      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 104,
          "verse": 5
        }
      ],
      "en": "He laid the foundations of the earth, that it should not be moved forever.",
      "ko": "땅의 기초를 두사 영원히 요동치 않게 하셨나이다",
      "source_text_hash": "43f7af039e0a242f0a238bd42bb4ad66fac7439aca5a42eeb12256db76be2d30",
      "translation_text_hash": "570f62757bf95f932865a3c61e4b76b23ad2dff28c9579d8f31bd9bfefe63551",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "땅의 기초를 두사 영원히 요동치 않게 하셨나이다"
      ],
      "raw_text_hashes": [
        "570f62757bf95f932865a3c61e4b76b23ad2dff28c9579d8f31bd9bfefe63551"
      ]
