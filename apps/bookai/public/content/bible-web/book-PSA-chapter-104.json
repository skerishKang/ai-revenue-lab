      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "공중의 새들이 그 가에서 깃들이며 나무가지 사이에서 소리를 발하는도다"
      ],
      "raw_text_hashes": [
        "533a3ea3c8a236df6daba769681bbf9db1e72983b8766bebda39fd0967ee0847"
      ]
