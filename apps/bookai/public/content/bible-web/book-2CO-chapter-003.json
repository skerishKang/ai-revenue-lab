      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 3,
          "verse": 9
        }
      ],
      "en": "For if the service of condemnation has glory, the service of righteousness exceeds much more in glory.",
      "ko": "정죄의 직분도 영광이 있은즉 의의 직분은 영광이 더욱 넘치리라",
      "source_text_hash": "7aace5ceba523199355e14b56ffe2b1e936478c3176c1dea4ca2aa9d218892bb",
      "translation_text_hash": "3a1c1e988c0811a6e85492aa3f5cb673537b8765b2fceccd31b8e453ab483d52",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "정죄의 직분도 영광이 있은즉 의의 직분은 영광이 더욱 넘치리라"
      ],
      "raw_text_hashes": [
        "3a1c1e988c0811a6e85492aa3f5cb673537b8765b2fceccd31b8e453ab483d52"
      ]
