      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 3,
          "verse": 10
        }
      ],
      "en": "For most certainly that which has been made glorious has not been made glorious in this respect, by reason of the glory that surpasses.",
      "ko": "영광되었던 것이 더 큰 영광을 인하여 이에 영광될 것이 없으나",
      "source_text_hash": "a737e532f2ce253cf68797043345d9f3d60e6aaf2f704053e13c75ac6441e479",
      "translation_text_hash": "5df3044b50b73f52bed597467a9aba12d63de3db3b6bf89d734a89becc12884a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "영광되었던 것이 더 큰 영광을 인하여 이에 영광될 것이 없으나"
      ],
      "raw_text_hashes": [
        "5df3044b50b73f52bed597467a9aba12d63de3db3b6bf89d734a89becc12884a"
      ]
