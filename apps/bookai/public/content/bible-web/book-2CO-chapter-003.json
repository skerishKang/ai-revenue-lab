      "raw_locator": [
        {
          "book": "2CO",
          "chapter": 3,
          "verse": 2
        }
      ],
      "en": "You are our letter, written in our hearts, known and read by all men,",
      "ko": "너희가 우리의 편지라 우리 마음에 썼고 뭇사람이 알고 읽는바라",
      "source_text_hash": "96ccb8a3dc39bd2f65db424a966f9e6988b657a71798f8fb6289a050bdddec00",
      "translation_text_hash": "ad4c3a3141e86a7bb5b205cb826ee2a722cb30ffac35d121e9f64e94c1da1d39",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 우리의 편지라 우리 마음에 썼고 뭇사람이 알고 읽는바라"
      ],
      "raw_text_hashes": [
        "ad4c3a3141e86a7bb5b205cb826ee2a722cb30ffac35d121e9f64e94c1da1d39"
      ]
    },
    {
      "canonical_locator": "bible:web:2CO:3:3",
      "sequence": 28841,
      "chapter_label": "2CO 3",
      "verse_label": "3",
