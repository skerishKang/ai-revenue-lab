        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 8,
          "verse": 11
        }
      ],
      "en": "The frogs shall depart from you, and from your houses, and from your servants, and from your people. They shall remain in the river only.”",
      "ko": "개구리가 왕과 왕궁과 왕의 신하와 왕의 백성을 떠나서 하수에만 있으리이다 하고",
      "source_text_hash": "8ec0ed28df6874fc2bf5e060290e1c34b6e74610d77bafff2a6265aa2c1b79a8",
      "translation_text_hash": "a027922b7bb237c75440a6f5a6775f282d1a1e9cd58a1d0d050ba035565fd69a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "개구리가 왕과 왕궁과 왕의 신하와 왕의 백성을 떠나서 하수에만 있으리이다 하고"
      ],
      "raw_text_hashes": [
        "a027922b7bb237c75440a6f5a6775f282d1a1e9cd58a1d0d050ba035565fd69a"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:8:12",
      "sequence": 1723,
      "chapter_label": "EXO 8",
      "verse_label": "12",
      "locator": {
