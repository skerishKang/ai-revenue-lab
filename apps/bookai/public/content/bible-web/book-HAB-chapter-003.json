        "verse": 11
      },
      "raw_locator": [
        {
          "book": "HAB",
          "chapter": 3,
          "verse": 11
        }
      ],
      "en": "The sun and moon stood still in the sky at the light of your arrows as they went, at the shining of your glittering spear.",
      "ko": "주의 날으는 살의 빛과 주의 번쩍이는 창의 광채로 인하여 해와 달이 그 처소에 멈추었나이다",
      "source_text_hash": "69422e61cf34f967d5e47c9b21c5ec94111e940e119e8d8555eac8d7264ed3b0",
      "translation_text_hash": "dc27bc611bb58b9235d017350c9d94c92ef351b7e5964186301f10b9dec33003",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "주의 날으는 살의 빛과 주의 번쩍이는 창의 광채로 인하여 해와 달이 그 처소에 멈추었나이다"
      ],
      "raw_text_hashes": [
        "dc27bc611bb58b9235d017350c9d94c92ef351b7e5964186301f10b9dec33003"
      ]
    },
    {
      "canonical_locator": "bible:web:HAB:3:12",
      "sequence": 22781,
      "chapter_label": "HAB 3",
      "verse_label": "12",
      "locator": {
