      "source_text_hash": "a673e88445fa9325dab416e85ba54cf097ba4fdcd69bd05e0ed659b3c383ebf4",
      "translation_text_hash": "50417e15d265a2e87813d16131943d9f48ca230bcae4287283144da2bcacf03e",
      "translation_policy": "krv-1961-source-mapped",
