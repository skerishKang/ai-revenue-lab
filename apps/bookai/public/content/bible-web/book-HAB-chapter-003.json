      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 광명이 햇빛 같고 광선이 그 손에서 나오니 그 권능이 그 속에 감취었도다"
      ],
      "raw_text_hashes": [
        "0e98ce0816e353a745d2b3c35993f40b814db1110a0b026dcc2ef924dc869e22"
      ]
