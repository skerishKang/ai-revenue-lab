        "온역이 그 앞에서 행하며 불덩이가 그 발밑에서 나오도다"
      ],
      "raw_text_hashes": [
        "50417e15d265a2e87813d16131943d9f48ca230bcae4287283144da2bcacf03e"
      ]
    },
    {
      "canonical_locator": "bible:web:HAB:3:6",
      "sequence": 22775,
      "chapter_label": "HAB 3",
      "verse_label": "6",
