        "verse": 7
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 39,
          "verse": 7
        }
      ],
      "en": "‘They will take away your sons who will issue from you, whom you shall father, and they will be eunuchs in the king of Babylon’s palace.’”",
      "ko": "또 네게서 날 자손 중에서 몇이 사로잡혀 바벨론 왕궁의 환관이 되리라 하셨나이다",
      "source_text_hash": "319ed8fee57b34598637e018380eaf501bfcb7f856f7459580739865f839d443",
      "translation_text_hash": "78a0a9d36f72169cdbcd1daf318554033eadcd8448536367a137919580a35214",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 네게서 날 자손 중에서 몇이 사로잡혀 바벨론 왕궁의 환관이 되리라 하셨나이다"
      ],
      "raw_text_hashes": [
        "78a0a9d36f72169cdbcd1daf318554033eadcd8448536367a137919580a35214"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:39:8",
      "sequence": 18421,
