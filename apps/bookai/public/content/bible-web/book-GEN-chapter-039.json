      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 39,
          "verse": 7
        }
      ],
      "en": "After these things, his master’s wife set her eyes on Joseph; and she said, “Lie with me.”",
      "ko": "그 후에 그 주인의 처가 요셉에게 눈짓하다가 동침하기를 청하니",
      "source_text_hash": "88ad63a05a6d372701a9959b496831834f311354efd729a32f36cbb9ac34e06d",
      "translation_text_hash": "d5037feb1826f3049302c8de553cd2045c029539569f875b77f13cc51424bff7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 후에 그 주인의 처가 요셉에게 눈짓하다가 동침하기를 청하니"
      ],
      "raw_text_hashes": [
        "d5037feb1826f3049302c8de553cd2045c029539569f875b77f13cc51424bff7"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:39:8",
      "sequence": 1158,
      "chapter_label": "GEN 39",
      "verse_label": "8",
      "locator": {
