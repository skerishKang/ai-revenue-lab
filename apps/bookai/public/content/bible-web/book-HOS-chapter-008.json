        "verse": 9
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 8,
          "verse": 9
        }
      ],
      "en": "For they have gone up to Assyria, like a wild donkey wandering alone. Ephraim has hired lovers for himself.",
      "ko": "저희가 홀로 처한 들 나귀처럼 앗수르로 갔고 에브라임이 값 주고 연애하는 자들을 얻었도다",
      "source_text_hash": "765c639701e67b5813691fc72021c0fd63feb5b3a6732a7fe32f8f74d781dfe8",
      "translation_text_hash": "6dd37f98d0235149aac2276f1434f9e93c4f69d3cb71bac6602c42254b11556f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 홀로 처한 들 나귀처럼 앗수르로 갔고 에브라임이 값 주고 연애하는 자들을 얻었도다"
      ],
      "raw_text_hashes": [
        "6dd37f98d0235149aac2276f1434f9e93c4f69d3cb71bac6602c42254b11556f"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:8:10",
      "sequence": 22205,
      "chapter_label": "HOS 8",
      "verse_label": "10",
      "locator": {
        "book": "HOS",
        "chapter": 8,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 8,
          "verse": 10
        }
      ],
      "en": "But although they sold themselves among the nations, I will now gather them; and they begin to waste away because of the oppression of the king of mighty ones.",
      "ko": "저희가 열방 사람에게 값을 주었을찌라도 이제 내가 저희를 모으리니 저희가 모든 방백의 임금의 지워준 짐을 인하여 쇠하기 시작하리라",
      "source_text_hash": "ae8072bb0deb970c9e8b15ef20b7be079c1312d6f11cf4acba9e7530b2478c0a",
      "translation_text_hash": "a07ba3eb5cfc37fb593e44d9db72ddbe50abc37ecc183caf157c854a0c55e0f8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 열방 사람에게 값을 주었을찌라도 이제 내가 저희를 모으리니 저희가 모든 방백의 임금의 지워준 짐을 인하여 쇠하기 시작하리라"
      ],
      "raw_text_hashes": [
        "a07ba3eb5cfc37fb593e44d9db72ddbe50abc37ecc183caf157c854a0c55e0f8"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:8:11",
      "sequence": 22206,
      "chapter_label": "HOS 8",
      "verse_label": "11",
      "locator": {
        "book": "HOS",
        "chapter": 8,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "HOS",
          "chapter": 8,
          "verse": 11
        }
      ],
      "en": "Because Ephraim has multiplied altars for sinning, they became for him altars for sinning.",
      "ko": "에브라임이 죄를 위하여 제단을 많이 만들더니 그 제단이 저로 범죄케 하는 것이 되었도다",
      "source_text_hash": "f30d036331ce012d6e7fa0ac4d4583ec1f8638cdb547e0bdc5e874b8c8435f1f",
      "translation_text_hash": "3cfa5814398c5fc0be2874225e12e3909cd1d226e17b3d65337beea251a13e2e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "에브라임이 죄를 위하여 제단을 많이 만들더니 그 제단이 저로 범죄케 하는 것이 되었도다"
      ],
      "raw_text_hashes": [
        "3cfa5814398c5fc0be2874225e12e3909cd1d226e17b3d65337beea251a13e2e"
      ]
    },
    {
      "canonical_locator": "bible:web:HOS:8:12",
      "sequence": 22207,
      "chapter_label": "HOS 8",
      "verse_label": "12",
      "locator": {
        "book": "HOS",
