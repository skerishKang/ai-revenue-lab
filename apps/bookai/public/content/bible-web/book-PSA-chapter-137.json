      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 바벨론의 여러 강변 거기 앉아서 시온을 기억하며 울었도다"
      ],
      "raw_text_hashes": [
        "7213eafda100d65a4f8763af12a7a1e63309e31153b96e8503bccf78a2cf41aa"
      ]
