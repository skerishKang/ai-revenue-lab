      ],
      "en": "How can we sing the LORD’s song in a foreign land?",
      "ko": "우리가 이방에 있어서 어찌 여호와의 노래를 부를꼬",
      "source_text_hash": "20f2c229d4da8ddad42aeeab72f2db3185d1864d76a683d5a5a23de9104599af",
      "translation_text_hash": "e821a3fec7422f6081016868985989c4b8d810a21977b798618635e98845557f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 이방에 있어서 어찌 여호와의 노래를 부를꼬"
      ],
      "raw_text_hashes": [
        "e821a3fec7422f6081016868985989c4b8d810a21977b798618635e98845557f"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:137:5",
