      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 137,
          "verse": 5
        }
      ],
      "en": "If I forget you, Jerusalem, let my right hand forget its skill.",
      "ko": "예루살렘아 내가 너를 잊을찐대 내 오른손이 그 재주를 잊을찌로다",
      "source_text_hash": "d98a7fbc8d30523a9f4fb9c24c8614a451ccc1220ae765b755750233e6dcc14c",
      "translation_text_hash": "df8bd02ecc780f1d3fc6619c89b664fc130085c7f72fdf56aff745cb33a517d2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "예루살렘아 내가 너를 잊을찐대 내 오른손이 그 재주를 잊을찌로다"
      ],
      "raw_text_hashes": [
        "df8bd02ecc780f1d3fc6619c89b664fc130085c7f72fdf56aff745cb33a517d2"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:137:6",
      "sequence": 16229,
      "chapter_label": "PSA 137",
      "verse_label": "6",
      "locator": {
        "book": "PSA",
