      "raw_locator": [
        {
          "book": "ROM",
          "chapter": 15,
          "verse": 4
        }
      ],
      "en": "For whatever things were written before were written for our learning, that through perseverance and through encouragement of the Scriptures we might have hope.",
      "ko": "무엇이든지 전에 기록한 바는 우리의 교훈을 위하여 기록된 것이니 우리로 하여금 인내로 또는 성경의 안위로 소망을 가지게 함이니라",
      "source_text_hash": "c67465200c8fd2003584ca4babd99c041d480c51942b6aa24638e2a881959155",
      "translation_text_hash": "2bfbcaf6f738aeb26882f36179708bea0e8a8a5db11af1ba2db28b1252e4e4cd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "무엇이든지 전에 기록한 바는 우리의 교훈을 위하여 기록된 것이니 우리로 하여금 인내로 또는 성경의 안위로 소망을 가지게 함이니라"
      ],
      "raw_text_hashes": [
        "2bfbcaf6f738aeb26882f36179708bea0e8a8a5db11af1ba2db28b1252e4e4cd"
      ]
