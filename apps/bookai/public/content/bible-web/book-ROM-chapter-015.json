      "source_text_hash": "ef5bc7b35fbe62e139a27d6ddd06bb1a5ca788967279fefabebb64bb39ffd17e",
      "translation_text_hash": "ca0570368a00df4b3df2d1de0f8f7b58f0272c89f4be299834f1f7f85b16c531",
