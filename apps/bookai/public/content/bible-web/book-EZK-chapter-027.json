        {
          "book": "EZK",
          "chapter": 27,
          "verse": 2
        }
      ],
      "en": "“You, son of man, take up a lamentation over Tyre;",
      "ko": "인자야 너는 두로를 위하여 애가를 지으라",
      "source_text_hash": "c5fa35f89755bcd64de67f576835bf6d93b2e62b5f351f959578e6d79d545073",
      "translation_text_hash": "682d07c759b26e781faa3c0b4dde88db5b292ac5bb8defd9bc9df1e9c73342c8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "인자야 너는 두로를 위하여 애가를 지으라"
      ],
      "raw_text_hashes": [
        "682d07c759b26e781faa3c0b4dde88db5b292ac5bb8defd9bc9df1e9c73342c8"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:3",
      "sequence": 21125,
      "chapter_label": "EZK 27",
      "verse_label": "3",
