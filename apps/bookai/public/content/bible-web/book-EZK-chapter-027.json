      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 10
        }
      ],
      "en": "“‘“Persia, Lud, and Put were in your army, your men of war. They hung the shield and helmet in you. They showed your beauty.",
      "ko": "바사와 룻과 붓이 네 군대 가운데서 병정이 되었음이여 네 가운데서 방패와 투구를 달아 네 영광을 나타내었도다",
      "source_text_hash": "2e20c1825eb12a5bc1baddc0cc40b80b9cea0b6ffa29b86fe9ab2227821e742c",
      "translation_text_hash": "8ba9c38bc233c347fd2b9082a44ea9f91b4c5cfd8b96e4857ca07cd31b97ae54",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바사와 룻과 붓이 네 군대 가운데서 병정이 되었음이여 네 가운데서 방패와 투구를 달아 네 영광을 나타내었도다"
      ],
      "raw_text_hashes": [
        "8ba9c38bc233c347fd2b9082a44ea9f91b4c5cfd8b96e4857ca07cd31b97ae54"
