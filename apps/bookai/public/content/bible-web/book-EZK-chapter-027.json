    {
      "canonical_locator": "bible:web:EZK:27:26",
      "sequence": 21148,
      "chapter_label": "EZK 27",
      "verse_label": "26",
      "locator": {
        "book": "EZK",
        "chapter": 27,
        "verse": 26
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 26
        }
      ],
      "en": "Your rowers have brought you into great waters. The east wind has broken you in the heart of the seas.",
      "ko": "네 사공이 너를 인도하여 큰 물에 이름이여 동풍이 바다 중심에서 너를 파하도다",
      "source_text_hash": "b20ba2a4b4e45523010a65e55d79f6d63821c9c7d88acbcfa97eed99380748c3",
      "translation_text_hash": "4e78b0460bb4e15110840e0e994908fc57649011009009bc5b9e75c872d8fea3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 사공이 너를 인도하여 큰 물에 이름이여 동풍이 바다 중심에서 너를 파하도다"
      ],
      "raw_text_hashes": [
        "4e78b0460bb4e15110840e0e994908fc57649011009009bc5b9e75c872d8fea3"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:27",
      "sequence": 21149,
      "chapter_label": "EZK 27",
      "verse_label": "27",
      "locator": {
        "book": "EZK",
        "chapter": 27,
        "verse": 27
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 27
        }
      ],
      "en": "Your riches, your wares, your merchandise, your mariners, your pilots, your repairers of ship seams, the dealers in your merchandise, and all your men of war who are in you, with all your company which is among you, will fall into the heart of the seas in the day of your ruin.",
      "ko": "네 재물과 상품과 무역한 물건과 네 사공과 선장과 네 배의 틈을 막는 자와 네 장사와 네 가운데 있는 모든 용사와 네 가운데 있는 모든 무리가 네 패망하는 날에 다 바다 중심에 빠질 것임이여",
      "source_text_hash": "8b76fdc6b1b6402a6ee483e058cfc89f66d08df3b041796b99d7ce483811c7b8",
      "translation_text_hash": "07f71ad38dfdbae1ae6bf36c09a11b95eb3fc0633e39654a1900a917618b9a5d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 재물과 상품과 무역한 물건과 네 사공과 선장과 네 배의 틈을 막는 자와 네 장사와 네 가운데 있는 모든 용사와 네 가운데 있는 모든 무리가 네 패망하는 날에 다 바다 중심에 빠질 것임이여"
      ],
