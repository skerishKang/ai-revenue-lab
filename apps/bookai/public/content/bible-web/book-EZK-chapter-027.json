        "verse": 5
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 5
        }
      ],
      "en": "They have made all your planks of cypress trees from Senir. They have taken a cedar from Lebanon to make a mast for you.",
      "ko": "스닐의 잣나무로 네 판자를 만들었음이여 너를 위하여 레바논 백향목을 가져 돛대를 만들었도다",
      "source_text_hash": "aeb9c6961bac764c4fba664822d1480e2bfa201dacf81cddca8ebd449088b5e4",
      "translation_text_hash": "b16c72d09784c54073e2400b99cb2ab576c690e02ffc2759f562176e7eadbf92",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "스닐의 잣나무로 네 판자를 만들었음이여 너를 위하여 레바논 백향목을 가져 돛대를 만들었도다"
      ],
      "raw_text_hashes": [
        "b16c72d09784c54073e2400b99cb2ab576c690e02ffc2759f562176e7eadbf92"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:6",
      "sequence": 21128,
      "chapter_label": "EZK 27",
      "verse_label": "6",
      "locator": {
        "book": "EZK",
