      ],
      "en": "The LORD’s word came again to me, saying,",
      "ko": "여호와의 말씀이 내게 임하여 가라사대",
      "source_text_hash": "53317430a9b7a9fdbe9156a35ae512112bae6b6f909738ce12aa74f8e4a71377",
      "translation_text_hash": "2fcb54244475e91bef0fbc3c3374d04d74406d7f7556cf1f7a2dd6aaa6668237",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와의 말씀이 내게 임하여 가라사대"
      ],
      "raw_text_hashes": [
        "2fcb54244475e91bef0fbc3c3374d04d74406d7f7556cf1f7a2dd6aaa6668237"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:2",
      "sequence": 21124,
