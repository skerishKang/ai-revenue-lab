      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 13
        }
      ],
      "en": "“‘“Javan, Tubal, and Meshech were your traders. They traded the persons of men and vessels of bronze for your merchandise.",
      "ko": "야완과 두발과 메섹은 네 장사가 되었음이여 사람과 놋그릇을 가지고 네 상품을 무역하였도다",
      "source_text_hash": "5b3b49b715f3f7cb8e3022bcdb2ad1f7cc81c361d77d9664781ad4404ed5cc09",
      "translation_text_hash": "04ca07b63719c4adb60a836274820b45d24491ae101f1f1e70be1e3b385d0273",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "야완과 두발과 메섹은 네 장사가 되었음이여 사람과 놋그릇을 가지고 네 상품을 무역하였도다"
      ],
      "raw_text_hashes": [
        "04ca07b63719c4adb60a836274820b45d24491ae101f1f1e70be1e3b385d0273"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:14",
      "sequence": 21136,
      "chapter_label": "EZK 27",
      "verse_label": "14",
      "locator": {
        "book": "EZK",
        "chapter": 27,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 14
        }
      ],
      "en": "“‘“They of the house of Togarmah traded for your wares with horses, war horses, and mules.",
      "ko": "도갈마 족속은 말과 전마와 노새를 가지고 네 물품을 무역하며",
