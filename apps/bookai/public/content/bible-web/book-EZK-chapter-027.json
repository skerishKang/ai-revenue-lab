        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 6
        }
      ],
      "en": "They have made your oars of the oaks of Bashan. They have made your benches of ivory inlaid in cypress wood from the islands of Kittim.",
      "ko": "바산 상수리나무로 네 노를 만들었었음이여 깃딤섬 황양목에 상아로 꾸며 갑판을 만들었도다",
      "source_text_hash": "52d8579b7d5a8961d31985e0abfd90c760aee5a0571f7920d75054ba339fd7c4",
      "translation_text_hash": "66879d290ded2619057fe04f3abf891e8bcce90ec80c3b42bc48f4eed46f5ced",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바산 상수리나무로 네 노를 만들었었음이여 깃딤섬 황양목에 상아로 꾸며 갑판을 만들었도다"
      ],
      "raw_text_hashes": [
        "66879d290ded2619057fe04f3abf891e8bcce90ec80c3b42bc48f4eed46f5ced"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:7",
      "sequence": 21129,
      "chapter_label": "EZK 27",
      "verse_label": "7",
      "locator": {
        "book": "EZK",
        "chapter": 27,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 7
        }
      ],
      "en": "Your sail was of fine linen with embroidered work from Egypt, that it might be to you for a banner. Blue and purple from the islands of Elishah was your awning.",
      "ko": "애굽의 수 놓은 가는 베로 돛을 만들어 기를 삼았음이여 엘리사 섬의 청색 자색 베로 차일을 만들었도다",
      "source_text_hash": "a5c60f5dd3725d65cd1f942a583157e477dcc3332b615deb5fdf95af24d8bc40",
      "translation_text_hash": "db23a89a6f38e8a043c8ad7c1541abd8d8ed551c07ee357251fb98a943cc26c6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "애굽의 수 놓은 가는 베로 돛을 만들어 기를 삼았음이여 엘리사 섬의 청색 자색 베로 차일을 만들었도다"
      ],
      "raw_text_hashes": [
        "db23a89a6f38e8a043c8ad7c1541abd8d8ed551c07ee357251fb98a943cc26c6"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:8",
      "sequence": 21130,
      "chapter_label": "EZK 27",
      "verse_label": "8",
      "locator": {
        "book": "EZK",
        "chapter": 27,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 8
        }
      ],
      "en": "The inhabitants of Sidon and Arvad were your rowers. Your wise men, Tyre, were in you. They were your pilots.",
      "ko": "시돈과 아르왓 거민들이 네 사공이 되었음이여 두로야 네 가운데 있는 박사가 네 선장이 되었도다",
      "source_text_hash": "8fd4991f37c8ae2cfe10dad9f885fe5e7754f2f413ebdea37643c0a98314ff01",
      "translation_text_hash": "e0646c6fb0699069094f0f4a3987e949d070a3056aa67adce85f3082aeddf20a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "시돈과 아르왓 거민들이 네 사공이 되었음이여 두로야 네 가운데 있는 박사가 네 선장이 되었도다"
      ],
      "raw_text_hashes": [
        "e0646c6fb0699069094f0f4a3987e949d070a3056aa67adce85f3082aeddf20a"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:27:9",
      "sequence": 21131,
      "chapter_label": "EZK 27",
      "verse_label": "9",
      "locator": {
        "book": "EZK",
        "chapter": 27,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 27,
          "verse": 9
        }
      ],
      "en": "The old men of Gebal and its wise men were your repairers of ship seams in you. All the ships of the sea with their mariners were in you to deal in your merchandise.",
      "ko": "그발의 노인과 박사들이 네 가운데서 배의 틈을 막는 자가 되었음이여 바다의 모든 배와 그 사공들은 네 가운데서 무역하였도다",
      "source_text_hash": "064bf71f56f6fcecbdde538d6b7be7dac319da2393996faa2fdcf1e5deb6d0d2",
      "translation_text_hash": "ff6ea19886cf5833004854136d5b968a4adad90b33188b9a96a73a46b71d08e5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그발의 노인과 박사들이 네 가운데서 배의 틈을 막는 자가 되었음이여 바다의 모든 배와 그 사공들은 네 가운데서 무역하였도다"
      ],
      "raw_text_hashes": [
        "ff6ea19886cf5833004854136d5b968a4adad90b33188b9a96a73a46b71d08e5"
