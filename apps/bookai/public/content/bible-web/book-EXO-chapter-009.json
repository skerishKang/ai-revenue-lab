        "verse": 2
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 9,
          "verse": 2
        }
      ],
      "en": "For if you refuse to let them go, and hold them still,",
      "ko": "네가 만일 그들 보내기를 거절하고 억지로 잡아 두면",
      "source_text_hash": "c89c934a388c69eee1fd4c0201f76d0ac37d32be38ef3ab87c4638a0848eb46b",
      "translation_text_hash": "9a9375353ee170c0a1d8f07695c2a999f7ffb01156cae3f793ac07c8c94ce9ed",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네가 만일 그들 보내기를 거절하고 억지로 잡아 두면"
      ],
      "raw_text_hashes": [
        "9a9375353ee170c0a1d8f07695c2a999f7ffb01156cae3f793ac07c8c94ce9ed"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:9:3",
      "sequence": 1746,
      "chapter_label": "EXO 9",
