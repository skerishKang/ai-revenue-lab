      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "압살롬이 그 누이 다말을 암논이 욕되게 하였으므로 저를 미워하여 시비간에 말하지 아니하니라"
      ],
      "raw_text_hashes": [
