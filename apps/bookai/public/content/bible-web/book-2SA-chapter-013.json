      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 주년 후에 에브라임 곁 바알하솔에서 압살롬의 양털을 깎는 일이 있으매 압살롬이 왕의 모든 아들을 청하고"
      ],
      "raw_text_hashes": [
