      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 길에 있을 때에 압살롬이 왕의 모든 아들을 죽이고 하나도 남기지 아니하였다는 소문이 다윗에게 이르매"
      ],
      "raw_text_hashes": [
