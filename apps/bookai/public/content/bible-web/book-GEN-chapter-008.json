      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이 노아와 그와 함께 방주에 있는 모든 들짐승과 육축을 권념하사 바람으로 땅위에 불게 하시매 물이 감하였고"
      ],
      "raw_text_hashes": [
        "5f4dc38ff3fd7d657db7a166cbfe311a3745ccbc8a821eb8c66e71dc56c2a4d6"
      ]
