      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 8,
          "verse": 15
        }
      ],
      "en": "God spoke to Noah, saying,",
      "ko": "하나님이 노아에게 말씀하여 가라사대",
      "source_text_hash": "13fa0d5169cb70cf2beeb7f54d94f4867a033f2cfeaf84cc31e4373460f63eb9",
