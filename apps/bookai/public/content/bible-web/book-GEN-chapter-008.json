      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 8,
          "verse": 2
        }
      ],
      "en": "The deep’s fountains and the sky’s windows were also stopped, and the rain from the sky was restrained.",
      "ko": "깊음의 샘과 하늘의 창이 막히고 하늘에서 비가 그치매",
      "source_text_hash": "4b03e139ace6077505a833a4a9aeab2a7f2918b0a2272db00d7911d991c377c9",
      "translation_text_hash": "b8833260cb52fb83f76b363ceca15c85e533683e0845b9d0e40262b369d0e187",
      "translation_policy": "krv-1961-source-mapped",
