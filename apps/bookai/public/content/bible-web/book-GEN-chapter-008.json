      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "깊음의 샘과 하늘의 창이 막히고 하늘에서 비가 그치매"
      ],
      "raw_text_hashes": [
        "b8833260cb52fb83f76b363ceca15c85e533683e0845b9d0e40262b369d0e187"
      ]
    },
    {
