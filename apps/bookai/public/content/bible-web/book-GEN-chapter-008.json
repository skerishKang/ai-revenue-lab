      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 8,
          "verse": 5
        }
      ],
      "en": "The waters receded continually until the tenth month. In the tenth month, on the first day of the month, the tops of the mountains were visible.",
      "ko": "물이 점점 감하여 시월 곧 그달 일일에 산들의 봉우리가 보였더라",
      "source_text_hash": "6b1b632caf3022f00c037649b9f5c99f3f92754587cc786cb0e8b1f41c91ffe1",
      "translation_text_hash": "5a8fe4bd4d2015a9652052d1ee953876302d409c025e19b52ac60e3ff1cb719f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "물이 점점 감하여 시월 곧 그달 일일에 산들의 봉우리가 보였더라"
      ],
      "raw_text_hashes": [
        "5a8fe4bd4d2015a9652052d1ee953876302d409c025e19b52ac60e3ff1cb719f"
      ]
    },
    {
