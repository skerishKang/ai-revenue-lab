      ],
      "raw_text_hashes": [
        "8c5fdcd7f42010570d965a87fa2207bd57bca227337861c5455ee931545a3364"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:8:11",
      "sequence": 195,
      "chapter_label": "GEN 8",
      "verse_label": "11",
      "locator": {
