        {
          "book": "GEN",
          "chapter": 8,
          "verse": 6
        }
      ],
      "en": "At the end of forty days, Noah opened the window of the ship which he had made,",
      "ko": "사십일을 지나서 노아가 그 방주에 지은 창을 열고",
      "source_text_hash": "6547dfeeb4165973748cafe96dfaedbd1ab804182466247ed9ca59fd4236fcfd",
      "translation_text_hash": "549159ea5ffdb706866d91d01fcbe921a70951dd9c3f523438f5ff55d43a80e3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사십일을 지나서 노아가 그 방주에 지은 창을 열고"
      ],
      "raw_text_hashes": [
        "549159ea5ffdb706866d91d01fcbe921a70951dd9c3f523438f5ff55d43a80e3"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:8:7",
