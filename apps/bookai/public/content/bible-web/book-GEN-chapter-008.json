      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이월 이십칠일에 땅이 말랐더라"
      ],
      "raw_text_hashes": [
