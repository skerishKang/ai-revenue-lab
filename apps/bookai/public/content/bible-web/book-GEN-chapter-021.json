      "raw_texts": [
        "아브라함이 그 아들을 위하여 그 일이 깊이 근심이 되었더니"
      ],
      "raw_text_hashes": [
        "d1a4e208b4d0195129b112b8f04dfcbcd8e7355dfea92772497c2809f5da8fef"
      ]
