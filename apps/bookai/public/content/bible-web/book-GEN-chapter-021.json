      ],
      "en": "Abraham circumcised his son, Isaac, when he was eight days old, as God had commanded him.",
      "ko": "그 아들 이삭이 난지 팔일만에 그가 하나님의 명대로 할례를 행하였더라",
      "source_text_hash": "4d7b4fcce0d1d33afe5be789048b2f0a4e7f0fd439d1dfb98dc568d2ba160e35",
      "translation_text_hash": "5c5706d2f3bc424762b86146b1135d95420f06a146aa9ae043ead0e1dee7201a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 아들 이삭이 난지 팔일만에 그가 하나님의 명대로 할례를 행하였더라"
      ],
      "raw_text_hashes": [
        "5c5706d2f3bc424762b86146b1135d95420f06a146aa9ae043ead0e1dee7201a"
      ]
    },
