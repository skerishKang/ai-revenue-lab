      ],
      "en": "Abraham was one hundred years old when his son, Isaac, was born to him.",
      "ko": "아브라함이 그 아들 이삭을 낳을 때에 백세라",
      "source_text_hash": "8a138482e18be25c9e34c05e99744851c22c22a59379e0079320979e76094abd",
      "translation_text_hash": "21e6434a1429f06aff3c1ce19c266b807523d824c3c3b09f4861a3b103dd2025",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브라함이 그 아들 이삭을 낳을 때에 백세라"
      ],
      "raw_text_hashes": [
        "21e6434a1429f06aff3c1ce19c266b807523d824c3c3b09f4861a3b103dd2025"
      ]
    },
    {
