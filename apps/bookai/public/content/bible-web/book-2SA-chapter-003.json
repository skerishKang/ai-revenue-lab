    {
      "canonical_locator": "bible:web:2SA:3:20",
      "sequence": 8102,
      "chapter_label": "2SA 3",
      "verse_label": "20",
      "locator": {
        "book": "2SA",
        "chapter": 3,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 3,
          "verse": 20
        }
      ],
      "en": "So Abner came to David to Hebron, and twenty men with him. David made Abner and the men who were with him a feast.",
      "ko": "아브넬이 종자 이십인으로 더불어 헤브론에 이르러 다윗에게 나아가니 다윗이 아브넬과 그 함께한 사람을 위하여 잔치를 배설하였더라",
      "source_text_hash": "37b655103703e0e4d66b1f475653b59fef4f8eb933a848b63992e438b1a8d035",
      "translation_text_hash": "c4f1945a0c0711973a3b551fb2dfb6e570c79572a787e80da4673eb20b8b7994",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브넬이 종자 이십인으로 더불어 헤브론에 이르러 다윗에게 나아가니 다윗이 아브넬과 그 함께한 사람을 위하여 잔치를 배설하였더라"
      ],
      "raw_text_hashes": [
