      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 남편이 저와 함께 오되 울며 바후림까지 따라 왔더니 아브넬이 저에게 돌아가라 하매 돌아가니라"
      ],
      "raw_text_hashes": [
        "e570337ee0e965d2785fc01248c2906b682b1faa2b6fce69e9fbde97d4ea0e67"
