      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사울의 집과 다윗의 집 사이에 전쟁이 오래매 다윗은 점점 강하여가고 사울의 집은 점점 약하여 가니라"
      ],
      "raw_text_hashes": [
        "c2084c2689e116559e8bb6dca90687918a9d48ecd3fabaa0ad10a28dab0212e9"
      ]
