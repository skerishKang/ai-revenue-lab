    {
      "canonical_locator": "bible:web:2SA:3:22",
      "sequence": 8104,
      "chapter_label": "2SA 3",
      "verse_label": "22",
      "locator": {
        "book": "2SA",
        "chapter": 3,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 3,
          "verse": 22
        }
      ],
      "en": "Behold, David’s servants and Joab came from a raid and brought in a great plunder with them; but Abner was not with David in Hebron, for he had sent him away, and he had gone in peace.",
      "ko": "다윗의 신복들과 요압이 적군을 치고 크게 노략한 물건을 가지고 돌아오니 아브넬은 이미 보냄을 받아 평안히 갔고 다윗과 함께 헤브론에 있지 아니한 때라",
      "source_text_hash": "5c7d8933b3322ed201356fa4c02d2ed754409b6598eb5399b970967a331fa6cb",
      "translation_text_hash": "538fe6f33f2b958fd6fec9d29bdc1eba1b27de74308baa94b05dc016f5b1ec43",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "다윗의 신복들과 요압이 적군을 치고 크게 노략한 물건을 가지고 돌아오니 아브넬은 이미 보냄을 받아 평안히 갔고 다윗과 함께 헤브론에 있지 아니한 때라"
      ],
      "raw_text_hashes": [
