    {
      "canonical_locator": "bible:web:2SA:3:24",
      "sequence": 8106,
      "chapter_label": "2SA 3",
      "verse_label": "24",
      "locator": {
        "book": "2SA",
        "chapter": 3,
        "verse": 24
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 3,
          "verse": 24
        }
      ],
      "en": "Then Joab came to the king and said, “What have you done? Behold, Abner came to you. Why is it that you have sent him away, and he is already gone?",
      "ko": "요압이 왕에게 나아가 가로되 어찌 하심이니이까 아브넬이 왕에게 나아왔거늘 어찌하여 저를 보내어 잘 가게 하셨나이까",
      "source_text_hash": "70a1ac7991d39657a88e6268b8bae842c0a622caacbab36a748d849bc1b46459",
      "translation_text_hash": "1c0698c80b346cf1bbad6f34c9056584d9dab423990bfd05136cd76f5629db64",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요압이 왕에게 나아가 가로되 어찌 하심이니이까 아브넬이 왕에게 나아왔거늘 어찌하여 저를 보내어 잘 가게 하셨나이까"
      ],
      "raw_text_hashes": [
        "1c0698c80b346cf1bbad6f34c9056584d9dab423990bfd05136cd76f5629db64"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:3:25",
      "sequence": 8107,
      "chapter_label": "2SA 3",
      "verse_label": "25",
      "locator": {
        "book": "2SA",
        "chapter": 3,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 3,
          "verse": 25
        }
      ],
      "en": "You know Abner the son of Ner. He came to deceive you, and to know your going out and your coming in, and to know all that you do.”",
      "ko": "왕도 아시려니와 넬의 아들 아브넬의 온 것은 왕을 속임이라 왕의 출입하는 것을 알고 모든 하시는 것을 알려 함이니이다 하고",
      "source_text_hash": "6606cea16818eaceb8cb05f2fa90897f2c8c45fe08798bd210ad2bdd43603e7e",
      "translation_text_hash": "145aa3019356f0f99bfe2def6fa9380a9e4251180c87b32e817946e6a0b65461",
