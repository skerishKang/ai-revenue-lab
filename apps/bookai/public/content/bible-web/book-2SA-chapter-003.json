    {
      "canonical_locator": "bible:web:2SA:3:19",
      "sequence": 8101,
      "chapter_label": "2SA 3",
      "verse_label": "19",
      "locator": {
        "book": "2SA",
        "chapter": 3,
        "verse": 19
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 3,
          "verse": 19
        }
      ],
      "en": "Abner also spoke in the ears of Benjamin; and Abner went also to speak in the ears of David in Hebron all that seemed good to Israel and to the whole house of Benjamin.",
      "ko": "아브넬이 또 베냐민 사람의 귀에 말하고 이스라엘과 베냐민의 온 집이 선히 여기는 모든 것을 다윗의 귀에 고하려고 헤브론으로 가니라",
      "source_text_hash": "2f5aa5c874a1935340a77274ba408cb731c9b26b0f47162579d88bfd84efcbf5",
      "translation_text_hash": "75e4b2afa15f30c09d552bfee5d6dea0b71444bcdc6c0a1c24a7ffe79a14ce47",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브넬이 또 베냐민 사람의 귀에 말하고 이스라엘과 베냐민의 온 집이 선히 여기는 모든 것을 다윗의 귀에 고하려고 헤브론으로 가니라"
      ],
      "raw_text_hashes": [
