    {
      "canonical_locator": "bible:web:2SA:3:23",
      "sequence": 8105,
      "chapter_label": "2SA 3",
      "verse_label": "23",
      "locator": {
        "book": "2SA",
        "chapter": 3,
        "verse": 23
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 3,
          "verse": 23
        }
      ],
      "en": "When Joab and all the army who was with him had come, they told Joab, “Abner the son of Ner came to the king, and he has sent him away, and he has gone in peace.”",
      "ko": "요압과 그 함께한 모든 군사가 돌아오매 혹이 요압에게 고하여 가로되 넬의 아들 아브넬이 왕에게 왔더니 왕이 보내매 저가 평안히 갔나이다",
      "source_text_hash": "78e1b1fb4a261edf8317eead11bbdbf58a13e95cad1ecdb4be6a76ed02c7e4a1",
      "translation_text_hash": "8f3476da46772b1d0c9a485a46ef453b4910e2381fb94810bff5cecee6ebb0fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "요압과 그 함께한 모든 군사가 돌아오매 혹이 요압에게 고하여 가로되 넬의 아들 아브넬이 왕에게 왔더니 왕이 보내매 저가 평안히 갔나이다"
      ],
      "raw_text_hashes": [
