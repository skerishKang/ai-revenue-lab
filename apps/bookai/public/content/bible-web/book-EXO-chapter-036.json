        "verse": 10
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 36,
          "verse": 10
        }
      ],
      "en": "He coupled five curtains to one another, and the other five curtains he coupled to one another.",
      "ko": "그 다섯 폭을 서로 연하며 또 그 다섯 폭을 서로 연하고",
      "source_text_hash": "c29d8ef7cd3e37ad09d0a2100cdb6cd6c1a8c2be4fb11b76d0986d0a1572172d",
      "translation_text_hash": "dd25eea42a6130464c67da5b55ef7da7223c91717afc324d37f770681e20d8ae",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 다섯 폭을 서로 연하며 또 그 다섯 폭을 서로 연하고"
      ],
      "raw_text_hashes": [
        "dd25eea42a6130464c67da5b55ef7da7223c91717afc324d37f770681e20d8ae"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:36:11",
      "sequence": 2578,
      "chapter_label": "EXO 36",
      "verse_label": "11",
      "locator": {
