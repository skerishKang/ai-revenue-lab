        "verse": 9
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 36,
          "verse": 9
        }
      ],
      "en": "The length of each curtain was twenty-eight cubits, and the width of each curtain four cubits. All the curtains had one measure.",
      "ko": "매폭의 장은 이십팔 규빗, 광은 사 규빗으로 각 폭의 장단을 같게 하여",
      "source_text_hash": "f3c73b03fe918472875e3eafdca72a3802e6fc76aca2538a09addd23eecf641d",
      "translation_text_hash": "d528adc45345266b9c6c33c494871570f684563b4027deee05ac2bf2bb7c89cc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "매폭의 장은 이십팔 규빗, 광은 사 규빗으로 각 폭의 장단을 같게 하여"
      ],
      "raw_text_hashes": [
        "d528adc45345266b9c6c33c494871570f684563b4027deee05ac2bf2bb7c89cc"
      ]
    },
    {
