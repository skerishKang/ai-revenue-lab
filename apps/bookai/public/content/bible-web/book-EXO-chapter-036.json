        "verse": 12
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 36,
          "verse": 12
        }
      ],
      "en": "He made fifty loops in the one curtain, and he made fifty loops in the edge of the curtain that was in the second coupling. The loops were opposite to one another.",
      "ko": "그 연락할 한 폭에 고 오십을 달고 다른 연락할 한 폭의 가에도 고 오십을 달아 그 고들이 서로 대하게 하고",
      "source_text_hash": "c2bbab928fe63af6d49d00403963b6b0198fa62df33dd72086a7bd46a5963d0d",
      "translation_text_hash": "7e76a83cf0c9303b8592038a8da7f4e2e0cf42d0aeb2d17fa2274d285e0c4b76",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 연락할 한 폭에 고 오십을 달고 다른 연락할 한 폭의 가에도 고 오십을 달아 그 고들이 서로 대하게 하고"
      ],
      "raw_text_hashes": [
        "7e76a83cf0c9303b8592038a8da7f4e2e0cf42d0aeb2d17fa2274d285e0c4b76"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:36:13",
      "sequence": 2580,
      "chapter_label": "EXO 36",
      "verse_label": "13",
      "locator": {
        "book": "EXO",
        "chapter": 36,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 36,
          "verse": 13
        }
      ],
      "en": "He made fifty clasps of gold, and coupled the curtains to one another with the clasps: so the tabernacle was a unit.",
      "ko": "금 갈고리 오십을 만들어 그 갈고리로 두 앙장을 연하여 한 막을 이루었더라",
      "source_text_hash": "f3568db66203740b04a8c6ffbcd44f94738ab699c8796895d51714add95d32cc",
      "translation_text_hash": "21d24ff069536c158756507a2862f06d5412945a75319626c0c8935866500329",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "금 갈고리 오십을 만들어 그 갈고리로 두 앙장을 연하여 한 막을 이루었더라"
      ],
      "raw_text_hashes": [
        "21d24ff069536c158756507a2862f06d5412945a75319626c0c8935866500329"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:36:14",
      "sequence": 2581,
      "chapter_label": "EXO 36",
      "verse_label": "14",
      "locator": {
