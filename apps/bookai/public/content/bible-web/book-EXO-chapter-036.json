        "verse": 11
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 36,
          "verse": 11
        }
      ],
      "en": "He made loops of blue on the edge of the one curtain from the edge in the coupling. Likewise he made in the edge of the curtain that was outermost in the second coupling.",
      "ko": "연락할 말폭 가에 청색 고를 만들며 다른 연락할 말폭 가에도 고를 만들되",
      "source_text_hash": "9f48438c906f8899caec5e5731f2e244611eb87cb92f76b0ac5c5d8b51e5dda5",
      "translation_text_hash": "2316105461644703ed60b42c98fe537a16c6ff4acf99acbc0bddb77932f9b593",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "연락할 말폭 가에 청색 고를 만들며 다른 연락할 말폭 가에도 고를 만들되"
      ],
      "raw_text_hashes": [
        "2316105461644703ed60b42c98fe537a16c6ff4acf99acbc0bddb77932f9b593"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:36:12",
      "sequence": 2579,
      "chapter_label": "EXO 36",
      "verse_label": "12",
      "locator": {
        "book": "EXO",
