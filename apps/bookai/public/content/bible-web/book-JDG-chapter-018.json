      "raw_texts": [
        "그들이 돌이켜서 어린 아이들과 가축과 물품을 앞에 두고 진행하더니"
      ],
      "raw_text_hashes": [
        "c7d865cdfbfa5f67ee9c1280158fba9cd386332d75807e63875a62a3f148c4a5"
