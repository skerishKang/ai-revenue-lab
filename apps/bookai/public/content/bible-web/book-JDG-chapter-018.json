        }
      ],
      "en": "The six hundred men armed with their weapons of war, who were of the children of Dan, stood by the entrance of the gate.",
      "ko": "단 자손 육백명은 병기를 띠고 문 입구에 서니라",
      "source_text_hash": "0f1b90c4ea7b4038069a9d40bd0ad00038250c0fe67726efbcd0e96c0580d7b2",
      "translation_text_hash": "c99865649cbf57bbb0d60ef2a3134ca54ef6f4bee6e68fb13d7d9b5d5e03c387",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "단 자손 육백명은 병기를 띠고 문 입구에 서니라"
      ],
      "raw_text_hashes": [
        "c99865649cbf57bbb0d60ef2a3134ca54ef6f4bee6e68fb13d7d9b5d5e03c387"
      ]
