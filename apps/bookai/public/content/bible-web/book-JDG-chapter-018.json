    {
      "canonical_locator": "bible:web:JDG:18:25",
      "sequence": 7019,
      "chapter_label": "JDG 18",
      "verse_label": "25",
      "locator": {
        "book": "JDG",
        "chapter": 18,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 18,
          "verse": 25
        }
      ],
      "en": "The children of Dan said to him, “Don’t let your voice be heard among us, lest angry fellows fall on you, and you lose your life, with the lives of your household.”",
      "ko": "단 자손이 그에게 이르되 네 목소리를 우리에게 들리게 말라 노한 자들이 너희를 쳐서 네 생명과 네 가족의 생명을 잃게 할까 하노라 하고",
      "source_text_hash": "e90fb7616d037128ff47adb8687b9badf13677845cda2e1700859c943bb1353c",
      "translation_text_hash": "0eee5f442b9686ade3f75e7d230e402e71b20d65416c2dee3d1090d83ffe5de6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "단 자손이 그에게 이르되 네 목소리를 우리에게 들리게 말라 노한 자들이 너희를 쳐서 네 생명과 네 가족의 생명을 잃게 할까 하노라 하고"
      ],
      "raw_text_hashes": [
