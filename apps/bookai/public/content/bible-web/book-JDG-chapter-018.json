      "sequence": 7012,
      "chapter_label": "JDG 18",
      "verse_label": "18",
      "locator": {
        "book": "JDG",
        "chapter": 18,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "JDG",
          "chapter": 18,
          "verse": 18
        }
      ],
      "en": "When these went into Micah’s house, and took the engraved image, the ephod, the teraphim, and the molten image, the priest said to them, “What are you doing?”",
      "ko": "그 다섯 사람이 미가의 집에 들어가서 그 새긴 신상과 에봇과 드라빔과 부어만든 신상을 취하여 내매 제사장이 그들에게 묻되 너희가 무엇을 하느냐",
      "source_text_hash": "5ae7fd8a8b9bd8155058a07bdaae021cfd446f3dc45fcc5f07725abc9bd9a29b",
      "translation_text_hash": "10afff845132c02de62d54a5c4e240516444e4abe1349a5f29c43d64acbf6c77",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 다섯 사람이 미가의 집에 들어가서 그 새긴 신상과 에봇과 드라빔과 부어만든 신상을 취하여 내매 제사장이 그들에게 묻되 너희가 무엇을 하느냐"
      ],
      "raw_text_hashes": [
        "10afff845132c02de62d54a5c4e240516444e4abe1349a5f29c43d64acbf6c77"
      ]
