      ],
      "en": "I made myself pools of water, to water the forest where trees were grown.",
      "ko": "수목을 기르는 삼림에 물주기 위하여 못을 팠으며",
      "source_text_hash": "58677390eca0f9ef8703b3a3677faeaea1fbcf52493f2ef61eeea759652a86f2",
      "translation_text_hash": "fd87de431335fc5a6381ef566035640e252656adcdbc7b5f2ec3b26878033353",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
