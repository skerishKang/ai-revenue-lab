      "raw_texts": [
        "이러므로 내가 해 아래서 수고한 모든 수고에 대하여 도리어 마음으로 실망케 하였도다"
      ],
      "raw_text_hashes": [
        "e09c4b3b970d890888500bb0ee7466bfdc9e5de2f453dc0666b3b9fb6685d572"
      ]
