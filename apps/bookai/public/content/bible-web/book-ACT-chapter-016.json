      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바울이 더베와 루스드라에도 이르매 거기 디모데라 하는 제자가 있으니 그 모친은 믿는 유대 여자요 부친은 헬라인이라"
      ],
      "raw_text_hashes": [
