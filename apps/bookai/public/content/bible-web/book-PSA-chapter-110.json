      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 내 주에게 말씀하시기를 내가 네 원수로 네 발등상 되게 하기까지 너는 내 우편에 앉으라 하셨도다"
      ],
      "raw_text_hashes": [
