    {
      "canonical_locator": "bible:web:ISA:41:11",
      "sequence": 18463,
      "chapter_label": "ISA 41",
      "verse_label": "11",
      "locator": {
        "book": "ISA",
        "chapter": 41,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 41,
          "verse": 11
        }
      ],
      "en": "Behold, all those who are incensed against you will be disappointed and confounded. Those who strive with you will be like nothing, and shall perish.",
      "ko": "보라 네게 노하던 자들이 수치와 욕을 당할 것이요 너와 다투는 자들이 아무 것도 아닌 것 같이 될 것이며 멸망할 것이라",
      "source_text_hash": "3debfc876a6a911beef6adedfff89b1b717a7d4d006b84d723ed04b4cd174673",
      "translation_text_hash": "7777187d5fab9ccdaceef38e42d7cea47f672e8bc69c2f2f3d8a312bf26c2f2f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "보라 네게 노하던 자들이 수치와 욕을 당할 것이요 너와 다투는 자들이 아무 것도 아닌 것 같이 될 것이며 멸망할 것이라"
      ],
      "raw_text_hashes": [
        "7777187d5fab9ccdaceef38e42d7cea47f672e8bc69c2f2f3d8a312bf26c2f2f"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:41:12",
      "sequence": 18464,
      "chapter_label": "ISA 41",
      "verse_label": "12",
      "locator": {
        "book": "ISA",
