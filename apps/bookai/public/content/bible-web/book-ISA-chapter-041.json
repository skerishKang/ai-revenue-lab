      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 41,
          "verse": 3
        }
      ],
      "en": "He pursues them and passes by safely, even by a way that he had not gone with his feet.",
      "ko": "그가 그들을 쫓아서 그 발로 가 보지 못한 길을 안전히 지났나니",
      "source_text_hash": "54e89cbe6c50af26fbf0979f2a3a194b46cd7da5d8cbb9a6d8adae00058ae978",
      "translation_text_hash": "89b03fd2d519771e62aa0eea75b9d85e27653d45ffb01f1139cf10bfb8f82947",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그가 그들을 쫓아서 그 발로 가 보지 못한 길을 안전히 지났나니"
      ],
      "raw_text_hashes": [
        "89b03fd2d519771e62aa0eea75b9d85e27653d45ffb01f1139cf10bfb8f82947"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:41:4",
      "sequence": 18456,
      "chapter_label": "ISA 41",
