        "verse": 6
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 41,
          "verse": 6
        }
      ],
      "en": "Everyone helps his neighbor. They say to their brothers, “Be strong!”",
      "ko": "각기 이웃을 도우며 그 형제에게 이르기를 너는 담대하라 하고",
      "source_text_hash": "84cb0736855efa68360d1b2768eff794c09fa09ae024356621e644a4e059b27c",
      "translation_text_hash": "c8c836a4abd15078f9a3231b2a9bd102b184d67d47a379a0088cdfb1a75860ac",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "각기 이웃을 도우며 그 형제에게 이르기를 너는 담대하라 하고"
      ],
      "raw_text_hashes": [
        "c8c836a4abd15078f9a3231b2a9bd102b184d67d47a379a0088cdfb1a75860ac"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:41:7",
      "sequence": 18459,
      "chapter_label": "ISA 41",
      "verse_label": "7",
      "locator": {
