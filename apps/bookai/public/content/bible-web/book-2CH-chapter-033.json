      ],
      "en": "His servants conspired against him, and put him to death in his own house.",
      "ko": "그 신복이 반역하여 왕을 궁중에서 죽이매",
      "source_text_hash": "dc76161e3bcfc2a479ef4ede9c5fbe9f1b400234b394180ed16f9c5913dd9fa6",
      "translation_text_hash": "08436f163371b2c808c9194143e7f4f743b3ca468729f54108343aff884c097b",
      "translation_policy": "krv-1961-source-mapped",
