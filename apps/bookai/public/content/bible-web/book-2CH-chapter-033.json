      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "므낫세가 그 열조와 함께 자매 그 궁에 장사하고 그 아들 아몬이 대신하여 왕이 되니라"
      ],
      "raw_text_hashes": [
        "124b452f37db4ddf4d0675bd27fc0608587c5fe0f2af51cede30f4ad4da4ee8b"
      ]
