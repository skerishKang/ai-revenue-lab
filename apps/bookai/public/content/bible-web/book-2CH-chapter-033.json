      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 33,
          "verse": 18
        }
      ],
      "en": "Now the rest of the acts of Manasseh, and his prayer to his God, and the words of the seers who spoke to him in the name of the LORD, the God of Israel, behold, they are written among the acts of the kings of Israel.",
      "ko": "므낫세의 남은 사적과 그 하나님께 기도한 말씀과 선견자가 이스라엘 하나님 여호와의 이름을 받들고 권한 말씀이 모두 이스라엘 열왕의 행장에 기록되었고",
      "source_text_hash": "397f7d4bea4c115763fd6eef6e62fd0f525f0d62b073d0214f37e7a6637ae281",
      "translation_text_hash": "1efb447a6cb9c40ad6fdfe4ce113b375e4fda23b0867fd2e8e4958e3192bbc98",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "므낫세의 남은 사적과 그 하나님께 기도한 말씀과 선견자가 이스라엘 하나님 여호와의 이름을 받들고 권한 말씀이 모두 이스라엘 열왕의 행장에 기록되었고"
      ],
      "raw_text_hashes": [
