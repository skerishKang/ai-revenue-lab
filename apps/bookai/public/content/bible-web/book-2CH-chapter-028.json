        "verse": 2
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 28,
          "verse": 2
        }
      ],
      "en": "but he walked in the ways of the kings of Israel, and also made molten images for the Baals.",
      "ko": "이스라엘 열왕의 길로 행하여 바알들의 우상을 부어만들고",
      "source_text_hash": "0b6d3f0223769437e0ee63e24a2b4cddedb7a322b046eb3461d7c7773f1fb0b8",
      "translation_text_hash": "2cb754b953e4c3b98d43daac61c7206186751024fc8636dc6c8a3c2f6e87711f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 열왕의 길로 행하여 바알들의 우상을 부어만들고"
      ],
      "raw_text_hashes": [
        "2cb754b953e4c3b98d43daac61c7206186751024fc8636dc6c8a3c2f6e87711f"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:28:3",
      "sequence": 11768,
      "chapter_label": "2CH 28",
