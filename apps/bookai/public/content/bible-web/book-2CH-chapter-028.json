    {
      "canonical_locator": "bible:web:2CH:28:6",
      "sequence": 11771,
      "chapter_label": "2CH 28",
      "verse_label": "6",
      "locator": {
        "book": "2CH",
        "chapter": 28,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 28,
          "verse": 6
        }
      ],
      "en": "For Pekah the son of Remaliah killed in Judah one hundred twenty thousand in one day, all of them valiant men, because they had forsaken the LORD, the God of their fathers.",
      "ko": "이는 그 열조의 하나님 여호와를 버렸음이라 르말랴의 아들 베가가 유다에서 하루 동안에 용사 십 이만명을 죽였으며",
      "source_text_hash": "e33bf0da1cdc87c1f5ce7b02ced7b668c21faf282caf3164743375aa0ba45b3d",
      "translation_text_hash": "39803698e25f4c24f167b7cdf5e4c459ebfebd709253daa242d24c7edf27794a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 그 열조의 하나님 여호와를 버렸음이라 르말랴의 아들 베가가 유다에서 하루 동안에 용사 십 이만명을 죽였으며"
      ],
      "raw_text_hashes": [
        "39803698e25f4c24f167b7cdf5e4c459ebfebd709253daa242d24c7edf27794a"
      ]
