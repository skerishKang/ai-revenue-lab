      "raw_locator": [
        {
          "book": "1CO",
          "chapter": 9,
          "verse": 3
        }
      ],
      "en": "My defense to those who examine me is this:",
      "ko": "나를 힐문하는 자들에게 발명할 것이 이것이니",
      "source_text_hash": "11721dd2082fafb586e1cdb7249045f00b299c7c699a33e9b9f467d5b89b50da",
      "translation_text_hash": "acbd229e2a6e8f87aff73ebad9f0e29228fd8a03a0630387f6194ee629654c98",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나를 힐문하는 자들에게 발명할 것이 이것이니"
      ],
      "raw_text_hashes": [
        "acbd229e2a6e8f87aff73ebad9f0e29228fd8a03a0630387f6194ee629654c98"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:9:4",
      "sequence": 28541,
      "chapter_label": "1CO 9",
      "verse_label": "4",
      "locator": {
        "book": "1CO",
