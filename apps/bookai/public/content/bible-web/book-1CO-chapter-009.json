      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 모든 사람에게 자유하였으나 스스로 모든 사람에게 종이 된 것은 더 많은 사람을 얻고자 함이라"
      ],
      "raw_text_hashes": [
        "14d88ac2ec558415cca0f682a39fa007e93f1e14e1ca076ae1c760e92cc98a71"
