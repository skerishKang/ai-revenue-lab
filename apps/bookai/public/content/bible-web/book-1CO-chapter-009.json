      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 복음을 위하여 모든 것을 행함은 복음에 참예하고자 함이라"
      ],
      "raw_text_hashes": [
        "a69df69f594297e7715d0962c40cb6a1ccfc9348e1ea0263a6abf2415e2dd5ea"
      ]
    },
    {
      "canonical_locator": "bible:web:1CO:9:24",
      "sequence": 28561,
      "chapter_label": "1CO 9",
      "verse_label": "24",
      "locator": {
        "book": "1CO",
