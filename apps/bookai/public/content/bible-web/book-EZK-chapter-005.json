        {
          "book": "EZK",
          "chapter": 5,
          "verse": 3
        }
      ],
      "en": "You shall take a small number of these and bind them in the folds of your robe.",
      "ko": "너는 터럭 중에서 조금을 가져 네 옷자락에 싸고",
      "source_text_hash": "bbb7b9f3adb61fe5d15716792fd64ff4f1d59d00b34a3af0314c345e8668290d",
      "translation_text_hash": "9fd16f40b712d22abaac70fd5de3dacc0265691718fb08bdd2e0db0cdfa3df24",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너는 터럭 중에서 조금을 가져 네 옷자락에 싸고"
      ],
      "raw_text_hashes": [
        "9fd16f40b712d22abaac70fd5de3dacc0265691718fb08bdd2e0db0cdfa3df24"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:5:4",
      "sequence": 20551,
      "chapter_label": "EZK 5",
      "verse_label": "4",
      "locator": {
        "book": "EZK",
