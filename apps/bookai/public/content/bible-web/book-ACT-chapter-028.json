      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "유대인들이 반대하기로 내가 마지못하여 가이사에게 호소함이요 내 민족을 송사하려는 것이 아니로라"
      ],
      "raw_text_hashes": [
