      "ko": "수라구사에 대고 사흘을 있다가",
      "source_text_hash": "15fbafaabb71376bfbcdb9aae6fdcae0ecd3f5ffd312ff51df7008395ea63b3b",
      "translation_text_hash": "c0d80302fe6fbf9a5997e7ae48588aaab93dd4db9ad933a884f6d07470e237af",
      "translation_policy": "krv-1961-source-mapped",
