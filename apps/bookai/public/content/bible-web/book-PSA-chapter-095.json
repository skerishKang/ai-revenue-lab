      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "땅의 깊은 곳이 그 위에 있으며 산들의 높은 것도 그의 것이로다"
      ],
      "raw_text_hashes": [
        "992e0f536cbbc87795d49f45fbc3de83b9871f5feb399695bad49db5d4b1977b"
      ]
