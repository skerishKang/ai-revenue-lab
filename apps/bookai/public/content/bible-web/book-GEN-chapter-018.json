      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 18,
          "verse": 4
        }
      ],
      "en": "Now let a little water be fetched, wash your feet, and rest yourselves under the tree.",
      "ko": "물을 조금 가져오게 하사 당신들의 발을 씻으시고 나무 아래서 쉬소서",
      "source_text_hash": "ae3fa03abe352891ae444330326773c6d6bdd467a94c1febfb034370944d762e",
      "translation_text_hash": "b058723bdd008fdd26390109c35bca6a18fc7f9cb38fa7e81e14eb8325e1223f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "물을 조금 가져오게 하사 당신들의 발을 씻으시고 나무 아래서 쉬소서"
      ],
      "raw_text_hashes": [
        "b058723bdd008fdd26390109c35bca6a18fc7f9cb38fa7e81e14eb8325e1223f"
      ]
