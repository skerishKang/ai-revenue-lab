      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 18,
          "verse": 11
        }
      ],
      "en": "Now Abraham and Sarah were old, well advanced in age. Sarah had passed the age of childbearing.",
      "ko": "아브라함과 사라가 나이 많아 늙었고 사라의 경수는 끊어졌는지라",
      "source_text_hash": "8477add019e8be7899028668ed0aaa61229527d1fbf78c851e3478f786179248",
      "translation_text_hash": "b33748f26a8b2031102a9bf1cab71bca7b54a07498ae6ff857f1373c260d1687",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브라함과 사라가 나이 많아 늙었고 사라의 경수는 끊어졌는지라"
      ],
      "raw_text_hashes": [
        "b33748f26a8b2031102a9bf1cab71bca7b54a07498ae6ff857f1373c260d1687"
      ]
    },
    {
      "canonical_locator": "bible:web:GEN:18:12",
      "sequence": 437,
      "chapter_label": "GEN 18",
      "verse_label": "12",
      "locator": {
        "book": "GEN",
