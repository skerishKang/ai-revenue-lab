        {
          "book": "JAS",
          "chapter": 1,
          "verse": 3
        }
      ],
      "en": "knowing that the testing of your faith produces endurance.",
      "ko": "이는 너희 믿음의 시련이 인내를 만들어 내는줄 너희가 앎이라",
      "source_text_hash": "a413cc8d9c1ca5e83a401f7e19a71af3f18b4cc2ab5a499764aa63f142419076",
      "translation_text_hash": "de98baebc9d12a6c1c33f053841966ee2d805ab8edc59f307621dabee4e1f420",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 너희 믿음의 시련이 인내를 만들어 내는줄 너희가 앎이라"
      ],
      "raw_text_hashes": [
        "de98baebc9d12a6c1c33f053841966ee2d805ab8edc59f307621dabee4e1f420"
      ]
    },
    {
      "canonical_locator": "bible:web:JAS:1:4",
      "sequence": 30267,
      "chapter_label": "JAS 1",
      "verse_label": "4",
