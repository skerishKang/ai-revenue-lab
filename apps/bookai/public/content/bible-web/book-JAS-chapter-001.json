      "raw_locator": [
        {
          "book": "JAS",
          "chapter": 1,
          "verse": 24
        }
      ],
      "en": "for he sees himself, and goes away, and immediately forgets what kind of man he was.",
      "ko": "제 자신을 보고 가서 그 모양이 어떠한 것을 곧 잊어버리거니와",
      "source_text_hash": "e482be1a7ec260635324344819dbcc22704cc87bda8849daa855064e7047dd70",
      "translation_text_hash": "69da41a964932f1d0d725b371190e66e1ad67a181e636ff2ace44d383422f0b9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제 자신을 보고 가서 그 모양이 어떠한 것을 곧 잊어버리거니와"
      ],
      "raw_text_hashes": [
        "69da41a964932f1d0d725b371190e66e1ad67a181e636ff2ace44d383422f0b9"
      ]
    },
    {
      "canonical_locator": "bible:web:JAS:1:25",
      "sequence": 30288,
      "chapter_label": "JAS 1",
      "verse_label": "25",
      "locator": {
        "book": "JAS",
