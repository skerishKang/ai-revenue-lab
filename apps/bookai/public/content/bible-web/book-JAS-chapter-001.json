      "verse_label": "14",
      "locator": {
        "book": "JAS",
        "chapter": 1,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "JAS",
          "chapter": 1,
          "verse": 14
        }
      ],
      "en": "But each one is tempted when he is drawn away by his own lust and enticed.",
      "ko": "오직 각 사람이 시험을 받는 것은 자기 욕심에 끌려 미혹됨이니",
      "source_text_hash": "13742bed024aabc9f1e9713a023d2b06c14c5003f72f9c980152fb3a13d227b4",
      "translation_text_hash": "dd61fafe39c86f8b7a58ec651db3c01c6039c92b9b91b27bbd14876108b52a9d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 각 사람이 시험을 받는 것은 자기 욕심에 끌려 미혹됨이니"
      ],
      "raw_text_hashes": [
        "dd61fafe39c86f8b7a58ec651db3c01c6039c92b9b91b27bbd14876108b52a9d"
      ]
    },
    {
      "canonical_locator": "bible:web:JAS:1:15",
      "sequence": 30278,
      "chapter_label": "JAS 1",
      "verse_label": "15",
      "locator": {
        "book": "JAS",
