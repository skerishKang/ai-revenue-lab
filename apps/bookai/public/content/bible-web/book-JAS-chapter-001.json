      },
      "raw_locator": [
        {
          "book": "JAS",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "He is a double-minded man, unstable in all his ways.",
      "ko": "두 마음을 품어 모든 일에 정함이 없는 자로다",
      "source_text_hash": "85d86c81c693c2b8524fffdf2256644e878154a989317e7d28a49be112b43467",
      "translation_text_hash": "64f61b5ca2a2de7764d820ab7eec094f00c885aa0cbd35c4d3546373abecc96d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "두 마음을 품어 모든 일에 정함이 없는 자로다"
      ],
      "raw_text_hashes": [
        "64f61b5ca2a2de7764d820ab7eec094f00c885aa0cbd35c4d3546373abecc96d"
      ]
    },
    {
      "canonical_locator": "bible:web:JAS:1:9",
      "sequence": 30272,
      "chapter_label": "JAS 1",
      "verse_label": "9",
      "locator": {
        "book": "JAS",
