      "ko": "사람의 성내는 것이 하나님의 의를 이루지 못함이니라",
      "source_text_hash": "0675257c1440159ce9f251af8fa1eabafaaca5c836eac9f19a33b9ddf7891d85",
      "translation_text_hash": "f4da19bfd7381be9a196cb1374074acd0995fa284653cdabcb1c2f1bfdc6b119",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람의 성내는 것이 하나님의 의를 이루지 못함이니라"
      ],
      "raw_text_hashes": [
        "f4da19bfd7381be9a196cb1374074acd0995fa284653cdabcb1c2f1bfdc6b119"
      ]
    },
    {
      "canonical_locator": "bible:web:JAS:1:21",
      "sequence": 30284,
      "chapter_label": "JAS 1",
      "verse_label": "21",
