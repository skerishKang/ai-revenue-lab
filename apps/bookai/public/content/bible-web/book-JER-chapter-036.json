      ]
    },
    {
      "canonical_locator": "bible:web:JER:36:32",
      "sequence": 19875,
      "chapter_label": "JER 36",
      "verse_label": "32",
      "locator": {
        "book": "JER",
        "chapter": 36,
        "verse": 32
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 36,
          "verse": 32
        }
      ],
      "en": "Then Jeremiah took another scroll, and gave it to Baruch the scribe, the son of Neriah, who wrote therein from the mouth of Jeremiah all the words of the book which Jehoiakim king of Judah had burned in the fire; and many similar words were added to them.",
      "ko": "이에 예레미야가 다른 두루마리를 취하여 네리야의 아들 서기관 바룩에게 주매 그가 유다 왕 여호야김의 불사른 책의 모든 말을 예레미야의 구전대로 기록하고 그 외에도 그 같은 말을 많이 더 하였더라",
      "source_text_hash": "0d0c20e5827655ee5a0c5d15a2ac3067a88393dcefb5a0b0667406aa4e3f231f",
      "translation_text_hash": "5c8f38484882a8b95d2218d6a765099e3be3c06c17cf779a449998b293c09a13",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이에 예레미야가 다른 두루마리를 취하여 네리야의 아들 서기관 바룩에게 주매 그가 유다 왕 여호야김의 불사른 책의 모든 말을 예레미야의 구전대로 기록하고 그 외에도 그 같은 말을 많이 더 하였더라"
      ],
      "raw_text_hashes": [
