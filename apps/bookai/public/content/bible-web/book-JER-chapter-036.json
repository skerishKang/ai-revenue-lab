      ]
    },
    {
      "canonical_locator": "bible:web:JER:36:30",
      "sequence": 19873,
      "chapter_label": "JER 36",
      "verse_label": "30",
      "locator": {
        "book": "JER",
        "chapter": 36,
        "verse": 30
      },
      "raw_locator": [
        {
          "book": "JER",
          "chapter": 36,
          "verse": 30
        }
      ],
      "en": "Therefore the LORD says concerning Jehoiakim king of Judah: “He will have no one to sit on David’s throne. His dead body will be cast out in the day to the heat, and in the night to the frost.",
      "ko": "그러므로 나 여호와가 유다 왕 여호야김에 대하여 이같이 말하노라 그에게 다윗의 위에 앉을 자가 없게 될 것이요 그 시체는 버림을 입어서 낮에는 더위, 밤에는 추위를 당하리라",
      "source_text_hash": "59ae93dd76f22858dbaa63bae23994d4c89d3e6652eb2fb50a114e5e4368c1db",
      "translation_text_hash": "2159796aafad099db38d1dc01b610a50d56baa5e38a7b3ee30144f19558618e1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 나 여호와가 유다 왕 여호야김에 대하여 이같이 말하노라 그에게 다윗의 위에 앉을 자가 없게 될 것이요 그 시체는 버림을 입어서 낮에는 더위, 밤에는 추위를 당하리라"
      ],
      "raw_text_hashes": [
        "2159796aafad099db38d1dc01b610a50d56baa5e38a7b3ee30144f19558618e1"
      ]
    },
    {
      "canonical_locator": "bible:web:JER:36:31",
      "sequence": 19874,
      "chapter_label": "JER 36",
      "verse_label": "31",
      "locator": {
