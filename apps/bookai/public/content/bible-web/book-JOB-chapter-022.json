      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 22,
          "verse": 7
        }
      ],
      "en": "You haven’t given water to the weary to drink, and you have withheld bread from the hungry.",
      "ko": "갈한 자에게 물을 마시우지 아니하며 주린 자에게 식물을 주지 아니하였구나",
      "source_text_hash": "bfb0a9c2aac77fa2d815be9a2a0248a929eb8f4f6dbf1fb6ed274290d78d0a1b",
      "translation_text_hash": "b94451a21c0188d92114c42a02c2f7f365cae60d1ac47646b69bb87d6d998a0e",
      "translation_policy": "krv-1961-source-mapped",
