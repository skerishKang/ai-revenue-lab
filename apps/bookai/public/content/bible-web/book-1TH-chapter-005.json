        "verse": 11
      },
      "raw_locator": [
        {
          "book": "1TH",
          "chapter": 5,
          "verse": 11
        }
      ],
      "en": "Therefore exhort one another, and build each other up, even as you also do.",
      "ko": "그러므로 피차 권면하고 피차 덕을 세우기를 너희가 하는것 같이 하라",
      "source_text_hash": "e5e3b4828f18b1c72df636771ebfaacdf1bc3fb7649ff14f84b62f45d60044fa",
      "translation_text_hash": "c4d4c3a1e290d8261f5b2ce9321dcbd4f423e09472eb32aceea5720f70edad8c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러므로 피차 권면하고 피차 덕을 세우기를 너희가 하는것 같이 하라"
      ],
      "raw_text_hashes": [
        "c4d4c3a1e290d8261f5b2ce9321dcbd4f423e09472eb32aceea5720f70edad8c"
      ]
    },
    {
      "canonical_locator": "bible:web:1TH:5:12",
      "sequence": 29630,
      "chapter_label": "1TH 5",
      "verse_label": "12",
      "locator": {
        "book": "1TH",
