        "verse": 5
      },
      "raw_locator": [
        {
          "book": "1TH",
          "chapter": 5,
          "verse": 5
        }
      ],
      "en": "You are all children of light and children of the day. We don’t belong to the night, nor to darkness,",
      "ko": "너희는 다 빛의 아들이요 낮의 아들이라 우리가 밤이나 어두움에 속하지 아니하나니",
      "source_text_hash": "5cc9409095f5f05abc7d552a656ea34a006cd42e8b83fba1062ef7e0a2726378",
      "translation_text_hash": "f5346e59392572b66521ee465f8afd8d4824ae0096553a0c501bae6bd85d5657",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 다 빛의 아들이요 낮의 아들이라 우리가 밤이나 어두움에 속하지 아니하나니"
      ],
      "raw_text_hashes": [
        "f5346e59392572b66521ee465f8afd8d4824ae0096553a0c501bae6bd85d5657"
      ]
    },
    {
      "canonical_locator": "bible:web:1TH:5:6",
      "sequence": 29624,
      "chapter_label": "1TH 5",
      "verse_label": "6",
