    {
      "canonical_locator": "bible:web:DEU:19:9",
      "sequence": 5416,
      "chapter_label": "DEU 19",
      "verse_label": "9",
      "locator": {
        "book": "DEU",
        "chapter": 19,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 19,
          "verse": 9
        }
      ],
      "en": "and if you keep all this commandment to do it, which I command you today, to love the LORD your God, and to walk ever in his ways, then you shall add three cities more for yourselves, in addition to these three.",
      "ko": "또 네가 나의 오늘날 네게 명하는 이 모든 명령을 지켜 행하여 네 하나님 여호와를 사랑하고 항상 그 길로 행할 때에는 이 셋 외에 세 성읍을 더하여",
      "source_text_hash": "89a63abdc2c513224bc02626be101bf030c97871e85845df78484885cd5911be",
      "translation_text_hash": "2a64a56eb1ce11ffa8ab2b080132440c952d9c3c99bfdd2af822fd3d11009f6e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "또 네가 나의 오늘날 네게 명하는 이 모든 명령을 지켜 행하여 네 하나님 여호와를 사랑하고 항상 그 길로 행할 때에는 이 셋 외에 세 성읍을 더하여"
      ],
      "raw_text_hashes": [
        "2a64a56eb1ce11ffa8ab2b080132440c952d9c3c99bfdd2af822fd3d11009f6e"
