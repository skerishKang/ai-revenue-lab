        "verse": 12
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 19,
          "verse": 12
        }
      ],
      "en": "then the elders of his city shall send and bring him there, and deliver him into the hand of the avenger of blood, that he may die.",
      "ko": "그 본 성읍 장로들이 사람을 보내어 그를 거기서 잡아다가 보수자의 손에 넘겨 죽이게 할 것이라",
      "source_text_hash": "4613b38dc167ad58102e67143c0061ca8d4f7babd7b6649d898389732ae5358f",
      "translation_text_hash": "eb7291eb7b2274482db33f1b69e3b4b7cd6d625d49d6b3ac3d5031ce0d4b7dd9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 본 성읍 장로들이 사람을 보내어 그를 거기서 잡아다가 보수자의 손에 넘겨 죽이게 할 것이라"
      ],
      "raw_text_hashes": [
        "eb7291eb7b2274482db33f1b69e3b4b7cd6d625d49d6b3ac3d5031ce0d4b7dd9"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:19:13",
      "sequence": 5420,
      "chapter_label": "DEU 19",
      "verse_label": "13",
      "locator": {
        "book": "DEU",
        "chapter": 19,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 19,
          "verse": 13
        }
      ],
      "en": "Your eye shall not pity him, but you shall purge the innocent blood from Israel that it may go well with you.",
      "ko": "네 눈이 그를 긍휼히 보지 말고 무죄한 피 흘린 죄를 이스라엘에서 제하라 그리하면 네게 복이 있으리라",
