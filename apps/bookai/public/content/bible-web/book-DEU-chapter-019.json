    {
      "canonical_locator": "bible:web:DEU:19:10",
      "sequence": 5417,
      "chapter_label": "DEU 19",
      "verse_label": "10",
      "locator": {
        "book": "DEU",
        "chapter": 19,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 19,
          "verse": 10
        }
      ],
      "en": "This is so that innocent blood will not be shed in the middle of your land which the LORD your God gives you for an inheritance, leaving blood guilt on you.",
      "ko": "네 하나님 여호와께서 네게 기업으로 주시는 땅에서 무죄한 피를 흘림이 없게 하라 이같이 하면 그 피가 네게로 돌아가지 아니하리라",
      "source_text_hash": "afca7ed6dd52551a66db8bff94c10dd4a84f1d95bb6711a1a5a3f028fa83a5ea",
      "translation_text_hash": "cceed8b7887e5ca7a92f94532eaeaf0e82d7bd7e55ed72894a566482a5c234fe",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께서 네게 기업으로 주시는 땅에서 무죄한 피를 흘림이 없게 하라 이같이 하면 그 피가 네게로 돌아가지 아니하리라"
      ],
      "raw_text_hashes": [
        "cceed8b7887e5ca7a92f94532eaeaf0e82d7bd7e55ed72894a566482a5c234fe"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:19:11",
      "sequence": 5418,
      "chapter_label": "DEU 19",
      "verse_label": "11",
      "locator": {
        "book": "DEU",
        "chapter": 19,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 19,
          "verse": 11
        }
      ],
      "en": "But if any man hates his neighbor, lies in wait for him, rises up against him, strikes him mortally so that he dies, and he flees into one of these cities;",
      "ko": "그러나 만일 사람이 그 이웃을 미워하여 엎드려 그를 기다리다가 일어나 쳐서 그 생명을 상하여 죽게 하고 이 한 성읍으로 도피하거든",
      "source_text_hash": "d3a0620fa6636598ad27c18b7ffc912c3e04eaeeb6327bccc6217e37ad32f5d1",
      "translation_text_hash": "336c09b8ed86ba4251ad5202c8f17376c297544a38ed641207c6552f97003aae",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 만일 사람이 그 이웃을 미워하여 엎드려 그를 기다리다가 일어나 쳐서 그 생명을 상하여 죽게 하고 이 한 성읍으로 도피하거든"
      ],
      "raw_text_hashes": [
        "336c09b8ed86ba4251ad5202c8f17376c297544a38ed641207c6552f97003aae"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:19:12",
      "sequence": 5419,
      "chapter_label": "DEU 19",
      "verse_label": "12",
      "locator": {
        "book": "DEU",
