        "verse": 2
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 19,
          "verse": 2
        }
      ],
      "en": "you shall set apart three cities for yourselves in the middle of your land, which the LORD your God gives you to possess.",
      "ko": "네 하나님 여호와께서 네게 기업으로 주신 땅 가운데서 세 성읍을 너를 위하여 구별하고",
      "source_text_hash": "dbed035de368a42552af0465cfa17b78611984288e95366e12a428b036230508",
      "translation_text_hash": "6ff306c545e5fa8aa55d2ab6b202b896c12d3d1d2a68828ea02c96aeecc4a73a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께서 네게 기업으로 주신 땅 가운데서 세 성읍을 너를 위하여 구별하고"
      ],
      "raw_text_hashes": [
        "6ff306c545e5fa8aa55d2ab6b202b896c12d3d1d2a68828ea02c96aeecc4a73a"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:19:3",
      "sequence": 5410,
      "chapter_label": "DEU 19",
      "verse_label": "3",
      "locator": {
        "book": "DEU",
        "chapter": 19,
        "verse": 3
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 19,
          "verse": 3
        }
      ],
      "en": "You shall prepare the way, and divide the borders of your land which the LORD your God causes you to inherit into three parts, that every man slayer may flee there.",
      "ko": "네 하나님 여호와께서 네게 유업으로 주시는 땅의 전체를 삼구로 분하여 그 도로를 닦고 무릇 살인자를 그 성읍으로 도피케 하라",
      "source_text_hash": "b9d34be3054f4d210e25a3f6a5a284b3741deb2d4d8c99de76e93f068ff7b269",
      "translation_text_hash": "d6ff437739771072fa6f3e8e337e4da6a2264850062b3cda0b57edc471e5ecf8",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "네 하나님 여호와께서 네게 유업으로 주시는 땅의 전체를 삼구로 분하여 그 도로를 닦고 무릇 살인자를 그 성읍으로 도피케 하라"
      ],
      "raw_text_hashes": [
        "d6ff437739771072fa6f3e8e337e4da6a2264850062b3cda0b57edc471e5ecf8"
      ]
