      "source_text_hash": "a6d78c9b88d69593493417357cbb9bc9ceb8e2a6b0c4419f3d9680027d79ae1a",
      "translation_text_hash": "a72232b82bc62c9e484afb4d269954cef423225574d153ee1bd4dbaf4390d43a",
