      "translation_text_hash": "170c7d09347ab4ff3fb0e2d1d7eda58383293d814e6711e86743da924c7b8965",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
