      "raw_locator": [
        {
          "book": "MAT",
          "chapter": 10,
          "verse": 7
        }
      ],
      "en": "As you go, preach, saying, ‘The Kingdom of Heaven is at hand!’",
      "ko": "가면서 전파하여 말하되 천국이 가까왔다 하고",
      "source_text_hash": "a5551b0f80354288bd634220631b86a5f17616e34a6a996d2abc33d7fd3846f4",
      "translation_text_hash": "d849b6afbc39f693af59241290ba8a7faf6ccdcb8575ccb8da6346f9471f4f86",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "가면서 전파하여 말하되 천국이 가까왔다 하고"
      ],
      "raw_text_hashes": [
        "d849b6afbc39f693af59241290ba8a7faf6ccdcb8575ccb8da6346f9471f4f86"
      ]
