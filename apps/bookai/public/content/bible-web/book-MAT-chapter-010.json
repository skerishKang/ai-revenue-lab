      "raw_locator": [
        {
          "book": "MAT",
          "chapter": 10,
          "verse": 10
        }
      ],
      "en": "Take no bag for your journey, neither two coats, nor sandals, nor staff: for the laborer is worthy of his food.",
      "ko": "여행을 위하여 주머니나 두 벌 옷이나 신이나 지팡이를 가지지 말라 이는 일군이 저 먹을것 받는 것이 마땅함이니라",
      "source_text_hash": "f1d431f7104940d08a8d1d7d2e4cc2c48c579551c301c8c171e76e3b837c85bf",
      "translation_text_hash": "a720da235afc0dae0a3b845177fb0962fd87f282f2a19456f55e1a7972fb6e54",
      "translation_policy": "krv-1961-source-mapped",
