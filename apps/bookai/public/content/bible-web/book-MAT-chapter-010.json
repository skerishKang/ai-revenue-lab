      "source_text_hash": "8418dca35fa10bf95923a120d79a52c00a2a902a52be324b152aa0ea673c0f65",
      "translation_text_hash": "fa2e19378fc8382626ff2a99a898850294055716a68db92f247837ab94a24aae",
      "translation_policy": "krv-1961-source-mapped",
