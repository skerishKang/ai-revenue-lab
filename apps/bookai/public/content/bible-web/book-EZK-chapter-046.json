      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 46,
          "verse": 9
        }
      ],
      "en": "“‘“But when the people of the land come before the LORD in the appointed feasts, he who enters by the way of the north gate to worship shall go out by the way of the south gate; and he who enters by the way of the south gate shall go out by the way of the north gate. He shall not return by the way of the gate by which he came in, but shall go out straight before him.",
      "ko": "그러나 모든 정한 절기에 이 땅 거민이 나 여호와 앞에 나아올 때에는 북문으로 들어와서 경배하는 자는 남문으로 나가고 남문으로 들어오는 자는 북문으로 나갈찌라 들어온 문으로 도로 나가지 말고 그 몸이 앞으로 향한대로 나갈찌며",
      "source_text_hash": "dc94076dba563e9757629d296a1267146968935d6695ba1d43ee6a43db5efe0a",
      "translation_text_hash": "bda34ef668839e753d1028e8f43c5f6fd5b37b80b3c008f9a768e6c51510ee38",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그러나 모든 정한 절기에 이 땅 거민이 나 여호와 앞에 나아올 때에는 북문으로 들어와서 경배하는 자는 남문으로 나가고 남문으로 들어오는 자는 북문으로 나갈찌라 들어온 문으로 도로 나가지 말고 그 몸이 앞으로 향한대로 나갈찌며"
      ],
      "raw_text_hashes": [
