        {
          "book": "EZK",
          "chapter": 46,
          "verse": 3
        }
      ],
      "en": "The people of the land shall worship at the door of that gate before the LORD on the Sabbaths and on the new moons.",
      "ko": "이 땅 백성도 안식일과 월삭에 이 문통에서 나 여호와 앞에 경배할 것이며",
      "source_text_hash": "fa88f7fb60bf78074eb4f065020a8f6fe5e11a4009cc36304edaf719d9f391e5",
      "translation_text_hash": "45275132b5853ca34534039f340344cadfcd1c2e8331031fa7f514ffdc876d71",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 땅 백성도 안식일과 월삭에 이 문통에서 나 여호와 앞에 경배할 것이며"
      ],
      "raw_text_hashes": [
        "45275132b5853ca34534039f340344cadfcd1c2e8331031fa7f514ffdc876d71"
      ]
    },
    {
      "canonical_locator": "bible:web:EZK:46:4",
      "sequence": 21660,
      "chapter_label": "EZK 46",
      "verse_label": "4",
