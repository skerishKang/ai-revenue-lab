      "ko": "왕은 무리 가운데 있어서 그들의 들어올 때에 들어오고 그들의 나갈 때에 나갈찌니라",
      "source_text_hash": "30ac403e98001508745bcb10cf0e582648ea0fbe9427f471df34940a82cd7eed",
      "translation_text_hash": "60fa65611669fe7e280dc5265c533626ede3e66369555eac0e647a193216d031",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
