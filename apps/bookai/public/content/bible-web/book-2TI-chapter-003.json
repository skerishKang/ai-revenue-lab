      "raw_texts": [
        "악한 사람들과 속이는 자들은 더욱 악하여져서 속이기도 하고 속기도 하나니"
      ],
      "raw_text_hashes": [
        "ed4a299fc2c6744a1ff3ed660e0c57fda4e927cd6e226a3976e5e5cd613c2d3d"
