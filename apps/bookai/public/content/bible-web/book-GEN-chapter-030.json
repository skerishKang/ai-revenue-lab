      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "야곱이 버드나무와 살구나무와 신풍나무의 푸른 가지를 취하여 그것들의 껍질을 벗겨 흰 무늬를 내고"
      ],
      "raw_text_hashes": [
