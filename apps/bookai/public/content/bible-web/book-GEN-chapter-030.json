      "source_text_hash": "9b60785f4078a32ed22ee9e37f75a9fb3c507caaa369f873bd8db4d087abb34c",
      "translation_text_hash": "e3e19b47dced6e18530ea521083fee6d8d74d1168790632f860dfbed67ecffc9",
