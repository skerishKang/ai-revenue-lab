      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 146,
          "verse": 8
        }
      ],
      "en": "The LORD opens the eyes of the blind. The LORD raises up those who are bowed down. The LORD loves the righteous.",
      "ko": "여호와께서 소경의 눈을 여시며 여호와께서 비굴한 자를 일으키시며 여호와께서 의인을 사랑하시며",
      "source_text_hash": "51ce8191a0032514c29e983218fb7b8f6c650a9211978e6edcb3ebac8828e514",
      "translation_text_hash": "75ea5c50eeac5d8cc1f903811f3241cca9af3f795100b7ac3fc8803b6bea5dbd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 소경의 눈을 여시며 여호와께서 비굴한 자를 일으키시며 여호와께서 의인을 사랑하시며"
      ],
      "raw_text_hashes": [
        "75ea5c50eeac5d8cc1f903811f3241cca9af3f795100b7ac3fc8803b6bea5dbd"
      ]
