      ],
      "en": "The LORD preserves the foreigners. He upholds the fatherless and widow, but he turns the way of the wicked upside down.",
      "ko": "여호와께서 객을 보호하시며 고아와 과부를 붙드시고 악인의 길은 굽게 하시는도다",
      "source_text_hash": "be33b4269821ee8a061d001837b4328d5d5cc86958a151c8dd4609fe43bf7213",
      "translation_text_hash": "0663e2a82e8ff731fdf6313b29f17d9f8fcde014877097e2c1fe73d995e715f5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 객을 보호하시며 고아와 과부를 붙드시고 악인의 길은 굽게 하시는도다"
      ],
      "raw_text_hashes": [
