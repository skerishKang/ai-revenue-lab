        {
          "book": "PSA",
          "chapter": 9,
          "verse": 2
        }
      ],
      "en": "I will be glad and rejoice in you. I will sing praise to your name, O Most High.",
      "ko": "내가 주를 기뻐하고 즐거워하며 지극히 높으신 주의 이름을 찬송하리니",
      "source_text_hash": "a3deebcca7584deeeee1339a8c6810f8002317546c9eb890bd73a27a717292fb",
      "translation_text_hash": "ec6af977fb6a389ff9316b4ea26529e56c0d2b49976119bcde882a51b537e159",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 주를 기뻐하고 즐거워하며 지극히 높으신 주의 이름을 찬송하리니"
      ],
      "raw_text_hashes": [
        "ec6af977fb6a389ff9316b4ea26529e56c0d2b49976119bcde882a51b537e159"
      ]
    },
