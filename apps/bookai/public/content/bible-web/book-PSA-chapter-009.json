      "translation_text_hash": "b0cb8e7b9e29e929d298cec6481b30e342b1af68aba600882dfc56132eb5c81c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "열방을 책하시고 악인을 멸하시며 저희 이름을 영영히 도말하셨나이다"
