        "chapter": 18,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "2KI",
          "chapter": 18,
          "verse": 15
        }
      ],
      "en": "Hezekiah gave him all the silver that was found in the LORD’s house and in the treasures of the king’s house.",
      "ko": "히스기야가 이에 여호와의 전과 왕궁 곳간에 있는 은을 다 주었고",
      "source_text_hash": "beb92fcece9bbd56db7ec96928d9ff44dbe32fafdcc6d0c4ae938dba7b8278f5",
      "translation_text_hash": "be202aa974342c1d2ab9aec8d836fab9a7dc504345ea6aa50c97a86a0cc4caee",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "히스기야가 이에 여호와의 전과 왕궁 곳간에 있는 은을 다 주었고"
      ],
      "raw_text_hashes": [
        "be202aa974342c1d2ab9aec8d836fab9a7dc504345ea6aa50c97a86a0cc4caee"
      ]
    },
    {
      "canonical_locator": "bible:web:2KI:18:16",
      "sequence": 10041,
      "chapter_label": "2KI 18",
