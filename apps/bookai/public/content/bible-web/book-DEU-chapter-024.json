    {
      "canonical_locator": "bible:web:DEU:24:9",
      "sequence": 5535,
      "chapter_label": "DEU 24",
      "verse_label": "9",
      "locator": {
        "book": "DEU",
        "chapter": 24,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 24,
          "verse": 9
        }
      ],
      "en": "Remember what the LORD your God did to Miriam, by the way as you came out of Egypt.",
      "ko": "너희가 애굽에서 나오는 길에서 네 하나님 여호와께서 미리암에게 행하신 일을 기억할찌니라",
      "source_text_hash": "b1cafc020fc88fea906d5ab1e3bb7d8cfd9b9d6534c33f5bcf9f694f535acb6f",
      "translation_text_hash": "dba0e9d53c2440217c4335a0fdcbfd6bb9f8fef33763ee92c021228eccfe4ee6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희가 애굽에서 나오는 길에서 네 하나님 여호와께서 미리암에게 행하신 일을 기억할찌니라"
      ],
      "raw_text_hashes": [
        "dba0e9d53c2440217c4335a0fdcbfd6bb9f8fef33763ee92c021228eccfe4ee6"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:24:10",
      "sequence": 5536,
