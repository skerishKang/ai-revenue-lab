    {
      "canonical_locator": "bible:web:DEU:24:6",
      "sequence": 5532,
      "chapter_label": "DEU 24",
      "verse_label": "6",
      "locator": {
        "book": "DEU",
        "chapter": 24,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 24,
          "verse": 6
        }
      ],
      "en": "No man shall take the mill or the upper millstone as a pledge, for he takes a life in pledge.",
      "ko": "사람이 맷돌의 전부나 그 위짝만이나 전집하지 말찌니 이는 그 생명을 전집함이니라",
      "source_text_hash": "ab44789dffc659a4af6fe6266f3ed90fdcc1587482020883b93d2ddd277f8639",
      "translation_text_hash": "02f7e6c8398b515a1f6b68a002142f1dc3d4495aa2a89e8bef278ed9b33200f1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람이 맷돌의 전부나 그 위짝만이나 전집하지 말찌니 이는 그 생명을 전집함이니라"
      ],
      "raw_text_hashes": [
        "02f7e6c8398b515a1f6b68a002142f1dc3d4495aa2a89e8bef278ed9b33200f1"
      ]
