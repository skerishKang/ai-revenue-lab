  "passages": [
    {
      "canonical_locator": "bible:web:DEU:24:1",
      "sequence": 5527,
      "chapter_label": "DEU 24",
      "verse_label": "1",
      "locator": {
        "book": "DEU",
        "chapter": 24,
        "verse": 1
