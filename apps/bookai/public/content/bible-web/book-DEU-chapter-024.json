      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 24,
          "verse": 14
        }
      ],
      "en": "You shall not oppress a hired servant who is poor and needy, whether he is one of your brothers or one of the foreigners who are in your land within your gates.",
      "ko": "곤궁하고 빈한한 품군은 너의 형제든지 네 땅 성문 안에 우거하는 객이든지 그를 학대하지 말며",
      "source_text_hash": "44a6d0bd2d7d329f82838f72a93d59a68bad7276d305cc14527872cceeeff0f8",
      "translation_text_hash": "4e922402658f7f3a52a462f40fb62461c47667a9b327b2be92880fb6b2b2a452",
      "translation_policy": "krv-1961-source-mapped",
