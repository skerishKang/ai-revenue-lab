      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 속히 나를 건지소서 여호와여 속히 나를 도우소서"
      ],
      "raw_text_hashes": [
        "689712413208f93e73681a35fda3bbed9c9343ed3b40eedfcabf462dd817e680"
      ]
    },
