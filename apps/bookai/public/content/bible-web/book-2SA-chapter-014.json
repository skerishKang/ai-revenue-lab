    {
      "canonical_locator": "bible:web:2SA:14:14",
      "sequence": 8371,
      "chapter_label": "2SA 14",
      "verse_label": "14",
      "locator": {
        "book": "2SA",
        "chapter": 14,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 14,
          "verse": 14
        }
      ],
      "en": "For we must die, and are like water spilled on the ground, which can’t be gathered up again; neither does God take away life, but devises means, that he who is banished not be an outcast from him.",
      "ko": "우리는 필경 죽으리니 땅에 쏟아진 물을 다시 모으지 못함 같을 것이오나 하나님은 생명을 빼앗지 아니하시고 방책을 베푸사 내어쫓긴 자로 하나님께 버린 자가 되지 않게 하시나이다",
      "source_text_hash": "f591956c99214ed6bdcbb49a63fd288cfe87e7becb8826329c6efe0974bdd1fc",
      "translation_text_hash": "0a9c6ac00c0f595af96d9945cdfee09dbd85b8616fa4763b69645b5df788d6a9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리는 필경 죽으리니 땅에 쏟아진 물을 다시 모으지 못함 같을 것이오나 하나님은 생명을 빼앗지 아니하시고 방책을 베푸사 내어쫓긴 자로 하나님께 버린 자가 되지 않게 하시나이다"
      ],
      "raw_text_hashes": [
        "0a9c6ac00c0f595af96d9945cdfee09dbd85b8616fa4763b69645b5df788d6a9"
      ]
