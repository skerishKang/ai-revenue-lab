      "sequence": 8372,
      "chapter_label": "2SA 14",
      "verse_label": "15",
      "locator": {
        "book": "2SA",
        "chapter": 14,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 14,
          "verse": 15
        }
      ],
      "en": "Now therefore, seeing that I have come to speak this word to my lord the king, it is because the people have made me afraid. Your servant said, ‘I will now speak to the king; it may be that the king will perform the request of his servant.’",
      "ko": "이제 내가 와서 내 주 왕께 이 말씀을 여쭙는 것은 백성들이 나를 두렵게 하므로 계집종이 스스로 말하기를 내가 왕께 여쭈면 혹시 종의 청하는 것을 시행하실 것이라",
      "source_text_hash": "b661a8cbdbdfd42c7353aef8ca723c261466067430fbffb1416f706841a88650",
      "translation_text_hash": "df771fcde76741094eb49ca19930e323e68e711c3e4365cf40c880eb5a0cc6cb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이제 내가 와서 내 주 왕께 이 말씀을 여쭙는 것은 백성들이 나를 두렵게 하므로 계집종이 스스로 말하기를 내가 왕께 여쭈면 혹시 종의 청하는 것을 시행하실 것이라"
      ],
      "raw_text_hashes": [
