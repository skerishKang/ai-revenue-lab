        "verse": 8
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 14,
          "verse": 8
        }
      ],
      "en": "The king said to the woman, “Go to your house, and I will give a command concerning you.”",
      "ko": "왕이 여인에게 이르되 네 집으로 가라 내가 너를 위하여 명령을 내리리라",
      "source_text_hash": "0ba4b6ae28f1f2c4b77940a1d1fca3aa2207105355318400a08f4bf0402eb29a",
      "translation_text_hash": "62d17a3382946873b1346b2f3408a85b3a03d21011c672df852327189027bccc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕이 여인에게 이르되 네 집으로 가라 내가 너를 위하여 명령을 내리리라"
      ],
      "raw_text_hashes": [
        "62d17a3382946873b1346b2f3408a85b3a03d21011c672df852327189027bccc"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:14:9",
      "sequence": 8366,
      "chapter_label": "2SA 14",
      "verse_label": "9",
      "locator": {
