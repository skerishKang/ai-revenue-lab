      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 14,
          "verse": 3
        }
      ],
      "en": "Go in to the king and speak like this to him.” So Joab put the words in her mouth.",
      "ko": "왕께 들어가서 여차여차히 말하라고 할 말을 그 입에 넣어주니라",
      "source_text_hash": "4e3b502e9cb0a4bfb5b5c2cbefb825d50ce9966ba668a683007bc698f47b540e",
      "translation_text_hash": "624d6883d00413dc6c9612c5e56bf84a326756fb2ce9f6b348f57a72ca929d7e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "왕께 들어가서 여차여차히 말하라고 할 말을 그 입에 넣어주니라"
      ],
      "raw_text_hashes": [
        "624d6883d00413dc6c9612c5e56bf84a326756fb2ce9f6b348f57a72ca929d7e"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:14:4",
      "sequence": 8361,
      "chapter_label": "2SA 14",
