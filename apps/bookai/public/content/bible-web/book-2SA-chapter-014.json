    {
      "canonical_locator": "bible:web:2SA:14:17",
      "sequence": 8374,
      "chapter_label": "2SA 14",
      "verse_label": "17",
      "locator": {
        "book": "2SA",
        "chapter": 14,
        "verse": 17
      },
      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 14,
          "verse": 17
        }
      ],
      "en": "Then your servant said, ‘Please let the word of my lord the king bring rest; for as an angel of God, so is my lord the king to discern good and bad. May the LORD, your God, be with you.’”",
      "ko": "계집종이 또 스스로 말하기를 내 주 왕의 말씀이 나의 위로가 되기를 원한다 하였사오니 이는 내 주 왕께서 하나님의 사자 같이 선과 악을 분간하심이니이다 원컨대 왕의 하나님 여호와께서 왕과 같이 계시옵소서",
      "source_text_hash": "36cab3b9320be5eb712aa5b61ffdeb67f5275b544fb8d1274b0dec8ac7299619",
      "translation_text_hash": "298e221201fb9b0c2ad4f3ff74fffea21eac5d78d5e6e8cde1a0368b83b7422c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "계집종이 또 스스로 말하기를 내 주 왕의 말씀이 나의 위로가 되기를 원한다 하였사오니 이는 내 주 왕께서 하나님의 사자 같이 선과 악을 분간하심이니이다 원컨대 왕의 하나님 여호와께서 왕과 같이 계시옵소서"
      ],
      "raw_text_hashes": [
