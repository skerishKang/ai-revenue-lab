      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 16,
          "verse": 9
        }
      ],
      "en": "Therefore my heart is glad, and my tongue rejoices. My body shall also dwell in safety.",
      "ko": "이러므로 내 마음이 기쁘고 내 영광도 즐거워하며 내 육체도 안전히 거하리니",
      "source_text_hash": "8421418d8a7d7eda206819d1dda59ed3cf933abc3c55dc7470e825cc111760ad",
      "translation_text_hash": "c822bf192e69c0ff9743c8a4948ee96bd3a5504c4d7d12cdccc9a8c8904a6138",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이러므로 내 마음이 기쁘고 내 영광도 즐거워하며 내 육체도 안전히 거하리니"
      ],
      "raw_text_hashes": [
        "c822bf192e69c0ff9743c8a4948ee96bd3a5504c4d7d12cdccc9a8c8904a6138"
      ]
