        "verse": 9
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 2,
          "verse": 9
        }
      ],
      "en": "Man is brought low, and mankind is humbled; therefore don’t forgive them.",
      "ko": "천한 자도 절하며 귀한 자도 굴복하오니 그들을 용서하지 마옵소서",
      "source_text_hash": "b7569ec8cfc9a372ee9994c9710f5faf75497f83bdcecd08b06f8d5573335e78",
      "translation_text_hash": "9c7b857a26e7d91cce098e662bcf9aa3963d583afc6a1d49b2f3a6f91681ff2d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "천한 자도 절하며 귀한 자도 굴복하오니 그들을 용서하지 마옵소서"
      ],
      "raw_text_hashes": [
        "9c7b857a26e7d91cce098e662bcf9aa3963d583afc6a1d49b2f3a6f91681ff2d"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:2:10",
      "sequence": 17696,
      "chapter_label": "ISA 2",
      "verse_label": "10",
      "locator": {
