      "raw_texts": [
        "또 레바논의 높고높은 모든 백향목과 바산의 모든 상수리나무와"
      ],
      "raw_text_hashes": [
        "a48efce52ad52be0fc8f7bddc61c79941f20cdca4cedc83c033759e30dba6610"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:2:14",
