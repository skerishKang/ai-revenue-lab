        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 2,
          "verse": 10
        }
      ],
      "en": "Enter into the rock, and hide in the dust, from before the terror of the LORD, and from the glory of his majesty.",
      "ko": "너희는 바위 틈에 들어가며 진토에 숨어 여호와의 위엄과 그 광대하심의 영광을 피하라",
      "source_text_hash": "1bcf15052d0736641c61d3d45cd7c1c61b1615c60a1e2d7365f078f77399e977",
      "translation_text_hash": "3f95e7c0f86f0ed5604878119b040dee969e475af53eea047143cc0296d4135e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "너희는 바위 틈에 들어가며 진토에 숨어 여호와의 위엄과 그 광대하심의 영광을 피하라"
      ],
      "raw_text_hashes": [
        "3f95e7c0f86f0ed5604878119b040dee969e475af53eea047143cc0296d4135e"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:2:11",
      "sequence": 17697,
      "chapter_label": "ISA 2",
      "verse_label": "11",
      "locator": {
        "book": "ISA",
        "chapter": 2,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 2,
          "verse": 11
        }
      ],
      "en": "The lofty looks of man will be brought low, the arrogance of men will be bowed down, and the LORD alone will be exalted in that day.",
      "ko": "그날에 눈이 높은 자가 낮아지며 교만한 자가 굴복되고 여호와께서 홀로 높임을 받으시리라",
      "source_text_hash": "73f1875b90a1c5901458341239186ba70eedcc433a3c7c55d38caf613d1799a0",
      "translation_text_hash": "3a8d7242cc2ed076248283ced67263e125125dc9aa010b4fb82de16399f254c7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그날에 눈이 높은 자가 낮아지며 교만한 자가 굴복되고 여호와께서 홀로 높임을 받으시리라"
      ],
      "raw_text_hashes": [
        "3a8d7242cc2ed076248283ced67263e125125dc9aa010b4fb82de16399f254c7"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:2:12",
      "sequence": 17698,
