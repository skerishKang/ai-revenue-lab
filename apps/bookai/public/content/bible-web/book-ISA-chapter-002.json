        "verse": 7
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 2,
          "verse": 7
        }
      ],
      "en": "Their land is full of silver and gold, neither is there any end of their treasures. Their land also is full of horses, neither is there any end of their chariots.",
      "ko": "그 땅에는 은금이 가득하고 보화가 무한하며 그 땅에는 마필이 가득하고 병거가 무수하며",
      "source_text_hash": "3aaae10f1b5d118578bc91edd1b5b21c3f442606c54dfe87df96a5e919e3a3db",
      "translation_text_hash": "9be3084eb9b13c56929f450249cb537beb360ca2973a9b5b6c6d44bb8e17fb45",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 땅에는 은금이 가득하고 보화가 무한하며 그 땅에는 마필이 가득하고 병거가 무수하며"
      ],
      "raw_text_hashes": [
        "9be3084eb9b13c56929f450249cb537beb360ca2973a9b5b6c6d44bb8e17fb45"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:2:8",
      "sequence": 17694,
      "chapter_label": "ISA 2",
      "verse_label": "8",
      "locator": {
