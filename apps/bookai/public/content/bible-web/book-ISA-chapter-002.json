      ],
      "en": "This is what Isaiah the son of Amoz saw concerning Judah and Jerusalem.",
      "ko": "아모스의 아들 이사야가 받은바 유다와 예루살렘에 관한 말씀이라",
      "source_text_hash": "4d8cf5b4d7f6c5a32025719abd9d396fece363d58a945909e845027821a29ab5",
      "translation_text_hash": "66506aae947657ad7c5cd3c028bcf4c40a631c7882d4eb6b893bd7d4eae22eef",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아모스의 아들 이사야가 받은바 유다와 예루살렘에 관한 말씀이라"
      ],
      "raw_text_hashes": [
        "66506aae947657ad7c5cd3c028bcf4c40a631c7882d4eb6b893bd7d4eae22eef"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:2:2",
      "sequence": 17688,
      "chapter_label": "ISA 2",
