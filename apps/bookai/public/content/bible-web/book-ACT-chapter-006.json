      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "사람들을 가르쳐 말시키되 이 사람이 모세와 및 하나님을 모독하는 말 하는 것을 우리가 들었노라 하게 하고"
      ],
      "raw_text_hashes": [
