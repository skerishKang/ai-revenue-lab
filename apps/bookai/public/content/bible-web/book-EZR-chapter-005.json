        }
      ],
      "en": "They sent a letter to him, in which was written: i To Darius the king, all peace. i1",
      "ko": "그 글에 일렀으되 다리오왕은 만안하옵소서",
      "source_text_hash": "f9a3e192430cc59fffbdc694e9fdeaa2ba78fc82c89292ef42e02e41e0d9316a",
      "translation_text_hash": "0d536d58fab8f8a202777e767e81daca325bb21419736b150f73238c8938ba66",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 글에 일렀으되 다리오왕은 만안하옵소서"
      ],
      "raw_text_hashes": [
        "0d536d58fab8f8a202777e767e81daca325bb21419736b150f73238c8938ba66"
      ]
    },
    {
      "canonical_locator": "bible:web:EZR:5:8",
      "sequence": 12143,
      "chapter_label": "EZR 5",
      "verse_label": "8",
