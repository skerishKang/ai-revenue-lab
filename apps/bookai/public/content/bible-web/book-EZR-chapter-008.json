      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "정월 십 이일에 우리가 아하와강을 떠나 예루살렘으로 갈쌔 우리 하나님의 손이 우리를 도우사 대적과 길에 매복한 자의 손에서 건지신지라"
      ],
      "raw_text_hashes": [
