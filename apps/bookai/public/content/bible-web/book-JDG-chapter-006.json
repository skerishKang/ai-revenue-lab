        {
          "book": "JDG",
          "chapter": 6,
          "verse": 7
        }
      ],
      "en": "When the children of Israel cried to the LORD because of Midian,",
      "ko": "이스라엘 자손이 미디안을 인하여 여호와께 부르짖은고로",
      "source_text_hash": "9386586de03983535228403b8c67dd89e960824eea3b56f6b6e3047bfe70b504",
      "translation_text_hash": "b4f2e864d006605239247293b637a6f41cf9b5191fab0d8f3a52d415aadc74ba",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손이 미디안을 인하여 여호와께 부르짖은고로"
      ],
      "raw_text_hashes": [
        "b4f2e864d006605239247293b637a6f41cf9b5191fab0d8f3a52d415aadc74ba"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:6:8",
      "sequence": 6663,
      "chapter_label": "JDG 6",
      "verse_label": "8",
      "locator": {
