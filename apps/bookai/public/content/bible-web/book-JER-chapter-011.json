      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 내게 알게 하셨으므로 내가 그것을 알았나이다 그 때에 주께서 그들의 행위를 내게 보이셨나이다"
      ],
      "raw_text_hashes": [
