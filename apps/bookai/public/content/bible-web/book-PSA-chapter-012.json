        {
          "book": "PSA",
          "chapter": 12,
          "verse": 3
        }
      ],
      "en": "May the LORD cut off all flattering lips, and the tongue that boasts,",
      "ko": "여호와께서 모든 아첨하는 입술과 자랑하는 혀를 끊으시리니",
      "source_text_hash": "276e653624845d867a190606fa4b935b14aeac61abcd09cfca3fdadb7e471d38",
      "translation_text_hash": "15217c2cc430b95b7261fcc284fce5d3968b39cdc93e55d850e80ebceba95dcf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 모든 아첨하는 입술과 자랑하는 혀를 끊으시리니"
      ],
      "raw_text_hashes": [
        "15217c2cc430b95b7261fcc284fce5d3968b39cdc93e55d850e80ebceba95dcf"
      ]
    },
    {
