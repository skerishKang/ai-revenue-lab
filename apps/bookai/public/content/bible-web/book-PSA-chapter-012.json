        {
          "book": "PSA",
          "chapter": 12,
          "verse": 2
        }
      ],
      "en": "Everyone lies to his neighbor. They speak with flattering lips, and with a double heart.",
      "ko": "저희가 이웃에게 각기 거짓을 말함이여 아첨하는 입술과 두 마음으로 말하는도다",
      "source_text_hash": "18a9cd2198b06632ef794c3029e5501255351ed34497fda07f15b336b1c148db",
      "translation_text_hash": "b5cc29918690ab0b20fde74e35d2e7835e3c378bd6a174b1c4cb095e232fb94b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 이웃에게 각기 거짓을 말함이여 아첨하는 입술과 두 마음으로 말하는도다"
      ],
      "raw_text_hashes": [
        "b5cc29918690ab0b20fde74e35d2e7835e3c378bd6a174b1c4cb095e232fb94b"
      ]
    },
