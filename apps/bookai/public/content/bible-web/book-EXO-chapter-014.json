        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 14,
          "verse": 6
        }
      ],
      "en": "He prepared his chariot, and took his army with him;",
      "ko": "바로가 곧 그 병거를 갖추고 그 백성을 데리고 갈새",
      "source_text_hash": "2b4a0ba00fff5fe8d8626a920d61e30d1af6b6c4ac694c1487c37e213aa8c528",
      "translation_text_hash": "741718fc0dd2ddf24657c2270ad0892538157962ccf5cfa9bb6f69e467b35140",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바로가 곧 그 병거를 갖추고 그 백성을 데리고 갈새"
      ],
      "raw_text_hashes": [
        "741718fc0dd2ddf24657c2270ad0892538157962ccf5cfa9bb6f69e467b35140"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:14:7",
      "sequence": 1897,
      "chapter_label": "EXO 14",
      "verse_label": "7",
      "locator": {
        "book": "EXO",
