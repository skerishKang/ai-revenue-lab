      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "새벽에 여호와께서 불 구름기둥 가운데서 애굽 군대를 보시고 그 군대를 어지럽게 하시며"
      ],
      "raw_text_hashes": [
