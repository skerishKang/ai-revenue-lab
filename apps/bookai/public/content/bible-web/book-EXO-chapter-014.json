    {
      "canonical_locator": "bible:web:EXO:14:8",
      "sequence": 1898,
      "chapter_label": "EXO 14",
      "verse_label": "8",
      "locator": {
        "book": "EXO",
        "chapter": 14,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 14,
          "verse": 8
        }
      ],
      "en": "The LORD hardened the heart of Pharaoh king of Egypt, and he pursued the children of Israel; for the children of Israel went out with a high hand.",
      "ko": "여호와께서 애굽 왕 바로의 마음을 강퍅케 하셨으므로 그가 이스라엘 자손의 뒤를 따르니 이스라엘 자손이 담대히 나갔음이라",
      "source_text_hash": "a8a31a62b39596d5702678f3d74abaddbc52f0f192aef72a23ccae84202a4259",
      "translation_text_hash": "991757ba335e8f4d64664543710151d1115aa8fd6d174155b289fa69c0ce8a59",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 애굽 왕 바로의 마음을 강퍅케 하셨으므로 그가 이스라엘 자손의 뒤를 따르니 이스라엘 자손이 담대히 나갔음이라"
      ],
      "raw_text_hashes": [
        "991757ba335e8f4d64664543710151d1115aa8fd6d174155b289fa69c0ce8a59"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:14:9",
      "sequence": 1899,
      "chapter_label": "EXO 14",
