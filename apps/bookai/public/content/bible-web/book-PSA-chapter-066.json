      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 66,
          "verse": 5
        }
      ],
      "en": "Come, and see God’s deeds— awesome work on behalf of the children of men.",
      "ko": "와서 하나님의 행하신 것을 보라 인생에게 행하심이 엄위하시도다",
      "source_text_hash": "1707079fddaaf3a15619db0de540875f440cda99374470e82b5bbc94e62f1004",
      "translation_text_hash": "e86ef99f8a4e87e18aeec41ac747b662701360eba1ae18a6f96c4cc4b30ae13b",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "와서 하나님의 행하신 것을 보라 인생에게 행하심이 엄위하시도다"
      ],
      "raw_text_hashes": [
        "e86ef99f8a4e87e18aeec41ac747b662701360eba1ae18a6f96c4cc4b30ae13b"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:66:6",
