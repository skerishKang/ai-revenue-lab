      "raw_texts": [
        "내가 번제를 가지고 주의 집에 들어가서 나의 서원을 갚으리니"
      ],
      "raw_text_hashes": [
        "1149b72295680fe589ff028c651cc0dae219ada1e02f3e0ae91478bb00f4501b"
      ]
    },
