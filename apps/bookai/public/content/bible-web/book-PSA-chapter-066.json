      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하나님이여 주께서 우리를 시험하시되 우리를 단련하시기를 은을 단련함 같이 하셨으며"
      ],
      "raw_text_hashes": [
        "de49615b757ec73fef9d78d2291c7e670a0ccefa4d3ad36343f7072dbd8ba297"
