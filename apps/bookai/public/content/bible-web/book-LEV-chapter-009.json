      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 9,
          "verse": 8
        }
      ],
      "en": "So Aaron came near to the altar, and killed the calf of the sin offering, which was for himself.",
      "ko": "이에 아론이 단에 나아가 자기를 위한 속죄제 송아지를 잡으매",
      "source_text_hash": "3a1921d6999d97ecce8a06fa294257d9a00a80a22c6501e8d98cbea467e21da9",
      "translation_text_hash": "6f28f9ec7d9acc7c645d37165c0a5e7a62530486ce22abe9e08d53de31384055",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이에 아론이 단에 나아가 자기를 위한 속죄제 송아지를 잡으매"
      ],
      "raw_text_hashes": [
        "6f28f9ec7d9acc7c645d37165c0a5e7a62530486ce22abe9e08d53de31384055"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:9:9",
