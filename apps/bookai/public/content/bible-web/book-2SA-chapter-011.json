      "raw_locator": [
        {
          "book": "2SA",
          "chapter": 11,
          "verse": 7
        }
      ],
      "en": "When Uriah had come to him, David asked him how Joab did, and how the people fared, and how the war prospered.",
      "ko": "우리아가 다윗에게 이르매 다윗이 요압의 안부와 군사의 안부와 싸움의 어떠한 것을 묻고",
      "source_text_hash": "bf1b84d6b01510277784515e7e63c5a101fe5ac99776a7043d4c1bbdf9b3e6b8",
      "translation_text_hash": "1c369e6a0a828cde2e191a2415cc8c267fd42939aba2e3d3c24aeb61e1dbf3a4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리아가 다윗에게 이르매 다윗이 요압의 안부와 군사의 안부와 싸움의 어떠한 것을 묻고"
      ],
      "raw_text_hashes": [
        "1c369e6a0a828cde2e191a2415cc8c267fd42939aba2e3d3c24aeb61e1dbf3a4"
      ]
    },
    {
      "canonical_locator": "bible:web:2SA:11:8",
      "sequence": 8268,
      "chapter_label": "2SA 11",
