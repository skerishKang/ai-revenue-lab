        "verse": 8
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 34,
          "verse": 8
        }
      ],
      "en": "Moses hurried and bowed his head toward the earth, and worshiped.",
      "ko": "모세가 급히 땅에 엎드리어 경배하며",
      "source_text_hash": "61e45d80306439bcaedc3497dc5fbce34794f30181b9a5aef6eabbe4d523ad53",
      "translation_text_hash": "7e12aad540c1e82426a647b0ff7f0670a26e5ee0c426432bc734b37d7a5795b3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "모세가 급히 땅에 엎드리어 경배하며"
      ],
      "raw_text_hashes": [
        "7e12aad540c1e82426a647b0ff7f0670a26e5ee0c426432bc734b37d7a5795b3"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:34:9",
      "sequence": 2506,
      "chapter_label": "EXO 34",
      "verse_label": "9",
      "locator": {
        "book": "EXO",
