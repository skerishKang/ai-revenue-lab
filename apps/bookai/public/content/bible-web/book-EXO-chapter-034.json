        "verse": 2
      },
      "raw_locator": [
        {
          "book": "EXO",
          "chapter": 34,
          "verse": 2
        }
      ],
      "en": "Be ready by the morning, and come up in the morning to Mount Sinai, and present yourself there to me on the top of the mountain.",
      "ko": "아침 전에 예비하고 아침에 시내산에 올라와 산꼭대기에서 내게 보이되",
      "source_text_hash": "8dc1632aa1ec9cc3d02fa1efe58713f41dc5794df9d9f36543392e33261490c0",
      "translation_text_hash": "0efdfc0867a00358df6800675c7551f8a5e4bffd724fc120f6edb37cf6902621",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아침 전에 예비하고 아침에 시내산에 올라와 산꼭대기에서 내게 보이되"
      ],
      "raw_text_hashes": [
        "0efdfc0867a00358df6800675c7551f8a5e4bffd724fc120f6edb37cf6902621"
      ]
    },
    {
      "canonical_locator": "bible:web:EXO:34:3",
      "sequence": 2500,
      "chapter_label": "EXO 34",
      "verse_label": "3",
      "locator": {
