    {
      "canonical_locator": "bible:web:NUM:18:25",
      "sequence": 4283,
      "chapter_label": "NUM 18",
      "verse_label": "25",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 25
        }
      ],
      "en": "The LORD spoke to Moses, saying,",
      "ko": "여호와께서 모세에게 일러 가라사대",
      "source_text_hash": "28219e5da0d26514843495c6edb280f326aa0ccffb0d2bb642d0e1b0f4478ca1",
