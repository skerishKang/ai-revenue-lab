    {
      "canonical_locator": "bible:web:NUM:18:18",
      "sequence": 4276,
      "chapter_label": "NUM 18",
      "verse_label": "18",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 18
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 18
        }
      ],
      "en": "Their meat shall be yours, as the wave offering breast and as the right thigh, it shall be yours.",
      "ko": "그 고기는 네게 돌릴찌니 흔든 가슴과 우편 넓적다리 같이 네게 돌릴 것이니라",
      "source_text_hash": "24fe8c6fa26930eb10a553c54b6355d305b6f783821f6ed05983ae153206262f",
      "translation_text_hash": "90841a84efcdd3c7cdaa05d4405af3cacfb107639d2aec7d85c1f6a955d72ed3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 고기는 네게 돌릴찌니 흔든 가슴과 우편 넓적다리 같이 네게 돌릴 것이니라"
      ],
      "raw_text_hashes": [
        "90841a84efcdd3c7cdaa05d4405af3cacfb107639d2aec7d85c1f6a955d72ed3"
      ]
