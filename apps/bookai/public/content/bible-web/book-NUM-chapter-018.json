    {
      "canonical_locator": "bible:web:NUM:18:15",
      "sequence": 4273,
      "chapter_label": "NUM 18",
      "verse_label": "15",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 15
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 15
        }
      ],
      "en": "Everything that opens the womb, of all flesh which they offer to the LORD, both of man and animal, shall be yours. Nevertheless, you shall surely redeem the firstborn of man, and you shall redeem the firstborn of unclean animals.",
      "ko": "여호와께 드리는 모든 생물의 처음 나는 것은 사람이나 짐승이나 다 네 것이로되 사람의 처음 난 것은 반드시 대속할 것이요 부정한 짐승의 처음 난 것도 대속할 것이며",
      "source_text_hash": "8c8a6c97fd274fd966551b0329859cde8771ef877aacc3749111ede3f08dbe89",
      "translation_text_hash": "c6d06b114ac22fab64344260f2321e235efd362eca4e51847117d39cec388aa6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께 드리는 모든 생물의 처음 나는 것은 사람이나 짐승이나 다 네 것이로되 사람의 처음 난 것은 반드시 대속할 것이요 부정한 짐승의 처음 난 것도 대속할 것이며"
      ],
      "raw_text_hashes": [
