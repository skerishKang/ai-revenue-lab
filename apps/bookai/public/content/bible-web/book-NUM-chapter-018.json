        "verse": 21
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 21
        }
      ],
      "en": "“To the children of Levi, behold, I have given all the tithe in Israel for an inheritance, in return for their service which they serve, even the service of the Tent of Meeting.",
      "ko": "내가 이스라엘의 십일조를 레위 자손에게 기업으로 다 주어서 그들의 하는 일 곧 회막에서 하는 일을 갚나니",
      "source_text_hash": "4a719c76298e096eb031e0cfe08d56524d976db62a7ae37e6501cf2de57ba220",
      "translation_text_hash": "c2d7ac0c3f2faef91bb5fa32fe542006d65a37c478399a9a6061e6ee9fd335bf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 이스라엘의 십일조를 레위 자손에게 기업으로 다 주어서 그들의 하는 일 곧 회막에서 하는 일을 갚나니"
      ],
      "raw_text_hashes": [
        "c2d7ac0c3f2faef91bb5fa32fe542006d65a37c478399a9a6061e6ee9fd335bf"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:18:22",
      "sequence": 4280,
      "chapter_label": "NUM 18",
      "verse_label": "22",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 22
        }
      ],
      "en": "Henceforth the children of Israel shall not come near the Tent of Meeting, lest they bear sin, and die.",
      "ko": "이 후로는 이스라엘 자손이 회막에 가까이 말 것이라 죄를 당하여 죽을까 하노라",
      "source_text_hash": "560a5b36e40c766cd2f499eb514f3bc0ff9d9b9b9c5385793dc4c8201c79137e",
      "translation_text_hash": "ffb9de8d03a03690c26bc704b2dc8a7778de39c430df14fb41a95876d5d32fc6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 후로는 이스라엘 자손이 회막에 가까이 말 것이라 죄를 당하여 죽을까 하노라"
      ],
      "raw_text_hashes": [
        "ffb9de8d03a03690c26bc704b2dc8a7778de39c430df14fb41a95876d5d32fc6"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:18:23",
      "sequence": 4281,
      "chapter_label": "NUM 18",
      "verse_label": "23",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 23
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 23
        }
      ],
      "en": "But the Levites shall do the service of the Tent of Meeting, and they shall bear their iniquity. It shall be a statute forever throughout your generations. Among the children of Israel, they shall have no inheritance.",
      "ko": "오직 레위인은 회막에서 봉사하며 자기들의 죄를 담당할 것이요 이스라엘 자손 중에는 기업이 없을 것이니 이는 너희의 대대에 영원한 율례라",
      "source_text_hash": "da2a67d7dea15bcded56b3a952b09e28087ef2a545037ee2b5c05ecd27aa5f32",
      "translation_text_hash": "ff50704791fc53cf98f35e2ab8476a7aebcb9aa0571dab81cf4af7e877cfaa94",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 레위인은 회막에서 봉사하며 자기들의 죄를 담당할 것이요 이스라엘 자손 중에는 기업이 없을 것이니 이는 너희의 대대에 영원한 율례라"
      ],
      "raw_text_hashes": [
        "ff50704791fc53cf98f35e2ab8476a7aebcb9aa0571dab81cf4af7e877cfaa94"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:18:24",
      "sequence": 4282,
      "chapter_label": "NUM 18",
      "verse_label": "24",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 24
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 24
        }
      ],
      "en": "For the tithe of the children of Israel, which they offer as a wave offering to the LORD, I have given to the Levites for an inheritance. Therefore I have said to them, ‘Among the children of Israel they shall have no inheritance.’”",
      "ko": "이스라엘 자손이 여호와께 거제로 드리는 십일조를 레위인에게 기업으로 준 고로 내가 그들에 대하여 말하기를 이스라엘 자손 중에 기업이 없을 것이라 하였노라",
      "source_text_hash": "584f23c930f4192b1e00c6a48cb1eb280c1005432da09ae317b0b0333ff74e42",
      "translation_text_hash": "e8c95d8ddceb2c2f8925d21f24889318dfbd7f6d5a0df0d41f42ded46c550a32",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이스라엘 자손이 여호와께 거제로 드리는 십일조를 레위인에게 기업으로 준 고로 내가 그들에 대하여 말하기를 이스라엘 자손 중에 기업이 없을 것이라 하였노라"
      ],
      "raw_text_hashes": [
