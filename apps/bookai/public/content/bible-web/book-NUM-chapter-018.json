    },
    {
      "canonical_locator": "bible:web:NUM:18:12",
      "sequence": 4270,
      "chapter_label": "NUM 18",
      "verse_label": "12",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 12
        }
      ],
      "en": "“I have given to you all the best of the oil, all the best of the vintage, and of the grain, the first fruits of them which they give to the LORD.",
      "ko": "그들이 여호와께 드리는 첫 소산 곧 제일 좋은 기름과 제일 좋은 포도주와 곡식을 네게 주었은즉",
      "source_text_hash": "c0b8e601c5f503d5c3fe2dfd474814a8e1137fb7a432283485ef1b11102a7057",
      "translation_text_hash": "90039fa5a7549886ececd81306c08d0d11d00052799e589e00dd9e1c6c440bf4",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들이 여호와께 드리는 첫 소산 곧 제일 좋은 기름과 제일 좋은 포도주와 곡식을 네게 주었은즉"
      ],
      "raw_text_hashes": [
        "90039fa5a7549886ececd81306c08d0d11d00052799e589e00dd9e1c6c440bf4"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:18:13",
      "sequence": 4271,
      "chapter_label": "NUM 18",
      "verse_label": "13",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 13
        }
      ],
      "en": "The first-ripe fruits of all that is in their land, which they bring to the LORD, shall be yours. Everyone who is clean in your house shall eat of it.",
      "ko": "그들이 여호와께 드리는 그 땅 처음 익은 모든 열매는 네 것이니 네 집에 정결한 자마다 먹을 것이라",
      "source_text_hash": "f2a43838190b4323d3395ee505b7267cd95dc08d12acf89e67a154d5834a8a95",
      "translation_text_hash": "d3f30351dc0cd34c78d1a8ec93ff4c78f04c9bfb6ded0f095227555fd9aedf66",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그들이 여호와께 드리는 그 땅 처음 익은 모든 열매는 네 것이니 네 집에 정결한 자마다 먹을 것이라"
      ],
      "raw_text_hashes": [
        "d3f30351dc0cd34c78d1a8ec93ff4c78f04c9bfb6ded0f095227555fd9aedf66"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:18:14",
