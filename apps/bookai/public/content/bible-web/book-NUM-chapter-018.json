      ]
    },
    {
      "canonical_locator": "bible:web:NUM:18:16",
      "sequence": 4274,
      "chapter_label": "NUM 18",
      "verse_label": "16",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 16
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 16
        }
      ],
      "en": "You shall redeem those who are to be redeemed of them from a month old, according to your estimation, for five shekels of money, according to the shekel of the sanctuary, which weighs twenty gerahs.",
      "ko": "그 사람을 속할 때에는 난지 일개월 이후에 네가 정한대로 성소의 세겔을 따라 은 다섯 세겔로 속하라 한 세겔은 이십 게라니라",
      "source_text_hash": "693337f5cb734ff1b90ae714d2116ba749474e552b76db0df8c9a7a52e5069d5",
      "translation_text_hash": "d50fefd2571f60a5f3e1cde9bd06cee44827231bf96e26896ab74d504715e234",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 사람을 속할 때에는 난지 일개월 이후에 네가 정한대로 성소의 세겔을 따라 은 다섯 세겔로 속하라 한 세겔은 이십 게라니라"
      ],
      "raw_text_hashes": [
        "d50fefd2571f60a5f3e1cde9bd06cee44827231bf96e26896ab74d504715e234"
      ]
