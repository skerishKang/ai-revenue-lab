    {
      "canonical_locator": "bible:web:NUM:18:17",
      "sequence": 4275,
      "chapter_label": "NUM 18",
      "verse_label": "17",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 17
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 17
        }
      ],
      "en": "“But you shall not redeem the firstborn of a cow, or the firstborn of a sheep, or the firstborn of a goat. They are holy. You shall sprinkle their blood on the altar, and shall burn their fat for an offering made by fire, for a pleasant aroma to the LORD.",
      "ko": "오직 소의 처음 난 것이나 양의 처음 난 것이나 염소의 처음 난 것은 속하지 말찌니 그것들은 거룩한즉 그 피는 단에 뿌리고 그 기름은 불살라 여호와께 향기로운 화제로 드릴 것이며",
      "source_text_hash": "46a57d711eb79da9e73659f2b4f7bae4c1a88af408fe55c714ed131469b36bbb",
      "translation_text_hash": "b3e1f3d7c5bc7d878be8af46b4c42544c7e83cc68f7f8b04ae8d6407516a7e4d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "오직 소의 처음 난 것이나 양의 처음 난 것이나 염소의 처음 난 것은 속하지 말찌니 그것들은 거룩한즉 그 피는 단에 뿌리고 그 기름은 불살라 여호와께 향기로운 화제로 드릴 것이며"
      ],
      "raw_text_hashes": [
        "b3e1f3d7c5bc7d878be8af46b4c42544c7e83cc68f7f8b04ae8d6407516a7e4d"
