    },
    {
      "canonical_locator": "bible:web:NUM:18:20",
      "sequence": 4278,
      "chapter_label": "NUM 18",
      "verse_label": "20",
      "locator": {
        "book": "NUM",
        "chapter": 18,
        "verse": 20
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 18,
          "verse": 20
        }
      ],
      "en": "The LORD said to Aaron, “You shall have no inheritance in their land, neither shall you have any portion among them. I am your portion and your inheritance among the children of Israel.",
      "ko": "여호와께서 또 아론에게 이르시되 너는 이스라엘 자손의 땅의 기업도 없겠고 그들 중에 아무 분깃도 없을 것이나 나는 이스라엘 자손 중에 네 분깃이요 네 기업이니라",
      "source_text_hash": "3563dd092a53b8d0e26f6fb3767b3b002c3fb5ead43ebd38eeb6ee2ee4c4c6c7",
      "translation_text_hash": "02ce45745039cce6461876dda9d84d072c0d9ee67e666f7311d91a199d52039c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 또 아론에게 이르시되 너는 이스라엘 자손의 땅의 기업도 없겠고 그들 중에 아무 분깃도 없을 것이나 나는 이스라엘 자손 중에 네 분깃이요 네 기업이니라"
      ],
      "raw_text_hashes": [
