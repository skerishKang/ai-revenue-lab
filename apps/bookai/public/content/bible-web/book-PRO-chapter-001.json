      "raw_locator": [
        {
          "book": "PRO",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "My son, listen to your father’s instruction, and don’t forsake your mother’s teaching;",
      "ko": "내 아들아 네 아비의 훈계를 들으며 네 어미의 법을 떠나지 말라",
      "source_text_hash": "566d6c690fbf60853c51424dbe81fbf8ebff0a7cb44fb144c7684ac036f35510",
      "translation_text_hash": "e3c4daa3803568f5cc220dc8ab60e3e8d3f5b39e4fbb9d6a3187c0f02b81acb1",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내 아들아 네 아비의 훈계를 들으며 네 어미의 법을 떠나지 말라"
      ],
      "raw_text_hashes": [
        "e3c4daa3803568f5cc220dc8ab60e3e8d3f5b39e4fbb9d6a3187c0f02b81acb1"
      ]
    },
