      "translation_text_hash": "1e7750a746b0c1cc9f260358e19096e44d1856708264206180cc8f65e1ced632",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
