      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 21,
          "verse": 12
        }
      ],
      "en": "David laid up these words in his heart, and was very afraid of Achish the king of Gath.",
      "ko": "다윗이 이 말을 그 마음에 두고 가드 왕 아기스를 심히 두려워하여",
      "source_text_hash": "3b147e2f47c7bb2c3c8ee6e4cb4fdddc1b0db4fa7738033e6a8b9fa0b306ade4",
      "translation_text_hash": "cb5ab85f17b81555cd5989240bdcd6442fca3ddf0d84975cb8008c4f608a6f18",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
