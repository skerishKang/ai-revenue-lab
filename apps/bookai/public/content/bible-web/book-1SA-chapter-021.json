      "sequence": 7783,
      "chapter_label": "1SA 21",
      "verse_label": "10",
      "locator": {
        "book": "1SA",
        "chapter": 21,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "1SA",
          "chapter": 21,
          "verse": 10
        }
      ],
      "en": "David arose and fled that day for fear of Saul, and went to Achish the king of Gath.",
      "ko": "그 날에 다윗이 사울을 두려워하여 일어나 도망하여 가드 왕 아기스에게로 가니",
      "source_text_hash": "bf50dba1a1cc35791b82061473b9ba1fee0b425b2888eb0aa7992dbbb2ab8150",
      "translation_text_hash": "ce9baef89c4d612fc8c81cf2515b5f12297d73f7404dbbcf7062b958aacf4f92",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 날에 다윗이 사울을 두려워하여 일어나 도망하여 가드 왕 아기스에게로 가니"
      ],
      "raw_text_hashes": [
        "ce9baef89c4d612fc8c81cf2515b5f12297d73f7404dbbcf7062b958aacf4f92"
      ]
    },
    {
      "canonical_locator": "bible:web:1SA:21:11",
      "sequence": 7784,
