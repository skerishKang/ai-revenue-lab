      "raw_locator": [
        {
          "book": "EZR",
          "chapter": 7,
          "verse": 8
        }
      ],
      "en": "He came to Jerusalem in the fifth month, which was in the seventh year of the king.",
      "ko": "이 에스라가 올라왔으니 왕의 칠년 오월이라",
      "source_text_hash": "1e05acdeaa0f7d688148714dddeedc9d4048b66b1a0550f4a083af9c6db92a8c",
      "translation_text_hash": "63deabcc205a7d3111bd7fab9f3320af14a326fe9c311d48e8bb339ad374a5b7",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
