        "chapter": 7,
        "verse": 22
      },
      "raw_locator": [
        {
          "book": "EZR",
          "chapter": 7,
          "verse": 22
        }
      ],
      "en": "up to one hundred talents of silver, and to one hundred cors of wheat, and to one hundred baths of wine, and to one hundred baths of oil, and salt without prescribing how much.",
      "ko": "은은 일백 달란트까지, 밀은 일백 고르까지, 포도주는 일백 밧까지, 기름도 일백 밧까지 하고 소금은 정수 없이 하라",
      "source_text_hash": "2f873f530e6f1548c719a09212e75634063c494421e7b285022927b49985d299",
      "translation_text_hash": "a972593c896f3542d01651f86628cb44459c55c58f3d20152d460393c16844f3",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "은은 일백 달란트까지, 밀은 일백 고르까지, 포도주는 일백 밧까지, 기름도 일백 밧까지 하고 소금은 정수 없이 하라"
      ],
      "raw_text_hashes": [
