      "translation_text_hash": "377cbbf3ce3776ef67d17ed71f289783a4b6a7e3eab6327849393361e6007e74",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
