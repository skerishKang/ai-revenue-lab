      "source_text_hash": "2fd149794405bf8b212a7e487fe3e692e6de1e6bb7fc8acb694d2392d2431efd",
      "translation_text_hash": "d1ae1ad7a6928d9161579a0d8219502a79cf27cd73d22e05ba8e0128d69c6e9a",
