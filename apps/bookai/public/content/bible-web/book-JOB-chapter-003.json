      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 날이 캄캄하였었더라면, 하나님이 위에서 돌아보지 마셨더라면, 빛도 그 날을 비취지 말았었더라면,"
      ],
      "raw_text_hashes": [
