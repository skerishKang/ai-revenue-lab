      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "날을 저주하는 자 곧 큰 악어를 격동시키기에 익숙한 자가 그 밤을 저주하였었더라면,"
      ],
      "raw_text_hashes": [
        "22ed4d55247b9b0e6bd98b170bea4bf5a055304e93b14f1150e7d636279a1cdc"
      ]
