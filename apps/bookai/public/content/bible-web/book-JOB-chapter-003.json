      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 난 날이 멸망하였었더라면, 남아를 배었다 하던 그 밤도 그러하였었더라면,"
      ],
      "raw_text_hashes": [
