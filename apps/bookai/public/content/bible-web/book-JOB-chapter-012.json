      "raw_texts": [
        "땅에게 말하라 네게 가르치리라 바다의 고기도 네게 설명하리라"
      ],
      "raw_text_hashes": [
        "540e3833c370fc90812a77fe71d3784fc32e6becae93c6b4a70fe3942032306a"
      ]
