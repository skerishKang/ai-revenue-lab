      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 12,
          "verse": 8
        }
      ],
      "en": "Or speak to the earth, and it will teach you. The fish of the sea will declare to you.",
      "ko": "땅에게 말하라 네게 가르치리라 바다의 고기도 네게 설명하리라",
      "source_text_hash": "2eeff7ed0ce7a7b18beea1070b11e595abd33cea04442eef1e7fa4b51438141e",
      "translation_text_hash": "540e3833c370fc90812a77fe71d3784fc32e6becae93c6b4a70fe3942032306a",
      "translation_policy": "krv-1961-source-mapped",
