        {
          "book": "JOB",
          "chapter": 12,
          "verse": 5
        }
      ],
      "en": "In the thought of him who is at ease there is contempt for misfortune. It is ready for them whose foot slips.",
      "ko": "평안한 자의 마음은 재앙을 멸시하나 재앙이 실족하는 자를 기다리는구나",
      "source_text_hash": "b7bb0ac55339b1b55ce8f854aaf4ca6254edfea3fe3c6852646346cdb7d1b637",
      "translation_text_hash": "c6dc406443a41e211462a0c35c7914f8eea7c38d71fa1553e8dc184cb45ebf02",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "평안한 자의 마음은 재앙을 멸시하나 재앙이 실족하는 자를 기다리는구나"
      ],
      "raw_text_hashes": [
        "c6dc406443a41e211462a0c35c7914f8eea7c38d71fa1553e8dc184cb45ebf02"
      ]
    },
    {
      "canonical_locator": "bible:web:JOB:12:6",
      "sequence": 13135,
      "chapter_label": "JOB 12",
      "verse_label": "6",
      "locator": {
