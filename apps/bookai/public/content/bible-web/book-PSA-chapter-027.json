        "verse": 13
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 27,
          "verse": 13
        }
      ],
      "en": "I am still confident of this: I will see the goodness of the LORD in the land of the living.",
      "ko": "내가 산 자의 땅에 있음이여 여호와의 은혜 볼 것을 믿었도다",
      "source_text_hash": "37eac02db1e69a19167090f3f4636da68df6c89c6e4241fd1611def798c41ab6",
      "translation_text_hash": "6634ce880dc55cba9a44191d534863330c4b8c3ef7cb8add7e9e0f489de51c52",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 산 자의 땅에 있음이여 여호와의 은혜 볼 것을 믿었도다"
      ],
      "raw_text_hashes": [
        "6634ce880dc55cba9a44191d534863330c4b8c3ef7cb8add7e9e0f489de51c52"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:27:14",
      "sequence": 14300,
      "chapter_label": "PSA 27",
      "verse_label": "14",
      "locator": {
        "book": "PSA",
        "chapter": 27,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 27,
          "verse": 14
        }
      ],
      "en": "Wait for the LORD. Be strong, and let your heart take courage. Yes, wait for the LORD.",
