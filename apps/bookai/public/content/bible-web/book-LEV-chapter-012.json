        "verse": 3
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 12,
          "verse": 3
        }
      ],
      "en": "In the eighth day the flesh of his foreskin shall be circumcised.",
      "ko": "제 팔일에는 그 아이의 양피를 벨 것이요",
      "source_text_hash": "4711f561e5a83df7c28e741282c28abe1c89c6975907e0932696946056675fba",
      "translation_text_hash": "17984668850ceb95dcec251a45997ff86d9f50b0011a758d12da9dfe043e4832",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제 팔일에는 그 아이의 양피를 벨 것이요"
      ],
      "raw_text_hashes": [
        "17984668850ceb95dcec251a45997ff86d9f50b0011a758d12da9dfe043e4832"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:12:4",
      "sequence": 3049,
      "chapter_label": "LEV 12",
      "verse_label": "4",
      "locator": {
        "book": "LEV",
        "chapter": 12,
        "verse": 4
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 12,
          "verse": 4
        }
      ],
      "en": "She shall continue in the blood of purification thirty-three days. She shall not touch any holy thing, nor come into the sanctuary, until the days of her purifying are completed.",
      "ko": "그 여인은 오히려 삼십 삼일을 지나야 산혈이 깨끗하리니 정결케 되는 기한이 차기 전에는 성물을 만지지도 말며 성소에 들어가지도 말 것이며",
      "source_text_hash": "12e4df3cb2974ec749805b20f625e185e89c722624bfa3b4350fff11903d9b98",
      "translation_text_hash": "2ce363f83f5c863691e5aa03214af4813fd5325b827447f6147d49c192292daf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 여인은 오히려 삼십 삼일을 지나야 산혈이 깨끗하리니 정결케 되는 기한이 차기 전에는 성물을 만지지도 말며 성소에 들어가지도 말 것이며"
      ],
      "raw_text_hashes": [
        "2ce363f83f5c863691e5aa03214af4813fd5325b827447f6147d49c192292daf"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:12:5",
      "sequence": 3050,
      "chapter_label": "LEV 12",
      "verse_label": "5",
      "locator": {
        "book": "LEV",
        "chapter": 12,
        "verse": 5
      },
      "raw_locator": [
        {
          "book": "LEV",
          "chapter": 12,
          "verse": 5
        }
      ],
      "en": "But if she bears a female child, then she shall be unclean two weeks, as in her period; and she shall continue in the blood of purification sixty-six days.",
      "ko": "여자를 낳으면 그는 이 칠일 동안 부정하리니 경도할 때와 같을 것이며 산혈이 깨끗하게 됨은 육십 륙일을 지나야 하리라",
      "source_text_hash": "9a13ada8b4ca99f8e4db3db5fee8f5766b2012ebabcc804cc082eaf0ccc74beb",
      "translation_text_hash": "bcc110ca1e079c5a1d2d1acf2c38f1378235d937770469af307bb2a649b8bb50",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여자를 낳으면 그는 이 칠일 동안 부정하리니 경도할 때와 같을 것이며 산혈이 깨끗하게 됨은 육십 륙일을 지나야 하리라"
      ],
      "raw_text_hashes": [
        "bcc110ca1e079c5a1d2d1acf2c38f1378235d937770469af307bb2a649b8bb50"
      ]
    },
    {
      "canonical_locator": "bible:web:LEV:12:6",
      "sequence": 3051,
      "chapter_label": "LEV 12",
      "verse_label": "6",
      "locator": {
        "book": "LEV",
