      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 14,
          "verse": 7
        }
      ],
      "en": "The whole earth is at rest, and is quiet. They break out in song.",
      "ko": "이제는 온 땅이 평안하고 정온하니 무리가 소리질러 노래하는도다",
      "source_text_hash": "1e3708830cc79edaae582460c63b4e639308cca566fd3a55cb2b6048ee80f53e",
      "translation_text_hash": "85b6cfcf9f8f17943fd6f73917d05a2a532fb6e773bc7cc7500bce9c7fc929e2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
