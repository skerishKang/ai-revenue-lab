      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 14,
          "verse": 5
        }
      ],
      "en": "The LORD has broken the staff of the wicked, the scepter of the rulers,",
      "ko": "여호와께서 악인의 몽둥이와 패권자의 홀을 꺾으셨도다",
      "source_text_hash": "983f3f54dfc495e760835e03f167461340d9d40b2f8b3d2e319749a6c6faf5b4",
      "translation_text_hash": "4e6ec1231256dce8a69f67a1048af630cd87b46a11c07be9c9a11c592a2fc06d",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 악인의 몽둥이와 패권자의 홀을 꺾으셨도다"
      ],
      "raw_text_hashes": [
        "4e6ec1231256dce8a69f67a1048af630cd87b46a11c07be9c9a11c592a2fc06d"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:14:6",
