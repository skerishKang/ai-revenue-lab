      ],
      "raw_text_hashes": [
        "85b6cfcf9f8f17943fd6f73917d05a2a532fb6e773bc7cc7500bce9c7fc929e2"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:14:8",
      "sequence": 17937,
      "chapter_label": "ISA 14",
      "verse_label": "8",
      "locator": {
        "book": "ISA",
