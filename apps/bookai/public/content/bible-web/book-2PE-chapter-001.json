        "verse": 13
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 1,
          "verse": 13
        }
      ],
      "en": "I think it right, as long as I am in this tent, to stir you up by reminding you,",
      "ko": "내가 이 장막에 있을 동안에 너희를 일깨워 생각하게 함이 옳은 줄로 여기노니",
      "source_text_hash": "35febb9e78cdba8745c382799e1b3349028b2a3865a84d39ea7dcff5f752baa0",
      "translation_text_hash": "97d491c332a96a240ff897f7e2e81ad7033ffa4ea932a724ab44f6f34fa5ba96",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 이 장막에 있을 동안에 너희를 일깨워 생각하게 함이 옳은 줄로 여기노니"
      ],
      "raw_text_hashes": [
        "97d491c332a96a240ff897f7e2e81ad7033ffa4ea932a724ab44f6f34fa5ba96"
      ]
    },
    {
      "canonical_locator": "bible:web:2PE:1:14",
      "sequence": 30490,
      "chapter_label": "2PE 1",
      "verse_label": "14",
      "locator": {
        "book": "2PE",
