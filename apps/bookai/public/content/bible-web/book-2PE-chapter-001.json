        "verse": 6
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 1,
          "verse": 6
        }
      ],
      "en": "and in knowledge, self-control; and in self-control, perseverance; and in perseverance, godliness;",
      "ko": "지식에 절제를, 절제에 인내를, 인내에 경건을,",
      "source_text_hash": "610aeab8cb3dbc7c4be4ed04d7744657ecf748bd6a40d52b52b033451f361ab3",
      "translation_text_hash": "8c8347de6b205682f6257a198b8afd043db90753ee9e242a54aa6d577acef63a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "지식에 절제를, 절제에 인내를, 인내에 경건을,"
      ],
      "raw_text_hashes": [
        "8c8347de6b205682f6257a198b8afd043db90753ee9e242a54aa6d577acef63a"
      ]
    },
    {
      "canonical_locator": "bible:web:2PE:1:7",
      "sequence": 30483,
      "chapter_label": "2PE 1",
      "verse_label": "7",
      "locator": {
        "book": "2PE",
        "chapter": 1,
        "verse": 7
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 1,
          "verse": 7
        }
      ],
      "en": "and in godliness, brotherly affection; and in brotherly affection, love.",
      "ko": "경건에 형제 우애를, 형제 우애에 사랑을 공급하라",
      "source_text_hash": "0b5afe6d7110c5ce86843e43c2cd9bc06a8fbdd18805e637f5df53f8986319e4",
      "translation_text_hash": "8e0818b547da5b17d1f2e273cd443fd0740f1e1e7439589f4b95f3747186c7df",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "경건에 형제 우애를, 형제 우애에 사랑을 공급하라"
      ],
      "raw_text_hashes": [
        "8e0818b547da5b17d1f2e273cd443fd0740f1e1e7439589f4b95f3747186c7df"
      ]
    },
    {
      "canonical_locator": "bible:web:2PE:1:8",
      "sequence": 30484,
      "chapter_label": "2PE 1",
      "verse_label": "8",
      "locator": {
        "book": "2PE",
        "chapter": 1,
        "verse": 8
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 1,
          "verse": 8
        }
      ],
      "en": "For if these things are yours and abound, they make you to not be idle or unfruitful in the knowledge of our Lord Jesus Christ.",
      "ko": "이런 것이 너희에게 있어 흡족한즉 너희로 우리 주 예수 그리스도를 알기에 게으르지 않고 열매 없는 자가 되지 않게 하려니와",
      "source_text_hash": "631a79c747446ed27cc56602863007f0aff0ee7ac61ecc79eaeb7b13e6f59e91",
      "translation_text_hash": "b2ad27163a238f652bc3c613c2036d00322dc51753d89ede4a1e0c79e2abc686",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이런 것이 너희에게 있어 흡족한즉 너희로 우리 주 예수 그리스도를 알기에 게으르지 않고 열매 없는 자가 되지 않게 하려니와"
      ],
      "raw_text_hashes": [
        "b2ad27163a238f652bc3c613c2036d00322dc51753d89ede4a1e0c79e2abc686"
      ]
    },
    {
      "canonical_locator": "bible:web:2PE:1:9",
      "sequence": 30485,
      "chapter_label": "2PE 1",
      "verse_label": "9",
      "locator": {
        "book": "2PE",
        "chapter": 1,
        "verse": 9
      },
      "raw_locator": [
        {
          "book": "2PE",
          "chapter": 1,
          "verse": 9
        }
      ],
      "en": "For he who lacks these things is blind, seeing only what is near, having forgotten the cleansing from his old sins.",
      "ko": "이런 것이 없는 자는 소경이라 원시치 못하고 그의 옛 죄를 깨끗케 하심을 잊었느니라",
      "source_text_hash": "39b4daef3463fef11b9dbac0396f34486a4bd7037bdebc5b83163c188232b562",
      "translation_text_hash": "ed1511704175f991bd6e7ca4d77855134567f24e27f8c3d171d3f3a5388289cd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이런 것이 없는 자는 소경이라 원시치 못하고 그의 옛 죄를 깨끗케 하심을 잊었느니라"
      ],
      "raw_text_hashes": [
        "ed1511704175f991bd6e7ca4d77855134567f24e27f8c3d171d3f3a5388289cd"
      ]
    },
    {
      "canonical_locator": "bible:web:2PE:1:10",
      "sequence": 30486,
      "chapter_label": "2PE 1",
      "verse_label": "10",
      "locator": {
        "book": "2PE",
