      ],
      "en": "Woe to those who decree unrighteous decrees, and to the writers who write oppressive decrees",
      "ko": "불의한 법령을 발포하며 불의한 말을 기록하며",
      "source_text_hash": "ca70a31f563930ff0fbf39334de7d32d95ebe1f358b6236ec8ed4d4d89cb6738",
      "translation_text_hash": "d3a21bdbf538ac1640c2bc203c0cdd31ccec748f3f245c82cf65cacae0919afc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "불의한 법령을 발포하며 불의한 말을 기록하며"
      ],
      "raw_text_hashes": [
        "d3a21bdbf538ac1640c2bc203c0cdd31ccec748f3f245c82cf65cacae0919afc"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:10:2",
