      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 42,
          "verse": 12
        }
      ],
      "en": "Let them give glory to the LORD, and declare his praise in the islands.",
      "ko": "여호와께 영광을 돌리며 섬들 중에서 그의 찬송을 선전할찌어다",
      "source_text_hash": "cdf0f0ca0a64eaff3fd3fb637cd0111ae11f7ca11aa127caac834c342713d0ed",
      "translation_text_hash": "95874bedcc3002f98e325dc3f62244e0d6366dca0bf87b38edfd844d8f369c73",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께 영광을 돌리며 섬들 중에서 그의 찬송을 선전할찌어다"
      ],
      "raw_text_hashes": [
        "95874bedcc3002f98e325dc3f62244e0d6366dca0bf87b38edfd844d8f369c73"
      ]
    },
    {
