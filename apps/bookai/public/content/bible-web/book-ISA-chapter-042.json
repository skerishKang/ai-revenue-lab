      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 42,
          "verse": 21
        }
      ],
      "en": "It pleased the LORD, for his righteousness’ sake, to magnify the law and make it honorable.",
      "ko": "여호와께서 자기의 의로우심을 인하여 기쁨으로 그 교훈을 크게 하며 존귀케 하려 하셨으나",
      "source_text_hash": "2a9ff067b20aaab89e93da62064bc80ab34ddd14c686b89d9b79eaffad53ee98",
      "translation_text_hash": "32f755cdf78ce6c79ce5878016cac76971bafd0d65d06e748c743bf29e1a1cfc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 자기의 의로우심을 인하여 기쁨으로 그 교훈을 크게 하며 존귀케 하려 하셨으나"
      ],
      "raw_text_hashes": [
