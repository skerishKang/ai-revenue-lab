      },
      "raw_locator": [
        {
          "book": "1TH",
          "chapter": 4,
          "verse": 4
        }
      ],
      "en": "that each one of you know how to control his own body in sanctification and honor,",
      "ko": "각각 거룩함과 존귀함으로 자기의 아내 취할 줄을 알고",
      "source_text_hash": "0686072cd388b36a488dc4c0d317adca63171c230303acb0d86bf1987bcb03aa",
      "translation_text_hash": "5d4c0b1d1769885cd037f9d744b2b5b3ce463a99f8c793ad03c82afb90cbb10c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "각각 거룩함과 존귀함으로 자기의 아내 취할 줄을 알고"
      ],
      "raw_text_hashes": [
        "5d4c0b1d1769885cd037f9d744b2b5b3ce463a99f8c793ad03c82afb90cbb10c"
      ]
    },
    {
      "canonical_locator": "bible:web:1TH:4:5",
      "sequence": 29605,
      "chapter_label": "1TH 4",
      "verse_label": "5",
      "locator": {
