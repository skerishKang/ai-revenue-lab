        "verse": 24
      },
      "raw_locator": [
        {
          "book": "GEN",
          "chapter": 25,
          "verse": 24
        }
      ],
      "en": "When her days to be delivered were fulfilled, behold, there were twins in her womb.",
      "ko": "그 해산 기한이 찬즉 태에 쌍동이가 있었는데",
      "source_text_hash": "91b9854fcd2289671775a1039d41955056b6ddc5114499026f057611d58606f5",
      "translation_text_hash": "c6dd1f4d2d57df38ce85097b186cd18b5283ec480f4f7e36fc8d27f8e74a34de",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 해산 기한이 찬즉 태에 쌍동이가 있었는데"
      ],
      "raw_text_hashes": [
        "c6dd1f4d2d57df38ce85097b186cd18b5283ec480f4f7e36fc8d27f8e74a34de"
      ]
    },
    {
