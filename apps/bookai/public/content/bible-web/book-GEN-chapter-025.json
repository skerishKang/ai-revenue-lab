      "en": "Abraham gave all that he had to Isaac,",
      "ko": "아브라함이 이삭에게 자기 모든 소유를 주었고",
      "source_text_hash": "6e74083fecbe198cd2e4f5c9823aeb093835e85fce13eaf39a452c5b03289876",
      "translation_text_hash": "aeecfe9a2504ec422a196c66067980bc8e43f9c89d77502d120b508870d45844",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "아브라함이 이삭에게 자기 모든 소유를 주었고"
      ],
      "raw_text_hashes": [
        "aeecfe9a2504ec422a196c66067980bc8e43f9c89d77502d120b508870d45844"
      ]
    },
    {
