        "chapter": 31,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "PSA",
          "chapter": 31,
          "verse": 12
        }
      ],
      "en": "I am forgotten from their hearts like a dead man. I am like broken pottery.",
      "ko": "내가 잊어버린바 됨이 사망한 자를 마음에 두지 아니함 같고 파기와 같으니이다",
      "source_text_hash": "db98d7659e97d89f481011854aaae1df333010351c57f6381f8e2fec22eab3a5",
      "translation_text_hash": "63adf81872779e4229c82a9434d35f7e7e23588cc8a485126899c069f5500726",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 잊어버린바 됨이 사망한 자를 마음에 두지 아니함 같고 파기와 같으니이다"
      ],
      "raw_text_hashes": [
        "63adf81872779e4229c82a9434d35f7e7e23588cc8a485126899c069f5500726"
      ]
    },
    {
      "canonical_locator": "bible:web:PSA:31:13",
      "sequence": 14345,
      "chapter_label": "PSA 31",
      "verse_label": "13",
      "locator": {
