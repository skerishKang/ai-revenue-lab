      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "게바가 안디옥에 이르렀을 때에 책망할 일이 있기로 내가 저를 면책하였노라"
      ],
      "raw_text_hashes": [
        "c0bcbccb1b4a0ecf699c68ad619fc4da4598ac5b192aab9d02f892af7b888eba"
      ]
