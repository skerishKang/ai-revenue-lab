      "source_text_hash": "11ac835c1d888c4db04f47834bc412047c79536f4bcc30377c0728bfe72af510",
      "translation_text_hash": "c0090689457f3bc64238df502c593d25f6f600e1b683b4ad207b9f1aa98c70b3",
