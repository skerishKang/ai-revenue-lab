      "raw_texts": [
        "열매가 익으면 곧 낫을 대나니 이는 추수 때가 이르렀음이니라"
      ],
      "raw_text_hashes": [
        "4b7920edb95356463dcb5c77515e21ade7efb59880099393a372502567aceb22"
      ]
    },
