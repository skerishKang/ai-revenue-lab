      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 속에 뿌리가 없어 잠간 견디다가 말씀을 인하여 환난이나 핍박이 일어나는 때에는 곧 넘어지는 자요"
      ],
      "raw_text_hashes": [
