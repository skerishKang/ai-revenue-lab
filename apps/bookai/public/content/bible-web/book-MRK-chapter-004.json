      "raw_texts": [
        "저가 밤낮 자고 깨고 하는 중에 씨가 나서 자라되 그 어떻게 된 것을 알지 못하느니라"
      ],
      "raw_text_hashes": [
        "bd7120cbf5b46366730c5a2c61496ad8991f3a83706fcd30bb1bad2e51cee3c7"
      ]
