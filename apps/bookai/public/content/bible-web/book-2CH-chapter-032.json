        "chapter": 32,
        "verse": 6
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 32,
          "verse": 6
        }
      ],
      "en": "He set captains of war over the people, gathered them together to him in the wide place at the gate of the city, and spoke encouragingly to them, saying,",
      "ko": "군대 장관들을 세워 백성을 거느리게 하고 성문 광장 자기에게로 무리를 모으고 말로 위로하여 가로되",
      "source_text_hash": "a2a6adc45e6fdf02c003cbe0cde43b06bcbd2fbbf75e069bd44b08bd36fde7e6",
      "translation_text_hash": "277a34e380b576a1fa13abef7f85b95b519bc43b613bd212dc751daeda020bf5",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "군대 장관들을 세워 백성을 거느리게 하고 성문 광장 자기에게로 무리를 모으고 말로 위로하여 가로되"
      ],
      "raw_text_hashes": [
        "277a34e380b576a1fa13abef7f85b95b519bc43b613bd212dc751daeda020bf5"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:32:7",
      "sequence": 11883,
      "chapter_label": "2CH 32",
      "verse_label": "7",
      "locator": {
        "book": "2CH",
