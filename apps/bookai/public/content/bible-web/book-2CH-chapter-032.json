    {
      "canonical_locator": "bible:web:2CH:32:13",
      "sequence": 11889,
      "chapter_label": "2CH 32",
      "verse_label": "13",
      "locator": {
        "book": "2CH",
        "chapter": 32,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 32,
          "verse": 13
        }
      ],
      "en": "Don’t you know what I and my fathers have done to all the peoples of the lands? Were the gods of the nations of those lands in any way able to deliver their land out of my hand?",
      "ko": "나와 내 열조가 이방 모든 백성에게 행한 것을 너희가 알지 못하느냐 열방의 신들이 능히 그 땅을 나의 손에서 건져 낼 수 있었느냐",
      "source_text_hash": "5fb2010213518225b146cfa172b73df39403f23b84231895746be4a3a2b8e3aa",
      "translation_text_hash": "b73f2406d45b4bea3e038ddd8e5a0d5dcfde4e611e7b739d7e7b8f846319dd24",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나와 내 열조가 이방 모든 백성에게 행한 것을 너희가 알지 못하느냐 열방의 신들이 능히 그 땅을 나의 손에서 건져 낼 수 있었느냐"
      ],
      "raw_text_hashes": [
        "b73f2406d45b4bea3e038ddd8e5a0d5dcfde4e611e7b739d7e7b8f846319dd24"
      ]
    },
    {
      "canonical_locator": "bible:web:2CH:32:14",
      "sequence": 11890,
      "chapter_label": "2CH 32",
      "verse_label": "14",
      "locator": {
        "book": "2CH",
        "chapter": 32,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "2CH",
          "chapter": 32,
          "verse": 14
        }
      ],
      "en": "Who was there among all the gods of those nations which my fathers utterly destroyed that could deliver his people out of my hand, that your God should be able to deliver you out of my hand?",
      "ko": "나의 열조가 진멸한 열국의 그 모든 신 중에 누가 능히 그 백성을 내 손에서 건져내었기에 너희 하나님이 능히 너희를 내 손에서 건지겠느냐",
      "source_text_hash": "b595a4430c241015d93f649281527c22c3216f19be89ddd10cdf0e9475b72c7a",
      "translation_text_hash": "84226794e228b42d5887b4a86c83d6b62c9b02e7d15e10828328df74be1bf399",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "나의 열조가 진멸한 열국의 그 모든 신 중에 누가 능히 그 백성을 내 손에서 건져내었기에 너희 하나님이 능히 너희를 내 손에서 건지겠느냐"
      ],
      "raw_text_hashes": [
        "84226794e228b42d5887b4a86c83d6b62c9b02e7d15e10828328df74be1bf399"
      ]
