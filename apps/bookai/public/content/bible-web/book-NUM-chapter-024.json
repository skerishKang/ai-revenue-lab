        "verse": 7
      },
      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 24,
          "verse": 7
        }
      ],
      "en": "Water shall flow from his buckets. His seed shall be in many waters. His king shall be higher than Agag. His kingdom shall be exalted.",
      "ko": "그 통에서는 물이 넘치겠고 그 종자는 많은 물 가에 있으리로다 그 왕이 아각보다 높으니 그 나라가 진흥하리로다",
      "source_text_hash": "c58926d60af9d71845aa3919a740fb58c9e911abfa1a591cb24aff8a041c6a92",
      "translation_text_hash": "a277e18feb01b9a9daaa64fbf0ab5a9cc82e3ba650e724e82745d16cc6e26f50",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 통에서는 물이 넘치겠고 그 종자는 많은 물 가에 있으리로다 그 왕이 아각보다 높으니 그 나라가 진흥하리로다"
      ],
      "raw_text_hashes": [
        "a277e18feb01b9a9daaa64fbf0ab5a9cc82e3ba650e724e82745d16cc6e26f50"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:24:8",
      "sequence": 4455,
      "chapter_label": "NUM 24",
      "verse_label": "8",
      "locator": {
        "book": "NUM",
