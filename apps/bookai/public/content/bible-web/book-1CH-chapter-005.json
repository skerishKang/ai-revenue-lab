      "canonical_locator": "bible:web:1CH:5:25",
      "sequence": 10454,
      "chapter_label": "1CH 5",
      "verse_label": "25",
      "locator": {
        "book": "1CH",
        "chapter": 5,
        "verse": 25
      },
      "raw_locator": [
        {
          "book": "1CH",
          "chapter": 5,
          "verse": 25
        }
      ],
      "en": "They trespassed against the God of their fathers, and played the prostitute after the gods of the peoples of the land whom God destroyed before them.",
      "ko": "저희가 그 열조의 하나님께 범죄하여 하나님이 저희 앞에서 멸하신 그 땅 백성의 신들을 간음하듯 섬긴지라",
      "source_text_hash": "fa9ae8f90ce556e2761b9c2bf51d063bb5864f0b2c3c83277b4d90efa4a79725",
      "translation_text_hash": "709dc9bcf9b53257c484677b5e77f910b259c4b8e6441a3139d3c0f157f221fd",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "저희가 그 열조의 하나님께 범죄하여 하나님이 저희 앞에서 멸하신 그 땅 백성의 신들을 간음하듯 섬긴지라"
      ],
      "raw_text_hashes": [
