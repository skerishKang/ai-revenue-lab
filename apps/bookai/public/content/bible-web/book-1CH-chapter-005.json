      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 족장은 에벨과 이시와 엘리엘과 아스리엘과 예레미야와 호다위야와 야디엘이라 다 용력이 유명한 족장이었더라"
      ],
