      "source_text_hash": "7d35370174dbe6bd8e608540204cfe56adf52faa74d59087c9337783158682c4",
      "translation_text_hash": "3706ed24a8ad3d15e5b4c38f73baf8c3639545b3bd86affc56d42c31ad2c2b0a",
      "translation_policy": "krv-1961-source-mapped",
