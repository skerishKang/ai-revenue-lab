        "verse": 3
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 59,
          "verse": 3
        }
      ],
      "en": "For your hands are defiled with blood, and your fingers with iniquity. Your lips have spoken lies. Your tongue mutters wickedness.",
      "ko": "이는 너희 손이 피에, 너희 손가락이 죄악에 더러웠으며 너희 입술은 거짓을 말하며 너희 혀는 악독을 발함이라",
      "source_text_hash": "2dfc9295a2718d74b8e1b714c42ca8ce0058d222b210300bf25400dcc55f629c",
      "translation_text_hash": "e5d6c6c106606f9595e99c9d6bf835d5bfb81758322246b393ac025ee41712a6",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 너희 손이 피에, 너희 손가락이 죄악에 더러웠으며 너희 입술은 거짓을 말하며 너희 혀는 악독을 발함이라"
      ],
      "raw_text_hashes": [
        "e5d6c6c106606f9595e99c9d6bf835d5bfb81758322246b393ac025ee41712a6"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:59:4",
