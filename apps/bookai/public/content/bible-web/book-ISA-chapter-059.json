      "verse_label": "13",
      "locator": {
        "book": "ISA",
        "chapter": 59,
        "verse": 13
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 59,
          "verse": 13
        }
      ],
      "en": "transgressing and denying the LORD, and turning away from following our God, speaking oppression and revolt, conceiving and uttering from the heart words of falsehood.",
      "ko": "우리가 여호와를 배반하고 인정치 아니하며 우리 하나님을 좇는데서 돌이켜 포학과 패역을 말하며 거짓말을 마음에 잉태하여 발하니",
      "source_text_hash": "bd0c7fa68c6a526b92e07cebdc1b1cc0a315e428bd08dccfd21ec42acff49cc5",
      "translation_text_hash": "73a98dfc29cf9f4bee9a5dd31bdcea51d8bab9adba167c13a66af93a1a981fdf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "우리가 여호와를 배반하고 인정치 아니하며 우리 하나님을 좇는데서 돌이켜 포학과 패역을 말하며 거짓말을 마음에 잉태하여 발하니"
      ],
      "raw_text_hashes": [
        "73a98dfc29cf9f4bee9a5dd31bdcea51d8bab9adba167c13a66af93a1a981fdf"
      ]
    },
