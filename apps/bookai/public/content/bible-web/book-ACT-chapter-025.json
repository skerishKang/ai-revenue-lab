        "verse": 9
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 25,
          "verse": 9
        }
      ],
      "en": "But Festus, desiring to gain favor with the Jews, answered Paul and said, “Are you willing to go up to Jerusalem and be judged by me there concerning these things?”",
      "ko": "베스도가 유대인의 마음을 얻고자하여 바울더러 묻되 네가 예루살렘에 올라가서 이 사건에 대하여 내 앞에서 심문을 받으려느냐",
      "source_text_hash": "d92c6ffb1ebf7c89e8b10c491378a2ee0e1e604285885e06414db7ca6c490ccb",
      "translation_text_hash": "35c36ff5f6fdd53db21a7b4b64616510326dbca70049593d104847b518ac906f",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "베스도가 유대인의 마음을 얻고자하여 바울더러 묻되 네가 예루살렘에 올라가서 이 사건에 대하여 내 앞에서 심문을 받으려느냐"
      ],
      "raw_text_hashes": [
        "35c36ff5f6fdd53db21a7b4b64616510326dbca70049593d104847b518ac906f"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:25:10",
      "sequence": 27803,
      "chapter_label": "ACT 25",
      "verse_label": "10",
      "locator": {
        "book": "ACT",
        "chapter": 25,
        "verse": 10
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 25,
          "verse": 10
        }
      ],
      "en": "But Paul said, “I am standing before Caesar’s judgment seat, where I ought to be tried. I have done no wrong to the Jews, as you also know very well.",
      "ko": "바울이 가로되 내가 가이사의 재판 자리 앞에 섰으니 마땅히 거기서 심문을 받을 것이라 당신도 잘 아시는 바에 내가 유대인들에게 불의를 행한 일이 없나이다",
      "source_text_hash": "ad036b8da81c6fcb67f0d0cda96ad2d6cc08777a9956206e29563276131578e6",
      "translation_text_hash": "011e2654ecdabb27f6d91b8af30c1004ff7942b09052db2b01f41cef22d51b77",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "바울이 가로되 내가 가이사의 재판 자리 앞에 섰으니 마땅히 거기서 심문을 받을 것이라 당신도 잘 아시는 바에 내가 유대인들에게 불의를 행한 일이 없나이다"
      ],
      "raw_text_hashes": [
        "011e2654ecdabb27f6d91b8af30c1004ff7942b09052db2b01f41cef22d51b77"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:25:11",
      "sequence": 27804,
      "chapter_label": "ACT 25",
      "verse_label": "11",
      "locator": {
        "book": "ACT",
        "chapter": 25,
        "verse": 11
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 25,
          "verse": 11
        }
      ],
      "en": "For if I have done wrong and have committed anything worthy of death, I don’t refuse to die; but if none of those things is true that they accuse me of, no one can give me up to them. I appeal to Caesar!”",
      "ko": "만일 내가 불의를 행하여 무슨 사죄를 범하였으면 죽기를 사양치 아니할 것이나 만일 이 사람들의 나를 송사하는 것이 다 사실이 아니면 누구든지 나를 그들에게 내어 줄 수 없삽나이다 내가 가이사께 호소하노라 한대",
      "source_text_hash": "008ad53195dfecb6d78d7370c4b125c51cb4cc10402ee8f20ebe35142b68ddbf",
      "translation_text_hash": "b6cd8087e17165e09f7762ee470485cdc7bc591319cf789149f591a289daf99c",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 내가 불의를 행하여 무슨 사죄를 범하였으면 죽기를 사양치 아니할 것이나 만일 이 사람들의 나를 송사하는 것이 다 사실이 아니면 누구든지 나를 그들에게 내어 줄 수 없삽나이다 내가 가이사께 호소하노라 한대"
      ],
      "raw_text_hashes": [
        "b6cd8087e17165e09f7762ee470485cdc7bc591319cf789149f591a289daf99c"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:25:12",
      "sequence": 27805,
      "chapter_label": "ACT 25",
      "verse_label": "12",
      "locator": {
        "book": "ACT",
        "chapter": 25,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 25,
          "verse": 12
        }
      ],
      "en": "Then Festus, when he had conferred with the council, answered, “You have appealed to Caesar. To Caesar you shall go.”",
      "ko": "베스도가 배석자들과 상의하고 가로되 네가 가이사에게 호소하였으니 가이사에게 갈 것이라 하니라",
      "source_text_hash": "4e5f2c70a7bfe12080819a107762d38966e252a5f95c249bdbf47062f0f6b2c5",
      "translation_text_hash": "5f6db91e5b0dac8fecf8b60871b85a7dee4dc568713db5302614d2c0223007c9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "베스도가 배석자들과 상의하고 가로되 네가 가이사에게 호소하였으니 가이사에게 갈 것이라 하니라"
      ],
      "raw_text_hashes": [
        "5f6db91e5b0dac8fecf8b60871b85a7dee4dc568713db5302614d2c0223007c9"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:25:13",
      "sequence": 27806,
      "chapter_label": "ACT 25",
      "verse_label": "13",
      "locator": {
        "book": "ACT",
