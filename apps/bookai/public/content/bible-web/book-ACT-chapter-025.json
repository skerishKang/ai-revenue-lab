      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여러 날을 있더니 베스도가 바울의 일로 왕에게 고하여 가로되 벨릭스가 한 사람을 구류하여 두었는데"
      ],
      "raw_text_hashes": [
        "073ec880dd795ffce1afaa1cc5415eb078b5b2a733e9d75ddde41b1a6d78f57a"
