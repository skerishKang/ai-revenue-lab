        "verse": 13
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 25,
          "verse": 13
        }
      ],
      "en": "Now when some days had passed, King Agrippa and Bernice arrived at Caesarea and greeted Festus.",
      "ko": "수일 후에 아그립바왕과 버니게가 베스도에게 문안하러 가이사랴에 와서",
      "source_text_hash": "7c8d9d17aabcc0773d513df9edf198996b053a290a68ab4f584247e149a547cb",
      "translation_text_hash": "81a8d00743c72bd0b8f3a21d4426e77a020ef61779c1ffab31f7665a80f27ecf",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "수일 후에 아그립바왕과 버니게가 베스도에게 문안하러 가이사랴에 와서"
      ],
      "raw_text_hashes": [
        "81a8d00743c72bd0b8f3a21d4426e77a020ef61779c1ffab31f7665a80f27ecf"
      ]
    },
    {
      "canonical_locator": "bible:web:ACT:25:14",
      "sequence": 27807,
      "chapter_label": "ACT 25",
      "verse_label": "14",
      "locator": {
        "book": "ACT",
        "chapter": 25,
        "verse": 14
      },
      "raw_locator": [
        {
          "book": "ACT",
          "chapter": 25,
          "verse": 14
        }
      ],
      "en": "As he stayed there many days, Festus laid Paul’s case before the king, saying, “There is a certain man left a prisoner by Felix;",
      "ko": "여러 날을 있더니 베스도가 바울의 일로 왕에게 고하여 가로되 벨릭스가 한 사람을 구류하여 두었는데",
      "source_text_hash": "bc274a11c4f97810b3e0312e3fd6a48006f72e885d9e144f09517e1ac57c7cf1",
      "translation_text_hash": "073ec880dd795ffce1afaa1cc5415eb078b5b2a733e9d75ddde41b1a6d78f57a",
      "translation_policy": "krv-1961-source-mapped",
