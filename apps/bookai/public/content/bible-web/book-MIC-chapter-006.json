      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "내가 만일 부정한 저울을 썼거나 주머니에 거짓 저울추를 두었으면 깨끗하겠느냐"
      ],
      "raw_text_hashes": [
