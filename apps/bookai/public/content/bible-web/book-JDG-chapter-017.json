        {
          "book": "JDG",
          "chapter": 17,
          "verse": 5
        }
      ],
      "en": "The man Micah had a house of gods, and he made an ephod, and teraphim, and consecrated one of his sons, who became his priest.",
      "ko": "이 사람 미가에게 신당이 있으므로 또 에봇과 드라빔을 만들고 한 아들을 세워 제사장을 삼았더라",
      "source_text_hash": "b8e1ddfd78938fffbfae254b9853e8c4d18ce351537ac24665bf3c49bdf0bb3e",
      "translation_text_hash": "2dfc4f7ef51ab069e0076784ef082d1dd2e24f384e2296290499bd742dba4cf9",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이 사람 미가에게 신당이 있으므로 또 에봇과 드라빔을 만들고 한 아들을 세워 제사장을 삼았더라"
      ],
      "raw_text_hashes": [
        "2dfc4f7ef51ab069e0076784ef082d1dd2e24f384e2296290499bd742dba4cf9"
      ]
    },
    {
      "canonical_locator": "bible:web:JDG:17:6",
      "sequence": 6987,
      "chapter_label": "JDG 17",
      "verse_label": "6",
      "locator": {
        "book": "JDG",
