        "verse": 6
      },
      "raw_locator": [
        {
          "book": "EST",
          "chapter": 4,
          "verse": 6
        }
      ],
      "en": "So Hathach went out to Mordecai, to the city square which was before the king’s gate.",
      "ko": "하닥이 대궐 문 앞 성중 광장에 있는 모르드개에게 이르니",
      "source_text_hash": "6b59c9e87202770ad345c81d743c2233689909b2d5674ea9195b1283fd6a0b3c",
      "translation_text_hash": "b197e0f644293d63126da31f896a717d20c032c97e9a827f876f39584db60fbc",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "하닥이 대궐 문 앞 성중 광장에 있는 모르드개에게 이르니"
      ],
      "raw_text_hashes": [
        "b197e0f644293d63126da31f896a717d20c032c97e9a827f876f39584db60fbc"
      ]
    },
    {
      "canonical_locator": "bible:web:EST:4:7",
      "sequence": 12770,
      "chapter_label": "EST 4",
      "verse_label": "7",
      "locator": {
        "book": "EST",
