      "ko": "산 위에서 제물을 먹거나 이웃의 아내를 더럽히거나",
      "source_text_hash": "936479127b75c7d46cdf114ecf6c865ef509759ee4ba003e900400a31523bdf2",
      "translation_text_hash": "e7511e660ed746fede44656dc70fe987bac8dfef8894032097f5e6521159f9c3",
      "translation_policy": "krv-1961-source-mapped",
