    {
      "canonical_locator": "bible:web:EZK:18:24",
      "sequence": 20874,
      "chapter_label": "EZK 18",
      "verse_label": "24",
      "locator": {
        "book": "EZK",
        "chapter": 18,
        "verse": 24
      },
      "raw_locator": [
        {
          "book": "EZK",
          "chapter": 18,
          "verse": 24
        }
      ],
      "en": "“But when the righteous turns away from his righteousness, and commits iniquity, and does according to all the abominations that the wicked man does, should he live? None of his righteous deeds that he has done will be remembered. In his trespass that he has trespassed, and in his sin that he has sinned, in them he shall die.",
      "ko": "만일 의인이 돌이켜 그 의에서 떠나서 범죄하고 악인의 행하는 모든 가증한 일대로 행하면 살겠느냐 그 행한 의로운 일은 하나도 기억함이 되지 아니하리니 그가 그 범한 허물과 그 지은 죄로 인하여 죽으리라",
      "source_text_hash": "6ee37ebba97df5c50f722898d3c2e34578d4d1749e0d494b2d39012ab97391dd",
      "translation_text_hash": "478d0647d83b2f56331892240311ecc62391f8eae12f453f865b65041db3c56a",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "만일 의인이 돌이켜 그 의에서 떠나서 범죄하고 악인의 행하는 모든 가증한 일대로 행하면 살겠느냐 그 행한 의로운 일은 하나도 기억함이 되지 아니하리니 그가 그 범한 허물과 그 지은 죄로 인하여 죽으리라"
      ],
      "raw_text_hashes": [
