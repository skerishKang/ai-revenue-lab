      "raw_locator": [
        {
          "book": "JOB",
          "chapter": 33,
          "verse": 7
        }
      ],
      "en": "Behold, my terror will not make you afraid, neither will my pressure be heavy on you.",
      "ko": "내 위엄으로는 너를 두렵게 하지 못하고 내 권세로는 너를 누르지 못하느니라",
      "source_text_hash": "09a66a3a4c415ef8b8d9755d4984b7d298141bb53bb0d3cc86cb3fb408a75b96",
      "translation_text_hash": "ae7fe7ded477aeada6a1304eab2ab081a862bf43432d493ea92b6a0c04b9522e",
      "translation_policy": "krv-1961-source-mapped",
