      "en": "The Spirit of God has made me, and the breath of the Almighty gives me life.",
      "ko": "하나님의 신이 나를 지으셨고 전능자의 기운이 나를 살리시느니라",
      "source_text_hash": "f3a45f2d29b1f9563a1fdb2da748f7a1bef7efbe67b4ce0eae0cd9baafadc365",
      "translation_text_hash": "ec5949a13c76841c31e2a4f9b7c01e7a4518b9e2f47f69987da978d3a6c2dd36",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
