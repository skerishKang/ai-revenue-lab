      "source_text_hash": "ba7dafaaed0b257e9999f2bfecf2c39d7ec0aa7969555314d39c1a7ac4c2fe2b",
      "translation_text_hash": "66115b9beb80e3b1e75167c84d5424766b62fc3d3802480dbdd68ad29a897d1a",
      "translation_policy": "krv-1961-source-mapped",
