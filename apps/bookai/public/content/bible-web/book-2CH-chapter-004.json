      "source_text_hash": "847aa3c4fda97d5703468fe049fa30af04a8d6cf0f01892e8d2041b65d0a85d2",
      "translation_text_hash": "28e99fc5002f69482e9cf3028f3f2f47815c634be6608346ee26e9f31afc458b",
