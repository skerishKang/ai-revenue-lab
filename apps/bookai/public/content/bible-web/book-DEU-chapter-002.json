      "raw_locator": [
        {
          "book": "DEU",
          "chapter": 2,
          "verse": 2
        }
      ],
      "en": "The LORD spoke to me, saying,",
      "ko": "여호와께서 내게 고하여 이르시되",
      "source_text_hash": "d4cca539cc5ca338bfec03a15ec680755ab4cea6e0b1f24ff5c1643e05fa1fc6",
      "translation_text_hash": "bfdc3a529ef09a9704ddf9d831fe33cb590db86ef00eb1f412701827aa5b53ce",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "여호와께서 내게 고하여 이르시되"
      ],
      "raw_text_hashes": [
        "bfdc3a529ef09a9704ddf9d831fe33cb590db86ef00eb1f412701827aa5b53ce"
      ]
    },
    {
      "canonical_locator": "bible:web:DEU:2:3",
      "sequence": 4942,
      "chapter_label": "DEU 2",
      "verse_label": "3",
