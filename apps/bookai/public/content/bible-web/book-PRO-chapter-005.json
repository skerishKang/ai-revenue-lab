      "translation_text_hash": "d8ae70207189c98c09d5abc1a77e9214a2f96aa2af67c2679a5fd8264540b690",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "대저 음녀의 입술은 꿀을 떨어뜨리며 그 입은 기름보다 미끄러우나"
      ],
      "raw_text_hashes": [
        "d8ae70207189c98c09d5abc1a77e9214a2f96aa2af67c2679a5fd8264540b690"
      ]
    },
