        "verse": 4
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 63,
          "verse": 4
        }
      ],
      "en": "For the day of vengeance was in my heart, and the year of my redeemed has come.",
      "ko": "이는 내 원수 갚는 날이 내 마음에 있고 내 구속할 해가 왔으나",
      "source_text_hash": "00f4d1957b3276e93785b9ad02413d623d7247167aac37d7b70b25227146268d",
      "translation_text_hash": "c5be9489b92c5d2f3b738501199ccbaa37c2e99ecc6221e780e8bdddfe9e9ee2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "이는 내 원수 갚는 날이 내 마음에 있고 내 구속할 해가 왔으나"
      ],
      "raw_text_hashes": [
        "c5be9489b92c5d2f3b738501199ccbaa37c2e99ecc6221e780e8bdddfe9e9ee2"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:63:5",
      "sequence": 18872,
      "chapter_label": "ISA 63",
