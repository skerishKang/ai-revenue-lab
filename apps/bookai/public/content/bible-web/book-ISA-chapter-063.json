    },
    {
      "canonical_locator": "bible:web:ISA:63:12",
      "sequence": 18879,
      "chapter_label": "ISA 63",
      "verse_label": "12",
      "locator": {
        "book": "ISA",
        "chapter": 63,
        "verse": 12
      },
      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 63,
          "verse": 12
        }
      ],
      "en": "Who caused his glorious arm to be at Moses’ right hand? Who divided the waters before them, to make himself an everlasting name?",
      "ko": "그 영광의 팔을 모세의 오른손과 함께하시며 그 이름을 영영케 하려 하사 그들 앞에서 물로 갈라지게 하시고",
      "source_text_hash": "602f16ffa0966c2bbe64dc32b1e53cd6a04dbcf214f31c6d55d1046212bd4fd9",
      "translation_text_hash": "0991a9c3e533668923d1c79b201f85db897071fd1fa53809ffddde15760928cb",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "그 영광의 팔을 모세의 오른손과 함께하시며 그 이름을 영영케 하려 하사 그들 앞에서 물로 갈라지게 하시고"
      ],
      "raw_text_hashes": [
        "0991a9c3e533668923d1c79b201f85db897071fd1fa53809ffddde15760928cb"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:63:13",
      "sequence": 18880,
      "chapter_label": "ISA 63",
      "verse_label": "13",
      "locator": {
