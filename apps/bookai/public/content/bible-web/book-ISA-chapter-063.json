      "raw_locator": [
        {
          "book": "ISA",
          "chapter": 63,
          "verse": 2
        }
      ],
      "en": "Why is your clothing red, and your garments like him who treads in the wine vat?",
      "ko": "어찌하여 네 의복이 붉으며 네 옷이 포도즙 틀을 밟는 자 같으뇨",
      "source_text_hash": "24b722fb3e63503e7f1263f7da0cf0521981b4d9a76dc499f11db10e3d1e084a",
      "translation_text_hash": "09bcabb0be75b627c30bee25b7f7fce0229e8af345ff2f91a2085e3da936ddd2",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "어찌하여 네 의복이 붉으며 네 옷이 포도즙 틀을 밟는 자 같으뇨"
      ],
      "raw_text_hashes": [
        "09bcabb0be75b627c30bee25b7f7fce0229e8af345ff2f91a2085e3da936ddd2"
      ]
    },
    {
      "canonical_locator": "bible:web:ISA:63:3",
      "sequence": 18870,
      "chapter_label": "ISA 63",
