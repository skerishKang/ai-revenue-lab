      "raw_locator": [
        {
          "book": "NUM",
          "chapter": 5,
          "verse": 17
        }
      ],
      "en": "The priest shall take holy water in an earthen vessel; and the priest shall take some of the dust that is on the floor of the tabernacle and put it into the water.",
      "ko": "토기에 거룩한 물을 담고 성막 바닥의 티끌을 취하여 물에 넣고",
      "source_text_hash": "c065191358016c6d2b21993825bd36867db5c9b271cafd90919349467dfc703c",
      "translation_text_hash": "0e6a76d20c54c284199f7315ddd109e21df07411fc727815287f48524c392546",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "토기에 거룩한 물을 담고 성막 바닥의 티끌을 취하여 물에 넣고"
      ],
      "raw_text_hashes": [
        "0e6a76d20c54c284199f7315ddd109e21df07411fc727815287f48524c392546"
      ]
