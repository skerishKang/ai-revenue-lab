      "source_text_hash": "6dbd0eaa9d066ae5b815bfb706a074f1154dc36d5c4ac495630d5097e68a5330",
      "translation_text_hash": "2cbb991e4f344661b5c22d46772c8fff6f532000f7be3910d76680c32e1d9833",
      "translation_policy": "krv-1961-source-mapped",
