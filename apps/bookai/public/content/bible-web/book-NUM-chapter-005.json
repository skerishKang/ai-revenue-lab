      ],
      "en": "“‘The priest shall write these curses in a book, and he shall wipe them into the water of bitterness.",
      "ko": "제사장이 저주의 말을 두루마리에 써서 그 글자를 그 쓴 물에 빨아 넣고",
      "source_text_hash": "16b3611dadf26a35b8bcdedc9c59a47ca0ecfa87f84bf781b1152c672827c257",
      "translation_text_hash": "8931d8faa4c2edc61797f4caf14e1cb9a6beb97e85e796cb64428e21f4ed036e",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제사장이 저주의 말을 두루마리에 써서 그 글자를 그 쓴 물에 빨아 넣고"
      ],
      "raw_text_hashes": [
        "8931d8faa4c2edc61797f4caf14e1cb9a6beb97e85e796cb64428e21f4ed036e"
      ]
    },
    {
      "canonical_locator": "bible:web:NUM:5:24",
      "sequence": 3817,
      "chapter_label": "NUM 5",
      "verse_label": "24",
      "locator": {
