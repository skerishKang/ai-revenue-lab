      "source_text_hash": "2a31883ab5f3299984355ed5a0433f36002c5a1c4c76e9675a3d558df71ba191",
      "translation_text_hash": "1eb6fbf843dfb0baa406d04296163eac40999fd6b20a1f393a7000ad630e9c72",
      "translation_policy": "krv-1961-source-mapped",
      "source_edition": "KRV-1961",
      "mapping_type": "normal",
      "mapping_note": null,
      "raw_texts": [
        "제사장 우리야가 아하스왕의 모든 명대로 행하였더라"
      ],
      "raw_text_hashes": [
        "1eb6fbf843dfb0baa406d04296163eac40999fd6b20a1f393a7000ad630e9c72"
      ]
