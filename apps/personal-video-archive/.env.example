APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=var/personal-video-archive.db

# Discovery provider: "fake" only in Phase 1. Real provider is deferred.
DISCOVERY_PROVIDER=fake

# Language model provider: "fake" only in Phase 1. Real provider is deferred.
LLM_PROVIDER=fake
LLM_MODEL=fake-pva-v1

# No real API key is required or accepted in Phase 1.
YOUTUBE_API_KEY=
