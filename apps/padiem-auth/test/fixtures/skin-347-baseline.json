    "/login-ko": {
      "status": 200,
      "html": "<!doctype html><html lang=\"ko\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>로그인</title><meta name=\"referrer\" content=\"no-referrer\"><style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);font-family:Pretendard,'Noto Sans KR',Inter,ui-sans-serif,system-ui,sans-serif;color:var(--text)}main{width:100%;max-width:400px;margin:24px;padding:32px 28px;background:var(--panel);border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,.08)}h1{font-size:20px;margin:0 0 20px;text-align:center;letter-spacing:-.04em;font-weight:600}.btn{display:flex;align-items:center;justify-content:center;gap:9px;min-height:48px;width:100%;padding:0 16px;border-radius:8px;border:1px solid var(--line);background:var(--panel);font-size:15px;font-weight:600;text-align:center;text-decoration:none;color:var(--text);cursor:pointer}.btn .g-logo{flex:0 0 auto;width:18px;height:18px}.btn+.btn{margin-top:10px}.btn-primary{background:var(--primary);border-color:var(--primary);color:#fff}.btn-primary:hover{background:var(--primary-hover)}.divider{display:flex;align-items:center;gap:12px;margin:20px 0 4px;color:var(--muted);font-size:12px}.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--line)}form{margin:0}button,input{font:inherit}form .btn-primary{margin-top:14px}label{display:block;font-size:12px;font-weight:600;letter-spacing:0;margin:12px 0 4px;color:var(--muted)}input{width:100%;padding:11px;border:1px solid var(--input-line);border-radius:8px;font-size:15px;color:var(--text);background:var(--panel)}.message{margin:0 0 12px;padding:10px;border-radius:8px;background:var(--error-bg);color:var(--error);font-size:14px}.link{display:block;margin-top:16px;text-align:center;font-size:13px;color:var(--primary);text-decoration:none}.padiem-account-line{margin:18px 0 0;text-align:center;font-size:11px;letter-spacing:.04em;line-height:1.6;color:var(--muted);word-break:keep-all}@media (max-width:680px){main{margin:0;min-height:100vh;max-width:none;border-radius:0;box-shadow:none}}:root{--bg:#f5f6f8;--panel:#fff;--text:#1c1e21;--muted:#5f6368;--primary:#1a73e8;--primary-hover:#1765cc;--line:#dadce0;--input-line:#747775;--error-bg:#fce8e6;--error:#c5221f}@media (prefers-color-scheme:dark){:root{--bg:#10151c;--panel:#1a232d;--text:#edf4fa;--muted:#9fb3c3;--primary:#1a73e8;--primary-hover:#1765cc;--line:#2d3a47;--input-line:#425263;--error-bg:#3a2323;--error:#f2b8b5}}</style></head><body><main><h1>PADIEM 로그인</h1><a class=\"btn\" href=\"/login/google?client_id=brandless&amp;redirect_uri=https%3A%2F%2Flovetree.example%2Fauth%2Fcallback&amp;state=STATE&amp;code_challenge=CHALLENGE&amp;code_challenge_method=S256\"><img class=\"g-logo\" src=\"/assets/auth-skin/googleg-standard-color.svg\" alt=\"\" width=\"18\" height=\"18\">Google 계정으로 계속</a><div class=\"divider\"><span>또는 이메일로</span></div><form method=\"post\" action=\"/login/password?state=STATE\"><label for=\"email\">이메일</label><input id=\"email\" name=\"email\" type=\"email\" required maxlength=\"255\" autocomplete=\"username\"><label for=\"password\">비밀번호</label><input id=\"password\" name=\"password\" type=\"password\" required maxlength=\"128\" autocomplete=\"current-password\"><button class=\"btn btn-primary\" type=\"submit\">이메일로 로그인</button></form><a class=\"link\" href=\"/signup?client_id=brandless&amp;redirect_uri=https%3A%2F%2Flovetree.example%2Fauth%2Fcallback&amp;state=STATE&amp;code_challenge=CHALLENGE&amp;code_challenge_method=S256\">이메일로 회원가입</a><p class=\"padiem-account-line\">PADIEM 계정으로 로그인합니다 · 하나의 계정으로 PADIEM 서비스를 이용할 수 있어요</p></main></body></html>"
