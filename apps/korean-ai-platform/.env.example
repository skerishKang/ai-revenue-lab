# Business 14 Korean AI Platform — Environment Configuration
# Copy this file: cp .env.example .env
# Then edit .env with your own values.

# ─── OpenRouter Adapter (Alpha 1) ─────────────────────────────────────
# Provider mode: "mock" = simulated responses (no real API call)
#                "live" = real provider API call (requires a provider key)
B14_PROVIDER_MODE=mock

# OpenRouter API key (server-side only — NEVER commit, NEVER log, NEVER expose to browser)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter base URL (do not change unless you have a specific need)
B14_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Referrer shown to OpenRouter (non-secret, optional)
B14_SITE_URL=https://business14.example

# App title shown in OpenRouter dashboard (non-secret, optional)
B14_SITE_NAME=Business 14 Korean AI Gateway

# ─── Platform-owned Provider credentials (generic credential plane) ─────
# Each platform-owned Provider reads its secret from a fixed server env var
# (binding name). The value is NEVER committed, logged, returned in responses,
# or reused across Providers. Missing secret => route fails closed.
# Agnes AI — first platform-owned Provider (upstream: https://apihub.agnes-ai.com)
AGNES_API_KEY=

# ─── Legacy BYOK Gateway (Phase 1/2 — optional, for backward compat) ───
# When BUSINESS14_PROVIDER_REGISTRY_JSON is set, multi-provider mode is used.
# When only BUSINESS14_PILOT_BASE_URL + BUSINESS14_PILOT_MODEL_ID are set,
# single-provider legacy mode is used.
BUSINESS14_PILOT_PROVIDER_ID=
BUSINESS14_PILOT_BASE_URL=
BUSINESS14_PILOT_MODEL_ID=
BUSINESS14_PILOT_UPSTREAM_MODEL=
BUSINESS14_PILOT_TIMEOUT_SECONDS=30
BUSINESS14_PROVIDER_REGISTRY_JSON=
