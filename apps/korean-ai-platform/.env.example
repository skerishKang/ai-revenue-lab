APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8014

# This MVP is a deterministic demo. No real AI provider, GitHub API, or
# container runner is connected. These values only label the demo UI.
DEMO_MODE=true

# Product-local persistence (Business 14 owns its own SQLite database).
# Only 'sqlite' is implemented; 'postgresql' fails closed (no silent fallback).
# KAP_DATABASE_PATH is resolved relative to the apps/korean-ai-platform workspace.
KAP_DB_BACKEND=sqlite
KAP_DATABASE_PATH=var/korean-ai-platform.db
