# B14 (apps/korean-ai-platform) 로컬·COM2 실행 환경 예시
#
# This file lists BINDING NAMES ONLY. No value is committed here, no value is
# copied from Cloudflare, and copying a live credential into a file is not part
# of any migration step. The Owner supplies values on the machine, into a file
# this process can read and no one else can:
#
#   install -d -m 0700 /var/lib/padiem-b14/b14-secrets   # systemd owns this via StateDirectory
#   printf '%s' "$VALUE" > /var/lib/padiem-b14/b14-secrets/PADIEM_B14_CREDENTIAL_01
#   chmod 0600 /var/lib/padiem-b14/b14-secrets/PADIEM_B14_CREDENTIAL_01
#
# Since #2107 the Owner normally does not type these commands: the COM2 admin
# screen (http://127.0.0.1:8789/com2/admin/secrets, loopback only) writes the
# file itself, at 0600, through this same path.
#
# Resolution order for every name below: process environment first, then
# $B14_SECRET_DIR/<exact binding name>. A secret file readable by group or
# other is refused (the binding then resolves to nothing and the route that
# needs it fails closed) — the same posture as an unresolvable Worker binding.
#
# The 16 names in the CREDENTIAL/PROOF/OBSERVABILITY block are exactly the
# Secrets Store bindings declared for ai-revenue-korean-ai-platform in
# docs/architecture/COM2_MIGRATION_INVENTORY_20261025.md §2.2 and §4.2.
#
# A Provider onboarded after #2107 contributes one more name here, and that name
# is whatever its entry in app/pilot/b14_models.json declares as its
# credential_binding_name. Such a name exists only on this host: it is not
# declared in wrangler.toml, no Cloudflare Secret is duplicated for it, and no
# existing slot is reused for it. Both entrypoints read it from the registry, so
# typing it here (or as $B14_SECRET_DIR/<name>) is the whole registration.

# --- platform provider credentials (14 slots, names are the stable slots) ----
PADIEM_B14_CREDENTIAL_01=
PADIEM_B14_CREDENTIAL_02=
PADIEM_B14_CREDENTIAL_03=
PADIEM_B14_CREDENTIAL_04=
PADIEM_B14_CREDENTIAL_05=
PADIEM_B14_CREDENTIAL_06=
PADIEM_B14_CREDENTIAL_07=
PADIEM_B14_CREDENTIAL_08=
PADIEM_B14_CREDENTIAL_09=
PADIEM_B14_CREDENTIAL_10=
PADIEM_B14_CREDENTIAL_11=
PADIEM_B14_CREDENTIAL_12=
PADIEM_B14_CREDENTIAL_13=
PADIEM_B14_CREDENTIAL_14=

# --- deployment-owned server-to-server caller proof -------------------------
# Authenticates a PADIEM caller before any platform credential is resolved.
# The Worker verifies the identical HMAC header over HTTPS, so switching the
# upstream transport does not weaken or replace this check.
PADIEM_B14_SERVICE_PROOF_SECRET=

# --- observability ----------------------------------------------------------
PADIEM_GRAFANA_OTLP_TOKEN=

# --- non-secret deployment configuration -----------------------------------
# live | mock. An unset or empty value resolves to mock: a host that has not
# said "live" out loud is a test bed and is never reported as a live B14.
B14_PROVIDER_MODE=
BUSINESS14_PROVIDER_REGISTRY_JSON=
BUSINESS14_PILOT_BASE_URL=
BUSINESS14_PILOT_MODEL_ID=
BUSINESS14_PILOT_PROVIDER_ID=
BUSINESS14_PILOT_UPSTREAM_MODEL=
BUSINESS14_PILOT_TIMEOUT_SECONDS=
KAP_APP_NAME=
# The application default is true. A real deployment must set it to false
# explicitly, otherwise the console renders demo data.
KAP_DEMO_MODE=false

# --- local runtime adapter (apps/korean-ai-platform/asgi.py) ----------------
# Absolute path of the ledger SQLite file. Leave unset to run with no durable
# ledger: writes then report the bounded not_configured posture and answers
# keep flowing, exactly as an unbound Worker deployment behaves.
B14_CALL_LEDGER_PATH=/opt/padiem/b14/ledger/b14-call-ledger.db
B14_SECRET_DIR=/var/lib/padiem-b14/b14-secrets
# The one registry file this deployment reads. Unset means the file inside the
# package (the checkout), which is what the Cloudflare Worker always uses; a
# systemd host keeps its own copy here so a redeploy cannot undo what the Owner
# registered on the machine. It is the same authority at a different path, not a
# second source that gets merged with the package file.
B14_REGISTRY_PATH=/var/lib/padiem-b14/b14-registry/b14_models.json
# Loopback only. The Tunnel host, not this setting, decides what is reachable.
B14_HOST=127.0.0.1
B14_PORT=8789
B14_LOG_LEVEL=INFO
