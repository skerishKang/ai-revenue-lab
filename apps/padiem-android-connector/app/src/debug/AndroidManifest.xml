<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only hook: revokes the saved SAF grant without clearing preferences,
             so the revoked-permission UI can be exercised on a non-rooted device. -->
        <receiver
            android:name=".DebugRevokeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.padiem.connector.DEBUG_REVOKE_GRANT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
